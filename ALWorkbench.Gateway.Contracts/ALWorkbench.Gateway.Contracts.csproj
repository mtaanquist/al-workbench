<Project Sdk="Microsoft.NET.Sdk">

  <!-- What AL Workbench and the on-premises gateway agree on: the request and
       response shapes, the protocol version and the signed request token. Both
       sides reference this project, so it stays plain net10.0 with no package
       references - anything it pulled in would ship inside the gateway too.
       See .design/on-prem-gateway.md, "Projects, packaging and naming". -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ALWorkbench.Gateway.Contracts</RootNamespace>
    <!-- Same discipline as the app: nullable warnings fail the build (#396)
         and restores are pinned in packages.lock.json (#394). -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
