<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The project prizes nullable discipline, so fail the build on nullable
         (CS86xx) warnings rather than only Nullable=enable's advisory output.
         Scoped to nullable (not all warnings) so platform-analyzer warnings like
         CA1416 stay advisory. See issue #396. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Reproducible restores: pin the dependency graph in packages.lock.json so
         two runs of the same commit can't resolve different package versions.
         CI restores in locked mode to enforce it. See issue #394. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Release stamp (issue #604). Both properties are empty for local and
       branch builds and are only supplied by release.yml -> Dockerfile ->
       dotnet publish when a v*.*.* tag is built. The attributes are therefore
       absent on unstamped builds, which is exactly how Services/BuildInfo
       tells "this is a release" from "this is a dev build" — a default
       InformationalVersion of 1.0.0 could not. InformationalVersion is set
       alongside so the DLL's file properties and crash dumps agree with the
       footer. -->
  <PropertyGroup Condition="'$(ReleaseVersion)' != ''">
    <Version>$(ReleaseVersion)</Version>
    <InformationalVersion>$(ReleaseVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ReleaseVersion" Value="$(ReleaseVersion)" Condition="'$(ReleaseVersion)' != ''" />
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" Condition="'$(ReleaseDate)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored Lucide icons (issue #47). The unmaintained Lucide.Blazor
         package was replaced by IconCatalog + Components/Shared/Icon.razor,
         which inline the SVGs below. LogicalName is set explicitly so kebab-
         case filenames survive MSBuild's identifier normalisation. -->
    <EmbeddedResource Include="Resources/Icons/*.svg">
      <LogicalName>ALDevToolbox.Resources.Icons.%(Filename).svg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- S3-compatible client for the off-site backup target. Works against
         AWS S3 as well as MinIO / Cloudflare R2 / Backblaze B2 (set
         OffsiteForcePathStyle=true for the non-AWS providers). -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <!-- Azure Blob Storage off-site backup target, selectable alongside the
         S3-compatible client above (system_settings.offsite_provider). -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <!-- Fido2NetLib (passkeys / WebAuthn). The .AspNet meta package pulls in
         the core types and the ASP.NET Core integration helpers. -->
    <PackageReference Include="Fido2.AspNet" Version="4.2.0" />
    <!-- 4.* floats over CVE-patched releases (GHSA-9j88-vvj5-vhgr, GHSA-g7hc-96xr-gvvx). -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- Markdown renderer for recipe authoring instructions. CommonMark + GFM
         (autolinks, fenced code, tables). Safe HTML output by default; we
         render through a sanitising pipeline in MarkdownRenderer. -->
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <!-- Model Context Protocol — bearer-token HTTP server mounted at /mcp,
         consumed by AI clients (Claude Desktop, Cursor, VS Code Copilot
         agent mode, Claude Code). See .design/mcp.md / docs/mcp-clients.md. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- OpenIddict — OAuth 2.1 authorization server + resource-server
         validation for the MCP endpoint. Lets Claude.ai's directory and
         custom-connector flow add the workbench via DCR (RFC 7591) and CIMD,
         neither of which work with a user-pasted static bearer. The PAT
         bearer path stays in place for desktop/CLI clients. See
         .design/mcp-oauth.md and docs/mcp. -->
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.7.1" />
    <!-- Pinned to an exact patch (not 10.*) so the app and the test project
         always compile against the SAME EF Core version. Left floating, a new
         10.0.x patch can land in one project's restore before the other's and
         the mismatch fails the test build with CS1705. Bump in lockstep with
         the EF Core refs in ALDevToolbox.Tests.csproj. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- TOTP (RFC 6238) primitives — pure managed, no native deps. -->
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <!-- QR PNG for the TOTP setup page so we don't ship a JS QR library. This
         is the library Microsoft's own Blazor TOTP guidance uses, and its PNG
         writer lives in the core assembly with no package dependencies at all,
         so nothing Windows-only can reach the Linux container.
         It replaced QRCoder, which had to be held at 1.6.* because 1.7+ took an
         unconditional dependency on System.Drawing.Common — Windows-only since
         .NET 6, and it threw PlatformNotSupportedException on Linux. QRCoder
         1.6.0 scoped that to a net6.0-windows7.0 target and later dropped the
         split, so every Dependabot run wanted to step over the pin (#780). -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test access to internal seams kept narrow on purpose: BackupScheduler
         exposes TickOnceAsync (#71) so schedule-decision tests can drive
         it without the Task.Delay loop. -->
    <InternalsVisibleTo Include="ALDevToolbox.Tests" />
  </ItemGroup>

</Project>
