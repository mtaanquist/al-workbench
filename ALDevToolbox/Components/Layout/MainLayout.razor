@inherits LayoutComponentBase
@using System.Security.Claims
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Organizations
@inject OrganizationConfigService Config

@*
    App shell on the design system's `shell.css`. The grid is 2x2 with named
    areas ("brand top" / "nav content"), which is why the brand is a sibling of
    the nav rather than nested inside it, and why the old `.main-col` wrapper is
    gone — the top bar is its own grid cell now.

    `.shell-root` is the container-query host: shell.css's breakpoints are
    container queries against it, not media queries, so the shell also behaves
    when it is embedded in something narrower than the viewport.
*@

@* The shell grid is height-bound (height: 100%), so the site banner cannot be
   a third grid child without redrawing the areas. A flex column above it gives
   the strip its own row and leaves the shell to fill what is left. *@
<div class="app-frame">
<SiteBanner />
<div class="shell-root">
    <div class="app">
        <div class="app__brand">
            @* Product name over organisation: "which install am I in" reads
               here, beside the mark, rather than bundled with the user's
               identity in the top bar. Both lines are inside the link, so its
               own label has to name the organisation - at rail width shell.css
               hides the text and the label is all that is left. *@
            <a href="/" class="brand__link" aria-label="@HomeLabel(BrandOrg)">
                <span class="brand__mark"><Icon Name="hammer" Width="17" Height="17" /></span>
                <span class="brand__text">
                    <span class="brand__name">AL Workbench</span>
                    @if (!string.IsNullOrEmpty(BrandOrg))
                    {
                        <span class="brand__org" title="@BrandOrg">@BrandOrg</span>
                    }
                </span>
            </a>
            @* Closes the drawer once it is open; the opener lives in the top
               bar, because below 700px .app__brand is itself hidden. *@
            @* Deliberately NOT also .nav-link-btn: that class sets display:grid
               and is declared after .brand__toggle in shell.css, so it beat the
               `display: none` that keeps this hidden above the drawer
               breakpoint — the close button showed on every desktop page. *@
            <button type="button" class="brand__toggle" data-drawer-toggle
                    aria-label="Close menu" title="Close menu">
                <Icon Name="x" Width="15" Height="15" />
            </button>
        </div>

        <nav class="app__nav" aria-label="Sidebar">
            <NavMenu />
        </nav>

        <header class="app__top">
            <div class="app__top-lead">
                <button type="button" class="app__top-menu nav-link-btn" data-drawer-toggle
                        aria-label="Open menu" title="Menu">
                    <Icon Name="menu" Width="17" Height="17" />
                </button>
                @* The palette's other way in. Nobody finds a hotkey by accident,
                   and on a phone or a tablet there is no hotkey to find - so
                   this button is the only door and has to survive every width.
                   It narrows to the magnifier alone below the drawer
                   breakpoint, where .cmdp-open__label goes sr-only rather than
                   display:none: clipped text is still in the accessibility
                   tree, so the icon-only button keeps its name.

                   The key cap says Ctrl here and command-palette.js rewrites it
                   to Cmd on a Mac - the same one decision that picks which
                   modifier actually opens the palette, rather than a second
                   copy of it in Razor. *@
                <AuthorizeView>
                    <Authorized>
                        @* The title earns its place only at rail and phone
                           width, where the label is clipped and a tablet with a
                           mouse has nothing else to hover. *@
                        <button type="button" class="cmdp-open" data-cmdp-open
                                title="Search or jump to">
                            <span class="cmdp-open__icon" aria-hidden="true">
                                <Icon Name="search" Width="15" Height="15" />
                            </span>
                            <span class="cmdp-open__label">Search or jump to...</span>
                            <span class="cmdp-open__keys" aria-hidden="true">
                                <kbd class="kbd" data-cmdp-mod>Ctrl</kbd><kbd class="kbd">K</kbd>
                            </span>
                            @* Read out after the label, so the name is
                               "Search or jump to..., Ctrl K". The key caps
                               beside it are decoration and stay hidden. *@
                            <span class="u-sr-only" data-cmdp-shortcut>, Ctrl K</span>
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
            <div class="app__top-cluster">
                <ThemeToggle />
                <AuthorizeView>
                    <Authorized>
                        @{
                            var roles = context.User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
                            var role = roles.Contains("SiteAdmin") ? "Site admin"
                                : roles.Contains("Admin") ? "Admin"
                                : roles.FirstOrDefault();
                            var name = context.User.Identity?.Name;
                        }
                        <NotificationBell />
                        <span class="top-sep" aria-hidden="true"></span>
                        <a href="/account" class="user-btn" title="Manage your account">
                            <span class="user-btn__avatar" aria-hidden="true">@Initials(name)</span>
                            <span class="user-btn__meta">
                                <span class="user-btn__name">@name</span>
                                @if (!string.IsNullOrEmpty(role))
                                {
                                    @* The handoff calls this line __org; it now
                                       carries the role alone, because the
                                       organisation moved to the brand. *@
                                    <span class="user-btn__org">@role</span>
                                }
                            </span>
                        </a>
                        <form method="post" action="/auth/logout" class="signout-form">
                            <AntiforgeryToken />
                            <button type="submit" class="nav-link-btn" title="Sign out" aria-label="Sign out">
                                <Icon Name="log-out" Width="15" Height="15" />
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        @* One entry point: the sign-in page links onward to /signup
                           for new accounts, so we don't surface a second button. *@
                        <span class="top-sep" aria-hidden="true"></span>
                        <a href="/login" class="btn btn--sm" aria-label="Sign in" title="Sign in">
                            <Icon Name="log-in" Width="15" Height="15" />
                            <span>Sign in</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="app__content">
            <div class="app__content-inner">
                @Body
            </div>
        </main>
    </div>
</div>
</div>

@* Hidden until Ctrl/Cmd+K. It sits outside .shell-root because the overlay
   covers the viewport rather than the shell, and it renders for signed-in
   people only - there is nowhere for an anonymous visitor to jump to. *@
<CommandPalette />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _liveOrgName;
    private string? _claimOrgName;

    /// <summary>
    /// The organisation shown under the product name. Prefers the live (cached)
    /// name so a rename via /admin/configuration/identity takes effect for every
    /// active circuit without forcing a re-login, and falls back to the
    /// <c>org_name</c> claim for the frame before the lookup returns.
    /// </summary>
    private string? BrandOrg => !string.IsNullOrEmpty(_liveOrgName) ? _liveOrgName : _claimOrgName;

    private static string Initials(string? name) => Avatar.Initials(name);

    /// <summary>
    /// The brand link's accessible name. Both visible lines sit inside the link,
    /// so its label would otherwise be the bare "Home" it needs at rail width,
    /// where shell.css hides the text and nothing announces which organisation
    /// this is.
    /// </summary>
    private static string HomeLabel(string? orgName) =>
        string.IsNullOrEmpty(orgName) ? "Home" : $"Home, {orgName}";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null) return;
        var state = await AuthStateTask;
        _claimOrgName = state.User.FindFirst("org_name")?.Value;
        var orgIdClaim = state.User.FindFirst(HttpOrganizationContext.OrganizationIdClaim)?.Value;
        if (int.TryParse(orgIdClaim, out var orgId))
        {
            _liveOrgName = await Config.GetOrganizationNameAsync(orgId);
        }
    }
}
