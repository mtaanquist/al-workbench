@inherits LayoutComponentBase

@*
    The layout for the tools that work without an account (Piper, Diff).
    Signed in, it is MainLayout. Signed out, it is AnonymousFrame, so a link
    shared with someone outside the organisation opens on the tool rather than
    on our product.
*@

<AuthorizeView>
    <Authorized>
        <LayoutView Layout="typeof(MainLayout)">@Body</LayoutView>
    </Authorized>
    <NotAuthorized>
        <AnonymousFrame>@Body</AnonymousFrame>
    </NotAuthorized>
</AuthorizeView>
