@rendermode InteractiveServer
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.DeliveryService Deliveries
@inject ILogger<ReleaseAgainDialog> Log
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Domain.Entities.ObjectExplorer

@*
    "Deploy again" for a failed deployment (issue #931; DeliveryRowPanel.dc.html, section 4):
    the same build, through the same pipeline, right now, with an optional Force sync for
    this one deployment. The pipeline's own setting is not touched. Apps the environment is
    already on at this version are left alone by the run, and the dialog names them so
    nobody expects them to be sent twice. Opened imperatively; raises OnReleased with the
    new delivery's id.

    Named user: an ops engineer whose deployment to a customer's environment just failed,
    deciding whether to push the same build through once more.
*@

@if (_request is { } r)
{
    <div class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="ra-title"
         tabindex="-1" @onkeydown="OnKeyDown" @ref="_root">
        <div class="modal-backdrop" @onclick="Cancel" aria-hidden="true"></div>
        <div class="confirm-dialog confirm-dialog--wide @DangerClass" @onclick:stopPropagation>
            <div class="confirm-dialog__head">
                <span class="confirm-dialog__icon" aria-hidden="true">
                    <Icon Name="rotate-cw" Width="17" Height="17" />
                </span>
                <h2 id="ra-title" class="confirm-dialog__title">Deploy build #@r.BuildId again?</h2>
            </div>
            <div class="confirm-dialog__body ra-body">
                <p class="ra-lead">@Lead</p>

                <div class="ra-facts">
                    <span class="meta-item">
                        <span class="meta-item__label">Build</span>
                        <span class="meta-item__value">#@r.BuildId <span class="u-muted">@r.BuildSource</span></span>
                    </span>
                    <span class="meta-item">
                        <span class="meta-item__label">Environment</span>
                        <span class="meta-item__value">
                            @* "Production Production" says nothing twice; the type alone names it. *@
                            @if (!string.Equals(r.EnvironmentName, EnvType, StringComparison.OrdinalIgnoreCase))
                            {
                                @(r.EnvironmentName + " ")
                            }
                            <span class="@(IsProduction ? "ra-type ra-type--prod" : "ra-type")">@EnvType</span>
                        </span>
                    </span>
                    <span class="meta-item">
                        <span class="meta-item__label">Apps</span>
                        <span class="meta-item__value">@string.Join(", ", r.Apps)</span>
                    </span>
                    <span class="meta-item">
                        <span class="meta-item__label">Installs</span>
                        <span class="meta-item__value">@DeliveryModeDisplay.Schedule(r.WireSchedule)</span>
                    </span>
                </div>

                @if (r.OutsideWindowWarning is { } windowWarn)
                {
                    <span class="field-warn"><Icon Name="triangle-alert" Width="13" Height="13" />@windowWarn</span>
                }

                @if (!r.PipelineUsesForceSync)
                {
                    <label class="@CheckClass("check ra-check", _force)">
                        <input type="checkbox" checked="@_force" disabled="@_releasing"
                               @onchange="e => SetForce((bool)(e.Value ?? false))" />
                        <span class="check__box ra-check__box"><Icon Name="check" Width="12" Height="12" /></span>
                        <span class="ra-check__text">
                            <span class="ra-check__title">Use Force sync for this deployment only</span>
                            <span class="ra-check__hint">The pipeline stays on @PipelineMode. The next deployment goes back to @PipelineMode.</span>
                        </span>
                    </label>
                    @if (r.FailedOnSchemaChange && !_force)
                    {
                        <span class="field-warn"><Icon Name="triangle-alert" Width="13" Height="13" />The last deployment failed because Business Central refused a schema change. Without Force sync this deployment will most likely fail the same way.</span>
                    }
                    @if (_force)
                    {
                        <label class="@CheckClass("check check--ack", _forceAck)">
                            <input type="checkbox" checked="@_forceAck" disabled="@_releasing"
                                   @onchange="e => _forceAck = (bool)(e.Value ?? false)" />
                            <span class="check__box ra-check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            <span>I understand Force sync can drop columns and permanently lose data in this environment.</span>
                        </label>
                    }
                }

                @if (IsProduction)
                {
                    <label class="@CheckClass("check check--ack", _prodAck)">
                        <input type="checkbox" checked="@_prodAck" disabled="@_releasing"
                               @onchange="e => _prodAck = (bool)(e.Value ?? false)" />
                        <span class="check__box ra-check__box"><Icon Name="check" Width="12" Height="12" /></span>
                        @if (string.Equals(r.EnvironmentName, "Production", StringComparison.OrdinalIgnoreCase))
                        {
                            <span>I understand this installs the apps into <b>@r.CustomerName</b>'s live <b>Production</b> environment.</span>
                        }
                        else
                        {
                            <span>I understand this installs the apps into <b>@r.EnvironmentName</b>, <b>@r.CustomerName</b>'s live <b>Production</b> environment.</span>
                        }
                    </label>
                }

                @if (BlockedText is { } blocked)
                {
                    <span class="field-warn"><Icon Name="triangle-alert" Width="13" Height="13" />@blocked</span>
                }

                @if (_sessionsCheck is { } check)
                {
                    <Alert Tone="AlertTone.Warn" Role="status"><span>@check.Question</span></Alert>
                }

                @if (_error is { } err)
                {
                    <Alert Tone="AlertTone.Danger"><span>@err</span></Alert>
                }
            </div>
            <div class="confirm-dialog__actions">
                <button type="button" class="btn" @onclick="Cancel" disabled="@_releasing">Cancel</button>
                <button type="button" class="btn btn--primary" @onclick="ReleaseAsync" disabled="@(!CanRelease)">
                    <Icon Name="send" Width="14" Height="14" />
                    <span>@(_checkingSessions ? "Checking who is online..." : _releasing ? "Deploying..." : _sessionsCheck is not null ? "Deploy anyway" : "Deploy")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Raised with the new delivery's id once the deployment is queued.</summary>
    [Parameter] public EventCallback<int> OnReleased { get; set; }

    /// <summary>
    /// What the dialog shows and deploys.
    /// </summary>
    /// <param name="DeliveryId">The failed deployment to deploy again.</param>
    /// <param name="ReleasePipelineId">The failed deployment's own deployment pipeline (the one it deploys through again), whose environment is asked who is online before an install that runs right away.</param>
    /// <param name="BuildId">The build it installed.</param>
    /// <param name="BuildSource">Where the build came from, read after its number: "from build pipeline \"Test\"".</param>
    /// <param name="CustomerName">The solution's name, which says whose environment this is.</param>
    /// <param name="EnvironmentName">The target environment.</param>
    /// <param name="EnvironmentType">"Production" or "Sandbox" as Business Central reports it.</param>
    /// <param name="WireSchedule">When Business Central installs, as the deployment will send it.</param>
    /// <param name="PipelineSyncMode">The pipeline's own schema sync mode.</param>
    /// <param name="Apps">The build's apps, in order.</param>
    /// <param name="AlreadyOn">The apps the environment already has at this build's version, which the deployment leaves alone.</param>
    /// <param name="OutsideWindowWarning">Set when deploying now falls outside the environment's delivery window.</param>
    /// <param name="FailedOnSchemaChange">True when Business Central refused a schema change, so deploying again without Force sync will likely fail the same way.</param>
    public sealed record Request(
        int DeliveryId, int ReleasePipelineId, int BuildId, string BuildSource, string CustomerName,
        string EnvironmentName, string? EnvironmentType, string WireSchedule, string PipelineSyncMode,
        IReadOnlyList<string> Apps, IReadOnlyList<string> AlreadyOn, string? OutsideWindowWarning = null,
        bool FailedOnSchemaChange = false)
    {
        /// <summary>True when the pipeline already uses Force sync, so there is nothing to turn on for one deployment.</summary>
        public bool PipelineUsesForceSync => BcSyncMode.Normalize(PipelineSyncMode) == BcSyncMode.ForceSync;
    }

    private Request? _request;
    private bool _focusPending;
    private ElementReference _root;
    private bool _force;
    private bool _forceAck;
    private bool _prodAck;
    private bool _releasing;
    private string? _error;
    // Who was signed in when the person first pressed Deploy; set only when somebody was
    // (or we couldn't tell), and the second press goes ahead. See OpenSessionsCheck.
    private OpenSessionsCheck? _sessionsCheck;
    private bool _checkingSessions;

    /// <summary>True when Business Central installs on arrival, so the people signed in right now are affected.</summary>
    private bool InstallsNow => _request is { } r && !BcDeploymentSchedule.IsDeferred(r.WireSchedule);

    private bool IsProduction => string.Equals(_request?.EnvironmentType, "Production", StringComparison.OrdinalIgnoreCase);
    private string EnvType => string.IsNullOrWhiteSpace(_request?.EnvironmentType) ? "Business Central" : _request!.EnvironmentType!;
    private string PipelineMode => DeliveryModeDisplay.SyncMode(_request?.PipelineSyncMode);
    private string DangerClass => IsProduction ? "confirm-dialog--danger" : "";

    private static string CheckClass(string baseClass, bool on) => on ? baseClass + " is-checked" : baseClass;

    private bool NeedsForceAck => _force && !_forceAck;
    private bool NeedsProdAck => IsProduction && !_prodAck;

    private bool CanRelease => !_releasing && _request is not null && !NeedsForceAck && !NeedsProdAck;

    private string? BlockedText => NeedsForceAck && NeedsProdAck
        ? "Tick both acknowledgements to deploy."
        : NeedsForceAck || NeedsProdAck ? "Tick the acknowledgement to deploy." : null;

    /// <summary>
    /// The sheet's opening sentence: what goes where, when, and which apps stay as they
    /// are. Production is named as the customer's; a sandbox is named by its type.
    /// </summary>
    private string Lead
    {
        get
        {
            var r = _request!;
            var when = BcDeploymentSchedule.Normalize(r.WireSchedule) == BcDeploymentSchedule.Immediate
                ? "right away"
                : $"to install with the {DeliveryModeDisplay.Schedule(r.WireSchedule).ToLowerInvariant()}";
            var where = IsProduction
                ? $"into {r.CustomerName}'s Production environment \"{r.EnvironmentName}\""
                : $"into the {EnvType} environment \"{r.EnvironmentName}\" for {r.CustomerName}";
            var lead = $"This installs build #{r.BuildId} {r.BuildSource} {where}, {when}.";
            if (r.AlreadyOn.Count == 1)
            {
                lead += $" {r.AlreadyOn[0]} is already on this version and is left alone.";
            }
            else if (r.AlreadyOn.Count > 1)
            {
                lead += $" {string.Join(", ", r.AlreadyOn.Take(r.AlreadyOn.Count - 1))} and {r.AlreadyOn[^1]} are already on this version and are left alone.";
            }
            return lead;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _request is not null)
        {
            _focusPending = false;
            try { await _root.FocusAsync(); }
            catch { /* detached */ }
        }
    }

    /// <summary>
    /// Opens the dialog. <paramref name="forceSync"/> pre-ticks the one-time Force sync,
    /// as the failure's "Deploy again with Force sync" button does; the acknowledgement
    /// under it is never pre-ticked.
    /// </summary>
    public Task OpenAsync(Request request, bool forceSync = false)
    {
        _request = request;
        _force = forceSync && !request.PipelineUsesForceSync;
        _forceAck = false;
        _prodAck = false;
        _releasing = false;
        _error = null;
        _sessionsCheck = null;
        _checkingSessions = false;
        _focusPending = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SetForce(bool on)
    {
        _force = on;
        if (!on) _forceAck = false;
    }

    private void Cancel()
    {
        if (_releasing) return;
        _request = null;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc") Cancel();
    }

    private async Task ReleaseAsync()
    {
        if (!CanRelease || _request is not { } r) return;
        _releasing = true;
        _error = null;
        try
        {
            // Before an install that runs right away, ask who is signed in; if anybody is,
            // the person answers "are you sure" with a second press.
            if (InstallsNow && _sessionsCheck is null)
            {
                _checkingSessions = true;
                StateHasChanged();
                var check = await CheckSessionsAsync(r);
                _checkingSessions = false;
                if (check.NeedsConfirmation)
                {
                    _sessionsCheck = check;
                    return;
                }
            }

            var deliveryId = await Deliveries.ReleaseAgainAsync(r.DeliveryId, _force);
            _request = null;
            await OnReleased.InvokeAsync(deliveryId);
        }
        catch (PlanValidationException ex)
        {
            _error = ex.Errors.Values.FirstOrDefault() ?? "Couldn't start the deployment.";
        }
        catch (ProjectAccessDeniedException)
        {
            _error = "Only the solution owner or an admin can deploy this solution's builds.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to deploy delivery {DeliveryId} again.", r.DeliveryId);
            _error = "Couldn't start the deployment.";
        }
        finally
        {
            _releasing = false;
            _checkingSessions = false;
        }
    }

    /// <summary>
    /// Who is signed in to the target. Anything but being refused comes back as a check we
    /// couldn't make, so a fault on our side asks the question rather than blocking the deployment.
    /// </summary>
    private async Task<OpenSessionsCheck> CheckSessionsAsync(Request r)
    {
        try
        {
            return await Deliveries.CheckOpenSessionsAsync(r.ReleasePipelineId);
        }
        catch (Exception ex) when (ex is not (ProjectAccessDeniedException or PlanValidationException))
        {
            Log.LogError(ex, "Failed to check the sessions before deploying delivery {DeliveryId} again.", r.DeliveryId);
            return OpenSessionsCheck.Unknown(r.EnvironmentName, "Something went wrong at our end.");
        }
    }
}
