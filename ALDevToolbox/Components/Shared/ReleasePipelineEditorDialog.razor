@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.PipelineService Pipelines
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.ReleasePipelineService Releases
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connections
@inject ALDevToolbox.Services.GitHub.GitHubReleaseService GitHubReleases
@inject ILogger<ReleasePipelineEditorDialog> Log
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer

@*
    Create / edit a deployment pipeline: name it, pick the source build pipeline whose
    builds it publishes, the target Business Central environment, and when installs
    run / how they reconcile schema. Force sync is gated behind an explicit
    acknowledgement because it can drop columns. Opened imperatively via
    OpenForCreateAsync / OpenForEditAsync; raises OnSaved with the deployment pipeline id.
    Deploying a build (the "Deploy" action) lives on the pipeline's own page — this
    dialog only configures the reusable target. See .design/saas-delivery.md.

    Named user: a BC consultant who has connected a customer's environment and wants a
    reusable "publish this build to Production" target.
*@

@if (_open)
{
    <div class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="rpe-title"
         tabindex="-1" @onkeydown="OnKeyDown" @ref="_root">
        <div class="modal-backdrop" @onclick="Cancel" aria-hidden="true"></div>
        <div class="confirm-dialog confirm-dialog--wide" @onclick:stopPropagation>
            <div class="confirm-dialog__head">
                <span class="confirm-dialog__icon" aria-hidden="true">
                    <Icon Name="send" Width="17" Height="17" />
                </span>
                <h2 id="rpe-title" class="confirm-dialog__title">@(_editing ? "Edit deployment pipeline" : "New deployment pipeline")</h2>
            </div>
            <div class="confirm-dialog__body">
                @if (_nextStep is { } nextStep)
                {
                    <p>@nextStep</p>
                }
                @if (!_pickProject && !string.IsNullOrEmpty(_projectName))
                {
                    <div class="field">
                        <span class="field__label">Solution</span>
                        <span class="field__value">@_projectName</span>
                    </div>
                }

                @if (_pickProject)
                {
                    <div class="field">
                        <label class="field__label" for="rpe-solution">Solution</label>
                        <SelectBox>
                            <select id="rpe-solution" class="select" @onchange="OnProjectChosenAsync" disabled="@_saving">
                                <option value="0" selected="@(_projectId == 0)">Choose a solution...</option>
                                @foreach (var p in _projectOptions ?? [])
                                {
                                    <option value="@p.Id" selected="@(_projectId == p.Id)">@p.Name</option>
                                }
                            </select>
                        </SelectBox>
                    </div>
                }

                @if (_pickProject && _projectId == 0)
                {
                    <p>Choose a customer solution to set up a deployment pipeline for.</p>
                }
                else if (_loading)
                {
                    <div class="loading-block loading-block--under-table">
                        <span class="spinner"></span>
                        <span>Loading the solution's build pipelines and environments...</span>
                    </div>
                }
                else if (_buildPipelines is { Count: 0 } && _releaseRepositories is not { Count: > 0 })
                {
                    <p>
                        This solution has no build pipeline yet. A deployment installs compiled apps, so
                        create a build pipeline first on the
                        <a href="@($"/solutions/{_projectId}?tab=pipelines")">solution's Pipelines tab</a>.
                    </p>
                }
                else if (_environments is { Count: 0 })
                {
                    <p>
                        This solution has no Business Central environments yet. Connect Business Central
                        on the <a href="@($"/solutions/{_projectId}?tab=bc")">solution's Business Central tab</a>
                        and refresh its environments, then come back.
                    </p>
                }
                else if (_buildPipelines is not null && _environments is not null)
                {
                    <div class="field">
                        <label class="field__label" for="rpe-name">Name</label>
                        <input id="rpe-name" type="text" class="input" maxlength="200" @bind="_name"
                               disabled="@_saving" placeholder="e.g. CRONUS App to Production" />
                        <small class="field__hint">Name it for what it publishes and where, so a colleague can tell your deployment pipelines apart.</small>
                    </div>

                    @if (_releaseRepositories is { Count: > 0 })
                    {
                        <div class="field">
                            <label class="field__label" for="rpe-source">Where the apps come from</label>
                            <SelectBox>
                                <select id="rpe-source" class="select" @bind="_artifactSource" @bind:after="SuggestName" disabled="@_saving">
                                    <option value="@ReleaseArtifactSource.Build">Builds from a build pipeline</option>
                                    <option value="@ReleaseArtifactSource.GithubRelease">Releases published on a GitHub repository</option>
                                </select>
                            </SelectBox>
                            <small class="field__hint">Choose GitHub releases when the apps were built somewhere else. AL Workbench installs whatever is attached to the release you pick.</small>
                        </div>
                    }

                    @if (_artifactSource == ReleaseArtifactSource.GithubRelease)
                    {
                        <div class="field">
                            <label class="field__label" for="rpe-repo">Repository to deploy from</label>
                            <SelectBox>
                                <select id="rpe-repo" class="select" @bind="_releaseRepositoryId" @bind:after="SuggestName" disabled="@_saving">
                                    <option value="0">Choose a repository...</option>
                                    @foreach (var repo in _releaseRepositories ?? [])
                                    {
                                        <option value="@repo.Id">@repo.FullName</option>
                                    }
                                </select>
                            </SelectBox>
                            <small class="field__hint">Its releases are what this pipeline installs. Only the .app files attached to the release are installed; other attachments are ignored.</small>
                        </div>
                    }
                    else if (_buildPipelines is { Count: > 0 })
                    {
                        <div class="field">
                            <label class="field__label" for="rpe-build">Build pipeline to deploy from</label>
                            <SelectBox>
                                <select id="rpe-build" class="select" @bind="_buildPipelineId" @bind:after="SuggestName" disabled="@_saving">
                                    <option value="0">Choose a build pipeline...</option>
                                    @foreach (var bp in _buildPipelines)
                                    {
                                        <option value="@bp.Id">@bp.Name</option>
                                    }
                                </select>
                            </SelectBox>
                            <small class="field__hint">Its successful builds are what this pipeline deploys.</small>
                        </div>
                    }
                    else
                    {
                        <Alert Tone="AlertTone.Info" Role="status">
                            <span>
                                Pick a GitHub repository above, or create a build pipeline first on the
                                <a href="@($"/solutions/{_projectId}?tab=pipelines")">solution's Pipelines tab</a>.
                                You can't save until one of the two is chosen.
                            </span>
                        </Alert>
                    }

                    <div class="field">
                        <label class="field__label" for="rpe-env">Target environment</label>
                        <SelectBox>
                            <select id="rpe-env" class="select" @bind="_environmentId" @bind:after="SuggestName" disabled="@_saving">
                                <option value="0">Choose an environment...</option>
                                @foreach (var env in _environments)
                                {
                                    var typeSuffix = env.Name.Equals(env.Type, StringComparison.OrdinalIgnoreCase) ? "" : $" ({env.Type})";
                                    var status = BcEnvironmentStatus.Humanise(env.Status);
                                    var statusSuffix = $" — {(status.Length > 0 ? status : "not checked yet")}";
                                    <option value="@env.Id">@env.Name@typeSuffix@statusSuffix</option>
                                }
                            </select>
                        </SelectBox>
                        <small class="field__hint">Where the apps are installed — every app in the build goes to this one. Each environment's status is shown: you can pick one that's busy, but deployments to it are refused until Business Central reports it ready.</small>
                    </div>

                    <div class="field">
                        <label class="field__label" for="rpe-schedule">When a deployment installs</label>
                        <SelectBox>
                            <select id="rpe-schedule" class="select" @bind="_deploymentSchedule" disabled="@_saving">
                                @if (!BcDeploymentSchedule.Pickable.Contains(_deploymentSchedule))
                                {
                                    <option value="@_deploymentSchedule" disabled>No longer available - choose one</option>
                                }
                                @foreach (var mode in BcDeploymentSchedule.Pickable)
                                {
                                    var unavailable = BcDeploymentSchedule.IsOurDeliveryWindow(mode) && !ChosenEnvironmentHasWindow;
                                    <option value="@mode" disabled="@unavailable">@DeliveryModeDisplay.ScheduleChoice(mode, ChosenEnvironment?.Name)@(unavailable && ChosenEnvironment is not null ? " (none set yet)" : "")</option>
                                }
                            </select>
                        </SelectBox>
                        <small class="field__hint">A deployment starts when you press Deploy or approve a prepared one. This is when it installs.</small>
                        @if (ChosenEnvironment is { } chosenEnv && !ChosenEnvironmentHasWindow)
                        {
                            @if (BcDeploymentSchedule.IsOurDeliveryWindow(_deploymentSchedule))
                            {
                                <small class="field__hint">
                                    @chosenEnv.Name has no delivery window yet.
                                    <a href="@($"/environments/{chosenEnv.Id}")" target="_blank" rel="noopener">Set one on the environment's page</a>
                                    (opens in a new tab), or choose another time for installs.
                                </small>
                            }
                            else
                            {
                                <small class="field__hint">@ScheduleHint</small>
                                <small class="field__hint">
                                    To install in @(chosenEnv.Name)'s delivery window, first
                                    <a href="@($"/environments/{chosenEnv.Id}")" target="_blank" rel="noopener">set one on the environment's page</a>
                                    (opens in a new tab).
                                </small>
                            }
                        }
                        else
                        {
                            <small class="field__hint">@ScheduleHint</small>
                        }
                    </div>

                    <div class="field">
                        <label class="field__label" for="rpe-sync">Schema sync</label>
                        <SelectBox>
                            <select id="rpe-sync" class="select" @bind="_schemaSyncMode" disabled="@_saving">
                                @if (!BcSyncMode.IsValid(_schemaSyncMode))
                                {
                                    <option value="@_schemaSyncMode" disabled>No longer available - choose one</option>
                                }
                                @foreach (var mode in BcSyncMode.All)
                                {
                                    <option value="@mode">@DeliveryModeDisplay.SyncMode(mode)</option>
                                }
                            </select>
                        </SelectBox>
                        <small class="field__hint"><b>Add</b> only ever adds — the safe default. <b>Force sync</b> can drop table columns and lose data.</small>
                    </div>

                    @if (_schemaSyncMode == BcSyncMode.ForceSync)
                    {
                        <label class="check check--ack @(_forceSyncAck ? "is-checked" : "")">
                            <input type="checkbox" checked="@_forceSyncAck"
                                   @onchange="e => _forceSyncAck = (bool)(e.Value ?? false)" disabled="@_saving" />
                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            <span>I understand Force sync can drop columns and permanently lose data in this environment.</span>
                        </label>
                    }

                    @* Only a build pipeline has "a new build" to follow (#934). *@
                    @if (_artifactSource == ReleaseArtifactSource.Build)
                    {
                        <div class="field">
                            <label class="check">
                                <input type="checkbox" checked="@_prepareOnNewBuild" disabled="@_saving"
                                       @onchange="e => _prepareOnNewBuild = (bool)(e.Value ?? false)" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>Prepare a deployment when a new build succeeds</span>
                            </label>
                            <small class="field__hint">The deployment waits on this pipeline's page until someone approves it. A newer build replaces one still waiting. Nothing is installed before then.</small>
                        </div>
                    }
                }

                @if (_saveError is { } se)
                {
                    <Alert Tone="AlertTone.Danger"><span>@se</span></Alert>
                }
            </div>
            <div class="confirm-dialog__actions">
                <button type="button" class="btn" @onclick="Cancel" disabled="@_saving">Cancel</button>
                <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@(!CanSave)">
                    <Icon Name="@(_editing ? "save" : "plus")" Width="14" Height="14" />
                    <span>@(_saving ? "Saving..." : _editing ? "Save deployment pipeline" : "Create deployment pipeline")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Raised with the saved deployment pipeline's id after a successful create/edit.</summary>
    [Parameter] public EventCallback<int> OnSaved { get; set; }

    private bool _open;
    private bool _focusPending;
    private ElementReference _root;
    private bool _editing;
    private bool _pickProject;
    private IReadOnlyList<PipelineProjectOption>? _projectOptions;
    private int _projectId;
    private string? _projectName;
    private int? _releasePipelineId;
    private string? _nextStep;

    private string _name = string.Empty;

    /// <summary>
    /// The name this dialog last filled in by itself, or null when the Name holds
    /// nothing it wrote. While the Name still equals it (or is empty) the person
    /// hasn't typed one, so a new source or environment may replace it; anything
    /// else is theirs and is never overwritten (issue #933).
    /// </summary>
    private string? _suggestedName;
    private string _artifactSource = ReleaseArtifactSource.Build;
    private int _buildPipelineId;
    private int _releaseRepositoryId;
    private int _environmentId;
    private string _deploymentSchedule = BcDeploymentSchedule.Immediate;
    private string _schemaSyncMode = BcSyncMode.Add;
    private bool _forceSyncAck;
    private bool _prepareOnNewBuild;

    private bool _loading;
    private bool _saving;
    private string? _saveError;
    private List<OePipeline>? _buildPipelines;
    private List<ProjectEnvironmentRow>? _environments;
    // The solution's GitHub repositories inside the connected organisation. Empty when
    // there is no GitHub connection, and then the source choice isn't offered at all.
    private IReadOnlyList<GitHubReleaseRepositoryOption>? _releaseRepositories;

    /// <summary>
    /// True when the repository list could not be read at all, as opposed to
    /// there being none. A pipeline that draws from GitHub cannot be saved while
    /// this stands: the picker would be empty for a reason that has nothing to do
    /// with the solution.
    /// </summary>
    private bool _repositoriesFailed;

    /// <summary>The environment currently picked as the target, or null before one is chosen.</summary>
    private ProjectEnvironmentRow? ChosenEnvironment =>
        _environmentId == 0 ? null : _environments?.FirstOrDefault(e => e.Id == _environmentId);

    /// <summary>
    /// Whether the picked environment has a delivery window. The "in its delivery
    /// window" choice is offered only when it does, and re-evaluated whenever the
    /// environment changes, because the window belongs to the environment.
    /// </summary>
    private bool ChosenEnvironmentHasWindow =>
        ChosenEnvironment is { } env && UpdateWindow.IsConfigured(env.UpdateWindowStart, env.UpdateWindowEnd);

    /// <summary>What the chosen timing does, in a sentence.</summary>
    private string ScheduleHint
    {
        get
        {
            if (BcDeploymentSchedule.IsOurDeliveryWindow(_deploymentSchedule))
            {
                return ChosenEnvironment is { } env && ChosenEnvironmentHasWindow
                    ? $"Deployments are scheduled for the next opening of the delivery window agreed with the customer for {env.Name} ({env.UpdateWindowStart:HH:mm}-{env.UpdateWindowEnd:HH:mm}, solution's time zone). This is not Business Central's own update window. The person releasing can still choose to release now."
                    : "Deployments default to the next opening of the environment's delivery window.";
            }
            return BcDeploymentSchedule.Normalize(_deploymentSchedule) switch
            {
                BcDeploymentSchedule.NextMinorUpdate => "Hands the app to Business Central, which installs it with the environment's next minor update.",
                BcDeploymentSchedule.NextMajorUpdate => "Hands the app to Business Central, which installs it with the environment's next major update.",
                _ => "Installs as soon as the deployment is sent.",
            };
        }
    }

    /// <summary>The Save button is live once the required fields are chosen and any Force-Sync acknowledgement is given.</summary>
    private bool CanSave =>
        !_saving && !_loading
        && _environments is { Count: > 0 }
        && !string.IsNullOrWhiteSpace(_name)
        && (_artifactSource == ReleaseArtifactSource.GithubRelease
            ? _releaseRepositoryId != 0 && !_repositoriesFailed
            : _buildPipelines is { Count: > 0 } && _buildPipelineId != 0)
        && _environmentId != 0
        && (!BcDeploymentSchedule.IsOurDeliveryWindow(_deploymentSchedule) || ChosenEnvironmentHasWindow)
        && (_schemaSyncMode != BcSyncMode.ForceSync || _forceSyncAck);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _open)
        {
            _focusPending = false;
            try { await _root.FocusAsync(); }
            catch { /* element already detached */ }
        }
    }

    /// <summary>
    /// Opens the dialog to create a new deployment pipeline under a fixed solution.
    /// <paramref name="buildPipelineId"/> fills in the source when the person came
    /// from that build pipeline's page (#938); <paramref name="nextStep"/> says what
    /// follows the save when this is one step of a longer task.
    /// </summary>
    public async Task OpenForCreateAsync(int projectId, string projectName, int? buildPipelineId = null, string? nextStep = null)
    {
        Reset();
        _buildPipelineId = buildPipelineId ?? 0;
        _nextStep = nextStep;
        _pickProject = false;
        _projectId = projectId;
        _projectName = projectName;
        _open = true;
        _focusPending = true;
        await LoadProjectAsync();
    }

    /// <summary>Opens the dialog to create a new deployment pipeline, letting the user pick the solution.</summary>
    public Task OpenForCreateAsync(IReadOnlyList<PipelineProjectOption> solutions)
    {
        Reset();
        _pickProject = true;
        _projectOptions = solutions;
        _projectId = 0;
        _projectName = null;
        _open = true;
        _focusPending = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Opens the dialog to edit an existing deployment pipeline.</summary>
    public async Task OpenForEditAsync(ReleasePipelineRow row)
    {
        Reset();
        _editing = true;
        _pickProject = false;
        _projectId = row.ProjectId;
        _releasePipelineId = row.Id;
        _name = row.Name;
        _artifactSource = ReleaseArtifactSource.IsValid(row.ArtifactSource) ? row.ArtifactSource : ReleaseArtifactSource.Build;
        _buildPipelineId = row.BuildPipelineId ?? 0;
        _releaseRepositoryId = row.GithubReleaseRepositoryId ?? 0;
        _environmentId = row.ProjectEnvironmentId;
        _deploymentSchedule = row.DeploymentSchedule;
        _schemaSyncMode = row.SchemaSyncMode;
        _forceSyncAck = row.SchemaSyncMode == BcSyncMode.ForceSync; // already-saved choice is pre-acknowledged
        _prepareOnNewBuild = row.PrepareReleaseOnNewBuild;
        _open = true;
        _focusPending = true;
        await LoadProjectAsync();
    }

    private void Reset()
    {
        _editing = false;
        _releasePipelineId = null;
        _name = string.Empty;
        _suggestedName = null;
        _artifactSource = ReleaseArtifactSource.Build;
        _buildPipelineId = 0;
        _releaseRepositoryId = 0;
        _environmentId = 0;
        _deploymentSchedule = BcDeploymentSchedule.Immediate;
        _schemaSyncMode = BcSyncMode.Add;
        _forceSyncAck = false;
        _prepareOnNewBuild = false;
        _saveError = null;
        _buildPipelines = null;
        _environments = null;
        _releaseRepositories = null;
        _projectName = null;
        _nextStep = null;
    }

    private async Task OnProjectChosenAsync(ChangeEventArgs e)
    {
        _projectId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _buildPipelines = null;
        _environments = null;
        _releaseRepositories = null;
        _releaseRepositoryId = 0;
        // The previous solution's picks mean nothing here: its build pipeline and
        // environment ids would otherwise survive, invisible, into the save.
        _artifactSource = ReleaseArtifactSource.Build;
        _buildPipelineId = 0;
        _environmentId = 0;
        SuggestName();
        if (_projectId != 0) await LoadProjectAsync();
    }

    /// <summary>
    /// On create, names the pipeline "{source} to {environment}" once both are chosen,
    /// so nobody has to invent a name for something the form already knows. Only a
    /// name this dialog suggested is replaced - one the person typed is kept - and
    /// an existing pipeline's name is never touched. A clash with another pipeline's
    /// name is still caught by the save.
    /// </summary>
    private void SuggestName()
    {
        if (_editing) return;
        if (!string.IsNullOrWhiteSpace(_name) && _name != _suggestedName) return;

        var source = _artifactSource == ReleaseArtifactSource.GithubRelease
            ? _releaseRepositories?.FirstOrDefault(r => r.Id == _releaseRepositoryId)?.DisplayName
            : _buildPipelines?.FirstOrDefault(p => p.Id == _buildPipelineId)?.Name;
        var environment = _environments?.FirstOrDefault(e => e.Id == _environmentId)?.Name;

        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(environment))
        {
            // A half-made choice leaves no stale suggestion behind.
            _name = string.Empty;
            _suggestedName = null;
            return;
        }

        var suggestion = $"{source.Trim()} to {environment.Trim()}";
        if (suggestion.Length > NameMaxLength) suggestion = suggestion[..NameMaxLength].TrimEnd();
        _name = suggestion;
        _suggestedName = suggestion;
    }

    /// <summary>Mirrors the Name input's <c>maxlength</c>.</summary>
    private const int NameMaxLength = 200;

    /// <summary>
    /// Loads the chosen solution's active build pipelines and the environments still
    /// present in Business Central. Both feed the pickers; an empty list drives the
    /// guidance states above.
    /// </summary>
    private async Task LoadProjectAsync()
    {
        _loading = true;
        _saveError = null;
        _repositoriesFailed = false;
        StateHasChanged();
        try
        {
            _buildPipelines = await Pipelines.ListPipelinesAsync(_projectId);
            // Never fails the dialog: without a GitHub connection the source choice
            // isn't offered and the pipeline draws from a build pipeline as before.
            try
            {
                _releaseRepositories = await GitHubReleases.ListRepositoryOptionsAsync(_projectId);
            }
            catch (Exception ex)
            {
                Log.LogError(ex, "Reading the solution's GitHub repositories failed for solution {ProjectId}.", _projectId);
                _releaseRepositories = null;
                // Saying nothing here would leave somebody editing a pipeline that
                // already draws from GitHub staring at an empty picker with no
                // reason given - and Save is refused below while this stands.
                _repositoriesFailed = true;
                _saveError = "The repositories on GitHub could not be read just now. Close this and try again.";
            }
            var envs = await Connections.ListEnvironmentsAsync(_projectId);
            // Every environment still present is a valid target - an extension installs
            // into the environment, so there is nothing further to choose inside one.
            // Keep an environment that's the current edit's target even if it's since gone
            // missing, so editing doesn't silently drop the existing selection.
            _environments = envs
                .Where(env => env.MissingSince is null || env.Id == _environmentId)
                .ToList();
        }
        catch (ProjectAccessDeniedException)
        {
            _saveError = "Only the solution owner or an admin can manage this solution's deployment pipelines.";
            _buildPipelines = new();
            _environments = new();
            _releaseRepositories = null;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Loading deployment pipeline options failed for solution {ProjectId}.", _projectId);
            _saveError = "Couldn't load the solution's build pipelines and environments.";
            _buildPipelines = new();
            _environments = new();
            _releaseRepositories = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        if (_saving) return;
        _open = false;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc") Cancel();
    }

    private async Task SaveAsync()
    {
        if (!CanSave) return;
        _saving = true;
        _saveError = null;
        try
        {
            var input = new ReleasePipelineInput(
                _projectId, _name.Trim(), _buildPipelineId, _environmentId, _deploymentSchedule, _schemaSyncMode,
                _artifactSource,
                _releaseRepositoryId == 0 ? null : _releaseRepositoryId,
                _prepareOnNewBuild && _artifactSource == ReleaseArtifactSource.Build);

            int id;
            if (_editing && _releasePipelineId is { } rid)
            {
                await Releases.UpdateReleasePipelineAsync(rid, input);
                id = rid;
            }
            else
            {
                id = await Releases.CreateReleasePipelineAsync(input);
            }
            _open = false;
            await OnSaved.InvokeAsync(id);
        }
        catch (PlanValidationException ex)
        {
            _saveError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't save the deployment pipeline.";
        }
        catch (ProjectAccessDeniedException)
        {
            _saveError = "Only the solution owner or an admin can manage this solution's deployment pipelines.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save deployment pipeline for solution {ProjectId}.", _projectId);
            _saveError = "Couldn't save the deployment pipeline.";
        }
        finally
        {
            _saving = false;
        }
    }
}
