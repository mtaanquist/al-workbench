@*
    Two-button modal that resolves a Task<bool> when the user picks. Use it via:

      <ConfirmDialog @ref="_confirm" Title="Delete X?" Message="..." ConfirmLabel="Delete" />
      ...
      if (await _confirm.OpenAsync()) { ... }

    Built as a plain CSS overlay rather than the native <dialog> element so it
    works without a JS interop hop and renders consistently inside the
    InteractiveServer pages we use it from.

    The head icon and the danger tint are derived from ConfirmButtonClass rather
    than taking a parameter of their own: a caller that already asked for a red
    confirm button has already said the action is destructive, and every caller
    would otherwise have to repeat itself.
*@

@implements IDisposable

@if (_open)
{
    <div class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="@_titleId"
         @onkeydown="OnKeyDown" @onkeydown:stopPropagation tabindex="-1">
        <div class="modal-backdrop" @onclick="Cancel" aria-hidden="true"></div>
        <div class="confirm-dialog @(_danger ? "confirm-dialog--danger" : null) @(Wide ? "confirm-dialog--wide" : null)" @onclick:stopPropagation>
            <div class="confirm-dialog__head">
                <span class="confirm-dialog__icon" aria-hidden="true">
                    <Icon Name="@(HeadIcon ?? (_danger ? "triangle-alert" : "info"))" Width="17" Height="17" />
                </span>
                <h2 id="@_titleId" class="confirm-dialog__title">@_title</h2>
            </div>
            @if (_phase == Phase.Counting)
            {
                @* The second thought. Nothing has left the building yet, and the bar
                   is the time left to say so. It drains by CSS over the whole grace
                   period; the number beside it is what a screen reader hears. *@
                @if (GraceContent is not null)
                {
                    <div class="confirm-dialog__body confirm-dialog__detail">@GraceContent</div>
                }
                <div class="confirm-dialog__body confirm-dialog__grace">
                    <p role="status">Starting in @_secondsLeft @(_secondsLeft == 1 ? "second" : "seconds"). Nothing has been sent yet.</p>
                    <div class="confirm-dialog__grace-bar" aria-hidden="true">
                        <span style="animation-duration: @(GraceSeconds)s"></span>
                    </div>
                </div>
                <div class="confirm-dialog__actions">
                    <button type="button" class="btn" @onclick="Proceed">Start now</button>
                    <button type="button" class="btn" @onclick="Cancel" @ref="_confirmButton">Cancel - send nothing</button>
                </div>
            }
            else if (_phase == Phase.Working)
            {
                <div class="confirm-dialog__body confirm-dialog__detail">@WorkingContent</div>
            }
            else
            {
            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="confirm-dialog__body">@_message</div>
            }
            @* Optional richer body - a caller that has to show *which* things it is
               about to act on (a list of environments, say) can't say that in a
               single sentence. Rendered under the message so the sentence still
               leads. *@
            @if (ChildContent is not null)
            {
                <div class="confirm-dialog__body confirm-dialog__detail">@ChildContent</div>
            }
            @* Type-to-confirm. Reserved for an action that is immediate and cannot
               be taken back - it makes the person read the sentence above before
               their hands can finish the click. *@
            @if (!string.IsNullOrWhiteSpace(RequireWord))
            {
                <div class="confirm-dialog__body confirm-dialog__gate">
                    <label class="confirm-dialog__gate-label" for="@_gateId">
                        Type <b>@RequireWord</b> to continue
                    </label>
                    <input id="@_gateId" type="text" class="input"
                           autocomplete="off" spellcheck="false"
                           value="@_typed" @oninput="OnTypedChanged" @ref="_gateInput" />
                </div>
            }
            <div class="confirm-dialog__actions">
                @* Focus sentinels close the focus cycle (Tab from the last
                   button wraps back to the first, Shift+Tab from the first
                   button wraps to the last). Cheap focus trap without a JS
                   interop hop. *@
                <span tabindex="0" class="u-sr"
                      @onfocus="FocusLastAction" aria-hidden="true"></span>
                <button type="button" class="btn" @onclick="Cancel" @ref="_cancelButton">@CancelLabel</button>
                <button type="button" class="btn @_confirmButtonClass" @onclick="Confirm" autofocus @ref="_confirmButton"
                        disabled="@(!_wordMatches || ConfirmDisabled)">
                    @if (!string.IsNullOrEmpty(_confirmIcon))
                    {
                        <Icon Name="@_confirmIcon" Width="14" Height="14" />
                    }
                    <span>@_confirmLabel</span>
                </button>
                <span tabindex="0" class="u-sr"
                      @onfocus="FocusFirstAction" aria-hidden="true"></span>
            </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Default title used when <see cref="OpenAsync"/> is called without an override.</summary>
    [Parameter] public string Title { get; set; } = "Are you sure?";
    /// <summary>Default message used when <see cref="OpenAsync"/> is called without an override.</summary>
    [Parameter] public string Message { get; set; } = string.Empty;
    /// <summary>Default confirm label used when <see cref="OpenAsync"/> is called without an override.</summary>
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    /// <summary>Default confirm-button class used when <see cref="OpenAsync"/> is called without an override.</summary>
    [Parameter] public string ConfirmButtonClass { get; set; } = "btn--danger";
    /// <summary>Default confirm icon used when <see cref="OpenAsync"/> is called without an override.</summary>
    [Parameter] public string? ConfirmIcon { get; set; }

    /// <summary>
    /// The glyph in the head, for a confirm that is a warning without being destructive -
    /// marking an upgrade done with lines still unchecked is a pause, not a delete, so it
    /// keeps the neutral tint and takes the warning glyph. Null derives it from the
    /// confirm button as before.
    /// </summary>
    [Parameter] public string? HeadIcon { get; set; }

    /// <summary>
    /// Extra body content under the message - for a confirm that has to show the
    /// caller *which* rows it is about to act on. Optional; a plain message-only
    /// confirm passes nothing and renders exactly as before.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gives the panel the wider layout the design system already defines, for a
    /// dialog that carries a list rather than a yes/no sentence.
    /// </summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>
    /// Holds the confirm button disabled for a reason of the caller's own — a dialog whose
    /// body carries a choice the caller can see is not yet valid (a booking time that has
    /// already passed, say). The caller shows why; this only stops the click. Independent
    /// of <see cref="RequireWord"/>: either can hold the button.
    /// </summary>
    [Parameter] public bool ConfirmDisabled { get; set; }

    /// <summary>
    /// Seconds between pressing confirm and the answer reaching the caller, shown as a
    /// draining bar with a way out. For an action that is sent somewhere it cannot be
    /// recalled from: the person gets one last look at what they agreed to, and until
    /// the bar runs out nothing has happened. Zero (the default) answers at once.
    /// </summary>
    [Parameter] public int GraceSeconds { get; set; }

    /// <summary>
    /// Shown above the draining bar: what is about to happen, without the controls that
    /// chose it. The grace period is for noticing the wrong customer, which takes the
    /// list of customers still being on screen.
    /// </summary>
    [Parameter] public RenderFragment? GraceContent { get; set; }

    /// <summary>
    /// When set, the dialog stays open after a yes and shows this in place of the
    /// question - progress, and anything that can still be stopped - until the caller
    /// calls <see cref="Close"/>. The work is then reported where it was asked for,
    /// rather than somewhere else on the page behind a scrim that has just gone.
    /// </summary>
    [Parameter] public RenderFragment? WorkingContent { get; set; }

    /// <summary>
    /// When set, the confirm button stays disabled until the person types this word.
    /// The deliberate speed bump in front of an action that starts immediately on
    /// someone else's production system and cannot be undone. Matched trimmed and
    /// case-insensitively - this is a pause, not a spelling test.
    /// </summary>
    [Parameter] public string? RequireWord { get; set; }

    private readonly string _titleId = $"confirm-{Guid.NewGuid():N}";
    private readonly string _gateId = $"confirm-gate-{Guid.NewGuid():N}";
    private string _typed = string.Empty;

    /// <summary>True when the confirm button may be pressed - always, unless a word is required.</summary>
    private bool _wordMatches =>
        string.IsNullOrWhiteSpace(RequireWord)
        || string.Equals(_typed.Trim(), RequireWord.Trim(), StringComparison.OrdinalIgnoreCase);

    private void OnTypedChanged(ChangeEventArgs e) => _typed = e.Value?.ToString() ?? string.Empty;
    private bool _open;
    private bool _needsFocus;
    private TaskCompletionSource<bool>? _tcs;
    private string _title = string.Empty;
    private string _message = string.Empty;
    private string _confirmLabel = "Confirm";
    private string _confirmButtonClass = "btn--danger";
    private string? _confirmIcon;

    /// <summary>
    /// Whether this is a destructive confirm, which tints the panel and picks the
    /// warning glyph. Read off the confirm button rather than a parameter of its
    /// own - see the note at the top of the file.
    /// </summary>
    private bool _danger => _confirmButtonClass.Contains("danger", StringComparison.Ordinal);

    private ElementReference _confirmButton;
    private ElementReference _gateInput;
    private ElementReference _cancelButton;

    protected override void OnParametersSet()
    {
        // Mirror the parameter defaults onto the runtime fields so callers that
        // never invoke the overload get the values from the markup.
        //
        // Also while open, for a dialog opened on its own parameters: a caller whose
        // body offers a choice that changes what the confirm means (run this now, or
        // book it for tonight) has to be able to re-voice the title, the message and
        // the button without closing and reopening. A caller that passed overrides to
        // OpenAsync keeps them - those were chosen for this one invocation and must not
        // be overwritten by the markup's defaults.
        if (!_open || !_openedWithOverrides)
        {
            _title = Title;
            _message = Message;
            _confirmLabel = ConfirmLabel;
            _confirmButtonClass = ConfirmButtonClass;
            _confirmIcon = ConfirmIcon;
        }
    }

    /// <summary>
    /// True while the dialog is on screen. For a page that refreshes its rows on a timer:
    /// the rows a person is reading in the dialog must not move under them.
    /// </summary>
    public bool IsOpen => _open;

    /// <summary>Opens the dialog with the current default parameters.</summary>
    public Task<bool> OpenAsync()
    {
        var task = OpenAsync(Title, Message, ConfirmLabel, ConfirmButtonClass, ConfirmIcon);
        _openedWithOverrides = false;
        return task;
    }

    /// <summary>
    /// True when the open call supplied its own title/message/labels, which then outrank
    /// the markup's defaults for as long as the dialog stays open.
    /// </summary>
    private bool _openedWithOverrides;

    /// <summary>
    /// Opens the dialog with per-invocation overrides. Lets a single dialog
    /// instance serve multiple call sites (e.g. one bulk-action bar with
    /// several action types) without mutating component parameters directly,
    /// which trips BL0005.
    /// </summary>
    public Task<bool> OpenAsync(string title, string message, string confirmLabel, string confirmButtonClass = "btn--danger", string? confirmIcon = null)
    {
        _title = title;
        _message = message;
        _confirmLabel = confirmLabel;
        _confirmButtonClass = confirmButtonClass;
        _confirmIcon = confirmIcon;
        _openedWithOverrides = true;
        // Replace any previous unresolved task with a fresh one so re-opening
        // the same dialog doesn't leak the prior caller's continuation.
        _tcs?.TrySetResult(false);
        _tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        // A previous run's typed word must never carry over - the speed bump only
        // works if it is there every time.
        _typed = string.Empty;
        StopCountdown();
        _phase = Phase.Asking;
        _open = true;
        _needsFocus = true;
        StateHasChanged();
        return _tcs.Task;
    }

    /// <summary>
    /// Moves focus into the dialog the first time it renders open. The markup's
    /// `autofocus` is not enough on its own: browsers honour it when the element
    /// arrives with the document, not when Blazor inserts it later. Without this
    /// the trigger button keeps focus, so Tab walks the page behind the scrim and
    /// Escape never reaches the handler on the layer - a dialog you cannot close
    /// from the keyboard, and one a screen reader is never told about.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_needsFocus)
        {
            return;
        }

        _needsFocus = false;
        // With a required word the confirm button starts disabled and cannot take
        // focus, so the caret goes where the person has to act: the input.
        try
        {
            if (!string.IsNullOrWhiteSpace(RequireWord)) await _gateInput.FocusAsync();
            else await _confirmButton.FocusAsync();
        }
        catch { /* closed again before the render landed */ }
    }

    private enum Phase { Asking, Counting, Working }

    private Phase _phase;
    private int _secondsLeft;
    private CancellationTokenSource? _graceCts;

    private void Confirm()
    {
        // The disabled button already blocks the click; this closes the keyboard
        // route, so the gate can't be stepped over by pressing Enter.
        if (!_wordMatches || ConfirmDisabled) return;
        if (GraceSeconds <= 0)
        {
            Proceed();
            return;
        }

        _phase = Phase.Counting;
        _secondsLeft = GraceSeconds;
        _needsFocus = true;
        _graceCts = new CancellationTokenSource();
        _ = CountDownAsync(_graceCts.Token);
    }

    private async Task CountDownAsync(CancellationToken ct)
    {
        try
        {
            while (_secondsLeft > 0)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), ct);
                _secondsLeft--;
                await InvokeAsync(StateHasChanged);
            }
            await InvokeAsync(Proceed);
        }
        catch (OperationCanceledException)
        {
            // Cancelled, or "Start now" got there first.
        }
    }

    /// <summary>The answer is yes: hand it to the caller, and stay open only if there is work to show.</summary>
    private void Proceed()
    {
        if (_tcs is null) return;
        StopCountdown();
        if (WorkingContent is null) _open = false;
        else _phase = Phase.Working;
        _tcs.TrySetResult(true);
        _tcs = null;
        StateHasChanged();
    }

    private void Cancel()
    {
        // Once the work has started there is nothing to cancel from here; the
        // caller's own content carries whatever can still be stopped.
        if (_phase == Phase.Working) return;
        StopCountdown();
        _open = false;
        _tcs?.TrySetResult(false);
        _tcs = null;
    }

    /// <summary>Closes a dialog that stayed open to show <see cref="WorkingContent"/>.</summary>
    public void Close()
    {
        StopCountdown();
        _open = false;
        _phase = Phase.Asking;
        StateHasChanged();
    }

    private void StopCountdown()
    {
        _graceCts?.Cancel();
        _graceCts?.Dispose();
        _graceCts = null;
    }

    public void Dispose() => StopCountdown();

    // Esc cancels - standard dialog affordance. The keydown handler is on the
    // root .modal-layer element so it fires while any descendant has focus.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" || e.Key == "Esc")
        {
            Cancel();
        }
    }

    // Focus-cycle sentinels - see the spans flanking the action buttons.
    private async Task FocusFirstAction()
    {
        try { await _cancelButton.FocusAsync(); }
        catch { /* element already detached after Confirm/Cancel */ }
    }

    private async Task FocusLastAction()
    {
        try { await _confirmButton.FocusAsync(); }
        catch { /* element already detached after Confirm/Cancel */ }
    }
}
