@*
    Upload one extension package to a Business Central environment: an app another
    company built and sent over, which no pipeline here can deploy. Shared by the
    environment page and the Environments list's row menu.

    The dialog only collects the answer - which files, and when. The caller books them
    (ProjectConnectionService.InstallUploadedAppsAsync) and reports the outcome where its
    own page reports outcomes. See .design/saas-delivery.md, "Uploading apps".

    Several files may be chosen at once. Each manifest is read on the spot and the apps
    are put in dependency order, which is the order they will install in, one after
    another - the worker waits for each install to finish before the next. A package
    whose manifest cannot be read (an encrypted vendor app) keeps the place it was
    chosen in, and the list says so.

    When: the delivery window agreed with the customer comes first when the environment
    has one, else Microsoft's own update window; then a time the person picks; then now.
    Every choice is a booking the workbench sends at the slot, never a schedule handed
    to Business Central, which is what makes the order a promise. A picked time is read
    in the organisation's display zone - the zone every other time on the page is shown
    in - and echoed back in words, so "12:32" fires at 12:32 on the clock the person is
    looking at, never at 12:32 UTC. The two windows are the customer's, in the
    customer's zone, and are shown as such.
*@
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using ALDevToolbox.Services.ObjectExplorer.Import
@using ALDevToolbox.Services.Organizations
@inject DisplayTimeZone DisplayZone
@inject ILogger<UploadAppDialog> Log

<ConfirmDialog @ref="_confirm" ConfirmDisabled="@(_files.Count == 0 || (_timing == UploadAppTiming.AtTime && SlotProblem() is not null))">
    <div class="upload-app__file">
        <label class="btn btn--sm btn--file" for="upload-app-file">
            <Icon Name="upload" Width="14" Height="14" />
            <span>@(_files.Count == 0 ? "Choose the .app files..." : "Choose different files...")</span>
            <InputFile id="upload-app-file" OnChange="OnChosenAsync" accept=".app" multiple />
        </label>
        @if (_reading)
        {
            <span class="u-muted" role="status">Reading the files...</span>
        }
        else if (_error is { } error)
        {
            <FieldError Message="@error" />
        }
        else if (_files.Count == 0)
        {
            <span class="u-muted">Choose one or more .app files to continue.</span>
        }
    </div>
    @if (_files.Count > 0)
    {
        <ol class="upload-app__list">
            @foreach (var file in _files)
            {
                <li class="upload-app__item">
                    <span class="upload-app__name">@file.FileName</span>
                    @if (file.Manifest is { } m)
                    {
                        <span class="u-muted">@m.Name @m.Version</span>
                    }
                    else
                    {
                        <span class="u-muted">protected app - name and version hidden</span>
                    }
                    <span class="u-muted">@FileSize(file.Bytes.Length)</span>
                </li>
            }
        </ol>
        @if (_files.Count > 1)
        {
            <small class="field__hint">
                @(_files.Any(f => f.Manifest is null)
                    ? "They install one after another in this order, dependencies first where they could be read. A protected app's dependencies can't be read: if one depends on another app here, upload them separately, dependencies first."
                    : "They install one after another in this order, dependencies first.")
            </small>
        }
    }
    <fieldset class="upload-app__when">
        <legend class="upload-app__when-legend">When should it install?</legend>
        @if (_deliveryWindowText is { } deliveryWindow)
        {
            <label class="upload-app__when-opt">
                <input type="radio" name="upload-app-when" checked="@(_timing == UploadAppTiming.DeliveryWindow)"
                       @onchange="() => _timing = UploadAppTiming.DeliveryWindow" />
                <span>In the delivery window, @deliveryWindow</span>
            </label>
        }
        else
        {
            <label class="upload-app__when-opt">
                <input type="radio" name="upload-app-when" checked="@(_timing == UploadAppTiming.BcUpdateWindow)"
                       disabled="@(_bcWindowText is null)"
                       @onchange="() => _timing = UploadAppTiming.BcUpdateWindow" />
                <span>In the BC update window@(_bcWindowText is { } bc ? $", {bc}" : "")</span>
            </label>
            <small class="field__hint upload-app__hint">
                @(_bcWindowText is null
                    ? "This environment has no delivery window, and Business Central's own window hasn't been read yet. Open the environment and choose Refresh to read it, or pick a time."
                    : "This environment has no delivery window (the install time agreed with the customer), so Business Central's own window stands in for it.")
            </small>
        }
        <label class="upload-app__when-opt">
            <input type="radio" name="upload-app-when" checked="@(_timing == UploadAppTiming.AtTime)"
                   @onchange="() => _timing = UploadAppTiming.AtTime" />
            <span>At a time I pick (@ZoneLabel(DisplayZone.Zone.Id) time)</span>
        </label>
        @if (_timing == UploadAppTiming.AtTime)
        {
            <div class="upload-app__pick">
                <input type="datetime-local" class="input" @bind="_slotLocal" @bind:event="oninput" />
                @* The browser draws that field in its own locale, which on a machine set
                   to English (US) is a 12-hour clock. The booking is said back in the
                   page's own words, always visible, and that sentence is what settles
                   what was picked - and in which zone. *@
                <p class="upload-app__echo">@SlotEchoText()</p>
                @if (SlotProblem() is { } problem)
                {
                    <FieldError Message="@problem" />
                }
                <small class="field__hint">
                    Until then you can cancel or start it early under Scheduled installs on the environment's Apps tab.
                </small>
            </div>
        }
        <label class="upload-app__when-opt">
            <input type="radio" name="upload-app-when" checked="@(_timing == UploadAppTiming.Now)"
                   @onchange="() => _timing = UploadAppTiming.Now" />
            <span>Now - anyone working in Business Central may be interrupted</span>
        </label>
    </fieldset>
</ConfirmDialog>

@code {
    /// <summary>What the person chose: the packages in install order, when, and - for a picked time - the instant it means.</summary>
    /// <param name="CustomerTimeZone">The IANA zone the customer's windows are agreed in, for saying a window slot back in it.</param>
    public sealed record Upload(IReadOnlyList<UploadFile> Files, UploadAppTiming Timing, DateTimeOffset? At = null, string? CustomerTimeZone = null);

    /// <summary>One chosen package, with its manifest when it could be read (an encrypted vendor app hides it).</summary>
    public sealed record UploadFile(byte[] Bytes, string FileName, AppManifest? Manifest);

    private ConfirmDialog? _confirm;
    private List<UploadFile> _files = new();
    private string? _error;
    private bool _reading;
    private UploadAppTiming _timing = UploadAppTiming.BcUpdateWindow;
    private string? _bcWindowText;
    private string? _deliveryWindowText;
    private string? _customerTimeZone;
    private DateTime _slotLocal;

    /// <summary>
    /// Asks for the files and the timing. Null when the person backed out. The gentlest
    /// timing is the default each time: the delivery window when the environment has
    /// one, else Microsoft's window when its hours are known, else a picked time.
    /// </summary>
    /// <param name="deliveryWindowStart">The environment's delivery window, when set. Both bounds or neither.</param>
    /// <param name="bcWindowStart">Microsoft's update window as mirrored from the admin centre, when read. Both bounds or neither.</param>
    /// <param name="bcWindowTimeZone">The IANA zone Microsoft's window is expressed in; the customer's zone when unknown.</param>
    /// <param name="customerTimeZone">The IANA zone the delivery window is agreed in - the solution's.</param>
    public async Task<Upload?> OpenAsync(
        string projectName, string environmentName, bool isProduction,
        TimeOnly? deliveryWindowStart = null, TimeOnly? deliveryWindowEnd = null, string? customerTimeZone = null,
        TimeOnly? bcWindowStart = null, TimeOnly? bcWindowEnd = null, string? bcWindowTimeZone = null)
    {
        if (_confirm is null) return null;
        await DisplayZone.EnsureLoadedAsync();
        _files = new();
        _error = null;
        _customerTimeZone = customerTimeZone;
        _deliveryWindowText = UpdateWindow.IsConfigured(deliveryWindowStart, deliveryWindowEnd)
            ? WindowText(deliveryWindowStart!.Value, deliveryWindowEnd!.Value, customerTimeZone)
            : null;
        _bcWindowText = UpdateWindow.IsConfigured(bcWindowStart, bcWindowEnd)
            ? WindowText(bcWindowStart!.Value, bcWindowEnd!.Value, bcWindowTimeZone ?? customerTimeZone)
            : null;
        _timing = _deliveryWindowText is not null ? UploadAppTiming.DeliveryWindow
            : _bcWindowText is not null ? UploadAppTiming.BcUpdateWindow
            : UploadAppTiming.AtTime;
        _slotLocal = DefaultSlot();
        StateHasChanged();

        var confirmed = await _confirm.OpenAsync(
            isProduction
                ? $"Upload apps to {environmentName}, a production environment?"
                : $"Upload apps to {environmentName}?",
            $"For apps another company built and sent you as .app files. They install into {projectName}'s "
            + "Business Central as they are; nothing here checks what they do. Apps you build yourself go through Deployments instead.",
            "Upload and install", "btn--danger");
        var files = _files;
        _files = new();
        if (!confirmed || files.Count == 0) return null;
        return new Upload(files, _timing, _timing == UploadAppTiming.AtTime ? SlotInstant() : null, _customerTimeZone);
    }

    /// <summary>
    /// The sentence for a page's success notice, so both callers say the same thing. It
    /// reports what <em>applied</em>, which the outcome carries: a delivery-window ask on
    /// an environment without one went to Microsoft's window.
    /// </summary>
    /// <param name="zone">The zone the page shows times in, for a booked slot.</param>
    public static string DoneMessage(Upload upload, UploadAppOutcome outcome, string environmentName, DisplayTimeZone zone)
    {
        var what = upload.Files.Count == 1 ? upload.Files[0].FileName : $"{upload.Files.Count} apps";
        var tail = upload.Files.Count == 1
            ? " Until then you can cancel or start it early under Scheduled installs on the environment."
            : " Until then you can cancel or start them early under Scheduled installs on the environment.";
        if (outcome.RunsAtUtc <= DateTime.UtcNow)
        {
            return upload.Files.Count == 1
                ? $"{what} will start installing on {environmentName} within a minute. Follow it under Scheduled installs on the environment."
                : $"{what} will start installing on {environmentName} within a minute, one after another in the order shown. Follow them under Scheduled installs on the environment.";
        }

        var when = $"{zone.Format(outcome.RunsAtUtc, SlotFormat)}, {ZoneLabel(zone.Zone.Id)} time";
        // A window was chosen as the customer's wall clock ("22:00-04:00 (New York)"),
        // so it is said back in that clock first, or the numbers look wrong.
        var customer = CustomerClock(outcome.RunsAtUtc, upload.CustomerTimeZone, zone.Zone);
        var lead = outcome.Timing switch
        {
            UploadAppTiming.DeliveryWindow =>
                $"{what} will be installed on {environmentName} when the delivery window next opens{(customer is null ? "" : $", {customer}")} ({when}).",
            UploadAppTiming.BcUpdateWindow =>
                $"{what} will be installed on {environmentName} when the BC update window next opens{(customer is null ? "" : $", {customer}")} ({when}).",
            _ => $"{what} will be installed on {environmentName} at {when}{(customer is null ? "" : $" - {customer}")}.",
        };
        return lead + tail;
    }

    /// <summary>The most files one upload takes - the service's limit, mirrored here so the refusal is instant.</summary>
    private const int MaxFiles = ProjectConnectionService.MaxUploadBatch;

    private async Task OnChosenAsync(InputFileChangeEventArgs e)
    {
        _files = new();
        _error = null;
        if (e.FileCount > MaxFiles)
        {
            _error = $"Choose at most {MaxFiles} apps at a time.";
            return;
        }
        var chosen = e.GetMultipleFiles(MaxFiles);
        if (chosen.FirstOrDefault(f => !f.Name.EndsWith(".app", StringComparison.OrdinalIgnoreCase)) is { } wrong)
        {
            _error = $"{wrong.Name} isn't an extension package - choose files ending in .app.";
            return;
        }
        if (chosen.FirstOrDefault(f => f.Size > BcAppManagementClient.MaxAppBytes) is { } tooBig)
        {
            _error = $"{tooBig.Name} is over 50 MB, which is the largest app Business Central accepts.";
            return;
        }

        _reading = true;
        StateHasChanged();
        try
        {
            var read = new List<UploadFile>(chosen.Count);
            foreach (var file in chosen)
            {
                await using var stream = file.OpenReadStream(BcAppManagementClient.MaxAppBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                var bytes = buffer.ToArray();
                read.Add(new UploadFile(bytes, file.Name, await AppPackageReader.TryReadManifestAsync(bytes)));
            }
            _files = InstallOrder(read);
        }
        catch (IOException ex)
        {
            Log.LogWarning(ex, "Reading an uploaded app failed.");
            _error = "Couldn't read one of the files. Choose them again.";
        }
        finally
        {
            _reading = false;
        }
    }

    /// <summary>
    /// Dependencies first, by the manifests that could be read; a package without one
    /// only keeps its place. Static so a test can pin the order without a browser.
    /// </summary>
    internal static List<UploadFile> InstallOrder(IReadOnlyList<UploadFile> files) =>
        DependencyOrder.Sort(files,
            f => f.Manifest?.AppId.ToString(),
            f => f.Manifest?.Dependencies.Select(d => d.AppId.ToString()) ?? Enumerable.Empty<string>())
        .ToList();

    // -- The picked time ------------------------------------------------------

    /// <summary>The next whole hour on the page's clock, so the field never opens on a time that has gone.</summary>
    private DateTime DefaultSlot()
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, DisplayZone.Zone);
        return new DateTime(local.Year, local.Month, local.Day, local.Hour, 0, 0).AddHours(1);
    }

    /// <summary>
    /// The instant the picked wall clock means, read in the organisation's display zone.
    /// A time that doesn't exist locally (the spring-forward hour) is nudged forward
    /// rather than refused - the person meant "that morning", not that instant.
    /// </summary>
    private DateTimeOffset SlotInstant()
    {
        var zone = DisplayZone.Zone;
        var wall = DateTime.SpecifyKind(_slotLocal, DateTimeKind.Unspecified);
        for (var i = 0; i < 4 && zone.IsInvalidTime(wall); i++) wall = wall.AddHours(1);
        return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(wall, zone), TimeSpan.Zero);
    }

    /// <summary>"20:00 on 3 Oct": the slot as a wall clock, read back through the display zone like every other time on the page. Shared with the pages that say a booking back.</summary>
    internal const string SlotFormat = "HH:mm 'on' d MMM";

    private string SlotEchoText()
    {
        var instant = SlotInstant().UtcDateTime;
        var customer = CustomerClock(instant, _customerTimeZone, DisplayZone.Zone);
        return $"Installs at {DisplayZone.Format(instant, SlotFormat)}, {ZoneLabel(DisplayZone.Zone.Id)} time{(customer is null ? "" : $" - {customer}")}.";
    }

    /// <summary>
    /// The same instant on the customer's clock ("08:00 for the customer (New York)"), when
    /// that clock differs from the page's. Null when the two clocks read the same at that
    /// instant or no customer zone is known, so a Berlin consultant booking a Copenhagen
    /// customer is not told the time twice.
    /// </summary>
    private static string? CustomerClock(DateTime utc, string? customerTimeZone, TimeZoneInfo pageZone)
    {
        if (string.IsNullOrWhiteSpace(customerTimeZone)) return null;
        var customerZone = UpdateWindow.ResolveTimeZone(customerTimeZone);
        var instant = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        if (customerZone.GetUtcOffset(instant) == pageZone.GetUtcOffset(instant)) return null;
        var local = TimeZoneInfo.ConvertTimeFromUtc(instant, customerZone);
        return $"{UpdateWindow.Clock(TimeOnly.FromDateTime(local))} for the customer ({ZoneLabel(customerZone.Id)})";
    }

    private string? SlotProblem() =>
        SlotInstant() < DateTimeOffset.UtcNow - ProjectConnectionService.BookingPastSlack ? "Pick a time that hasn't happened yet." : null;

    /// <summary>"22:00-04:00 (Copenhagen)": a window as the hours it was agreed in, with whose clock.</summary>
    private static string WindowText(TimeOnly start, TimeOnly end, string? ianaId) =>
        $"{UpdateWindow.Clock(start)}-{UpdateWindow.Clock(end)} ({ZoneLabel(ianaId)})";

    /// <summary>A zone the way a consultant names it - the city, not the region/city id. Shared with the pages that say a booking back.</summary>
    internal static string ZoneLabel(string? ianaId) =>
        string.IsNullOrWhiteSpace(ianaId) || ianaId == TimeZoneInfo.Utc.Id ? "UTC" : BcUpdateWindow.CityLabel(ianaId);

    private static string FileSize(int bytes) => bytes < 1024 * 1024
        ? $"{Math.Max(1, bytes / 1024)} KB"
        : $"{bytes / (1024d * 1024d):0.0} MB";
}
