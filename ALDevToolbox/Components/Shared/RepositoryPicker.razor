@using ALDevToolbox.Services.GitHub
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceScopeFactory Scopes
@inject ILogger<RepositoryPicker> Logger

@*
    The shared GitHub repository picker (issue #623), reused by the pipeline
    editor (#624) and the Translator (#625).

    Two credentials produce this list and neither of them lives here: the
    installation token says what the organisation shared with the app, and the
    user's own token narrows it to what they can open. Both are
    GitHubRepositoryService's business - see its note - so a second caller
    cannot widen the list by accident.

    Both reads run in this component's own service scope, not the page's. A
    component is mounted during its host page's first render, which Blazor does
    while that page's own OnInitializedAsync is still awaiting the database - so
    sharing the page's AppDbContext meant two operations on one context and a
    dead page ("a second operation was started on this context instance"), a
    crash the host had no part in beyond placing this control. A private scope
    makes mounting it safe whatever the host is doing, and is the same answer
    SiteBanner reached for the same reason. Each read costs one extra context;
    the readiness read happens once per mount and the list once per visit.

    Everything before "Ready" is answered from the database, so this renders its
    guidance even when GitHub is unreachable. The repository list itself is
    fetched when the user first reaches for it rather than on page load: it
    costs one call to GitHub per repository, and most visits to a page carrying
    this picker never touch it.

    See .design/github-integration.md, "The shared repository picker".
*@

<div class="repo-picker">
    @* The label is only a label when there is something to label. In the five
       states that render prose instead of a control, a <label for> would point
       at an element that does not exist, so the same words render as a plain
       heading. *@
    @if (ShowsInput)
    {
        <label class="field__label" for="@InputId">@Label</label>
    }
    else
    {
        <span class="field__label">@Label</span>
    }

    @if (_access is null)
    {
        <div class="loading-block">
            <span class="spinner"></span><span>Loading...</span>
        </div>
    }
    else if (Selected is not null)
    {
        <div class="repo-picker__chosen">
            <span class="repo-picker__mark"><Icon Name="folder-git-2" Width="15" Height="15" /></span>
            <a class="repo-picker__name" href="@Selected.HtmlUrl" target="_blank" rel="noopener">@Selected.FullName</a>
            @* Named, not bare: an unlabelled branch beside a repository reads as
               "the branch this is about to write to", which is the one thing it
               is not. *@
            <span class="repo-picker__branch">default branch <code class="code">@Selected.DefaultBranch</code></span>
            <button type="button" class="btn btn--sm" disabled="@Disabled" @onclick="ClearAsync">Change</button>
        </div>
    }
    else if (_access.Readiness == GitHubRepositoryReadiness.NotConfigured)
    {
        @* Nothing here may say what else the host page offers instead: this
           control is shared, and what is true beside it on New Extension is
           false beside it on a pipeline editor. A host that has a fallback
           says so through Hint. *@
        <div class="empty-state empty-state--quiet">
            <span class="empty-state__title">GitHub is not set up on this server yet</span>
            <AuthorizeView Roles="SiteAdmin">
                <Authorized>
                    <span class="empty-state__text">
                        Register the GitHub app for this server and repositories can be
                        listed here.
                    </span>
                    <a class="btn empty-state__action" href="/site-admin/settings/github">
                        <Icon Name="folder-git-2" Width="15" Height="15" />
                        <span>Set up GitHub</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <span class="empty-state__text">
                        Until whoever runs AL Workbench sets it up, there are no
                        repositories to list here.
                    </span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }
    else if (_access.Readiness == GitHubRepositoryReadiness.NotConnected)
    {
        <div class="empty-state empty-state--quiet">
            <span class="empty-state__title">No GitHub organisation is connected yet</span>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <span class="empty-state__text">
                        Connect the GitHub organisation your customers' repositories live in,
                        and they will be listed here.
                    </span>
                    <a class="btn empty-state__action" href="/admin/administration/repositories">
                        <Icon Name="folder-git-2" Width="15" Height="15" />
                        <span>Connect a GitHub organisation</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <span class="empty-state__text">
                        Ask one of your administrators to connect it, under
                        Administration &#8594; Repositories.
                    </span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }
    else if (_access.Readiness == GitHubRepositoryReadiness.NotLinked)
    {
        <div class="empty-state empty-state--quiet">
            <span class="empty-state__title">Connect your GitHub account to see your repositories</span>
            @* This is the moment someone decides whether to let the workbench near
               a customer's code, so it says what the workbench will and will not be
               able to do - not how many clicks it takes. *@
            <span class="empty-state__text">
                The workbench will list the repositories you can already open on GitHub,
                and no others. It never changes who can see what there, it never acts
                as anyone else, and you can disconnect it whenever you like.
            </span>
            <a class="btn empty-state__action" href="/account/repos">
                <Icon Name="link" Width="15" Height="15" />
                <span>Connect your GitHub account</span>
            </a>
        </div>
    }
    else if (_access.Readiness == GitHubRepositoryReadiness.LinkNeedsRepair)
    {
        <div class="empty-state empty-state--quiet">
            <span class="empty-state__title">Your GitHub account needs connecting again</span>
            <span class="empty-state__text">
                The workbench can no longer act as you on GitHub - most often because the
                workbench was removed from your authorised apps there, under your GitHub
                Settings &#8594; Applications. Connecting again puts it back.
            </span>
            <a class="btn empty-state__action" href="/account/repos">
                <Icon Name="refresh-cw" Width="15" Height="15" />
                <span>Connect again</span>
            </a>
        </div>
    }
    else
    {
        <div class="repo-picker__search">
            @* The icon is wrapped rather than styled through the component: CSS
               isolation only reaches elements this file renders, so a class
               handed to <Icon> would never be matched by the sheet below. *@
            <span class="repo-picker__search-icon"><Icon Name="search" Width="15" Height="15" /></span>
            <input class="input repo-picker__input" id="@InputId" type="text"
                   autocomplete="off" spellcheck="false"
                   placeholder="@SearchPlaceholder"
                   disabled="@Disabled"
                   value="@_query"
                   @oninput="OnQueryChangedAsync"
                   @onfocus="EnsureLoadedAsync" />
        </div>

        @if (_loading)
        {
            <div class="loading-block">
                <span class="spinner"></span><span>Reading your repositories from GitHub...</span>
            </div>
        }
        else if (_loadFailed)
        {
            <Alert Tone="AlertTone.Warn" Role="alert">
                <span class="u-stack">
                    <span>@_loadError</span>
                    <span><button type="button" class="btn btn--sm" @onclick="ReloadAsync">Try again</button></span>
                </span>
            </Alert>
        }
        else if (_loaded)
        {
            var matches = Matches();
            if (_all.Count == 0)
            {
                @* A dead end, not a footnote: the same quiet empty state the four
                   guidance states use, with the retry this control already has. *@
                <div class="empty-state empty-state--quiet">
                    <span class="empty-state__title">You cannot open any of @OrgName's repositories yet</span>
                    <span class="empty-state__text">
                        The workbench lists only what you can already open on GitHub. Ask an
                        owner of @OrgName to give you access, then look again.
                    </span>
                    <button type="button" class="btn empty-state__action" @onclick="ReloadAsync">
                        <Icon Name="refresh-cw" Width="15" Height="15" />
                        <span>Try again</span>
                    </button>
                </div>
            }
            else if (matches.Count == 0)
            {
                <p class="field__hint">
                    None of @OrgName's repositories match "@_applied".
                    <button type="button" class="btn btn--sm" @onclick="ClearSearchAsync">Clear search</button>
                </p>
            }
            else
            {
                <ul class="repo-picker__results">
                    @foreach (var repo in matches)
                    {
                        var added = IsAlreadyAdded?.Invoke(repo) == true;
                        <li>
                            @* A repository the caller already has is shown and
                               unclickable, not hidden: hiding it invites the
                               user to go looking for one that is right there,
                               and leaving it clickable lets them add it twice
                               and be told afterwards. *@
                            <button type="button" class="repo-picker__result"
                                    disabled="@(Disabled || added)" @onclick="() => SelectAsync(repo)">
                                <span class="repo-picker__result-name">
                                    <span>@repo.Name</span>
                                    @if (repo.IsPrivate)
                                    {
                                        <span class="repo-picker__private">
                                            <Icon Name="lock" Width="12" Height="12" />
                                            <span class="u-sr">Private repository</span>
                                        </span>
                                    }
                                    @if (added)
                                    {
                                        <span class="repo-picker__added">Added</span>
                                    }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(repo.Description))
                                {
                                    <span class="repo-picker__result-sub">@repo.Description</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
                @if (_hiddenCount > 0)
                {
                    @* What is on screen and what is not, rather than an
                       instruction: the search box above already says how to
                       narrow it. *@
                    <p class="field__hint">Showing @matches.Count of @(matches.Count + _hiddenCount) repositories.</p>
                }
            }
        }
    }

    @* The result count out loud. The list appears without the page moving and
       without focus leaving the search box, so a screen reader user is
       otherwise told nothing at all about what typing just did. *@
    @if (ShowsInput && _announcement is { Length: > 0 })
    {
        <span class="u-sr" role="status" aria-live="polite">@_announcement</span>
    }

    @* The hint describes what picking a repository leads to, so it only belongs
       where picking one is possible. Below a "GitHub is not set up" state it
       would promise something the page cannot do. *@
    @if (!string.IsNullOrWhiteSpace(Hint) && (ShowsInput || Selected is not null))
    {
        <span class="field__hint">@Hint</span>
    }
</div>

@code {
    /// <summary>How many rows the list shows before asking the user to narrow it.</summary>
    private const int MaxResults = 8;

    /// <summary>
    /// How long typing settles before the list is filtered. Long enough that a
    /// word typed at speed re-renders once, short enough not to feel laggy.
    /// </summary>
    private const int DebounceMilliseconds = 200;

    /// <summary>
    /// The chosen repository. Two-way bindable: <c>@bind-Selected</c> gives the
    /// caller the whole row, because the pipeline editor (#624) needs its clone
    /// URL and default branch, not only its name.
    /// </summary>
    [Parameter] public GitHubRepositorySummary? Selected { get; set; }

    /// <summary>Raised when the user picks a repository, and with null when they clear it.</summary>
    [Parameter] public EventCallback<GitHubRepositorySummary?> SelectedChanged { get; set; }

    /// <summary>
    /// Narrows what is offered, on top of the access rules the service applies.
    /// For callers that only make sense against some repositories - not a
    /// permission check, which is never the caller's to make.
    /// </summary>
    [Parameter] public Func<GitHubRepositorySummary, bool>? Filter { get; set; }

    /// <summary>Greys the control out while the page is busy elsewhere.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The field label. Say what the repository is <em>for</em> on this page.</summary>
    [Parameter] public string Label { get; set; } = "Repository";

    /// <summary>Optional line under the control.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Overrides the search box's placeholder.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>The input's id, so the caller's label and hints can point at it.</summary>
    [Parameter] public string InputId { get; set; } = "repo-picker";

    /// <summary>
    /// Says which repositories the caller already has. Rows it matches are shown
    /// but cannot be clicked, so adding the same one twice is impossible rather
    /// than refused afterwards. Optional: without it every row is selectable,
    /// which is what a single-selection caller wants.
    /// </summary>
    [Parameter] public Func<GitHubRepositorySummary, bool>? IsAlreadyAdded { get; set; }

    /// <summary>
    /// For callers that add several repositories one after another: the
    /// selection is handed over and then cleared, so the control goes straight
    /// back to being a search box instead of showing a chosen row the page has
    /// already moved past. Off by default - a form with one repository field
    /// wants the chosen row to stay.
    /// </summary>
    [Parameter] public bool ClearAfterSelect { get; set; }

    private GitHubRepositoryAccess? _access;
    private IReadOnlyList<GitHubRepositorySummary> _all = [];
    private bool _loading;
    private bool _loaded;
    private bool _loadFailed;
    private string _loadError = string.Empty;
    private string _query = string.Empty;
    private string _applied = string.Empty;
    private int _hiddenCount;
    private string _announcement = string.Empty;
    private CancellationTokenSource? _debounce;

    private string OrgName => string.IsNullOrWhiteSpace(_access?.OrgLogin) ? "your organisation" : _access!.OrgLogin!;

    /// <summary>
    /// Whether this render puts a search box on screen. Drives the label-versus-
    /// heading choice and whether the caller's hint is true yet.
    /// </summary>
    private bool ShowsInput => _access is not null && _access.IsReady && Selected is null;

    private string SearchPlaceholder => Placeholder
        ?? (string.IsNullOrWhiteSpace(_access?.OrgLogin)
            ? "Search your repositories..."
            : $"Search {_access!.OrgLogin} repositories...");

    protected override async Task OnInitializedAsync()
    {
        _access = await ReadAsync(r => r.GetAccessAsync());
    }

    /// <summary>
    /// Runs one read through this component's own scope - see the note at the
    /// top of the file. Nothing here writes, so a scope per read is the whole
    /// of the isolation needed.
    /// </summary>
    private async Task<T> ReadAsync<T>(Func<GitHubRepositoryService, Task<T>> read)
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await read(scope.ServiceProvider.GetRequiredService<GitHubRepositoryService>());
    }

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }

    /// <summary>
    /// Fetches the list once, the first time the user reaches for it. Failure is
    /// a state of this control, not of the page: the rest of the form still
    /// works without GitHub.
    /// </summary>
    private async Task EnsureLoadedAsync()
    {
        if (_loaded || _loading || _access is null || !_access.IsReady) return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadFailed = false;
        StateHasChanged();
        try
        {
            _all = await ReadAsync(r => r.ListAccessibleAsync());
            _loaded = true;
        }
        catch (Exception ex) when (ex is GitHubApiException or GitHubAppNotConfiguredException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Could not list the repositories for the repository picker.");
            _loadFailed = true;
            _loadError = "The workbench could not reach GitHub just now, so it cannot show your repositories.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnQueryChangedAsync(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        await EnsureLoadedAsync();

        // Publish the new source before tearing the old one down, so a dispose
        // racing this never sees a field pointing at an already-disposed source.
        var cts = new CancellationTokenSource();
        var previous = _debounce;
        _debounce = cts;
        previous?.Cancel();
        previous?.Dispose();
        try
        {
            await Task.Delay(DebounceMilliseconds, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _applied = _query;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The rows to show: the caller's filter, then a plain substring match on
    /// the name, capped so the list stays a list rather than a directory.
    /// </summary>
    private List<GitHubRepositorySummary> Matches()
    {
        IEnumerable<GitHubRepositorySummary> rows = _all;
        if (Filter is not null) rows = rows.Where(Filter);
        if (!string.IsNullOrWhiteSpace(_applied))
        {
            rows = rows.Where(r => r.FullName.Contains(_applied.Trim(), StringComparison.OrdinalIgnoreCase));
        }
        var all = rows.ToList();
        _hiddenCount = Math.Max(0, all.Count - MaxResults);
        // Nothing to announce when there is nothing to search: that state says
        // its own piece, at length, in the empty state below.
        _announcement = _all.Count == 0 ? string.Empty : all.Count switch
        {
            0 => $"No repositories match \"{_applied}\".",
            1 => "1 repository matches.",
            _ => $"{all.Count} repositories match.",
        };
        return all.Take(MaxResults).ToList();
    }

    private async Task SelectAsync(GitHubRepositorySummary repo)
    {
        _query = string.Empty;
        _applied = string.Empty;
        _announcement = string.Empty;
        Selected = repo;
        await SelectedChanged.InvokeAsync(repo);

        // The caller has taken it; put the search box back for the next one.
        // Done here rather than by the caller nulling the binding after the
        // fact, which shows the chosen row for a render on the way past.
        if (ClearAfterSelect)
        {
            Selected = null;
            await SelectedChanged.InvokeAsync(null);
        }
    }

    /// <summary>Empties the search box, from the state that says nothing matched.</summary>
    private async Task ClearSearchAsync()
    {
        _query = string.Empty;
        _applied = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearAsync()
    {
        Selected = null;
        await SelectedChanged.InvokeAsync(null);
    }
}
