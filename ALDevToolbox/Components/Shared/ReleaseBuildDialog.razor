@rendermode InteractiveServer
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.DeliveryService Deliveries
@inject ALDevToolbox.Services.GitHub.GitHubReleaseService GitHubReleases
@inject ILogger<ReleaseBuildDialog> Log
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Services.GitHub

@*
    Deploy a build through a deployment pipeline: pick which successful build to publish
    (defaults to the latest), pick when (prefilled to the next opening of the target
    environment's delivery window, or now if it has none), confirm a Production target,
    and deploy. A pipeline set to install in the delivery window says so beside the
    time, and "Now" is the explicit way out of it. "Deploy now" runs immediately; a
    future time is enqueued by the DeliveryScheduler when due. Picking a time outside the window is allowed but
    recorded. The picker and the window are in the customer's time zone, and say so: the
    window is a time of day agreed with the customer, and booking against it in their
    clock is what keeps the two tellable apart (#942). Build and release dates in the
    pickers are instants, shown in the organisation's display zone. Opened imperatively; raises
    OnReleased with the new delivery id. See .design/saas-delivery.md.

    Named user: a BC consultant publishing a finished build to a customer environment.
*@

@if (_open)
{
    <div class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="rb-title"
         tabindex="-1" @onkeydown="OnKeyDown" @ref="_root">
        <div class="modal-backdrop" @onclick="Cancel" aria-hidden="true"></div>
        <div class="confirm-dialog" @onclick:stopPropagation>
            <div class="confirm-dialog__head">
                <span class="confirm-dialog__icon" aria-hidden="true">
                    <Icon Name="send" Width="17" Height="17" />
                </span>
                <h2 id="rb-title" class="confirm-dialog__title">Deploy to @_customerName — @_envName</h2>
            </div>
            <div class="confirm-dialog__body">
                <p>
                    Uploads the build's apps to <b>@_envName</b> in <b>@_customerName</b>'s Business Central@(IsImmediate ? "" : " at the time below").
                    Business Central installs them
                    <b>@DeliveryModeDisplay.Schedule(BcDeploymentSchedule.ToWire(_deploymentSchedule) ?? _deploymentSchedule).ToLowerInvariant()</b>@(_schemaSyncMode == BcSyncMode.ForceSync ? ", using Force sync (which can drop columns)" : "").
                </p>

                @if (_fromReleases && _releases.Count == 0)
                {
                    <Alert Tone="AlertTone.Info" Role="status">
                        <span>
                            @(_repositoryName.Length > 0
                                ? $"No GitHub release on {_repositoryName} has an .app file attached yet."
                                : "No GitHub release has an .app file attached yet.")
                            Publish a GitHub release with the compiled apps attached, then come back.
                        </span>
                    </Alert>
                }
                else if (_fromReleases)
                {
                    <div class="field">
                        <label class="field__label" for="rb-release">GitHub release to install</label>
                        <SelectBox>
                            <select id="rb-release" class="select" @bind="_tag" disabled="@_releasing">
                                @foreach (var r in _releases)
                                {
                                    <option value="@r.Tag">@ReleaseLabel(r)</option>
                                }
                            </select>
                        </SelectBox>
                        <small class="field__hint">
                            The newest release is selected.@(_repositoryName.Length > 0
                                ? $" Its app files are downloaded from {_repositoryName} when you deploy."
                                : " Its app files are downloaded when you deploy.")
                        </small>
                    </div>
                }
                else
                {
                    <div class="field">
                        <label class="field__label" for="rb-build">Build to deploy</label>
                        <SelectBox>
                            <select id="rb-build" class="select" @bind="_buildId" disabled="@_releasing">
                                @foreach (var b in _builds)
                                {
                                    <option value="@b.Id">@b.Label</option>
                                }
                            </select>
                        </SelectBox>
                        <small class="field__hint">@(_buildChosenForYou
                            ? "This is the build you chose. You can pick a different one here."
                            : "The latest successful build is selected. Older successful builds are available too.")</small>
                    </div>
                }

                <div class="field">
                    <label class="field__label" for="rb-when">When</label>
                    <div class="rb-when-row">
                        <input id="rb-when" type="datetime-local" class="input" @bind="_scheduledLocal" @bind:event="oninput" disabled="@_releasing" />
                        <button type="button" class="btn btn--sm" @onclick="SetNow" disabled="@_releasing">Now</button>
                        @if (_hasWindow && _scheduledLocal != _windowOpeningLocal)
                        {
                            <button type="button" class="btn btn--sm" @onclick="SetNextOpening" disabled="@_releasing">Next window</button>
                        }
                    </div>
                    <small class="field__hint">@WhenHint</small>
                    @if (_hasWindow && IsOutsideWindow)
                    {
                        <span class="field-warn"><Icon Name="triangle-alert" Width="13" Height="13" />@(IsImmediate
                            ? $"{_envName}'s delivery window ({WindowLabel}) isn't open now. Deploying now installs outside the hours agreed with the customer, and the deployment history will record that."
                            : $"This time is outside {_envName}'s delivery window ({WindowLabel}). It will still run then, and the deployment history will record that it ran outside the window.")</span>
                    }
                    @if (SecretWarning is { } secretWarn)
                    {
                        <span class="field-warn"><Icon Name="triangle-alert" Width="13" Height="13" />@secretWarn</span>
                    }
                </div>

                @if (_fromReleases && SelectedReleaseFiles.Count > 0)
                {
                    <div class="rb-apps">
                        <span class="rb-apps__label">This release installs</span>
                        <ul class="rb-apps__list">
                            @foreach (var file in SelectedReleaseFiles)
                            {
                                <li><span class="rb-apps__name">@file</span></li>
                            }
                        </ul>
                    </div>
                }
                else if (!_fromReleases && SelectedApps.Count > 0)
                {
                    <div class="rb-apps">
                        <span class="rb-apps__label">This build installs</span>
                        <ul class="rb-apps__list">
                            @foreach (var app in SelectedApps)
                            {
                                <li><span class="rb-apps__name">@app.Name</span> <span class="rb-apps__ver">@app.Version</span></li>
                            }
                        </ul>
                    </div>
                }

                @if (_isProduction)
                {
                    <label class="check check--ack @(_prodAck ? "is-checked" : "")">
                        <input type="checkbox" checked="@_prodAck"
                               @onchange="e => _prodAck = (bool)(e.Value ?? false)" disabled="@_releasing" />
                        <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                        @if (_envNameIsProduction)
                        {
                            <span>I understand this installs the apps into <b>@_customerName</b>'s live <b>Production</b> environment.</span>
                        }
                        else
                        {
                            <span>I understand this installs the apps into <b>@_envName</b>, <b>@_customerName</b>'s live <b>Production</b> environment.</span>
                        }
                    </label>
                }

                @if (_error is { } err)
                {
                    <Alert Tone="AlertTone.Danger"><span>@err</span></Alert>
                }
            </div>
            <div class="confirm-dialog__actions">
                <button type="button" class="btn" @onclick="Cancel" disabled="@_releasing">Cancel</button>
                <button type="button" class="btn btn--primary" @onclick="ReleaseAsync" disabled="@(!CanRelease)">
                    <Icon Name="send" Width="14" Height="14" />
                    <span>@(_staging ? "Getting the apps..." : _releasing ? "Deploying..." : IsImmediate ? "Deploy now" : "Schedule deployment")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Raised with the new delivery's id once the deployment is queued/scheduled.</summary>
    [Parameter] public EventCallback<int> OnReleased { get; set; }

    private bool _open;
    private bool _focusPending;
    private ElementReference _root;
    private int _releasePipelineId;
    private string _customerName = string.Empty;
    private string _envName = string.Empty;
    private bool _isProduction;
    private bool _envNameIsProduction;
    private string _deploymentSchedule = string.Empty;
    private string _schemaSyncMode = string.Empty;
    private List<ReleasableBuildOption> _builds = new();
    private int _buildId;
    // True when the caller named the build (the build list's "Deploy..." on one row),
    // so the hint doesn't claim the latest was picked when it wasn't (#938).
    private bool _buildChosenForYou;
    // Release-sourced pipelines pick a GitHub release rather than a build; the apps are
    // downloaded and staged as a build at the moment the person deploys (#632).
    private bool _fromReleases;
    private List<GitHubReleaseOption> _releases = new();
    private string _tag = string.Empty;
    private string _repositoryName = string.Empty;
    private bool _staging;
    private bool _prodAck;
    private bool _releasing;
    private string? _error;

    // Scheduling: the picker value is a wall-clock in the solution's timezone.
    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private string _tzLabel = "UTC";
    private TimeOnly? _winStart;
    private TimeOnly? _winEnd;
    private bool _hasWindow;
    private DateTime _scheduledLocal; // Unspecified kind = customer-tz wall-clock
    private DateTime _windowOpeningLocal; // the prefilled next opening, same kind as _scheduledLocal
    private DateTime? _secretExpiresAt; // UTC instant the BC client secret lapses, if known

    private string WindowLabel => _hasWindow ? $"{_winStart:HH:mm}-{_winEnd:HH:mm}" : "";

    /// <summary>True when the deployment pipeline is set to install in the environment's delivery window.</summary>
    private bool ByDeliveryWindow => BcDeploymentSchedule.IsOurDeliveryWindow(_deploymentSchedule);

    /// <summary>
    /// The line under the time. For a pipeline that installs in the delivery window it
    /// says where the time came from while the time is still the window's next opening;
    /// once the person picks another time (or Now) it reverts to the plain line, and the
    /// outside-the-window warning takes over when that applies.
    /// </summary>
    private string WhenHint
    {
        get
        {
            if (ByDeliveryWindow && !_hasWindow)
            {
                return $"This pipeline installs in {_envName}'s delivery window, but the environment no longer has one, so pick a time. Time is in the solution's time zone ({_tzLabel}).";
            }
            var atOpening = _scheduledLocal == _windowOpeningLocal;
            if (ByDeliveryWindow && atOpening)
            {
                return IsImmediate
                    ? $"{_envName}'s delivery window ({WindowLabel}) is open now, so this deploys right away."
                    : $"Scheduled for the next delivery window, {DayAndTime(_windowOpeningLocal)}, in the solution's time zone ({_tzLabel}).";
            }
            if (!_hasWindow) return $"Time is in the solution's time zone ({_tzLabel}).";
            return atOpening
                ? $"Time is in the solution's time zone ({_tzLabel}). Delivery window {WindowLabel}; prefilled to its next opening."
                : $"Time is in the solution's time zone ({_tzLabel}). Delivery window {WindowLabel}.";
        }
    }

    /// <summary>"today 22:00", "tomorrow 02:00" or "Thursday 02:00", counted in the customer's time zone.</summary>
    private string DayAndTime(DateTime local)
    {
        var today = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, _tz).Date;
        var day = (local.Date - today).Days switch
        {
            0 => "today",
            1 => "tomorrow",
            _ => local.ToString("dddd", System.Globalization.CultureInfo.InvariantCulture),
        };
        return $"{day} {local:HH:mm}";
    }

    /// <summary>The apps the currently-picked build would install, shown before the confirm.</summary>
    private IReadOnlyList<ReleasableBuildApp> SelectedApps =>
        _builds.FirstOrDefault(b => b.Id == _buildId)?.Apps ?? [];

    /// <summary>The app files attached to the currently-picked GitHub release.</summary>
    private IReadOnlyList<string> SelectedReleaseFiles =>
        _releases.FirstOrDefault(r => r.Tag == _tag)?.AppFileNames ?? [];

    /// <summary>
    /// How one release reads in the picker: its tag, its title when it has a different one,
    /// and when it was published. An option holds text only, so the date goes through the
    /// display zone here rather than through a Timestamp.
    /// </summary>
    private string ReleaseLabel(GitHubReleaseOption release)
    {
        var title = string.IsNullOrWhiteSpace(release.Name) || release.Name == release.Tag ? null : release.Name;
        var when = release.PublishedAt is { } at ? Zone.Format(at.UtcDateTime, "yyyy-MM-dd") : null;
        var suffix = string.Join(" - ", new[] { title, when }.Where(x => !string.IsNullOrEmpty(x)));
        return suffix.Length == 0 ? release.Tag : $"{release.Tag} ({suffix})";
    }

    /// <summary>The picked customer-tz wall-clock as a UTC instant.</summary>
    private DateTime ScheduledUtc => TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(_scheduledLocal, DateTimeKind.Unspecified), _tz);

    /// <summary>True when the picked time is now or in the past (a "deploy now").</summary>
    private bool IsImmediate => ScheduledUtc <= DateTime.UtcNow.AddMinutes(1);

    private bool IsOutsideWindow =>
        UpdateWindow.IsConfigured(_winStart, _winEnd) && !UpdateWindow.IsWithin(_winStart, _winEnd, _tz, ScheduledUtc);

    /// <summary>
    /// Warn-but-allow: the deployment runs under the customer's S2S secret, which fails once
    /// it expires. Flag it at scheduling time (the run itself hard-fails with the same
    /// advice) so a consultant rotates it first. Already-lapsed and scheduled-past-expiry
    /// are distinct messages. See .design/saas-delivery.md ("Expired-secret behaviour").
    /// </summary>
    private string? SecretWarning
    {
        get
        {
            if (_secretExpiresAt is not { } expiry) return null;
            if (expiry <= DateTime.UtcNow)
            {
                return "The Business Central client secret has expired. Rotate it in Entra and re-enter it on the solution's Business Central page before this can install.";
            }
            if (ScheduledUtc > expiry)
            {
                // A calendar date the consultant typed, stored at midnight UTC: printed as
                // that date, never converted into a zone that could move it a day.
                return $"The Business Central client secret expires {expiry:yyyy-MM-dd}. This deployment is scheduled after that and will fail unless the secret is rotated first.";
            }
            return null;
        }
    }

    private bool CanRelease =>
        !_releasing
        && (_fromReleases
            ? _tag.Length > 0 && SelectedReleaseFiles.Count > 0
            : _buildId != 0 && _builds.Count > 0)
        && (!_isProduction || _prodAck);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _open)
        {
            _focusPending = false;
            try { await _root.FocusAsync(); }
            catch { /* detached */ }
        }
    }

    /// <summary>
    /// Opens the dialog for a deployment pipeline. <paramref name="builds"/> must be its
    /// successful builds (newest first). <paramref name="timeZone"/> is the solution's
    /// IANA tz; <paramref name="windowStart"/>/<paramref name="windowEnd"/> the target
    /// environment's update window (both null = none). <paramref name="selectedBuildId"/>
    /// preselects one of <paramref name="builds"/> - the build list opens the dialog
    /// from a specific build's row (#938); it falls back to the latest when that build
    /// is not among them.
    /// </summary>
    public Task OpenAsync(int releasePipelineId, string customerName, string envName, string envType, string deploymentSchedule, string schemaSyncMode,
        IReadOnlyList<ReleasableBuildOption> builds, string? timeZone, TimeOnly? windowStart, TimeOnly? windowEnd,
        DateTime? secretExpiresAt = null,
        IReadOnlyList<GitHubReleaseOption>? releases = null,
        string? repositoryName = null,
        int? selectedBuildId = null)
    {
        _releasePipelineId = releasePipelineId;
        _fromReleases = releases is not null;
        _releases = releases?.Where(r => r.AppFileNames.Count > 0).ToList() ?? new();
        _tag = _releases.Count > 0 ? _releases[0].Tag : string.Empty;
        _repositoryName = repositoryName ?? string.Empty;
        _staging = false;
        _secretExpiresAt = secretExpiresAt;
        // The customer's project name is what tells a consultant with several projects
        // open *whose* tenant this writes to - an environment is often literally named
        // "Production" (#714).
        _customerName = string.IsNullOrWhiteSpace(customerName) ? "this project" : customerName;
        _envName = envName;
        _isProduction = string.Equals(envType, "Production", StringComparison.OrdinalIgnoreCase);
        _envNameIsProduction = string.Equals(envName, "Production", StringComparison.OrdinalIgnoreCase);
        _deploymentSchedule = deploymentSchedule;
        _schemaSyncMode = schemaSyncMode;
        _builds = builds.ToList();
        _buildChosenForYou = selectedBuildId is { } chosen && _builds.Any(b => b.Id == chosen);
        _buildId = _buildChosenForYou ? selectedBuildId!.Value : _builds.Count > 0 ? _builds[0].Id : 0;
        _prodAck = false;
        _error = null;
        _releasing = false;

        _tz = UpdateWindow.ResolveTimeZone(timeZone);
        _tzLabel = string.IsNullOrWhiteSpace(timeZone) ? "UTC" : timeZone!;
        _winStart = windowStart;
        _winEnd = windowEnd;
        _hasWindow = UpdateWindow.IsConfigured(windowStart, windowEnd);

        // Prefill to the next opening of the window (or now if there's none), expressed
        // as a customer-tz wall-clock for the datetime-local input.
        var prefillUtc = UpdateWindow.NextOpeningUtc(windowStart, windowEnd, _tz, DateTime.UtcNow);
        _scheduledLocal = Trim(TimeZoneInfo.ConvertTimeFromUtc(prefillUtc, _tz));
        _windowOpeningLocal = _scheduledLocal;

        _open = true;
        _focusPending = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SetNextOpening() => _scheduledLocal = _windowOpeningLocal;

    private void SetNow() => _scheduledLocal = Trim(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, _tz));

    /// <summary>Drop seconds so the value round-trips cleanly through datetime-local (minute precision).</summary>
    private static DateTime Trim(DateTime d) => new(d.Year, d.Month, d.Day, d.Hour, d.Minute, 0, DateTimeKind.Unspecified);

    private void Cancel()
    {
        if (_releasing) return;
        _open = false;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc") Cancel();
    }

    private async Task ReleaseAsync()
    {
        if (!CanRelease) return;
        _releasing = true;
        _error = null;
        try
        {
            var buildId = _buildId;
            if (_fromReleases)
            {
                // Downloading the release's app files is what turns a tag into
                // something deliverable; from there the flow is the ordinary one.
                _staging = true;
                StateHasChanged();
                buildId = await GitHubReleases.StageReleaseAsync(_releasePipelineId, _tag);
                _staging = false;
            }
            var deliveryId = await Deliveries.ScheduleDeliveryAsync(_releasePipelineId, buildId, ScheduledUtc);
            _open = false;
            await OnReleased.InvokeAsync(deliveryId);
        }
        catch (PlanValidationException ex)
        {
            _error = ex.Errors.Values.FirstOrDefault() ?? "Couldn't start the deployment.";
        }
        catch (ProjectAccessDeniedException)
        {
            _error = "Only the solution owner or an admin can deploy this solution's builds.";
        }
        catch (GitHubApiException ex)
        {
            _error = _repositoryName.Length > 0
                ? $"GitHub would not hand over the release: {ex.Message}. Check the app is still installed for {_repositoryName}, then try again."
                : $"GitHub would not hand over the release: {ex.Message}. Check the app is still installed for the repository, then try again.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to start deployment for pipeline {ReleasePipelineId}.", _releasePipelineId);
            _error = _fromReleases
                ? "Couldn't get the release's app files from GitHub. Try again in a moment."
                : "Couldn't start the deployment.";
        }
        finally
        {
            _releasing = false;
            _staging = false;
        }
    }

    /// <summary>
    /// The picker's options from a build pipeline's builds: the successful ones, newest
    /// first, each with the apps it carries. Preview builds are left out: they are
    /// check-only and the deployment would refuse them (#994). Shared by every page that opens this
    /// dialog for a build pipeline, so the picker reads the same wherever it opens
    /// (#938). <paramref name="zone"/> is the page's display zone, for the build time.
    /// </summary>
    public static List<ReleasableBuildOption> OptionsFrom(
        IEnumerable<ALDevToolbox.Services.ObjectExplorer.Projects.BuildRow> builds,
        IReadOnlyDictionary<int, List<ALDevToolbox.Services.ObjectExplorer.Projects.BuildAppRow>> appsByBuild,
        ALDevToolbox.Services.Organizations.DisplayTimeZone zone) =>
        builds
            .Where(b => b.Status == "ready" && !b.IsPreview)
            .OrderByDescending(b => b.FinishedAt ?? b.StartedAt)
            .Select(b =>
            {
                var apps = appsByBuild.TryGetValue(b.Id, out var found) ? found : [];
                return new ReleasableBuildOption(
                    b.Id,
                    OptionLabel(b, apps.Count, zone),
                    apps.Select(a => new ReleasableBuildApp(a.AppName, a.AppVersion)).ToList());
            })
            .ToList();

    /// <summary>
    /// The picker label for one releasable build: what it is, not just when it ran.
    /// A consultant picking a build for a customer's live tenant needs the branch,
    /// the commit it was built at and how many apps it carries (#714) - e.g.
    /// "#412 · main @a3f9c21 · 3 apps · built 29 Aug 14:21". Parts the build has no
    /// value for are dropped rather than shown empty. The build time is in the display
    /// zone: an option holds text only, so it cannot carry a Timestamp.
    /// </summary>
    public static string OptionLabel(ALDevToolbox.Services.ObjectExplorer.Projects.BuildRow b, int appCount,
        ALDevToolbox.Services.Organizations.DisplayTimeZone zone)
    {
        var parts = new List<string> { $"#{b.Id}" };

        var source = string.Join(" ", new[]
        {
            b.Branch,
            string.IsNullOrEmpty(b.HeadCommitShort) ? null : $"@{b.HeadCommitShort}",
        }.Where(s => !string.IsNullOrEmpty(s)));
        if (!string.IsNullOrEmpty(source)) parts.Add(source);

        if (appCount > 0) parts.Add(appCount == 1 ? "1 app" : $"{appCount} apps");
        if (!string.IsNullOrEmpty(b.BcVersion)) parts.Add($"BC {b.BcVersion}");
        parts.Add("built " + zone.Format(b.FinishedAt ?? b.StartedAt, "d MMM HH:mm"));

        return string.Join(" · ", parts);
    }

    /// <summary>A successful build offered in the picker, with the apps it would install.</summary>
    public sealed record ReleasableBuildOption(int Id, string Label, IReadOnlyList<ReleasableBuildApp> Apps);

    /// <summary>One app in a build: what goes into the customer's tenant, and at which version.</summary>
    public sealed record ReleasableBuildApp(string Name, string Version);
}
