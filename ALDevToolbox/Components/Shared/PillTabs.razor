@*
    Pill tab navigation, on the design system's .pill-tabs / .pill-tab.
    Used by the per-org Administration page to switch between Identity,
    Tools, Users, OAuth clients, and Export sub-pages, and by the SiteAdmin
    and Object Explorer section headers. Each tab is a real <a href> - full
    page navigation, not SPA-like - so the routes can be bookmarked and the
    back button works as expected.

    The tabs carry no bottom margin: a migrated page is a .page grid and gets
    its spacing from the gap. Pages still on .admin-page take theirs from the
    gated legacy rule in admin.css, which retires with that container.
*@

<nav class="pill-tabs@(Equal ? " pill-tabs--equal" : "")" role="tablist" aria-label="@AriaLabel">
    @foreach (var item in Items)
    {
        @if (item.Disabled)
        {
            @* A link cannot be disabled, so a held tab is a disabled button in its place:
               the sheet's .pill-tab[disabled] greys it, and nothing navigates. *@
            <button type="button" class="pill-tab @(item.IsActive ? "is-active" : "")" disabled
                    role="tab" aria-selected="@(item.IsActive ? "true" : "false")">
                @TabBody(item)
            </button>
        }
        else
        {
            <a class="pill-tab @(item.IsActive ? "is-active" : "")" href="@item.Href"
               role="tab" aria-selected="@(item.IsActive ? "true" : "false")">
                @TabBody(item)
            </a>
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PillTabItem> Items { get; set; } = Array.Empty<PillTabItem>();
    [Parameter] public string AriaLabel { get; set; } = "Section";

    /// <summary>When true the tabs stretch to equal width (a full-width row) instead of sizing to their labels.</summary>
    [Parameter] public bool Equal { get; set; }

    /// <param name="Count">
    /// How many things the tab holds, shown after the label in the sheet's quieter
    /// <c>.pill-tab__count</c>. Null draws none - a count still loading is left out
    /// rather than shown as a zero that is not true yet.
    /// </param>
    /// <param name="Disabled">
    /// Held for now - the page is doing something following a tab would interrupt. Drawn
    /// as a disabled button rather than a link, so it cannot be followed.
    /// </param>
    public record PillTabItem(string Label, string Href, string? IconName, bool IsActive, int? Count = null, bool Disabled = false);

    private static RenderFragment TabBody(PillTabItem item) => @<text>
        @if (!string.IsNullOrEmpty(item.IconName))
        {
            <Icon Name="@item.IconName" Width="14" Height="14" />
        }
        <span>@item.Label</span>
        @if (item.Count is { } count)
        {
            <span class="pill-tab__count">@count</span>
        }
    </text>;
}
