@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using ALDevToolbox.Services.Organizations
@inject DisplayTimeZone DisplayZone

@*
    What has been done to one customer's Business Central environment: the update
    dates somebody moved, the updates somebody started, the slots still booked for
    later, and the ones that didn't work.

    Named user: a member of the BC upgrade team. They open this to answer "did
    anyone already do this customer?" and "what happened to the one we booked for
    last night?" - so every entry says who, when, and how it went, in that order,
    in plain words.

    Shared by the Upgrades page and the environment panel on a solution's Business
    Central tab, because the answer must not read differently depending on which
    page you happened to open. Presentational only: the page loads the entries and
    performs the cancel.

    Times: everything a person picked is shown in the customer's own time zone,
    named, because "20:00" means nothing to a colleague in another country. What
    already happened is shown as how long ago it was.

    See .design/saas-delivery.md and issue #657.
*@

@if (Entries is null)
{
    <div class="loading-block">
        <span class="spinner"></span><span>Loading what's been done here...</span>
    </div>
}
else if (Entries.Count == 0)
{
    <p class="u-muted">Nothing has been done to this environment from here yet.</p>
}
else
{
    <ul class="eaf">
        @foreach (var entry in Entries)
        {
            <li class="@ItemClass(entry.Status)" @key="entry.Id">
                <span class="eaf__icon" aria-hidden="true">
                    <Icon Name="@StatusIcon(entry.Status)" Width="15" Height="15" />
                </span>
                <div class="eaf__body">
                    <div class="eaf__what">
                        <b>@Headline(entry)</b>
                        @* The name alone in the sentence, the address on hover: a feed of
                           twenty entries reads as people, and "name <email>" on every line
                           is a log format, not a sentence. *@
                        <span class="u-muted" title="@entry.RequestedByEmail">@entry.RequestedByName</span>
                        <span class="u-muted"><Timestamp Value="@entry.RequestedAt" Relative="true" /></span>
                    </div>
                    <div class="eaf__status">
                        <span>@StatusText(entry)</span>
                        @* Beside the sentence it acts on, not pinned to the right: this
                           feed is embedded in a panel narrower than the page, and a
                           right-aligned button there ends up somewhere nobody looks. *@
                        @if (entry.IsPending && CanCancel(entry) && !IsMidInstall(entry))
                        {
                            <button type="button" class="btn btn--sm eaf__cancel"
                                    disabled="@(_cancelling == entry.Id)"
                                    @onclick="() => CancelAsync(entry.Id)">
                                @(_cancelling == entry.Id ? "Cancelling..." : entry.Kind == UpgradeActionKind.UploadApp ? "Cancel install" : "Cancel booking")
                            </button>
                        }
                    </div>
                    @if (entry.Status != UpgradeActionStatus.Pending && !string.IsNullOrWhiteSpace(entry.Outcome))
                    {
                        <div class="eaf__outcome">@entry.Outcome</div>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    /// <summary>The entries, newest first. Null renders the loading state.</summary>
    [Parameter] public List<UpgradeActionRow>? Entries { get; set; }

    /// <summary>
    /// True when this person may cancel a booked slot — the environment-updates grant on
    /// this customer. Reading the feed needs only being able to see the customer, so a
    /// colleague without the grant sees the same history without the Cancel buttons.
    /// </summary>
    [Parameter] public bool CanAct { get; set; }

    /// <summary>
    /// True when this person may cancel a booked upload - managing the customer, which is
    /// the check that made the booking. A different grant from <see cref="CanAct"/>: the
    /// update team moves platform updates, the solution's managers install apps.
    /// </summary>
    [Parameter] public bool CanActOnUploads { get; set; }

    private bool CanCancel(UpgradeActionRow entry) =>
        entry.Kind == UpgradeActionKind.UploadApp ? CanActOnUploads : CanAct;

    /// <summary>An upload the worker has claimed: nothing left to cancel, and a cancel would only be refused.</summary>
    private static bool IsMidInstall(UpgradeActionRow entry) =>
        entry.Kind == UpgradeActionKind.UploadApp && entry.SentAt is not null;

    /// <summary>The customer's own time zone, which booked slots are shown in.</summary>
    [Parameter] public TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Utc;

    /// <summary>What that zone is called on screen, e.g. "Europe/Copenhagen".</summary>
    [Parameter] public string TimeZoneLabel { get; set; } = "UTC";

    /// <summary>Raised with the action id when someone cancels a booked slot.</summary>
    [Parameter] public EventCallback<int> OnCancel { get; set; }

    private int? _cancelling;

    private async Task CancelAsync(int actionId)
    {
        if (_cancelling is not null) return;
        _cancelling = actionId;
        try
        {
            await OnCancel.InvokeAsync(actionId);
        }
        finally
        {
            _cancelling = null;
        }
    }

    /// <summary>
    /// What was asked for, in the words that stay true in every state the entry can reach.
    /// Booking and starting are opposite claims, so the headline has to know which this
    /// was: a booking says "Booked the update" whether it is still waiting, has since run,
    /// or was called off, and only an action somebody ran there and then says "Started".
    /// An immediate attempt that was refused never started at all, so it says it tried.
    /// </summary>
    private static string Headline(UpgradeActionRow entry)
    {
        if (entry.Kind == UpgradeActionKind.UpdateApp) return "Updated an AppSource app";
        if (entry.Kind == UpgradeActionKind.UploadApp)
        {
            // Every upload names its file: while it waits, the file is the whole of what
            // somebody deciding whether to cancel it needs to know. An upload asked for
            // "now" is still sent by the worker, so it has a waiting state of its own.
            var file = entry.PackageFileName ?? "an app";
            if (entry.IsBooking) return $"Booked the install of {file}";
            // "Uploaded", not "installed": a sent row may be one the workbench could not
            // see through to the end, and the status line carries that caveat.
            return entry.Status switch
            {
                UpgradeActionStatus.Sent => $"Uploaded {file}",
                UpgradeActionStatus.Failed => $"Tried to install {file}",
                _ => $"Asked to install {file} now",
            };
        }
        if (entry.Kind == UpgradeActionKind.RecoverEnvironment) return "Recovered the environment";
        if (entry.Kind == UpgradeActionKind.CopyEnvironment) return "Copied the environment";
        if (entry.Kind == UpgradeActionKind.CancelSession) return "Ended a signed-in session";
        if (entry.Kind == UpgradeActionKind.PushDateToLatest)
        {
            return entry.IsBooking
                ? "Booked a move of the update date"
                : "Moved the update date to the latest allowed";
        }
        // A version change names its version in the headline, because that is the whole
        // of what it did; the date is Business Central's, so there is nothing else to say.
        if (entry.Kind == UpgradeActionKind.SelectVersion)
        {
            var version = entry.TargetVersion ?? "another version";
            if (entry.IsBooking) return $"Booked a change of the next version to {version}";
            return entry.Status == UpgradeActionStatus.Failed
                ? $"Tried to set the next version to {version}"
                : $"Set the next version to {version}";
        }
        if (entry.IsBooking) return "Booked the update";
        return entry.Status == UpgradeActionStatus.Failed
            ? "Tried to start the update"
            : "Started the update";
    }

    /// <summary>
    /// Where the entry stands, as a sentence rather than a state name. A booked slot
    /// leads with when it runs, because that is the thing somebody reading this needs to
    /// decide whether to cancel it.
    /// </summary>
    private RenderFragment StatusText(UpgradeActionRow entry)
    {
        var sent = entry.SentAt ?? entry.RequestedAt;
        var cancelled = entry.CancelledAt ?? entry.RequestedAt;
        return entry.Status switch
        {
            // A booked slot leads with when it runs: that is what somebody deciding whether
            // to cancel it needs. Past its slot and still waiting is a different fact and
            // says so plainly rather than promising a time that has gone.
            UpgradeActionStatus.Pending when entry.Kind == UpgradeActionKind.UploadApp && entry.SentAt is not null
                => @<text>Installing now</text>,
            UpgradeActionStatus.Pending when entry.Kind == UpgradeActionKind.UploadApp && entry.ExecuteAfter <= DateTime.UtcNow
                => @<text>Starting shortly</text>,
            UpgradeActionStatus.Pending => entry.ExecuteAfter <= DateTime.UtcNow
                ? @<text>Was due at @SlotText(entry, entry.ExecuteAfter) - hasn't run yet.</text>
                : @<text>Runs at @SlotText(entry, entry.ExecuteAfter)</text>,
            UpgradeActionStatus.Sent => @<text>Done <Timestamp Value="@sent" Relative="true" /></text>,
            UpgradeActionStatus.Failed => @<text>Didn't work (<Timestamp Value="@sent" Relative="true" />)</text>,
            _ => entry.CancelledByName is { Length: > 0 } who
                ? @<text>Cancelled by @who <Timestamp Value="@cancelled" Relative="true" /></text>
                : @<text>Cancelled <Timestamp Value="@cancelled" Relative="true" /></text>,
        };
    }

    /// <summary>
    /// A booked slot, named with its zone. A platform-update slot is in the customer's own
    /// time - "20:00 on 11 Sep, Europe/Copenhagen time" - not the organisation's display
    /// zone: it was booked as a wall clock in the customer's zone, and is said back the
    /// way it was agreed. An upload's slot was picked on the page's own clock (the
    /// display zone), and is said back in that, as the Scheduled installs list says it.
    /// </summary>
    private string SlotText(UpgradeActionRow entry, DateTime utc)
    {
        if (entry.Kind == UpgradeActionKind.UploadApp)
        {
            return UploadAppDialog.SlotText(DisplayZone, utc);
        }
        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZone);
        return $"{local:HH:mm} on {local:d MMM}, {TimeZoneLabel} time";
    }

    /// <summary>
    /// The entry's class, composed here rather than interpolated into the markup, so
    /// every class name the component renders is a whole name a stylesheet can be checked
    /// against - the same rule the Upgrades page's row results follow.
    /// </summary>
    private static string ItemClass(UpgradeActionStatus status) => status switch
    {
        UpgradeActionStatus.Pending => "eaf__item eaf__item--pending",
        UpgradeActionStatus.Sent => "eaf__item eaf__item--ok",
        UpgradeActionStatus.Failed => "eaf__item eaf__item--bad",
        _ => "eaf__item eaf__item--muted",
    };

    private static string StatusIcon(UpgradeActionStatus status) => status switch
    {
        UpgradeActionStatus.Pending => "clock",
        UpgradeActionStatus.Sent => "check",
        UpgradeActionStatus.Failed => "triangle-alert",
        _ => "x",
    };
}
