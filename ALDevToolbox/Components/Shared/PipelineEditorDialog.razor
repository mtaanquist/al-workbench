@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ProjectDiscoveryService Discovery
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.PipelineService Pipelines
@inject ALDevToolbox.Services.GitHub.GitHubReleaseService GitHubReleases
@inject ILogger<PipelineEditorDialog> Log
@inject IServiceScopeFactory ScopeFactory
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone
@using Microsoft.Extensions.DependencyInjection
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Domain.ValueObjects

@*
    Create / edit a pipeline: name it and pick which of the solution's extensions it
    compiles. The checklist is served from the solution's discovered-extensions cache
    (warmed in the background when repos change), so it appears instantly; a Refresh
    re-discovers on demand. Shared by the Pipelines landing (New pipeline), the
    solution detail page (New pipeline), and the pipeline detail page (Edit pipeline).
    Opened imperatively via OpenForCreateAsync / OpenForEditAsync; raises OnSaved with
    the pipeline id. See .design/artifacts.md.
*@

@if (_open)
{
    <div class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="pe-title"
         tabindex="-1" @onkeydown="OnKeyDown" @ref="_root">
        <div class="modal-backdrop" @onclick="Cancel" aria-hidden="true"></div>
        <div class="confirm-dialog confirm-dialog--wide" @onclick:stopPropagation>
            <div class="confirm-dialog__head">
                <span class="confirm-dialog__icon" aria-hidden="true">
                    <Icon Name="rocket" Width="17" Height="17" />
                </span>
                <h2 id="pe-title" class="confirm-dialog__title">@(_editing ? "Edit pipeline" : "New pipeline")</h2>
            </div>
            <div class="confirm-dialog__body">
                @if (!_pickProject && !string.IsNullOrEmpty(_projectName))
                {
                    <div class="field">
                        <span class="field__label">Solution</span>
                        <span class="field__value">@_projectName</span>
                    </div>
                }

                @if (_pickProject)
                {
                    <div class="field">
                        <label class="field__label" for="pe-solution">Solution</label>
                        <SelectBox>
                            <select id="pe-solution" class="select" @onchange="OnProjectChosenAsync" disabled="@_saving">
                                <option value="0" selected="@(_projectId == 0)">Choose a solution...</option>
                                @foreach (var p in _projectOptions ?? [])
                                {
                                    <option value="@p.Id" selected="@(_projectId == p.Id)">@p.Name</option>
                                }
                            </select>
                        </SelectBox>
                    </div>
                }

                @if (!_pickProject || _projectId != 0)
                {
                    <div class="field">
                        <label class="field__label" for="pe-name">Name</label>
                        <input id="pe-name" type="text" class="input" maxlength="200" @bind="_name"
                               disabled="@_saving" placeholder="e.g. Production or Test environment" />
                        <small class="field__hint">A solution can have several pipelines, each compiling a different set of extensions - name this one for its environment.</small>
                    </div>
                    <div class="field">
                        <label class="field__label" for="pe-branch">Branch (optional)</label>
                        <input id="pe-branch" type="text" class="input" maxlength="@GitBranchName.MaxLength"
                               pattern="@GitBranchName.HtmlPattern" @bind="_branch"
                               disabled="@_saving" placeholder="e.g. main or release/25.0" spellcheck="false" autocomplete="off" />
                        <small class="field__hint">Builds check out this branch. Leave empty for each repository's default branch.</small>
                    </div>
                    <div class="field">
                        <label class="@(_previewCheck ? "check is-checked" : "check")">
                            <input id="pe-preview-check" type="checkbox" checked="@_previewCheck" disabled="@_saving"
                                   @onchange="e => _previewCheck = (bool)(e.Value ?? false)" />
                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            <span>Check against upcoming Business Central versions every night</span>
                        </label>
                        <small class="field__hint">Builds against Microsoft's previews of the next minor and next major Business Central versions, to catch breaking changes before they reach your customers. These preview builds can't be deployed; their results show beside the pipeline in the pipelines list.</small>
                    </div>
                    <div class="field">
                        <label class="@(_autoVersion ? "check is-checked" : "check")">
                            <input id="pe-auto-version" type="checkbox" checked="@_autoVersion" disabled="@_saving"
                                   @onchange="e => _autoVersion = (bool)(e.Value ?? false)" />
                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            <span>Add the build number to each app's version</span>
                        </label>
                        <small class="field__hint">The build number is added to the third part of the version: 28.2.0.0 in app.json becomes 28.2.4812.0 in build #4812. Business Central only installs a higher version over an installed app, so this lets every build be deployed without raising the version by hand. Your app.json files aren't changed.</small>
                    </div>
                }

                @if (_pickProject && _projectId == 0)
                {
                    <p>Choose a solution to see the extensions you can build.</p>
                }
                else if (IsDiscovering)
                {
                    <div class="loading-block loading-block--under-table">
                        <span class="spinner"></span>
                        <span>Looking for extensions in the solution's repositories...</span>
                    </div>
                }
                else if (_extensions is { Count: > 0 })
                {
                    <p>
                        Choose the extensions this pipeline compiles. Leave out legacy apps you no longer build.
                    </p>
                    <div class="sub-rows sub-rows--plain pe-picker">
                        @foreach (var ext in _extensions)
                        {
                            <label class="sub-row check @(IsSelected(ext.AppId) ? "is-checked" : "")">
                                <span class="sub-row__stack">
                                    <span class="sub-row__name">@ext.Name</span>
                                    <span class="sub-row__val">@Meta(ext)</span>
                                </span>
                                <span class="sub-row__acts">
                                    <input type="checkbox" checked="@IsSelected(ext.AppId)"
                                           @onchange="e => Toggle(ext.AppId, (bool)(e.Value ?? false))" />
                                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                </span>
                            </label>
                        }
                        <div class="sub-rows__foot">
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="SelectAll">Select all</button>
                            <button type="button" class="btn btn--ghost btn--sm" @onclick="SelectNone">Clear</button>
                            <span class="pe-picker__count">@_selected.Count of @_extensions.Count selected</span>
                        </div>
                    </div>
                    <div class="pe-discovery">
                        <small class="field__hint">@DiscoveredCaption</small>
                        <button type="button" class="btn btn--sm" @onclick="StartRefreshAsync" disabled="@IsDiscovering">
                            <Icon Name="refresh-cw" Width="14" Height="14" />
                            <span>Refresh</span>
                        </button>
                    </div>
                }
                else if (_discoverError is { } de)
                {
                    <Alert Tone="AlertTone.Danger"><span>@de</span></Alert>
                    <div class="pe-discovery">
                        <a class="btn btn--sm" href="/account?section=repos">
                            <Icon Name="key-round" Width="14" Height="14" />
                            <span>Manage repository tokens</span>
                        </a>
                        <button type="button" class="btn btn--sm" @onclick="StartRefreshAsync" disabled="@IsDiscovering">
                            <Icon Name="refresh-cw" Width="14" Height="14" />
                            <span>Try again</span>
                        </button>
                    </div>
                }
                else
                {
                    <p>
                        No extensions found in this solution's repositories. A pipeline needs at least one
                        folder with an <code>app.json</code> outside test folders. Check the repositories in
                        <a href="@($"/solutions/{_projectId}?tab=repositories")">solution setup</a>.
                    </p>
                    <div class="pe-discovery">
                        <small class="field__hint">@DiscoveredCaption</small>
                        <button type="button" class="btn btn--sm" @onclick="StartRefreshAsync" disabled="@IsDiscovering">
                            <Icon Name="refresh-cw" Width="14" Height="14" />
                            <span>Refresh</span>
                        </button>
                    </div>
                }

                @if (_releaseRepositories is { Count: > 0 } && (!_pickProject || _projectId != 0))
                {
                    <div class="field">
                        <label class="field__label" for="pe-release-repo">Publish successful builds to GitHub</label>
                        <SelectBox>
                            <select id="pe-release-repo" class="select" @bind="_releaseRepositoryId" disabled="@_saving">
                                <option value="0">Don't publish releases</option>
                                @foreach (var repo in _releaseRepositories)
                                {
                                    <option value="@repo.Id">@repo.FullName</option>
                                }
                            </select>
                        </SelectBox>
                        <small class="field__hint">All apps in a build have to share one version number, because the release is tagged with it. If they don't match, the build still succeeds and its files can still be downloaded here; only the release is skipped.</small>
                    </div>
                }
                else if (ShowUnavailableReleaseField)
                {
                    <div class="field">
                        <label class="field__label" for="pe-release-repo">Publish successful builds to GitHub</label>
                        <SelectBox>
                            <select id="pe-release-repo" class="select" disabled>
                                <option value="0">Don't publish releases</option>
                            </select>
                        </SelectBox>
                        <small class="field__hint">
                            @(_releaseRepositoriesFailed
                                ? "Couldn't reach GitHub just now; try again."
                                : "GitHub isn't connected for this organisation yet. An admin can connect it under Administration → Repositories.")
                        </small>
                    </div>
                }

                @if (_saveError is { } se)
                {
                    <Alert Tone="AlertTone.Danger"><span>@se</span></Alert>
                }

                @if (_extensions is { Count: > 0 } && !IsDiscovering && !_saving
                     && (string.IsNullOrWhiteSpace(_name) || _selected.Count == 0))
                {
                    <p class="field__hint pe-hint">Name your pipeline and select at least one extension to continue.</p>
                }
            </div>
            <div class="confirm-dialog__actions">
                <button type="button" class="btn" @onclick="Cancel" disabled="@_saving">Cancel</button>
                <button type="button" class="btn btn--primary" @onclick="SaveAsync"
                        disabled="@(IsDiscovering || _saving || _extensions is not { Count: > 0 } || _selected.Count == 0 || string.IsNullOrWhiteSpace(_name))">
                    <Icon Name="@(_editing ? "save" : "plus")" Width="14" Height="14" />
                    <span>@(_saving ? "Saving..." : _editing ? "Save pipeline" : "Create pipeline")</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Raised with the saved pipeline's id after a successful create/edit.</summary>
    [Parameter] public EventCallback<int> OnSaved { get; set; }

    /// <summary>How often the dialog re-checks the cache while a background discovery is in flight.</summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    /// <summary>
    /// Focus the dialog root once after it opens so its keydown handler receives Esc
    /// immediately — without this, Esc only works after the user has clicked into the
    /// modal (which is what put focus inside it).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _open)
        {
            _focusPending = false;
            try { await _root.FocusAsync(); }
            catch { /* element already detached */ }
        }
    }

    private bool _open;
    private bool _focusPending;
    private ElementReference _root;
    private bool _editing;
    private bool _pickProject;
    private IReadOnlyList<PipelineProjectOption>? _projectOptions;
    private int _projectId;
    private string? _projectName;
    private int? _pipelineId;
    private string _name = string.Empty;
    // The branch the pipeline builds; blank = each repository's default branch (#963).
    private string _branch = string.Empty;
    // The nightly preview check against the next minor and next major (#994).
    private bool _previewCheck;
    // Whether builds add their build number to each app's version.
    private bool _autoVersion = true;
    // The solution's GitHub repositories inside the connected organisation. Empty
    // (and the whole field hidden) when there is no GitHub connection - an
    // organisation on Azure DevOps is shown no GitHub machinery at all.
    private IReadOnlyList<GitHubReleaseRepositoryOption>? _releaseRepositories;
    private int _releaseRepositoryId;
    // True when there is nothing to pick but the person can still be told why.
    private bool _releaseRepositoriesExplainable;
    private bool _releaseRepositoriesFailed;

    /// <summary>Show the field disabled with a reason rather than hiding it entirely.</summary>
    private bool ShowUnavailableReleaseField =>
        _releaseRepositoriesExplainable && (!_pickProject || _projectId != 0);

    private bool _loadingDiscovery;
    private bool _saving;
    private string? _discoverError;
    private string? _saveError;
    private ProjectDiscovery? _discovery;
    private List<DiscoveredExtension>? _extensions;
    private HashSet<string> _selected = new(StringComparer.Ordinal);
    // The selection to pre-check (null = the pipeline builds everything).
    private IReadOnlySet<string>? _initialSelection;
    private bool _initialIsAll;
    private bool _selectionSeeded;

    private PeriodicTimer? _poll;
    private CancellationTokenSource? _pollCts;

    /// <summary>True while the cache is being read or a background discovery is running.</summary>
    private bool IsDiscovering => _loadingDiscovery || _poll is not null;

    /// <summary>Opens the dialog to create a new pipeline under a fixed solution (from the solution detail page).</summary>
    public async Task OpenForCreateAsync(int projectId, string projectName)
    {
        ResetForCreate();
        _pickProject = false;
        _projectId = projectId;
        _projectName = projectName;
        _open = true;
        _focusPending = true;
        await LoadReleaseRepositoriesAsync();
        await LoadDiscoveryAsync();
    }

    /// <summary>Opens the dialog to create a new pipeline, letting the user pick which solution (from the Pipelines landing).</summary>
    public Task OpenForCreateAsync(IReadOnlyList<PipelineProjectOption> solutions)
    {
        ResetForCreate();
        _pickProject = true;
        _projectOptions = solutions;
        _projectId = 0;
        _projectName = null;
        _open = true;
        _focusPending = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Opens the dialog to edit an existing pipeline. <paramref name="requestedAppIdsJson"/> is the stored selection (null = all).</summary>
    public async Task OpenForEditAsync(int pipelineId, int projectId, string projectName, string name, string? requestedAppIdsJson,
        int? githubReleaseRepositoryId = null, string? branch = null, bool previewCheck = false, bool autoVersion = true)
    {
        ResetForCreate();
        _editing = true;
        _pickProject = false;
        _projectId = projectId;
        _projectName = projectName;
        _pipelineId = pipelineId;
        _name = name;
        var parsed = ProjectBuildService.ParseSelectedAppIds(requestedAppIdsJson);
        _initialSelection = parsed;
        _initialIsAll = parsed is null;
        _releaseRepositoryId = githubReleaseRepositoryId ?? 0;
        _branch = branch ?? string.Empty;
        _previewCheck = previewCheck;
        _autoVersion = autoVersion;
        _open = true;
        _focusPending = true;
        await LoadReleaseRepositoriesAsync();
        await LoadDiscoveryAsync();
    }

    private void ResetForCreate()
    {
        StopPoll();
        _editing = false;
        _pipelineId = null;
        _name = string.Empty;
        _branch = string.Empty;
        _previewCheck = false;
        _autoVersion = true;
        _initialSelection = null;
        _initialIsAll = true; // new pipelines default to "build everything"
        _selectionSeeded = false;
        _discoverError = null;
        _saveError = null;
        _discovery = null;
        _extensions = null;
        _selected = new(StringComparer.Ordinal);
        _releaseRepositories = null;
        _releaseRepositoryId = 0;
        _releaseRepositoriesExplainable = false;
        _releaseRepositoriesFailed = false;
    }

    /// <summary>
    /// Loads the solution's publishable repositories. Never fails the dialog: without
    /// them the field simply isn't offered, which is the same as an organisation that
    /// has not connected GitHub.
    /// </summary>
    private async Task LoadReleaseRepositoriesAsync()
    {
        _releaseRepositoriesFailed = false;
        _releaseRepositoriesExplainable = false;
        if (_projectId == 0) { _releaseRepositories = null; return; }
        try
        {
            var choices = await GitHubReleases.DescribeRepositoryOptionsAsync(_projectId);
            _releaseRepositories = choices.Options;
            // Somebody whose solution is on GitHub but whose organisation has not
            // connected it can be helped by an admin - say so instead of hiding the
            // field, which would look like the feature does not exist.
            _releaseRepositoriesExplainable =
                choices.DeploymentConfigured && choices.HasGitHubRepositories && choices.Options.Count == 0;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Reading the solution's GitHub repositories failed for solution {ProjectId}.", _projectId);
            _releaseRepositories = null;
            _releaseRepositoriesFailed = true;
            _releaseRepositoriesExplainable = true;
        }
    }

    private async Task OnProjectChosenAsync(ChangeEventArgs e)
    {
        StopPoll();
        _selectionSeeded = false;
        _projectId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _releaseRepositoryId = 0;
        if (_projectId != 0)
        {
            await LoadReleaseRepositoriesAsync();
            await LoadDiscoveryAsync();
        }
    }

    /// <summary>
    /// Cache-first load: read the solution's discovered extensions, render them
    /// instantly when present, poll while a background discovery is in flight, and
    /// auto-trigger a discovery for a solution that has nothing usable cached: never
    /// discovered (e.g. a solution migrated before the cache existed), or whose last
    /// attempt failed.
    /// </summary>
    private async Task LoadDiscoveryAsync()
    {
        _loadingDiscovery = true;
        _discoverError = null;
        _saveError = null;
        _extensions = null;
        StateHasChanged();
        try
        {
            _discovery = await Discovery.GetDiscoveryAsync(_projectId);
            if (_discovery.Extensions.Count == 0 && !_discovery.InFlight)
            {
                // Never discovered, or the last attempt failed. A cached failure is
                // retried rather than shown: whatever caused it (a token, the App's
                // reach) is often fixed elsewhere since, and the stale error would
                // otherwise outlive the fix until someone thought to press Try again.
                await StartRefreshAsync();
                return;
            }
            if (_discovery.InFlight) StartPoll();
            else ApplyResultState();
        }
        catch (ProjectAccessDeniedException)
        {
            _discoverError = "Only the solution owner or an admin can manage this solution's pipelines.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Reading discovery cache failed for solution {ProjectId}.", _projectId);
            _discoverError = "Couldn't load the solution's extensions. Try Refresh, or check your repository tokens.";
        }
        finally
        {
            _loadingDiscovery = false;
        }
    }

    /// <summary>Enqueues a fresh background discovery and polls for it. Used by the Refresh button and the never-discovered auto-trigger.</summary>
    private async Task StartRefreshAsync()
    {
        if (_projectId == 0 || _poll is not null) return;
        _loadingDiscovery = true;
        _discoverError = null;
        _saveError = null;
        StateHasChanged();
        try
        {
            await Discovery.RequestDiscoveryAsync(_projectId);
            _discovery = await Discovery.GetDiscoveryAsync(_projectId);
            if (_discovery.InFlight) StartPoll();
            else ApplyResultState();
        }
        catch (ProjectAccessDeniedException)
        {
            _discoverError = "Only the solution owner or an admin can manage this solution's pipelines.";
        }
        catch (PlanValidationException ex)
        {
            _discoverError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't discover the solution's extensions.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Requesting discovery failed for solution {ProjectId}.", _projectId);
            _discoverError = "Couldn't discover the solution's extensions. Check the repositories and your repository tokens, then try again.";
        }
        finally
        {
            _loadingDiscovery = false;
        }
    }

    private void StartPoll()
    {
        if (_poll is not null) return;
        _pollCts = new CancellationTokenSource();
        _poll = new PeriodicTimer(PollInterval);
        _ = PollLoopAsync(_poll, _pollCts.Token);
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                // Own DI scope per tick: this runs on a thread-pool continuation, not the
                // circuit's dispatcher, so sharing the circuit's DbContext would let a tick
                // and a click have two commands in flight on one context. See #679.
                ProjectDiscovery discovery;
                await using (var scope = ScopeFactory.CreateAsyncScope())
                {
                    discovery = await scope.ServiceProvider.GetRequiredService<ProjectDiscoveryService>()
                        .GetDiscoveryAsync(_projectId, token);
                }

                // Disposal can happen while we were parked on the query; touching the
                // renderer after that logs an error for what is a normal navigate-away.
                if (token.IsCancellationRequested) break;
                if (!discovery.InFlight)
                {
                    StopPoll();
                    await InvokeAsync(() =>
                    {
                        _discovery = discovery;
                        ApplyResultState();
                        StateHasChanged();
                    });
                    break;
                }
                await InvokeAsync(() => _discovery = discovery);
            }
        }
        catch (OperationCanceledException) { /* circuit tearing down or solution switched */ }
        catch (ObjectDisposedException) when (token.IsCancellationRequested) { /* torn down mid-poll */ }
        catch (Exception ex)
        {
            Log.LogError(ex, "Discovery poll failed for solution {ProjectId}.", _projectId);
        }
        finally
        {
            StopPoll();
        }
    }

    /// <summary>
    /// Idempotent, single-shot teardown: disposal (renderer thread) and the poll loop's
    /// finally (thread pool) both call this, so the fields are claimed atomically to avoid
    /// a double Dispose / Cancel-on-disposed race.
    /// </summary>
    private void StopPoll()
    {
        var cts = Interlocked.Exchange(ref _pollCts, null);
        var timer = Interlocked.Exchange(ref _poll, null);
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
    }

    /// <summary>Settles a not-in-flight discovery into the checklist / error / empty state and seeds or preserves the selection.</summary>
    private void ApplyResultState()
    {
        var d = _discovery!;
        if (d.Extensions.Count > 0)
        {
            _discoverError = null;
            _extensions = d.Extensions.ToList();
            var ids = _extensions.Select(e => ProjectBuildService.NormalizeAppId(e.AppId)).ToHashSet(StringComparer.Ordinal);
            if (!_selectionSeeded)
            {
                // Pre-check: everything for a new (or "build all") pipeline; otherwise the
                // stored selection intersected with what's currently discovered.
                _selected = ids.Where(id => _initialIsAll || (_initialSelection?.Contains(id) ?? false)).ToHashSet(StringComparer.Ordinal);
                _selectionSeeded = true;
            }
            else
            {
                // A refresh: keep the user's choices, dropping any extension that's gone.
                _selected.IntersectWith(ids);
            }
        }
        else if (d.Error is not null)
        {
            _extensions = new();
            _discoverError = d.Error;
        }
        else
        {
            _extensions = new();
            _discoverError = null; // genuine empty → the empty state
        }
    }

    private void Cancel()
    {
        if (_saving) return;
        StopPoll();
        _open = false;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc") Cancel();
    }

    private bool IsSelected(string appId) => _selected.Contains(ProjectBuildService.NormalizeAppId(appId));

    private void Toggle(string appId, bool isChecked)
    {
        var key = ProjectBuildService.NormalizeAppId(appId);
        if (isChecked) _selected.Add(key);
        else _selected.Remove(key);
    }

    private void SelectAll()
    {
        if (_extensions is null) return;
        _selected = _extensions.Select(e => ProjectBuildService.NormalizeAppId(e.AppId)).ToHashSet(StringComparer.Ordinal);
    }

    private void SelectNone() => _selected = new(StringComparer.Ordinal);

    private static string Meta(DiscoveredExtension e)
    {
        var pub = string.IsNullOrWhiteSpace(e.Publisher) ? "" : $"{e.Publisher} · ";
        return $"{pub}v{e.Version} · {e.RepoDisplayName}";
    }

    /// <summary>The "Last checked ..." caption under the checklist.</summary>
    /// <summary>"Last checked 4 min ago.", with the exact instant in UTC on hover.</summary>
    private RenderFragment DiscoveredCaption => _discovery?.DiscoveredAt is { } at
        ? @<text>Last checked <span title="@Zone.UtcTooltip(at)">@TimeAgo(at)</span>.</text>
        : @<text>Not checked yet.</text>;

    /// <summary>
    /// This dialog's shorter phrasing ("4 min ago", then "on 2026-07-01" past a week);
    /// the date is in the organisation's display zone.
    /// </summary>
    private string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span switch
        {
            { TotalSeconds: < 60 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)span.TotalMinutes} min ago",
            { TotalHours: < 24 } => $"{(int)span.TotalHours} hr ago",
            { TotalDays: < 7 } => $"{(int)span.TotalDays} day{((int)span.TotalDays == 1 ? "" : "s")} ago",
            _ => $"on {Zone.Format(utc, "yyyy-MM-dd")}",
        };
    }

    private async Task SaveAsync()
    {
        if (_saving || _projectId == 0 || _extensions is not { Count: > 0 } || _selected.Count == 0 || string.IsNullOrWhiteSpace(_name)) return;
        _saving = true;
        _saveError = null;
        try
        {
            var picked = _extensions
                .Where(e => _selected.Contains(ProjectBuildService.NormalizeAppId(e.AppId)))
                .Select(e => e.AppId)
                .ToList();
            // All selected == build everything: store null so apps added later are included.
            var selection = picked.Count == _extensions.Count ? null : picked;
            var input = new PipelineInput(
                _projectId, _name.Trim(), selection,
                _releaseRepositoryId == 0 ? null : _releaseRepositoryId,
                string.IsNullOrWhiteSpace(_branch) ? null : _branch.Trim(),
                _previewCheck,
                _autoVersion);

            int id;
            if (_editing && _pipelineId is { } pid)
            {
                await Pipelines.UpdatePipelineAsync(pid, input);
                id = pid;
            }
            else
            {
                id = await Pipelines.CreatePipelineAsync(input);
            }
            StopPoll();
            _open = false;
            await OnSaved.InvokeAsync(id);
        }
        catch (PlanValidationException ex)
        {
            _saveError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't save the pipeline.";
        }
        catch (ProjectAccessDeniedException)
        {
            _saveError = "Only the solution owner or an admin can manage this solution's pipelines.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save pipeline for solution {ProjectId}.", _projectId);
            _saveError = "Couldn't save the pipeline.";
        }
        finally
        {
            _saving = false;
        }
    }

    public ValueTask DisposeAsync()
    {
        StopPoll();
        return ValueTask.CompletedTask;
    }
}
