@*
    On/off switch on the design system's .switch, for settings rows where the
    choice is binary and takes effect as a whole ("nightly backup: on").

    It wraps a real checkbox so a plain server-rendered form posts it - the
    handoff's switch is a static mock with no input at all. The track and knob
    follow the input's own state through the :has() rules in components.css,
    so nothing has to watch it.

    Unchecked checkboxes post nothing, which reads server-side as "absent"
    rather than "off". Set HiddenFalse when the endpoint needs to tell the two
    apart; it emits the usual paired hidden field before the checkbox, so the
    last value for the name wins.
*@

<label class="switch @(Disabled ? "is-disabled" : "") @Css">
    @if (HiddenFalse && !Disabled)
    {
        <input type="hidden" name="@Name" value="false" />
    }
    @if (CheckedChanged.HasDelegate)
    {
        @* Interactive page: the switch drives component state and saves on
           change. No name, because nothing is posting a form. *@
        <input type="checkbox" checked="@Checked" disabled="@Disabled"
               aria-label="@AriaLabel" aria-describedby="@AriaDescribedBy"
               @onchange="OnChangedAsync" />
    }
    else
    {
        <input type="checkbox" name="@Name" value="true" checked="@Checked" disabled="@Disabled"
               aria-label="@AriaLabel" aria-describedby="@AriaDescribedBy" />
    }
    <span class="switch__track"><span class="switch__knob"></span></span>
    <span>@Label</span>
</label>

@code {
    /// <summary>Form field name. The checkbox posts <c>true</c> when on.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>Text beside the switch. Says what the current state *is*
    /// ("Enabled", "02:00 UTC"), not what clicking would do.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Checked { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Emit a paired <c>hidden</c> false so the endpoint receives an
    /// explicit value when the switch is off.</summary>
    [Parameter] public bool HiddenFalse { get; set; }

    /// <summary>Bind with <c>@bind-Checked</c> on an interactive page. Supplying
    /// it switches the input from a form field to a state-driven one - a page
    /// that saves on toggle has no form to post.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>The checkbox's accessible name, when several rows share the
    /// same visible <see cref="Label"/> and need telling apart.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? AriaDescribedBy { get; set; }
    [Parameter] public string? Css { get; set; }

    private async Task OnChangedAsync(ChangeEventArgs e)
    {
        var next = e.Value is bool b ? b : false;
        Checked = next;
        await CheckedChanged.InvokeAsync(next);
    }
}
