@*
    The one primary action in an email: a filled link, plus the address written
    out underneath for when a mail filter or a corporate scanner breaks the
    button. In the plain-text part the button becomes "Label:" and the address,
    and the written-out line is left out (data-email-text, see EmailPlainText).
*@
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 16px;">
    <tr>
        @* mso-padding-alt gives Outlook on Windows the padding it ignores on the link; other clients ignore the property. *@
        <td bgcolor="@EmailTheme.ButtonFill" style="background-color: @EmailTheme.ButtonFill; border-radius: 2px; mso-padding-alt: 10px 18px;">
            <a href="@Href" data-email-text="button" target="_blank" style="display: inline-block; padding: 10px 18px; font-family: @EmailTheme.Font; font-size: 15px; font-weight: 600; line-height: 20px; color: @EmailTheme.ButtonText; text-decoration: none; border-radius: 2px;">@ChildContent</a>
        </td>
    </tr>
</table>
@if (ShowLink)
{
    <p data-email-text="skip" style="margin: 0 0 16px; font-size: 13px; line-height: 20px; color: @EmailTheme.Muted;">
        If the button does not work, copy this link into your browser:<br>
        <a href="@Href" target="_blank" style="color: @EmailTheme.Link; word-break: break-all;">@Href</a>
    </p>
}

@code {
    /// <summary>Where the button goes. Always an absolute URL: an email has no page to be relative to.</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;

    /// <summary>The label, a verb the reader would use: "Reset password", not "Click here".</summary>
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    /// <summary>Whether to write the address out under the button. On by default; turn it off only when the link carries nothing the reader needs if the button breaks.</summary>
    [Parameter] public bool ShowLink { get; set; } = true;
}
