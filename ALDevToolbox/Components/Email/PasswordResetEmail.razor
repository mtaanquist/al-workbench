@* Password reset link, sent from the forgot-password page. *@
<EmailLayout Preheader="Choose a new password within the next hour." Reason="You received this because someone asked to reset the password for this address.">
    <EmailParagraph>Hi @DisplayName,</EmailParagraph>
    <EmailParagraph>Someone, hopefully you, asked to reset your AL Workbench password. The link works for the next hour.</EmailParagraph>
    <EmailButton Href="@ResetUrl">Reset password</EmailButton>
    <EmailParagraph>If you did not ask for this, you can ignore this email. Your password stays the same.</EmailParagraph>
</EmailLayout>

@code {
    public const string Subject = "Reset your AL Workbench password";

    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ResetUrl { get; set; } = string.Empty;

    public static Task<EmailContent> RenderAsync(EmailRenderer renderer, string displayName, string resetUrl, CancellationToken ct = default)
        => renderer.RenderAsync<PasswordResetEmail>(Subject, new Dictionary<string, object?>
        {
            [nameof(DisplayName)] = displayName,
            [nameof(ResetUrl)] = resetUrl,
        }, ct);
}
