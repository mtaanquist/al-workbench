@* A one-time code the reader types in somewhere, set large and spaced so it is easy to copy by eye. *@
<p style="margin: 4px 0 20px; font-family: @EmailTheme.Mono; font-size: 26px; font-weight: 600; line-height: 32px; letter-spacing: 0.15em; color: @EmailTheme.Ink;">@Code</p>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = string.Empty;
}
