@* Sent to the current address as soon as an administrator asks to change it, with a link to stop the change. *@
<EmailLayout Preheader="@($"{RequestedByName} asked to change the email address on your account.")" Reason="You received this because an administrator asked to change the email address on the AL Workbench account that uses this address.">
    <EmailParagraph>Hi @DisplayName,</EmailParagraph>
    <EmailParagraph><strong>@RequestedByName</strong> (@RequestedByEmail), an administrator in your organisation, asked to change the email address on your AL Workbench account to <strong>@NewEmail</strong>.</EmailParagraph>
    <EmailParagraph>Once that address confirms the change, you sign in with it instead of this one, and you are signed out everywhere.</EmailParagraph>
    <EmailParagraph>If you did not expect this, stop the change now. The link works once, for the next 24 hours.</EmailParagraph>
    <EmailButton Href="@CancelUrl">Stop this change</EmailButton>
    <EmailParagraph>If you expected it, you don't need to do anything.</EmailParagraph>
</EmailLayout>

@code {
    public const string Subject = "Someone asked to change your AL Workbench email";

    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string RequestedByName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string RequestedByEmail { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NewEmail { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CancelUrl { get; set; } = string.Empty;

    public static Task<EmailContent> RenderAsync(
        EmailRenderer renderer, string displayName, string requestedByName, string requestedByEmail, string newEmail,
        string cancelUrl, CancellationToken ct = default)
        => renderer.RenderAsync<EmailChangeRequestedEmail>(Subject, new Dictionary<string, object?>
        {
            [nameof(DisplayName)] = displayName,
            [nameof(RequestedByName)] = requestedByName,
            [nameof(RequestedByEmail)] = requestedByEmail,
            [nameof(NewEmail)] = newEmail,
            [nameof(CancelUrl)] = cancelUrl,
        }, ct);
}
