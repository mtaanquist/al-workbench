@page "/templates"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Interactivity is opt-in per page in this app (see Program.cs
   AddInteractiveServerRenderMode). The filter box and its "Clear search" button
   are event handlers, so without this they render but silently do nothing. *@
@rendermode InteractiveServer
@using ALDevToolbox.Services.Templates
@inject TemplateService Templates

<PageTitle>Templates · AL Workbench</PageTitle>

@*
    Archetype 2 (list / browser) from the BC design handoff — the first page
    onto it. Four states, not three: the fourth is filtered-empty, which offers
    "Clear search" rather than "New", because "no templates yet" is a lie when
    some exist and the filter simply matched none. Row status is the 4px edge
    keyline plus a leading glyph (never a pill in a table row); loading is
    skeleton cells under the real header so column widths don't jump.
    See .design/design-migration.md.
*@

@* Two lists share this frame, so each section keeps its own loading, empty and
   no-match states; ListPage supplies the head and the filter row over both. *@
<ListPage Title="Templates"
          Subtitle="The workspace templates and modules available in your organisation. Browse them here; an admin edits them under Administration."
          Trail='@([new("Home", "/"), new("Templates")])'>
    <Search>
        <input class="input" type="search" placeholder="Filter by name or runtime..."
               aria-keyshortcuts="F3" title="Filter templates and modules (F3)"
               value="@_query" @oninput="OnSearch" aria-label="Filter templates and modules" />
    </Search>
    <ChildContent>
    <section>
        <p class="section-label">Workspace templates</p>
        @if (_templates is not null && FilteredTemplates.Count == 0)
        {
            @if (_templates.Count == 0)
            {
                <div class="card">
                    <EmptyState Icon="layers" Title="No templates yet">
                        <Text>
                            A template describes the folders, settings and modules a new workspace starts from.
                            @* Importing is an editor's job; a member who cannot open
                               that page is told who to ask instead of being sent to it. *@
                            <AuthorizeView Roles="Admin,Editor">
                                <Authorized>Import one from the site catalogue to get started.</Authorized>
                                <NotAuthorized>Ask one of your administrators to import one.</NotAuthorized>
                            </AuthorizeView>
                        </Text>
                        <Action>
                            <AuthorizeView Roles="Admin,Editor">
                                <a class="btn btn--primary" href="/admin/templates">Import a template</a>
                            </AuthorizeView>
                        </Action>
                    </EmptyState>
                </div>
            }
            else
            {
                <div class="card">
                    <EmptyState Icon="funnel-x" Title="@($"No templates match \"{_query}\"")">
                        <Text>Try a shorter search, or clear it to see all @_templates.Count.</Text>
                        <Action><button class="btn" type="button" @onclick="ClearSearch">Clear search</button></Action>
                    </EmptyState>
                </div>
            }
        }
        else
        {
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                        <th>Name</th>
                        <th>Runtime</th>
                        <th>Description</th>
                        <th class="data-table__num">Extensions</th>
                        <th class="data-table__actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_templates is null)
                    {
                        <TableSkeletonRows Columns="5" />
                    }
                    @foreach (var t in FilteredTemplates)
                    {
                        var state = t.Deprecated ? "deprecated" : "active";
                        <tr class="@RowStateIcon.RowClass(state)">
                            <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                            <td>@t.Name</td>
                            <td>@t.Runtime</td>
                            <td class="u-muted">@t.Description</td>
                            <td class="data-table__num">@t.WorkspaceExtensions.Count</td>
                            <td class="data-table__actions">
                                <a class="btn btn--sm" href="@($"/templates/{Uri.EscapeDataString(t.Key)}")">
                                    <Icon Name="eye" Width="14" Height="14" />
                                    <span>View</span>
                                </a>
                                @if (!t.Deprecated)
                                {
                                    <a class="btn btn--sm" href="@($"/templates/workspace?template={Uri.EscapeDataString(t.Key)}")">
                                        <Icon Name="folder-plus" Width="14" Height="14" />
                                        <span>New workspace</span>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_templates is null)
            {
                <LoadingBlock Text="Loading templates..." UnderTable="true" />
            }
        }
    </section>

    <section>
        <p class="section-label">Modules</p>
        @if (_modules is not null && FilteredModules.Count == 0)
        {
            @if (_modules.Count == 0)
            {
                <div class="card">
                    <EmptyState Icon="package" Title="No modules yet">
                        <Text>Modules are the optional building blocks a workspace can include. They arrive with the templates an admin imports.</Text>
                    </EmptyState>
                </div>
            }
            else
            {
                <div class="card">
                    <EmptyState Icon="funnel-x" Title="@($"No modules match \"{_query}\"")">
                        <Text>Try a shorter search, or clear it to see all @_modules.Count.</Text>
                        <Action><button class="btn" type="button" @onclick="ClearSearch">Clear search</button></Action>
                    </EmptyState>
                </div>
            }
        }
        else
        {
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                        <th>Name</th>
                        <th class="data-table__num">Dependencies</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_modules is null)
                    {
                        <TableSkeletonRows Columns="2" />
                    }
                    @foreach (var m in FilteredModules)
                    {
                        var state = m.Deprecated ? "deprecated" : "active";
                        <tr class="@RowStateIcon.RowClass(state)">
                            <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                            <td>@m.Name</td>
                            <td class="data-table__num">@m.Dependencies.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_modules is null)
            {
                <LoadingBlock Text="Loading modules..." UnderTable="true" />
            }
        }
    </section>
    </ChildContent>
</ListPage>

@code {
    private List<ALDevToolbox.Domain.Entities.RuntimeTemplate>? _templates;
    private List<ALDevToolbox.Domain.Entities.Module>? _modules;
    private string _query = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _templates = await Templates.GetTemplatesAsync(includeDeprecated: true);
        _modules = await Templates.GetModulesAsync(includeDeprecated: true);
    }

    private List<ALDevToolbox.Domain.Entities.RuntimeTemplate> FilteredTemplates =>
        _templates is null ? new()
        : string.IsNullOrWhiteSpace(_query) ? _templates
        : _templates.Where(t => Matches(t.Name) || Matches(t.Runtime) || Matches(t.Description)).ToList();

    private List<ALDevToolbox.Domain.Entities.Module> FilteredModules =>
        _modules is null ? new()
        : string.IsNullOrWhiteSpace(_query) ? _modules
        : _modules.Where(m => Matches(m.Name)).ToList();

    private bool Matches(string? value) =>
        value is not null && value.Contains(_query, StringComparison.OrdinalIgnoreCase);

    private void OnSearch(ChangeEventArgs e) => _query = e.Value?.ToString() ?? string.Empty;

    private void ClearSearch() => _query = string.Empty;
}
