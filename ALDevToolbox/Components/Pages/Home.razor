@page "/"
@using ALDevToolbox.Domain.Tools
@using ALDevToolbox.Endpoints
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Tools
@inject IToolAvailability ToolAvailability
@inject DashboardService Dashboard

<PageTitle>AL Workbench</PageTitle>

@*
    Tools home, on page archetype 1 ("tool launcher"). Cards stay visible for
    unauthenticated visitors - each card just points at /login?returnUrl=<tool>
    instead of the tool itself, and we add a small lock badge so it's obvious
    sign-in is needed first. The MCP card is additionally gated on the site-wide
    MCP enable flag (no point linking to a feature the SiteAdmin turned off).

    The .section-label groups, and their names, come from the hand-off's own
    launcher. They earn their place twice over here: this page was a flat run of
    tiles with no way in other than reading all of them, and it was also missing
    four tools outright - Solutions, Pipelines, Releases and Translator were in
    the sidebar and never on the launcher, so the whole deliver half of the
    product was invisible to anyone who started from the front page.

    .tool-tile__meta carries a count only for the four tools that hold content.
    A tool that is empty is a wasted click, and the tile is the last place we
    can say so; the tools that need no data (both generators, Piper, Compare,
    MCP) get no meta line rather than a manufactured one. An empty count names
    the next step rather than stating the void.

    DIVERGENCE: the hand-off's third group is "Translate and compare" and holds
    its MCP tile. Ours holds Piper too, which is neither, and MCP is neither -
    so the group is named for what it actually contains and MCP gets its own.
    A heading that excludes half its tiles is where someone hunting for "how do
    I hook up Claude" gives up.

    DIVERGENCE: group order. The hand-off runs Build, Translate and compare,
    Deliver; ours runs Build, Deliver, Work with text, Connect an assistant.
    Deliver moves up because it is the half of the product a returning user
    comes back for, where the text tools are reached once and rarely again.
*@

@* Tiles follow the same site + per-org tool toggles as the sidebar (see
   Domain/Tools/ToolCatalog.cs); a switched-off tool's tiles disappear here too,
   and a group whose tools are all off goes with them. Signed-out visitors have
   no org context, so their tiles follow the site-wide toggle only, link to the
   login page, and carry no counts - what a tool holds is the organisation's
   business, not a signed-out visitor's. *@
<AuthorizeView>
    <Authorized>
        <LauncherPage Title="AL Workbench" Subtitle="Pick a tool to get started." Groups="@Groups(signedIn: true)" />
    </Authorized>
    <NotAuthorized>
        <LauncherPage Title="AL Workbench" Subtitle="Sign in to open these tools. Diff works without an account."
                      Groups="@Groups(signedIn: false)" />
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private HashSet<ToolKey> _orgDisabled = new();
    private ToolCounts _counts = ToolCounts.Empty;

    // OnInitializedAsync, not OnParametersSetAsync: cascading parameters are
    // supplied before initialisation, so the auth state is already here, and
    // this runs once per component rather than on every cascading notification.
    // The page is static SSR today, where the difference is invisible - but the
    // moment anyone adds @rendermode InteractiveServer, the old hook would fire
    // four DB queries onto the circuit's shared context on every notification,
    // which is the shape of issue #551.
    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null) return;
        var state = await AuthStateTask;
        _orgDisabled = EndpointHelpers.ReadDisabledTools(state.User);
        // Signed-out visitors have no organisation, so there is nothing to
        // count and the tenant filter would match nothing anyway.
        if (state.User.Identity?.IsAuthenticated == true)
        {
            _counts = await Dashboard.GetToolCountsAsync();
        }
    }

    // Site-enabled and not switched off for this org — mirrors the sidebar.
    private bool ToolVisible(ToolKey key) =>
        ToolAvailability.IsSiteEnabled(key) && !_orgDisabled.Contains(key);

    /// <summary>
    /// The launcher's one list of tiles, rendered for both audiences. The names and
    /// order of the groups match the sidebar's (NavMenu.razor); keep the two in step.
    /// The three template tiles share the Templates toggle.
    /// </summary>
    private IReadOnlyList<LauncherGroup> Groups(bool signedIn)
    {
        LauncherTile? Tile(ToolKey key, string title, string text, string icon, string href,
            Func<string>? meta = null, bool needsAccount = true)
        {
            var visible = signedIn ? ToolVisible(key) : ToolAvailability.IsSiteEnabled(key);
            if (!visible) return null;
            return new LauncherTile(title, text, icon, href,
                Meta: signedIn ? meta?.Invoke() : null,
                Locked: !signedIn && needsAccount);
        }

        static LauncherGroup Group(string label, params LauncherTile?[] tiles) =>
            new(label, tiles.OfType<LauncherTile>().ToList());

        return new[]
        {
            Group("Build",
                Tile(ToolKey.Templates, "Workspace", "Generate a multi-extension AL workspace from a runtime template.", "folder-plus", "/templates/workspace"),
                Tile(ToolKey.Templates, "Extension", "Generate a single standalone AL extension.", "package", "/templates/extension"),
                Tile(ToolKey.Templates, "Templates", "Browse the runtime templates available for your organisation.", "layers", "/templates", TemplatesMeta),
                Tile(ToolKey.Cookbook, "Cookbook", "Search the AL recipe library and suggest new ones.", "square-code", "/cookbook", CookbookMeta),
                Tile(ToolKey.ObjectExplorer, "Object Explorer", "Browse BC releases, modules, objects, and source files.", "search", "/object-explorer", ObjectExplorerMeta)),
            Group("Deliver",
                Tile(ToolKey.Projects, "Solutions", "Point a customer's Git repositories at AL Workbench and build them into .app files.", "folder-git-2", "/solutions", ProjectsMeta),
                Tile(ToolKey.Pipelines, "Build pipelines", "Compile some or all of a solution's extensions, and watch the build as it happens.", "rocket", "/pipelines/builds"),
                Tile(ToolKey.Releases, "Deployment pipelines", "Deploy a build to a customer's Business Central environment.", "send", "/pipelines/deployments")),
            Group("Work with text",
                Tile(ToolKey.Translator, "Translator", "Edit an XLIFF file's translation units, filter by state, and fill the gaps.", "languages", "/translator"),
                // Diff works without an account - link it directly, no lock.
                Tile(ToolKey.Compare, "Diff", "Paste two texts side by side and see what changed.", "git-compare", "/diff", needsAccount: false),
                Tile(ToolKey.Piper, "Piper", "Turn a list of values into a pipe-separated filter, an SQL IN list, or another format.", "git-merge", "/piper"),
                Tile(ToolKey.Sealed, "Sealed", "Send a password or client secret as a link that opens a set number of times, instead of pasting it into an email.", "lock", "/sealed")),
            Group("Connect an assistant",
                Tile(ToolKey.Mcp, "MCP", "Let Claude, Cursor, or another AI assistant read your templates, recipes and BC objects.", "bot", "/tools/mcp")),
        };
    }

    private string TemplatesMeta() => _counts.Templates == 0
        ? "None yet - ask an admin to import some"
        : Plural(_counts.Templates, "template");

    private string CookbookMeta() => _counts.Recipes == 0
        ? "No recipes yet - suggest the first one"
        : Plural(_counts.Recipes, "recipe");

    private string ObjectExplorerMeta() => _counts.Releases == 0
        ? "No BC releases yet - ask an admin to import one"
        : Plural(_counts.Releases, "BC release");

    private string ProjectsMeta() => _counts.Projects == 0
        ? "No solutions yet - add your first"
        : Plural(_counts.Projects, "solution");

    private static string Plural(int n, string noun) => $"{n:N0} {noun}{(n == 1 ? "" : "s")}";
}
