@page "/cookbook/suggest"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RecipeSuggestionService Suggestions
@inject ApplicationVersionService ApplicationVersions
@inject NavigationManager Nav
@inject ILogger<SuggestRecipe> Log
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Cookbook
@using ALDevToolbox.Services.Templates

<PageTitle>Suggest a recipe · AL Workbench</PageTitle>

<div class="page">
    <PageHead Title="Suggest a recipe">
        <SubtitleContent>
            Submit a reusable AL recipe for an admin to review. Pick a type
            (Snippet, Pattern, or Module), give it a clear title and
            description, comma-separate the search keywords, and add one or
            more files. Each file may live in a folder (set its
            <strong>Folder</strong> field) - the ZIP download preserves the
            folder structure.
        </SubtitleContent>
        <Actions>
            <a class="btn btn--sm" href="/cookbook">
                <Icon Name="arrow-left" Width="14" Height="14" />
                <span>Back to cookbook</span>
            </a>
            @if (!_submitted)
            {
                <button type="button" class="btn btn--sm btn--primary" @onclick="SubmitAsync" disabled="@_busy">
                    <Icon Name="send" Width="14" Height="14" />
                    <span>@(_busy ? "Submitting..." : "Submit for review")</span>
                </button>
            }
        </Actions>
    </PageHead>

    @if (_submitted)
    {
        <Alert Tone="AlertTone.Success">
            <span>
                Thanks - your suggestion is pending review. An admin will approve
                or reject it shortly.
            </span>
        </Alert>
        <a class="btn" href="/cookbook">Back to cookbook</a>
    }
    else
    {
        <section class="form-sec">
            <div class="form-sec__head"><span class="section-label">Details</span></div>
            @* Two columns, not one full-width stack: a title input 1,100px wide
               is harder to scan than one at half that, and .form-grid is the
               archetype's own answer. Long fields opt back out with
               .field--full. *@
            <div class="form-grid">
            <div class="field field--full">
                <label class="field__label" for="recipe-title">Title</label>
                <input id="recipe-title" type="text" class="input" maxlength="200"
                       @bind="_title" @bind:event="oninput"
                       placeholder="e.g. Doc. Attachment List Factbox for an unsupported table" />
                <FieldError Field="Title" Errors="_errors" />
            </div>

            <div class="field">
                <label class="field__label" for="recipe-type">Type</label>
                <SelectBox>
                <select id="recipe-type" class="select" @bind="_type">
                    <option value="@RecipeType.Snippet">Snippet - small, one or two files</option>
                    <option value="@RecipeType.Pattern">Pattern - a few related files</option>
                    <option value="@RecipeType.Module">Module - near-complete feature</option>
                </select>
                </SelectBox>
                <FieldError Field="Type" Errors="_errors" />
            </div>

            <div class="field">
                <label class="field__label" for="recipe-min-version">Minimum BC application version (optional)</label>
                <SelectBox>
                <select id="recipe-min-version" class="select" @bind="_minimumApplicationVersionId">
                    <option value="">No minimum</option>
                    @foreach (var v in _applicationVersions)
                    {
                        <option value="@v.Id">@v.Name (@v.Application)</option>
                    }
                </select>
                </SelectBox>
                <small class="field__hint">
                    Pick the lowest BC release this recipe compiles against. Shown as a
                    badge on the published recipe.
                </small>
                <FieldError Field="MinimumApplicationVersionId" Errors="_errors" />
            </div>

            <div class="field field--full">
                <label class="field__label" for="recipe-description">Description</label>
                <textarea id="recipe-description" class="textarea" rows="4" maxlength="2000"
                          @bind="_description" @bind:event="oninput"
                          placeholder="What does this recipe do, and when would you use it?"></textarea>
                <FieldError Field="Description" Errors="_errors" />
            </div>

            <div class="field field--full">
                <label class="field__label" for="recipe-keywords">Keywords</label>
                <input id="recipe-keywords" type="text" class="input" maxlength="500"
                       @bind="_keywords" @bind:event="oninput"
                       placeholder='space-separated; wrap a phrase in quotes, e.g. "document attachments" factbox subscriber' />
                <small class="field__hint">
                    Separate tags with spaces or commas. Wrap a multi-word tag in
                    double quotes to keep it as one - e.g.
                    <code>"document attachments"</code>.
                </small>
                <FieldError Field="Keywords" Errors="_errors" />
            </div>

            <div class="field">
                <label class="field__label" for="recipe-value-hours">Estimated value (hours)</label>
                <input id="recipe-value-hours" type="number" class="input" min="0" step="0.25"
                       @bind="_estimatedValueHours" @bind:event="oninput"
                       placeholder="e.g. 8" />
                <small class="field__hint">
                    Optional. Roughly how many hours of work this recipe saves
                    whoever uses it. The reviewing admin can adjust it.
                </small>
                <FieldError Field="EstimatedValueHours" Errors="_errors" />
            </div>

            <div class="field field--full">
                <label class="field__label" for="recipe-instructions">Instructions (optional, Markdown)</label>
                <textarea id="recipe-instructions" class="textarea" rows="6" maxlength="10000"
                          @bind="_instructions" @bind:event="oninput"
                          placeholder="Where should the recipient put this? Anything to add to a permission set or setup table? Markdown is rendered on the published page."></textarea>
                <FieldError Field="Instructions" Errors="_errors" />
            </div>
            </div>
        </section>

        <section class="form-sec">
            <div class="form-sec__head"><span class="section-label">Files</span></div>
            <p class="form-sec__cap">
                Each file becomes one AL object. The optional <strong>Folder</strong>
                field puts the file inside that directory of the ZIP - leave it
                blank for files at the root.
            </p>
            <RecipeFileEditor Files="_files" Errors="_errors" />
        </section>

        @foreach (var message in UnfieldedErrors)
        {
            <Alert Tone="AlertTone.Danger">
                <span>@message</span>
            </Alert>
        }
        @if (_lastError is not null)
        {
            <Alert Tone="AlertTone.Danger">
                <span>@_lastError</span>
            </Alert>
        }
    }
</div>

@code {
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string _keywords = string.Empty;
    private string _instructions = string.Empty;
    private RecipeType _type = RecipeType.Snippet;
    private string _minimumApplicationVersionId = string.Empty;
    private decimal? _estimatedValueHours;
    private List<ApplicationVersion> _applicationVersions = new();
    private List<RecipeFileEditor.EditableFile> _files = new() { new RecipeFileEditor.EditableFile() };
    private IReadOnlyDictionary<string, string>? _errors;

    // Keys a FieldError on this page renders. Anything else - the storage
    // quota refusal, for one - has no field to sit under, so it goes in the
    // alert at the bottom instead of vanishing (#1600).
    private static readonly HashSet<string> FieldedKeys = new(StringComparer.Ordinal)
    {
        "Title", "Type", "MinimumApplicationVersionId", "Description",
        "Keywords", "EstimatedValueHours", "Instructions",
    };

    private IEnumerable<string> UnfieldedErrors =>
        _errors is null
            ? Enumerable.Empty<string>()
            : _errors.Where(e => !FieldedKeys.Contains(e.Key) && !e.Key.StartsWith("Files", StringComparison.Ordinal))
                .Select(e => e.Value);
    private string? _lastError;
    private bool _busy;
    private bool _submitted;

    protected override async Task OnInitializedAsync()
    {
        _applicationVersions = await ApplicationVersions.GetActiveAsync();
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        _errors = null;
        _lastError = null;
        try
        {
            var input = new RecipeSuggestionInput(
                _title,
                _description,
                _keywords,
                _type,
                _files.Select(f => new RecipeFileInput(f.FileName, f.Content, f.RelativePath)).ToList(),
                Instructions: _instructions,
                MinimumApplicationVersionId: int.TryParse(_minimumApplicationVersionId, out var avId) ? avId : null,
                EstimatedValueHours: _estimatedValueHours);
            await Suggestions.SubmitAsync(input);
            _submitted = true;
        }
        catch (PlanValidationException ex)
        {
            _errors = ex.Errors;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to submit recipe suggestion.");
            _lastError = "An unexpected error occurred. Your suggestion was not saved.";
        }
        finally
        {
            _busy = false;
        }
    }
}
