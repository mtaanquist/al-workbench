@page "/login/magic"
@layout ALDevToolbox.Components.Layout.AuthLayout
@using ALDevToolbox.Components.Shared

<PageTitle>Sign in with a link · AL Workbench</PageTitle>

@*
    The magic-link half of sign-in. The Password / Magic link tab bar is gone
    here as it is on Login: this page is reached from Login's .auth__sso block,
    and a tab strip that only ever has one other tab was doing the same job with
    more chrome. "Use a password instead" goes back the other way.

    Same DIVERGENCE as /forgot-password on the confirmation: no .auth__mail,
    because the endpoint deliberately returns nothing but ok=1 so this page
    cannot be used to find out who has an account.
*@

@if (Ok == "1")
{
    <AuthCard>
        <Head>
            <div class="auth__ok">
                <span class="auth__ok-icon"><Icon Name="mail" Width="20" Height="20" /></span>
                <h1 class="auth__title">Check your email</h1>
                <p class="auth__sub">
                    If that email matches an account, a sign-in link is on its way.
                    It works once and expires in 15 minutes.
                </p>
            </div>
        </Head>
        <ChildContent>
            <a class="btn" href="/login/magic">Send it again</a>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/login">Use a password instead</a>
        </Foot>
        <Legal>Nothing after a few minutes? Check your spam folder, then ask your administrator for help signing in.</Legal>
    </AuthCard>
}
else if (Error == "not-configured")
{
    <AuthCard Title="Sign-in links are turned off">
        <Sub>
            This copy of AL Workbench can't send email yet, so it can't send you a
            sign-in link. Sign in with your password instead.
        </Sub>
        <ChildContent>
            <a class="btn btn--primary" href="/login" style="height: var(--control-h-lg)">
                <Icon Name="log-in" Width="16" Height="16" />
                <span>Sign in with a password</span>
            </a>
        </ChildContent>
    </AuthCard>
}
else
{
    <AuthCard Title="Sign in with a link" FormAction="/auth/login/magic">
        <Sub>We'll email you a single-use link. No password needed.</Sub>
        <Alerts>
            @if (Error == "invalid")
            {
                @* A link that was already used or has expired lands here, so
                   the message sits above the form that sends a new one. *@
                <Alert Tone="AlertTone.Danger">
                    <span>@(Message ?? "This sign-in link is no longer valid. Request a new one.")</span>
                </Alert>
            }
        </Alerts>
        <ChildContent>
            <div class="auth__fields">
                <div class="field">
                    <label class="field__label" for="ml-email">Email</label>
                    <input class="input" id="ml-email" type="email" name="Email" required autofocus
                           autocomplete="username" placeholder="you@cronus.example" />
                </div>
            </div>
            <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg)">
                <Icon Name="mail" Width="16" Height="16" />
                <span>Send sign-in link</span>
            </button>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/login">Use a password instead</a>
        </Foot>
    </AuthCard>
}

@code {
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
}
