@page "/account/2fa/totp/setup"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@* Rendered on the server only, never interactive: the page has nothing to
   click that isn't a link or a form post, and it has to set the cookie that
   lets this browser - and no other - come back to the same secret (#1614). *@
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Account
@inject IOrganizationContext Org
@inject TotpService Totp
@inject StepUpService StepUp
@inject NavigationManager Nav

@*
    Two steps, one card each. The design system's own "setup steps" archetype
    (.steps / .step) lives in pages-content.css, which this branch has not pulled
    yet - see .design/handoff/README.md, "pull the layer you are porting". A card
    per step carries the same numbered sequence on the layer we already ship.
*@

<PageTitle>Set up authenticator · AL Workbench</PageTitle>

<div class="page">
    <PageHead Title="Set up authenticator app"
              Subtitle="Once this is on, signing in asks for a six-digit code from your phone as well as your password."
              Trail='@([new("Sign-in & security", "/account/security"), new("Authenticator app")])' />

    @if (!string.IsNullOrEmpty(Reason))
    {
        <Alert Tone="AlertTone.Danger">
            <span>@FormErrorReasons.MessageFor(Reason)</span>
        </Alert>
    }

    @if (_mustStepUp)
    {
        @* Turning this on adds a second factor the owner would then need, so it
           asks for the same proof as adding a passkey (#1614). The QR is not
           shown, nor a secret made, until the person has confirmed. *@
        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Confirm it's you first</h2>
                    <p class="card__sub">Turning on an authenticator app changes how you sign in, so we check it's really you before showing the code to scan.</p>
                </div>
            </div>
            <div class="card__foot">
                <a class="btn" href="/account/security">Cancel</a>
                <a class="btn btn--primary" href="@ConfirmUrl">
                    <Icon Name="shield" Width="16" Height="16" />
                    <span>Confirm it's you</span>
                </a>
            </div>
        </section>
    }
    else if (_enrollment is null)
    {
        <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
    }
    else
    {
        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">1. Scan this with your authenticator app</h2>
                    <p class="card__sub">1Password, Authy, Google Authenticator - any of them will do.</p>
                </div>
            </div>
            <div class="card__body">
                <img src="data:image/png;base64,@Convert.ToBase64String(_enrollment.QrPng)"
                     alt="QR code for setting up your authenticator app"
                     style="width:220px;height:220px;image-rendering:pixelated;background:#fff;padding:8px;border:1px solid var(--border);border-radius:var(--r-control)" />
                <p class="u-muted" style="margin-top:var(--space-3)">Can't scan it? Type this in instead:</p>
                <div class="code-block">
                    <pre>@_enrollment.SecretBase32</pre>
                </div>
            </div>
        </section>

        <section class="card">
            <form method="post" action="/auth/account/2fa/totp/confirm">
                <AntiforgeryToken />
                <div class="card__head">
                    <div>
                        <h2 class="card__title">2. Enter the code it shows you</h2>
                        <p class="card__sub">This proves the app is set up correctly before we switch it on.</p>
                    </div>
                </div>
                <div class="card__body u-stack">
                    <label class="field" style="max-width:220px">
                        <span class="field__label">Six-digit code</span>
                        <input class="input" type="text" name="Code" inputmode="numeric" pattern="[0-9]{6}"
                               maxlength="6" required autocomplete="one-time-code" placeholder="123456" />
                    </label>
                    @if (_needsPassword)
                    {
                        @* No recent confirmation and nothing else to confirm with:
                           the current password is the proof, as when adding a
                           first passkey. *@
                        <label class="field" style="max-width:320px">
                            <span class="field__label">Current password</span>
                            <input class="input" type="password" name="Password" required autocomplete="current-password" />
                            <span class="field__hint">To confirm it's you before adding a new step to your sign-in.</span>
                        </label>
                    }
                </div>
                <div class="card__foot">
                    <a class="btn" href="/account/security">Cancel</a>
                    <button type="submit" class="btn btn--primary">
                        <Icon Name="shield" Width="16" Height="16" />
                        <span>Confirm and turn on</span>
                    </button>
                </div>
            </form>
        </section>
    }
</div>

@code {
    // A code, not the sentence: the copy lives in FormErrorReasons so a link
    // can't put its own text on this page (#1544).
    [SupplyParameterFromQuery(Name = "reason")] public string? Reason { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private static readonly string ConfirmUrl = ALDevToolbox.Endpoints.StepUpEndpoints.Url("/account/2fa/totp/setup");

    private TotpEnrollment? _enrollment;
    private bool _mustStepUp;
    private bool _needsPassword;

    protected override async Task OnInitializedAsync()
    {
        if (Org.CurrentUserId is null) { Nav.NavigateTo("/account"); return; }
        if (AuthStateTask is not null)
        {
            var principal = (await AuthStateTask).User;
            _mustStepUp = await StepUp.MustStepUpBeforeAddingAsync(principal, Org.CurrentUserId.Value, CancellationToken.None);
            if (_mustStepUp) return;
            _needsPassword = !await StepUp.IsFreshForPasskeyAsync(principal, CancellationToken.None);
        }
        try
        {
            // Shows the same secret again when this browser comes back from a
            // refused confirm, so the entry they scanned still works. Another
            // session has no ticket and gets a new secret instead.
            var ticket = HttpContext?.Request.Cookies[TotpService.PendingSetupCookieName];
            _enrollment = await Totp.BeginEnrollmentAsync(Org.CurrentUserId.Value, resumeTicket: ticket);
            if (HttpContext is { Response.HasStarted: false } http)
            {
                // The page carries the secret, so no cache may keep it.
                http.Response.Headers.CacheControl = "no-store";
                http.Response.Cookies.Append(TotpService.PendingSetupCookieName, _enrollment.ResumeTicket, new CookieOptions
                {
                    HttpOnly = true,
                    SameSite = SameSiteMode.Lax,
                    Secure = http.Request.IsHttps,
                    Path = "/account/2fa/totp",
                    MaxAge = TotpService.PendingSecretReuse,
                });
            }
        }
        catch (Exception)
        {
            Nav.NavigateTo($"/account/security?err=Totp&reason={FormErrorReasons.TotpAlreadySetUp}");
        }
    }
}
