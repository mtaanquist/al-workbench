@page "/account/access-tokens/created"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using ALDevToolbox.Endpoints
@using ALDevToolbox.Components.Shared
@using Microsoft.AspNetCore.DataProtection
@inject IHttpContextAccessor Http
@inject IDataProtectionProvider Protection
@inject IJSRuntime JS
@inject PersistentComponentState PersistentState

<PageTitle>Token created · AL Workbench</PageTitle>

<div class="page">
    <PageHead Title="Save your token"
              Trail='@([new("AI assistants", "/account/ai"), new("New token")])'>
        <SubtitleContent>
            This is the only time the full token will be shown. Copy it now -
            you'll paste it into your AI client's configuration below. If you
            lose it, revoke this token and create a new one.
        </SubtitleContent>
    </PageHead>

    @if (_token is null)
    {
        <section class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="key-round" Width="21" Height="21" /></span>
                <span class="empty-state__title">This token has already been shown once</span>
                <span class="empty-state__text">
                    For safety we only ever show a token straight after it is created. Create a
                    fresh one and we'll show you that instead.
                </span>
                <span class="empty-state__action">
                    <a class="btn btn--sm" href="/account/ai">Back to AI assistants</a>
                </span>
            </div>
        </section>
    }
    else
    {
        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">@_token.Name</h2>
                    <p class="card__sub">
                        Created <Timestamp Value="@_token.CreatedAt" />
                        @if (_token.ExpiresAt is { } expires)
                        {
                            <text> · expires <Timestamp Value="@expires" Format="yyyy-MM-dd" /></text>
                        }
                        else
                        {
                            <text> · no expiry</text>
                        }
                    </p>
                </div>
            </div>
            <div class="card__body">
                <div class="code-block">
                    <div class="code-block__bar">
                        <span class="code-block__name">access token</span>
                        <button type="button" class="btn btn--sm copy-btn @(_copiedToken ? "is-copied" : "")" @onclick="CopyTokenAsync">
                            <Icon Name="copy" Width="14" Height="14" />
                            <span>@(_copiedToken ? "Copied" : "Copy token")</span>
                        </button>
                    </div>
                    <pre>@_token.Plaintext</pre>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Add it to your AI client</h2>
                    <p class="card__sub">These snippets already have your token and this server's address filled in.</p>
                </div>
                <span class="pill-tabs" role="tablist">
                    @foreach (var tab in Tabs)
                    {
                        <button type="button" role="tab" aria-selected="@(tab == _selectedTab ? "true" : "false")"
                                class="pill-tab @(tab == _selectedTab ? "is-active" : "")"
                                @onclick="() => SelectTab(tab)">
                            @tab
                        </button>
                    }
                </span>
            </div>
            <div class="card__body">
                <div class="code-block">
                    <div class="code-block__bar">
                        <span class="code-block__name">@_selectedTab</span>
                        <button type="button" class="btn btn--sm copy-btn @(_copiedSnippet ? "is-copied" : "")" @onclick="CopySnippetAsync">
                            <Icon Name="copy" Width="14" Height="14" />
                            <span>@(_copiedSnippet ? "Copied" : "Copy snippet")</span>
                        </button>
                    </div>
                    <pre>@CurrentSnippet</pre>
                </div>
                <p class="u-muted" style="margin-top:var(--space-3)">@CurrentHint</p>
            </div>
            <div class="card__foot">
                <a class="btn btn--primary" href="/account/ai">I've saved it</a>
            </div>
        </section>
    }
</div>

@code {
    private static readonly string[] Tabs = new[] { "VS Code", "Claude Desktop", "Cursor", "Claude Code" };

    private const string TokenStateKey = "oneShotPat";
    private const string ServerUrlStateKey = "oneShotPatServerUrl";

    private EndpointHelpers.OneShotPat? _token;
    private string _serverUrl = string.Empty;
    private string _selectedTab = "VS Code";
    private bool _copiedToken;
    private bool _copiedSnippet;
    private PersistingComponentStateSubscription _persistingSubscription;

    protected override void OnInitialized()
    {
        // Bridge the SSR prerender → interactive circuit handoff. The
        // SSR pass consumes the one-shot cookie; without persistent
        // state, the interactive pass sees nothing and renders the
        // "tokens can only be shown immediately" error over the token
        // the user briefly saw. See issue #177.
        if (PersistentState.TryTakeFromJson<EndpointHelpers.OneShotPat>(TokenStateKey, out var restoredToken)
            && restoredToken is not null)
        {
            _token = restoredToken;
            if (PersistentState.TryTakeFromJson<string>(ServerUrlStateKey, out var restoredUrl)
                && !string.IsNullOrEmpty(restoredUrl))
            {
                _serverUrl = restoredUrl;
            }
            return;
        }

        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _token = EndpointHelpers.ReadAndClearOneShotPatCookie(ctx, Protection);
        _serverUrl = $"{ctx.Request.Scheme}://{ctx.Request.Host}/mcp";
        if (_token is null) return;
        _persistingSubscription = PersistentState.RegisterOnPersisting(() =>
        {
            PersistentState.PersistAsJson(TokenStateKey, _token);
            PersistentState.PersistAsJson(ServerUrlStateKey, _serverUrl);
            return Task.CompletedTask;
        });
    }

    public void Dispose() => _persistingSubscription.Dispose();

    private void SelectTab(string tab)
    {
        _selectedTab = tab;
        _copiedSnippet = false;
    }

    private string CurrentSnippet => _token is null
        ? string.Empty
        : _selectedTab switch
        {
            "Claude Desktop" => ClaudeDesktopSnippet(_serverUrl, _token.Plaintext),
            "Cursor" => CursorSnippet(_serverUrl, _token.Plaintext),
            "Claude Code" => ClaudeCodeSnippet(_serverUrl, _token.Plaintext),
            _ => VsCodeSnippet(_serverUrl, _token.Plaintext),
        };

    private string CurrentHint => _selectedTab switch
    {
        "VS Code" => "Save this to your workspace's .vscode/mcp.json and reload. Requires GitHub Copilot agent mode.",
        "Claude Desktop" => "Add to claude_desktop_config.json (Settings → Developer → Edit Config) and restart the app.",
        "Cursor" => "Add to ~/.cursor/mcp.json (or Cursor Settings → MCP). Cursor will reload the server automatically.",
        "Claude Code" => "Run the command in any solution directory; Claude Code stores the config in .claude/.",
        _ => string.Empty,
    };

    private async Task CopyTokenAsync()
    {
        if (_token is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _token.Plaintext);
        _copiedToken = true;
    }

    private async Task CopySnippetAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentSnippet);
        _copiedSnippet = true;
    }

    private static string VsCodeSnippet(string url, string token) => $$"""
        {
          "servers": {
            "aldevtoolbox": {
              "type": "http",
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer {{token}}"
              }
            }
          }
        }
        """;

    private static string ClaudeDesktopSnippet(string url, string token) => $$"""
        {
          "mcpServers": {
            "aldevtoolbox": {
              "type": "http",
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer {{token}}"
              }
            }
          }
        }
        """;

    private static string CursorSnippet(string url, string token) => $$"""
        {
          "mcpServers": {
            "aldevtoolbox": {
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer {{token}}"
              }
            }
          }
        }
        """;

    private static string ClaudeCodeSnippet(string url, string token) =>
        $"claude mcp add aldevtoolbox \\\n  --transport http \\\n  --url {url} \\\n  --header \"Authorization: Bearer {token}\"";
}
