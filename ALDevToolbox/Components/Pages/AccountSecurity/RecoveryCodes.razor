@page "/account/2fa/recovery-codes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Endpoints
@using Microsoft.AspNetCore.DataProtection
@inject IHttpContextAccessor Http
@inject IDataProtectionProvider Protection
@inject NavigationManager Nav
@inject PersistentComponentState PersistentState

<PageTitle>Recovery codes · AL Workbench</PageTitle>

<div class="page">
    <PageHead Title="Save your recovery codes"
              Trail='@([new("Sign-in & security", "/account/security"), new("Recovery codes")])'>
        <SubtitleContent>
            Store these somewhere safe - a password manager, an encrypted note, or paper. Each code works
            <strong>once</strong>. Use them to sign in when your authenticator isn't available.
        </SubtitleContent>
    </PageHead>

    @if (_codes.Length == 0)
    {
        <section class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="key-round" Width="21" Height="21" /></span>
                <span class="empty-state__title">These codes have already been shown once</span>
                <span class="empty-state__text">
                    For safety we only ever show them straight after they are generated. Generate a
                    fresh set and we'll show you those instead.
                </span>
                <span class="empty-state__action">
                    <a class="btn btn--sm" href="/account/security">Back to sign-in &amp; security</a>
                </span>
            </div>
        </section>
    }
    else
    {
        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">@_codes.Length recovery codes</h2>
                    <p class="card__sub">Each one gets you in exactly once, then stops working.</p>
                </div>
                <button type="button" class="btn btn--sm" @onclick="DownloadAsync">
                    <Icon Name="download" Width="14" Height="14" />
                    <span>Download as .txt</span>
                </button>
            </div>
            <div class="card__body">
                <div class="code-block">
                    <div class="code-block__bar">
                        <span class="code-block__name">recovery codes</span>
                        <button type="button" class="btn btn--sm copy-btn @(_copied ? "is-copied" : "")" @onclick="CopyAsync">
                            <Icon Name="copy" Width="14" Height="14" />
                            <span>@(_copied ? "Copied" : "Copy")</span>
                        </button>
                    </div>
                    <pre>@_codesText</pre>
                </div>
            </div>
            <div class="card__foot">
                <a class="btn btn--primary" href="/account/security">I've saved them</a>
            </div>
        </section>
    }
</div>

@code {
    [Inject] IJSRuntime JS { get; set; } = default!;

    private const string StateKey = "recoveryCodes";

    private string[] _codes = Array.Empty<string>();
    private string _codesText = string.Empty;
    private bool _copied;
    private PersistingComponentStateSubscription _persistingSubscription;

    protected override void OnInitialized()
    {
        // Two render passes happen under InteractiveServer with prerender:
        // the SSR pass reads + clears the one-shot cookie, then the
        // interactive circuit re-runs OnInitialized with the cookie
        // already consumed. Without bridging the gap, the second pass
        // sees nothing and renders the "can only be shown immediately"
        // error over the codes the user briefly saw. PersistentComponentState
        // carries the codes across the boundary. See issue #177.
        if (PersistentState.TryTakeFromJson<string[]>(StateKey, out var restored) && restored is { Length: > 0 })
        {
            ApplyCodes(restored);
            return;
        }

        var ctx = Http.HttpContext;
        if (ctx is null) return;
        var codes = EndpointHelpers.ReadAndClearOneShotRecoveryCodesCookie(ctx, Protection);
        if (codes is null) return;
        ApplyCodes(codes);
        _persistingSubscription = PersistentState.RegisterOnPersisting(() =>
        {
            PersistentState.PersistAsJson(StateKey, _codes);
            return Task.CompletedTask;
        });
    }

    private void ApplyCodes(string[] codes)
    {
        _codes = codes;
        _codesText = string.Join('\n', _codes);
    }

    public void Dispose() => _persistingSubscription.Dispose();

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _codesText);
        _copied = true;
    }

    private async Task DownloadAsync()
    {
        var name = $"aldt-recovery-codes-{DateTime.UtcNow:yyyyMMdd}.txt";
        await JS.InvokeVoidAsync("aldtDownload.text", name, _codesText);
    }
}
