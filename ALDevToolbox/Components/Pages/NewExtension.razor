@page "/templates/extension"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject TemplateService Templates
@inject FolderTreeHydrator FolderTree
@inject ApplicationVersionService Versions
@inject WorkspaceConfigService Configs
@inject OrganizationConfigService OrgConfig
@inject ILogger<NewExtension> Logger
@inject GenerationService Gen
@inject GitHubRepositoryService GitHubRepos
@inject GitHubExtensionDeliveryService GitHubDelivery
@inject IJSRuntime JS
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Generation
@using ALDevToolbox.Services.Organizations
@using ALDevToolbox.Services.Templates

<PageTitle>New extension · AL Workbench</PageTitle>

@*
    Archetype 5 (generator with live preview), the sibling of New Workspace: one
    form column beside a sticky aside carrying the import card, the tree, the
    counts, the drop-in instructions and Generate.
    See .design/design-migration.md.
*@

<GeneratorPage Title="New extension"
               IsLoading="@(_templates is null || _catalog is null || _modules is null || _applicationVersions is null)"
               LoadingText="Loading templates..."
               IsEmpty="@(_templates is { Count: 0 })"
               FormId="gen-extension-form" FormAction="/generate/extension" OnSubmit="SubmitAsync"
               PrimaryNote="@GenerateNote">
    <SubtitleContent>
        Scaffold a standalone extension that drops into an existing AL
        workspace. Pick the workspace template it should sit alongside
        and the modules it depends on.
    </SubtitleContent>
    <Empty>
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="layers" Width="21" Height="21" /></span>
                <span class="empty-state__title">No workspace templates yet</span>
                <span class="empty-state__text">
                    An extension is scaffolded to sit alongside a workspace template, so
                    there has to be one first. An admin can import one from the site catalogue.
                </span>
                <a class="btn btn--primary empty-state__action" href="/admin/templates">Import a template</a>
            </div>
        </div>
    </Empty>
    <Notices>
        @if (_errors.Count > 0)
        {
            <Alert Tone="AlertTone.Danger">
                <span>
                    @(_errors.Count == 1 ? "One thing needs fixing" : $"{_errors.Count} things need fixing")
                    before this extension can be @_errorAction. Nothing you typed has been lost.
                    @if (_unfieldedErrors.Count > 0)
                    {
                        <text> @string.Join(" ", _unfieldedErrors)</text>
                    }
                </span>
            </Alert>
        }
    </Notices>
    <Form>
        @* Sibling-extension flow: when a workspace config is loaded, ship
           the workspace's identity through to the generation endpoint so
           the ZIP can include an updated <Workspace>.code-workspace file
           listing Core + every imported module + the new extension. The
           folder names come from the persisted identities so renames in
           the DB since the workspace was generated don't bleed into the
           regenerated workspace file. *@
        @if (_workspaceContext is not null)
        {
            <input type="hidden" name="WorkspaceName" value="@_workspaceContext.WorkspaceName" />
            <input type="hidden" name="WorkspaceShortName" value="@_workspaceContext.ShortName" />
            <input type="hidden" name="WorkspaceExtensionPrefix" value="@_workspaceContext.ExtensionPrefix" />
            @foreach (var key in _workspaceContext.ModuleKeys)
            {
                <input type="hidden" name="WorkspaceModuleKeys" value="@key" />
            }
            @foreach (var ext in _workspaceContext.Extensions)
            {
                <input type="hidden" name="WorkspaceFolders" value="@ext.Folder" />
            }
        }

        <section class="form-sec">
            <div class="form-sec__head">
                <span class="section-label">Workspace template</span>
                @if (_workspaceContext is not null)
                {
                    <span class="form-sec__note">Locked by @HydrationSourceLabel</span>
                }
            </div>
            <div class="field">
                <label class="field__label" for="ext-template">Template</label>
                <SelectBox>
                    <select class="select" id="ext-template" name="TemplateKey" required
                            disabled="@(_workspaceContext is not null)"
                            @bind="_templateKey" @bind:after="OnTemplateChanged">
                        @foreach (var t in _templates!)
                        {
                            <option value="@t.Key">@t.Name</option>
                        }
                    </select>
                </SelectBox>
                <FieldError Field="TemplateKey" Errors="_errors" />
                @* When the field is disabled the browser drops it from the
                   form post, so mirror the value into a hidden input - the
                   generation endpoint expects TemplateKey on every submit. *@
                @* _selected is non-null in both branches below because
                   OnInitializedAsync picks a template whenever the list is
                   non-empty and publishes both in the same synchronous
                   block, so no render can see one without the other. *@
                @if (_workspaceContext is not null)
                {
                    <input type="hidden" name="TemplateKey" value="@_templateKey" />
                    <p class="form-sec__cap">
                        Locked to <strong>@_selected!.Name</strong>, the template
                        @HydrationSourceLabel was built from. @UnlockHint
                    </p>
                }
                else
                {
                    <p class="form-sec__cap">
                        @_selected!.Description
                        @if (!string.IsNullOrWhiteSpace(_selected.Defaults.Application))
                        {
                            <span> · Default application: <code class="code">@_selected.Defaults.Application</code></span>
                        }
                    </p>
                }
            </div>
        </section>

        <section class="form-sec">
            <div class="form-sec__head"><span class="section-label">Extension</span></div>
            <div class="form-grid">
                <div class="field field--full">
                    <label class="field__label" for="ext-name">Extension name <span class="req">*</span></label>
                    <input class="input" id="ext-name" type="text" name="ExtensionName" placeholder="@ExtensionNamePlaceholder"
                           pattern="^[A-Za-z][A-Za-z0-9 ]*$" required
                           title="Letters, digits and spaces only; must start with a letter."
                           @bind="_extensionName" @bind:event="oninput" />
                    @if (BuildSiblingContext() is { } joining)
                    {
                        @* The prefix is added for the user rather than asked
                           for, so the hint shows the name it produces. *@
                        <span class="field__hint">
                            @if (string.IsNullOrWhiteSpace(_extensionName))
                            {
                                <text>
                                    Type the name without <strong>@joining.ExtensionPrefix</strong>: it is
                                    added for you, as it is on the other extensions in this solution.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Will be called <strong>@joining.ExtensionNameFor(_extensionName)</strong>,
                                    like the other extensions in this solution, in a folder called
                                    <code class="code">@FolderName/</code>.
                                </text>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="field__hint">
                            Kept as you type it inside the extension. Spaces come out of the
                            folder name. Letters, digits and spaces only; must start with a letter.
                        </span>
                    }
                    <FieldError Field="ExtensionName" Errors="_errors" />
                </div>
                <div class="field field--full">
                    <label class="field__label" for="ext-brief">Short description</label>
                    <input class="input" id="ext-brief" type="text" name="Brief" placeholder="One line, shown in app.json"
                           @bind="_brief" @bind:event="oninput" />
                </div>
                <div class="field field--full">
                    <label class="field__label" for="ext-desc">Long description</label>
                    <textarea class="textarea" id="ext-desc" name="Description" rows="3"
                              placeholder="Optional. Anything a colleague opening this extension should know."
                              @bind="_description" @bind:event="oninput"></textarea>
                </div>
            </div>
            @* Publisher comes from /admin/configuration/defaults at
               generation time. No form input - a standalone extension
               inherits whatever the org has configured, same as the
               workspace flow. *@
        </section>

        <section class="form-sec">
            <div class="form-sec__head">
                <span class="section-label">ID range</span>
                <span class="form-sec__note">Yours to keep clear of the rest of the workspace</span>
            </div>
            <IdRangeEditor IdPrefix="ext-id"
                           FromName="IdRangeFrom" ToName="IdRangeTo"
                           Label="Object IDs (first / last)"
                           FromLabel="First object ID" ToLabel="Last object ID"
                           Hint="Nothing checks this against your other extensions, so pick a range you know is free."
                           From="_idRangeFrom" FromChanged="v => _idRangeFrom = v"
                           To="_idRangeTo" ToChanged="v => _idRangeTo = v" />
            <FieldError Field="IdRangeFrom" Errors="_errors" />
            <FieldError Field="IdRangeTo" Errors="_errors" />
        </section>

        <section class="form-sec">
            <div class="form-sec__head"><span class="section-label">Application version</span></div>
            @if (_applicationVersions is null || _applicationVersions.Count == 0)
            {
                <div class="field">
                    <label class="field__label" for="ext-app-version">Version</label>
                    <input class="input" id="ext-app-version" type="text" name="ApplicationVersion" required
                           @bind="_applicationVersion" @bind:event="oninput" />
                    <input type="hidden" name="RuntimeVersion" value="@_runtimeVersion" />
                    <span class="field__hint">
                        No application versions have been added for your organisation yet.
                        An admin can curate them under
                        <a href="/admin/application-versions">Application versions</a>.
                    </span>
                </div>
            }
            else
            {
                <div class="field">
                    <label class="field__label" for="ext-app-version">Version</label>
                    <SelectBox>
                        <select class="select" id="ext-app-version" name="ApplicationVersion"
                                @bind="_applicationVersion" @bind:after="OnApplicationVersionChanged">
                            @* "Latest" sentinel - resolves to the highest
                               active catalogue row at submit time. *@
                            <option value="@ApplicationVersionService.LatestSentinel">Latest (always highest)</option>
                            @if (!string.Equals(_applicationVersion, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal)
                                && !_applicationVersions.Any(v => v.Application == _applicationVersion))
                            {
                                <option value="@_applicationVersion">@_applicationVersion (template default - not in catalogue)</option>
                            }
                            @foreach (var v in _applicationVersions)
                            {
                                <option value="@v.Application">@v.Name</option>
                            }
                        </select>
                    </SelectBox>
                    <input type="hidden" name="RuntimeVersion" value="@_runtimeVersion" />
                    <FieldError Field="ApplicationVersion" Errors="_errors" />
                    <FieldError Field="RuntimeVersion" Errors="_errors" />
                    <span class="field__hint">
                        application <code class="code">@_applicationVersion</code> ·
                        runtime <code class="code">@_runtimeVersion</code>
                    </span>
                </div>
            }
        </section>

        <section class="form-sec">
            <div class="form-sec__head">
                <span class="section-label">Dependencies</span>
                <span class="form-sec__note">@_dependencies.Count selected</span>
            </div>
            <DependencyPicker Catalog="_catalog!" Value="_dependencies" ValueChanged="OnDependenciesChanged" />
            @* Hidden inputs serialise the picker's state into the form post.
               The endpoint reads them as four parallel string arrays. *@
            @foreach (var d in _dependencies)
            {
                <input type="hidden" name="DependencyIds" value="@d.DepId" />
                <input type="hidden" name="DependencyNames" value="@d.DepName" />
                <input type="hidden" name="DependencyPublishers" value="@d.DepPublisher" />
                <input type="hidden" name="DependencyVersions" value="@d.DepVersion" />
            }
        </section>
    </Form>
    <Preview>
        <div class="card">
            <div class="card__head">
                <div>
                    <h4 class="card__title">Preview</h4>
                    <p class="card__sub">@FolderName</p>
                </div>
                @* The example-files switch lives here, not in the form
                   below: flipping it strikes the affected rows out of
                   the tree beside it, which is the whole explanation
                   the option needs. *@
                <div class="preview__head-tools">
                    <Switch Name="IncludeExamples" Label="Include example files"
                            Checked="IncludeExamples" Disabled="JoinsExistingSolution"
                            CheckedChanged="v => _includeExamples = v" />
                    <StatusPill Tone="live">Live</StatusPill>
                </div>
            </div>
            @* Switch drives component state, so it posts nothing of its
               own - this carries the value into the form post. *@
            <input type="hidden" name="IncludeExamples" value="@(IncludeExamples ? "true" : "false")" />
            @if (JoinsExistingSolution)
            {
                <div class="card__body">
                    <p class="field__hint">
                        Example files are left out when adding to an existing solution, so they
                        cannot clash with the ones it already has.
                    </p>
                </div>
            }
            <FolderTreePreview Root="BuildPreview()" />
        </div>
    </Preview>
    <Stats>
        <div class="stat-card">
            <span class="stat-card__label">Extensions</span>
            <span class="stat-card__value">1</span>
        </div>
        <div class="stat-card stat-card--accent">
            <span class="stat-card__label">Dependencies</span>
            <span class="stat-card__value">@_dependencies.Count</span>
        </div>
    </Stats>
    <PrimaryLabel><Icon Name="download" Width="15" Height="15" /> Download ZIP</PrimaryLabel>
    <AsideCards>
        @* Under Generate, not over it: both are optional, and above the preview they
           pushed the page's one primary action below the fold at laptop height. The
           sheet has the preview first. *@
        @* The GitHub half of this page (issue #623). One picked
           repository does two things - fills this form in from the
           solution's saved settings, and becomes the place the new
           extension can be added - so it is one control, not two. *@
        <div class="card">
            <div class="card__head">
                <div>
                    <h4 class="card__title">Start from your solution on GitHub</h4>
                    <p class="card__sub">Optional</p>
                </div>
            </div>
            <div class="card__body ext-repo">
                <RepositoryPicker Label="Solution repository"
                                  InputId="ext-repo"
                                  Selected="_repository"
                                  SelectedChanged="OnRepositoryChangedAsync"
                                  Disabled="_repoBusy || _hydrating"
                                  Hint="Picking one fills this form in from the solution's saved settings, replacing anything already typed here." />
                @if (_hydrating)
                {
                    <div class="loading-block">
                        <span class="spinner"></span><span>Reading the solution's settings...</span>
                    </div>
                }
                @* The one line that reports what just happened, told
                   apart from the static caption above it - otherwise
                   the only news on the card reads as more boilerplate. *@
                @if (!string.IsNullOrEmpty(_repoMessage))
                {
                    <p class="ext-repo__outcome" role="status">
                        <Icon Name="info" Width="14" Height="14" />
                        <span>@_repoMessage</span>
                    </p>
                }
                @if (_repoErrors.Count > 0)
                {
                    <ul class="ext-import__errors" role="alert">
                        @foreach (var err in _repoErrors)
                        {
                            <li><FieldError Message="@err.Value" /></li>
                        }
                    </ul>
                }
            </div>

            @* The action sits with the control that enables it. It is
               deliberately not a second primary - the ZIP is still the
               default - and it says what it will do before it is
               pressed: a branch and a pull request in the user's own
               name, and nothing moved on the customer's own branch. *@
            @if (_repository is not null)
            {
                <div class="card__foot ext-deliver">
                    @if (_delivery is not null)
                    {
                        <Alert Tone="AlertTone.Success">
                            <span class="u-stack">
                                <span>
                                    Pull request #@_delivery.PullRequest.Number was opened on
                                    <strong>@_delivery.Repository.FullName</strong>, adding
                                    <code class="code">@_delivery.FolderName/</code>. Review and
                                    merge it there to bring the extension in. Anything you change
                                    on this page now is not in it.
                                </span>
                                <span>
                                    <a class="btn" href="@_delivery.PullRequest.HtmlUrl"
                                       target="_blank" rel="noopener">
                                        <Icon Name="external-link" Width="15" Height="15" />
                                        <span>Open pull request #@_delivery.PullRequest.Number</span>
                                    </a>
                                </span>
                            </span>
                        </Alert>
                    }
                    <p>
                        @(_delivery is null ? "Adds" : "Adding again puts")
                        <code class="code">@FolderName/</code>
                        @(_delivery is null ? "to" : "in")
                        <strong>@_repository.FullName</strong> on a new branch and opens a pull
                        request for it, in your name and with your name on the commit. Nothing on
                        <code class="code">@_repository.DefaultBranch</code> changes until
                        someone merges it.
                    </p>
                    @* Spinner and busy label, as on Download ZIP:
                       opening the pull request takes seconds and a
                       merely disabled button reads as broken. *@
                    @* Disabled while the picked repository's settings
                       are still being read - the plan would be built
                       from half-filled fields - but only _repoBusy
                       gets the spinner and the label, because only
                       _repoBusy is a pull request being opened. *@
                    <button type="button" class="btn ext-repo__go @(_repoBusy ? "btn--loading" : null)"
                            disabled="@(_repoBusy || _hydrating)"
                            aria-busy="@(_repoBusy ? "true" : null)"
                            @onclick="AddToRepositoryAsync">
                        <span class="btn__spinner" aria-hidden="true"></span>
                        <span class="btn__label">
                            <Icon Name="git-branch" Width="15" Height="15" />
                            @(_delivery is null ? "Add to repository" : "Open another pull request")
                        </span>
                        <span class="btn__label-busy">Opening pull request...</span>
                    </button>
                </div>
            }
        </div>

        <div class="card">
            <div class="card__head">
                <div>
                    <h4 class="card__title">Start from a saved config</h4>
                    <p class="card__sub">Optional</p>
                </div>
            </div>
            <div class="card__body ext-import">
                <div class="ext-import__row">
                    <label class="btn btn--sm ext-import__button">
                        <Icon Name="upload" Width="14" Height="14" />
                        <span>Choose file...</span>
                        <InputFile OnChange="OnImportFileChosen" accept=".toml" class="ext-import__input" />
                    </label>
                    @if (!string.IsNullOrEmpty(_importFileName))
                    {
                        <span class="ext-import__filename" title="@_importFileName">@_importFileName</span>
                    }
                    @if (_workspaceContext is not null)
                    {
                        <button type="button" class="btn btn--sm" @onclick="ClearImportedWorkspace">Clear</button>
                    }
                </div>
                <p class="field__hint">
                    Refills this form from a <code class="code">@WorkspaceConfigService.FileName</code>
                    you saved earlier. A workspace config locks the template and scaffolds a
                    sibling extension; an extension config restores every field.
                </p>
                @if (!string.IsNullOrEmpty(_importMessage))
                {
                    <p class="field__hint">@_importMessage</p>
                }
                @if (_importErrors.Count > 0)
                {
                    <ul class="ext-import__errors" role="alert">
                        @foreach (var err in _importErrors)
                        {
                            <li><FieldError>@err.Key: @err.Value</FieldError></li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="card">
            <div class="card__head">
                <div><h4 class="card__title">After downloading</h4></div>
            </div>
            <div class="card__body ext-after">
                @if (_workspaceContext is not null)
                {
                    <p>
                        Drop the <code class="code">@FolderName/</code> folder and the regenerated
                        @* Spaces come out of the file name, exactly as the generator
                           emits it - naming a file that is not in the ZIP sends the
                           user hunting. *@
                        <code class="code">@($"{CustomerNaming.Apply(_workspaceContext.WorkspaceName, FolderStyle)}.code-workspace")</code>
                        file into your existing workspace, replacing the old workspace
                        file. The new <code class="code">folders</code> array already lists every
                        extension plus the new one.
                    </p>
                }
                else
                {
                    <p>
                        Drop <code class="code">@FolderName/</code> into your existing workspace folder, then add
                        this line to the <code class="code">folders</code> array in your
                        <code class="code">.code-workspace</code>:
                    </p>
                    <div class="code-block">
                        <pre><code>@WorkspaceFoldersSnippet</code></pre>
                    </div>
                    <p>
                        If the file also has a <code class="code">files.exclude</code> list under
                        <code class="code">settings</code>, add this line there too, so the folder
                        isn't shown twice:
                    </p>
                    <div class="code-block">
                        <pre><code>@WorkspaceExcludeSnippet</code></pre>
                    </div>
                }
            </div>
        </div>
    </AsideCards>
</GeneratorPage>

@code {
    /// <summary>The line under the Generate button: what this run will produce.</summary>
    private string GenerateNote =>
        _selected is null ? "1 extension" : $"1 extension for {_selected.Name}";

    private List<RuntimeTemplate>? _templates;
    private List<WellKnownDependency>? _catalog;
    // Loaded once at init so the sibling-extension preview can resolve folder
    // names from imported module keys without an extra DB round-trip.
    private List<ALDevToolbox.Domain.Entities.Module>? _modules;
    private List<ApplicationVersion>? _applicationVersions;
    private RuntimeTemplate? _selected;

    // Form state. Mirrors the fields posted to /generate/extension; the live
    // preview and the post-generation snippet read from the same source so
    // they always reflect the user's current input.
    private string _templateKey = string.Empty;
    private string _extensionName = string.Empty;
    private string _brief = string.Empty;
    private string _description = string.Empty;
    private int _idRangeFrom = 90000;
    private int _idRangeTo = 90999;
    private string _applicationVersion = string.Empty;
    private string _runtimeVersion = string.Empty;
    private bool _includeExamples = true;
    private List<DependencyEntry> _dependencies = new();

    // Sibling-extension state. Non-null when the user imported a workspace
    // config; locks the template select, drives the full-workspace preview,
    // and tells the generation endpoint to emit an updated .code-workspace
    // alongside the new extension folder.
    private WorkspaceImportContext? _workspaceContext;

    private record WorkspaceImportContext(
        string WorkspaceName,
        string? ShortName,
        string ExtensionPrefix,
        bool IncludeExamples,
        IReadOnlyList<string> ModuleKeys,
        IReadOnlyList<WorkspaceExtensionIdentity> Extensions);

    // Import-config feedback. _importFileName labels the picked file next to
    // the button; _importMessage is the success/seed line shown underneath;
    // _importErrors carries field-keyed validation messages when a file was
    // rejected. See the workspace-page comments for the same shape.
    private string _importFileName = string.Empty;
    private string _importMessage = string.Empty;
    private Dictionary<string, string> _importErrors = new();
    private const long MaxImportSize = 1 * 1024 * 1024;

    // The GitHub half (#623). One picked repository both hydrates the form and
    // becomes the place "Add to repository" opens its pull request on;
    // _repoMessage / _repoErrors are that card's own feedback, kept apart from
    // the upload card's so the two never explain each other's outcome.
    private GitHubRepositorySummary? _repository;
    private string _repoMessage = string.Empty;
    private Dictionary<string, string> _repoErrors = new();

    /// <summary>
    /// True only while a pull request is being opened - not while a picked
    /// repository's settings are being read, which is <see cref="_hydrating"/>.
    /// The two disable the same controls, but only this one is allowed to say
    /// "Opening pull request...".
    /// </summary>
    private bool _repoBusy;
    private GitHubExtensionDelivery? _delivery;

    /// <summary>
    /// Where the form's settings came from, when they were not typed - the
    /// repository's full name, or the uploaded file's name. Named in the copy so
    /// "locked" points at something the user remembers doing.
    /// </summary>
    private string? _hydrationSource;

    /// <summary>Whether <see cref="_hydrationSource"/> is a repository rather than an uploaded file.</summary>
    private bool _hydratedFromRepository;

    /// <summary>True only while the picked repository's settings are being read.</summary>
    private bool _hydrating;

    /// <summary>What the locked template says it is locked by, in the user's words.</summary>
    private string HydrationSourceLabel => _hydrationSource ?? "the settings you loaded";

    /// <summary>The control that undoes the lock, named rather than pointed at by position.</summary>
    private string UnlockHint => _hydratedFromRepository
        ? "Choose Change beside the repository to switch templates."
        : "Choose Clear beside the loaded file to switch templates.";

    /// <summary>
    /// What the shared error banner says the user was trying to do. The same
    /// rules refuse a download and a pull request, and the banner has to name
    /// the button that was actually pressed.
    /// </summary>
    private string _errorAction = "generated";

    // The folder name drops the spaces the display name in app.json keeps,
    // mirroring how the generator derives it (CustomerNaming). See issue #520.
    // Joining a solution it drops the solution's prefix too, as the
    // generator does.
    private string FolderName => string.IsNullOrWhiteSpace(_extensionName)
        ? "MyExtension"
        : BuildSiblingContext()?.FolderNameFor(_extensionName)
            ?? CustomerNaming.Apply(_extensionName, NamingStyle.PascalCase);

    /// <summary>
    /// Whether the extension is being added to something that already exists:
    /// a solution loaded from a saved config, or a picked repository. Either
    /// way the template's example files stay out - see
    /// <see cref="IncludeExamples"/>.
    /// </summary>
    private bool JoinsExistingSolution => _workspaceContext is not null || _repository is not null;

    /// <summary>
    /// The example-files choice that actually applies. The generator and the
    /// pull request both leave examples out when joining a solution, so the
    /// switch shows off and is locked rather than offering a choice that
    /// would be ignored. The user's own choice is kept for when they go back
    /// to a standalone extension.
    /// </summary>
    private bool IncludeExamples => _includeExamples && !JoinsExistingSolution;

    private string WorkspaceFoldersSnippet => $"{{ \"path\": \"{FolderName}\" }}";

    private string WorkspaceExcludeSnippet => $"\"{FolderName}\": true";

    private OrganizationConfig? _orgConfig;

    /// <summary>
    /// The organisation's folder naming style, or the default while the config
    /// is still loading. Only names a workspace this extension is joining -
    /// the extension's own folder comes from its name.
    /// </summary>
    private NamingStyle FolderStyle => _orgConfig?.Settings.NamingFolderStyle ?? NamingStyle.PascalCase;

    /// <summary>
    /// Field-keyed problems from the last submit attempt. See
    /// <c>NewWorkspace.razor</c> - same contract, same reason for only
    /// populating it once the user has pressed Generate.
    /// </summary>
    private IReadOnlyDictionary<string, string> _errors =
        new Dictionary<string, string>();

    /// <summary>
    /// Messages with no field to sit next to: the org-level publisher, and
    /// duplicate dependency ids keyed <c>Dependencies[n].DepId</c>.
    /// </summary>
    private List<string> _unfieldedErrors = new();

    private static readonly HashSet<string> FieldedKeys = new(StringComparer.Ordinal)
    {
        "TemplateKey", "ExtensionName", "IdRangeFrom", "IdRangeTo",
        "ApplicationVersion", "RuntimeVersion",
    };

    /// <summary>
    /// Runs the generator's own rules before the form posts, so a problem the
    /// browser cannot see - an org with no publisher set, a duplicate
    /// dependency, a template that has since been deleted - is shown here
    /// rather than on an error page with the form's contents gone.
    /// </summary>
    private async Task SubmitAsync()
    {
        _errorAction = "generated";
        var plan = await BuildValidPlanAsync();
        if (plan is null) return;

        await JS.InvokeVoidAsync("aldtGenerate.submit", "gen-extension-form");
    }

    /// <summary>
    /// The plan this form describes, resolved and checked - or null, with the
    /// problems already on screen. Shared by the two ways of taking delivery
    /// (the ZIP and the pull request) so neither can accept a plan the other
    /// would refuse.
    /// </summary>
    private async Task<StandaloneExtensionPlan?> BuildValidPlanAsync()
    {
        var application = _applicationVersion;
        var runtime = _runtimeVersion;
        if (string.Equals(application, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal)
            || string.Equals(runtime, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal))
        {
            var latest = await Versions.GetLatestAsync();
            if (latest is null)
            {
                SetErrors(new Dictionary<string, string>
                {
                    ["ApplicationVersion"] = "\"Latest\" needs at least one application version to pick from, "
                        + "and none have been added yet. Choose a specific version, or ask an admin to add one.",
                });
                return null;
            }
            application = latest.Application;
            runtime = latest.Runtime;
        }

        // Publisher is not a form field - the endpoint takes it from the org's
        // defaults, so the check has to use the same source or the page would
        // wave through a plan the endpoint rejects.
        var plan = new StandaloneExtensionPlan(
            TemplateKey: _templateKey,
            ExtensionName: _extensionName.Trim(),
            Brief: _brief.Trim(),
            Description: _description.Trim(),
            ApplicationVersion: application,
            RuntimeVersion: runtime,
            IdRangeFrom: _idRangeFrom,
            IdRangeTo: _idRangeTo,
            IncludeExamples: IncludeExamples,
            Publisher: _orgConfig?.Settings.DefaultPublisher ?? string.Empty,
            Dependencies: _dependencies);

        SetErrors(await Gen.ValidateExtensionAsync(plan, BuildSiblingContext()));
        return _errors.Count > 0 ? null : plan;
    }

    /// <summary>
    /// The fields the aside's refusal can name, in the order they appear in the
    /// form. Each entry is the error key the generator raises, the words the
    /// field is labelled with, and the id to send the user to.
    /// </summary>
    private static readonly (string Key, string Label, string ElementId)[] FormFields =
    [
        ("TemplateKey", "Template", "ext-template"),
        ("ExtensionName", "Extension name", "ext-name"),
        ("IdRangeFrom", "First object ID", "ext-id-from"),
        ("IdRangeTo", "Last object ID", "ext-id-to"),
        ("ApplicationVersion", "Version", "ext-app-version"),
    ];

    /// <summary>
    /// The refusal shown beside "Add to repository": the first field in form
    /// order that has a problem, named as the user sees it. Falls back to the
    /// problems that belong to no field at all - an organisation with no
    /// publisher set, say - which are the ones a user cannot fix on this page.
    /// </summary>
    private string FirstThingToFix()
    {
        foreach (var (key, label, _) in FormFields)
        {
            if (_errors.TryGetValue(key, out var message))
            {
                return $"{label}: {message}";
            }
        }
        return _unfieldedErrors.Count > 0
            ? string.Join(" ", _unfieldedErrors)
            : "Something on this form needs fixing before the extension can be added.";
    }

    /// <summary>The element to send the user to, or null when nothing on this page can be fixed.</summary>
    private string? FirstErrorFieldId() =>
        FormFields.FirstOrDefault(f => _errors.ContainsKey(f.Key)).ElementId;

    /// <summary>
    /// The example name in the empty field. Once a workspace has been imported
    /// the example is drawn from it ("CRO Banking" beside "CRO Core"), so the
    /// naming the rest of that workspace follows is the one being suggested.
    /// </summary>
    private string ExtensionNamePlaceholder => _workspaceContext is null
        ? "e.g. My Custom Feature"
        : "e.g. Banking";

    /// <summary>
    /// The workspace this extension is joining, in the shape the generator
    /// takes it, with its prefix settled the way the generator settles it so
    /// the name and folder shown here are the ones it writes.
    /// </summary>
    private SiblingWorkspaceContext? BuildSiblingContext() =>
        _workspaceContext is null || _orgConfig is null
            ? null
            : new SiblingWorkspaceContext(
                _workspaceContext.WorkspaceName,
                _workspaceContext.ModuleKeys,
                _workspaceContext.Extensions.Select(e => e.Folder).ToList(),
                _workspaceContext.ShortName,
                ExtensionPrefixPolicy.ForExistingWorkspace(
                    _orgConfig.Settings, _workspaceContext.ExtensionPrefix,
                    _workspaceContext.ShortName, _workspaceContext.WorkspaceName),
                SavedExtensions: _workspaceContext.Extensions);

    /// <summary>
    /// Picking a repository fills the form in from the settings the workbench
    /// saved into it when the solution was generated - through exactly the same
    /// path an uploaded file takes, so the two can never hydrate differently.
    /// A repository without those settings is an ordinary outcome: the message
    /// says so and the form stays manual.
    /// </summary>
    private async Task OnRepositoryChangedAsync(GitHubRepositorySummary? repository)
    {
        // Changing or clearing the repository undoes what it filled in. Leaving
        // the workspace context behind would keep the template locked to a
        // solution the page no longer claims to be working from.
        ForgetRepositoryHydration();
        _repository = repository;
        _delivery = null;
        _repoMessage = string.Empty;
        _repoErrors = new();
        if (repository is null) return;

        // Only _hydrating: this reads the repository's settings, it does not
        // open a pull request, and _repoBusy is what puts "Opening pull
        // request..." on the button below.
        _hydrating = true;
        try
        {
            var config = await GitHubRepos.TryReadWorkspaceConfigAsync(repository);
            if (config is null)
            {
                _repoMessage = $"{repository.Name} has no settings saved by the workbench, so nothing was "
                    + "filled in. Fill the form in yourself - you can still add the extension to it.";
                return;
            }

            var (message, errors) = await ApplyConfigAsync(config.Text, repository.FullName);
            if (errors.Count > 0)
            {
                // Whatever the parser found, it found it in a file the user
                // never chose. Its wording is for someone who picked a file;
                // this person picked a repository, so they get the outcome and
                // the log gets the detail.
                Logger.LogWarning(
                    "The saved config in {RepoFullName} could not be applied: {Errors}",
                    repository.FullName,
                    string.Join("; ", errors.Select(e => $"{e.Key}: {e.Value}")));
                _repoMessage = $"The settings saved in {repository.Name} could not be read, so nothing was "
                    + "filled in. Fill the form in yourself - you can still add the extension to it.";
                return;
            }
            _repoMessage = message;
            _hydrationSource = repository.FullName;
            _hydratedFromRepository = true;
        }
        catch (Exception ex) when (ex is GitHubApiException or GitHubAppNotConfiguredException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Could not read the saved config from {RepoFullName}.", repository.FullName);
            _repoErrors = new Dictionary<string, string>
            {
                ["GitHubRepository"] = "The workbench could not reach GitHub just now, so nothing was filled "
                    + "in. Fill the form in yourself, or pick the repository again in a minute.",
            };
        }
        finally
        {
            _hydrating = false;
        }
    }

    /// <summary>
    /// Drops what a repository filled in, leaving anything that came from an
    /// uploaded file alone - that has its own Clear, in its own card.
    /// </summary>
    private void ForgetRepositoryHydration()
    {
        if (!_hydratedFromRepository) return;
        _workspaceContext = null;
        _hydrationSource = null;
        _hydratedFromRepository = false;
    }

    /// <summary>
    /// Generates the extension and opens a pull request adding it to the picked
    /// repository. The commit goes out as the signed-in user, on a branch of its
    /// own - never onto the repository's default branch. The service owns both
    /// of those rules, so the MCP tool behaves the same way.
    /// </summary>
    private async Task AddToRepositoryAsync()
    {
        if (_repository is null) return;

        _repoErrors = new();
        _errorAction = "added to the repository";
        // Before the first await, or the render Blazor does when this handler
        // first yields still shows an idle button and the pull request opens
        // with nothing on screen to say it is happening - the same ordering bug
        // the Create repository button had (#812). The plan build moved inside
        // the try so the early refusal below still clears the flag.
        _repoBusy = true;

        try
        {
            var plan = await BuildValidPlanAsync();
            if (plan is null)
            {
                // The button lives in the aside; the form's own error banner is a
                // column away and often off-screen. Say what is wrong here, name the
                // first thing to fix, and take the user to it - a button that looks
                // like it did nothing is worse than one that refuses out loud.
                _repoErrors = new Dictionary<string, string>(StringComparer.Ordinal)
                {
                    ["GitHubRepository"] = FirstThingToFix(),
                };
                if (FirstErrorFieldId() is { } fieldId)
                {
                    await JS.InvokeVoidAsync("aldtGenerate.focusField", fieldId);
                }
                return;
            }

            _delivery = await GitHubDelivery.AddExtensionAsync(plan, BuildSiblingContext(), _repository.FullName);
            _repoMessage = string.Empty;
        }
        catch (PlanValidationException ex)
        {
            // Problems with the repository belong beside the picker; anything
            // about the plan itself belongs on the field that caused it.
            _repoErrors = ex.Errors
                .Where(e => e.Key == "GitHubRepository")
                .ToDictionary(e => e.Key, e => e.Value, StringComparer.Ordinal);
            var fieldErrors = ex.Errors.Where(e => e.Key != "GitHubRepository").ToDictionary(e => e.Key, e => e.Value);
            if (fieldErrors.Count > 0) SetErrors(fieldErrors);
        }
        catch (GitHubApiException ex)
        {
            Logger.LogWarning(ex, "GitHub refused the pull request on {RepoFullName}.", _repository.FullName);
            _repoErrors = new Dictionary<string, string> { ["GitHubRepository"] = $"GitHub would not do that: {ex.Message}" };
        }
        catch (Exception ex) when (ex is GitHubAppNotConfiguredException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Could not reach GitHub to add to {RepoFullName}.", _repository.FullName);
            _repoErrors = new Dictionary<string, string>
            {
                ["GitHubRepository"] = "The workbench could not reach GitHub just now, so nothing was added. Try again in a minute.",
            };
        }
        finally
        {
            _repoBusy = false;
        }
    }

    private void SetErrors(IReadOnlyDictionary<string, string> errors)
    {
        _errors = errors;
        _unfieldedErrors = errors
            .Where(e => !FieldedKeys.Contains(e.Key))
            .Select(e => e.Value)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        // Load into locals, then publish every field in one synchronous block
        // at the end - same reasoning as NewWorkspace: ComponentBase renders
        // as soon as this method first yields, and the guard at the top only
        // tests the four collections, so publishing them one await at a time
        // lets a render reach the form while _selected is still null.
        var templates = await Templates.GetTemplatesAsync(includeDeprecated: false);
        var catalog = await Templates.GetCatalogAsync();
        var modules = await Templates.GetModulesAsync(includeDeprecated: false);
        // Folder/file trees aren't pulled by the default reads - load them on
        // top so the standalone preview can walk the template's scaffold
        // extension and the sibling-workspace preview can render real module
        // trees alongside the new extension.
        // Paths only: the preview draws the layout, never a file's body, and
        // reading every example AL file to render a list of names is the whole
        // template's text pulled across for nothing.
        await FolderTree.HydrateExtensionFolderTreeAsync(templates, pathsOnly: true);
        await FolderTree.HydrateModuleExtensionFolderTreeAsync(modules, pathsOnly: true);
        var applicationVersions = await Versions.GetActiveAsync(includeDeprecated: false);
        var orgConfig = await OrgConfig.GetCurrentAsync();
        // Prefer the per-org default template; fall back to the first row so
        // a fresh organisation without a default still gets a sensible
        // initial selection.
        var selected = templates.FirstOrDefault(t => t.IsDefault) ?? templates.FirstOrDefault();

        // No await past this point: everything below runs before the renderer
        // gets another look at the component.
        _templates = templates;
        _catalog = catalog;
        _modules = modules;
        _applicationVersions = applicationVersions;
        _orgConfig = orgConfig;
        _selected = selected;
        if (selected is not null)
        {
            ApplyTemplateDefaults(selected);
        }
        // No brief / description pre-fill on this page. The org-level
        // defaults at /admin/configuration/defaults are written against the
        // workspace flow's mustache context - typically referencing
        // {{workspace_name}} or {{tenant_id}} - which a standalone extension
        // can't resolve. Admins type a per-extension blurb here instead.
    }

    private void OnApplicationVersionChanged()
    {
        // "Latest" propagates the sentinel into RuntimeVersion so the
        // endpoint can swap both fields in lock-step at submit time.
        if (string.Equals(_applicationVersion, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal))
        {
            _runtimeVersion = ApplicationVersionService.LatestSentinel;
            return;
        }
        if (_applicationVersions is null) return;
        var match = _applicationVersions.FirstOrDefault(v => v.Application == _applicationVersion);
        if (match is not null)
        {
            _runtimeVersion = match.Runtime;
        }
    }

    private void OnTemplateChanged()
    {
        var picked = _templates?.FirstOrDefault(t => t.Key == _templateKey);
        if (picked is null) return;
        _selected = picked;
        ApplyTemplateDefaults(picked);
    }

    private void ApplyTemplateDefaults(RuntimeTemplate template)
    {
        _templateKey = template.Key;
        // Publisher is resolved at the generation endpoint from
        // OrganizationSettings.DefaultPublisher - no form-side state needed.
        (_applicationVersion, _runtimeVersion) =
            TemplateDefaultsResolver.ResolveApplicationAndRuntime(template, _applicationVersions);
    }

    private void OnDependenciesChanged(List<DependencyEntry> next)
    {
        _dependencies = next;
    }

    /// <summary>
    /// Builds the <see cref="PreviewNode"/> tree displayed in the right column.
    /// In standalone mode it's a single extension root (matches
    /// <c>generation-engine.md</c>); in sibling-extension mode (a workspace
    /// config has been imported) it renders the full workspace with the new
    /// extension slotted in and tagged "new" so the user sees where it lands.
    /// </summary>
    private PreviewNode BuildPreview() =>
        _workspaceContext is null
            ? BuildExtensionPreview(includeWorkspaceRootFiles: true)
            : BuildSiblingWorkspacePreview(_workspaceContext);

    private (List<string> WorkspaceRoot, List<string> PerExtension) SplitIncludedFiles()
    {
        var workspaceRoot = new List<string>();
        var perExtension = new List<string>();
        if (_selected is null || _orgConfig is null) return (workspaceRoot, perExtension);
        var byId = _orgConfig.Files.ToDictionary(f => f.Id);
        foreach (var joined in _selected.IncludedFiles.OrderBy(j => j.Ordering))
        {
            if (!byId.TryGetValue(joined.OrganizationFileId, out var file)) continue;
            if (file.Scope == OrganizationFileScope.EveryExtension)
            {
                perExtension.Add(file.Path);
            }
            else
            {
                workspaceRoot.Add(file.Path);
            }
        }
        return (workspaceRoot, perExtension);
    }

    /// <summary>
    /// The single extension folder the generator emits. When
    /// <paramref name="includeWorkspaceRootFiles"/> is true (the standalone
    /// case) the workspace-root-scoped organisation files are grafted in too:
    /// that folder is the root of what the user unzips, so the generator puts
    /// them there (issue #522). In sibling mode they stay out - the existing
    /// workspace already carries them at its own root.
    /// </summary>
    private PreviewNode BuildExtensionPreview(bool includeWorkspaceRootFiles = false)
    {
        // The generator scaffolds a standalone extension from the picked
        // template's first required WorkspaceExtension - see
        // GenerationService.GenerateExtensionAsync. Reflect that in the
        // preview so the user sees the folder tree they'll actually get.
        var scaffold = _selected?.WorkspaceExtensions
            .Where(e => e.Required)
            .OrderBy(e => e.Ordering)
            .FirstOrDefault();
        var folders = scaffold?.Folders ?? new List<WorkspaceExtensionFolder>();
        var (workspaceRootPaths, perExtensionPaths) = SplitIncludedFiles();
        var contents = ExtensionPreviewBuilder.BuildContents(folders, IncludeExamples, perExtensionPaths).ToList();
        // Every generated extension folder carries its own saved config so the
        // form can be restored from it later.
        contents.Add(PreviewNode.File(ALDevToolbox.Services.Generation.WorkspaceConfigService.FileName));
        if (includeWorkspaceRootFiles)
        {
            // The org logo rides along at the same path it takes in a
            // generated workspace, now relative to this folder.
            if (_orgConfig?.Logo is not null)
            {
                var logoExt = _orgConfig.Logo.ContentType == "image/svg+xml" ? "svg" : "png";
                PreviewTreeBuilder.GraftFile(contents, ALDevToolbox.Services.Generation.WorkspaceZipBuilder.NormaliseLogoPath(
                    _orgConfig.Settings.DefaultLogo, logoExt));
            }
            foreach (var path in workspaceRootPaths)
            {
                PreviewTreeBuilder.GraftFile(contents, path);
            }
            // The template's empty root folders ship with the workspace-root
            // files, so they follow the same gate - see
            // WorkspaceZipBuilder.BuildStandaloneAsync.
            PreviewTreeBuilder.GraftEmptyFolders(
                contents,
                _selected?.RootFolders.OrderBy(f => f.Ordering).Select(f => f.Path),
                workspaceRootPaths);
        }
        var node = PreviewNode.Extension(FolderName, contents);
        return PreviewTreeBuilder.SortForDisplay(node);
    }

    private PreviewNode BuildSiblingWorkspacePreview(WorkspaceImportContext context)
    {
        var rootName = CustomerNaming.Apply(context.WorkspaceName, FolderStyle) is { Length: > 0 } folder
            ? folder
            : "Workspace";

        var children = new List<PreviewNode>();

        // The org logo lands at the path the admin set on
        // /admin/configuration/defaults' "Default logo path". No logo
        // uploaded means no .assets folder phantom.
        if (_orgConfig?.Logo is not null)
        {
            var logoExt = _orgConfig.Logo.ContentType switch
            {
                "image/svg+xml" => "svg",
                _ => "png",
            };
            var logoPath = ALDevToolbox.Services.Generation.WorkspaceZipBuilder.NormaliseLogoPath(
                _orgConfig.Settings.DefaultLogo, logoExt);
            PreviewTreeBuilder.GraftFile(children, logoPath);
        }

        var (workspaceRootPaths, perExtensionPaths) = SplitIncludedFiles();

        // Required template extensions land on every generated workspace. We
        // don't know which optionals the original workspace included, so only
        // the required set is rendered - matches what an empty WorkspaceFolders
        // list would imply.
        if (_selected is not null)
        {
            foreach (var ext in _selected.WorkspaceExtensions
                .Where(e => e.Required)
                .OrderBy(e => e.Ordering))
            {
                children.Add(PreviewNode.Extension(
                    ext.Path,
                    ExtensionPreviewBuilder.BuildContents(ext.Folders, context.IncludeExamples, perExtensionPaths)));
            }
        }

        // Modules from the imported workspace, in the order they were saved.
        // Unknown / soft-deleted module keys silently drop off - same rule as
        // the workspace builder applies on its own form.
        if (_modules is not null)
        {
            foreach (var key in context.ModuleKeys)
            {
                var module = _modules.FirstOrDefault(m => m.Key == key);
                if (module is null) continue;
                children.Add(PreviewNode.Extension(
                    module.ExtensionName,
                    ExtensionPreviewBuilder.BuildContents(module.ExtensionFolders, context.IncludeExamples, perExtensionPaths)));
            }
        }

        // The new sibling extension we're about to generate. Reuses the
        // standalone-extension scaffold so the folder tree matches what the
        // generator will emit; the IsNew flag lets the renderer label it.
        var newNode = BuildExtensionPreview() with { IsNew = true };
        children.Add(newNode);

        // Side-cars + workspace-root-scoped org files, then sort. Shared with
        // New Workspace and Template Detail so all three previews stay identical.
        return PreviewTreeBuilder.BuildWorkspacePreview(
            rootName, children, ALDevToolbox.Services.Generation.WorkspaceConfigService.FileName, workspaceRootPaths,
            _selected?.RootFolders.OrderBy(f => f.Ordering).Select(f => f.Path));
    }


    /// <summary>
    /// Reads a saved <c>workspace.aldt.toml</c> and hydrates the form from it.
    /// Per Milestone P2.3, this page accepts both kinds: an extension config
    /// restores every field including dependencies; a workspace config seeds
    /// the shared subset (template, versions, publisher from the template's
    /// defaults) so the user can scaffold a sibling extension that lines up
    /// with the original workspace.
    /// </summary>
    private async Task OnImportFileChosen(InputFileChangeEventArgs e)
    {
        _importMessage = string.Empty;
        _importErrors = new();

        var file = e.File;
        if (file is null) return;

        _importFileName = file.Name;

        if (file.Size > MaxImportSize)
        {
            _importErrors["File"] = $"File is larger than {MaxImportSize / 1024} KiB.";
            return;
        }

        string toml;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportSize);
            using var reader = new StreamReader(stream);
            toml = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to read uploaded config '{Name}'.", file.Name);
            _importErrors["File"] = $"Could not read the file: {ex.Message}";
            return;
        }

        var (message, errors) = await ApplyConfigAsync(toml, file.Name);
        _importMessage = message;
        _importErrors = errors;
        if (errors.Count == 0)
        {
            _hydrationSource = file.Name;
            _hydratedFromRepository = false;
        }
    }

    /// <summary>
    /// Hydrates the form from one saved config, whichever way it arrived - the
    /// upload button, or a repository the user picked (#623). Deliberately one
    /// path: two would drift, and the whole point of picking a repository is
    /// that it fills the form in exactly as the file does.
    ///
    /// <para>Returns the line to show the user and any field-keyed problems,
    /// rather than writing them itself, because the two entry points show their
    /// feedback in different cards.</para>
    /// </summary>
    private async Task<(string Message, Dictionary<string, string> Errors)> ApplyConfigAsync(
        string toml, string source)
    {
        WorkspaceConfigImport import;
        try
        {
            import = await Configs.ParseAsync(toml);
        }
        catch (PlanValidationException ex)
        {
            return (string.Empty, ex.Errors.ToDictionary(p => p.Key, p => p.Value));
        }

        switch (import.Kind)
        {
            case WorkspaceConfigService.ExtensionKind when import.Extension is not null:
                ApplyImportedExtension(import.Extension);
                return ($"Filled in from {source}. Every field now matches that extension, "
                    + "including its ID range and dependencies.", new());

            case WorkspaceConfigService.WorkspaceKind when import.Workspace is not null:
                ApplyImportedWorkspace(import.Workspace, import.Extensions);
                // Extensions include the workspace's own Core, so the others
                // (modules, and extensions added since) are what is left after it.
                var others = Math.Max(0, import.Extensions.Count - 1);
                var othersPhrase = others == 0
                    ? "nothing else"
                    : $"its {others} other {(others == 1 ? "extension" : "extensions")}";
                return (import.Extensions.Count > 0
                    ? $"Filled in from {source}: its template, versions, dependencies on Core and "
                        + $"{othersPhrase}, and an ID range starting after the last one it uses. "
                        + "That replaced anything already typed here, the ID range included. "
                        + "Give the extension a name."
                    : $"Filled in from {source}: its template and versions only, because it was saved "
                        + "by an older workbench that recorded nothing else. That replaced anything "
                        + "already typed here. Give the extension a name, and check the ID range and "
                        + "dependencies yourself.", new());

            default:
                return (string.Empty, new() { ["Kind"] = $"Unsupported config kind '{import.Kind}'." });
        }
    }

    /// <summary>
    /// Restores every extension form field from an extension-shaped config.
    /// Standalone extensions have no enclosing workspace, so the workspace
    /// context (if previously set) is wiped - the page reverts to the plain
    /// New Extension behaviour.
    /// </summary>
    private void ApplyImportedExtension(StandaloneExtensionPlan plan)
    {
        var template = _templates?.FirstOrDefault(t => t.Key == plan.TemplateKey);
        _selected = template ?? _selected;
        _templateKey = plan.TemplateKey;
        _extensionName = plan.ExtensionName;
        _brief = plan.Brief;
        _description = plan.Description;
        // Publisher is no longer form-side state - the endpoint resolves it
        // from OrganizationSettings.DefaultPublisher at generation time.
        _applicationVersion = plan.ApplicationVersion;
        _runtimeVersion = plan.RuntimeVersion;
        _idRangeFrom = plan.IdRangeFrom;
        _idRangeTo = plan.IdRangeTo;
        _includeExamples = plan.IncludeExamples;
        _dependencies = plan.Dependencies.ToList();
        _workspaceContext = null;
    }

    /// <summary>
    /// Hydrates the shared subset of fields from a workspace config so the user
    /// can scaffold a sibling extension that drops into the same workspace.
    /// Publisher comes from the picked template's defaults (the workspace
    /// config doesn't carry a publisher of its own). When <paramref name="extensions"/>
    /// is non-empty (the workspace was generated by a recent enough workbench to
    /// stamp identities into the config), the new extension's id-range slots
    /// in directly after the highest existing range and the dependency picker
    /// is pre-filled with real GUIDs for Core and every module - saves the
    /// user transcribing them from the workspace's app.json files. With an
    /// empty identities list (older configs), we fall back to estimating the
    /// next slot from the template's defaults.
    /// </summary>
    private void ApplyImportedWorkspace(ProjectPlan plan, IReadOnlyList<WorkspaceExtensionIdentity> extensions)
    {
        var template = _templates?.FirstOrDefault(t => t.Key == plan.TemplateKey);
        _selected = template ?? _selected;
        _templateKey = plan.TemplateKey;
        _brief = plan.Brief;
        _description = plan.Description;
        _applicationVersion = plan.ApplicationVersion;
        _runtimeVersion = plan.RuntimeVersion;

        if (extensions.Count > 0)
        {
            // Real identities - version is the workspace generator's hardcoded
            // 0.0.0.1 (see GenerationService.BuildCoreAppJsonAsync); the user
            // can untick anything they don't want to depend on.
            _dependencies = extensions
                .Select(e => new DependencyEntry(
                    DepId: e.Id.ToString(),
                    DepName: e.Name,
                    DepPublisher: e.Publisher,
                    DepVersion: "0.0.0.1"))
                .ToList();

            var maxTo = extensions.Max(e => e.IdRangeTo);
            var size = Math.Max(1, template?.ModuleIdRangeSize ?? 1000);
            _idRangeFrom = maxTo + 1;
            _idRangeTo = _idRangeFrom + size - 1;
        }
        else
        {
            // Older workspace config - no identities. Best-effort id-range
            // estimate from template defaults; dependencies can't be wired
            // because we don't have the GUIDs.
            _dependencies = new();
            if (template is not null)
            {
                var moduleCount = plan.SelectedModuleKeys.Count;
                var size = Math.Max(1, template.ModuleIdRangeSize);
                _idRangeFrom = template.ModuleIdRangeStart + moduleCount * size;
                _idRangeTo = _idRangeFrom + size - 1;
            }
        }

        _workspaceContext = new WorkspaceImportContext(
            plan.WorkspaceName,
            plan.ShortName,
            plan.ExtensionPrefix,
            plan.IncludeExamples,
            plan.SelectedModuleKeys.ToList(),
            extensions);
    }

    /// <summary>
    /// Wipes the imported workspace context and re-enables the template
    /// select. The other form fields keep whatever values the user has set;
    /// only the sibling-specific assumptions (locked template, auto-allocated
    /// ID range, full-workspace preview, updated .code-workspace on output)
    /// go away.
    /// </summary>
    private void ClearImportedWorkspace()
    {
        _workspaceContext = null;
        _importFileName = string.Empty;
        _importMessage = string.Empty;
        _importErrors = new();
        if (!_hydratedFromRepository)
        {
            _hydrationSource = null;
        }
    }
}
