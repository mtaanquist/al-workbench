@page "/environments/{EnvironmentId:int}"
@page "/environments/{EnvironmentId:int}/{OpenTab}"
@page "/environments/{Solution}/{Environment}"
@page "/environments/{Solution}/{Environment}/{OpenTab}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Bc.UpgradeFleetService Fleet
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ALDevToolbox.Services.ObjectExplorer.Bc.UpgradeActionService UpgradeActions
@inject ALDevToolbox.Services.ObjectExplorer.ProjectAccess Access
@inject ILogger<EnvironmentDetail> Log
@inject NavigationManager Nav
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone
@using System.Globalization
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Services
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using static ALDevToolbox.Components.Shared.FleetRowState

@*
    One Business Central environment: what it is on, when Microsoft moves it, what is
    installed, what is waiting, and the three settings we can change in the customer's
    tenant. Built to .design/handoff/PageEnvironmentDetail.dc.html; every departure is
    tabled in .design/environment-updates.md.

    Named user: an ops engineer responsible for a fleet of customer environments, who
    today opens each customer's admin centre in turn. Knows Business Central; knows
    nothing about this codebase.

    Two kinds of reading share the page, and the freshness strip says which is which.
    The head, the meta row and the Updates card come from our own mirror of the
    environment and cost Business Central nothing. Apps, Operations, Sessions and the
    environment's settings are read live with the customer's credentials - but reading
    is still reading, so all of it follows the solution's visibility: everyone in the
    organisation on a Public or Read-only solution, its teams on a Private one. What
    acts on the customer's tenant - every setting, an app update, an upload, a copy, a
    recovery, ending a session, and the Refresh that makes the tenant answer again - is
    for the people who manage the solution. No second fetch path: it is the
    same cached panel read (ProjectConnectionService.GetEnvironmentPanelAsync).
*@

<PageTitle>@(_env?.Fleet.EnvironmentName ?? "Environment") · AL Workbench</PageTitle>

@* What the command palette opens with on this page: its tabs, the way out to
   Business Central, and its solution. *@
@* Only once found: the lookup behind a readable address does not decide visibility. *@
@if (_env is not null)
{
    <PaletteContext Kind="ALDevToolbox.Services.Palette.PaletteContextKind.Environment" Id="Id" />
}

<DetailPage IsLoading="@(!_loaded)"
            LoadingText="Loading environment..."
            IsNotFound="@(_loaded && _env is null)"
            Title="@_env?.Fleet.EnvironmentName"
            PageClass="env-detail">
    <NotFound>
        <div class="card">
            <EmptyState Icon="server" Title="We couldn't find that environment" Heading="true">
                <Text>
                    Business Central may no longer report it, or it belongs to a solution
                    you can't see.
                </Text>
                <Action>
                    <a class="btn" href="/environments">Back to Environments</a>
                </Action>
            </EmptyState>
        </div>
    </NotFound>
    <Crumbs>
        <a href="/solutions">Solutions</a>
        <Icon Name="chevron-right" Width="14" Height="14" />
        <a href="@Row.SolutionHref">@Row.ProjectName</a>
        <Icon Name="chevron-right" Width="14" Height="14" />
        <a href="/environments">Environments</a>
        <Icon Name="chevron-right" Width="14" Height="14" />
        <span>@Row.EnvironmentName</span>
    </Crumbs>
    <TitleRow>
        <StatusPill Tone="@StatusTone()">@StatusWord(Row)</StatusPill>
        <span class="tag">@Row.EnvironmentType</span>
    </TitleRow>
    <SubtitleContent>@SubtitleText()</SubtitleContent>
    <Actions>
        @if (Row.BusinessCentralUrl is { } bcUrl)
        {
            <a class="btn" href="@bcUrl" target="_blank" rel="noopener">
                <Icon Name="external-link" Width="15" Height="15" />
                <span>Open in Business Central</span>
            </a>
        }
        @if (AdminCentreUrl is { } adminUrl)
        {
            <a class="btn" href="@adminUrl" target="_blank" rel="noopener">
                <Icon Name="external-link" Width="15" Height="15" />
                <span>Open the admin centre</span>
            </a>
        }
        @* The most common thing this page's reader would otherwise open the admin
           centre for. An outline button like its neighbours: it writes to the
           customer's tenant, and nothing on this page is the primary action. A
           deleted environment has nothing to copy - the alert below offers the one
           thing left to do to it. *@
        @if (_canManage && !Row.IsSoftDeleted)
        {
            <button type="button" class="btn @(_settingBusy == "copy" ? "btn--loading" : "")"
                    @onclick="CopyAsync" disabled="@_settingSaving">
                <Icon Name="copy" Width="15" Height="15" />
                <span class="btn__label">@(_settingBusy == "copy" ? "Starting the copy" : "Copy this environment...")</span>
            </button>
        }
    </Actions>
    <ChildContent>
        <div class="freshness @FreshnessClass()">
            <Icon Name="cloud-download" Width="15" Height="15" Css="freshness__icon" />
            <span class="freshness__text">
                @if (_panel is { } fresh)
                {
                    <text>Apps and settings read from Business Central <span class="freshness__age"><Timestamp Value="@fresh.FetchedAtUtc" Relative="true" /></span>. </text>
                }
                @if (_tab == Section.Operations && _operationsFetchedAt is { } opsRead)
                {
                    <text>Operations read from Business Central <span class="freshness__age"><Timestamp Value="@opsRead" Relative="true" /></span>. </text>
                }
                @if (_tab == Section.Sessions && _sessionsFetchedAt is { } sessionsRead)
                {
                    <text>Sessions read from Business Central <span class="freshness__age"><Timestamp Value="@sessionsRead" Relative="true" /></span>. </text>
                }
                @if (Row.EnvironmentFetchedAt is { } mirrored)
                {
                    <text>Version and update dates last checked <span class="freshness__age"><Timestamp Value="@mirrored" Relative="true" /></span>.</text>
                }
                else
                {
                    <text>Version and update dates haven't been read from Business Central yet.</text>
                }
            </span>
            <span class="freshness__spacer"></span>
            @* Refresh is offered where it changes nothing the reader isn't already
               getting. Operations and Sessions are read live on every visit, so anyone
               reading them may read them again; Apps and settings are cached for
               everyone, and making the customer's tenant answer again is a manager's
               call. data-page-refresh lets the command palette press the same button,
               under the same condition - it is offered only where the button is drawn. *@
            @if (_canManage || _tab is Section.Operations or Section.Sessions)
            {
                <button type="button" class="btn btn--sm @(Refreshing ? "btn--loading" : "")"
                        @onclick="RefreshAsync" disabled="@Refreshing" data-page-refresh>
                    <Icon Name="refresh-cw" Width="14" Height="14" />
                    <span class="btn__label">@(Refreshing ? "Refreshing" : "Refresh")</span>
                </button>
            }
            else
            {
                @* A timestamp with no way to move it reads as something broken. Say who
                   can move it, and point at the tab that answers the question this page's
                   reader most often came with - Operations is read fresh every visit. *@
                <span class="u-muted env-detail__count">
                    Only people who manage this solution can read Business Central again.
                    <a href="@TabHref(Section.Operations)">Operations</a> is read fresh every time you open it.
                </span>
            }
        </div>

        @* What the last write did. Up here, not beside the control that did it: the
           writes are spread over a long page (an app, a scheduled install, three
           settings, a booked update) and each re-reads everything, so the one place
           that is always where the eye lands afterwards is the top. *@
        @if (_settingError is { } settingError)
        {
            <Alert Tone="AlertTone.Danger"><span>@settingError</span></Alert>
        }
        else if (_settingDone is { } settingDone)
        {
            @* Some outcomes are only half told here: a copy runs for an hour after the
               page has said it started, so the notice carries the way to go and watch it. *@
            <Alert Tone="AlertTone.Success">
                <span>
                    @settingDone
                    @if (_settingDoneLink is { } link)
                    {
                        <text> </text><a href="@link.Href">@link.Text</a><text>.</text>
                    }
                </span>
            </Alert>
        }

        @* The first thing on the page for a deleted environment, because it changes what
           everything below it means: the version, the windows and the app lists are all
           the state it was in when the customer deleted it. It says the deadline, not
           just the fact, since the deadline is the only thing anyone can still act on. *@
        @if (Row.IsSoftDeleted)
        {
            <Alert Tone="AlertTone.Danger" Block="true">
                <span>
                    <b>@DeletedSentence</b>
                    @* The same reading as the Environments list, word for word: the two
                       are looked at in the same minute, and on a fortnight's window a day
                       either way is a customer's data. *@
                    @if (Row.HardDeletePendingOn is { } goneOn)
                    {
                        <text> It is gone for good on <Timestamp Value="@goneOn" Format="dd MMM yyyy" /> - @RecoverWindowText(goneOn).</text>
                    }
                    else
                    {
                        <text> Business Central usually keeps a deleted environment for about 14 days, but hasn't said when this one goes for good.</text>
                    }
                    <text> Until it is back, Business Central refuses an install, an update or a change of settings on it.</text>
                    @if (_canManage)
                    {
                        <span class="env-detail__recover">
                            <button type="button" class="btn btn--sm @(_settingBusy == "recover" ? "btn--loading" : "")"
                                    @onclick="RecoverAsync" disabled="@_settingSaving">
                                <Icon Name="archive-restore" Width="14" Height="14" />
                                <span class="btn__label">Recover this environment</span>
                            </button>
                        </span>
                    }
                    else
                    {
                        <text> Only people who manage this solution can bring it back - ask its owner or an administrator.</text>
                    }
                </span>
            </Alert>
        }

        @* Under the freshness strip, as the sheet has it, so the strip qualifies the
           numbers below it - which is why this is not the frame's Meta slot. *@
        <div class="meta-row">
            <span class="meta-item"><span class="meta-item__label">Type</span><span class="meta-item__value">@Row.EnvironmentType</span></span>
            <span class="meta-item"><span class="meta-item__label">BC version</span><span class="meta-item__value meta-item__value--mono">@(Row.Version ?? "—")</span></span>
            <span class="meta-item"><span class="meta-item__label">Country</span><span class="meta-item__value">@CountryText()</span></span>
            <span class="meta-item"><span class="meta-item__label">Delivery window</span><span class="meta-item__value">@DeliveryWindowText()</span></span>
            <span class="meta-item"><span class="meta-item__label">Next update</span><span class="meta-item__value"><Timestamp Value="@Row.NextUpdateDate" Format="dd MMM yyyy" Placeholder="—" /></span></span>
            <span class="meta-item"><span class="meta-item__label">Database</span><span class="meta-item__value">@(Row.DatabaseKb is { } dbSize ? StorageDisplay.Size(dbSize) : "—")</span></span>
            <span class="meta-item"><span class="meta-item__label">Apps installed</span><span class="meta-item__value">@(_panel is { InstalledAppsError: null } p ? p.InstalledApps.Count.ToString() : _panel is null && _panelError is null ? "—" : "Not read")</span></span>
        </div>

        @if (Row.TenantStorageUse is { } storageUse && StorageDisplay.Tone(storageUse) is { Length: > 0 } storageTone)
        {
            <Alert Tone="@(storageTone == "danger" ? AlertTone.Danger : AlertTone.Warn)" Role="" Block="true">
                <span>
                    <b>@StorageDisplay.Summary(storageUse, Row.TenantQuotaKb!.Value).</b>
                    The allowance is shared by all of @Row.ProjectName's environments, so deleting a sandbox
                    frees room as well as buying more does.
                </span>
            </Alert>
        }

        @* Under the numbers that are true on every tab. Real links, so a tab can be
           bookmarked and Back works; the page reads the environment once and a change of
           tab only reads what that tab needs. *@
        <div class="settings__tabs">
            <HeaderTabs Items="@SectionTabs" AriaLabel="Environment sections" />
        </div>

        @if (_tab == Section.Overview)
        {
            <div class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Updates</h2>
                        <p class="card__sub">When Microsoft moves this environment to the next Business Central version, and the hours agreed with the customer for our own installs.</p>
                    </div>
                    @if (_canManage && _panel is not null && Choosable().Count > 0)
                    {
                        <a class="btn btn--sm" href="@(Row.Href() + "#env-next-update")">
                            <Icon Name="arrow-down" Width="14" Height="14" />
                            <span>Change the next version</span>
                        </a>
                    }
                </div>
                <div class="card__body">
                    <div class="kv-grid">
                        <span class="meta-item"><span class="meta-item__label">Current version</span><span class="meta-item__value">@CurrentVersionShort()@if (Row.Version is { } full && full != CurrentVersionShort()) {<span class="u-muted"> (@full)</span>}</span></span>
                        <span class="meta-item"><span class="meta-item__label">Next update version</span><span class="meta-item__value">@(Row.NextUpdateVersion ?? "None announced")</span></span>
                        <span class="meta-item"><span class="meta-item__label">Scheduled for</span><span class="meta-item__value"><Timestamp Value="@Row.NextUpdateDate" Format="dd MMM yyyy, HH:mm" Placeholder="—" />@if (ScheduledCustomerText() is { } customerText) {<span class="u-muted env-detail__utc">@customerText</span>}</span></span>
                        <span class="meta-item"><span class="meta-item__label">Latest possible date</span><span class="meta-item__value"><Timestamp Value="@Row.EffectiveLatestDate" Format="dd MMM yyyy" Placeholder="—" /></span></span>
                        <span class="meta-item"><span class="meta-item__label">Our delivery window</span><span class="meta-item__value">@DeliveryWindowText()</span></span>
                        <span class="meta-item"><span class="meta-item__label">BC update window</span><span class="meta-item__value">@BcWindowText()</span></span>
                    </div>
                    @if (LaterVersions() is { Length: > 0 } later)
                    {
                        <p class="u-muted env-detail__later">Also announced: @later</p>
                    }
                    @* "None announced" above is a fact; when Business Central refused to
                       say, it is a guess. A manager reads the refusal on the setting row
                       this card links down to, which nobody else has, so it is said here
                       for everyone else. *@
                    @if (!_canManage && _panel?.EnvironmentUpdatesError is { } updatesUnread)
                    {
                        <FieldError Class="env-detail__later">Couldn't read the versions this environment is being offered: @updatesUnread</FieldError>
                    }
                    @if (WindowsOverlap())
                    {
                        <Alert Tone="AlertTone.Info" Class="env-detail__overlap" Block="true">
                            <span>
                                The two windows overlap. Business Central refuses an install while it
                                is updating the environment, so a deployment that lands during Microsoft's
                                update would fail. Move the delivery window if the update date matters
                                to the customer.
                            </span>
                        </Alert>
                    }
                    @* Ours to set, and about this one environment, so it is set here rather
                       than from a row of the solution's list. Touches no tenant: no confirm. *@
                    @if (_canManage)
                    {
                        @if (!_windowEditing)
                        {
                            <div class="env-detail__window-open">
                                <button type="button" class="btn btn--sm" @onclick="OpenWindowEditor">
                                    <Icon Name="clock" Width="14" Height="14" />
                                    <span>Change the delivery window</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="env-detail__window">
                                <div class="env-detail__window-row">
                                    <label class="env-detail__window-time">From <input type="time" class="input input--sm" @bind="_winStart" disabled="@_windowSaving" /></label>
                                    <label class="env-detail__window-time">To <input type="time" class="input input--sm" @bind="_winEnd" disabled="@_windowSaving" /></label>
                                    <button type="button" class="btn btn--sm" @onclick="SaveWindowAsync" disabled="@_windowSaving">Save window</button>
                                    <button type="button" class="btn btn--sm" @onclick="() => PersistWindowAsync(null, null)" disabled="@_windowSaving">Clear (any time)</button>
                                    <button type="button" class="btn btn--sm" @onclick="() => _windowEditing = false" disabled="@_windowSaving">Cancel</button>
                                </div>
                                <small class="field__hint">@WindowZoneCaption() These are the hours agreed with the customer for our own installs. Deployments prefill to the next opening; you can still deploy outside it. A window may run past midnight (e.g. 22:00 to 06:00).</small>
                                @if (_windowError is { } windowError)
                                {
                                    <FieldError Message="@windowError" />
                                }
                            </div>
                        }
                    }
                </div>
            </div>
            <p class="section-label">Environment settings</p>
            @if (LivePanel is { } panel)
            {
                <div class="card">
                    @if (!_canManage)
                    {
                        <div class="card__head">
                            <div>
                                <p class="card__sub">
                                    Read from @Row.ProjectName's Business Central. Only people who manage
                                    this solution can change them.
                                </p>
                            </div>
                        </div>
                    }
                    @if (_canManage)
                    {
                        <Alert Tone="AlertTone.Warn" Role="" Class="env-detail__warn" Block="true">
                            <span>
                                <b>These change @Row.EnvironmentName in the customer's tenant.</b>
                                Saving here writes straight to @Row.ProjectName's Business Central
                                environment, not just to the workbench. Agree the change with the customer first.
                            </span>
                        </Alert>
                    }
                    <div class="setting-list">
                        <div class="setting">
                            <span class="setting__label">
                                @if (_canManage)
                                {
                                    <label class="setting__name" for="env-cadence">AppSource apps update cadence</label>
                                }
                                else
                                {
                                    <span class="setting__name">AppSource apps update cadence</span>
                                }
                                <span class="setting__hint">How often apps the customer installed are updated. Does not affect extensions you deploy yourself.</span>
                            </span>
                            <span class="setting__ctl">
                                @if (_canManage)
                                {
                                    <SelectBox style="width: 240px">
                                        <select id="env-cadence" class="select" value="@_cadence" disabled="@_settingSaving"
                                                @onchange="OnCadenceChangedAsync">
                                            @foreach (var option in BcAppUpdateCadence.All)
                                            {
                                                <option value="@option">@BcAppUpdateCadence.Display(option)</option>
                                            }
                                        </select>
                                    </SelectBox>
                                }
                                else
                                {
                                    <span class="env-detail__value">@BcAppUpdateCadence.Display(_cadence)</span>
                                }
                            </span>
                        </div>
                        <div class="setting">
                            <span class="setting__label">
                                <span class="setting__name" id="env-m365-label">Access with Microsoft 365 licences</span>
                                <span class="setting__hint">
                                    Lets people who hold only a Microsoft 365 licence sign in and read data in this environment.
                                    @if (_m365 is null && _canManage)
                                    {
                                        <text>
                                            Couldn't read this setting right now - try Refresh above, or check the
                                            connection on the <a href="@(Row.SolutionHref + "?tab=bc")">solution's Business Central tab</a>.
                                        </text>
                                    }
                                    else if (_m365 is null)
                                    {
                                        <text>Couldn't read this setting right now. Someone who manages this solution can read it again.</text>
                                    }
                                </span>
                            </span>
                            <span class="setting__ctl">
                                @if (_m365 is { } m365 && _canManage)
                                {
                                    <Switch Name="M365Access" Label="@(m365 ? "Allowed" : "Not allowed")" Checked="m365"
                                            Disabled="_settingSaving" AriaDescribedBy="env-m365-label"
                                            CheckedChanged="SaveM365Async" />
                                }
                                else if (_m365 is { } m365Value)
                                {
                                    <span class="env-detail__value">@(m365Value ? "Allowed" : "Not allowed")</span>
                                }
                                else
                                {
                                    <span class="u-muted">Unknown</span>
                                }
                            </span>
                        </div>
                        @if (_canManage)
                        {
                            <div class="setting setting--danger" id="env-next-update">
                                <span class="setting__label">
                                    <label class="setting__name" for="env-version">Next Business Central update</label>
                                    <span class="setting__hint">
                                        @if (panel.EnvironmentUpdatesError is { } platformErr)
                                        {
                                            <text>@platformErr</text>
                                        }
                                        else if (Choosable().Count == 0)
                                        {
                                            <text>No other version is available to choose right now.</text>
                                        }
                                        else
                                        {
                                            <text>
                                                Picking a version reschedules the update in the customer's tenant.
                                                The upgrade itself runs in Microsoft's update window, not yours.
                                            </text>
                                        }
                                    </span>
                                </span>
                                <span class="setting__ctl">
                                    <span class="u-row">
                                        <SelectBox style="width: 180px">
                                            <select id="env-version" class="select" @bind="_targetVersion"
                                                    disabled="@(_settingSaving || Choosable().Count == 0)">
                                                <option value="">Choose a version...</option>
                                                @foreach (var option in panel.EnvironmentUpdates.Where(u => u.Available))
                                                {
                                                    @* The version already queued is shown so the list matches the
                                                       admin centre, but picking it would ask for no change. *@
                                                    <option value="@option.TargetVersion" disabled="@option.Selected">@option.TargetVersion@(option.Selected ? " (already next)" : "")</option>
                                                }
                                            </select>
                                        </SelectBox>
                                        <button type="button" class="btn btn--sm @(_settingBusy == "version" ? "btn--loading" : "")"
                                                disabled="@(_settingSaving || string.IsNullOrEmpty(_targetVersion))"
                                                @onclick="SaveTargetVersionAsync">
                                            <span class="btn__label">Reschedule</span>
                                        </button>
                                    </span>
                                    <span class="setting__lock"><Icon Name="lock" Width="12" Height="12" />Writes to the customer's tenant</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                @LiveUnavailable()
            }
        }
        else if (_tab == Section.Apps)
        {
            @* Drawn whether or not Business Central answered: the uploads booked here are
               ours to show and cancel, and a tenant that will not answer today is exactly
               when somebody wants to call one off. *@
            var panel = LivePanel;
            if (panel is not null || BookedInstalls.Count > 0)
            {
                <div class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Scheduled installs</h2>
                            <p class="card__sub">Apps waiting to install on this environment, whether booked here or already handed to Business Central.</p>
                        </div>
                        @if (_canManage)
                        {
                            <button type="button" class="btn btn--sm" disabled="@_settingSaving" @onclick="UploadAppAsync">
                                <Icon Name="upload" Width="14" Height="14" />
                                <span>Upload apps</span>
                            </button>
                        }
                    </div>
                    @if (panel?.ScheduledInstallsError is { } scheduledErr && BookedInstalls.Count == 0)
                    {
                        <div class="card__body"><FieldError Message="@scheduledErr" /></div>
                    }
                    else if ((panel?.ScheduledInstalls.Count ?? 0) == 0 && BookedInstalls.Count == 0)
                    {
                        <EmptyState Icon="calendar" Title="Nothing waiting to install" Quiet="true">
                            <Text>A deployment you schedule for this environment, or an app another company sent you that you upload for later, waits here until it installs.</Text>
                            <Action>
                                <a class="btn btn--sm" href="/pipelines/deployments">Open deployment pipelines</a>
                            </Action>
                        </EmptyState>
                    }
                    else
                    {
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th scope="col">App</th>
                                    <th scope="col">Version</th>
                                    <th scope="col">Installs</th>
                                    @if (_canManage)
                                    {
                                        <th scope="col" class="data-table__actions">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @* Uploads and AppSource updates booked here: still in this workbench, not
                                   yet with Business Central, which is why they can be called off or
                                   started early. *@
                                @foreach (var booked in BookedInstalls)
                                {
                                    <tr @key="@($"booked-{booked.Id}")">
                                        <td>
                                            @(booked.PackageFileName ?? booked.AppName ?? "An app")
                                            <span class="tag">@(booked.Kind == UpgradeActionKind.UpdateApp ? "Update booked here" : "Uploaded here")</span>
                                            @if (BatchPlace(booked) is { } place)
                                            {
                                                <span class="u-muted">@place</span>
                                            }
                                        </td>
                                        <td class="u-num env-detail__mono">@(booked.Kind == UpgradeActionKind.UpdateApp ? booked.TargetVersion : "-")</td>
                                        <td>@BookedWhen(booked)</td>
                                        @if (_canManage)
                                        {
                                            <td class="data-table__actions">
                                                @* Nothing to do to one mid-install: the worker has claimed it, and a
                                                   cancel would only be refused. *@
                                                @if (booked.SentAt is null)
                                                {
                                                    @if (booked.ExecuteAfter > DateTime.UtcNow)
                                                    {
                                                        <button type="button" class="btn btn--sm" disabled="@_settingSaving"
                                                                @onclick="() => InstallBookedNowAsync(booked)">@(booked.Kind == UpgradeActionKind.UpdateApp ? "Update now" : "Install now")</button>
                                                    }
                                                    <button type="button" class="btn btn--sm btn--danger" disabled="@_settingSaving"
                                                            @onclick="() => CancelBookedInstallAsync(booked)">@(booked.Kind == UpgradeActionKind.UpdateApp ? "Cancel update" : "Cancel install")</button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                                @foreach (var op in panel?.ScheduledInstalls ?? Array.Empty<BcScheduledPteOperation>())
                                {
                                    <tr>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(op.Name) ? "An extension" : op.Name)
                                            @if (op.AppId is { } ourApp && panel!.ReleasedAppIds.Contains(ourApp))
                                            {
                                                <span class="tag">Deployed from this workbench</span>
                                            }
                                        </td>
                                        <td class="u-num env-detail__mono">@op.TargetAppVersion</td>
                                        <td>@ScheduleWhen(op.ScheduleKind)</td>
                                        @if (_canManage)
                                        {
                                            <td class="data-table__actions">
                                                @if (op.AppId is { } appId)
                                                {
                                                    <button type="button" class="btn btn--sm btn--danger"
                                                            @onclick="() => CancelScheduledAsync(appId, op)">Cancel install</button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="card__foot">
                            <span class="u-muted env-detail__count">
                                Installs started from Business Central's own Extension Management page aren't shown here.@if (_canManage) {<text> Pick one place per customer.</text>}
                            </span>
                        </div>
                        @if (panel?.ScheduledInstallsError is { } bookedOnlyErr)
                        {
                            <div class="card__body"><FieldError Message="@bookedOnlyErr" /></div>
                        }
                    }
                </div>
            }
            if (panel is not null)
            {
                <div class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title env-detail__counted">Installed apps<span class="badge">@panel.InstalledApps.Count</span></h2>
                            <p class="card__sub">Reported by the environment, including Microsoft's own apps.</p>
                        </div>
                        @if (panel.InstalledApps.Count > 0)
                        {
                            <span class="search env-detail__filter">
                                <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                                <input class="input" type="search" placeholder="Filter installed apps..."
                                       aria-label="Filter installed apps" data-page-search aria-keyshortcuts="F3" title="Filter installed apps (F3)"
                                       @bind="_installedFilter" @bind:event="oninput" />
                            </span>
                        }
                    </div>
                    @if (panel.InstalledAppsError is { } installedErr)
                    {
                        <div class="card__body"><FieldError Message="@installedErr" /></div>
                    }
                    else if (panel.InstalledApps.Count == 0)
                    {
                        <EmptyState Title="No apps reported" Quiet="true">
                            <Text>Business Central answered, but listed nothing installed on this environment.</Text>
                        </EmptyState>
                    }
                    else
                    {
                        var installed = FilteredInstalled(panel);
                        var installedShown = _showAllInstalled || _installedFilter.Length > 0 ? installed : installed.Take(InstalledPreview).ToList();
                        @if (installed.Count == 0)
                        {
                            <EmptyState Title="No installed app matches that" Quiet="true">
                                <Text>Try part of the app's name or its publisher.</Text>
                            </EmptyState>
                        }
                        else
                        {
                            <table class="data-table">
                                <thead>
                                    <tr><th scope="col">App</th><th scope="col">Publisher</th><th scope="col">Version</th><th scope="col">Source</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in installedShown)
                                    {
                                        <tr>
                                            <td>
                                                @app.Name
                                                @if (panel.ReleasedAppIds.Contains(app.AppId))
                                                {
                                                    <span class="tag">Deployed from this workbench</span>
                                                }
                                            </td>
                                            <td>@app.Publisher</td>
                                            <td class="u-num env-detail__mono">@app.Version</td>
                                            <td>@SourceText(app)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="card__foot">
                                <span class="u-muted env-detail__count">
                                    @if (installedShown.Count < panel.InstalledApps.Count)
                                    {
                                        <text>Showing @installedShown.Count of @panel.InstalledApps.Count. </text>
                                    }
                                    Extensions you build are updated from <a href="/pipelines/deployments">Deployments</a>, not here.
                                </span>
                                @if (installedShown.Count < installed.Count)
                                {
                                    <button type="button" class="btn btn--sm" @onclick="() => _showAllInstalled = true">Show all @installed.Count</button>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title env-detail__counted">AppSource updates waiting<span class="badge">@panel.AvailableUpdates.Count</span></h2>
                            <p class="card__sub">
                                @if (BlockedCount(panel) > 0)
                                {
                                    <text>@BlockedCount(panel) of these @(BlockedCount(panel) == 1 ? "waits" : "wait") for another app to be updated first. </text>
                                }
                                Apps you build and deploy yourself are never listed here.
                            </p>
                        </div>
                        @if (panel.AvailableUpdates.Count > 0)
                        {
                            <span class="u-row">
                                <span class="search env-detail__filter">
                                    <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                                    <input class="input" type="search" placeholder="Filter updates..."
                                           aria-label="Filter AppSource updates" data-page-search aria-keyshortcuts="F3" title="Filter AppSource updates (F3)"
                                           @bind="_updatesFilter" @bind:event="oninput" />
                                </span>
                                <SelectBox style="width: 150px">
                                    <select class="select" aria-label="Show ready or waiting updates" @bind="_updatesShow">
                                        <option value="">All updates</option>
                                        <option value="ready">Ready now</option>
                                        <option value="blocked">Waiting</option>
                                    </select>
                                </SelectBox>
                            </span>
                        }
                    </div>
                    @if (panel.AvailableUpdatesError is { } updatesErr)
                    {
                        <div class="card__body"><FieldError Message="@updatesErr" /></div>
                    }
                    else if (panel.AvailableUpdates.Count == 0)
                    {
                        <EmptyState Icon="circle-check" Title="No AppSource app has a newer version waiting" Quiet="true" />
                    }
                    else
                    {
                        var updates = FilteredUpdates(panel);
                        var narrowed = _updatesFilter.Length > 0 || _updatesShow.Length > 0;
                        var updatesShown = _showAllUpdates || narrowed ? updates : updates.Take(UpdatesPreview).ToList();
                        @if (updates.Count == 0)
                        {
                            <EmptyState Title="No waiting update matches that" Quiet="true">
                                <Text>Try part of the app's name, or choose All updates.</Text>
                            </EmptyState>
                        }
                        else
                        {
                            <table class="data-table data-table--edge u-compact">
                                <thead>
                                    <tr>
                                        <th class="data-table__col-state" scope="col"><span class="u-sr">State</span></th>
                                        <th scope="col">App</th>
                                        <th scope="col">Publisher</th>
                                        <th scope="col">Target version</th>
                                        <th scope="col">Prerequisites</th>
                                        @if (_canManage)
                                        {
                                            <th scope="col" class="data-table__actions">Actions</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var up in updatesShown)
                                    {
                                        var ready = up.Requirements.Count == 0;
                                        var progress = UpdateProgress(panel, up);
                                        var rowState = progress is not null ? "is-running" : UpdateRowClass(up);
                                        <tr class="@rowState">
                                            <td class="data-table__col-state">
                                                @if (progress is not null)
                                                {
                                                    <StatusPill Tone="@(progress == "Updating" ? "running" : "queued")">@progress</StatusPill>
                                                }
                                                else if (ready)
                                                {
                                                    <StatusPill Tone="success">Ready</StatusPill>
                                                }
                                                else
                                                {
                                                    <StatusPill Tone="queued">Waits for @up.Requirements.Count</StatusPill>
                                                }
                                            </td>
                                            <td>@up.Name</td>
                                            <td>@up.Publisher</td>
                                            <td class="u-num env-detail__mono">@up.Version</td>
                                            <td>
                                                @if (ready)
                                                {
                                                    <span class="u-muted">None</span>
                                                }
                                                else
                                                {
                                                    <span class="u-row env-detail__tags">
                                                        @foreach (var req in up.Requirements)
                                                        {
                                                            <span class="tag">@req.Name</span>
                                                        }
                                                    </span>
                                                }
                                            </td>
                                            @if (_canManage)
                                            {
                                                <td class="data-table__actions">
                                                    @* A waiting row updates too: Business Central brings
                                                       the apps it waits for along, and the dialog lists
                                                       them first so nothing moves that nobody agreed to. *@
                                                    @* Once an update is on its way the button says so and
                                                       stops working, for the app that was asked for and for
                                                       every app that moves with it - pressing it again would
                                                       only ask Business Central for the same thing twice. *@
                                                    <button type="button" class="btn btn--sm"
                                                            disabled="@(_settingSaving || progress is not null)" @onclick="() => UpdateAppAsync(up)"
                                                            title="@(progress == "Booked" ? "Booked to update later - see Scheduled installs to start it now or cancel it." : null)"
                                                            aria-label="@(progress == "Booked"
                                                                ? $"{up.Name} is booked to update to {up.Version}; see Scheduled installs"
                                                                : ready
                                                                ? $"Update {up.Name} to {up.Version}"
                                                                : $"Update {up.Name} to {up.Version}, along with the {up.Requirements.Count} it waits for")">
                                                        <span class="btn__label">@(progress switch
                                                        {
                                                            "Updating" => "Updating...",
                                                            "Scheduled" => "Scheduled",
                                                            "Booked" => "Booked",
                                                            _ => ready ? "Update" : $"Update + {up.Requirements.Count}",
                                                        })</span>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="card__foot">
                                <span class="u-muted env-detail__count">
                                    @if (updatesShown.Count < panel.AvailableUpdates.Count)
                                    {
                                        <text>Showing @updatesShown.Count of @panel.AvailableUpdates.Count, ready ones first. </text>
                                    }
                                    Left alone, Business Central installs these on the <a href="@TabHref(Section.Overview)">update cadence set under Overview</a>.
                                </span>
                                @if (updatesShown.Count < updates.Count)
                                {
                                    <button type="button" class="btn btn--sm" @onclick="() => _showAllUpdates = true">Show all @updates.Count</button>
                                }
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                @LiveUnavailable()
            }
        }
        else if (_tab == Section.Operations)
        {
            @* Business Central's record, where History is ours: an update someone started
               from the admin centre, or one Microsoft ran overnight, shows up here and
               nowhere else on the page. *@
            @if (_operationsError is { } operationsError)
            {
                <div class="card">
                    <EmptyState Icon="plug" Title="Couldn't read the operations from Business Central" Action="@ConnectionAction()">
                        <Text>
                            @operationsError
                            @if (!_canManage)
                            {
                                <text> Ask the solution's owner or an administrator to check its Business Central connection.</text>
                            }
                        </Text>
                    </EmptyState>
                </div>
            }
            else if (_operations is null)
            {
                <LoadingBlock Text="@($"Asking Business Central what has happened on {Row.EnvironmentName}...")" />
            }
            else
            {
                <EnvironmentOperationsList Operations="_operations"
                                           EnvironmentName="@Row.EnvironmentName"
                                           AppName="AppNameFor"
                                           HistoryHref="@TabHref(Section.History)" />
            }
        }
        else if (_tab == Section.Sessions)
        {
            @* Who is signed in this minute, and the way to end one of those sessions.
               The one live part of the page: it reads on arrival and keeps itself
               current while it is open. See .design/environment-updates.md, "Sessions". *@
            @if (Row.IsSoftDeleted)
            {
                <div class="card">
                    <EmptyState Icon="users" Title="Nobody can be signed in to a deleted environment" Quiet="true">
                        <Text>
                            Business Central ended every session when @Row.EnvironmentName was
                            deleted. Bring it back and people can sign in again.
                        </Text>
                    </EmptyState>
                </div>
            }
            else if (_sessionsError is { } sessionsError)
            {
                <div class="card">
                    <EmptyState Icon="plug" Title="Couldn't read who is signed in to this environment" Action="@ConnectionAction()">
                        <Text>
                            @sessionsError
                            @if (!_canManage)
                            {
                                <text> Ask the solution's owner or an administrator to check its Business Central connection.</text>
                            }
                        </Text>
                    </EmptyState>
                </div>
            }
            else if (_sessions is null)
            {
                <LoadingBlock Text="@($"Asking Business Central who is signed in to {Row.EnvironmentName}...")" />
            }
            else
            {
                <EnvironmentSessionsList Sessions="_sessions"
                                         EnvironmentName="@Row.EnvironmentName"
                                         FetchedAt="_sessionsFetchedAt"
                                         Refreshing="_sessionsLoading"
                                         Busy="_settingSaving"
                                         Stopped="_sessionsLiveStopped"
                                         StoppedAfterText="@LiveForText()"
                                         UpdateFailed="@_sessionsStaleNote"
                                         UpdateEverySeconds="@((int)SessionsLiveEvery.TotalSeconds)"
                                         CanCancel="_canManage"
                                         OperationsHref="@TabHref(Section.Operations)"
                                         OnCancel="CancelSessionAsync"
                                         OnRefresh="RefreshSessionsAsync" />
            }
        }
        else
        {
            @* Our own record, not Business Central's, so it is outside every branch above: a
               customer whose tenant won't answer today must not lose the history of what was
               done to it. Anyone who can see the solution reads it; only the
               environment-updates grant gets a Cancel. *@
            <div class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Workbench history</h2>
                        <p class="card__sub">
                            What people did to @Row.EnvironmentName from AL Workbench, and what is still booked.
                            Everything Business Central itself recorded, whoever started it, is under
                            <a href="@TabHref(Section.Operations)">Operations</a>.
                        </p>
                    </div>
                </div>
                <div class="card__body">
                    <EnvironmentActivityFeed Entries="_activity"
                                             CanAct="Row.CanAct"
                                             CanActOnUploads="_canManage"
                                             TimeZone="UpdateWindow.ResolveTimeZone(Row.TimeZone)"
                                             TimeZoneLabel="@(string.IsNullOrWhiteSpace(Row.TimeZone) ? "UTC" : Row.TimeZone!)"
                                             OnCancel="CancelUpgradeActionAsync" />
                </div>
            </div>
        }
    </ChildContent>
</DetailPage>

<ConfirmDialog @ref="_confirm" />

@* Its own dialog because it asks a question the others do not: when. It asks it the
   way the upload dialog does, because both are bookings the workbench sends at the
   slot. The gentle answer is the default - an app update can interrupt whoever is
   working in it. *@
<ConfirmDialog @ref="_updateConfirm" Wide="true" ConfirmDisabled="@(!_updateWhen.IsValid)">
    @if (_updateAlongside.Count > 0)
    {
        <div class="env-detail__alongside">
            <p class="env-detail__when-legend">These will be installed or updated too</p>
            <ul class="env-detail__alongside-list">
                @foreach (var req in _updateAlongside)
                {
                    <li>
                        <span class="env-detail__alongside-name">@req.Name</span>
                        <span class="u-muted env-detail__alongside-pub">@req.Publisher</span>
                        <span class="u-num env-detail__mono env-detail__alongside-ver">@(string.IsNullOrWhiteSpace(req.Version) ? "" : $"to {req.Version} or newer")</span>
                    </li>
                }
            </ul>
        </div>
    }
    <InstallTimingPicker Choice="_updateWhen" Name="env-update-when" Changed="() => { }" />
</ConfirmDialog>

<UploadAppDialog @ref="_uploadDialog" />
<CopyEnvironmentDialog @ref="_copyDialog" />

@code {
    /// <summary>The numeric address, /environments/42. Still served, and forwarded to the readable one.</summary>
    [Parameter] public int? EnvironmentId { get; set; }

    /// <summary>The solution's slug in the readable address, /environments/{Solution}/{Environment}.</summary>
    [Parameter] public string? Solution { get; set; }

    /// <summary>The environment's name in the readable address.</summary>
    [Parameter] public string? Environment { get; set; }

    /// <summary>The environment on screen, whichever address named it; 0 when the address names none.</summary>
    private int Id { get; set; }

    /// <summary>The address <see cref="Id"/> was last resolved from.</summary>
    private (int?, string?, string?)? _resolvedFor;

    /// <summary>Rows shown before "Show all", as on the sheet.</summary>
    private const int InstalledPreview = 6;
    private const int UpdatesPreview = 12;

    /// <summary>A mirror reading older than this gets the stale strip, as on the Environments list.</summary>
    private static readonly TimeSpan StaleAfter = TimeSpan.FromHours(24);

    private bool _loaded;
    private EnvironmentDetailRow? _env;

    /// <summary>Only read inside fragments the frame draws once the environment is found.</summary>
    private UpgradeFleetRow Row => _env!.Fleet;

    /// <summary>
    /// Owner, org admin or a member of an assigned team: who may change anything here.
    /// Reading the page - including everything read live from Business Central - only
    /// needs to be able to see the solution, which is what finding <c>_env</c> proved.
    /// </summary>
    private bool _canManage;

    private BcEnvironmentPanel? _panel;
    private bool _panelLoading;
    private string? _panelError;
    private bool? _m365;
    private List<UpgradeActionRow>? _activity;

    private string _installedFilter = string.Empty;
    private bool _showAllInstalled;
    private string _updatesFilter = string.Empty;
    private string _updatesShow = string.Empty;
    private bool _showAllUpdates;

    private ConfirmDialog? _confirm;
    private ConfirmDialog? _updateConfirm;

    /// <summary>The update dialog's answer to "when". Reset to the gentle one each time it opens.</summary>
    private readonly InstallTimingPicker.TimingChoice _updateWhen = new();

    private UploadAppDialog? _uploadDialog;
    private CopyEnvironmentDialog? _copyDialog;

    /// <summary>What the app in the update dialog waits for, and so what moves with it. Empty for a ready app.</summary>
    private IReadOnlyList<BcAppUpdateRequirement> _updateAlongside = Array.Empty<BcAppUpdateRequirement>();
    private string _cadence = BcAppUpdateCadence.Default;
    private string _targetVersion = string.Empty;
    private bool _settingSaving;
    private string? _settingBusy;
    private string? _settingError;
    private string? _settingDone;

    /// <summary>Where to go on from an outcome the page cannot finish telling - a copy that is still running.</summary>
    private (string Href, string Text)? _settingDoneLink;

    /// <summary>The tab in the address: "apps", "operations", "sessions" or "history". Absent, or anything else, is Overview.</summary>
    [Parameter] public string? OpenTab { get; set; }

    private enum Section { Overview, Apps, Operations, Sessions, History }
    private Section _tab = Section.Overview;

    /// <summary>The environment the page last read, so a change of tab does not read it again.</summary>
    private int? _loadedId;

    private List<BcEnvironmentOperation>? _operations;
    private bool _operationsLoading;
    private string? _operationsError;
    private DateTime? _operationsFetchedAt;

    // ── Sessions ────────────────────────────────────────────────────────
    //
    // The one live thing on the page. Everything else here is a fact that holds for
    // minutes or days; who is signed in is true for seconds, so a list that is not
    // being kept current is a list that is quietly wrong. See
    // .design/environment-updates.md, "Sessions".

    private List<BcSession>? _sessions;
    private bool _sessionsLoading;
    private string? _sessionsError;
    private DateTime? _sessionsFetchedAt;

    /// <summary>Set when an automatic re-read failed and the last good list is still worth showing.</summary>
    private string? _sessionsStaleNote;

    /// <summary>True once the live loop has given up, so the card can offer to start it again.</summary>
    private bool _sessionsLiveStopped;

    /// <summary>True while the tab is the one on screen, which is what the loop runs for.</summary>
    private bool _sessionsTabActive;

    /// <summary>True while the cancel confirm is open: the row it names must not move under the person.</summary>
    private bool _sessionsConfirmOpen;

    /// <summary>
    /// How often the Sessions tab re-reads while it is open, and how long it keeps doing
    /// so before stopping. Parameters only so a test needn't wait thirty seconds for a
    /// tick; nothing in the app passes them, and the card's copy is written from them so
    /// the sentence and the timer cannot disagree.
    /// </summary>
    [Parameter] public TimeSpan SessionsLiveEvery { get; set; } = TimeSpan.FromSeconds(30);
    [Parameter] public TimeSpan SessionsLiveFor { get; set; } = TimeSpan.FromMinutes(10);

    private List<HeaderTabs.HeaderTabItem> SectionTabs =>
    [
        Tab("Overview", Section.Overview),
        Tab("Apps", Section.Apps),
        Tab("Operations", Section.Operations),
        Tab("Sessions", Section.Sessions),
        Tab("Workbench history", Section.History),
    ];

    private HeaderTabs.HeaderTabItem Tab(string label, Section section) =>
        new(label, TabHref(section), IsActive: _tab == section);

    private string TabHref(Section section) => SectionHref(section == Section.Overview ? null : section.ToString().ToLowerInvariant());

    /// <summary>This page's own address, on <paramref name="tab"/> when given: the readable one once the environment is loaded.</summary>
    private string SectionHref(string? tab) => _env is not null && _loadedId == Id
        ? Row.Href(tab)
        : ALDevToolbox.Services.ObjectExplorer.Projects.SolutionLinks.Environment(Solution, Environment, Id, tab);

    /// <summary>The live panel when there is one to draw, else null and <see cref="LiveUnavailable"/> says why.</summary>
    private BcEnvironmentPanel? LivePanel => _panelError is null ? _panel : null;

    /// <summary>Why the live half is not on screen: still being read, or unreadable.</summary>
    private RenderFragment LiveUnavailable() => @<div>
        @if (_panelError is { } panelError)
        {
            <div class="card">
                <EmptyState Icon="plug" Title="Couldn't read apps and settings from Business Central" Action="@ConnectionAction()">
                    <Text>
                        @panelError
                        @if (!_canManage)
                        {
                            <text> Ask the solution's owner or an administrator to check its Business Central connection.</text>
                        }
                    </Text>
                </EmptyState>
            </div>
        }
        else
        {
            <LoadingBlock Text="@($"Asking Business Central what's on {Row.EnvironmentName}...")" />
        }
    </div>;

    /// <summary>
    /// The way out of a tenant that will not answer is the solution's Business Central
    /// tab, which only the people who manage it have. So a reader is told who to ask, in
    /// the card's text, and gets no button: an action somebody cannot finish is worse
    /// than none. Null rather than an empty fragment, so no action slot is drawn at all.
    /// </summary>
    private RenderFragment? ConnectionAction()
    {
        if (!_canManage) return null;
        return @<a class="btn" href="@(Row.SolutionHref + "?tab=bc")">Check the solution's connection</a>;
    }

    private bool Refreshing => _panelLoading || _operationsLoading || _sessionsLoading;

    /// <summary>Refresh re-reads what the open tab shows.</summary>
    private async Task RefreshAsync()
    {
        if (_tab == Section.Operations) await LoadOperationsAsync();
        else if (_tab == Section.Sessions) await RefreshSessionsAsync();
        else if (_tab == Section.History) _activity = await Read(ct => UpgradeActions.ListEnvironmentActivityAsync(Row.ProjectId, Id, ct));
        else
        {
            await LoadPanelAsync(forceRefresh: true);
            // The Apps tab lists the uploads booked here among the scheduled installs, and
            // one whose slot has passed may have been sent since the page loaded.
            if (_tab == Section.Apps) await LoadBookedInstallsAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Looked up once per address: a change of tab keeps the component, and its
        // reads (the live sessions loop among them) may still be using the context.
        if (EnvironmentId is { } numbered)
        {
            // A number needs no lookup.
            _resolvedFor = (EnvironmentId, Solution, Environment);
            Id = numbered;
        }
        else if (_resolvedFor != (EnvironmentId, Solution, Environment))
        {
            _resolvedFor = (EnvironmentId, Solution, Environment);
            Id = EnvironmentId
                ?? (Solution is not null && Environment is not null
                    ? await Read(ct => Fleet.FindEnvironmentIdAsync(Solution, Environment, ct)) ?? 0
                    : 0);
        }

        var known = Enum.TryParse<Section>(OpenTab, ignoreCase: true, out var asked)
            && Enum.IsDefined(asked) && !int.TryParse(OpenTab, out _);
        if (OpenTab is not null && (!known || asked == Section.Overview))
        {
            // A segment that names no tab is dropped from the address rather than left
            // there looking like a place: Overview has one address, the bare one.
            Nav.NavigateTo(SectionHref(null), replace: true);
            return;
        }
        _tab = known ? asked : Section.Overview;

        if (_loadedId != Id)
        {
            // The page is reused from one environment to the next.
            _loaded = false;
            _panel = null;
            _panelError = null;
            _operations = null;
            _operationsError = null;
            LeaveSessionsTab();
            await Zone.EnsureLoadedAsync();
            await LoadEnvironmentAsync();
            _loaded = true;
            _loadedId = Id;
            if (_env is null) return;

            _canManage = await Read(ct => Access.CanManageAsync(Row.ProjectId, _env.CreatedByUserId, ct));
            _activity = await Read(ct => UpgradeActions.ListEnvironmentActivityAsync(Row.ProjectId, Id, ct));
            await LoadBookedInstallsAsync();
        }
        if (_env is null) return;

        // A numeric address forwards to the readable one, on the same tab, so the page
        // has one address whichever link led here - including a palette link to the
        // environment already open. After the load, so the pass that lands on the new
        // address finds everything already read and asks nothing again.
        if (EnvironmentId is not null && Row.ProjectSlug is not null)
        {
            Nav.NavigateTo(SectionHref(_tab == Section.Overview ? null : _tab.ToString().ToLowerInvariant()), replace: true);
            return;
        }

        // Leaving the Sessions tab always stops it reading, whatever else is true -
        // and it drops the list it held, because coming back to a sessions list that
        // is minutes old would answer the wrong question.
        if (_tab != Section.Sessions && _sessionsTabActive) LeaveSessionsTab();

        // Drawn first, then read: the head and the Updates card are ours and ready, and
        // the live half can take Business Central several seconds. LoadPanelAsync raises
        // the flag and redraws before it awaits anything.
        //
        // Only once the page is live, though. The first pass is a prerender, which has
        // nobody to redraw for: it waits for this whole method before a byte is sent, so
        // reading Business Central here made the click into the page hang for as long as
        // the customer's tenant took to answer. The prerender sends the loader instead,
        // and the live pass that follows does the reading.
        //
        // Everyone who got this far reads: finding the environment at all went through
        // the visible-solutions join, which is the whole question for a read. Whether
        // they may change anything is _canManage, and that decides buttons, not fetches.
        //
        // And only what the open tab shows: Overview and Apps share the one cached panel
        // read, Operations and Sessions each have their own, History asks Business
        // Central nothing.
        var wantsPanel = _tab is Section.Overview or Section.Apps;
        if (!RendererInfo.IsInteractive) _panelLoading = wantsPanel;
        else if (wantsPanel && _panel is null && _panelError is null) await LoadPanelAsync();
        else if (_tab == Section.Operations && _operations is null && _operationsError is null)
        {
            await LoadOperationsAsync();
            // The list names an app only by id. The panel knows the names, and is
            // usually cached; the list is already on screen while it is read.
            if (_operations is not null && _panel is null && _panelError is null) await LoadPanelAsync();
        }
        else if (_tab == Section.Sessions && !_sessionsTabActive && !Row.IsSoftDeleted)
        {
            // Arriving on the tab reads at once - by a click or by landing straight on
            // the address - and starts the loop that keeps it current. Never a tab that
            // waits for a button: an empty Sessions tab is a wrong answer.
            _sessionsTabActive = true;
            StartSessionsLive();
            await LoadSessionsAsync();
        }
    }

    private async Task LoadOperationsAsync()
    {
        _operationsLoading = true;
        _operationsError = null;
        StateHasChanged();
        try
        {
            _operations = await Read(ct => Connection.ListEnvironmentOperationsAsync(Row.ProjectId, Id, ct));
            _operationsFetchedAt = DateTime.UtcNow;
        }
        catch (PlanValidationException ex)
        {
            _operations = null;
            _operationsError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't read this environment's operations.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _operations = null;
            _canManage = false;
            _operationsError = ex.Message;
        }
        catch (OperationCanceledException) when (_gone.IsCancellationRequested)
        {
            throw; // the page was left mid-read; see DisposeAsync
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to read the operations for environment {EnvId}.", Id);
            _operations = null;
            _operationsError = "Something went wrong at our end while asking Business Central. Try Refresh in a moment.";
        }
        finally
        {
            _operationsLoading = false;
        }
    }

    // ── Sessions: reading, keeping current, and ending one ──────────────

    /// <summary>
    /// Reads who is signed in. <paramref name="automatic"/> marks a read the loop asked
    /// for rather than a person: one of those failing must not replace a list somebody is
    /// reading out to a customer with an error card, so it keeps the list and says quietly
    /// that it couldn't be updated. A first read that fails has nothing to keep.
    /// </summary>
    private async Task LoadSessionsAsync(bool automatic = false)
    {
        if (_sessionsLoading) return;
        _sessionsLoading = true;
        if (!automatic)
        {
            _sessionsError = null;
            _sessionsStaleNote = null;
        }
        StateHasChanged();
        try
        {
            _sessions = await Read(ct => Connection.ListEnvironmentSessionsAsync(Row.ProjectId, Id, ct));
            _sessionsFetchedAt = DateTime.UtcNow;
            _sessionsError = null;
            _sessionsStaleNote = null;
        }
        catch (PlanValidationException ex)
        {
            SessionsFailed(ex.Errors.Values.FirstOrDefault() ?? "Couldn't read who is signed in to this environment.");
        }
        catch (ProjectAccessDeniedException ex)
        {
            // Lost between the check and the read; nothing left to keep current.
            _canManage = false;
            _sessions = null;
            _sessionsError = ex.Message;
            StopSessionsLive();
        }
        catch (OperationCanceledException) when (_gone.IsCancellationRequested)
        {
            throw; // the page was left mid-read; see DisposeAsync
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to read the sessions for environment {EnvId}.", Id);
            SessionsFailed("Something went wrong at our end while asking Business Central. Try Refresh in a moment.");
        }
        finally
        {
            _sessionsLoading = false;
        }

        void SessionsFailed(string message)
        {
            if (automatic && _sessions is not null)
            {
                _sessionsStaleNote = message;
                return;
            }
            _sessions = null;
            _sessionsError = message;
        }
    }

    /// <summary>Reads now, and starts the ten minutes over: Refresh is also how the loop is restarted.</summary>
    private async Task RefreshSessionsAsync()
    {
        if (!Row.IsSoftDeleted)
        {
            _sessionsTabActive = true;
            StartSessionsLive();
        }
        await LoadSessionsAsync();
    }

    /// <summary>Stops the loop and forgets the list. Nothing about a session outlives the tab.</summary>
    private void LeaveSessionsTab()
    {
        StopSessionsLive();
        _sessionsTabActive = false;
        _sessions = null;
        _sessionsError = null;
        _sessionsFetchedAt = null;
        _sessionsStaleNote = null;
        _sessionsLiveStopped = false;
    }

    /// <summary>How long it keeps itself current, for the line that says it has stopped.</summary>
    private string LiveForText()
    {
        var minutes = (int)Math.Round(SessionsLiveFor.TotalMinutes);
        if (minutes >= 1) return minutes == 1 ? "1 minute" : $"{minutes} minutes";
        var seconds = Math.Max(1, (int)Math.Round(SessionsLiveFor.TotalSeconds));
        return seconds == 1 ? "1 second" : $"{seconds} seconds";
    }

    // The same mechanism the Upgrades page polls with, and deliberately not a second
    // one: every tick goes through InvokeAsync, which puts the read on the renderer's
    // synchronisation context, and that is what keeps it from colliding with a click
    // handler on this circuit's one AppDbContext. It gives up after a few minutes
    // because a browser tab left open overnight must not read a customer's tenant all
    // night - one request every thirty seconds against one tenant is fine, an unbounded
    // one is not.

    private System.Threading.Timer? _sessionsLive;
    private DateTime _sessionsLiveUntilUtc;

    private void StartSessionsLive()
    {
        StopSessionsLive();
        _sessionsLiveStopped = false;
        _sessionsLiveUntilUtc = DateTime.UtcNow.Add(SessionsLiveFor);
        _sessionsLive = new System.Threading.Timer(
            _ => _ = SessionsTickAsync(), null, SessionsLiveEvery, SessionsLiveEvery);
    }

    private void StopSessionsLive()
    {
        _sessionsLive?.Dispose();
        _sessionsLive = null;
    }

    private async Task SessionsTickAsync()
    {
        if (DateTime.UtcNow > _sessionsLiveUntilUtc)
        {
            StopSessionsLive();
            try
            {
                await InvokeAsync(() =>
                {
                    _sessionsLiveStopped = true;
                    StateHasChanged();
                });
            }
            catch (ObjectDisposedException)
            {
                // The circuit went while we were saying so. Nothing left to tell.
            }
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                // Never over the top of a read or a write of our own, and never while
                // the confirm is open: the row somebody is about to end must not move or
                // vanish under them between reading it and pressing the button.
                if (!_sessionsTabActive || _sessionsLoading || _settingSaving || _sessionsConfirmOpen) return;
                await LoadSessionsAsync(automatic: true);
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            StopSessionsLive();
        }
        catch (OperationCanceledException) when (_gone.IsCancellationRequested)
        {
            StopSessionsLive();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "The environment page stopped keeping the session list current for {EnvId}.", Id);
            StopSessionsLive();
        }
    }

    /// <summary>
    /// Ends one session on the customer's environment. The confirm names the person, what
    /// their session is running, the environment and whether it is a production one, and
    /// says plainly what it costs them - because it is the only write on this page whose
    /// consequence lands on somebody who isn't in the room.
    /// </summary>
    private async Task CancelSessionAsync(BcSession session)
    {
        if (_confirm is null) return;

        var who = string.IsNullOrWhiteSpace(session.UserId) ? "an unnamed user" : session.UserId;
        var doing = BcSessionDisplay.Doing(session);
        var running = string.Equals(doing, BcSessionDisplay.Idle, StringComparison.Ordinal)
            ? string.Empty
            : $" and is running {doing}";

        bool confirmed;
        _sessionsConfirmOpen = true;
        try
        {
            confirmed = await _confirm.OpenAsync(
                Row.IsProduction
                    ? $"End {who}'s session on {Row.EnvironmentName}, a production environment?"
                    : $"End {who}'s session on {Row.EnvironmentName}?",
                $"{who} has been signed in to {Row.EnvironmentName} ({Row.EnvironmentType}) in {Row.ProjectName} "
                + $"through the {BcSessionDisplay.ClientTypePhrase(session.ClientType)}{running}. "
                + "Business Central ends the session at once and anything they have not saved is lost. "
                + "They can sign in again straight away.",
                "End the session", confirmButtonClass: "btn--danger", confirmIcon: "user-x");
        }
        finally
        {
            _sessionsConfirmOpen = false;
        }
        if (!confirmed) return;

        // Deliberately not RunSettingWriteAsync: that re-reads the apps panel, which is
        // a call to the customer's tenant this tab has no use for. What has to be fresh
        // afterwards is the session list, and the history the line was written to.
        _settingSaving = true;
        _settingBusy = "session";
        _settingError = null;
        _settingDone = null;
        _settingDoneLink = null;
        StateHasChanged();
        try
        {
            await Write(() => Connection.CancelEnvironmentSessionAsync(Row.ProjectId, Id, session.SessionId));
            _settingDone = $"{who}'s session on {Row.EnvironmentName} was ended.";
            _activity = await Read(ct => UpgradeActions.ListEnvironmentActivityAsync(Row.ProjectId, Id, ct));
            await LoadBookedInstallsAsync();
        }
        catch (PlanValidationException ex)
        {
            _settingError = ex.Errors.Values.FirstOrDefault()
                ?? $"Couldn't end that session on {Row.EnvironmentName}. Try Refresh, then try again.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _settingError = ex.Message;
        }
        catch (OperationCanceledException) when (_gone.IsCancellationRequested)
        {
            throw; // the page was left mid-read; see DisposeAsync
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to end a session on environment {EnvId}.", Id);
            _settingError = $"Couldn't end that session on {Row.EnvironmentName}. Try Refresh, then try again.";
        }
        finally
        {
            _settingSaving = false;
            _settingBusy = null;
        }

        // Either way the list is re-read: a refusal usually means the session has gone.
        await LoadSessionsAsync();
    }

    // ── Leaving ─────────────────────────────────────────────────────────

    // Every call the page makes to a service goes through Read or Write, so that
    // leaving the page can cancel the reads under way and then wait for the last
    // call to finish before the circuit's one AppDbContext goes with the scope. A
    // read is cancelled outright: nobody is left to show it to. A write is let
    // finish - an update the user asked for must not be lost to a click on Back -
    // but the re-reads after it are reads, and stop like the rest. Before this, a
    // load could still be finishing after Dispose, and its next query would land on
    // a context being torn down under it; the page's tests met that as #924.
    private readonly CancellationTokenSource _gone = new();
    private int _asking;
    private TaskCompletionSource? _quiet;

    private async Task<T> Read<T>(Func<CancellationToken, Task<T>> read) => await AskAsync(read(_gone.Token));

    private async Task Write(Func<Task> write) => await AskAsync(Then(write()));

    private static async Task<bool> Then(Task task)
    {
        await task;
        return true;
    }

    private async Task<T> AskAsync<T>(Task<T> call)
    {
        Interlocked.Increment(ref _asking);
        try
        {
            return await call;
        }
        finally
        {
            if (Interlocked.Decrement(ref _asking) == 0) _quiet?.TrySetResult();
        }
    }

    public async ValueTask DisposeAsync()
    {
        StopSessionsLive();
        await _gone.CancelAsync();
        // Wait for whatever is still under way, including a call a finishing one
        // starts next: the flag is armed before each look at the count, so a call
        // that ends between the two is not missed. The source is left undisposed
        // on purpose - a continuation queued behind this one may still ask it for
        // the token, and a cancelled source with nothing registered holds nothing.
        while (true)
        {
            var quiet = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
            _quiet = quiet;
            if (Volatile.Read(ref _asking) == 0) break;
            await quiet.Task;
        }
    }

    /// <summary>The operations list names an app only by id; the panel, when it has been read, knows the name.</summary>
    private string? AppNameFor(Guid appId) =>
        _panel?.InstalledApps.FirstOrDefault(a => a.AppId == appId)?.Name
        ?? _panel?.AvailableUpdates.FirstOrDefault(u => u.AppId == appId)?.Name;

    private async Task LoadEnvironmentAsync()
    {
        _env = await Read(ct => Fleet.GetEnvironmentAsync(Id, ct));
        _cadence = BcAppUpdateCadence.Normalize(_env?.AppSourceAppsUpdateCadence) ?? BcAppUpdateCadence.Default;
    }

    private async Task LoadPanelAsync(bool forceRefresh = false)
    {
        _panelLoading = true;
        _panelError = null;
        StateHasChanged();
        try
        {
            _panel = await Read(ct => Connection.GetEnvironmentPanelAsync(Row.ProjectId, Id, forceRefresh, ct));
            _targetVersion = string.Empty;
            _m365 = await ReadM365Async();
        }
        catch (PlanValidationException ex)
        {
            _panel = null;
            _panelError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't read this environment.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            // Lost between the check and the read - the solution was made Private, or a
            // team changed, while the page was open.
            _panel = null;
            _canManage = false;
            _panelError = ex.Message;
        }
        catch (OperationCanceledException) when (_gone.IsCancellationRequested)
        {
            throw; // the page was left mid-read; see DisposeAsync
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to read the environment panel for {EnvId}.", Id);
            _panel = null;
            _panelError = _canManage
                ? "Something went wrong at our end while asking Business Central. Try Refresh in a moment."
                : "Something went wrong at our end while asking Business Central. Try again in a few minutes.";
        }
        finally
        {
            _panelLoading = false;
        }
    }

    /// <summary>
    /// One setting failing to read must not cost the page its three app lists, so this
    /// answers "unknown" - which the setting row already knows how to say.
    /// </summary>
    private async Task<bool?> ReadM365Async()
    {
        try
        {
            return await Read(ct => Connection.GetM365AccessAsync(Row.ProjectId, Id, ct));
        }
        catch (PlanValidationException)
        {
            return null;
        }
    }

    // ── Head ────────────────────────────────────────────────────────────

    private string StatusTone() => BcEnvironmentStatus.Classify(Row.Status) switch
    {
        BcEnvironmentReadiness.Ready => "success",
        BcEnvironmentReadiness.Busy => "warn",
        BcEnvironmentReadiness.Deleting or BcEnvironmentReadiness.Failed => "danger",
        _ => "muted",
    };

    private string SubtitleText()
    {
        var parts = new List<string> { $"Business Central environment in {Row.ProjectName}" };
        if (CurrentVersionShort() is { Length: > 0 } version && version != "—") parts.Add($"BC version {version}");
        if (!string.IsNullOrWhiteSpace(_env!.LocationName)) parts.Add(_env.LocationName!);
        return string.Join(" - ", parts);
    }

    /// <summary>The admin centre for the customer's tenant. Microsoft has no deep link to one environment.</summary>
    private string? AdminCentreUrl => Row.AdminCentreUrl;

    /// <summary>"28.2" from "28.2.41125.0": the part people say out loud.</summary>
    private string CurrentVersionShort()
    {
        if (string.IsNullOrWhiteSpace(Row.Version)) return "—";
        var parts = Row.Version.Split('.');
        return parts.Length >= 2 ? $"{parts[0]}.{parts[1]}" : Row.Version;
    }

    private string CountryText()
    {
        var code = _env!.CountryCode;
        if (string.IsNullOrWhiteSpace(code)) return "—";
        try
        {
            return $"{new RegionInfo(code).EnglishName} ({code.ToUpperInvariant()})";
        }
        catch (ArgumentException)
        {
            // Business Central has localisations that are not ISO regions ("W1").
            return code.ToUpperInvariant();
        }
    }

    private string FreshnessClass()
    {
        var classes = string.Empty;
        if (Row.EnvironmentFetchedAt is { } at && DateTime.UtcNow - at > StaleAfter) classes += "freshness--stale";
        if (_panelLoading) classes += " is-refreshing";
        return classes.Trim();
    }

    // ── Updates ─────────────────────────────────────────────────────────

    /// <summary>
    /// The update's time again in the customer's own zone, under the one in the
    /// organisation's zone: the two windows beside it are in the customer's zone, and
    /// whether they collide is the question the card answers. Left out when the two
    /// zones are the same, or the solution has none.
    /// </summary>
    private string? ScheduledCustomerText()
    {
        if (Row.NextUpdateDate is not { } at || ZoneCity(Row.TimeZone) is not { } city) return null;
        var customerZone = UpdateWindow.ResolveTimeZone(Row.TimeZone);
        if (customerZone.Id == Zone.Zone.Id) return null;
        var local = TimeZoneInfo.ConvertTimeFromUtc(ALDevToolbox.Services.Organizations.DisplayTimeZone.AsUtc(at), customerZone);
        return $"{city} time · {local:d MMM, HH:mm}";
    }

    /// <summary>
    /// Whose clock the delivery window is on. It is a time of day agreed with the
    /// customer and kept in the solution's zone, not converted into the organisation's
    /// display zone like the times elsewhere on the page.
    /// </summary>
    private string WindowZoneCaption() => ZoneCity(Row.TimeZone) is { } city
        ? $"Times are in the solution's own time zone, {city}."
        : "Times are in UTC, because the solution has no time zone set on its Business Central tab.";

    private string DeliveryWindowText() =>
        _env!.DeliveryWindowStart is { } s && _env.DeliveryWindowEnd is { } e
            ? $"{s:HH\\:mm}-{e:HH\\:mm} ({ZoneCity(Row.TimeZone) ?? "UTC"})"
            : "Any time";

    /// <summary>Microsoft's own window, in its own zone - not ours to set, so never worded like ours.</summary>
    private string BcWindowText()
    {
        if (_env!.BcUpdateWindowFetchedAt is null) return "Not read yet";
        if (_env.BcUpdateWindowStart is not { } s || _env.BcUpdateWindowEnd is not { } e) return "No window set";
        var label = ZoneCity(_env.BcUpdateWindowTimeZoneIana)
            ?? (string.IsNullOrWhiteSpace(Row.TimeZone) ? "UTC" : "this solution's time zone");
        return $"{s:HH\\:mm}-{e:HH\\:mm} ({label})";
    }

    /// <summary>The city half of an IANA id, which is what a consultant recognises.</summary>
    private static string? ZoneCity(string? iana)
    {
        if (string.IsNullOrWhiteSpace(iana)) return null;
        // A connection may hold the Windows name the admin centre shows ("Romance
        // Standard Time"), which has no city in it and does not fit the cell.
        if (!iana.Contains('/') && TimeZoneInfo.TryConvertWindowsIdToIanaId(iana, out var converted)) iana = converted;
        var city = iana.Contains('/') ? iana[(iana.LastIndexOf('/') + 1)..] : iana;
        return city.Replace('_', ' ');
    }

    private bool WindowsOverlap()
    {
        var env = _env!;
        if (env.BcUpdateWindowStart is null || env.BcUpdateWindowEnd is null) return false;
        if (env.DeliveryWindowStart is null || env.DeliveryWindowEnd is null) return false;

        return BcUpdateWindow.Overlaps(
            env.DeliveryWindowStart, env.DeliveryWindowEnd, UpdateWindow.ResolveTimeZone(Row.TimeZone),
            env.BcUpdateWindowStart, env.BcUpdateWindowEnd,
            BcUpdateWindow.ResolveDisplayZone(env.BcUpdateWindowTimeZoneIana, Row.TimeZone),
            DateTime.UtcNow);
    }

    /// <summary>Versions Microsoft has announced but not released, which the picker cannot offer.</summary>
    private string LaterVersions() => _panel is null
        ? string.Empty
        : string.Join(", ", _panel.EnvironmentUpdates
            .Where(u => !u.Available)
            .Select(u => u.ExpectedAvailability is { } when ? $"{u.TargetVersion}, expected {when}" : $"{u.TargetVersion}, not released yet"));

    private List<BcEnvironmentUpdate> Choosable() =>
        _panel?.EnvironmentUpdates.Where(u => u.Available && !u.Selected).ToList() ?? new();

    // ── Apps ────────────────────────────────────────────────────────────

    private List<BcInstalledApp> FilteredInstalled(BcEnvironmentPanel panel) => panel.InstalledApps
        .Where(a => Matches(_installedFilter, a.Name, a.Publisher))
        .OrderByDescending(a => a.IsPerTenant)
        .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<BcAvailableAppUpdate> FilteredUpdates(BcEnvironmentPanel panel) => panel.AvailableUpdates
        .Where(u => Matches(_updatesFilter, u.Name, u.Publisher))
        .Where(u => _updatesShow switch
        {
            "ready" => u.Requirements.Count == 0,
            "blocked" => u.Requirements.Count > 0,
            _ => true,
        })
        .OrderBy(u => u.Requirements.Count > 0)
        .ThenBy(u => u.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    /// <summary>The edge bar: green for an update that can go now, grey for one that waits on another.</summary>
    /// <summary>
    /// "Updating", "Scheduled", "Booked", or null when nothing is on its way for this app.
    /// Business Central's own word on the installed app comes first; then an update booked
    /// here, for the app or as a prerequisite that moves with one - the button stops
    /// working for every app it covers, since pressing it again would only book the same
    /// thing twice.
    /// </summary>
    private string? UpdateProgress(BcEnvironmentPanel panel, BcAvailableAppUpdate update)
    {
        var state = panel.InstalledApps.FirstOrDefault(a => a.AppId == update.AppId)?.State;
        if (string.Equals(state, "Updating", StringComparison.OrdinalIgnoreCase)) return "Updating";
        if (string.Equals(state, "UpdatePending", StringComparison.OrdinalIgnoreCase)) return "Scheduled";
        var booked = BookedInstalls.FirstOrDefault(b => b.Kind == UpgradeActionKind.UpdateApp
            && (b.AppId == update.AppId || (b.PrerequisiteAppIds?.Contains(update.AppId) ?? false)));
        return booked is null ? null : booked.SentAt is not null ? "Updating" : "Booked";
    }

    private static string UpdateRowClass(BcAvailableAppUpdate update) =>
        update.Requirements.Count == 0 ? "is-published" : "is-queued";

    private static int BlockedCount(BcEnvironmentPanel panel) => panel.AvailableUpdates.Count(u => u.Requirements.Count > 0);

    private static bool Matches(string filter, params string[] fields) =>
        string.IsNullOrWhiteSpace(filter)
        || fields.Any(f => f.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string SourceText(BcInstalledApp app) =>
        app.IsPerTenant ? "Per-tenant"
        : string.Equals(app.Publisher, "Microsoft", StringComparison.OrdinalIgnoreCase) ? "Microsoft"
        : "AppSource";

    /// <summary>When a scheduled install will actually run, in the words the deploy dialog uses.</summary>
    private static string ScheduleWhen(string? scheduleKind) =>
        BcDeploymentSchedule.Normalize(scheduleKind) is { } known
            ? DeliveryModeDisplay.Schedule(known)
            : "Waiting";

    /// <summary>
    /// Cancels one scheduled install, behind a confirm - Business Central drops the
    /// uploaded package, so the version has to be deployed again afterwards.
    /// </summary>
    private async Task CancelScheduledAsync(Guid appId, BcScheduledPteOperation op)
    {
        if (_confirm is null) return;
        var name = string.IsNullOrWhiteSpace(op.Name) ? "this extension" : op.Name;
        var confirmed = await _confirm.OpenAsync(
            "Cancel this scheduled install?",
            $"Business Central will drop the copy of {name} {op.TargetAppVersion} it is holding for {Row.EnvironmentName}. "
            + "To install it later you'll have to deploy it again.",
            "Cancel the install");
        if (!confirmed) return;

        await RunSettingWriteAsync("cancel-install",
            () => Connection.CancelScheduledInstallAsync(Row.ProjectId, Id, appId, op.TargetAppVersion, op.ScheduleKind ?? string.Empty),
            "Couldn't cancel the scheduled install.",
            () => $"The install of {name} {op.TargetAppVersion} was cancelled.");
    }

    private static string UpdateBusyKey(BcAvailableAppUpdate update) => $"app-{update.AppId}";

    /// <summary>
    /// Books one AppSource app to be updated to the version Business Central has waiting,
    /// at the slot the person picks - the same bookings an upload makes. The service
    /// re-reads the waiting list before it books, and again before it sends, so a row
    /// that went stale is refused with a sentence rather than acted on.
    /// </summary>
    private async Task UpdateAppAsync(BcAvailableAppUpdate update)
    {
        if (_updateConfirm is null) return;
        _updateAlongside = update.Requirements;
        await _updateWhen.ResetAsync(Zone, _env!.DeliveryWindowStart, _env.DeliveryWindowEnd, Row.TimeZone,
            _env.BcUpdateWindowStart, _env.BcUpdateWindowEnd, _env.BcUpdateWindowTimeZoneIana);
        var others = update.Requirements.Count;
        var installed = _panel?.InstalledApps.FirstOrDefault(a => a.AppId == update.AppId)?.Version;
        var from = string.IsNullOrWhiteSpace(installed) ? "" : $" from {installed}";
        var what = others == 0 ? update.Name : $"{update.Name} and {AppCount(others)} it waits for";

        var confirmed = await _updateConfirm.OpenAsync(
            Row.IsProduction
                ? $"Update {what} on {Row.EnvironmentName}, a production environment?"
                : $"Update {what} on {Row.EnvironmentName}?",
            $"{update.Name} by {update.Publisher} will go{from} to {update.Version} in {Row.ProjectName}'s Business Central."
            + (others == 0 ? " " : $" It waits for {AppCount(others)}, so Business Central will install or update those as well, each to the newest version this environment supports. ")
            + "Once installed, none of it can be rolled back from here.",
            // "Book": every timing is a booking, "now" included, and the notice says when.
            others == 0 ? "Book the update" : $"Book all {others + 1} updates", "btn--danger");
        if (!confirmed) return;

        var timing = _updateWhen.Timing;
        var at = _updateWhen.At;
        var customerZone = _updateWhen.CustomerTimeZone;
        var alongside = update.Requirements.Where(r => r.AppId is not null).Select(r => r.AppId!.Value).ToList();
        UploadAppOutcome? outcome = null;
        await RunSettingWriteAsync(UpdateBusyKey(update),
            async () => outcome = await Connection.BookAppUpdateAsync(Row.ProjectId, Id, update.AppId, update.Version, timing, at, alongside),
            $"Couldn't book the update of {update.Name}. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.",
            () => InstallTimingPicker.BookedWhenPhrase(outcome!, customerZone, Zone) is { } when
                ? $"{what} will be updated on {Row.EnvironmentName} {when}. Until then you can cancel or start it early under Scheduled installs."
                : $"{what} will start updating on {Row.EnvironmentName} shortly. Follow it under Scheduled installs.");
    }

    private static string AppCount(int count) => count == 1 ? "1 other app" : $"{count} other apps";

    // ── Uploading an app ────────────────────────────────────────────────

    private async Task UploadAppAsync()
    {
        if (_uploadDialog is null) return;
        var upload = await _uploadDialog.OpenAsync(Row.ProjectName, Row.EnvironmentName, Row.IsProduction,
            _env!.DeliveryWindowStart, _env.DeliveryWindowEnd, Row.TimeZone,
            _env.BcUpdateWindowStart, _env.BcUpdateWindowEnd, _env.BcUpdateWindowTimeZoneIana);
        if (upload is null) return;

        UploadAppOutcome? outcome = null;
        var packages = upload.Files.Select(f => new UploadPackage(f.Bytes, f.FileName)).ToList();
        await RunSettingWriteAsync("upload",
            async () => outcome = await Connection.InstallUploadedAppsAsync(Row.ProjectId, Id, packages, upload.Timing, upload.At),
            "Couldn't book the upload. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.",
            () => UploadAppDialog.DoneMessage(upload, outcome!, Row.EnvironmentName, Zone));
    }

    /// <summary>
    /// Uploads and AppSource updates booked here and still waiting for their slot - shown
    /// among the scheduled installs, because to the person asking "what is going to install here?" they are
    /// one list, whichever side is holding the file.
    /// </summary>
    private List<UpgradeActionRow> BookedInstalls => _bookedInstalls ?? new();

    /// <summary>
    /// The installs still booked here, read on their own rather than out of the history:
    /// the history is capped, and a booking must not drop off the Scheduled installs
    /// because the environment has been busy.
    /// </summary>
    private List<UpgradeActionRow>? _bookedInstalls;

    private async Task LoadBookedInstallsAsync() =>
        _bookedInstalls = await Read(ct => UpgradeActions.ListBookedInstallsAsync(Row.ProjectId, Id, ct));

    /// <summary>"2 of 3" for a row of a multi-app upload, so the list shows the order they go in; null for a single one.</summary>
    private string? BatchPlace(UpgradeActionRow booked)
    {
        if (booked.BatchId is not { } batch || booked.BatchOrder is not { } order) return null;
        // The batch may have settled rows already, which the pending list no longer
        // holds; the history has them for as long as it reaches.
        var size = Math.Max(BookedInstalls.Count(a => a.BatchId == batch), _activity?.Count(a => a.BatchId == batch) ?? 0);
        return size > 1 ? $"{order + 1} of {size}" : null;
    }

    /// <summary>When a booked row goes: its slot, "starting shortly" once that has come, or "installing now" while the worker has it.</summary>
    private string BookedWhen(UpgradeActionRow booked) =>
        booked.SentAt is not null ? (booked.Kind == UpgradeActionKind.UpdateApp ? "Updating now" : "Installing now")
        : booked.ExecuteAfter <= DateTime.UtcNow ? "Starting shortly"
        : $"Booked for {BookedSlotText(booked.ExecuteAfter)}";

    /// <summary>A booked slot in the page's own zone - the one it was picked in - so it reads back as picked.</summary>
    private string BookedSlotText(DateTime utc) => InstallTimingPicker.SlotText(Zone, utc);

    /// <summary>What a booked install is called on this page: an upload's file, or the app an AppSource update moves.</summary>
    private static string BookedName(UpgradeActionRow booked) =>
        booked.PackageFileName ?? booked.AppName ?? "the app";

    /// <summary>Sends a booked install straight away, behind a confirm: from here it interrupts whoever is working.</summary>
    private async Task InstallBookedNowAsync(UpgradeActionRow booked)
    {
        if (_confirm is null) return;
        var name = BookedName(booked);
        var batch = BatchPlace(booked) is not null;
        var update = booked.Kind == UpgradeActionKind.UpdateApp;
        var confirmed = await _confirm.OpenAsync(
            update ? $"Update {name} now?" : batch ? $"Install {name} and the apps booked with it now?" : $"Install {name} now?",
            (batch
                ? $"They were booked for {BookedSlotText(booked.ExecuteAfter)} and install one after another. Installing them now may interrupt anyone working in {Row.EnvironmentName}."
                : update
                    ? $"It was booked for {BookedSlotText(booked.ExecuteAfter)}. Updating it now may interrupt anyone working in {Row.EnvironmentName}."
                    : $"It was booked for {BookedSlotText(booked.ExecuteAfter)}. Installing it now may interrupt anyone working in {Row.EnvironmentName}."),
            update ? "Update now" : "Install now");
        if (!confirmed) return;

        await RunSettingWriteAsync("install-now",
            () => UpgradeActions.RunBookedInstallNowAsync(booked.Id),
            update ? $"Couldn't start the update of {name}." : $"Couldn't start the install of {name}.",
            () => update
                ? $"{name} will start updating on {Row.EnvironmentName} shortly."
                : batch
                ? $"{name} and the apps booked with it will start installing on {Row.EnvironmentName} within a minute."
                : $"{name} will start installing on {Row.EnvironmentName} within a minute.");
    }

    /// <summary>
    /// Calls off a booked install. An upload's stored file goes with the booking, so the
    /// confirm says to upload it again; an AppSource update can simply be booked again.
    /// </summary>
    private async Task CancelBookedInstallAsync(UpgradeActionRow booked)
    {
        if (_confirm is null) return;
        var name = BookedName(booked);
        var others = BatchPlace(booked) is null ? "" : " The other apps booked with it still install; any that needs it will be refused by Business Central.";
        var update = booked.Kind == UpgradeActionKind.UpdateApp;
        var confirmed = await _confirm.OpenAsync(
            update ? "Call off this update?" : "Call off this install?",
            update
                ? $"{name} won't be updated to {booked.TargetVersion} on {Row.EnvironmentName}. To update it later, use Update under Available updates again."
                : $"{name} won't be installed on {Row.EnvironmentName}. To install it later, upload it again.{others}",
            update ? "Call off the update" : "Call off the install");
        if (!confirmed) return;

        await RunSettingWriteAsync("cancel-booked",
            () => UpgradeActions.CancelUpgradeActionAsync(booked.Id),
            "Couldn't cancel the booked install.",
            () => booked.Kind == UpgradeActionKind.UpdateApp ? $"The update of {name} was cancelled." : $"The install of {name} was cancelled.");
    }

    // ── Copying the environment ─────────────────────────────────────────

    /// <summary>
    /// Makes a new environment from this one. The dialog collects the name and the type
    /// and carries the warnings; the write is refused by the service for anyone who does
    /// not manage the solution, whatever this page offered.
    /// </summary>
    private async Task CopyAsync()
    {
        if (_copyDialog is null) return;
        var copy = await _copyDialog.OpenAsync(
            Row.ProjectName, Row.EnvironmentName, Row.IsProduction, Row.TenantStorageUse);
        if (copy is null) return;

        var made = await RunSettingWriteAsync("copy",
            () => Connection.CopyEnvironmentAsync(Row.ProjectId, Id, copy.Name, copy.Type),
            $"Couldn't copy {Row.EnvironmentName}. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.",
            () => CopyEnvironmentDialog.DoneMessage(copy, Row.EnvironmentName));
        if (made)
        {
            // The copy outlives this page load, so the notice says where to watch it.
            _settingDoneLink = (Row.Href("operations"), "Open the Operations tab");
        }
    }

    // ── Delivery window ─────────────────────────────────────────────────

    private bool _windowEditing;
    private bool _windowSaving;
    private string? _windowError;
    private TimeOnly? _winStart;
    private TimeOnly? _winEnd;

    private void OpenWindowEditor()
    {
        _windowEditing = true;
        _windowError = null;
        _winStart = _env!.DeliveryWindowStart;
        _winEnd = _env.DeliveryWindowEnd;
    }

    private async Task SaveWindowAsync()
    {
        if (_winStart is not { } start || _winEnd is not { } end)
        {
            _windowError = "Enter both a start and an end time, or use Clear for 'any time'.";
            return;
        }
        await PersistWindowAsync(start, end);
    }

    private async Task PersistWindowAsync(TimeOnly? start, TimeOnly? end)
    {
        _windowError = null;
        _windowSaving = true;
        try
        {
            await Write(() => Connection.SetUpdateWindowAsync(Row.ProjectId, Id, start, end));
            _windowEditing = false;
            await LoadEnvironmentAsync();
        }
        catch (PlanValidationException ex)
        {
            _windowError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't save the delivery window.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _windowError = ex.Message;
        }
        catch (OperationCanceledException) when (_gone.IsCancellationRequested)
        {
            throw; // the page was left mid-read; see DisposeAsync
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save the delivery window for environment {EnvId}.", Id);
            _windowError = "Couldn't save the delivery window. Try again in a moment.";
        }
        finally
        {
            _windowSaving = false;
        }
    }

    // ── Settings ────────────────────────────────────────────────────────

    /// <summary>
    /// The select saves on change, behind a confirm, as the sheet has it. Declining puts
    /// the select back: the control must never show a cadence the tenant does not have.
    /// </summary>
    private async Task OnCadenceChangedAsync(ChangeEventArgs args)
    {
        var previous = _cadence;
        var chosen = args.Value?.ToString() ?? previous;
        if (_confirm is null || chosen == previous) return;

        _cadence = chosen;
        var confirmed = await _confirm.OpenAsync(
            "Change the AppSource update cadence?",
            BcAppUpdateCadence.ConfirmSentence(chosen, Row.EnvironmentName),
            "Change cadence", "btn--primary");
        if (!confirmed)
        {
            _cadence = previous;
            return;
        }

        var saved = await RunSettingWriteAsync("cadence",
            () => Connection.SetAppUpdateCadenceAsync(Row.ProjectId, Id, chosen),
            $"Couldn't change the update cadence on {Row.EnvironmentName}. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.",
            () => $"Business Central now updates AppSource apps on {Row.EnvironmentName}: {BcAppUpdateCadence.Display(chosen)}.");
        if (!saved) _cadence = previous;
    }

    /// <summary>Turns Microsoft 365 licence sign-in on or off - it changes who can get in.</summary>
    private async Task SaveM365Async(bool enable)
    {
        if (_confirm is null) return;
        var confirmed = await _confirm.OpenAsync(
            enable ? "Allow Microsoft 365 sign-in?" : "Stop allowing Microsoft 365 sign-in?",
            enable
                ? $"Anyone in the customer's organisation with a Microsoft 365 licence will be able to sign in to {Row.EnvironmentName} and read data there."
                : $"People who hold only a Microsoft 365 licence will lose access to {Row.EnvironmentName}. Anyone with a Business Central licence keeps theirs.",
            enable ? "Allow it" : "Stop allowing it",
            enable ? "btn--primary" : "btn--danger");
        if (!confirmed)
        {
            // Redraw, so the switch goes back to what the tenant actually has.
            StateHasChanged();
            return;
        }

        await RunSettingWriteAsync("m365",
            () => Connection.SetM365AccessAsync(Row.ProjectId, Id, enable),
            $"Couldn't change Microsoft 365 licence access on {Row.EnvironmentName}. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.",
            () => enable
                ? $"Business Central now allows Microsoft 365 licence sign-in on {Row.EnvironmentName}."
                : $"Business Central no longer allows Microsoft 365 licence sign-in on {Row.EnvironmentName}.");
    }

    /// <summary>
    /// The alert's opening line. Written as two whole sentences rather than one with a
    /// date glued on, because "has been deleted on 20 Sep" is not a sentence - and this
    /// is the boldest line on the page.
    /// </summary>
    private RenderFragment DeletedSentence => Row.SoftDeletedOn is { } deleted
        ? @<text>@Row.EnvironmentName was deleted on <Timestamp Value="@deleted" Format="dd MMM yyyy" />.</text>
        : @<text>@Row.EnvironmentName has been deleted.</text>;

    /// <summary>
    /// How long is left, in the same words the Environments list uses under its date. A
    /// date already past is not dressed up as urgency - the mirror may simply be older
    /// than the deadline it is repeating.
    /// </summary>
    private static string RecoverWindowText(DateTime goneForGood) =>
        (goneForGood.Date - DateTime.UtcNow.Date).Days switch
        {
            < 0 => "that date has passed",
            0 => "today is the last day to bring it back",
            1 => "1 day left to bring it back",
            var days => $"{days} days left to bring it back",
        };

    /// <summary>
    /// Brings the environment back while Business Central is still keeping it. Confirmed
    /// by name, and louder when it is a production environment: recovering one puts a
    /// customer's live data back in front of their users.
    /// </summary>
    private async Task RecoverAsync()
    {
        if (_confirm is null) return;

        // The same one verb the Environments list uses, and never "restore" - in Business
        // Central that is the point-in-time restore of a live environment.
        var confirmed = await _confirm.OpenAsync(
            Row.IsProduction
                ? $"Recover {Row.EnvironmentName}, a production environment?"
                : $"Recover {Row.EnvironmentName}?",
            $"{Row.EnvironmentName} ({Row.EnvironmentType}) belongs to {Row.ProjectName}. "
            + "Business Central brings it back with the data it held when it was deleted, "
            + "and people will be able to sign in to it again. It takes a few minutes.",
            "Recover it", confirmButtonClass: "btn--primary", confirmIcon: "archive-restore");
        if (!confirmed) return;

        await RunSettingWriteAsync("recover",
            () => Connection.RecoverEnvironmentAsync(Row.ProjectId, Id),
            $"Couldn't bring {Row.EnvironmentName} back. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.",
            () => $"Business Central is bringing {Row.EnvironmentName} back. It can take a few minutes; use Refresh to see where it has got to.");
    }

    /// <summary>
    /// Reschedules the customer's platform upgrade. The most consequential control on
    /// the page, so the confirm names the environment, says out loud when it is a
    /// production one, and states which version it is moving from and to.
    /// </summary>
    private async Task SaveTargetVersionAsync()
    {
        if (_confirm is null || _panel is null || string.IsNullOrEmpty(_targetVersion)) return;

        var version = _targetVersion;
        var current = _panel.EnvironmentUpdates.FirstOrDefault(u => u.Selected)?.TargetVersion;
        var from = current is null || string.Equals(current, version, StringComparison.OrdinalIgnoreCase)
            ? ""
            : $" instead of {current}";
        var chosenRow = _panel.EnvironmentUpdates.FirstOrDefault(u =>
            string.Equals(u.TargetVersion, version, StringComparison.OrdinalIgnoreCase));
        var when = chosenRow?.SelectedDateTime is { } at
            ? $"Microsoft runs the upgrade on {Zone.Format(at.UtcDateTime, "yyyy-MM-dd HH:mm")}"
            : "Microsoft runs the upgrade in this environment's update window";

        var confirmed = await _confirm.OpenAsync(
            Row.IsProduction
                ? $"Reschedule the update on {Row.EnvironmentName}, a production environment?"
                : $"Reschedule the update on {Row.EnvironmentName}?",
            $"{Row.EnvironmentName} ({Row.EnvironmentType}) will update to Business Central {version}{from}. "
            + $"{when}, and the environment is unavailable while it does.",
            $"Schedule {version}");
        if (!confirmed) return;

        await RunSettingWriteAsync("version",
            () => Connection.SelectTargetVersionAsync(Row.ProjectId, Id, version),
            $"Couldn't schedule the update on {Row.EnvironmentName}. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.",
            () => $"Business Central now shows {version} as the next update for {Row.EnvironmentName}.");
    }

    /// <summary>
    /// Runs one write with a loading state, then re-reads everything so the page shows
    /// what the tenant now says rather than what we asked for. True when it went through.
    /// </summary>
    private async Task<bool> RunSettingWriteAsync(
        string busyKey, Func<Task> write, string failureMessage, Func<string> successMessage)
    {
        _settingSaving = true;
        _settingBusy = busyKey;
        _settingError = null;
        _settingDone = null;
        _settingDoneLink = null;
        StateHasChanged();
        try
        {
            await Write(write);
            _operations = null; // Business Central has a new one to show
            await LoadEnvironmentAsync();
            await LoadPanelAsync();
            _activity = await Read(ct => UpgradeActions.ListEnvironmentActivityAsync(Row.ProjectId, Id, ct));
            await LoadBookedInstallsAsync();
            _settingDone = successMessage();
            return true;
        }
        catch (PlanValidationException ex)
        {
            // The service's own message is more specific when it has one (an unavailable
            // version, a rejected value); the generic line names the setting and the fix.
            _settingError = ex.Errors.Values.FirstOrDefault() ?? failureMessage;
        }
        catch (ProjectAccessDeniedException ex)
        {
            _settingError = ex.Message;
        }
        catch (OperationCanceledException) when (_gone.IsCancellationRequested)
        {
            throw; // the page was left mid-read; see DisposeAsync
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "An environment settings write failed for {EnvId}.", Id);
            _settingError = failureMessage;
        }
        finally
        {
            _settingSaving = false;
            _settingBusy = null;
        }
        return false;
    }

    /// <summary>
    /// Cancels an update booked for a later slot. A cancel that loses the race with the
    /// update starting comes back as a plain refusal; either way the history is re-read.
    /// </summary>
    private async Task CancelUpgradeActionAsync(int actionId)
    {
        var entry = _activity?.FirstOrDefault(a => a.Id == actionId);
        if (entry is not null && UpgradeActionService.IsAppInstall(entry.Kind))
        {
            // The same confirm the Scheduled installs card gives: an upload's stored file
            // goes with the booking.
            await CancelBookedInstallAsync(entry);
            return;
        }
        try
        {
            await Write(() => UpgradeActions.CancelUpgradeActionAsync(actionId));
            _settingError = null;
            _settingDone = "The booked update was cancelled.";
        }
        catch (PlanValidationException ex)
        {
            _settingError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't cancel that.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _settingError = ex.Message;
        }

        _activity = await Read(ct => UpgradeActions.ListEnvironmentActivityAsync(Row.ProjectId, Id, ct));
        await LoadBookedInstallsAsync();
    }
}
