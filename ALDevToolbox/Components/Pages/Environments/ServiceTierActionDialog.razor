@*
    Confirm a restart, stop or start of an on-premises service tier, or a restart of every
    tier on its database (#1371). Named user: a consultant whose customer has rung to say
    Business Central is stuck, who wants it working again without remoting into the
    customer's server, and who knows Business Central but nothing about the gateway.

    What the person is about to cost other people is the point of the dialog, so it leads
    with how many are signed in and that they will be signed out; on Production they tick
    that they understand, as they do before deploying to Production. Anything that would
    refuse the action is said here and holds the button.

    The dialog only confirms. The caller sends it (OnPremisesTierActionService.RequestAsync),
    which checks everything again. See .design/on-prem-gateway.md, "Service tier actions".
*@
@using ALDevToolbox.Services.Gateways
@inject OnPremisesTierActionService TierActions
@inject ILogger<ServiceTierActionDialog> Log
@inject TimeProvider Clock

<ConfirmDialog @ref="_confirm" Wide="true" HeadIcon="@HeadIcon"
               ConfirmDisabled="@(_plan is null || _plan.Refusal is not null || (NeedsAck && !_ack) || (_booking && WhenError is not null))">
    <div class="tier-dialog">
    @if (_booking && _groupTierCount > 1)
    {
        <div class="field">
            <label class="field__label" for="tier-booking-what">What to restart</label>
            <select id="tier-booking-what" class="select" value="@_action" @onchange="e => ChooseAsync(Enum.Parse<ServiceTierAction>((string)e.Value!))">
                <option value="@ServiceTierAction.Restart">Only @_tierName</option>
                <option value="@ServiceTierAction.RestartAll">@RestartAllLabel(_groupTierCount)</option>
            </select>
        </div>
    }
    @if (_booking && _plan is { Refusal: null })
    {
        <div class="field">
            <label class="field__label" for="tier-booking-when">When</label>
            <input id="tier-booking-when" type="datetime-local" class="input" required
                   min="@LocalText(Clock.GetUtcNow().UtcDateTime + OnPremisesTierActionService.MinBookingAhead)"
                   max="@LocalText(Clock.GetUtcNow().UtcDateTime + OnPremisesTierActionService.MaxBookingAhead)"
                   @bind="_runAtLocal" @bind:event="oninput" />
            @if (WhenError is { } whenError)
            {
                <FieldError Message="@whenError" />
            }
            else
            {
                <span class="field__hint">@WhenHint</span>
            }
        </div>
    }
    @if (_planError is { } planError)
    {
        <Alert Tone="AlertTone.Danger"><span>@planError</span></Alert>
    }
    else if (_plan is null)
    {
        <LoadingBlock Text="Reading the service tier..." />
    }
    else if (_plan.Refusal is { } refusal)
    {
        <Alert Tone="AlertTone.Danger"><span>@refusal</span></Alert>
    }
    else
    {
        <p class="tier-dialog__lead">@Lead(_plan)</p>
        <ul class="tier-dialog__tiers">
            @foreach (var tier in _plan.Tiers)
            {
                <li>@tier</li>
            }
            @foreach (var left in _plan.LeftAlone)
            {
                <li class="tier-dialog__left-out">@left — keeps running</li>
            }
        </ul>

        @if (_booking)
        {
            <Alert Tone="AlertTone.Warn" Role="" Block="true" Class="tier-dialog__alert">
                <div class="tier-dialog__warn">
                    <p>@AfterSentence(_plan)</p>
                    <p>You'll be told if it doesn't go through.</p>
                </div>
            </Alert>
        }
        else if (_plan.SignsPeopleOut)
        {
            <Alert Tone="AlertTone.Warn" Role="" Block="true" Class="tier-dialog__alert">
                <div class="tier-dialog__warn">
                    <p><b>@SessionsHeadline(_plan)</b> @SessionsDetail(_plan)</p>
                    <p>@AfterSentence(_plan)</p>
                </div>
            </Alert>
        }

        @if (NeedsAck)
        {
            <label class="check check--ack @(_ack ? "is-checked" : "")">
                <input type="checkbox" checked="@_ack" @onchange="e => _ack = (bool)(e.Value ?? false)" />
                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                <span>@AckSentence(_plan)</span>
            </label>
        }
    }
    </div>
</ConfirmDialog>

@code {
    private ConfirmDialog? _confirm;
    private ServiceTierActionPlan? _plan;
    private string? _planError;
    private bool _ack;
    private ServiceTierAction _action;

    // Booking a restart for later (#1788).
    private bool _booking;
    private int _environmentId;
    private string _tierName = string.Empty;
    private int _groupTierCount;
    private DateTime _runAtLocal;
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;
    private string? _changeHours;

    private string WhenHint => _zone == TimeZoneInfo.Utc
        // An older gateway does not say its time zone, so its hours cannot be put in UTC here.
        ? (_changeHours is { } utcHours ? $"The customer allows changes from {utcHours.Replace("-", " to ")} on their server's clock, which may not be UTC. " : "") + "Time in UTC."
        : (_changeHours is { } hours ? $"The customer allows changes from {hours.Replace("-", " to ")}. " : "") + $"Time on the customer's server ({_zone.StandardName}).";

    /// <summary>The server's rules for the time, mirrored so the person sees them by the field; the server checks them again.</summary>
    private string? WhenError
    {
        get
        {
            if (_plan is null) return null;
            var utc = ToUtc(_runAtLocal);
            var now = Clock.GetUtcNow().UtcDateTime;
            if (utc < now + OnPremisesTierActionService.MinBookingAhead) return "Pick a time at least a few minutes from now. To restart now, use Restart.";
            if (utc > now + OnPremisesTierActionService.MaxBookingAhead) return "Pick a time within the next 30 days.";
            if (_zone != TimeZoneInfo.Utc && OnPremisesTierActionService.ChangeHours.Parse(_changeHours) is { } hours
                && !hours.Contains(TimeOnly.FromDateTime(_runAtLocal)))
            {
                return $"The customer allows changes only from {hours.StartText} to {hours.EndText}. Pick a time in that window.";
            }
            return null;
        }
    }

    private string LocalText(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(utc, _zone).ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private DateTime ToUtc(DateTime local)
    {
        var wall = DateTime.SpecifyKind(local, DateTimeKind.Unspecified);
        // A wall time that does not exist (the hour the clocks skip): an hour later does.
        return _zone.IsInvalidTime(wall) ? TimeZoneInfo.ConvertTimeToUtc(wall.AddHours(1), _zone) : TimeZoneInfo.ConvertTimeToUtc(wall, _zone);
    }

    /// <summary>
    /// Asks the person when to restart the environment's service tier (or every tier on its
    /// database), and to confirm. The time, UTC, and what to restart; null when they cancelled.
    /// The caller books it (OnPremisesTierActionService.BookAsync), which checks it all again.
    /// </summary>
    public async Task<(ServiceTierAction Action, DateTime RunAtUtc)?> OpenBookingAsync(int environmentId, string tierName, int groupTierCount)
    {
        if (_confirm is null) return null;
        _booking = true;
        _environmentId = environmentId;
        _tierName = tierName;
        _groupTierCount = groupTierCount;
        _action = ServiceTierAction.Restart;
        _plan = null;
        _planError = null;
        _ack = false;
        StateHasChanged();
        var opening = _confirm.OpenAsync($"Restart {tierName} later", "", "Book restart", "");
        await LoadBookingPlanAsync(setTime: true);
        var confirmed = await opening;
        _booking = false;
        if (!confirmed) return null;
        var utc = ToUtc(_runAtLocal);
        return (_action, utc);
    }

    private async Task ChooseAsync(ServiceTierAction action)
    {
        _action = action;
        _ack = false;
        await LoadBookingPlanAsync(setTime: false);
    }

    private async Task LoadBookingPlanAsync(bool setTime)
    {
        _plan = null;
        _planError = null;
        StateHasChanged();
        try
        {
            var booking = await TierActions.GetBookingPlanAsync(_environmentId, _action);
            if (booking is null)
            {
                _planError = "This environment is no longer linked to a service tier.";
            }
            else
            {
                _plan = booking.Plan;
                _changeHours = booking.ChangeHours;
                _zone = booking.TimeZone is { } id ? ALDevToolbox.Domain.ValueObjects.ObjectExplorer.UpdateWindow.ResolveTimeZone(id) : TimeZoneInfo.Utc;
                if (setTime) _runAtLocal = TimeZoneInfo.ConvertTimeFromUtc(booking.DefaultRunAt, _zone);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogWarning(ex, "Reading the booking plan for environment {EnvironmentId} failed.", _environmentId);
            _planError = "Couldn't read the service tier. Close this and try again.";
        }
        StateHasChanged();
    }

    /// <summary>Production asks again before anyone is signed out, as a Production deployment does.</summary>
    private bool NeedsAck => _plan is { IsProduction: true, SignsPeopleOut: true, Refusal: null };

    private string HeadIcon => _action == ServiceTierAction.Start ? "circle-play" : _action == ServiceTierAction.Stop ? "circle-stop" : "rotate-cw";

    /// <summary>
    /// Asks the person to confirm <paramref name="action"/> on <paramref name="environmentId"/>,
    /// after saying what it will do. True when they confirmed.
    /// </summary>
    public async Task<bool> OpenAsync(int environmentId, string environmentName, string tierName, int groupTierCount, ServiceTierAction action)
    {
        if (_confirm is null) return false;
        _booking = false;
        _action = action;
        _plan = null;
        _planError = null;
        _ack = false;
        StateHasChanged();

        var (title, message, label, css) = action switch
        {
            ServiceTierAction.RestartAll => (
                $"{RestartAllLabel(groupTierCount)}?",
                "Use this when restarting one service tier did not help.",
                RestartAllLabel(groupTierCount), "btn--danger"),
            ServiceTierAction.Stop => (
                $"Stop {tierName}?",
                "",
                "Stop service tier", "btn--danger"),
            ServiceTierAction.Start => (
                $"Start {tierName}?",
                "",
                "Start service tier", ""),
            _ => (
                $"Restart {tierName}?",
                "",
                "Restart service tier", "btn--danger"),
        };
        var opening = _confirm.OpenAsync(title, message, label, css);
        try
        {
            _plan = await TierActions.GetPlanAsync(environmentId, action);
            if (_plan is null) _planError = "This environment is no longer linked to a service tier.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogWarning(ex, "Reading the {Action} plan for environment {EnvironmentId} failed.", action, environmentId);
            _planError = "Couldn't read the service tier. Close this and try again.";
        }
        StateHasChanged();
        return await opening;
    }

    private static string Lead(ServiceTierActionPlan plan) => plan.Action switch
    {
        ServiceTierAction.RestartAll => plan.OneByOne
            ? "These service tiers restart one at a time, so one of them is always running:"
            : "These service tiers all stop, then all start again:",
        ServiceTierAction.Stop => "This service tier stops:",
        ServiceTierAction.Start => "This service tier starts:",
        _ => "This service tier stops and starts again:",
    };

    /// <summary>The label, title and confirm button for restarting the whole group, the same everywhere.</summary>
    public static string RestartAllLabel(int tiers) =>
        tiers == 2 ? "Restart both service tiers" : $"Restart all {tiers} service tiers";

    /// <summary>
    /// "14 sessions are open on this service tier (23 across both service tiers on this
    /// database)." A tier without a count makes the number a floor, and it says so.
    /// </summary>
    private static string SessionsHeadline(ServiceTierActionPlan plan)
    {
        var s = plan.Sessions;
        var where = plan.Tiers.Count == 1 ? "this service tier" : "these service tiers";
        if (s.OnTiers is not { } open) return "How many sessions are open is not known yet.";
        var count = open == 1 ? "1 session is" : $"{open} sessions are";
        var sentence = s.Uncounted > 0 ? $"At least {open} {(open == 1 ? "session is" : "sessions are")} open on {where}"
            : open == 0 ? $"No sessions were open on {where} when the gateway last counted"
            : $"{count} open on {where}";
        if (s.DatabaseTiers > plan.Tiers.Count && s.OnDatabase is { } onDatabase)
        {
            var all = s.DatabaseTiers == 2 ? "both service tiers" : $"all {s.DatabaseTiers} service tiers";
            sentence += $" ({onDatabase} across {all} on this database)";
        }
        if (s.Uncounted > 0)
        {
            sentence += s.Uncounted == 1 ? "; one service tier did not report a count" : $"; {s.Uncounted} service tiers did not report a count";
        }
        return sentence + ".";
    }

    private string SessionsDetail(ServiceTierActionPlan plan) => plan.Sessions.CountedAt is { } counted
        ? $"Counted {Ago(counted)}."
        : "";

    private static string AfterSentence(ServiceTierActionPlan plan) => plan.Action switch
    {
        ServiceTierAction.Stop => "Everyone signed in to it is signed out and loses unsaved work. Nobody can sign in through it until someone starts it again.",
        ServiceTierAction.RestartAll when plan.OneByOne => "Everyone signed in to a tier is signed out and loses unsaved work when that tier restarts.",
        ServiceTierAction.RestartAll => "Everyone signed in is signed out and loses unsaved work. Business Central is unavailable for the few minutes the restart takes.",
        _ => "Everyone signed in to it is signed out and loses unsaved work. It is unavailable for the minute or two the restart takes.",
    };

    private static string AckSentence(ServiceTierActionPlan plan)
    {
        var verb = plan.Action == ServiceTierAction.Stop ? "stops" : "restarts";
        var them = plan.Tiers.Count == 1 ? "it" : "them";
        var tiers = plan.Tiers.Count == 1 ? plan.Tiers[0] : $"the {plan.Tiers.Count} service tiers listed";
        // Production because of where the people are, said the way that is true: this
        // environment, another environment on the same tiers, or the customer's own word.
        if (plan.OtherProduction is { Count: > 0 } others)
        {
            return $"I understand this {verb} {tiers}, which also {(plan.Tiers.Count == 1 ? "serves" : "serve")} live Production ({string.Join(", ", others)}), and signs everyone out of {them}.";
        }
        if (!plan.IsOwnProduction)
        {
            return $"I understand this {verb} {tiers}, which the customer's IT runs as production, and signs everyone out of {them}.";
        }
        var where = string.Equals(plan.EnvironmentName, "Production", StringComparison.OrdinalIgnoreCase)
            ? $"{plan.SolutionName}'s live Production environment"
            : $"{plan.EnvironmentName}, {plan.SolutionName}'s live Production environment";
        return $"I understand this {verb} {where} on {tiers} and signs everyone out of {them}.";
    }

    private string Ago(DateTime utc)
    {
        var span = Clock.GetUtcNow().UtcDateTime - utc;
        if (span < TimeSpan.FromMinutes(1)) return "less than a minute ago";
        if (span < TimeSpan.FromHours(1)) return span.TotalMinutes < 2 ? "1 minute ago" : $"{(int)span.TotalMinutes} minutes ago";
        return span.TotalHours < 2 ? "1 hour ago" : $"{(int)span.TotalHours} hours ago";
    }
}
