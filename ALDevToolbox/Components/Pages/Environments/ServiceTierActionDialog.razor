@*
    Confirm a restart, stop or start of an on-premises service tier, or a restart of every
    tier on its database (#1371). Named user: a consultant whose customer has rung to say
    Business Central is stuck, who wants it working again without remoting into the
    customer's server, and who knows Business Central but nothing about the gateway.

    What the person is about to cost other people is the point of the dialog, so it leads
    with how many are signed in and that they will be signed out; on Production they tick
    that they understand, as they do before deploying to Production. Anything that would
    refuse the action is said here and holds the button.

    The dialog only confirms. The caller sends it (OnPremisesTierActionService.RequestAsync),
    which checks everything again. See .design/on-prem-gateway.md, "Service tier actions".
*@
@using ALDevToolbox.Services.Gateways
@inject OnPremisesTierActionService TierActions
@inject ILogger<ServiceTierActionDialog> Log

<ConfirmDialog @ref="_confirm" Wide="true" HeadIcon="@HeadIcon"
               ConfirmDisabled="@(_plan is null || _plan.Refusal is not null || (NeedsAck && !_ack))">
    <div class="tier-dialog">
    @if (_planError is { } planError)
    {
        <Alert Tone="AlertTone.Danger"><span>@planError</span></Alert>
    }
    else if (_plan is null)
    {
        <LoadingBlock Text="Reading the service tier..." />
    }
    else if (_plan.Refusal is { } refusal)
    {
        <Alert Tone="AlertTone.Danger"><span>@refusal</span></Alert>
    }
    else
    {
        <p class="tier-dialog__lead">@Lead(_plan)</p>
        <ul class="tier-dialog__tiers">
            @foreach (var tier in _plan.Tiers)
            {
                <li>@tier</li>
            }
            @foreach (var left in _plan.LeftAlone)
            {
                <li class="tier-dialog__left-out">@left — keeps running</li>
            }
        </ul>

        @if (_plan.SignsPeopleOut)
        {
            <Alert Tone="AlertTone.Warn" Role="" Block="true" Class="tier-dialog__alert">
                <div class="tier-dialog__warn">
                    <p><b>@SessionsHeadline(_plan.Sessions)</b> @SessionsDetail(_plan)</p>
                    <p>@AfterSentence(_plan)</p>
                </div>
            </Alert>
        }

        @if (NeedsAck)
        {
            <label class="check check--ack @(_ack ? "is-checked" : "")">
                <input type="checkbox" checked="@_ack" @onchange="e => _ack = (bool)(e.Value ?? false)" />
                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                <span>@AckSentence(_plan)</span>
            </label>
        }
    }
    </div>
</ConfirmDialog>

@code {
    private ConfirmDialog? _confirm;
    private ServiceTierActionPlan? _plan;
    private string? _planError;
    private bool _ack;
    private ServiceTierAction _action;

    /// <summary>Production asks again before anyone is signed out, as a Production deployment does.</summary>
    private bool NeedsAck => _plan is { IsProduction: true, SignsPeopleOut: true, Refusal: null };

    private string HeadIcon => _action == ServiceTierAction.Start ? "circle-play" : _action == ServiceTierAction.Stop ? "circle-stop" : "rotate-cw";

    /// <summary>
    /// Asks the person to confirm <paramref name="action"/> on <paramref name="environmentId"/>,
    /// after saying what it will do. True when they confirmed.
    /// </summary>
    public async Task<bool> OpenAsync(int environmentId, string environmentName, string tierName, int groupTierCount, ServiceTierAction action)
    {
        if (_confirm is null) return false;
        _action = action;
        _plan = null;
        _planError = null;
        _ack = false;
        StateHasChanged();

        var (title, message, label, css) = action switch
        {
            ServiceTierAction.RestartAll => (
                $"Restart all {groupTierCount} service tiers of {environmentName}?",
                "Every service tier on this database stops and starts again, as after a deployment. Use it when restarting one tier is not enough.",
                "Restart all tiers", "btn--danger"),
            ServiceTierAction.Stop => (
                $"Stop {tierName}?",
                "The service tier stops and stays stopped until someone starts it again, here or on the server.",
                "Stop service tier", "btn--danger"),
            ServiceTierAction.Start => (
                $"Start {tierName}?",
                "The service tier starts, and people can sign in through it again once it is running.",
                "Start service tier", ""),
            _ => (
                $"Restart {tierName}?",
                "Use it when people cannot sign in or Business Central has stopped answering. A restart clears stuck sessions and reads the service tier's settings again.",
                "Restart service tier", "btn--danger"),
        };
        var opening = _confirm.OpenAsync(title, message, label, css);
        try
        {
            _plan = await TierActions.GetPlanAsync(environmentId, action);
            if (_plan is null) _planError = "This environment is no longer linked to a service tier.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogWarning(ex, "Reading the {Action} plan for environment {EnvironmentId} failed.", action, environmentId);
            _planError = "Couldn't read the service tier. Close this and try again.";
        }
        StateHasChanged();
        return await opening;
    }

    private static string Lead(ServiceTierActionPlan plan) => plan.Action switch
    {
        ServiceTierAction.RestartAll => plan.OneByOne
            ? "These service tiers restart one at a time, so one of them is always running:"
            : "These service tiers all stop, then all start again:",
        ServiceTierAction.Stop => "This service tier stops:",
        ServiceTierAction.Start => "This service tier starts:",
        _ => "This service tier stops and starts again:",
    };

    private static string SessionsHeadline(ServiceTierSessions sessions) => sessions.OnTiers switch
    {
        null => "How many sessions are open is not known yet.",
        0 => "No sessions were open when the gateway last counted.",
        1 => "1 session is open.",
        var n => $"{n} sessions are open.",
    };

    private string SessionsDetail(ServiceTierActionPlan plan)
    {
        var s = plan.Sessions;
        var parts = new List<string>();
        if (s.OnTiers is not null && s.DatabaseTiers > plan.Tiers.Count && s.OnDatabase is { } onDatabase)
        {
            parts.Add($"{onDatabase} in all across the {s.DatabaseTiers} service tiers on this database.");
        }
        if (s.CountedAt is { } counted)
        {
            parts.Add($"The gateway counted them {Ago(counted)}, so the number may have changed.");
        }
        else
        {
            parts.Add("The gateway counts them every 15 minutes.");
        }
        return string.Join(" ", parts);
    }

    private static string AfterSentence(ServiceTierActionPlan plan) => plan.Action switch
    {
        ServiceTierAction.Stop => "Everyone signed in to it is signed out and loses unsaved work. Nobody can sign in through it until someone starts it again.",
        ServiceTierAction.RestartAll when plan.OneByOne => "Everyone signed in to a tier is signed out and loses unsaved work when that tier restarts.",
        ServiceTierAction.RestartAll => "Everyone signed in is signed out and loses unsaved work. Business Central is unavailable for the few minutes the restart takes.",
        _ => "Everyone signed in to it is signed out and loses unsaved work. It is unavailable for the minute or two the restart takes.",
    };

    private static string AckSentence(ServiceTierActionPlan plan)
    {
        var where = string.Equals(plan.EnvironmentName, "Production", StringComparison.OrdinalIgnoreCase)
            ? $"{plan.SolutionName}'s live Production environment"
            : $"{plan.EnvironmentName}, {plan.SolutionName}'s live Production environment";
        var tiers = plan.Tiers.Count == 1 ? plan.Tiers[0] : $"the {plan.Tiers.Count} service tiers listed";
        return plan.Action == ServiceTierAction.Stop
            ? $"I understand this stops {where} on {tiers} and signs everyone out of it."
            : $"I understand this restarts {where} on {tiers} and signs everyone out of {(plan.Tiers.Count == 1 ? "it" : "them")}.";
    }

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span < TimeSpan.FromMinutes(1)) return "less than a minute ago";
        if (span < TimeSpan.FromHours(1)) return span.TotalMinutes < 2 ? "1 minute ago" : $"{(int)span.TotalMinutes} minutes ago";
        return span.TotalHours < 2 ? "1 hour ago" : $"{(int)span.TotalHours} hours ago";
    }
}
