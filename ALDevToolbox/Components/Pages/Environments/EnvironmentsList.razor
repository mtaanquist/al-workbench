@page "/environments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Bc.UpgradeFleetService Fleet
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ILogger<EnvironmentsList> Log
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone
@inject IServiceScopeFactory ScopeFactory
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using static ALDevToolbox.Components.Shared.FleetRowState

@*
    Every Business Central environment across the solutions the viewer can
    reach, in one table. Archetype 2a (cross-solution list, live data) from the
    design system.

    It reads from UpgradeFleetService, which already answers exactly this
    question - the fleet query is cross-solution, joined through
    VisibleProjectPredicate, and its row carries every column drawn here. The
    Upgrades page is the same rows with scheduling on top; this one is the
    read-only view of the same fleet, so they deliberately share the query
    rather than growing a second one that could disagree. The one difference
    is deleted environments: Upgrades drops them (their update date cannot
    be moved), this page asks for them and puts them in a view of their own,
    because an environment Business Central is still keeping is the one
    thing here somebody can still act on before it is too late.

    Nothing here calls Business Central. The rows come from the mirror on
    oe_project_environments, which a nightly sweep and this page's Refresh keep
    current - see .design/environment-updates.md.
*@

<PageTitle>Environments · AL Workbench</PageTitle>

@{
    // Worked out once: the no-matches state, the table and the count all read it.
    // With Show selected on it is every ticked row, whatever the filters say.
    var shown = _rows is null ? [] : _selection.Shown(Filtered(), _rows, r => r.EnvironmentId, FilterKey()).ToList();
    var shownIds = Selectable(shown).Select(r => r.EnvironmentId).ToList();
}

<ListPage Title="Environments" Sticky="true"
          Subtitle="Every Business Central environment across the solutions you can reach."
          IsLoading="@(_rows is null)"
          IsEmpty="@(_loadFailed || _rows is { Count: 0 })"
          HasNoMatches="@(shown.Count == 0)"
          Trail='@([new("Home", "/"), new("Solutions", "/solutions"), new("Environments")])'>
    <Notices>
        @* Only a refresh failure belongs here: the table is still on screen and the
           alert annotates it. A failure to load at all gets its own state below,
           because the empty state underneath would otherwise claim the viewer has no
           Business Central connections. *@
        @if (_error is { } error)
        {
            <Alert Tone="AlertTone.Danger">
                <span>@error</span>
            </Alert>
        }
        else if (_done is { } done)
        {
            <Alert Tone="AlertTone.Success">
                <span>
                    @done
                    @* A copy runs for an hour after this line appears, so the notice
                       carries the way to go and watch it. *@
                    @if (_doneLink is { } link)
                    {
                        <text> </text><a href="@link.Href">@link.Text</a><text>.</text>
                    }
                </span>
            </Alert>
        }

        @* One freshness strip for the page, never one per section. The rows are a
           cached copy and the age is the honest thing to lead with; Refresh is the
           only way to make it newer, so it lives here beside the age it fixes.
           data-page-refresh is what the command palette's Refresh presses - a
           read of Business Central, never a write. *@
        @if (_rows is { Count: > 0 })
        {
            <div class="freshness @FreshnessClass()">
                <Icon Name="cloud-download" Width="15" Height="15" Css="freshness__icon" />
                @* The number is the OLDEST row, not the page. Labelling it "read from
                   Business Central 3 days ago" over a table where most rows say 4 minutes
                   reads as a contradiction, and the note that used to patch that over was
                   explaining our scheduler rather than telling anyone anything they can
                   act on. Naming it "oldest" makes the differing rows the obvious
                   consequence instead. *@
                <span class="freshness__text">
                    @if (OldestRead() is { } age)
                    {
                        <text>Oldest reading <span class="freshness__age"><Timestamp Value="@age" Relative="true" /></span>. Each row shows its own.</text>
                    }
                    else
                    {
                        <text>Not read from Business Central yet.</text>
                    }
                </span>
                <span class="freshness__spacer"></span>
                @* Per viewer and per visit: nothing remembers it, so a screen left on
                   overnight does not keep asking tomorrow. The two-hour stop in
                   AutoRefreshTickAsync is what stands in for knowing the tab is hidden. *@
                <label class="check freshness__auto @(_autoRefresh ? "is-checked" : "")">
                    <input type="checkbox" checked="@_autoRefresh" @onchange="OnAutoRefreshChanged" data-auto-refresh />
                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                    <span>Refresh every 5 minutes</span>
                </label>
                <button type="button" class="btn btn--sm @(_refreshing ? "btn--loading" : "")"
                        @onclick="RefreshAsync" disabled="@_refreshing" data-page-refresh>
                    <Icon Name="refresh-cw" Width="14" Height="14" />
                    <span class="btn__label">@(_refreshing ? "Refreshing" : "Refresh")</span>
                </button>
            </div>
        }

        @if (_refreshNote is { } note)
        {
            @* A note is an icon beside a body: without the icon the body lands in the
               icon's own 18px column and breaks a word to a line. *@
            <p class="note note--info">
                <span class="note__icon"><Icon Name="info" Width="17" Height="17" /></span>
                <span class="note__body">@note</span>
            </p>
        }

        @* What this view is, in the view itself. The pill's tooltip says the same, but a
           tooltip does not exist on touch and never appears on a keyboard - so it can
           never be the only place the meaning lives. *@
        @if (_tab == Tab.Deleted && _rows is { Count: > 0 })
        {
            <p class="note note--info">
                <span class="note__icon"><Icon Name="info" Width="17" Height="17" /></span>
                <span class="note__body">
                    These have been deleted in Business Central. Each one can be brought
                    back until the date below - after that it is gone, with its data.
                </span>
            </p>
        }
    </Notices>
    <Loading>
        @* Skeleton rows under the real header, as the design has it, so the column
           widths are settled before the data lands and nothing jumps. *@
        <table class="data-table data-table--edge">
            <thead>
                <tr>
                    <th class="data-table__col-check"><span class="u-sr">Select</span></th>
                    <th class="data-table__col-state"><span class="u-sr">State</span></th>
                    <th>Environment</th><th>Solution</th><th>Now on</th><th>Next update</th><th>Storage</th><th>Last checked</th><th class="data-table__actions">Actions</th>
                </tr>
            </thead>
            <tbody><TableSkeletonRows Columns="7" CheckColumn="true" StateColumn="true" /></tbody>
        </table>
        <LoadingBlock Text="Loading environments..." UnderTable="true" />
    </Loading>
    <Empty>
        @if (_loadFailed)
        {
            <div class="card">
                <EmptyState Icon="circle-alert" Title="Couldn't load your environments">
                    <Text>
                        Something went wrong at our end - this doesn't mean anything is wrong
                        with your Business Central connections.
                    </Text>
                    <Action>
                        <button type="button" class="btn btn--primary" @onclick="RetryAsync" disabled="@_loading">
                            @(_loading ? "Trying..." : "Try again")
                        </button>
                    </Action>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="card">
                <EmptyState Icon="server" Title="No environments to show yet">
                    <Text>
                        Environments appear here once a solution has a Business Central connection.
                        Open a solution, add its Entra tenant and app registration, and its
                        environments are read in automatically.
                    </Text>
                    <Action>
                        <a class="btn btn--primary" href="/solutions">Go to solutions</a>
                    </Action>
                </EmptyState>
            </div>
        }
    </Empty>
    <Search>
        <input class="input" type="search" placeholder="Solution or environment"
               aria-label="Search solution or environment"
               aria-keyshortcuts="F3" title="Search solution or environment (F3)"
               @bind="_searchInput" @bind:event="oninput" @bind:after="OnSearchInput" />
    </Search>
    <Filters>
        <SelectBox style="width: 200px">
            <select class="select" aria-label="Filter by solution" @bind="_solutionFilter">
                <option value="">All solutions</option>
                @* "CRONUS (CRN)": many customers are only ever called by their short name. *@
                @foreach (var solution in _rows!.GroupBy(r => r.ProjectName).OrderBy(g => g.Key))
                {
                    var shortName = solution.Select(r => r.ProjectShortName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n));
                    <option value="@solution.Key">@(shortName is null ? solution.Key : $"{solution.Key} ({shortName})")</option>
                }
            </select>
        </SelectBox>
        <SelectBox style="width: 170px">
            <select class="select" aria-label="Filter by environment type" @bind="_typeFilter">
                <option value="">All types</option>
                <option value="Production">Production only</option>
                <option value="Sandbox">Sandbox only</option>
            </select>
        </SelectBox>
    </Filters>
    <Trailing>
        <div class="pill-tabs">
            @foreach (var tab in Tabs())
            {
                <button type="button" class="pill-tab @(_tab == tab ? "is-active" : "")"
                        title="@TabHint(tab)" @onclick="() => SelectTab(tab)">
                    @TabLabel(tab)<span class="pill-tab__count">@CountFor(tab)</span>
                </button>
            }
        </div>
    </Trailing>
    <NoMatches>
        @* The frame draws this instead of the table, so the bar comes too: a tab or a
           search that hides every ticked row is exactly when the count and Show
           selected are needed. *@
        @if (_selection.Count > 0)
        {
            @BulkBar(shownIds)
        }
        @* An empty "Needs attention" is good news and must not be dressed as a
           failed search telling the reader to widen their filters. *@
        <div class="card">
            @if (_tab == Tab.NeedsAttention && NoOtherFilters())
            {
                <EmptyState Icon="circle-check" Title="Nothing needs attention">
                    <Text>
                        Every environment reported a healthy state, and none of them are
                        waiting on you.
                    </Text>
                </EmptyState>
            }
            else if (_tab == Tab.Deleted && NoOtherFilters())
            {
                @* The view is only offered when something is in it, so this is what a
                   reader standing in it sees when a refresh brings the last one back. *@
                <EmptyState Icon="circle-check" Title="Nothing has been deleted">
                    <Text>
                        None of these solutions has a deleted environment waiting to be
                        brought back.
                    </Text>
                    <Action>
                        <button type="button" class="btn" @onclick="() => _tab = Tab.All">Show all environments</button>
                    </Action>
                </EmptyState>
            }
            else if (_tab == Tab.UpdatingSoon && NoOtherFilters())
            {
                <EmptyState Title="No updates scheduled">
                    <Text>
                        Business Central hasn't announced an update for any of these
                        environments yet.
                    </Text>
                </EmptyState>
            }
            else
            {
                <EmptyState Title="No environments match those filters">
                    <Text>Try a different search, or choose All.</Text>
                    <Action>
                        <button type="button" class="btn" @onclick="ClearFilters">Clear filters</button>
                    </Action>
                </EmptyState>
            }
        </div>
    </NoMatches>
    <ChildContent>
        @if (_selection.Count > 0)
        {
            @BulkBar(shownIds)
        }
        <table class="data-table data-table--edge">
            <thead>
                <tr>
                    <th class="data-table__col-check">
                        @if (shownIds.Count > 0)
                        {
                            var rowState = _selection.SomeShownPicked(shownIds) ? "check is-indeterminate" : "check";
                            <label class="@rowState" aria-label="Select every environment shown">
                                <input type="checkbox" checked="@_selection.AllShownPicked(shownIds)"
                                       @onchange="e => _selection.ToggleShown(shownIds, e.Value is true)" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            </label>
                        }
                        else
                        {
                            <span class="u-sr">Select</span>
                        }
                    </th>
                    <th class="data-table__col-state" scope="col"><span class="u-sr">State</span></th>
                    <th scope="col">Environment</th>
                    <th scope="col">Solution</th>
                    <th scope="col">Now on</th>
                    @* In the Deleted view this column carries the deadline, not an
                       update, and a header saying otherwise is the wrong label on the
                       one fact somebody came for. *@
                    <th scope="col">@(_tab == Tab.Deleted ? "Gone for good" : "Next update")</th>
                    <th scope="col">Storage</th>
                    <th scope="col">Last checked</th>
                    <th scope="col" class="data-table__actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in shown)
                {
                    var picked = _selection.Contains(row.EnvironmentId);
                    var rowState = RowState(row) + (picked ? " is-selected" : "");
                    <tr class="@rowState">
                        @* A deleted environment has nothing to set: Business Central is only
                           keeping it so it can be brought back. *@
                        <td class="data-table__col-check">
                            @if (!row.IsSoftDeleted)
                            {
                                <label class="check" aria-label="@($"Select {row.ProjectName} {row.EnvironmentName}")">
                                    <input type="checkbox" checked="@picked" @onchange="e => _selection.Set(row.EnvironmentId, e.Value is true)" />
                                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                </label>
                            }
                        </td>
                        <td class="data-table__col-state">
                            @* Glyph only, as the design has it: the row says its state
                               with the edge bar and this icon, and no column is spent on
                               a word. Four states share two glyphs (suspended and deleted,
                               updating and preparing), and a title does not exist on
                               touch - so for every state but Running the word is also
                               written out under Next update, where the design puts it. *@
                            <span class="data-table__state data-table__state--icon" role="img"
                                  aria-label="@StatusWord(row)" title="@StatusWord(row)">
                                <Icon Name="@StatusIcon(row)" Width="15" Height="15" />
                            </span>
                        </td>
                        @* The environment leads: this is a list of environments, so the
                           first link in a row opens the environment, not its solution. *@
                        <td>
                            <span class="cell-stack">
                                <a class="cell-stack__main" href="@row.Href()">@row.EnvironmentName</a>
                                <span class="cell-stack__sub">@row.EnvironmentType</span>
                            </span>
                        </td>
                        <td>
                            <a href="@row.SolutionHref">@row.ProjectName</a>
                            @if (!string.IsNullOrWhiteSpace(row.ProjectShortName))
                            {
                                <span class="sol-list__short" title="Short name">@row.ProjectShortName</span>
                            }
                        </td>
                        <td class="u-num">@(row.Version ?? "—")</td>
                        <td>
                            @* For a deleted environment the deadline takes the bold line
                               the version would have had: it is the fact the row is here
                               for, and a dash in bold over it in grey reads backwards. *@
                            <span class="cell-stack">
                                <span class="cell-stack__main" style="font-weight: var(--fw-semibold)">
                                    @if (!row.IsSoftDeleted)
                                    {
                                        @NextVersion(row)
                                    }
                                    else if (row.HardDeletePendingOn is { } gone)
                                    {
                                        <text>Gone for good on <Timestamp Value="@gone" Format="dd MMM yyyy" /></text>
                                    }
                                    else
                                    {
                                        <text>Business Central hasn't said when it goes for good</text>
                                    }
                                </span>
                                <span class="cell-stack__sub">
                                    @if (row.IsSoftDeleted && row.HardDeletePendingOn is null && row.SoftDeletedOn is { } deleted)
                                    {
                                        <text>Deleted <Timestamp Value="@deleted" Format="dd MMM yyyy" /></text>
                                    }
                                    else if (row.IsSoftDeleted)
                                    {
                                        @RecoverWindow(row)
                                    }
                                    else if (row.NextUpdateDate is { } nextDate)
                                    {
                                        <Timestamp Value="@nextDate" Format="dd MMM yyyy, HH:mm" />
                                    }
                                    else
                                    {
                                        @NextWhen(row)
                                    }
                                </span>
                            </span>
                        </td>
                        <td>
                            @* The size is this environment's; the bar is the customer's whole
                               tenant against its allowance, because that is what runs out. It
                               repeats on each of a customer's rows so it is never a scroll away. *@
                            @if (row.DatabaseKb is { } size)
                            {
                                <span class="cell-stack env-storage">
                                    <span class="cell-stack__main u-num">@StorageDisplay.Size(size)</span>
                                    @if (row.TenantStorageUse is { } use)
                                    {
                                        var tone = StorageDisplay.Tone(use);
                                        <progress class="progress env-storage__bar @(tone.Length > 0 ? $"env-storage__bar--{tone}" : "")"
                                                  max="1" value="@Math.Min(use, 1).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                  aria-label="@StorageDisplay.Summary(use, row.TenantQuotaKb!.Value)"></progress>
                                        <span class="cell-stack__sub @(tone.Length > 0 ? $"env-storage__note--{tone}" : "")">@StorageDisplay.Summary(use, row.TenantQuotaKb!.Value)</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="u-muted">—</span>
                            }
                        </td>
                        <td class="u-muted">
                            @* fetched_at is NOT NULL on the row, so this always has a real
                               answer; the dash is only for a projection that somehow didn't
                               carry it. *@
                            @if (row.EnvironmentFetchedAt is { } fetchedAt)
                            {
                                <Timestamp Value="@fetchedAt" Relative="true" />
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                        <td class="data-table__actions">
                            @* The sheet's third entry, a refresh, is not here: a refresh
                               is per solution, not per environment, and the strip above
                               already does it. *@
                            <RowActions Label="@($"Actions for {row.ProjectName} {row.EnvironmentName}")">
                                @* Recover and Upload are offered on every row and refused by the
                                   service for someone who doesn't manage the solution: each is
                                   one click, and the refusal says who may. Copy is the exception,
                                   for the reason below it. Recover leads the menu on a deleted
                                   row - it is the only thing left to do to one, and the only one
                                   with a deadline. *@
                                @if (row.IsSoftDeleted)
                                {
                                    <button type="button" class="menu__item" role="menuitem"
                                            disabled="@_busy" @onclick="() => RecoverAsync(row)">Recover this environment...</button>
                                }
                                <a class="menu__item" role="menuitem" href="@row.Href()">Open environment</a>
                                @if (row.BusinessCentralUrl is { } bcUrl)
                                {
                                    <a class="menu__item" role="menuitem" href="@bcUrl"
                                       target="_blank" rel="noopener">Open in Business Central</a>
                                }
                                @if (!row.IsSoftDeleted)
                                {
                                    <button type="button" class="menu__item" role="menuitem"
                                            disabled="@_busy" @onclick="() => UploadAppAsync(row)">Upload apps...</button>
                                }
                                @* Copy is the one entry offered only to people who manage the
                                   solution. The others are one click and a refusal; this one
                                   asks for a name and two decisions first, and taking all that
                                   back with "you may not" is a worse answer than never asking. *@
                                @if (row.CanManage && !row.IsSoftDeleted)
                                {
                                    <button type="button" class="menu__item" role="menuitem"
                                            disabled="@_busy" @onclick="() => CopyAsync(row)">Copy this environment...</button>
                                }
                            </RowActions>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </ChildContent>
    <Footer>
        @* The whole result set is rendered, so the pager carries the count and
           no buttons: Previous and Next over a list that is never paged would be
           two controls that can never be enabled. *@
        <div class="pager">
            <span class="pager__count">
                @(shown.Count == _rows!.Count
                    ? $"{shown.Count} {(shown.Count == 1 ? "environment" : "environments")}"
                    : $"Showing {shown.Count} of {_rows.Count} environments")
            </span>
        </div>
    </Footer>
</ListPage>

<UploadAppDialog @ref="_uploadDialog" />
<BulkDeliveryWindowDialog @ref="_bulkWindowDialog" OnApplied="OnBulkWindowApplied" />
<CopyEnvironmentDialog @ref="_copyDialog" />
<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>The fleet, newest read wins. Null while loading; empty means nothing connected.</summary>
    private List<UpgradeFleetRow>? _rows;

    private string? _error;

    /// <summary>The outcome of an upload, a recovery or a copy, shown where a refresh failure would be.</summary>
    private string? _done;

    /// <summary>Where to go on from an outcome this page cannot finish telling - a copy that is still running.</summary>
    private (string Href, string Text)? _doneLink;

    /// <summary>A write from a row menu is in flight; the other rows' menu items wait for it.</summary>
    private bool _busy;
    private UploadAppDialog? _uploadDialog;
    private BulkDeliveryWindowDialog? _bulkWindowDialog;

    /// <summary>
    /// The ticked rows, by environment id. A search, a filter or a view leaves them
    /// ticked even when it takes them off screen (#985); only a re-read drops a tick,
    /// for an environment that is gone or has since been deleted.
    /// </summary>
    private readonly SelectionSet _selection = new();
    private CopyEnvironmentDialog? _copyDialog;
    private ConfirmDialog? _confirm;

    /// <summary>
    /// Set when the initial listing threw. Kept apart from <see cref="_error"/> so the
    /// empty state - which tells a first-time viewer to go and connect a solution -
    /// never renders on top of a failure, where it would be a lie.
    /// </summary>
    private bool _loadFailed;

    private bool _loading;
    private string? _refreshNote;
    private bool _refreshing;

    private string _search = string.Empty;
    private string _solutionFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private Tab _tab = Tab.All;

    /// <summary>
    /// Past this, the copy is old enough that a consultant should refresh before acting
    /// on the dates. Matches the Upgrades page's own staleness threshold so the two
    /// pages never disagree about whether the same row is stale.
    /// </summary>
    private static readonly TimeSpan StaleAfter = TimeSpan.FromHours(36);

    private enum Tab { All, UpdatingSoon, NeedsAttention, Deleted }

    /// <summary>
    /// The views on offer. Deleted only appears when Business Central is actually holding
    /// one: most of the time nothing has been deleted, and a view that is always empty is
    /// a place people learn to ignore - which is exactly the view that has to be noticed
    /// on the fortnight it isn't empty.
    /// </summary>
    private Tab[] Tabs() =>
        (_rows ?? new()).Any(r => r.IsSoftDeleted)
            ? [Tab.All, Tab.UpdatingSoon, Tab.NeedsAttention, Tab.Deleted]
            : [Tab.All, Tab.UpdatingSoon, Tab.NeedsAttention];

    private static string TabLabel(Tab tab) => tab switch
    {
        Tab.UpdatingSoon => "Update scheduled",
        Tab.NeedsAttention => "Needs attention",
        Tab.Deleted => "Deleted",
        _ => "All",
    };

    /// <summary>
    /// What each tab actually selects. "Needs attention" in particular is not
    /// guessable from its label, and the empty state alone can't say so because the
    /// reader has to choose the tab before seeing it. This is a hint on top of a
    /// working label, never the only place the meaning lives.
    /// </summary>
    private static string TabHint(Tab tab) => tab switch
    {
        Tab.UpdatingSoon => "Environments with an update date from Business Central",
        Tab.NeedsAttention =>
            "Environments Business Central reports as suspended, reported no state for, "
            + "or that returned something unexpected - and those of a customer at or "
            + "over their storage allowance",
        Tab.Deleted =>
            "Environments that have been deleted in Business Central. It keeps each one "
            + "for about 14 days, and until then it can be brought back",
        _ => "Every environment you can reach",
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>Counts the listings started, so an earlier one finishing late doesn't overwrite a later one.</summary>
    private int _loads;

    /// <param name="ownScope">True for the poll, whose tick can land while a click is still awaiting the circuit's context.</param>
    private async Task LoadAsync(bool ownScope = false)
    {
        // The poll and a click's reload can now be in flight together; only the one that
        // started last may set the rows, or a poll read from before a Recover would put
        // the old state back.
        var load = ++_loads;
        try
        {
            var rows = ownScope
                ? await OnOwnScopeAsync(fleet => fleet.ListFleetAsync(includeSoftDeleted: true))
                : await Fleet.ListFleetAsync(includeSoftDeleted: true);
            if (load != _loads) return;
            _rows = rows;
            _error = null;
            _loadFailed = false;
            _selection.Prune(Selectable(_rows).Select(r => r.EnvironmentId));
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to list environments.");
            if (load != _loads) return;
            _rows = new List<UpgradeFleetRow>();
            _loadFailed = true;
        }
    }

    /// <summary>Re-runs the listing behind the error state's Try again button.</summary>
    private async Task RetryAsync()
    {
        _loading = true;
        try { await LoadAsync(); }
        finally { _loading = false; }
    }

    /// <summary>
    /// Asks for a fresh read of every solution on the page. The refresh runs in the
    /// background worker, so the page polls itself rather than telling the reader to
    /// reload - the same shape the Upgrades page uses. A pressed Refresh always asks:
    /// the person has decided the rows are too old, whatever the timestamps say.
    /// </summary>
    private Task RefreshAsync() => RequestRefreshAsync(force: true);

    /// <summary>
    /// The one path both Refresh and the auto-refresh tick take. Unforced, the service
    /// leaves out any solution Business Central answered for in the last few minutes,
    /// which is what keeps a room full of open Environments lists from multiplying the
    /// calls (see UpgradeFleetService.RequestRefreshAsync).
    /// </summary>
    private async Task RequestRefreshAsync(bool force)
    {
        if (_refreshing || _rows is null) return;
        _refreshing = true;
        _refreshNote = null;
        try
        {
            var projectIds = _rows.Select(r => r.ProjectId).Distinct().ToList();
            // On a scope of its own: the auto-refresh timer comes through here too, and
            // its tick can land while a click is still awaiting the circuit's context.
            var result = await OnOwnScopeAsync(fleet => fleet.RequestRefreshAsync(projectIds, force));
            // Skipped rows are solutions this person may see but not act on. Saying
            // "asking about 3 customers" when 3 were asked and 5 were skipped is the
            // honest count, and it explains a table that only partly moves.
            var asked = result.Queued + result.AlreadyRunning;
            var total = projectIds.Count;
            _refreshNote = RefreshNote(asked, result.Fresh, total);
            if (asked == 0)
            {
                _refreshing = false;
                return;
            }
            StartPolling();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to request an environments refresh.");
            _refreshing = false;
            _error = "Couldn't ask Business Central for a refresh. Try again in a moment.";
        }
    }

    /// <summary>
    /// Runs a fleet call on a DI scope of its own, for the work the timers start. A timer
    /// tick goes through InvokeAsync, but that only keeps it apart from a click between
    /// awaits; a click already awaiting a query on the circuit's one AppDbContext would
    /// meet the tick's query there, and a context takes one command at a time. Same as
    /// the pipeline pages (#679).
    /// </summary>
    private async Task<T> OnOwnScopeAsync<T>(Func<UpgradeFleetService, Task<T>> call)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        return await call(scope.ServiceProvider.GetRequiredService<UpgradeFleetService>());
    }

    /// <summary>What a refresh request did, in the reader's words.</summary>
    private static string RefreshNote(int asked, int fresh, int total)
    {
        if (asked == 0)
        {
            return fresh > 0
                ? "Already up to date - Business Central was asked less than five minutes ago."
                : "You can see these environments but not refresh them. Ask an admin on the "
                  + "solution's page to re-read them.";
        }
        // Saying only the number asked, with a table that then half-moves, reads as a
        // bug. The ratio explains the rows that stay put.
        if (asked == total)
        {
            return $"Asking Business Central about {asked} solution{(asked == 1 ? "" : "s")}. "
                   + "New answers appear here as they arrive.";
        }
        var rest = fresh == 0
            ? "The rest aren't yours to refresh."
            : fresh == total - asked
                ? "The rest were read less than five minutes ago."
                : "The rest were read less than five minutes ago or aren't yours to refresh.";
        return $"Asking Business Central about {asked} of {total} solutions. {rest}";
    }

    // A refresh happens off the request thread, so the page re-reads on a timer for a
    // few minutes rather than leaving a stale table with no way forward.
    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(20);
    private static readonly TimeSpan PollFor = TimeSpan.FromMinutes(3);
    private System.Threading.Timer? _poll;
    private DateTime _pollUntilUtc;

    private void StartPolling()
    {
        _poll?.Dispose();
        _pollUntilUtc = DateTime.UtcNow.Add(PollFor);
        _poll = new System.Threading.Timer(_ => _ = PollTickAsync(), null, PollEvery, PollEvery);
    }

    private async Task PollTickAsync()
    {
        // On the renderer's context, so the rows land between a click's steps; the read
        // itself is on a scope of its own (see OnOwnScopeAsync).
        await InvokeAsync(async () =>
        {
            // A re-read waits for the next tick rather than moving the rows under the
            // dialog while it works.
            if (_bulkWindowDialog?.IsWorking == true) return;
            await LoadAsync(ownScope: true);
            if (DateTime.UtcNow >= _pollUntilUtc)
            {
                _poll?.Dispose();
                _poll = null;
                _refreshing = false;
                // A note that just vanishes leaves the reader unsure whether the refresh
                // ever landed. Say it finished, and how to read the table now.
                _refreshNote = "Finished asking. Anything still showing an old time didn't answer.";
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _poll?.Dispose();
        _searchDebounce.Dispose();
        _autoTimer?.Dispose();
    }

    // ── Auto-refresh ─────────────────────────────────────────────────────

    /// <summary>How often the auto-refresh asks. Tests shorten it; the page never changes it.</summary>
    internal static TimeSpan AutoRefreshEvery { get; set; } = TimeSpan.FromMinutes(5);

    /// <summary>
    /// How long the auto-refresh runs before it turns itself off. The page cannot tell
    /// a hidden tab from a watched one without script, so it bounds the time instead:
    /// a list forgotten in a background tab stops asking after this.
    /// </summary>
    internal static TimeSpan AutoRefreshFor { get; set; } = TimeSpan.FromHours(2);

    /// <summary><c>?auto=1</c> opens the page with the auto-refresh already on, for a screen set up to watch it.</summary>
    [SupplyParameterFromQuery(Name = "auto")] public string? AutoParam { get; set; }

    private bool _autoRefresh;
    private bool _autoFromAddressDone;
    private System.Threading.Timer? _autoTimer;
    private DateTime _autoUntilUtc;

    // After a render rather than in OnInitializedAsync: a prerender must never start a
    // timer, and the rows have to be there before a first tick has anything to ask about.
    protected override void OnAfterRender(bool firstRender)
    {
        if (_autoFromAddressDone || _rows is null) return;
        _autoFromAddressDone = true;
        if (AutoParam == "1" && !_loadFailed && _rows.Count > 0)
        {
            StartAutoRefresh();
            StateHasChanged();
        }
    }

    private async Task OnAutoRefreshChanged(ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            StartAutoRefresh();
            // Straight away as well: ticking the box is asking for current rows now,
            // and the freshness gate makes this free when they already are.
            await AutoRefreshTickAsync();
        }
        else
        {
            StopAutoRefresh();
        }
    }

    private void StartAutoRefresh()
    {
        _autoTimer?.Dispose();
        _autoRefresh = true;
        _autoUntilUtc = DateTime.UtcNow.Add(AutoRefreshFor);
        _autoTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(async () =>
            {
                await AutoRefreshTickAsync();
                StateHasChanged();
            }),
            null, AutoRefreshEvery, AutoRefreshEvery);
    }

    private void StopAutoRefresh()
    {
        _autoRefresh = false;
        _autoTimer?.Dispose();
        _autoTimer = null;
    }

    /// <summary>
    /// One auto-refresh round: an unforced request through the same path as Refresh, so
    /// its answers arrive through the same re-read. Internal so a test can drive it
    /// without waiting on the timer; it must run on the renderer's context.
    /// </summary>
    internal async Task AutoRefreshTickAsync()
    {
        if (!_autoRefresh) return;
        if (DateTime.UtcNow >= _autoUntilUtc)
        {
            StopAutoRefresh();
            _refreshNote = "Stopped refreshing every 5 minutes after two hours. Tick the box again to carry on.";
            return;
        }
        // Never beside a Refresh or its re-reads, and never while the dialog works on
        // the rows.
        if (_refreshing || _bulkWindowDialog?.IsWorking == true) return;
        try
        {
            await RequestRefreshAsync(force: false);
        }
        catch (Exception ex)
        {
            // RequestRefreshAsync handles its own failures; this is the timer's last resort.
            Log.LogError(ex, "Environments auto-refresh tick failed.");
        }
    }

    // ── Filtering ────────────────────────────────────────────────────────

    /// <summary>How long the search box waits for typing to stop before it filters. Tests set it to zero.</summary>
    internal static TimeSpan SearchDebounce { get; set; } = TimeSpan.FromMilliseconds(200);

    private readonly Debouncer _searchDebounce = new(SearchDebounce);

    // The box is bound to what is being typed; the table filters on _search, which
    // catches up once typing pauses (#981). Binding the box straight to _search would
    // redraw the table on every keystroke.
    private string _searchInput = string.Empty;

    private void OnSearchInput() =>
        _searchDebounce.Trigger(() => InvokeAsync(() =>
        {
            _search = _searchInput;
            StateHasChanged();
        }));

    private void SelectTab(Tab tab) => _tab = tab;

    /// <summary>
    /// The search, both dropdowns and the view as they stand. Show selected holds only
    /// while this does: changing any of them is asking to see something else.
    /// </summary>
    private (string Search, string Solution, string Type, Tab Tab) FilterKey() =>
        (_search.Trim(), _solutionFilter, _typeFilter, _tab);

    private void ClearFilters()
    {
        _searchDebounce.Cancel();
        _search = _searchInput = string.Empty;
        _solutionFilter = string.Empty;
        _typeFilter = string.Empty;
        _tab = Tab.All;
    }

    // ── Selection ────────────────────────────────────────────────────────

    /// <summary>The rows that can be ticked: every one but a deleted environment.</summary>
    private static List<UpgradeFleetRow> Selectable(IEnumerable<UpgradeFleetRow> rows) =>
        rows.Where(r => !r.IsSoftDeleted).ToList();

    /// <summary>
    /// The bulk bar, drawn over the table and over the no-matches state alike: ticks
    /// survive a search or a tab that hides them all (#985), and the bar is then the
    /// only sign of them and the only way back to them.
    /// </summary>
    private RenderFragment BulkBar(IReadOnlyCollection<int> shownIds) => @<text>
        @* The count says how many ticks are off screen, because a search or a filter
           no longer takes them away (#985). Show selected is the way to see them. *@
        <div class="bulk-bar" role="region" aria-label="Bulk actions" aria-live="polite">
            <span class="bulk-bar__summary">@_selection.Summary(shownIds)</span>
            <div class="bulk-bar__actions">
                <button type="button" class="btn btn--sm" @onclick="OpenBulkWindowAsync" disabled="@_busy">
                    <Icon Name="clock" Width="14" Height="14" />
                    <span>Set delivery window...</span>
                </button>
                <button type="button" class="btn btn--sm @(_selection.ShowSelectedOnly ? "is-active" : "")"
                        aria-pressed="@(_selection.ShowSelectedOnly ? "true" : "false")"
                        @onclick="() => _selection.ShowSelected(!_selection.ShowSelectedOnly, FilterKey())">
                    <Icon Name="eye" Width="14" Height="14" />
                    <span>Show selected</span>
                </button>
                <button type="button" class="btn btn--sm" @onclick="() => _selection.Clear()">
                    <Icon Name="x" Width="14" Height="14" />
                    <span>Clear selection</span>
                </button>
            </div>
        </div>
    </text>;

    private async Task OpenBulkWindowAsync()
    {
        if (_bulkWindowDialog is null || _rows is null) return;
        // Every ticked row, on screen or not: the dialog lists each one by name before
        // anything is written, so a tick a search has hidden is still seen first.
        var rows = _rows.Where(r => _selection.Contains(r.EnvironmentId)).ToList();
        if (rows.Count == 0) return;
        await _bulkWindowDialog.OpenAsync(rows);
    }

    /// <summary>
    /// The dialog shows its own per-row result; the list shows no windows, so there is
    /// nothing to re-read. The ticks have done their job.
    /// </summary>
    private void OnBulkWindowApplied(List<DeliveryWindowChangeResult> results) => _selection.Clear();

    /// <summary>True when only a tab is narrowing the list — the search and both dropdowns are clear.</summary>
    private bool NoOtherFilters() =>
        string.IsNullOrWhiteSpace(_search)
        && string.IsNullOrEmpty(_solutionFilter)
        && string.IsNullOrEmpty(_typeFilter);

    private IEnumerable<UpgradeFleetRow> Filtered()
    {
        var rows = _rows ?? Enumerable.Empty<UpgradeFleetRow>().ToList();
        IEnumerable<UpgradeFleetRow> q = rows;

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            q = q.Where(r =>
                r.ProjectName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (r.ProjectShortName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || r.EnvironmentName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        if (!string.IsNullOrEmpty(_solutionFilter))
        {
            q = q.Where(r => r.ProjectName == _solutionFilter);
        }
        if (!string.IsNullOrEmpty(_typeFilter))
        {
            q = q.Where(r => string.Equals(r.EnvironmentType, _typeFilter, StringComparison.OrdinalIgnoreCase));
        }
        return q.Where(r => MatchesTab(r, _tab));
    }

    /// <summary>
    /// Which view a row belongs to. A deleted environment appears in exactly one of them:
    /// nothing can be published, updated or rescheduled on it, so listing it beside the
    /// live ones makes the fleet look both bigger and sicker than it is - and in
    /// particular it is not something that "needs attention", which is a list of things
    /// somebody has to go and do.
    /// </summary>
    private static bool MatchesTab(UpgradeFleetRow row, Tab tab) => tab switch
    {
        Tab.Deleted => row.IsSoftDeleted,
        _ when row.IsSoftDeleted => false,
        Tab.UpdatingSoon => row.NextUpdateDate is not null,
        Tab.NeedsAttention => NeedsAttention(row),
        _ => true,
    };

    private int CountFor(Tab tab) => (_rows ?? new()).Count(r => MatchesTab(r, tab));

    /// <summary>
    /// A row worth looking at: we have never managed to read it, or Business Central
    /// reports a state it will not leave on its own. Two things deliberately don't
    /// count — "nothing is scheduled" isn't a problem, and neither is an environment
    /// part-way through an update, which is the system working.
    /// <para>A customer at or over their storage allowance counts too: nothing is broken
    /// yet, but it is a conversation somebody has to have. Filling up (amber) does not -
    /// the bar already says so, and a list of things to do should not grow on a warning.</para>
    /// </summary>
    private static bool NeedsAttention(UpgradeFleetRow row) =>
        StateUnknown(row) || RowState(row) is "is-failed" or "is-queued" || row.TenantStorageUse >= 1;

    // ── Presentation ─────────────────────────────────────────────────────

    /// <summary>
    /// The sub-line under the next version when it has no date (a dated one is a
    /// Timestamp in the markup). Distinguishes a version Microsoft has named but not
    /// dated, nothing on offer at all, and an environment we have never managed to read
    /// - see .design/environment-updates.md, which makes the same distinction the mirror does.
    /// </summary>
    private static string NextWhen(UpgradeFleetRow row)
    {
        if (row.NextUpdateVersion is not null) return "Date not announced yet";
        // With nothing scheduled, this line is where the design names a state that is
        // not plain Running - the state cell is a glyph, and this keeps the word on screen.
        return IsRunning(row) ? "Nothing scheduled" : StatusWord(row);
    }

    /// <summary>The next version, or a dash when Business Central is offering none.</summary>
    private static string NextVersion(UpgradeFleetRow row) => row.IsSoftDeleted ? "—" : row.NextUpdateVersion ?? "—";

    /// <summary>
    /// How long is left, under the date. A date alone makes somebody scanning a list do
    /// the arithmetic per row to find the customer who needs a call today, which is the
    /// question this view exists to answer - and the column beside it is already
    /// relative. A date already past is not dressed up as urgency: the mirror may simply
    /// be older than the deadline it is repeating. (The day a deleted environment stops
    /// being recoverable is the bold line above; an unknown one is said plainly there
    /// rather than left as a dash the reader has to interpret as "no deadline".)
    /// </summary>
    private static string RecoverWindow(UpgradeFleetRow row)
    {
        if (row.HardDeletePendingOn is not { } gone)
        {
            return "Deleted";
        }
        return (gone.Date - DateTime.UtcNow.Date).Days switch
        {
            < 0 => "Past the date Business Central gave",
            0 => "Today is the last day to bring it back",
            1 => "1 day left to bring it back",
            var days => $"{days} days left to bring it back",
        };
    }

    /// <summary>
    /// The age of the oldest row that has ever been read, or null when none has. Null
    /// is a different sentence, not the word "never" dropped into this one.
    /// </summary>
    private DateTime? OldestRead()
    {
        var read = (_rows ?? new())
            .Where(r => r.EnvironmentFetchedAt is not null)
            .Select(r => r.EnvironmentFetchedAt!.Value)
            .ToList();
        return read.Count == 0 ? null : read.Min();
    }

    private string FreshnessClass()
    {
        var classes = string.Empty;
        var rows = _rows ?? new();
        // Only rows we have actually read count. Including never-read ones would pin
        // the warning on for as long as one environment stays unreachable, and a
        // banner that never clears is one people stop seeing.
        var anyStale = rows.Any(r =>
            r.EnvironmentFetchedAt is { } at && DateTime.UtcNow - at > StaleAfter);
        if (anyStale) classes += "freshness--stale";
        if (_refreshing) classes += " is-refreshing";
        return classes.Trim();
    }

    /// <summary>
    /// Sends an app somebody was handed straight to this row's environment. The list has
    /// no live panel to re-read afterwards, so the outcome is a notice and nothing else.
    /// </summary>
    private async Task UploadAppAsync(UpgradeFleetRow row)
    {
        if (_uploadDialog is null) return;
        // The list row carries no windows; the environment's own read does, and the
        // dialog needs the delivery window to offer it.
        var detail = await Fleet.GetEnvironmentAsync(row.EnvironmentId);
        var upload = await _uploadDialog.OpenAsync(row.ProjectName, row.EnvironmentName, row.IsProduction,
            detail?.DeliveryWindowStart, detail?.DeliveryWindowEnd, row.TimeZone,
            detail?.BcUpdateWindowStart, detail?.BcUpdateWindowEnd, detail?.BcUpdateWindowTimeZoneIana);
        if (upload is null) return;

        _busy = true;
        _error = null;
        _done = null;
        _doneLink = null;
        StateHasChanged();
        try
        {
            var packages = upload.Files.Select(f => new UploadPackage(f.Bytes, f.FileName)).ToList();
            var outcome = await Connection.InstallUploadedAppsAsync(row.ProjectId, row.EnvironmentId, packages, upload.Timing, upload.At);
            _done = UploadAppDialog.DoneMessage(upload, outcome, row.EnvironmentName, Zone);
        }
        catch (PlanValidationException ex)
        {
            _error = ex.Errors.Values.FirstOrDefault() ?? "Couldn't book the upload.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Uploading an app failed for environment {EnvId}.", row.EnvironmentId);
            _error = "Couldn't book the upload. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Makes a new environment from this row's. The list has no live panel to re-read
    /// afterwards, so the outcome is a notice - and because the copy goes on running long
    /// after it, the notice says where to watch it finish.
    /// </summary>
    private async Task CopyAsync(UpgradeFleetRow row)
    {
        if (_copyDialog is null) return;
        var copy = await _copyDialog.OpenAsync(
            row.ProjectName, row.EnvironmentName, row.IsProduction, row.TenantStorageUse);
        if (copy is null) return;

        _busy = true;
        _error = null;
        _done = null;
        _doneLink = null;
        StateHasChanged();
        try
        {
            await Connection.CopyEnvironmentAsync(row.ProjectId, row.EnvironmentId, copy.Name, copy.Type);
            _done = CopyEnvironmentDialog.DoneMessage(copy, row.EnvironmentName);
            _doneLink = (row.Href("operations"), $"Open {row.EnvironmentName}'s Operations tab");
            // Business Central may not list the new one yet; the re-read is what brings
            // it in as soon as it does, and its absence is not a failure.
            await LoadAsync();
        }
        catch (PlanValidationException ex)
        {
            _error = ex.Errors.Values.FirstOrDefault() ?? $"Couldn't copy {row.EnvironmentName}.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Copying environment {EnvId} failed.", row.EnvironmentId);
            _error = $"Couldn't copy {row.EnvironmentName}. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Brings a deleted environment back. Business Central schedules the recovery rather
    /// than doing it there and then, so the list is re-read afterwards and the row moves
    /// out of the Deleted view on its own once Microsoft has finished.
    /// </summary>
    private async Task RecoverAsync(UpgradeFleetRow row)
    {
        if (_confirm is null) return;
        // One verb throughout - the control, the title and the button all say recover,
        // which is also what the admin centre calls it. Never "restore": in Business
        // Central that is the point-in-time restore of a live environment, and somebody
        // would reasonably ask which point in time.
        var confirmed = await _confirm.OpenAsync(
            row.IsProduction
                ? $"Recover {row.EnvironmentName}, a production environment?"
                : $"Recover {row.EnvironmentName}?",
            $"{row.EnvironmentName} ({row.EnvironmentType}) belongs to {row.ProjectName}. "
            + "Business Central brings it back with the data it held when it was deleted, "
            + "and people will be able to sign in to it again. It takes a few minutes.",
            "Recover it", confirmButtonClass: "btn--primary", confirmIcon: "archive-restore");
        if (!confirmed) return;

        _busy = true;
        _error = null;
        _done = null;
        _doneLink = null;
        StateHasChanged();
        try
        {
            await Connection.RecoverEnvironmentAsync(row.ProjectId, row.EnvironmentId);
            _done = $"Business Central is bringing {row.EnvironmentName} back. It takes a few minutes - use Refresh above to see when it is done.";
            await LoadAsync();
            // Recovering the last one takes the view away with it; standing in a view
            // that is no longer offered would look like the page had lost the rows.
            if (_tab == Tab.Deleted && !Tabs().Contains(Tab.Deleted)) _tab = Tab.All;
        }
        catch (PlanValidationException ex)
        {
            _error = ex.Errors.Values.FirstOrDefault() ?? $"Couldn't bring {row.EnvironmentName} back.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Recovering environment {EnvId} failed.", row.EnvironmentId);
            _error = $"Couldn't bring {row.EnvironmentName} back. Check AL Workbench still has admin access in the customer's Business Central admin centre, then try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
