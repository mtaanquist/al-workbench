@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services.Gateways
@using ALDevToolbox.Services.ObjectExplorer.Bc
@inject TimeProvider Clock

@*
    The environment page for a linked on-premises service tier. Only what the gateway
    reports is here: there is no Microsoft update to schedule, no storage allowance, no
    copy and no live read of the customer's tenant, so none of those cards is drawn.
    Named user: a BC consultant checking which version a hosted customer runs and what
    is installed, who knows Business Central and nothing about the gateway. The facts are
    as the gateway last pushed them, so the first thing said is how fresh they are, and
    when the gateway has gone quiet that comes before everything else.
    See .design/on-prem-gateway.md, "Readers of OeProjectEnvironments".
*@

@{
    var now = Clock.GetUtcNow().UtcDateTime;
    var tier = Row.OnPremises;
}

@if (Head)
{
<div class="freshness @StripClass">
    <Icon Name="server" Width="15" Height="15" Css="freshness__icon" />
    <span class="freshness__text">
        @if (tier?.ReadAt is { } read)
        {
            <text>Read from the service tier by the on-premises gateway <span class="freshness__age"><Timestamp Value="@read" Relative="true" /></span>. The gateway reads it every 15 minutes.</text>
        }
        else
        {
            <text>The on-premises gateway hasn't read this service tier yet.</text>
        }
    </span>
</div>

@if (tier is null)
{
    <Alert Tone="AlertTone.Warn" Block="true">
        <span><b>The gateway no longer reports this service tier.</b> What is shown is what it last reported. An administrator can check the gateway's list of service tiers.</span>
    </Alert>
}
else if (tier.IsGatewayOffline(now) || tier.InstanceMissingSince is not null)
{
    <Alert Tone="AlertTone.Warn" Block="true">
        <span>
            <b><OnPremisesTierState Row="Row" />.</b>
            What is shown is what it last reported, so the version and apps may have changed since.
            @if (tier.InstanceMissingSince is not null && !tier.IsGatewayOffline(now))
            {
                <text> The customer's IT may have taken it out of the gateway's settings file.</text>
            }
            else
            {
                <text> Ask the customer's IT to check that the AL Workbench gateway service is running on @tier.Machine's network.</text>
            }
            @if (CanSeeGateway)
            {
                @(" ")<a href="@GatewayHref(tier)">Open the gateway</a><text>.</text>
            }
        </span>
    </Alert>
}

<div class="meta-row">
    <span class="meta-item"><span class="meta-item__label">Type</span><span class="meta-item__value">@(tier?.EnvironmentLabel ?? Row.EnvironmentType)</span></span>
    <span class="meta-item"><span class="meta-item__label">BC version</span><span class="meta-item__value meta-item__value--mono">@(Row.Version ?? "—")</span></span>
    <span class="meta-item"><span class="meta-item__label">Server</span><span class="meta-item__value">@(tier?.TierName ?? "—")</span></span>
    <span class="meta-item"><span class="meta-item__label">Tenant</span><span class="meta-item__value">@TenantText(tier)</span></span>
    <span class="meta-item"><span class="meta-item__label">Delivery window</span><span class="meta-item__value">@DeliveryWindow</span></span>
    <span class="meta-item"><span class="meta-item__label">Apps installed</span><span class="meta-item__value">@(Apps is { Count: > 0 } a ? a.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")</span></span>
</div>

}
else if (!ShowApps)
{
    <div class="card">
        <div class="card__head">
            <div>
                <h2 class="card__title">Service tier</h2>
                <p class="card__sub">The Business Central server this environment is, as the on-premises gateway in the customer's network reports it.</p>
            </div>
        </div>
        <div class="card__body">
            @if (tier is null)
            {
                <p class="u-muted">Nothing is known about the service tier any more.</p>
            }
            else
            {
                <div class="kv-grid">
                    <span class="meta-item"><span class="meta-item__label">Server</span><span class="meta-item__value">@tier.Machine</span></span>
                    <span class="meta-item"><span class="meta-item__label">Instance</span><span class="meta-item__value">@tier.InstanceName</span></span>
                    <span class="meta-item"><span class="meta-item__label">Tenant</span><span class="meta-item__value">@TenantText(tier)</span></span>
                    <span class="meta-item"><span class="meta-item__label">State</span><span class="meta-item__value">@BcEnvironmentStatus.StatusWord(Row.Status)</span></span>
                    <span class="meta-item"><span class="meta-item__label">Database</span><span class="meta-item__value">@(tier.Database ?? "Not read yet")</span></span>
                    <span class="meta-item"><span class="meta-item__label">Open sessions</span><span class="meta-item__value">@(tier.SessionCount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Not read")</span></span>
                    <span class="meta-item"><span class="meta-item__label">Licence expires</span><span class="meta-item__value">@LicenceText(tier)</span></span>
                    <span class="meta-item"><span class="meta-item__label">Gateway</span><span class="meta-item__value">@tier.GatewayName</span></span>
                    <span class="meta-item"><span class="meta-item__label">Our delivery window</span><span class="meta-item__value">@DeliveryWindow</span></span>
                </div>
                @if (tier.ReadError is { } error)
                {
                    <FieldError Class="env-detail__later">The gateway couldn't read the service tier last time: @error</FieldError>
                }
                <p class="u-muted onprem__note">
                    Microsoft's platform updates don't reach an on-premises server, so there is no update
                    to schedule here. The customer's own IT decides whether this is Production, Test or
                    Development.
                </p>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card__head">
            <div>
                <h2 class="card__title">Installed apps</h2>
                <p class="card__sub">What the gateway last reported as installed@(tier is { Multitenant: true } ? $" in tenant {tier.TenantId}" : "").</p>
            </div>
        </div>
        @if (Apps is null)
        {
            <div class="card__body"><LoadingBlock Text="Loading installed apps..." /></div>
        }
        else if (Apps.Count == 0)
        {
            <EmptyState Icon="package" Title="No apps reported yet">
                <Text>The gateway reads the installed apps every 15 minutes while it is online. They appear here after its next reading.</Text>
            </EmptyState>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th scope="col">App</th><th scope="col">Publisher</th><th scope="col">Version</th></tr>
                </thead>
                <tbody>
                    @foreach (var app in Apps)
                    {
                        <tr>
                            <td>@app.Name</td>
                            <td class="u-muted">@app.Publisher</td>
                            <td class="u-num">@app.Version</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    /// <summary>The environment, from the fleet; <see cref="UpgradeFleetRow.IsOnPremises"/> is true.</summary>
    [Parameter, EditorRequired] public UpgradeFleetRow Row { get; set; } = default!;

    /// <summary>
    /// True for the part above the page's tabs (how fresh the facts are, the gateway's
    /// state, the meta row); false for the open tab's card.
    /// </summary>
    [Parameter] public bool Head { get; set; }

    /// <summary>True on the Apps tab; Overview otherwise.</summary>
    [Parameter] public bool ShowApps { get; set; }

    /// <summary>The installed-apps mirror; null while it is read.</summary>
    [Parameter] public List<InstalledAppRow>? Apps { get; set; }

    /// <summary>The delivery window, worded as the page words it.</summary>
    [Parameter] public string DeliveryWindow { get; set; } = "Any time";

    /// <summary>True for an Admin, who may open the gateway's own page.</summary>
    [Parameter] public bool CanSeeGateway { get; set; }

    private static string GatewayHref(OnPremisesTierFacts tier) =>
        $"/admin/administration/gateways/{tier.GatewayId.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    /// <summary>Unknown, unread for too long, or its gateway offline: the strip turns to its warning colour.</summary>
    private string StripClass
    {
        get
        {
            var now = Clock.GetUtcNow().UtcDateTime;
            var tier = Row.OnPremises;
            return tier is null || tier.IsStale(now) || tier.IsGatewayOffline(now) ? "freshness--stale" : string.Empty;
        }
    }

    /// <summary>A single-tenant server's one tenant is "default" in BC; the page says what that means.</summary>
    private static string TenantText(OnPremisesTierFacts? tier) =>
        tier is null ? "—" : tier.Multitenant == true ? tier.TenantId : "Single tenant";

    private string LicenceText(OnPremisesTierFacts tier)
    {
        if (tier.LicenceExpiresOn is not { } expires) return tier.Licensee is null ? "Not read yet" : "No expiry date";
        var today = DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);
        var date = ALDevToolbox.Components.Pages.Admin.Administration.GatewayStatusText.LicenceDate(expires);
        if (expires < today) return $"{date} (expired)";
        return expires.DayNumber - today.DayNumber <= 30 ? $"{date} (within 30 days)" : date;
    }
}
