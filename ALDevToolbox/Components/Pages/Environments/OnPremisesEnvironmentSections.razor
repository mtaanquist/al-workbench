@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services.Gateways
@using ALDevToolbox.Services.ObjectExplorer.Bc
@inject TimeProvider Clock

@*
    The environment page for a linked on-premises service tier. Only what the gateway
    reports is here: there is no Microsoft update to schedule, no storage allowance, no
    copy and no live read of the customer's tenant, so none of those cards is drawn.
    Named user: a BC consultant checking which version a hosted customer runs and what
    is installed, who knows Business Central and nothing about the gateway. The facts are
    as the gateway last pushed them, so the first thing said is how fresh they are, and
    when the gateway has gone quiet that comes before everything else.
    See .design/on-prem-gateway.md, "Readers of OeProjectEnvironments".
*@

@{
    var now = Clock.GetUtcNow().UtcDateTime;
    var tier = Row.OnPremises;
}

@if (Head)
{
@* When the gateway has gone quiet the warning is the whole story: a freshness line
   beside it ("read 3 days ago, reads every 15 minutes") would only argue with it. *@
@if (tier is null)
{
    <Alert Tone="AlertTone.Warn" Block="true">
        <span><b>The gateway no longer reports this service tier.</b> What is shown is what it last reported. An administrator can check the gateway's list of service tiers.</span>
    </Alert>
}
else if (tier.NeedsAttention(now))
{
    <Alert Tone="AlertTone.Warn" Block="true">
        <span>
            <b><OnPremisesTierState Row="Row" />.</b>
            What is shown is what it last reported, so the version and apps may have changed since.
            @if (tier.IsGatewayOffline(now))
            {
                <text> Ask the customer's IT to check that the AL Workbench gateway service is running on @tier.Machine's network.</text>
            }
            else if (tier.NoLongerReportedSince is not null)
            {
                <text> The customer's IT may have taken it out of the gateway's settings file.</text>
            }
            else
            {
                <text> The gateway is connected but can't read the service tier. Ask the customer's IT to check that the server is running.</text>
            }
            @if (CanSeeGateway)
            {
                @(" ")<a href="@GatewayHref(tier)">Open the gateway</a><text>.</text>
            }
        </span>
    </Alert>
}
else
{
    <div class="freshness">
        <Icon Name="server" Width="15" Height="15" Css="freshness__icon" />
        <span class="freshness__text">
            @if (tier.ReadAt is { } read)
            {
                <text>Read from the service tier by the on-premises gateway <span class="freshness__age"><Timestamp Value="@read" Relative="true" /></span>. The gateway reads it every 15 minutes.</text>
            }
            else
            {
                <text>The on-premises gateway hasn't read this service tier yet. It reads it every 15 minutes.</text>
            }
        </span>
    </div>
}

<div class="meta-row">
    <span class="meta-item"><span class="meta-item__label">Type</span><span class="meta-item__value">@(tier?.EnvironmentLabel ?? Row.EnvironmentType)</span></span>
    <span class="meta-item"><span class="meta-item__label">BC version</span><span class="meta-item__value meta-item__value--mono">@(Row.Version ?? "—")</span></span>
    <span class="meta-item"><span class="meta-item__label">Server</span><span class="meta-item__value">@(tier?.Machine ?? "—")</span></span>
    <span class="meta-item"><span class="meta-item__label">Tenant</span><span class="meta-item__value">@TenantText(tier)</span></span>
    <span class="meta-item"><span class="meta-item__label">Delivery window</span><span class="meta-item__value">@DeliveryWindow</span></span>
    <span class="meta-item"><span class="meta-item__label">Apps installed</span><span class="meta-item__value">@(Apps is { Count: > 0 } a ? a.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—")</span></span>
    <span class="meta-item"><span class="meta-item__label">Licence expires</span><span class="meta-item__value">@(tier is null ? "—" : LicenceText(tier))</span></span>
</div>

@* A licence that runs out stops everyone signing in, so a month ahead it is said above
   the tabs, on every tab, with the button that fixes it. While a new licence is being
   imported the warning would only argue with the card below, so it says that instead. *@
@if (Licence?.LastUpload is { State: LicenceImportState.Waiting or LicenceImportState.Running })
{
    <Alert Tone="AlertTone.Info" Block="true">
        <span>A new licence is being imported. The Licence card below shows how it goes.</span>
    </Alert>
}
else if (tier?.LicenceExpiresOn is { } expiresOn && expiresOn.DayNumber - Today.DayNumber <= OnPremisesLicenceService.ExpiryWarningDays)
{
    var daysLeft = expiresOn.DayNumber - Today.DayNumber;
    <Alert Tone="@(daysLeft <= 0 ? AlertTone.Danger : AlertTone.Warn)" Block="true">
        <div class="onprem__expiry">
            <span>
                <b>@(daysLeft <= 0
                    ? $"The Business Central licence expired on {LicenceDate(expiresOn)}."
                    : $"The Business Central licence expires on {LicenceDate(expiresOn)}, in {(daysLeft == 1 ? "1 day" : $"{daysLeft} days")}.")</b>
                @(daysLeft <= 0 ? " Nobody can sign in to Business Central until a new one is imported." : "")
                @if (CanManage)
                {
                    <text> Ask the customer for their new licence file, then import it here.</text>
                }
                else
                {
                    <text> Ask the customer for their new licence file. Someone who manages this Solution can import it here.</text>
                }
            </span>
            @if (CanManage)
            {
                @ImportButton
            }
        </div>
    </Alert>
}

}
else if (!ShowApps)
{
    <div class="card">
        <div class="card__head">
            <div>
                <h2 class="card__title">Service tier</h2>
                <p class="card__sub">The Business Central server this environment is, as the on-premises gateway in the customer's network reports it.</p>
            </div>
        </div>
        <div class="card__body">
            @if (tier is null)
            {
                <p class="u-muted">Nothing is known about the service tier any more.</p>
            }
            else
            {
                <div class="kv-grid">
                    <span class="meta-item"><span class="meta-item__label">Server</span><span class="meta-item__value">@tier.Machine</span></span>
                    <span class="meta-item"><span class="meta-item__label">Instance</span><span class="meta-item__value">@tier.InstanceName</span></span>
                    <span class="meta-item"><span class="meta-item__label">Tenant</span><span class="meta-item__value">@TenantText(tier)</span></span>
                    <span class="meta-item"><span class="meta-item__label">State</span><span class="meta-item__value">@FleetRowState.StatusWord(Row, now)</span></span>
                    <span class="meta-item"><span class="meta-item__label">Database</span><span class="meta-item__value">@(tier.Database ?? "Not read yet")</span></span>
                    <span class="meta-item"><span class="meta-item__label">Open sessions</span><span class="meta-item__value">@(tier.SessionCount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Not read")</span></span>
                    <span class="meta-item"><span class="meta-item__label">Gateway</span><span class="meta-item__value">@tier.GatewayName</span></span>
                    <span class="meta-item"><span class="meta-item__label">Delivery window</span><span class="meta-item__value">@DeliveryWindow</span></span>
                </div>
                @if (tier.ReadError is { } error)
                {
                    <FieldError Class="env-detail__later">The gateway couldn't read the service tier last time: @error</FieldError>
                }
                <p class="u-muted onprem__note">
                    Microsoft's platform updates don't reach an on-premises server, so there is no update
                    to schedule here. The customer's own IT decides whether this is Production, Test or
                    Development.
                </p>
            }
        </div>
    </div>

    @* The licence: what the tier runs, the last upload, and the one action. An outline
       button - nothing on this page is the primary action. *@
    <div class="card">
        <div class="card__head">
            <div>
                <h2 class="card__title">Licence</h2>
                <p class="card__sub">The Business Central licence the service tier runs, as the gateway last read it.</p>
            </div>
            @if (CanManage && tier is not null)
            {
                @ImportButton
            }
        </div>
        @if (LicenceError is { } licenceError)
        {
            <div class="card__body"><FieldError Message="@licenceError" /></div>
        }
        else if (Licence is null)
        {
            <div class="card__body"><LoadingBlock Text="Loading the licence..." /></div>
        }
        else
        {
            @if (Licence.Installed is not { } installed)
            {
                <EmptyState Icon="key-round" Title="No licence read yet">
                    <Text>The gateway reads the licence every 15 minutes while it is online. It appears here after the next reading.</Text>
                </EmptyState>
            }
            else
            {
                <div class="card__body">
                    <div class="kv-grid">
                        <span class="meta-item"><span class="meta-item__label">Licensed to</span><span class="meta-item__value">@(installed.Licensee ?? "Not stated")</span></span>
                        <span class="meta-item"><span class="meta-item__label">Expires</span><span class="meta-item__value">@LicenceText(tier!)</span></span>
                        <span class="meta-item"><span class="meta-item__label">Serial number</span><span class="meta-item__value meta-item__value--mono">@(installed.SerialNumber ?? "Not stated")</span></span>
                        <span class="meta-item"><span class="meta-item__label">Read</span><span class="meta-item__value"><Timestamp Value="@installed.ReadAt" Relative="true" /></span></span>
                    </div>
                    @if (installed.ParseProblems is { } problems)
                    {
                        <p class="u-muted onprem__note">Some of the licence could not be read: @problems</p>
                    }
                    @if (installed.Ranges.Count > 0)
                    {
                        <details class="onprem__ranges">
                            <summary>Object ranges (@installed.Ranges.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</summary>
                            <table class="data-table">
                                <thead>
                                    <tr><th scope="col">Object type</th><th scope="col">From</th><th scope="col">To</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var range in installed.Ranges)
                                    {
                                        <tr>
                                            <td>@range.ObjectType</td>
                                            <td class="u-num">@range.FromId</td>
                                            <td class="u-num">@range.ToId</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </details>
                    }
                </div>
            }
            <div class="card__body onprem__upload">
                @if (Licence.LastUpload is { } upload)
                {
                    <p class="onprem__upload-line">
                        <StatusPill Tone="@UploadTone(upload.State)">@UploadWord(upload.State)</StatusPill>
                        <span>
                            Last upload:
                            @if (Licence.CanManage)
                            {
                                <a href="@($"/licences/{upload.Id}/file")" download>@upload.FileName</a>
                            }
                            else
                            {
                                <span>@upload.FileName</span>
                            }
                            by @(upload.UploadedBy ?? "a former member") <Timestamp Value="@upload.UploadedAt" Relative="true" />,
                            into @upload.Where.
                        </span>
                    </p>
                    @if (upload.State is LicenceImportState.Waiting)
                    {
                        <p class="u-muted onprem__upload-detail">Waiting for the gateway to pick it up. If this does not change within a few minutes, the gateway may be offline: ask the customer's IT to check it.</p>
                    }
                    else if (upload.State is LicenceImportState.Running)
                    {
                        <p class="u-muted onprem__upload-detail">The gateway is importing it and restarting the service tiers. This page shows the result when it is done.</p>
                    }
                    else if (upload.Message is { } message && upload.State is LicenceImportState.Failed)
                    {
                        <FieldError Class="onprem__upload-detail" Message="@message" />
                    }
                    else if (upload.Message is { } note)
                    {
                        <p class="onprem__upload-detail onprem__upload-note">@note</p>
                    }
                }
                else
                {
                    <p class="u-muted onprem__upload-line">No licence has been uploaded here yet.</p>
                }
                @if (!Licence.CanManage)
                {
                    <p class="u-muted onprem__upload-detail">Only people who manage this Solution can import a licence.</p>
                }
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="card__head">
            <div>
                <h2 class="card__title">Installed apps</h2>
                <p class="card__sub">What the gateway last reported as installed@(tier is { Multitenant: true } ? $" in tenant {tier.TenantId}" : "").</p>
            </div>
        </div>
        @if (Apps is null)
        {
            <div class="card__body"><LoadingBlock Text="Loading installed apps..." /></div>
        }
        else if (Apps.Count == 0)
        {
            <EmptyState Icon="package" Title="No apps reported yet">
                <Text>The gateway reads the installed apps every 15 minutes while it is online. They appear here after its next reading.</Text>
            </EmptyState>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th scope="col">App</th><th scope="col">Publisher</th><th scope="col">Version</th></tr>
                </thead>
                <tbody>
                    @foreach (var app in Apps)
                    {
                        <tr>
                            <td>@app.Name</td>
                            <td class="u-muted">@app.Publisher</td>
                            <td class="u-num">@app.Version</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    /// <summary>The environment, from the fleet; <see cref="UpgradeFleetRow.IsOnPremises"/> is true.</summary>
    [Parameter, EditorRequired] public UpgradeFleetRow Row { get; set; } = default!;

    /// <summary>
    /// True for the part above the page's tabs (how fresh the facts are, the gateway's
    /// state, the meta row); false for the open tab's card.
    /// </summary>
    [Parameter] public bool Head { get; set; }

    /// <summary>True on the Apps tab; Overview otherwise.</summary>
    [Parameter] public bool ShowApps { get; set; }

    /// <summary>The installed-apps mirror; null while it is read.</summary>
    [Parameter] public List<InstalledAppRow>? Apps { get; set; }

    /// <summary>The delivery window, worded as the page words it.</summary>
    [Parameter] public string DeliveryWindow { get; set; } = "Any time";

    /// <summary>True for an Admin, who may open the gateway's own page.</summary>
    [Parameter] public bool CanSeeGateway { get; set; }

    /// <summary>The licence card's content; null while it is read. Only read on the Overview tab.</summary>
    [Parameter] public OnPremisesLicenceView? Licence { get; set; }

    /// <summary>Why the licence could not be read, when it could not.</summary>
    [Parameter] public string? LicenceError { get; set; }

    /// <summary>True for someone who manages the Solution: they may upload a licence.</summary>
    [Parameter] public bool CanManage { get; set; }

    /// <summary>True while an upload is being sent.</summary>
    [Parameter] public bool UploadingLicence { get; set; }

    /// <summary>Opens the upload dialog.</summary>
    [Parameter] public EventCallback OnUploadLicence { get; set; }

    /// <summary>Today on the customer's calendar, which is when a licence runs out.</summary>
    private DateOnly Today => OnPremisesLicenceService.TodayFor(Clock.GetUtcNow(), Row.TimeZone);

    private static string LicenceDate(DateOnly date) =>
        ALDevToolbox.Components.Pages.Admin.Administration.GatewayStatusText.LicenceDate(date);

    /// <summary>
    /// The one way to import a licence, in the expiry warning and on the Licence card. An
    /// outline button: nothing on this page is the primary action.
    /// </summary>
    private RenderFragment ImportButton => @<button type="button" class="btn btn--sm @(UploadingLicence ? "btn--loading" : "")"
                                                    @onclick="OnUploadLicence" disabled="@UploadingLicence">
        <Icon Name="upload" Width="14" Height="14" />
        <span class="btn__label">@(UploadingLicence ? "Sending the licence" : "Import licence...")</span>
    </button>;

    private static string UploadTone(LicenceImportState state) => state switch
    {
        LicenceImportState.Imported => "success",
        LicenceImportState.ImportedWithProblems => "warn",
        LicenceImportState.Unknown => "warn",
        LicenceImportState.Failed => "danger",
        LicenceImportState.Running => "running",
        _ => "queued",
    };

    private static string UploadWord(LicenceImportState state) => state switch
    {
        LicenceImportState.Imported => "Imported",
        LicenceImportState.ImportedWithProblems => "Imported, with problems",
        LicenceImportState.Failed => "Not imported",
        LicenceImportState.Unknown => "Not known",
        LicenceImportState.Running => "Importing",
        _ => "Waiting",
    };

    private static string GatewayHref(OnPremisesTierFacts tier) =>
        $"/admin/administration/gateways/{tier.GatewayId.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    /// <summary>A single-tenant server's one tenant is "default" in BC; the page says what that means.</summary>
    private static string TenantText(OnPremisesTierFacts? tier) =>
        tier is null ? "—" : tier.Multitenant == true ? tier.TenantId : "Single tenant";

    /// <summary>
    /// The expiry date alone: how soon it is, or that it has passed, is the warning above
    /// the tabs, which a narrow column would otherwise cut off.
    /// </summary>
    private static string LicenceText(OnPremisesTierFacts tier) =>
        tier.LicenceExpiresOn is { } expires ? LicenceDate(expires)
        : tier.Licensee is null ? "Not read yet" : "No expiry date";
}
