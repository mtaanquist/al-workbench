@page "/templates/workspace"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject TemplateService Templates
@inject FolderTreeHydrator FolderTree
@inject ApplicationVersionService Versions
@inject OrganizationConfigService OrgConfig
@inject GenerationService Gen
@inject GitHubRepositoryService GitHubRepos
@inject GitHubWorkspaceRepositoryService GitHubCreate
@inject GitHubRepositoryStandardsService Standards
@inject ToolEnablement Tools
@inject ILogger<NewWorkspace> Logger
@inject IJSRuntime JS
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Generation
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Services.Organizations
@using ALDevToolbox.Services.Templates
@using ALDevToolbox.Services.Tools
@using ALDevToolbox.Domain.Tools
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>New workspace · AL Workbench</PageTitle>

@*
    Archetype 5 (generator with live preview): a single form column beside a
    sticky aside holding the folder tree, the two counts and the Generate
    button. The button moved out of a sticky bottom bar and into that aside —
    the aside is sticky, so it stays reachable through a long form, and it now
    sits next to the preview of what it will produce.
    See .design/design-migration.md.
*@

<GeneratorPage Title="New workspace"
               IsLoading="@(_templates is null || _modules is null || _applicationVersions is null)"
               LoadingText="Loading templates..."
               IsEmpty="@(_templates is { Count: 0 })"
               FormId="gen-workspace-form" FormAction="/generate/workspace" OnSubmit="SubmitAsync"
               PrimaryNote="@GenerateNote">
    <SubtitleContent>
        Spin up a fresh AL workspace from one of your organisation's
        workspace templates. Pick the template, tweak the defaults that
        don't fit your project, and download the ZIP.
    </SubtitleContent>
    <Empty>
        <div class="card">
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="layers" Width="21" Height="21" /></span>
                <span class="empty-state__title">No workspace templates yet</span>
                <span class="empty-state__text">
                    A template describes the folders, settings and modules a new workspace
                    starts from. An admin can import one from the site catalogue.
                </span>
                <a class="btn btn--primary empty-state__action" href="/admin/templates">Import a template</a>
            </div>
        </div>
    </Empty>
    <Notices>
        @if (_errors.Count > 0)
        {
            <Alert Tone="AlertTone.Danger">
                <span>
                    @(_errors.Count == 1 ? "One thing needs fixing" : $"{_errors.Count} things need fixing")
                    before this workspace can be generated. Nothing you typed has been lost.
                    @if (_unfieldedErrors.Count > 0)
                    {
                        <text> @string.Join(" ", _unfieldedErrors)</text>
                    }
                </span>
            </Alert>
        }
    </Notices>
    <Form>
        <section class="form-sec">
            <div class="form-sec__head">
                <span class="section-label">Workspace template</span>
                <span class="form-sec__note">@_templates!.Count available</span>
            </div>
            <div class="field">
                <label class="field__label" for="ws-template">Template</label>
                <SelectBox>
                    <select class="select" id="ws-template" name="TemplateKey" required
                            @bind="_templateKey" @bind:after="OnTemplateChanged">
                        @foreach (var t in _templates)
                        {
                            <option value="@t.Key">@t.Name</option>
                        }
                    </select>
                </SelectBox>
                <FieldError Field="TemplateKey" Errors="_errors" />
                <p class="form-sec__cap">
                    @* Non-null here because OnInitializedAsync picks a
                       template whenever the list is non-empty and
                       publishes both in the same synchronous block, so
                       no render can see one without the other. *@
                    @_selected!.Description
                    @* Only when the template actually carries one — an
                       empty chip reads as a broken value, not an absent
                       default. *@
                    @if (!string.IsNullOrWhiteSpace(_selected.Defaults.Application))
                    {
                        <span> · Default application: <code class="code">@_selected.Defaults.Application</code></span>
                    }
                </p>
            </div>
        </section>

        <section class="form-sec">
            <div class="form-sec__head"><span class="section-label">Solution</span></div>
            <div class="form-grid">
                <div class="field">
                    <label class="field__label" for="ws-name">Solution <span class="req">*</span></label>
                    @* The customer is typed once. A customer already on
                       file here fills in what it knows; a new one is
                       offered as a new solution. See
                       .design/customer-naming.md.

                       An organisation that does not use Solutions gets
                       the plain field instead: there is nothing to pick
                       from and nothing would be registered, so offering
                       the choice would only promise something that never
                       happens (issue #772). *@
                    @if (_solutionsEnabled)
                    {
                        <SolutionPicker InputId="ws-name" InputName="WorkspaceName" Label="Solution"
                                        Placeholder="e.g. CRONUS A/S" MaxLength="100" Required="true"
                                        Hint="The customer's solution. Pick it if it exists, or type a new name to create one."
                                        Value="@_workspaceName" ValueChanged="OnCustomerNameChangedAsync"
                                        Selected="_solution" SelectedChanged="OnSolutionSelectedAsync"
                                        CreateNew="_createSolution" CreateNewChanged="OnCreateSolutionChanged" />
                        @* Carried through a failed submit so the choice made
                           before the round trip is still the choice after it. *@
                        <input type="hidden" name="SolutionId" value="@(_solutionId?.ToString() ?? string.Empty)" />
                    }
                    else
                    {
                        <input class="input" id="ws-name" type="text" name="WorkspaceName"
                               placeholder="e.g. CRONUS A/S" required maxlength="100"
                               value="@_workspaceName" @oninput="OnCustomerNameInput" />
                        <span class="field__hint">
                            The customer's solution, named as it should appear. Folder and file
                            names are derived from it.
                        </span>
                    }
                    <FieldError Field="WorkspaceName" Errors="_errors" />
                </div>
                <div class="field">
                    <label class="field__label" for="ws-short">Short name</label>
                    <input class="input" id="ws-short" type="text" name="ShortName" placeholder="e.g. CRO"
                           maxlength="50"
                           value="@_shortName" @oninput="OnShortNameInput" />
                    @if (_shortNameFromSolution && _solution is { } shortNameSource)
                    {
                        <span class="field__hint">
                            From @shortNameSource.Name's saved details. Change it here if this
                            workspace needs something different.
                        </span>
                    }
                    else
                    {
                        <span class="field__hint">
                            Optional. A short form of the solution's name for extension names, for
                            example <code class="code">CRO Core</code>. Also the default for the
                            extension prefix. Leave blank to use the full name.
                        </span>
                    }
                    <FieldError Field="ShortName" Errors="_errors" />
                </div>
                @* Only asked for when the organisation leaves the choice
                   per workspace. Under the other two policies the prefix
                   is already decided, and the endpoint resolves it
                   server-side either way - see ExtensionPrefixPolicy. *@
                @if (ShowExtensionPrefix)
                {
                    <div class="field">
                        <label class="field__label" for="ws-prefix">Extension prefix</label>
                        <input class="input" id="ws-prefix" type="text" name="ExtensionPrefix"
                               placeholder="e.g. CRONUS"
                               value="@ExtensionPrefix" @oninput="OnExtensionPrefixInput" />
                        <span class="field__hint">
                            Starts the name of every extension in this workspace, as in
                            <code class="code">CRONUS Core</code>.
                            @* What an emptied field will actually generate, said in
                               words rather than hidden in the placeholder. *@
                            @if (!string.IsNullOrWhiteSpace(ExtensionPrefixFallback))
                            {
                                <text>
                                    Leave blank to use <code class="code">@ExtensionPrefixFallback</code>.
                                </text>
                            }
                        </span>
                    </div>
                }
                <div class="field field--full">
                    <label class="field__label" for="ws-brief">Short description</label>
                    <input class="input" id="ws-brief" type="text" name="Brief" placeholder="One line, shown in app.json"
                           @bind="_brief" @bind:event="oninput" />
                </div>
                <div class="field field--full">
                    <label class="field__label" for="ws-desc">Long description</label>
                    <textarea class="textarea" id="ws-desc" name="Description" rows="3"
                              placeholder="Optional. Anything a colleague opening this workspace should know."
                              @bind="_description" @bind:event="oninput"></textarea>
                </div>
                <div class="field field--full">
                    <label class="field__label" for="ws-tenant">Tenant ID</label>
                    <input class="input" id="ws-tenant" type="text" name="TenantId"
                           pattern="^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                           placeholder="e.g. 8a4f1c3e-1b2d-4e6f-9c1a-3d5b7e9f2a4c"
                           title="GUID in 8-4-4-4-12 hex form."
                           value="@_tenantId" @oninput="OnTenantIdInput" />
                    @if (_tenantIdFromSolution && _solution is { } tenantSource)
                    {
                        <span class="field__hint">
                            From @tenantSource.Name's saved details. Change it here if this
                            workspace needs something different.
                        </span>
                    }
                    else
                    {
                        <span class="field__hint">
                            The customer's Microsoft Entra (Azure AD) tenant ID, so the generated
                            debug configuration targets the right tenant. Optional - leave it blank
                            if you don't have it yet.
                        </span>
                    }
                </div>
            </div>
        </section>

        <section class="form-sec">
            <div class="form-sec__head">
                <span class="section-label">Core ID range</span>
                <span class="form-sec__note">Modules get their own ranges</span>
            </div>
            <IdRangeEditor IdPrefix="ws-core"
                           FromName="CoreIdRangeFrom" ToName="CoreIdRangeTo"
                           Label="Object IDs (first / last)"
                           FromLabel="First object ID" ToLabel="Last object ID"
                           Hint="Per-tenant extensions start at 50000. AppSource apps must use an assigned range."
                           From="_coreIdRangeFrom" FromChanged="v => _coreIdRangeFrom = v"
                           To="_coreIdRangeTo" ToChanged="v => _coreIdRangeTo = v" />
            <FieldError Field="CoreIdRangeFrom" Errors="_errors" />
            <FieldError Field="CoreIdRangeTo" Errors="_errors" />
        </section>

        <section class="form-sec">
            <div class="form-sec__head"><span class="section-label">Application version</span></div>
            @if (_applicationVersions is null || _applicationVersions.Count == 0)
            {
                @* Fallback when the catalogue is empty - keep the form
                   submittable using the free-text values lifted from
                   the picked template's defaults. Admins can curate the
                   list under /admin/application-versions. *@
                <div class="field">
                    <label class="field__label" for="ws-app-version">Version</label>
                    <input class="input" id="ws-app-version" type="text" name="ApplicationVersion" required
                           @bind="_applicationVersion" @bind:event="oninput" />
                    <input type="hidden" name="RuntimeVersion" value="@_runtimeVersion" />
                    <span class="field__hint">
                        No application versions have been added for your organisation yet.
                        An admin can curate them under
                        <a href="/admin/application-versions">Application versions</a>.
                    </span>
                    <FieldError Field="ApplicationVersion" Errors="_errors" />
                </div>
            }
            else
            {
                <div class="field">
                    <label class="field__label" for="ws-app-version">Version</label>
                    <SelectBox>
                        <select class="select" id="ws-app-version" name="ApplicationVersion"
                                @bind="_applicationVersion" @bind:after="OnApplicationVersionChanged">
                            @* "Latest" sentinel: the endpoint resolves to
                               the highest-ordered active catalogue row at
                               submit time. Picking it sets the hidden
                               RuntimeVersion to the same sentinel so the
                               endpoint can swap both atomically. *@
                            <option value="@ApplicationVersionService.LatestSentinel">Latest (always highest)</option>
                            @* Orphan templates carry a free-text default
                               that doesn't necessarily appear in the curated
                               catalogue; render a synthetic option so the
                               browser keeps the orphan value selectable
                               until an admin assigns a real entry. Skip
                               this when the value is the Latest sentinel
                               since that already renders above. *@
                            @if (!string.Equals(_applicationVersion, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal)
                                && !_applicationVersions.Any(v => v.Application == _applicationVersion))
                            {
                                <option value="@_applicationVersion">@_applicationVersion (template default - not in catalogue)</option>
                            }
                            @foreach (var v in _applicationVersions)
                            {
                                <option value="@v.Application">@v.Name</option>
                            }
                        </select>
                    </SelectBox>
                    @* The runtime is derived from the picked entry; ship
                       it as a hidden input so the existing endpoint shape
                       (separate ApplicationVersion + RuntimeVersion fields)
                       keeps working. *@
                    <input type="hidden" name="RuntimeVersion" value="@_runtimeVersion" />
                    <span class="field__hint">
                        application <code class="code">@_applicationVersion</code> ·
                        runtime <code class="code">@_runtimeVersion</code>
                    </span>
                    <FieldError Field="ApplicationVersion" Errors="_errors" />
                    <FieldError Field="RuntimeVersion" Errors="_errors" />
                </div>
            }
        </section>

        @if (_optionalExtensions.Count > 0)
        {
            <section class="form-sec">
                <div class="form-sec__head">
                    <span class="section-label">Additional extensions</span>
                    <span class="form-sec__note">@_selectedExtensionPaths.Count of @_optionalExtensions.Count selected</span>
                </div>
                <p class="form-sec__cap">
                    Optional extensions declared by this template. Tick to include
                    them in the generated workspace alongside the required ones.
                </p>
                <div class="module-list">
                    @foreach (var ext in _optionalExtensions.OrderBy(e => e.Path, StringComparer.OrdinalIgnoreCase))
                    {
                        var picked = _selectedExtensionPaths.Contains(ext.Path);
                        <label class="module-card @(picked ? "is-selected" : "")">
                            <input type="checkbox" name="SelectedExtensionPaths" value="@ext.Path"
                                   checked="@picked"
                                   @onchange="e => OnExtensionToggled(ext.Path, (bool)(e.Value ?? false))" />
                            <span class="module-card__row">
                                <span class="module-card__title">@ext.Path</span>
                            </span>
                            <span class="module-card__text">@ext.NameTemplate</span>
                            <span class="module-card__check"><Icon Name="check" Width="12" Height="12" /></span>
                        </label>
                    }
                </div>
            </section>
        }

        <section class="form-sec">
            <div class="form-sec__head">
                <span class="section-label">Modules</span>
                @if (_modules!.Count > 0)
                {
                    <span class="form-sec__note">@_selectedModuleKeys.Count of @_modules.Count selected</span>
                }
            </div>
            @if (_modules.Count == 0)
            {
                <p class="form-sec__cap">
                    No modules are available in your organisation. A template still
                    generates its own extensions without them.
                </p>
            }
            else
            {
                <div class="module-list">
                    @foreach (var m in _modules)
                    {
                        var picked = _selectedModuleKeys.Contains(m.Key);
                        <label class="module-card @(picked ? "is-selected" : "")">
                            <input type="checkbox" name="SelectedModuleKeys" value="@m.Key"
                                   checked="@picked"
                                   @onchange="e => OnModuleToggled(m.Key, (bool)(e.Value ?? false))" />
                            <span class="module-card__row">
                                <span class="module-card__title">@m.Name</span>
                                <span class="module-card__id">@m.Key</span>
                            </span>
                            <span class="module-card__deps">
                                <Icon Name="link" Width="12" Height="12" />
                                @(m.Dependencies.Count == 0
                                    ? "no extra dependencies"
                                    : $"+ {m.Dependencies.Count} {(m.Dependencies.Count == 1 ? "dependency" : "dependencies")}")
                            </span>
                            <span class="module-card__check"><Icon Name="check" Width="12" Height="12" /></span>
                        </label>
                    }
                </div>
                <span class="field__hint">
                    Each module becomes its own extension folder, with its own ID range.
                </span>
            }
        </section>
    </Form>
    <Preview>
        <div class="card">
            <div class="card__head">
                <div>
                    <h4 class="card__title">Preview</h4>
                    <p class="card__sub">@PreviewRootName</p>
                </div>
                @* The example-files switch lives here, not in the form
                   below: flipping it strikes the affected rows out of
                   the tree beside it, which is the whole explanation
                   the option needs. *@
                <div class="preview__head-tools">
                    <Switch Name="IncludeExamples" Label="Include example files"
                            @bind-Checked="_includeExamples" />
                    <StatusPill Tone="live">Live</StatusPill>
                </div>
            </div>
            @* Switch drives component state, so it posts nothing of its
               own - this carries the value into the form post. *@
            <input type="hidden" name="IncludeExamples" value="@(_includeExamples ? "true" : "false")" />
            <FolderTreePreview Root="BuildPreview()" />
        </div>
    </Preview>
    <Stats>
        <div class="stat-card">
            <span class="stat-card__label">Extensions</span>
            <span class="stat-card__value">@CountExtensions()</span>
        </div>
        <div class="stat-card stat-card--accent">
            <span class="stat-card__label">Dependencies</span>
            <span class="stat-card__value">@CountDependencies()</span>
        </div>
    </Stats>
    <PrimaryLabel><Icon Name="download" Width="15" Height="15" /> Download ZIP</PrimaryLabel>
    <AsideCards>
        @* The second way to take delivery (issue #622). Deliberately
           not a second primary button: the ZIP is still the default,
           and this one says what it is about to do before it is
           pressed, because it creates something in the customer's
           GitHub organisation that cannot be un-created from here. *@
        <div class="card">
            <div class="card__head">
                <div>
                    <h4 class="card__title">Create it on GitHub</h4>
                    <p class="card__sub">Optional</p>
                </div>
            </div>
            <div class="card__body ws-repo">
                @if (_createdRepo is not null)
                {
                    <Alert Tone="AlertTone.Success">
                        <span class="u-stack">
                            <span>
                                <strong>@_createdRepo.Repository.FullName</strong> is ready, with
                                @_createdRepo.FileCount @(_createdRepo.FileCount == 1 ? "file" : "files")
                                committed to <code class="code">@_createdRepo.Repository.DefaultBranch</code>.
                                @if (_createdRepo.StandardsFileCount > 0)
                                {
                                    @* Worded to match what the card
                                       promised before the button was
                                       pressed. A bare count of
                                       "standard files" names
                                       something this page never
                                       defined. *@
                                    <text>
                                        Your organisation's standard files and branch rules
                                        were added too.
                                    </text>
                                }
                            </span>
                            @* The working branches and their build
                               pipelines, so the consultant knows where
                               to start and where the builds are. *@
                            @if (_createdRepo.Branches is { Count: > 0 } branches)
                            {
                                <span>
                                    Also created the @CodeList(branches) @(branches.Count == 1 ? "branch" : "branches") from
                                    <code class="code">@_createdRepo.Repository.DefaultBranch</code>.
                                </span>
                            }
                            @if (_createdRepo.PipelineNames is { Count: > 0 } pipelines
                                 && _createdRepo.SolutionId is { } pipelineSolutionId)
                            {
                                <span>
                                    @(pipelines.Count == 1 ? "The build pipeline for" : "Build pipelines for")
                                    @CodeList(pipelines) @(pipelines.Count == 1 ? "is" : "are") on the solution's
                                    <a href="@($"/solutions/{pipelineSolutionId}?tab=pipelines")">Pipelines tab</a>.
                                </span>
                            }
                            @* The things a consultant does next, side by
                               side. All outline buttons - Download ZIP is
                               still the page's one primary action (#812). *@
                            <span class="ws-repo-actions">
                                <a class="btn" href="@_createdRepo.Repository.HtmlUrl"
                                   target="_blank" rel="noopener">
                                    <Icon Name="external-link" Width="15" Height="15" />
                                    <span>Open it on GitHub</span>
                                    <span class="u-sr">(opens in a new tab)</span>
                                </a>
                                @* VS Code's own URL handler: it opens
                                   VS Code and starts its clone flow.
                                   Nothing happens on a machine without
                                   VS Code, which is why the command
                                   below stays on the card. *@
                                <a class="btn" href="@RepositoryLinks.VsCodeCloneUrl(_createdRepo.Repository.CloneUrl)">
                                    <Icon Name="code" Width="15" Height="15" />
                                    <span>Clone in VS Code</span>
                                </a>
                            </span>
                            @* A click that opens nothing is the worst
                               outcome here, so say what to expect and
                               point at the way out of it. *@
                            <small class="field__hint">
                                Your browser will ask to open VS Code. If nothing happens,
                                use the command below.
                            </small>
                            @* Where the customer now lives, so the
                               consultant can go straight on to
                               builds and pipelines (#759). *@
                            @if (_createdRepo.SolutionId is { } solutionId)
                            {
                                <span>
                                    @(_createdRepo.SolutionCreated ? "Created the solution" : "Registered on the solution")
                                    <a href="@($"/solutions/{solutionId}")">@_createdRepo.SolutionName</a>.
                                </span>
                            }
                            @* The fallback for a machine without VS
                               Code, and for anyone who would rather
                               type it. Copy button wired the same
                               way the docs pages wire theirs - one
                               delegated listener in
                               copy-to-clipboard.js, loaded in the
                               shell, so this needs no interop. *@
                            <span class="ws-repo-clone">
                                <span class="ws-repo-clone__label">Or clone it yourself:</span>
                                <code class="code" id="ws-repo-clone-command">git clone @_createdRepo.Repository.CloneUrl</code>
                                <CopyButton Target="#ws-repo-clone-command" />
                            </span>
                        </span>
                    </Alert>
                    @if (!string.IsNullOrEmpty(_createdRepo.SolutionWarning))
                    {
                        @* The repository is there and holds the files;
                           only the customer's solution is missing. *@
                        <Alert Tone="AlertTone.Warn">
                            <span>@_createdRepo.SolutionWarning</span>
                        </Alert>
                    }
                    @if (!string.IsNullOrEmpty(_createdRepo.BranchesWarning))
                    {
                        <Alert Tone="AlertTone.Warn">
                            <span>@_createdRepo.BranchesWarning</span>
                        </Alert>
                    }
                    @if (!string.IsNullOrEmpty(_createdRepo.PipelinesWarning))
                    {
                        <Alert Tone="AlertTone.Warn">
                            <span>
                                @_createdRepo.PipelinesWarning
                                @if (_createdRepo.SolutionId is { } warnSolutionId)
                                {
                                    <a href="@($"/solutions/{warnSolutionId}?tab=pipelines")">Open the Pipelines tab</a>
                                }
                            </span>
                        </Alert>
                    }
                    @if (!string.IsNullOrEmpty(_createdRepo.StandardsWarning))
                    {
                        @* The repository is there and holds the files; only
                           the branch rules are missing. A warning beside the
                           success, not instead of it (#628). *@
                        <Alert Tone="AlertTone.Warn">
                            <span>@_createdRepo.StandardsWarning</span>
                        </Alert>
                    }
                }
                else if (_gitHub is null)
                {
                    <div class="loading-block">
                        <span class="spinner"></span><span>Loading...</span>
                    </div>
                }
                else if (_gitHub.Readiness == GitHubRepositoryReadiness.NotConfigured)
                {
                    <p>GitHub is not set up on this server yet, so the ZIP is the only way out of here.</p>
                    <AuthorizeView Roles="SiteAdmin">
                        <Authorized>
                            <a class="btn" href="/site-admin/settings/github">
                                <Icon Name="folder-git-2" Width="15" Height="15" />
                                <span>Set up GitHub</span>
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <p class="field__hint">
                                Ask whoever runs AL Workbench to set it up.
                            </p>
                        </NotAuthorized>
                    </AuthorizeView>
                }
                else if (_gitHub.Readiness == GitHubRepositoryReadiness.NotConnected)
                {
                    <p>Your organisation has not connected a GitHub organisation yet, so there is nowhere to create this.</p>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <a class="btn" href="/admin/administration/repositories">
                                <Icon Name="folder-git-2" Width="15" Height="15" />
                                <span>Connect a GitHub organisation</span>
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <p class="field__hint">
                                Ask one of your administrators to connect it, under
                                Administration &#8594; Repositories.
                            </p>
                        </NotAuthorized>
                    </AuthorizeView>
                }
                else if (_gitHub.Readiness == GitHubRepositoryReadiness.LinkNeedsRepair)
                {
                    <p>
                        Your GitHub account is no longer connected to the workbench, so it cannot
                        check that you are in @_gitHub.OrgLogin.
                    </p>
                    <a class="btn" href="/account?section=repos">
                        <Icon Name="refresh-cw" Width="15" Height="15" />
                        <span>Connect again</span>
                    </a>
                }
                else if (_gitHub.Readiness == GitHubRepositoryReadiness.NotLinked)
                {
                    <p>
                        Connect your GitHub account and this workspace can be created as a
                        repository in @_gitHub.OrgLogin instead of downloaded.
                    </p>
                    <a class="btn" href="/account?section=repos">
                        <Icon Name="link" Width="15" Height="15" />
                        <span>Connect your GitHub account</span>
                    </a>
                }
                else
                {
                    <p>
                        Creates <strong>@_gitHub.OrgLogin/@RepositoryName</strong> on GitHub and
                        commits the generated files to it.
                        @if (_standardsSummary is not null)
                        {
                            @* Said, not offered: the standards are the
                               organisation's, and this person does not
                               choose per repository whether to follow
                               them (#628). *@
                            <text>
                                Your administrators have set files and branch rules that every new
                                repository here starts with; they will be added for you.
                            </text>
                        }
                    </p>
                    <div class="field">
                        <label class="field__label" for="ws-repo-name">Repository name</label>
                        @* No name= attribute: this field belongs to the
                           button below, not to the form's native POST. *@
                        <input class="input" id="ws-repo-name" type="text"
                               pattern="@GitHubWorkspaceRepositoryService.NamePattern" required
                               maxlength="100"
                               placeholder="e.g. CRONUS-Customer"
                               value="@RepositoryName"
                               @oninput="OnRepositoryNameInput" />
                        <FieldError Field="GitHubRepositoryName" Errors="_repoErrors" />
                        <small class="field__hint">
                            Letters, digits, hyphens, underscores and full stops.
                        </small>
                    </div>
                    <div class="field">
                        <label class="field__label" for="ws-repo-visibility">Who can see it</label>
                        <SelectBox>
                            @* Bound as text, not as the bool it stands
                               for: Blazor formats a bool as "True",
                               which matches no option value and leaves
                               the control looking empty. *@
                            <select class="select" id="ws-repo-visibility" @bind="_repoVisibility">
                                <option value="private">Only people in @_gitHub.OrgLogin</option>
                                <option value="public">Anyone on GitHub</option>
                            </select>
                        </SelectBox>
                    </div>
                    <FieldError Field="GitHubRepository" Errors="_repoErrors" />
                    @* The customer's solution is chosen a column
                       away, but this is the button that was pressed,
                       so this is where the refusal has to be. *@
                    <FieldError Field="SolutionId" Errors="_repoErrors" />
                    @* Same spinner-and-busy-label treatment the
                       Download ZIP button gets. Creating the
                       repository runs for seconds, and "disabled"
                       on its own reads as "broken" rather than
                       "working" (#812). The class is driven from
                       Blazor here rather than by generate.js: this
                       button posts nothing, so there is no form
                       submission for that script to hang off. *@
                    <button type="button" class="btn ws-repo__create @(_repoBusy ? "btn--loading" : null)"
                            disabled="@_repoBusy" aria-busy="@(_repoBusy ? "true" : null)"
                            @onclick="CreateRepositoryAsync">
                        <span class="btn__spinner" aria-hidden="true"></span>
                        <span class="btn__label">
                            <Icon Name="folder-git-2" Width="15" Height="15" /> Create repository
                        </span>
                        <span class="btn__label-busy">Creating repository...</span>
                    </button>
                }
            </div>
        </div>

        @* What this customer already has. A second workspace for the
           same customer is a fine thing to want - it just should not
           happen by accident. *@
        @if (_solutionsEnabled && _solution is { Repositories.Count: > 0 } solution)
        {
            <div class="card">
                <div class="card__head">
                    <div>
                        <h4 class="card__title">Existing work for @solution.Name</h4>
                    </div>
                </div>
                <div class="card__body">
                    <p>
                        You have set this customer up before. Another workspace is fine, but
                        check these first in case what you need is already there.
                    </p>
                    <ul class="ws-solution-repos">
                        @foreach (var repo in solution.Repositories)
                        {
                            <li>
                                <a href="@repo.Url" target="_blank" rel="noopener">
                                    @RepositoryLabel(repo)
                                    <span class="u-sr">(opens in a new tab)</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </AsideCards>
</GeneratorPage>

@code {
    /// <summary>The line under Generate, saying what it is about to produce.</summary>
    private string GenerateNote
    {
        get
        {
            var count = CountExtensions();
            var noun = count == 1 ? "extension" : "extensions";
            return _selected is null ? $"{count} {noun}" : $"{count} {noun} from {_selected.Name}";
        }
    }

    [SupplyParameterFromQuery(Name = "template")] public string? PreselectedTemplate { get; set; }

    // Cascaded by CascadingAuthenticationState. The signed-in principal carries
    // the organisation's switched-off tools, which is how this page knows
    // whether to offer Solutions - the same claim the sidebar reads.
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<RuntimeTemplate>? _templates;
    private List<ALDevToolbox.Domain.Entities.Module>? _modules;
    private List<ApplicationVersion>? _applicationVersions;
    private RuntimeTemplate? _selected;

    // Form state. Mirrors what the form posts to /generate/workspace; the live
    // preview reads from these same fields so it always reflects the user's
    // current input.
    private string _templateKey = string.Empty;
    private string _workspaceName = string.Empty;
    private string _shortName = string.Empty;
    private string _brief = string.Empty;
    private string _description = string.Empty;
    private int _coreIdRangeFrom;
    private int _coreIdRangeTo;
    private string _applicationVersion = string.Empty;
    private string _runtimeVersion = string.Empty;
    private string _extensionPrefix = string.Empty;
    /// <summary>
    /// True once the user has typed a prefix themselves, after which the short
    /// name stops steering it - the same rule the repository name follows.
    /// </summary>
    private bool _extensionPrefixEdited;
    private readonly HashSet<string> _selectedModuleKeys = new(StringComparer.Ordinal);
    /// <summary>
    /// Paths of optional template-declared extensions the user ticked. The
    /// required ones are emitted regardless and don't go through this set.
    /// </summary>
    private readonly HashSet<string> _selectedExtensionPaths = new(StringComparer.Ordinal);
    /// <summary>Cache of the picked template's optional extensions for rendering checkboxes.</summary>
    private List<WorkspaceExtension> _optionalExtensions = new();
    private bool _includeExamples = true;
    /// <summary>
    /// Microsoft Entra tenant ID surfaced via <c>{{tenant_id}}</c> mustache
    /// substitution. Optional - users who don't know it leave it blank;
    /// downstream substitutions then resolve to the empty string.
    /// </summary>
    private string _tenantId = string.Empty;

    private OrganizationConfig? _orgConfig;

    /// <summary>
    /// Whether this organisation uses Solutions at all. When it does not, the
    /// Customer field is a plain box, nothing is registered when a repository
    /// is created, and the success state has no solution to link (issue #772).
    /// </summary>
    private bool _solutionsEnabled = true;

    // The customer as a Solution (issue #758). Either an existing one was
    // picked, or the typed name was marked as a new one; both are carried for
    // the repository step, which is what actually registers it.
    private SolutionOption? _solution;
    private int? _solutionId;
    private bool _createSolution;
    /// <summary>
    /// True while the short name / tenant ID on screen are the picked solution's
    /// rather than this person's, so clearing the pick takes back what the pick
    /// filled in and leaves anything they typed themselves alone.
    /// </summary>
    private bool _shortNameFromSolution;
    private bool _tenantIdFromSolution;

    /// <summary>
    /// The plain Customer field's own handler, for the organisations that do
    /// not use Solutions and so never see the picker.
    /// </summary>
    private void OnCustomerNameInput(ChangeEventArgs e)
    {
        _workspaceName = e.Value?.ToString() ?? string.Empty;
        OnPlanChanged();
    }

    private Task OnCustomerNameChangedAsync(string value)
    {
        _workspaceName = value;
        OnPlanChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Carries over what the picked solution already knows. Clearing the pick
    /// takes those values back out again - but only those: a short name typed
    /// afterwards is the user's, and stays.
    /// </summary>
    private Task OnSolutionSelectedAsync(SolutionOption? solution)
    {
        _solution = solution;
        _solutionId = solution?.Id;

        if (solution is null)
        {
            if (_shortNameFromSolution) _shortName = string.Empty;
            if (_tenantIdFromSolution) _tenantId = string.Empty;
            _shortNameFromSolution = false;
            _tenantIdFromSolution = false;
            OnPlanChanged();
            return Task.CompletedTask;
        }

        _createSolution = false;
        if (!string.IsNullOrWhiteSpace(solution.ShortName))
        {
            _shortName = solution.ShortName!;
            _shortNameFromSolution = true;
        }
        if (solution.BcTenantId is { } tenantId)
        {
            _tenantId = tenantId.ToString();
            _tenantIdFromSolution = true;
        }
        OnPlanChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// How one of the customer's repositories is named on screen: the
    /// owner/name it is known by on GitHub or Azure DevOps, taken from its URL,
    /// falling back to whatever it was given as a display name.
    /// </summary>
    private static string RepositoryLabel(SolutionRepositoryOption repo)
    {
        if (Uri.TryCreate(repo.Url, UriKind.Absolute, out var uri))
        {
            var segments = uri.AbsolutePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (segments.Length >= 2)
            {
                var name = segments[^1];
                if (name.EndsWith(".git", StringComparison.OrdinalIgnoreCase)) name = name[..^4];
                // Azure DevOps spells its clone URLs org/project/_git/repo, so
                // the segment before the name is a marker, not an owner.
                var owner = segments[^2] == "_git" && segments.Length >= 3 ? segments[^3] : segments[^2];
                return $"{owner}/{name}";
            }
        }
        return repo.DisplayName;
    }

    private void OnCreateSolutionChanged(bool createNew)
    {
        _createSolution = createNew;
    }

    private void OnShortNameInput(ChangeEventArgs e)
    {
        _shortName = e.Value?.ToString() ?? string.Empty;
        _shortNameFromSolution = false;
        OnPlanChanged();
    }

    private void OnTenantIdInput(ChangeEventArgs e)
    {
        _tenantId = e.Value?.ToString() ?? string.Empty;
        _tenantIdFromSolution = false;
    }

    // The GitHub half (issue #622). _gitHub is answered from the database, so
    // the card renders its guidance even when GitHub itself is unreachable;
    // _repoErrors is that card's own feedback, kept apart from the form's so
    // neither explains the other's outcome.
    private GitHubRepositoryAccess? _gitHub;
    private string _repositoryName = string.Empty;
    /// <summary>
    /// True once the user has typed in the repository name themselves, after
    /// which the workspace name stops steering it - renaming the workspace must
    /// not quietly undo a name they chose.
    /// </summary>
    private bool _repositoryNameEdited;
    /// <summary>
    /// Who will be able to see the repository, as the select's own value.
    /// Private by default: a customer's code is the norm, and the choice that
    /// cannot be undone quietly is the one that should not be the default.
    /// </summary>
    private string _repoVisibility = "private";
    private bool _repoBusy;
    private Dictionary<string, string> _repoErrors = new();
    private GitHubWorkspaceRepository? _createdRepo;
    /// <summary>
    /// What the organisation's repository standards amount to, or null when
    /// nothing is configured - in which case the card says nothing about them
    /// rather than saying there are none (#628).
    /// </summary>
    private string? _standardsSummary;

    /// <summary>
    /// Whether this organisation asks for a prefix per workspace at all. The
    /// other two policies already know the answer, so the field is not shown.
    /// </summary>
    private bool ShowExtensionPrefix =>
        _orgConfig is null || ExtensionPrefixPolicy.IsAskedFor(_orgConfig.Settings.ExtensionPrefixMode);

    /// <summary>
    /// The prefix this workspace will be generated with. What the user typed
    /// once they have typed something; otherwise whatever the organisation's
    /// policy resolves to - the org's own value, or the short name, so a
    /// workspace still gets "CRO Core" rather than " Core". The server resolves
    /// this again from the same rule, so a hidden field cannot smuggle a value
    /// past the organisation's policy.
    /// </summary>
    private string ExtensionPrefix =>
        _extensionPrefixEdited ? _extensionPrefix : ExtensionPrefixFallback;

    /// <summary>
    /// What an untouched (or emptied) prefix field generates: the
    /// organisation's own prefix when it has one, the customer's short name
    /// otherwise. The same rule the server applies.
    /// </summary>
    private string ExtensionPrefixFallback =>
        _orgConfig is null
            ? _shortName.Trim()
            : ExtensionPrefixPolicy.Resolve(_orgConfig.Settings, null, _shortName, _workspaceName);

    private void OnExtensionPrefixInput(ChangeEventArgs e)
    {
        _extensionPrefixEdited = true;
        _extensionPrefix = e.Value?.ToString() ?? string.Empty;
        OnPlanChanged();
    }

    /// <summary>
    /// The name in the field, or the one the workspace name suggests while the
    /// user has not typed one. One rule, shared with the service, so the name
    /// shown in "Creates org/name" is the name that gets created.
    /// </summary>
    private string RepositoryName => _repositoryNameEdited
        ? _repositoryName
        : GitHubWorkspaceRepositoryService.SuggestName(_workspaceName, RepositoryStyle);

    /// <summary>The organisation's repository naming style, or the default while the config loads.</summary>
    private NamingStyle RepositoryStyle =>
        _orgConfig?.Settings.NamingRepositoryStyle ?? NamingStyle.KebabCase;

    /// <summary>The organisation's folder naming style, or the default while the config loads.</summary>
    private NamingStyle FolderStyle =>
        _orgConfig?.Settings.NamingFolderStyle ?? NamingStyle.PascalCase;

    /// <summary>
    /// Field-keyed problems from the last submit attempt, straight from
    /// <see cref="GenerationService.ValidateWorkspaceAsync"/>. Empty until the
    /// user presses Generate - this form is long, and marking fields red while
    /// someone is still filling it in is noise, not help.
    /// </summary>
    private IReadOnlyDictionary<string, string> _errors =
        new Dictionary<string, string>();

    /// <summary>
    /// Messages whose key names no field on this page - the cross-extension
    /// id-range overlaps, keyed <c>Extensions[n].IdRange</c>. They have nowhere
    /// inline to go, so the summary carries them rather than dropping them.
    /// </summary>
    private List<string> _unfieldedErrors = new();

    /// <summary>Keys that have a <c>FieldError</c> slot in the markup above.</summary>
    private static readonly HashSet<string> FieldedKeys = new(StringComparer.Ordinal)
    {
        "TemplateKey", "WorkspaceName", "ShortName", "CoreIdRangeFrom", "CoreIdRangeTo",
        "ApplicationVersion", "RuntimeVersion",
    };

    /// <summary>
    /// Runs the generator's own rules before the form is allowed to post.
    /// Everything the browser can check (required, pattern) has already run by
    /// the time a submit event fires; this covers what only the server knows -
    /// a missing template, overlapping id ranges, an empty version catalogue
    /// behind "Latest".
    /// </summary>
    private async Task SubmitAsync()
    {
        var plan = await BuildValidPlanAsync();
        if (plan is null) return;

        // Clean: hand off to generate.js, which starts the loading state and
        // posts the form natively so the ZIP streams back as a download.
        await JS.InvokeVoidAsync("aldtGenerate.submit", "gen-workspace-form");
    }

    /// <summary>
    /// The plan this form describes, resolved and checked - or null, with the
    /// problems already on screen. Shared by the two ways of taking delivery
    /// (the ZIP and the repository) so neither can accept a plan the other
    /// would refuse.
    /// </summary>
    private async Task<ProjectPlan?> BuildValidPlanAsync()
    {
        // Resolve the "Latest" sentinel the way the endpoint does, so a plan
        // that cannot resolve is caught here rather than on the error page.
        var application = _applicationVersion;
        var runtime = _runtimeVersion;
        if (string.Equals(application, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal)
            || string.Equals(runtime, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal))
        {
            var latest = await Versions.GetLatestAsync();
            if (latest is null)
            {
                SetErrors(new Dictionary<string, string>
                {
                    ["ApplicationVersion"] = "\"Latest\" needs at least one application version to pick from, "
                        + "and none have been added yet. Choose a specific version, or ask an admin to add one.",
                });
                return null;
            }
            application = latest.Application;
            runtime = latest.Runtime;
        }

        var plan = new ProjectPlan(
            TemplateKey: _templateKey,
            WorkspaceName: _workspaceName.Trim(),
            ShortName: _shortName.Trim(),
            ExtensionPrefix: ExtensionPrefix.Trim(),
            Brief: _brief.Trim(),
            Description: _description.Trim(),
            ApplicationVersion: application,
            RuntimeVersion: runtime,
            CoreIdRangeFrom: _coreIdRangeFrom,
            CoreIdRangeTo: _coreIdRangeTo,
            IncludeExamples: _includeExamples,
            SelectedExtensionPaths: _selectedExtensionPaths.ToList(),
            SelectedModuleKeys: _selectedModuleKeys.ToList(),
            TenantId: _tenantId.Trim());

        SetErrors(await Gen.ValidateWorkspaceAsync(plan));
        return _errors.Count > 0 ? null : plan;
    }

    /// <summary>
    /// Creates the repository and puts the generated workspace in it. The
    /// service owns every rule - which organisation, who may create there, and
    /// which credential acts - so the MCP tool behaves identically.
    /// </summary>
    private async Task CreateRepositoryAsync()
    {
        // Every one of these has to be set before the first await. Blazor
        // renders an event handler's synchronous prefix when it first yields
        // and again when the whole handler finishes - not at each await in
        // between. Setting the flag after validating the plan meant the render
        // that happens at that yield still saw an idle button, and the create
        // itself (one call per generated file) ran with nothing on screen to
        // say so, which is what invited the second click (#812).
        _repoErrors = new();
        _createdRepo = null;
        _repoBusy = true;

        try
        {
            var plan = await BuildValidPlanAsync();
            if (plan is null) return;

            _createdRepo = await GitHubCreate.CreateAsync(
                plan, RepositoryName, isPrivate: _repoVisibility != "public", solutionId: _solutionId);

            // The customer is on file now, whichever way round it happened, so
            // the picker stops offering to create them and shows the solution
            // they are: a second press adds to that solution rather than trying
            // to create it again.
            if (_createdRepo is { SolutionId: { } registeredId, SolutionName: { } registeredName })
            {
                _solutionId = registeredId;
                _createSolution = false;
                _solution = new SolutionOption(
                    registeredId,
                    registeredName,
                    string.IsNullOrWhiteSpace(_shortName) ? null : _shortName.Trim(),
                    Guid.TryParse(_tenantId.Trim(), out var tenant) ? tenant : null,
                    // No repositories listed on purpose: the card that lists
                    // them exists to catch a customer set up before this
                    // session, and the repository just made is already named in
                    // the success state above it.
                    []);
            }
        }
        catch (PlanValidationException ex)
        {
            // Problems with the repository belong in this card; anything about
            // the plan itself belongs on the field that caused it.
            _repoErrors = ex.Errors
                .Where(e => e.Key is "GitHubRepository" or "GitHubRepositoryName" or "SolutionId")
                .ToDictionary(e => e.Key, e => e.Value, StringComparer.Ordinal);
            var fieldErrors = ex.Errors
                .Where(e => e.Key is not ("GitHubRepository" or "GitHubRepositoryName" or "SolutionId"))
                .ToDictionary(e => e.Key, e => e.Value);
            if (fieldErrors.Count > 0) SetErrors(fieldErrors);
        }
        catch (GitHubApiException ex)
        {
            Logger.LogWarning(ex, "GitHub refused to create the repository {RepositoryName}.", RepositoryName);
            _repoErrors = new Dictionary<string, string>
            {
                ["GitHubRepository"] = $"GitHub would not do that: {ex.Message}",
            };
        }
        catch (Exception ex) when (ex is GitHubAppNotConfiguredException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Could not reach GitHub to create the repository {RepositoryName}.", RepositoryName);
            _repoErrors = new Dictionary<string, string>
            {
                ["GitHubRepository"] = "The workbench could not reach GitHub just now, so nothing was created. "
                    + "Try again in a minute.",
            };
        }
        finally
        {
            _repoBusy = false;
        }
    }

    /// <summary>Branch names as code, joined the way a sentence lists them: "a, b and c".</summary>
    private static RenderFragment CodeList(IReadOnlyList<string> items) => builder =>
    {
        for (var i = 0; i < items.Count; i++)
        {
            if (i > 0) builder.AddContent(0, i == items.Count - 1 ? " and " : ", ");
            builder.OpenElement(1, "code");
            builder.AddAttribute(2, "class", "code");
            builder.AddContent(3, items[i]);
            builder.CloseElement();
        }
    };

    /// <summary>
    /// The name the user typed. Once they have touched the field the workspace
    /// name stops steering it, and a field they empty stays empty rather than
    /// silently refilling itself.
    /// </summary>
    private void OnRepositoryNameInput(ChangeEventArgs e)
    {
        _repositoryNameEdited = true;
        _repositoryName = e.Value?.ToString() ?? string.Empty;
        _repoErrors = new();
    }

    /// <summary>
    /// A repository created for "CRONUS Customer" is not evidence about "CRONUS
    /// Reseller", so the success state goes as soon as the plan behind it does.
    /// </summary>
    private void OnPlanChanged()
    {
        if (_createdRepo is null) return;
        _createdRepo = null;
        _repoErrors = new();
    }

    private void SetErrors(IReadOnlyDictionary<string, string> errors)
    {
        _errors = errors;
        _unfieldedErrors = errors
            .Where(e => !FieldedKeys.Contains(e.Key))
            .Select(e => e.Value)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        // Load into locals, then publish every field in one synchronous block
        // at the end. ComponentBase renders as soon as this method first
        // yields, so assigning the fields as each await returns lets a render
        // catch the page half-loaded: the guard at the top only tests the
        // three collections, and once they are set the form below runs -
        // dereferencing _selected, which is picked last. Whether that render
        // lands in the gap depends on which of these reads happens to
        // complete synchronously, which is why it only ever showed up
        // intermittently. Publishing atomically closes the gap for good.
        var solutionsEnabled = AuthStateTask is null
            || Tools.IsEnabled(ToolKey.Projects, (await AuthStateTask).User);
        var templates = await Templates.GetTemplatesAsync(includeDeprecated: false);
        var modules = await Templates.GetModulesAsync(includeDeprecated: false);
        // Folder/file trees aren't pulled by the default reads - load them on
        // top so the live preview can walk each extension's real layout
        // without an extra round-trip when the user picks a template or
        // toggles a module.
        // Paths only: the preview draws the layout, never a file's body, and
        // reading every example AL file to render a list of names is the whole
        // template's text pulled across for nothing.
        await FolderTree.HydrateExtensionFolderTreeAsync(templates, pathsOnly: true);
        await FolderTree.HydrateModuleExtensionFolderTreeAsync(modules, pathsOnly: true);
        var applicationVersions = await Versions.GetActiveAsync(includeDeprecated: false);
        var orgConfig = await OrgConfig.GetCurrentAsync();
        // Whether this workspace can be created as a repository, and why not
        // when it cannot. Two cached reads, no call to GitHub - so the card
        // below renders its guidance even while GitHub is unreachable.
        var gitHub = await GitHubRepos.GetAccessAsync();
        // One more database read, no call to GitHub: whether this organisation
        // has repository standards, which the card mentions before the button
        // is pressed rather than after (#628).
        var standardsSummary = await Standards.GetSummaryAsync();
        // Honour the ?template=<key> hint from the Templates browser when present
        // and the key matches an active template; otherwise fall back to the
        // per-org default flagged in admin, then the first row in the list.
        var selected = (!string.IsNullOrWhiteSpace(PreselectedTemplate)
            ? templates.FirstOrDefault(t => t.Key == PreselectedTemplate)
            : null)
            ?? templates.FirstOrDefault(t => t.IsDefault)
            ?? templates.FirstOrDefault();

        // No await past this point: everything below runs before the renderer
        // gets another look at the component.
        _solutionsEnabled = solutionsEnabled;
        _templates = templates;
        _modules = modules;
        _applicationVersions = applicationVersions;
        _orgConfig = orgConfig;
        _gitHub = gitHub;
        _standardsSummary = standardsSummary;
        _selected = selected;
        // Pre-fill the brief / description from the org's defaults block
        // (Milestone P3.14). Users can still edit either field; the template's
        // own fields override the id range below if it specifies one, since
        // the ID range is a per-template concern.
        _brief = orgConfig.Settings.DefaultBrief;
        _description = orgConfig.Settings.DefaultCoreDescription;
        if (selected is not null)
        {
            ApplyTemplateDefaults(selected);
        }
    }

    private void OnApplicationVersionChanged()
    {
        // Picking an entry on the select fills both ApplicationVersion and
        // RuntimeVersion atomically (Milestone P2.4). The select's value is
        // the four-part Application string; we look the row up to recover the
        // matching runtime so the hidden RuntimeVersion input stays correct.
        // "Latest" propagates the sentinel into RuntimeVersion so the
        // endpoint can swap both fields in lock-step at submit time.
        if (string.Equals(_applicationVersion, ApplicationVersionService.LatestSentinel, StringComparison.Ordinal))
        {
            _runtimeVersion = ApplicationVersionService.LatestSentinel;
            return;
        }
        if (_applicationVersions is null) return;
        var match = _applicationVersions.FirstOrDefault(v => v.Application == _applicationVersion);
        if (match is not null)
        {
            _runtimeVersion = match.Runtime;
        }
    }

    private void OnTemplateChanged()
    {
        var picked = _templates?.FirstOrDefault(t => t.Key == _templateKey);
        if (picked is null) return;
        _selected = picked;
        ApplyTemplateDefaults(picked);
    }

    private void ApplyTemplateDefaults(RuntimeTemplate template)
    {
        _templateKey = template.Key;
        _coreIdRangeFrom = template.CoreIdRangeFrom;
        _coreIdRangeTo = template.CoreIdRangeTo;
        // Populate the optional-extension checkbox list. Switching templates
        // wipes prior selections; required entries (Required = true) are
        // emitted unconditionally and don't surface here.
        _selectedExtensionPaths.Clear();
        _optionalExtensions = template.WorkspaceExtensions
            .Where(e => !e.Required)
            .OrderBy(e => e.Ordering)
            .ToList();
        (_applicationVersion, _runtimeVersion) =
            TemplateDefaultsResolver.ResolveApplicationAndRuntime(template, _applicationVersions);

        // Pre-select the modules this template ships with (Milestone P2.1).
        // Switching templates retunes the selection; the user's subsequent
        // toggles after that are honoured unchanged. We only consider modules
        // that are still in the active list - soft-deleted or filtered-out
        // entries silently drop off the default set.
        _selectedModuleKeys.Clear();
        if (_modules is null) return;
        var availableKeys = _modules.Select(m => m.Key).ToHashSet(StringComparer.Ordinal);
        foreach (var d in template.DefaultModules.OrderBy(d => d.Ordering))
        {
            var key = d.Module?.Key;
            if (!string.IsNullOrEmpty(key) && availableKeys.Contains(key))
            {
                _selectedModuleKeys.Add(key);
            }
        }
    }

    private void OnModuleToggled(string key, bool isChecked)
    {
        if (isChecked) _selectedModuleKeys.Add(key);
        else _selectedModuleKeys.Remove(key);
    }

    private void OnExtensionToggled(string path, bool isChecked)
    {
        if (isChecked) _selectedExtensionPaths.Add(path);
        else _selectedExtensionPaths.Remove(path);
    }

    private int CountExtensions()
    {
        var template = _selected;
        var fromTemplate = template is null
            ? 0
            : template.WorkspaceExtensions.Count(e => e.Required || _selectedExtensionPaths.Contains(e.Path));
        return fromTemplate + _selectedModuleKeys.Count;
    }

    private int CountDependencies()
    {
        if (_modules is null) return 0;
        // One self-reference to Core per module, plus each module's own
        // dependencies. Core itself has no dependencies unless ForNAV is on,
        // in which case we just call out a non-zero count without looking up
        // catalogue rows for the preview.
        var total = 0;
        foreach (var key in _selectedModuleKeys)
        {
            var module = _modules.FirstOrDefault(m => m.Key == key);
            if (module is null) continue;
            total += 1 + module.Dependencies.Count;
        }
        return total;
    }

    /// <summary>
    /// Builds the <see cref="PreviewNode"/> tree displayed in the right column.
    /// Mirrors the structure documented in <c>generation-engine.md</c>: the
    /// workspace root contains <c>.assets</c>, one extension folder per
    /// required template extension and per ticked optional extension, one
    /// folder per selected module (cloned from the module's extension tree),
    /// and three workspace-level files. The per-extension contents come from
    /// <see cref="ExtensionPreviewBuilder"/>, which walks the recursive folder
    /// tree the same way <c>GenerationService</c> does.
    /// </summary>
    /// <summary>The folder the ZIP unpacks into — shown under the preview's title.</summary>
    /// <summary>
    /// The folder the ZIP unpacks into, derived from the customer name exactly
    /// as the generator derives it. A name with nothing to derive from (all
    /// punctuation) falls back to the placeholder rather than showing an empty
    /// root; the server refuses that name anyway.
    /// </summary>
    private string PreviewRootName =>
        CustomerNaming.Apply(_workspaceName, FolderStyle) is { Length: > 0 } folder
            ? folder
            : "Workspace";

    /// <summary>
    /// The selected modules in the order the generator will emit them - which is
    /// the order the user ticked them, not catalogue order. Shared by the
    /// preview tree and its id-range allocation so the two cannot disagree.
    /// </summary>
    private List<Module> SelectedModulesInOrder()
    {
        var ordered = new List<Module>();
        if (_modules is null) return ordered;
        foreach (var key in _selectedModuleKeys)
        {
            var module = _modules.FirstOrDefault(m => m.Key == key);
            if (module is not null) ordered.Add(module);
        }
        return ordered;
    }

    private PreviewNode BuildPreview()
    {
        var rootName = PreviewRootName;

        var children = new List<PreviewNode>();

        // The org logo lands at the path the admin set on
        // /admin/configuration/defaults' "Default logo path" (stripped of
        // any extension-relative ../ prefix). No logo uploaded means no
        // logo node at all - fresh orgs don't see a phantom .assets folder.
        if (_orgConfig?.Logo is not null)
        {
            var logoExt = _orgConfig.Logo.ContentType switch
            {
                "image/svg+xml" => "svg",
                _ => "png",
            };
            var logoPath = ALDevToolbox.Services.Generation.WorkspaceZipBuilder.NormaliseLogoPath(
                _orgConfig.Settings.DefaultLogo, logoExt);
            PreviewTreeBuilder.GraftFile(children, logoPath);
        }

        // Split the template's included files by scope once: workspace-root
        // grafts into the workspace tree; per-extension is duplicated inside
        // each extension folder by ExtensionPreviewBuilder. This is exactly
        // what WorkspaceZipBuilder does at emit time so the preview matches
        // the ZIP.
        var workspaceRootPaths = new List<string>();
        var perExtensionPaths = new List<string>();
        if (_selected is not null && _orgConfig is not null)
        {
            var byId = _orgConfig.Files.ToDictionary(f => f.Id);
            foreach (var joined in _selected.IncludedFiles.OrderBy(j => j.Ordering))
            {
                if (!byId.TryGetValue(joined.OrganizationFileId, out var file)) continue;
                if (file.Scope == OrganizationFileScope.EveryExtension)
                {
                    perExtensionPaths.Add(file.Path);
                }
                else
                {
                    workspaceRootPaths.Add(file.Path);
                }
            }
        }

        // The id ranges this form is about to allocate, from the same code that
        // will allocate them at emit time rather than a second copy of the walk
        // (#546). Keyed by the folder name each range belongs to, which is what
        // the tree rows are labelled with, so a row finds its own range without
        // the two loops below having to stay index-aligned with the allocator.
        var ranges = _selected is null
            ? new Dictionary<string, string>(StringComparer.Ordinal)
            : IdRangeAllocator
                .Allocate(_selected, _selectedExtensionPaths, SelectedModulesInOrder(),
                          _coreIdRangeFrom, _coreIdRangeTo)
                .GroupBy(r => r.Path, StringComparer.Ordinal)
                .ToDictionary(g => g.Key, g => g.First().Label, StringComparer.Ordinal);

        if (_selected is not null)
        {
            foreach (var ext in _selected.WorkspaceExtensions.OrderBy(e => e.Ordering))
            {
                if (!ext.Required && !_selectedExtensionPaths.Contains(ext.Path)) continue;
                children.Add(PreviewNode.Extension(
                    ext.Path,
                    ExtensionPreviewBuilder.BuildContents(ext.Folders, _includeExamples, perExtensionPaths))
                    with { Meta = ranges.GetValueOrDefault(ext.Path) });
            }
        }

        if (_modules is not null)
        {
            foreach (var module in SelectedModulesInOrder())
            {
                // Module-cloned extension folder name mirrors GenerationService:
                // the module's ExtensionName (PascalCase) is what lands in the
                // ZIP. Module.Key stays as the admin slug / dep ref target.
                children.Add(PreviewNode.Extension(
                    module.ExtensionName,
                    ExtensionPreviewBuilder.BuildContents(module.ExtensionFolders, _includeExamples, perExtensionPaths))
                    with { Meta = ranges.GetValueOrDefault(module.ExtensionName) });
            }
        }

        // Workspace-root side-cars + workspace-root-scoped org files, then
        // sort. Shared with the New Extension and Template Detail previews so
        // all three stay identical - see PreviewTreeBuilder.BuildWorkspacePreview.
        return PreviewTreeBuilder.BuildWorkspacePreview(
            rootName, children, WorkspaceConfigService.FileName, workspaceRootPaths,
            _selected?.RootFolders.OrderBy(f => f.Ordering).Select(f => f.Path));
    }

}
