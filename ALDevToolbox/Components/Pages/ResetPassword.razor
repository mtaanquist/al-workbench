@page "/reset-password"
@layout ALDevToolbox.Components.Layout.AuthLayout
@using ALDevToolbox.Components.Shared

<PageTitle>Reset password · AL Workbench</PageTitle>

@if (string.IsNullOrEmpty(Token))
{
    @* Reached by typing the URL, or by a link that lost its token. There is no
       form to show, so the card is the explanation and the way back. *@
    <AuthCard Title="That link is missing something">
        <Sub>
            This link looks incomplete — email apps sometimes cut long links in half.
            Open it from the email again, or ask for a new one.
        </Sub>
        <ChildContent>
            <a class="btn btn--primary" href="/forgot-password" style="height: var(--control-h-lg)">
                <Icon Name="mail" Width="16" Height="16" />
                <span>Send a new link</span>
            </a>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
    </AuthCard>
}
else if (Error == "Token")
{
    @* The link itself was refused (used, expired, or the organisation signs in
       with Microsoft now). Showing the form again would only invite another
       submit of the same dead link. *@
    <AuthCard Title="This link can't be used">
        <Sub>@(Message ?? "This reset link is no longer valid. Request a new one.")</Sub>
        <ChildContent>
            <a class="btn btn--primary" href="/login" style="height: var(--control-h-lg)">
                <Icon Name="log-in" Width="16" Height="16" />
                <span>Back to sign in</span>
            </a>
        </ChildContent>
    </AuthCard>
}
else
{
    <AuthCard Title="Set a new password" FormAction="/auth/reset-password">
        <Sub>Pick something you don't use anywhere else. You'll sign in with it straight away.</Sub>
        <Alerts>
            @if (Error is not null && Message is not null)
            {
                <Alert Tone="AlertTone.Danger">
                    <span>
                        @if (AuthCard.FieldLabel(@Error) is { } label)
                        {
                            <strong>@label:</strong>
                        }
                        @Message
                    </span>
                </Alert>
            }
        </Alerts>
        <ChildContent>
            <input type="hidden" name="Token" value="@Token" />
            <div class="auth__fields">
                <div class="field">
                    <label class="field__label" for="rp-password">New password</label>
                    <input class="input" id="rp-password" type="password" name="Password" required
                           minlength="12" autofocus autocomplete="new-password" />
                    <span class="field__hint">At least 12 characters, and not one you use anywhere else.</span>
                </div>
            </div>
            <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg)">
                <Icon Name="key-round" Width="16" Height="16" />
                <span>Update password</span>
            </button>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
        <Legal>This link can only be used once. If you request another reset email, this link stops working.</Legal>
    </AuthCard>
}

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
}
