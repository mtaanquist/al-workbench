@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Projects

@*
    The General tab of a solution's settings: what the solution is called, which
    Business Central localisation it compiles against, when it was created, and
    the one destructive setting.

    Named user: the BC consultant who owns a customer's solution, opening
    Settings to correct the name or point it at another localisation.

    The tab has no Save of its own - the page header's "Save solution" primary
    covers General and Repositories together, because the two share one edit
    model. So this component mutates the model it is handed and raises OnDirty;
    the page owns the write. Deleting is the same shape: the confirmation lives
    here, the delete itself is the page's, because its failure message belongs
    in the page-level alert.
*@

<div class="form-sec__head">
        <h2 class="card__title">General</h2>
    </div>
    <p class="form-sec__cap">Identifies the solution across the workbench and tells the compiler which Business Central localisation to target.</p>
<div class="card">
    <div class="card__body">
        <div class="form-grid">
            <section class="field">
                <label class="field__label" for="proj-name">Name</label>
                @* required + maxlength mirror ProjectService.ValidateAsync. *@
                <input id="proj-name" type="text" class="input" maxlength="200" required @bind="Edit.Name" @bind:after="MarkDirty"
                       disabled="@(Saving || !CanManage)" placeholder="e.g. CRONUS A/S" />
                <FieldError Field="Name" Errors="Errors" />
                <small class="field__hint">Labels each build, e.g. "CRONUS A/S on BC 26.0".</small>
            </section>
            <section class="field">
                <label class="field__label" for="proj-short-name">Short name</label>
                @* maxlength mirrors ProjectService.ValidateAsync, which mirrors
                   the generator's own ceiling. *@
                <input id="proj-short-name" type="text" class="input" maxlength="50" @bind="Edit.ShortName" @bind:after="MarkDirty"
                       disabled="@(Saving || !CanManage)" placeholder="e.g. CRO" />
                <FieldError Field="ShortName" Errors="Errors" />
                <small class="field__hint">
                    Optional. A short form used in extension names, for example
                    <code class="code">CRO Core</code>. Leave blank to use the full name.
                </small>
            </section>
            @if (Id is not null)
            {
                <section class="field">
                    <label class="field__label" for="proj-slug">Link name</label>
                    @* pattern + maxlength mirror SolutionSlug.IsValid, which ProjectService.ValidateAsync applies. *@
                    <input id="proj-slug" type="text" class="input" maxlength="@SolutionSlug.MaxLength" pattern="@SolutionSlug.HtmlPattern"
                           title="Lowercase letters, digits and single dashes, e.g. cronus-dk"
                           @bind="Edit.Slug" @bind:after="MarkDirty" disabled="@(Saving || !CanManage)" placeholder="e.g. cronus" />
                    <FieldError Field="Slug" Errors="Errors" />
                    <small class="field__hint">
                        The last part of this solution's link, for example
                        <code class="code">/solutions/@(SolutionSlug.IsValid(Edit.Slug.Trim()) ? Edit.Slug.Trim() : "cronus")</code>.
                        Lowercase letters, digits and single dashes, with at least one letter.
                        Leave blank to make one from the short name, or the name if there is none. Changing it breaks links people have already saved.
                    </small>
                </section>
            }
            <section class="field">
                <label class="field__label" for="proj-country">Country code</label>
                <input id="proj-country" type="text" class="input" maxlength="20" pattern="[A-Za-z0-9]{2,10}" required style="max-width:220px"
                       @bind="Edit.Country" @bind:after="MarkDirty" disabled="@(Saving || !CanManage)" placeholder="e.g. dk or w1" />
                <FieldError Field="DefaultArtifactCountry" Errors="Errors" />
                <small class="field__hint">Country code of the Microsoft localisation to compile against (e.g. dk for Denmark, w1 for the base/worldwide version). Some localisations include extra regulatory features, so pick the one this solution actually targets.</small>
            </section>
        </div>
    </div>
</div>

@if (Id is not null && LoadedProject is { } proj)
{
    <div class="form-sec__head"><span class="section-label">Audit trail</span></div>
    <div class="card">
        <div class="card__body">
            <div class="meta-row">
                <div class="meta-item">
                    <span class="meta-item__label">Created by</span>
                    <span class="meta-item__value">
                        @if (OwnerName is { } creator)
                        {
                            @creator
                        }
                        else
                        {
                            <span class="u-muted">Unknown</span>
                        }
                    </span>
                    <span class="meta-item__value meta-item__value--mono"><Timestamp Value="@proj.CreatedAt" Format="d MMM yyyy · HH:mm" /></span>
                </div>
                <div class="meta-item">
                    <span class="meta-item__label">Last updated</span>
                    <span class="meta-item__value">@(proj.UpdatedAt == proj.CreatedAt ? "Not changed since creation" : "")</span>
                    <span class="meta-item__value meta-item__value--mono"><Timestamp Value="@proj.UpdatedAt" Format="d MMM yyyy · HH:mm" /></span>
                </div>
            </div>
        </div>
    </div>
}

@* Deleting a solution is one destructive setting, and the
   settings archetype ships .setting--danger + .setting__lock
   for exactly that, on the shared SettingRow. It sits at the
   foot of General rather than behind a tab of its own - a
   whole tab for one button is a lot of navigation. *@
@if (Id is not null && CanManage)
{
    <div class="card pd-danger">
        <SettingRow Name="Delete this solution" Danger="true"
                    Hint="Removes its setup - the name and its repositories. Past builds stay downloadable from the Pipelines tool."
                    Lock="Cannot be undone">
            @if (_confirmingDelete)
            {
                <span class="setting__hint">Delete <strong>@SolutionName</strong>?</span>
                <span class="u-row">
                    <button type="button" class="btn btn--sm btn--danger" @onclick="ConfirmDeleteAsync">Yes, delete</button>
                    <button type="button" class="btn btn--sm" @onclick="() => _confirmingDelete = false">Cancel</button>
                </span>
            }
            else
            {
                <span>
                    <button type="button" class="btn btn--danger" @onclick="() => _confirmingDelete = true">
                        <Icon Name="trash-2" Width="14" Height="14" />
                        <span>Delete solution</span>
                    </button>
                </span>
            }
        </SettingRow>
    </div>
}

@code {
    /// <summary>The solution's id, or null on /solutions/new - the audit trail and the delete row exist only once it is saved.</summary>
    [Parameter] public int? Id { get; set; }

    /// <summary>Whether this person may change the solution. A viewer sees the same fields, disabled.</summary>
    [Parameter] public bool CanManage { get; set; }

    /// <summary>True while the page's own Save is in flight, which disables every field here.</summary>
    [Parameter] public bool Saving { get; set; }

    /// <summary>The page's edit model, shared with the Repositories tab and written by the page's Save.</summary>
    [Parameter, EditorRequired] public ProjectDetail.EditModel Edit { get; set; } = new();

    /// <summary>The page-level field errors from the last save, keyed the way ProjectService throws them.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? Errors { get; set; }

    /// <summary>The loaded solution, for the audit trail. Null while creating.</summary>
    [Parameter] public OeProject? LoadedProject { get; set; }

    /// <summary>Who created the solution, for the audit trail.</summary>
    [Parameter] public string? OwnerName { get; set; }

    /// <summary>The solution's name as loaded, named in the delete confirmation.</summary>
    [Parameter] public string? SolutionName { get; set; }

    /// <summary>Raised when the user edits a field, so the page can show "Unsaved changes".</summary>
    [Parameter] public EventCallback OnDirty { get; set; }

    /// <summary>
    /// Raised when the delete is confirmed. The page owns the write: its failure
    /// message renders in the page-level alert above the tabs, and its success
    /// navigates away from this page entirely.
    /// </summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    private bool _confirmingDelete;

    private Task MarkDirty() => OnDirty.InvokeAsync();

    private async Task ConfirmDeleteAsync()
    {
        await OnDelete.InvokeAsync();
        // On success the page has navigated away and this is invisible; on failure
        // it puts the row back to its resting state beside the page's error.
        _confirmingDelete = false;
    }
}
