@using ALDevToolbox.Services
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Domain.ValueObjects
@using Microsoft.Extensions.DependencyInjection
@using ALDevToolbox.Services.Organizations
@inject IServiceScopeFactory Scopes
@inject ILogger<DependencyDriftPanel> Logger

@*
    "These repositories still target an older Business Central" (issue #630),
    under the untracked-repositories panel on the Solutions page.

    Named user: a consultant who wants to know which customer repositories
    still target an older Business Central than the customer's production
    environment runs - and to get the pull requests that move them on without
    opening twelve repositories by hand. A solution with no production
    environment is measured against its sandbox, and one with no environment
    at all (not live yet) is not checked (issue #1081).

    Silent unless it has something to say: the organisation has to allow GitHub
    repositories, the person looking has to have linked their own account, and
    at least one repository they can see has to be behind. What is listed comes
    from the last scan in the database, so a slow GitHub cannot hold up the page.

    Every read runs in this component's own service scope, not the host page's -
    the same reason RepositoryPicker and the untracked panel do: a child mounted
    during the host's first render must not share its AppDbContext.

    See .design/github-integration-phase2.md, issue #630.
*@

@if (_show && _summary is { IsEmpty: false })
{
    <section class="card drift" aria-labelledby="drift-title">
        <div class="drift__head">
            <div>
                <h2 class="drift__title" id="drift-title">@Heading</h2>
                <p class="drift__sub">@Subheading</p>
            </div>
            <div class="drift__head-actions">
                <button type="button" class="btn btn--sm" disabled="@_busy" @onclick="OpenAllAsync">
                    <Icon Name="git-branch" Width="15" Height="15" />
                    <span>@(_opening ? "Opening..." : "Open update pull requests")</span>
                </button>
                <button type="button" class="btn btn--sm" disabled="@_busy" @onclick="CheckAgainAsync">
                    <Icon Name="refresh-cw" Width="15" Height="15" />
                    <span>@(_checking ? "Checking..." : "Check again")</span>
                </button>
            </div>
        </div>

        @if (_failed)
        {
            <Alert Tone="AlertTone.Warn" Role="alert">
                <span>The workbench could not reach GitHub just now, so nothing was changed. Try again in a moment.</span>
            </Alert>
        }

        <ul class="drift__list">
            @foreach (var repo in _summary.Repositories)
            {
                <li class="drift__row" @key="repo.Repository">
                    <div class="drift__repo">
                        <a class="drift__name" href="@repo.HtmlUrl" target="_blank" rel="noopener">@repo.Repository</a>
                        @if (repo.CurrentApplication.Length > 0)
                        {
                            <span class="drift__on">on Business Central @repo.CurrentApplication. @ComparedWith(repo)</span>
                        }
                        <details class="drift__what">
                            <summary>What would change</summary>
                            @foreach (var file in repo.Files)
                            {
                                <p class="drift__file"><code>@file.Path</code></p>
                                <ul class="drift__changes">
                                    @foreach (var change in file.Changes)
                                    {
                                        <li>@change.Label: <code>@change.Current</code> → <code>@change.Proposed</code></li>
                                    }
                                </ul>
                            }
                        </details>
                        @if (_results.TryGetValue(repo.Repository, out var result))
                        {
                            @if (result.PullRequest is { } pull)
                            {
                                <p class="drift__result">
                                    <a href="@pull.HtmlUrl" target="_blank" rel="noopener">
                                        @(result.IsNewPullRequest ? "Pull request opened" : "Added to the open pull request")
                                        (#@pull.Number)
                                    </a>
                                </p>
                            }
                            else
                            {
                                <p class="drift__refusal" role="alert">@result.Refusal</p>
                            }
                        }
                    </div>
                    <div class="drift__actions">
                        <button type="button" class="btn btn--sm" disabled="@_busy"
                                @onclick="() => OpenOneAsync(repo.Repository)">
                            <span>Open pull request</span>
                        </button>
                    </div>
                </li>
            }
        </ul>
    </section>
}

@code {
    private bool _show;
    private bool _loadStarted;
    private bool _failed;
    private bool _busy;
    private bool _opening;
    private bool _checking;
    private DependencyDriftSummary? _summary;
    private readonly Dictionary<string, DependencyDriftPullRequest> _results = new(StringComparer.OrdinalIgnoreCase);

    private int RepositoryCount => _summary?.Repositories.Count ?? 0;

    private string Heading
    {
        get
        {
            var count = RepositoryCount;
            var subject = count == 1 ? "1 repository is" : $"{count} repositories are";
            var version = _summary?.Groups.Count == 1
                ? _summary.Groups[0].CurrentApplication
                : null;
            return version is null
                ? $"{subject} behind on Business Central"
                : $"{subject} still on Business Central {version}";
        }
    }

    /// <summary>
    /// What the repositories were measured against (issue #1081): each solution's
    /// production environment, and the newest imported release only for the
    /// solutions that have no production environment with a known version.
    /// </summary>
    private string Subheading
    {
        get
        {
            var measured = _summary?.Repositories.Where(r => r.TargetApplication.Length > 0).ToList() ?? [];
            if (measured.Count == 0)
                return "These repositories' app.json ask for older versions than the workbench knows about.";
            if (measured.Any(r => r.EnvironmentType is null))
                return "These repositories' app.json still ask for an older Business Central. Check again to compare "
                    + "them with their solution's production environment.";
            return measured.Any(r => r.EnvironmentType == "Sandbox")
                ? "These repositories' app.json still ask for an older Business Central than their solution's "
                    + "production environment runs, or its sandbox where it has no production environment yet."
                : "These repositories' app.json still ask for an older Business Central than their solution's "
                    + "production environment runs.";
        }
    }

    /// <summary>One repository's yardstick, in a sentence under its name.</summary>
    private static string ComparedWith(DependencyDriftRepository repo)
    {
        var version = repo.TargetApplication;
        return repo.EnvironmentType switch
        {
            null => $"Compared with the newest imported release, Business Central {version}.",
            "Sandbox" => repo.Environment is { } sandbox
                ? $"{repo.Solution} has no production environment, so its sandbox (\"{sandbox}\") was used: Business Central {version}."
                : $"Compared with the sandbox of another solution that tracks this repository, on Business Central {version}.",
            _ => repo.Environment is { } production
                ? $"The production environment of {repo.Solution} (\"{production}\") is on Business Central {version}."
                : $"Compared with the production environment of another solution that tracks this repository, on Business Central {version}.",
        };
    }

    protected override async Task OnInitializedAsync()
    {
        // Two cached database reads and no call to GitHub, so a slow or
        // unreachable GitHub cannot hold up the Solutions page behind this.
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            var config = scope.ServiceProvider.GetRequiredService<RepositoryProviderPolicyService>();
            if (!(await config.GetAllowedProvidersAsync()).Contains(RepositoryProvider.GitHub)) return;

            var repos = scope.ServiceProvider.GetRequiredService<GitHubRepositoryService>();
            _show = (await repos.GetAccessAsync()).IsReady;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not tell whether the Solutions page can show dependency drift.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Deliberately not gated on firstRender: Blazor renders this component
        // once before OnInitializedAsync has come back from the database, so at
        // the first render it does not yet know whether it has anything to show.
        if (!_show || _loadStarted) return;
        _loadStarted = true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _summary = await WithService(s => s.GetSummaryAsync());
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read the dependency drift for the Solutions page.");
            _summary = null;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Runs the scan the release import runs - each repository against its
    /// solution's production environment, or its sandbox where there is none - so somebody who has just tidied a
    /// repository by hand can see it drop off the list.
    /// </summary>
    private async Task CheckAgainAsync()
    {
        _busy = true;
        _checking = true;
        _failed = false;
        _results.Clear();
        StateHasChanged();
        try
        {
            await WithService(async s =>
            {
                if (await s.NewestFirstPartyReleaseIdAsync() is { } releaseId)
                {
                    await s.ScanForReleaseAsync(releaseId);
                }
                return true;
            });
        }
        catch (Exception ex) when (ex is GitHubApiException or GitHubAppNotConfiguredException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Could not rescan the tracked repositories for dependency drift.");
            _failed = true;
        }
        finally
        {
            _busy = false;
            _checking = false;
        }
        await ReloadAsync();
    }

    private Task OpenAllAsync() =>
        OpenAsync(_summary?.Repositories.Select(r => r.Repository).ToList() ?? [], all: true);

    private Task OpenOneAsync(string repository) => OpenAsync([repository], all: false);

    private async Task OpenAsync(IReadOnlyList<string> repositories, bool all)
    {
        if (repositories.Count == 0) return;
        _busy = true;
        _opening = all;
        _failed = false;
        StateHasChanged();
        try
        {
            var results = await WithService(s => s.OpenUpdatePullRequestsAsync(repositories));
            foreach (var result in results) _results[result.Repository] = result;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not open the update pull requests.");
            _failed = true;
        }
        finally
        {
            _busy = false;
            _opening = false;
            StateHasChanged();
        }
    }

    /// <summary>One operation through this component's own scope - see the note at the top of the file.</summary>
    private async Task<T> WithService<T>(Func<DependencyDriftService, Task<T>> operation)
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await operation(scope.ServiceProvider.GetRequiredService<DependencyDriftService>());
    }
}
