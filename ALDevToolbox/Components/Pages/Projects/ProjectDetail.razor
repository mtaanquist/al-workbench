    private void HydrateEdit()
    {
        _edit = new EditModel
        {
            Name = _loadedProject!.Name,
            ShortName = _loadedProject.ShortName ?? string.Empty,
            Slug = _loadedProject.Slug ?? string.Empty,
            Country = _loadedProject.DefaultArtifactCountry ?? string.Empty,
            Repos = _loadedProject.Repositories
                .Select(r => new RepoRow { Provider = r.Provider, Url = r.Url, SavedUrl = r.Url, DisplayName = r.DisplayName })
                .ToList(),
            AutoUpdatePullRequests = _loadedProject.AutoUpdatePullRequests,
        };
        _dirty = false;
    }

    private void MarkDirty() => _dirty = true;

    /// <summary>
    /// Per-row repository errors, so each message renders under the row it belongs to
    /// instead of stacking in a page-level alert that never names the row.
    /// </summary>
    private Dictionary<RepoRow, Dictionary<string, string>> _repoErrors = new();

    /// <summary>
    /// Re-keys the service's positional repository errors (<c>Repositories[i].Url</c>)
    /// onto the rows that were sent, and moves the user to the tab holding the first
    /// problem - otherwise an inline-only error can sit on a tab they can't see.
    /// </summary>
    private void SpreadRepoErrors(List<RepoRow> sent)
    {
        foreach (var (key, message) in _errors)
        {
            if (!key.StartsWith("Repositories[", StringComparison.Ordinal)) continue;
            var close = key.IndexOf(']');
            if (close < 0 || !int.TryParse(key.AsSpan(13, close - 13), out var i)) continue;
            if (i < 0 || i >= sent.Count) continue;
            var field = key[(close + 2)..];
            if (!_repoErrors.TryGetValue(sent[i], out var errs))
            {
                errs = new();
                _repoErrors[sent[i]] = errs;
            }
            errs[field] = message;
        }

        var generalProblem = _errors.ContainsKey("Name") || _errors.ContainsKey("ShortName")
            || _errors.ContainsKey("DefaultArtifactCountry");
        if (generalProblem) ShowSection(Section.General);
        else if (_repoErrors.Count > 0) ShowSection(Section.Repos);
    }

    /// <summary>Up-to-two-letter avatar initials for the audit trail and header.</summary>
    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        var letters = parts.Take(2).Select(p => char.ToUpperInvariant(p[0]));
        return string.Concat(letters);
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _message = null;
        _messageLinksToSettings = false;
        _errors = new();
        _repoErrors = new();
        // The rows actually sent, in order: the service keys repository errors by
        // position in this list, so it is what maps an error back to a visible row.
        var sent = _edit.Repos.Where(r => !r.IsBlank()).ToList();
        try
        {
            var repos = sent
                .Select(r => new ProjectRepositoryInput(r.Provider, r.Url, r.DisplayName))
                .ToList();
            var input = new ProjectInput(
                _edit.Name,
                string.IsNullOrWhiteSpace(_edit.ShortName) ? null : _edit.ShortName,
                string.IsNullOrWhiteSpace(_edit.Country) ? null : _edit.Country,
                repos,
                // Blank asks the service for one made from the name; on create, the
                // field is not shown and null does the same.
                Id is null ? null : _edit.Slug.Trim(),
                Id is null ? null : _edit.AutoUpdatePullRequests);

            if (Id is null)
            {
                var newId = await Projects.CreateProjectAsync(input, _newAccess);
                Nav.NavigateTo(SolutionLinks.Solution(await Projects.FindVisibleSlugAsync(newId), newId));
                return;
            }
            var slugBefore = _loadedProject?.Slug;
            await Projects.UpdateProjectAsync(Id.Value, input);
            await LoadAsync();
            HydrateEdit();
            _message = "Solution saved.";
            // A new address moves the page with it, or the one in the bar stops working.
            // Rewritten rather than navigated to, like a tab click: a navigation builds
            // the page afresh and the confirmation above would go with it.
            if (_loadedProject is { } saved && saved.Slug != slugBefore)
            {
                _addressToShow = SectionHref(_section);
                _revealTab = true;
            }
        }
        catch (PlanValidationException ex)
        {
            _errors = new(ex.Errors);
            SpreadRepoErrors(sent);
        }
        catch (ProjectAccessDeniedException)
        {
            _errors = new() { ["_"] = "Only the solution owner or an admin can change this solution." };
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save solution {ProjectId}.", Id);
            _errors = new() { ["_"] = "An unexpected error occurred. The change was not saved." };
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>"Resume with my access" on the Repositories tab: automatic update pull requests are opened as this person from now on.</summary>
    private async Task ResumeAutoUpdatesAsync()
    {
        if (Id is not { } id) return;
        _errors = new();
        try
        {
            await Projects.ResumeAutoUpdatePullRequestsAsync(id);
            _loadedProject = await Projects.GetProjectAsync(id) ?? _loadedProject;
            _message = "Pull requests will be opened with your GitHub account from now on.";
        }
        catch (ProjectAccessDeniedException)
        {
            _errors = new() { ["_"] = "Only the solution owner or an admin can change this solution." };
        }
        catch (PlanValidationException ex)
        {
            _errors = new(ex.Errors);
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        try
        {
            await Projects.SoftDeleteProjectAsync(Id!.Value);
            Nav.NavigateTo("/solutions");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to delete solution {ProjectId}.", Id);
            _errors = new() { ["_"] = "Could not delete the solution." };
        }
    }

    /// <summary>
    /// The name and localisation the General tab edits and the repositories the
    /// Repositories tab edits, in one model because one Save writes both.
    /// Public so those two components can take it as a parameter; it is still
    /// this page's state.
    /// </summary>
    public sealed class EditModel
    {
        public string Name { get; set; } = string.Empty;
        /// <summary>The abbreviation the generator puts in extension names. Blank means the full name is used. See .design/customer-naming.md.</summary>
        public string ShortName { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        /// <summary>The solution's key in its web address. Blank on save makes one from the name. See <see cref="SolutionSlug"/>.</summary>
        public string Slug { get; set; } = string.Empty;
        public List<RepoRow> Repos { get; set; } = new();
        /// <summary>Whether update pull requests are opened automatically (#1104). Only an existing solution offers it.</summary>
        public bool AutoUpdatePullRequests { get; set; }
    }

    /// <summary>One row of the Repositories tab's table. Identity, not value, keys its errors.</summary>
    public sealed class RepoRow
    {
        public RepositoryProvider Provider { get; set; } = RepositoryProvider.GitHub;
        public string Url { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        /// <summary>The URL as last loaded from the solution, or null for a row added since. The tab only links a row whose URL still matches it.</summary>
        public string? SavedUrl { get; init; }
        public bool IsBlank() => string.IsNullOrWhiteSpace(Url) && string.IsNullOrWhiteSpace(DisplayName);
    }
}
