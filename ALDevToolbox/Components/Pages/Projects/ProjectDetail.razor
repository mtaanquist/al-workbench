@page "/solutions/new"
@page "/solutions/{SolutionId:int}"
@page "/solutions/{SolutionId:int}/{TabName}"
@page "/solutions/{Slug}"
@page "/solutions/{Slug}/{TabName}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ProjectService Projects
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ProjectFollowService Follows
@inject ALDevToolbox.Services.Notifications.NotificationPreferenceService NotificationPreferences
@inject ALDevToolbox.Endpoints.PublicOrigin Origin
@inject IEmailService EmailSvc
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.PipelineService PipelinesSvc
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.ReleasePipelineService ReleasePipelinesSvc
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ArtifactService Artifacts
@inject ALDevToolbox.Services.Organizations.RepositoryProviderPolicyService Config
@inject ALDevToolbox.Services.Organizations.TeamService Teams
@inject ALDevToolbox.Services.GitHub.GitHubRepositoryService GitHubRepos
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@inject ILogger<ProjectDetail> Log
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Services
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Services.Organizations

@*
    One solution's settings, grouped behind a left sub-nav so each concern loads on
    its own instead of one long scroll: General (name + localisation, with a
    read-only audit trail), Repositories, the Business Central connection, and the
    solution's Pipelines. Doubles as the create form (/solutions/new), which shows
    just General + Repositories until the solution exists.

    Only the owner or an org admin can edit or delete — the management sections are
    hidden for everyone else, who still sees the repositories read-only and can
    follow through to download builds. Named user: the BC consultant who owns a
    customer's solution, opening Settings to point it at a repo or wire up delivery.
    Primary action: Create solution on /solutions/new, Save solution once it exists.
    See .design/artifacts.md.

    Each tab is its own component - ProjectDetailGeneral, ProjectDetailRepositories,
    ProjectDetailBc, ProjectDetailPipelines, ProjectDetailSymbols, ProjectDetailAccess. What stays here is
    what the page is: the route, the load, the header, the tab strip, and the state
    more than one tab reads (the shared edit model behind one Save, and the loaded
    solution the header reports).
*@

<PageTitle>@(_header?.Name ?? (Id is null ? "New solution" : "Solution")) · Solutions · AL Workbench</PageTitle>

@* What the command palette opens with on this page: its tabs, its environments
   and its latest build. Nothing while it is being created - there is no record
   to be about yet. *@
@* Only once the solution has loaded: the lookup behind a readable address does not
   decide visibility, so an id it found must not reach the page before the load has. *@
@if (_loadedProject is not null && Id is { } paletteId)
{
    <PaletteContext Kind="ALDevToolbox.Services.Palette.PaletteContextKind.Solution" Id="paletteId" />
}

<DetailPage IsLoading="@(_loading)"
            PageClass="sol"
            LoadingText="Loading solution..."
            IsNotFound="@(_notFound || _providers.Count == 0)"
            Title="@(Id is null ? "New solution" : _header?.Name)">
    <NotFound>
        @if (_notFound)
        {
            <EmptyState Icon="package" Title="This solution doesn't exist" Heading="true">
                <Text>It may have been deleted. Head back to the list to pick another.</Text>
                <Action>
                    <a class="btn btn--primary" href="/solutions"><Icon Name="arrow-left" Width="16" Height="16" /><span>All solutions</span></a>
                </Action>
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="package" Title="No source-control providers yet" Heading="true">
                <Text>
                    Your organisation hasn't enabled any source-control providers, so solutions can't be built.
                    An administrator turns them on under <a href="/admin/administration/repositories">Administration → Repositories</a>.
                </Text>
                <Action>
                    <a class="btn" href="/solutions"><Icon Name="arrow-left" Width="16" Height="16" /><span>All solutions</span></a>
                </Action>
            </EmptyState>
        }
    </NotFound>
    <Crumbs>
        <a href="/solutions">Solutions</a>
        <Icon Name="chevron-right" Width="12" Height="12" />
        <span>@(Id is null ? "New solution" : _header?.Name)</span>
    </Crumbs>
    <TitleRow>
        @* Which fence this solution is behind, on every tab. Nothing for
           Public - the default needs no telling, and a badge on every
           solution would stop meaning anything. The title row already
           exists for a marker beside the name. *@
        @if (VisibilityBadge is { } badge)
        {
            @* No status dot: the pill is a label for a setting, not a
               run state, and the dot beside a title reads as a divider. *@
            <StatusPill Tone="muted"><span>@badge</span></StatusPill>
        }
    </TitleRow>
    <SubtitleContent>
        @if (Id is not null)
        {
            @($"{_edit.Repos.Count} repositor{(_edit.Repos.Count == 1 ? "y" : "ies")}")
            @if (_header?.OwnerName is { } owner)
            {
                <text> · @owner</text>
            }
        }
        else
        {
            <text>Name the solution, add its repositories, and choose who can see it.</text>
        }

    </SubtitleContent>
    <Actions>
        @* Following decides who hears about the solution's own events, such as
           Business Central update dates (#1048). Anyone who can see it may follow. *@
        @if (Id is not null && _loadedProject is not null)
        {
            <button type="button" class="btn" @onclick="ToggleFollowAsync" disabled="@_followSaving" data-follow
                    title="@(_following ? "You hear when Business Central schedules or moves an update for this solution" : "Hear when Business Central schedules or moves an update for this solution")">
                <Icon Name="@(_following ? "check" : "bell")" Width="15" Height="15" />
                <span>@(_following ? "Following" : "Follow")</span>
            </button>
        }
        <a class="btn" href="/solutions">
            <Icon Name="arrow-left" Width="15" Height="15" />
            <span>All solutions</span>
        </a>
        @* Save solution applies to General + Repositories. The Business Central and
           Pipelines sections have their own save/actions, so the header primary is
           hidden there to avoid implying it would save those edits. *@
        @if (_canManage && (_section is Section.General or Section.Repos
                            || (Id is null && _section == Section.Access)))
        {
            @if (_dirty)
            {
                <span class="form-actions__note">Unsaved changes</span>
            }
            <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">
                <Icon Name="@(Id is null ? "plus" : "save")" Width="15" Height="15" />
                <span>@(_saving ? "Saving..." : Id is null ? "Create solution" : "Save solution")</span>
            </button>
        }
    </Actions>
    <ChildContent>
        @* Archetype: PageDetail.dc.html - crumbs outside the head. No state
           pill: a solution has no run state of its own. *@
        @if (_message is not null)
        {
            <Alert Tone="AlertTone.Success">
                <span>
                    @_message
                    @if (_messageLinksToSettings)
                    {
                        <a href="@ALDevToolbox.Services.Notifications.NotificationService.SettingsPath">Choose how you hear about it</a>
                    }
                </span>
            </Alert>
        }
        @* Only the page-level failures ("_") stack up here; everything the user typed
           gets its error inline next to the field, the way the Access tab does. *@
        @if (_errors.TryGetValue("_", out var pageError))
        {
            <Alert Tone="AlertTone.Danger" Icon="" Block="true">
                <p>@pageError</p>
            </Alert>
        }

        @* A deployment a pipeline prepared from a new build waits on that pipeline's page
           for someone to approve it (#934); this is the solution's pointer to it. *@
        @if (_waitingForApproval.Count > 0)
        {
            <Alert Tone="AlertTone.Warn">
                <span>
                    <b>@(_waitingForApproval.Count == 1 ? "1 deployment" : $"{_waitingForApproval.Count} deployments") waiting for approval:</b>
                    @for (var i = 0; i < _waitingForApproval.Count; i++)
                    {
                        var w = _waitingForApproval[i];
                        @(i == 0 ? " " : ", ")<a href="@($"/pipelines/deployments/{w.ReleasePipelineId}")">@w.ReleasePipelineName</a><text> (build #@w.BuildId)</text>
                    }
                </span>
            </Alert>
        }

        @if (!_canManage)
        {
            <p class="u-muted">
                You're viewing this solution. Only its owner@(_header?.OwnerName is { } ownerName ? $" ({ownerName})" : "") or an admin can change or build it — you can still
                @* The Pipelines list searched for this solution, not /pipelines/{Id}:
                   that route takes a pipeline's id, so it opened whichever pipeline
                   happened to share this solution's number - or nothing. *@
                <a href="@($"/pipelines/builds?q={Uri.EscapeDataString(_header?.Name ?? string.Empty)}")">download its builds</a>.
            </p>
        }

        @*
            Horizontal section tabs, not the left rail this page used to carry:
            archetype 7 and every other settings family in the app (site-admin,
            Administration, Account) put them under the title. Each tab of an
            existing solution has its own address (#1077), but a click switches the
            section in page state and only rewrites the address bar: General and
            Repositories share one Save, and a real navigation builds the page
            afresh - it would drop whatever the user had typed with no warning.
        *@
        <div class="settings">
            <div class="settings__tabs">
                <HeaderTabs Items="@SectionTabs" AriaLabel="Solution settings" />
            </div>

            <div class="settings__body settings__body--wide">
                @if (_section == Section.General)
                {
                    <ProjectDetailGeneral Id="Id"
                                          CanManage="_canManage"
                                          Saving="_saving"
                                          Edit="_edit"
                                          Errors="_errors"
                                          LoadedProject="_loadedProject"
                                          OwnerName="@_header?.OwnerName"
                                          SolutionName="@_header?.Name"
                                          OnDirty="MarkDirty"
                                          OnDelete="ConfirmDeleteAsync" />
                    @* Creating, the level has a default and a consequence, and the tab
                       that sets it is one somebody may never open. So it is stated here,
                       on the tab the form opens on, with the way to change it. *@
                    @if (Id is null)
                    {
                        <p class="form-sec__cap">@NewAccessSummary</p>
                        <div class="form-actions">
                            <button type="button" class="btn btn--ghost btn--sm"
                                    @onclick="() => _section = Section.Access">
                                <Icon Name="users" Width="14" Height="14" />
                                <span>Choose who can see it</span>
                            </button>
                        </div>
                    }
                }
                else if (_section == Section.Repos)
                {
                    <ProjectDetailRepositories CanManage="_canManage"
                                               Saving="_saving"
                                               Edit="_edit"
                                               Providers="_providers"
                                               CanPickFromGitHub="_canPickFromGitHub"
                                               RepoErrors="_repoErrors"
                                               LoadedProject="_loadedProject"
                                               OnResumeAutoUpdates="ResumeAutoUpdatesAsync"
                                               OnDirty="MarkDirty" />
                }
                else if (_section == Section.Customer && Id is not null)
                {
                    <ProjectDetailCustomer Id="Id.Value" SolutionSlug="@_loadedProject?.Slug" CanManage="CanEditCustomer" CanChangeHosting="_canManage" OnSaved="OnCustomerSavedAsync" />
                }
                else if (_section == Section.Bc && Id is not null && _canManage && !IsOnPremises)
                {
                    <ProjectDetailBc Id="Id.Value" SolutionSlug="@_loadedProject?.Slug" />
                }
                else if (_section == Section.Pipelines && Id is not null && _canManage)
                {
                    <ProjectDetailPipelines Id="Id.Value" Pipelines="_pipelines" />
                }
                else if (_section == Section.Symbols && Id is not null && _canManage)
                {
                    <ProjectDetailSymbols Id="Id.Value" CanManage="_canManage" />
                }
                else if (_section == Section.Access && Id is not null && _canChangeAccess)
                {
                    <ProjectDetailAccess Id="Id.Value"
                                         AllTeams="_allTeams"
                                         Baseline="_accessBaseline"
                                         OnSaved="OnAccessSavedAsync" />
                }
                else if (_section == Section.Access && Id is null)
                {
                    @* No id to save against yet: the tab collects the answer and Create
                       solution writes it with the rest, in one go. *@
                    <ProjectDetailAccess AllTeams="_allTeams"
                                         Baseline="_newAccess"
                                         OnChanged="OnNewAccessChanged" />
                }
            </div>
        </div>
    </ChildContent>
</DetailPage>

@code {
    /// <summary>The numeric address, /solutions/42. Still served, and forwarded to the slug one.</summary>
    [Parameter] public int? SolutionId { get; set; }

    /// <summary>The readable address, /solutions/cronus. See <see cref="SolutionSlug"/>.</summary>
    [Parameter] public string? Slug { get; set; }

    /// <summary>The solution on screen, whichever address named it; null on /solutions/new.</summary>
    private int? Id { get; set; }

    /// <summary>
    /// The tab in the address, /solutions/cronus/bc - see <see cref="SegmentFor"/>.
    /// Absent is Customer; a name that is not a tab, or not one this person can open,
    /// is dropped from the address rather than left there looking like a place.
    /// </summary>
    [Parameter] public string? TabName { get; set; }

    /// <summary>
    /// The address a tab had before it had a path, ?tab=bc. Links like that live on in
    /// emails and bookmarks, so an existing solution forwards it to the path form. The
    /// create form has no path to put a tab in and still opens on it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? OpenTab { get; set; }

    private enum Section { General, Repos, Customer, Bc, Pipelines, Symbols, Access }
    private Section _section = Section.General;

    /// <summary>
    /// The section tab row. Every tab switches in place and, on an existing solution,
    /// puts its own address in the bar - see the note above the markup.
    ///
    /// Labels only, as archetype 7 renders them. The left rail this replaced
    /// also carried a repository count and a dot for the Business Central
    /// connection; the count is already in the page head's sub-line, and the
    /// dot is a deliberate loss rather than a badge bolted onto a tab row the
    /// design system renders as plain text.
    /// </summary>
    private List<HeaderTabs.HeaderTabItem> SectionTabs =>
        AvailableSections().Select(t => Tab(t.Label, t.Section)).ToList();

    /// <summary>The tabs this person gets on this solution, in order.</summary>
    private IEnumerable<(string Label, Section Section)> AvailableSections()
    {
        // First, and the tab an existing solution opens on: it is what most people
        // opening a solution come to read. A solution being created has no customer yet.
        if (Id is not null) yield return ("Customer", Section.Customer);
        yield return ("General", Section.General);
        yield return ("Repositories", Section.Repos);

        if (Id is not null && _canManage)
        {
            // Nothing on it works without Business Central online.
            if (!IsOnPremises) yield return ("Business Central", Section.Bc);
            yield return ("Pipelines", Section.Pipelines);
            // The dependency packages a build can't find on its own. Beside
            // Pipelines, because a failed build is what sends people here.
            yield return ("Symbols", Section.Symbols);
            // Who may see the solution is the owner's and the admins' to set, not
            // every manager's - on a Public solution that is everybody.
            if (_canChangeAccess) yield return ("Access", Section.Access);
        }
        // Creating: the level is picked here rather than left at Public and fixed
        // afterwards. A Public solution is managed by everyone in the organisation,
        // so "we'll set that later" is a customer's Business Central connection
        // open to the whole company in the meantime.
        else if (Id is null) yield return ("Access", Section.Access);
    }

    private HeaderTabs.HeaderTabItem Tab(string label, Section section) =>
        new(label, Href: null, IsActive: _section == section,
            OnSelected: EventCallback.Factory.Create(this, () => ShowSection(section)));

    /// <summary>This solution's address on <paramref name="section"/>, the readable one when the slug is known.</summary>
    private string SectionHref(Section section) =>
        SolutionLinks.Solution(_loadedProject?.Slug ?? Slug, Id!.Value, SegmentFor(section));

    /// <summary>
    /// Moves to <paramref name="section"/> - a tab click, or Save sending the user to the
    /// tab holding a problem - and, once it has drawn, puts its address in the bar. See
    /// ProjectDetail.razor.js for why the address is rewritten rather than navigated to.
    /// </summary>
    private void ShowSection(Section section)
    {
        _section = section;
        if (Id is null) return;
        _addressToShow = SectionHref(section);
        _revealTab = true;
    }

    /// <summary>The address <see cref="ShowSection"/> moved to, for the next render to put in the bar.</summary>
    private string? _addressToShow;

    /// <summary>Set when the active tab may be scrolled out of sight in the row (a phone), for the next render to bring it into view.</summary>
    private bool _revealTab;

    private IJSObjectReference? _tabsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_revealTab || _loading) return;
        _revealTab = false;
        var address = _addressToShow;
        _addressToShow = null;
        try
        {
            _tabsModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Pages/Projects/ProjectDetail.razor.js");
            await _tabsModule.InvokeVoidAsync("showTab", address);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is going; there is no address bar left to update.
        }
        catch (Exception ex) when (ex is JSException or OperationCanceledException)
        {
            // An address bar that did not move is not worth the circuit, and with it
            // whatever is typed on General and Repositories.
            Log.LogWarning(ex, "Could not put solution {ProjectId}'s tab in the address bar.", Id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_tabsModule is null) return;
        try { await _tabsModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    /// <summary>
    /// The label beside the solution name, or null for Public. Read off the loaded
    /// solution so a viewer who can't manage it still sees why the page looks the
    /// way it does.
    /// </summary>
    private string? VisibilityBadge => Id is null
        ? LevelName(_newAccess.Visibility)
        : _loadedProject?.Visibility switch
        {
            ProjectVisibility.Private => "Private",
            ProjectVisibility.ReadOnly => "Read-only",
            _ => null,
        };

    /// <summary>
    /// A level in one word for the badge. Public is named while creating and not
    /// afterwards, on purpose: a badge on every solution in the list would stop meaning
    /// anything, but on the form where the level is being chosen the default is exactly
    /// what needs saying out loud. The Solutions list's Visibility column uses the same
    /// words, so a level reads the same everywhere it is shown.
    /// </summary>
    internal static string LevelName(ProjectVisibility visibility) => visibility switch
    {
        ProjectVisibility.Private => "Private",
        ProjectVisibility.ReadOnly => "Read-only",
        _ => "Public",
    };

    private bool _loading = true;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;
    private bool _canManage;

    /// <summary>
    /// Owner, org Admin or SiteAdmin: who may change the solution's visibility and its
    /// teams. Narrower than <see cref="_canManage"/> on purpose - a Public solution is
    /// managed by everyone in the organisation, and re-governing it is not theirs.
    /// </summary>
    private bool _canChangeAccess;

    /// <summary>
    /// The level and teams picked on the create form, held here until there is a
    /// solution to put them on. Public with no teams until somebody says otherwise,
    /// which is what the tab starts on.
    /// </summary>
    private ProjectAccessSettings _newAccess = new(ProjectVisibility.Public, Array.Empty<int>());

    private void OnNewAccessChanged(ProjectAccessSettings access)
    {
        _newAccess = access;
        // The form says "Unsaved changes" for a typed character; it would be a strange
        // silence for this one.
        MarkDirty();
    }

    /// <summary>
    /// What the create form's General tab says about the level, so the decision is
    /// stated on the tab people actually open rather than only on the one they might
    /// not. Public is the default and the widest, which is the sentence worth carrying.
    /// </summary>
    private string NewAccessSummary => _newAccess.Visibility switch
    {
        ProjectVisibility.Private => "Only the teams you picked can see this solution.",
        ProjectVisibility.ReadOnly => "Anyone in your organisation can see this solution; only the teams you picked can change it.",
        _ => "Anyone in your organisation will be able to see and change this solution.",
    };
    private string? _message;
    private Dictionary<string, string> _errors = new();

    private ProjectHeader? _header;
    private List<OePipeline> _pipelines = new();
    private List<RepositoryProvider> _providers = new();

    /// <summary>
    /// Whether this person can be offered repositories to pick from, rather than
    /// left to type a URL. False for an organisation on Azure DevOps only, one
    /// that has not connected a GitHub organisation, and anyone who has not
    /// connected their own GitHub account - all of which fall back to the field
    /// they already had. Answered from the database; GitHub is not asked.
    /// </summary>
    private bool _canPickFromGitHub;

    private EditModel _edit = new();

    // Access (visibility + teams). Read here with the solution and handed to the
    // Access tab, which owns the edit in progress and the write.
    private List<TeamListRow> _allTeams = new();
    private ProjectAccessSettings? _accessBaseline;

    private async Task LoadAccessAsync()
    {
        _allTeams = await Teams.ListTeamsAsync();
        _accessBaseline = await Projects.GetAccessAsync(Id!.Value);
    }

    /// <summary>
    /// After the Access tab saves: re-read the baseline (which puts its form back
    /// to what is now stored) and move the badge beside the solution name, because
    /// the level the whole page reports just changed.
    /// </summary>
    private async Task OnAccessSavedAsync(ProjectVisibility visibility)
    {
        await LoadAccessAsync();
        if (_loadedProject is not null) _loadedProject.Visibility = visibility;
    }

    /// <summary>
    /// Whether the page has loaded a solution yet. A page that is already built can be
    /// handed a new address - another solution, or another tab of this one - as new
    /// parameters rather than as a fresh component, so the load keys off these rather
    /// than off <c>OnInitializedAsync</c>, which would only ever run for the first.
    /// An enhanced navigation in the running app builds the page afresh, which is why the
    /// tabs' own clicks do not navigate.
    /// </summary>
    private bool _hasLoaded;

    /// <summary>The address <see cref="Id"/> was last resolved from.</summary>
    private (int? SolutionId, string? Slug)? _resolvedFor;
    private int? _loadedId;

    /// <summary>Set while the page hides itself for the address it just navigated to - see OnParametersSetAsync.</summary>
    private bool _leaving;

    protected override async Task OnParametersSetAsync()
    {
        if (!await ResolveAddressAsync()) return;

        if (_hasLoaded && _loadedId == Id)
        {
            // Same solution, so this is a move to another of its tabs. The edits in
            // progress stay; the tabs share one model. The create form has no tab in
            // its path, so only a ?tab= moves it.
            if (_leaving)
            {
                // The address this page left for came back to it rather than to a
                // fresh page, so it draws again.
                _leaving = false;
                _loading = false;
            }
            if (Id is not null && TabAddressToSettleOn() is { } settled)
            {
                Nav.NavigateTo(settled, replace: true);
                return;
            }
            if (Id is not null) _section = SectionFor(TabName);
            else if (OpenTab is not null) _section = SectionFor(OpenTab);
            if (!IsAvailable(_section))
            {
                _section = Section.Customer;
                Nav.NavigateTo(SectionHref(Section.Customer), replace: true);
            }
            return;
        }

        _hasLoaded = true;
        _loadedId = Id;
        await LoadPageAsync();

        // One address per tab: ?tab=bc, /BC, /customer and a tab this person does not
        // get all settle on the address the tabs use. Only once the load has said the
        // solution is there for them: settling first would answer "that slug exists"
        // about a private solution the not-found page is meant to say nothing about.
        if (Id is not null && _loadedProject is not null && !_notFound)
        {
            var leaveFor = TabAddressToSettleOn();
            if (leaveFor is null && !IsAvailable(_section)) leaveFor = SectionHref(Section.Customer);
            if (leaveFor is not null)
            {
                // The address is about to build the page afresh; drawing a tab now
                // would only start reads that meet the new page's on the shared context.
                _loading = true;
                _leaving = true;
                Nav.NavigateTo(leaveFor, replace: true);
                return;
            }
        }
        // A tab named in the address may sit past the edge of the row on a phone.
        _revealTab = Id is not null && _section != Section.Customer;
    }

    /// <summary>
    /// The address an existing solution's tab should be at, or null when it is already
    /// there: a <c>?tab=</c> moves into the path, a name is lower-cased, and Customer or
    /// a name that is not a tab drops to the bare address.
    /// </summary>
    private string? TabAddressToSettleOn()
    {
        if (OpenTab is null && TabName is null) return null;
        var segment = SegmentFor(SectionFor(TabName ?? OpenTab));
        if (OpenTab is null && string.Equals(TabName, segment, StringComparison.Ordinal)) return null;
        return SectionHref(SectionFor(TabName ?? OpenTab));
    }

    /// <summary>
    /// Whether this person gets <paramref name="section"/> here. One they do not -
    /// Business Central on an on-premises solution, a manager's tab for someone who can
    /// only look - opens the default one instead, at its own address, rather than an
    /// empty page under a tab row that does not show it.
    /// </summary>
    private bool IsAvailable(Section section) =>
        Id is null || _loadedProject is null || _notFound || AvailableSections().Any(t => t.Section == section);

    /// <summary>
    /// Turns the address into <see cref="Id"/>. A numeric address for a solution this
    /// person can see is forwarded to its slug, keeping the tab, so a page has
    /// one address whichever link led to it. False when the page is leaving or the
    /// slug names nothing - the not-found state is then already set.
    /// </summary>
    private async Task<bool> ResolveAddressAsync()
    {
        // The same solution again - a change of tab, which keeps the component - needs no
        // lookup, and must not start one: the page's own reads may still be running on
        // the shared context.
        if (_hasLoaded && _resolvedFor == (SolutionId, Slug)) return !_notFound || Slug is null;
        _resolvedFor = (SolutionId, Slug);

        if (Slug is not null)
        {
            Id = await Projects.FindIdBySlugAsync(Slug);
            if (Id is not null) return true;
            // Not "loaded": a later /solutions/new has Id null too, and must not be
            // mistaken for this page again.
            _hasLoaded = false;
            _loadedId = null;
            _loading = false;
            _notFound = true;
            _header = null;
            return false;
        }

        Id = SolutionId;
        // The solution already on screen, by its number (the palette links that way):
        // move the address, read nothing.
        if (Id is { } shown && _hasLoaded && _loadedId == shown && _loadedProject is { Slug: { } known })
        {
            Nav.NavigateTo(SolutionLinks.Solution(known, shown, SegmentFor(SectionFor(TabName ?? OpenTab))), replace: true);
            return false;
        }
        if (Id is { } id && await Projects.FindVisibleSlugAsync(id) is { } slug)
        {
            Nav.NavigateTo(SolutionLinks.Solution(slug, id, SegmentFor(SectionFor(TabName ?? OpenTab))), replace: true);
            return false;
        }
        return true;
    }

    private Section SectionFor(string? tab) => tab?.ToLowerInvariant() switch
    {
        "bc" => Section.Bc,
        "general" => Section.General,
        "repositories" => Section.Repos,
        "customer" => Section.Customer,
        "pipelines" => Section.Pipelines,
        "symbols" => Section.Symbols,
        "access" => Section.Access,
        _ => Id is null ? Section.General : Section.Customer,
    };

    /// <summary>
    /// A tab's name in the address. Null for Customer, the tab the bare address opens
    /// on, so it has one address rather than two.
    /// </summary>
    private static string? SegmentFor(Section section) => section switch
    {
        Section.General => "general",
        Section.Repos => "repositories",
        Section.Bc => "bc",
        Section.Pipelines => "pipelines",
        Section.Symbols => "symbols",
        Section.Access => "access",
        _ => null,
    };

    private async Task LoadPageAsync()
    {
        // Everything the last solution left behind, for when the page is reused.
        _loading = true;
        _leaving = false;
        _notFound = false;
        _saving = false;
        _dirty = false;
        _canManage = false;
        _following = false;
        _followSaving = false;
        _messageLinksToSettings = false;
        _canChangeAccess = false;
        _canPickFromGitHub = false;
        _message = null;
        _errors = new();
        _repoErrors = new();
        _header = null;
        _loadedProject = null;
        _pipelines = new();
        _waitingForApproval = new();
        _accessBaseline = null;
        _newAccess = new(ProjectVisibility.Public, Array.Empty<int>());

        _section = SectionFor(Id is null ? OpenTab : TabName);
        _providers = (await Config.GetAllowedProvidersAsync()).ToList();

        if (Id is null)
        {
            // Anyone may create. The creator becomes the owner.
            _canManage = true;
            // No seeded blank row: with none, the Repositories tab shows its empty
            // state and the "Add repository" button, which is what a first-time
            // user needs. A seeded row hid both and made the "0 added" pill lie.
            _edit = new EditModel();
            // The Access tab needs the org's teams to offer them, and there is no
            // solution to read a baseline from yet.
            _allTeams = await Teams.ListTeamsAsync();
        }
        else
        {
            await LoadAsync();
            if (!_notFound)
            {
                _canManage = await Projects.CanManageAsync(Id.Value);
                _canChangeAccess = await Projects.CanChangeAccessAsync(Id.Value);
                _following = await Follows.IsFollowingAsync(Id.Value);
                HydrateEdit();
                if (_canChangeAccess)
                {
                    await LoadAccessAsync();
                }
            }
        }
        await LoadGitHubAssistAsync();
        _loading = false;
    }

    /// <summary>
    /// Decides whether the Repositories tab can offer a list to pick from. Two
    /// reads and no call to GitHub, so a slow or unreachable GitHub cannot hold
    /// up the page - and a no is silent: someone who cannot use the picker is
    /// not shown machinery explaining why.
    /// </summary>
    private async Task LoadGitHubAssistAsync()
    {
        if (!_canManage || _notFound || !_providers.Contains(RepositoryProvider.GitHub)) return;
        try
        {
            _canPickFromGitHub = (await GitHubRepos.GetAccessAsync()).IsReady;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Could not tell whether solution {ProjectId} can pick repositories from GitHub.", Id);
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var solution = await Projects.GetProjectAsync(Id!.Value);
            if (solution is null) { _notFound = true; return; }
            _header = await Artifacts.GetProjectHeaderAsync(Id.Value);
            _pipelines = await PipelinesSvc.ListPipelinesAsync(Id.Value);
            _waitingForApproval = await ReleasePipelinesSvc.ListWaitingForApprovalAsync(Id.Value);
            _loadedProject = solution;
        }
        catch (ProjectAccessDeniedException)
        {
            // A private solution this person isn't on the team for. The solutions
            // list already shows them its name; the detail page says no more than
            // that, so navigating straight here confirms nothing extra.
            _notFound = true;
        }
    }

    private OeProject? _loadedProject;

    private bool _following;
    /// <summary>The follow confirmation points at the notification settings; other messages do not.</summary>
    private bool _messageLinksToSettings;
    private bool _followSaving;

    private async Task ToggleFollowAsync()
    {
        if (Id is not { } id) return;
        var target = !_following;
        _followSaving = true;
        _message = null;
        _errors.Remove("_");
        try
        {
            await Follows.SetFollowingAsync(id, target);
            // Moved to another solution meanwhile: that page has loaded its own state.
            if (Id != id) return;
            _following = target;
            _messageLinksToSettings = _following;
            _message = _following
                ? await FollowConfirmationAsync()
                : "You're no longer following this solution. You won't hear when Business Central schedules or moves an update for it.";
        }
        catch (Exception ex) when (ex is PlanValidationException or ProjectAccessDeniedException)
        {
            _errors["_"] = ex is PlanValidationException pv
                ? pv.Errors.Values.FirstOrDefault() ?? "Couldn't change whether you follow this solution."
                : "You no longer have access to this solution.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Could not change whether the user follows solution {ProjectId}.", Id);
            _errors["_"] = "Couldn't change whether you follow this solution. Try again.";
        }
        finally
        {
            _followSaving = false;
        }
    }

    /// <summary>
    /// What following means for this person, from their own Solutions choice: the
    /// default is in the app only, but they may already have turned email on or the
    /// list off.
    /// </summary>
    private async Task<string> FollowConfirmationAsync()
    {
        // The follow is already saved; a failure to word the message must not report it as failed.
        try
        {
            return await DescribeFollowAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Could not read the notification settings for the follow confirmation.");
            return "You're following this solution.";
        }
    }

    private async Task<string> DescribeFollowAsync()
    {
        var choice = (await NotificationPreferences.GetForCurrentUserAsync())[ALDevToolbox.Domain.Entities.NotificationCategory.Solutions];
        var email = choice.Email != ALDevToolbox.Domain.Entities.NotificationDelivery.Off
            && Origin.IsConfigured && await EmailSvc.IsConfiguredAsync();
        const string Following = "You're following this solution.";
        const string When = "When Business Central schedules or moves an update for it,";
        return (choice.InApp, email) switch
        {
            (true, true) => $"{Following} {When} it will show on your Notifications page and you will get {EmailPhrase(choice.Email)}.",
            (true, false) => $"{Following} {When} it will show on your Notifications page; you get no email about it.",
            (false, true) => $"{Following} {When} you will get {EmailPhrase(choice.Email)}.",
            (false, false) => $"{Following} Your settings turn these notifications off, so you will not hear about it yet.",
        };
    }

    private static string EmailPhrase(ALDevToolbox.Domain.Entities.NotificationDelivery delivery) => delivery switch
    {
        ALDevToolbox.Domain.Entities.NotificationDelivery.Daily => "it in a daily email digest",
        ALDevToolbox.Domain.Entities.NotificationDelivery.Weekly => "it in a weekly email digest",
        _ => "an email straight away",
    };

