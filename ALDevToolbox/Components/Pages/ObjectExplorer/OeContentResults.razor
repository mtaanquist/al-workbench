@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerLinks Links
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Explore
@using ALDevToolbox.Components.Shared

@*
    File-content (grep) result table for the Release search page.

    Five states, not four: "nothing typed yet" and "too short to run" are
    different things and get different copy, because the first is the normal
    first-run and the second means the user has already started. Both are
    .empty-state cards - archetype 5 in the BC design handoff - so they read
    as a deliberate state rather than a line of muted text under a filter bar.
*@

@if (string.IsNullOrWhiteSpace(Search))
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="search" Width="21" Height="21" /></span>
            <span class="empty-state__title">Find text anywhere in the source</span>
            <span class="empty-state__text">
                Type a substring in the search box to find it across every
                <code class="code">.al</code> file in this release - useful when
                you know the text but not the object it lives in.
            </span>
        </div>
    </div>
    return;
}
@if (Search.Trim().Length < ObjectSearchService.MinContentSearchLength)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="search" Width="21" Height="21" /></span>
            <span class="empty-state__title">Keep typing</span>
            <span class="empty-state__text">
                Content search needs at least @ObjectSearchService.MinContentSearchLength
                characters - a shorter term matches too much of the source to be useful.
            </span>
        </div>
    </div>
    return;
}
@if (Results is { Count: 0 })
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
            <span class="empty-state__title">No lines match "@Search"</span>
            <span class="empty-state__text">
                Content search is a plain substring match, not a pattern. Try a
                shorter fragment, or search Objects by name instead.
            </span>
        </div>
    </div>
    return;
}
@if (Results is not null)
{
    <p class="u-muted">Showing @Results.Count.ToString("N0") line@(Results.Count == 1 ? "" : "s")@(CappedAtFiles is { } files ? $" from the first {files:N0} files. Narrow the search to see the rest." : ".")</p>
}
<table class="data-table">
    <thead>
        <tr>
            <th scope="col">Extension</th>
            <th scope="col">File</th>
            <th class="data-table__num">Line</th>
            <th scope="col">Snippet</th>
        </tr>
    </thead>
    <tbody>
        @if (Results is null)
        {
            <TableSkeletonRows Columns="4" StateColumn="false" />
        }
        @foreach (var r in Results ?? new())
        {
            <tr>
                <td>@r.ModuleName</td>
                @* .code chip for the path (it is short and reads as an identifier)
                   but a bare <code> for the snippet: .code is white-space: nowrap,
                   which would stop a line of source from wrapping in its cell. *@
                <td><code class="code">@r.FilePath</code></td>
                <td class="data-table__num"><a href="@Links.SourceFile(r.FileId, r.LineNumber)">@r.LineNumber</a></td>
                <td><code>@r.Snippet</code></td>
            </tr>
        }
    </tbody>
</table>
@if (Results is null)
{
    <div class="loading-block loading-block--under-table">
        <span class="spinner"></span><span>Searching source...</span>
    </div>
}

@code {
    [Parameter] public List<ReleaseContentMatch>? Results { get; set; }
    [Parameter] public string Search { get; set; } = string.Empty;
    /// <summary>
    /// The number of files the search stopped at when more files matched, or
    /// null when every matching file is shown. The search caps files, not
    /// lines - each file gives up to three - so the notice counts files.
    /// </summary>
    [Parameter] public int? CappedAtFiles { get; set; }
}
