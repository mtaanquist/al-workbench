@page "/object-explorer/release/{ReleaseId:int}"
@attribute [Authorize]
@* prerender:false - under default InteractiveServer the page rendered
   twice (once during the static prerender, once after the circuit took
   over), so the table briefly appeared and then "refreshed". Skipping
   prerender lets the first paint be the loading state and the data
   loads exactly once on the interactive pass. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerService ObjectExplorer
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ArtifactService Artifacts
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ReleaseComparisonService Comparison
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectSearchService Search
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerLinks Links
@inject NavigationManager Nav
@inject IJSRuntime JS
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Explore
@using System.Web
@using ALDevToolbox.Components.Shared

@*
    Search-first Release page modelled on the legacy VersionBrowser. Filter
    row across the top (Search in / Search / Object type / Extension /
    Module / Namespace), result table below with Type / Id / Name /
    Extension / Module / Namespace / Lines columns + a Find-references
    icon on every row. Every result links straight to the source viewer.

    The "Extension" filter maps to oe_modules (the .app - e.g. "Base
    Application", "OIOUBL"); "Module" is parsed from the namespace's
    second segment (the first under "Microsoft." or equivalent), matching
    the legacy convention.
*@

<PageTitle>@(_release?.Label ?? "Release") · AL Workbench</PageTitle>

<DetailPage IsLoading="@(_release is null && !_loaded)"
            LoadingText="Loading release..."
            IsNotFound="@(_release is null && _loaded)"
            Title="@(_release is { IsPrerelease: true } ? ALDevToolbox.Services.ObjectExplorer.Import.BcArtifactIndex.StripPreviewSuffix(_release.Label) : _release?.Label)"
            PageClass="oe-release"
            ShowMeta="@(_repoUrls.Count > 0 || _release?.IsPrerelease == true)">
    <NotFound>
        @* An id that resolves to nothing - a removed release, or one that
           belongs to a solution the viewer can't see - used to leave the page on
           "Loading..." for ever. Same shape as OeModuleDetail. A private
           solution's release is deliberately indistinguishable from a missing
           one here; see .design/teams-and-visibility.md. *@
        <div class="card">
            <EmptyState Icon="funnel-x" Title="We couldn't find that release" Heading="true">
                <Text>
                    It may have been removed since this link was made, or it belongs
                    to a solution you don't have access to.
                </Text>
                <Action>
                    <a class="btn" href="/object-explorer">Back to Object Explorer</a>
                </Action>
            </EmptyState>
        </div>
    </NotFound>
    <Crumbs>
        <a href="/object-explorer">Object Explorer</a>
        <Icon Name="chevron-right" Width="14" Height="14" />
        <span>@_release!.Label</span>
    </Crumbs>
    <SubtitleContent>
        @_release!.ModuleCount extension@(_release!.ModuleCount == 1 ? "" : "s")
        @if (!string.IsNullOrEmpty(_release!.BcVersion))
        {
            <span> · BC @_release!.BcVersion</span>
        }
        <span> · @FormatStatus(_release!.Status)</span>
        @if (_release!.IsPrerelease)
        {
            <StatusPill Tone="warn" Class="status-pill--inline" title="Pre-release build of an upcoming version. Objects may still change before it ships.">Preview</StatusPill>
        }
    </SubtitleContent>
    @* Where the release was built from. A second line under the subtitle until the
       page moved onto the detail frame, which keeps facts in the meta row. *@
    <Meta>
        @if (_release!.IsPrerelease)
        {
            <span class="meta-item">
                <span class="meta-item__label">Preview</span>
                <span class="meta-item__value">
                    Pre-release build of an upcoming version, imported
                    <Timestamp Value="@_release!.ImportedAt" Format="yyyy-MM-dd" />.
                    Objects may still change before it ships.
                </span>
            </span>
        }
        @if (_repoUrls.Count > 0)
        {
        <span class="meta-item">
            <span class="meta-item__label">@(_repoUrls.Count == 1 ? "Repository" : "Repositories")</span>
            <span class="meta-item__value oe-release__repos">
                @foreach (var url in _repoUrls)
                {
                    <a href="@url" target="_blank" rel="noopener noreferrer">@url</a>
                }
            </span>
        </span>
        }
    </Meta>
    <Actions>
        @if (_artifactProjectId is { } pid)
        {
            <a class="btn btn--sm" href="@($"/solutions/{pid}")">
                <Icon Name="arrow-left" Width="14" Height="14" />
                <span>Back to the solution</span>
            </a>
        }
        <AuthorizeView Roles="Admin,Editor">
            <a class="btn btn--sm" href="/admin/object-explorer/release/@ReleaseId/modules">
                <Icon Name="package-plus" Width="14" Height="14" />
                <span>Add extensions</span>
            </a>
        </AuthorizeView>
        <a class="btn btn--sm" href="/object-explorer">
            <Icon Name="arrow-left" Width="14" Height="14" />
            <span>All releases</span>
        </a>
    </Actions>
    <ChildContent>
        @* Scope is pill-tabs, not a select: it is the control that decides what
           every other filter means, and the handoff's own Object Explorer bar
           spells that choice as tabs. The Alt+1..4 shortcuts moved off the
           labels onto aria-keyshortcuts - a label is not the place to teach a
           keystroke. *@
        @*
            The scope tabs are their own row above the filters, not the first
            item in them. They pick WHAT you are searching - objects,
            procedures, source text, another release - which is a level above
            "narrow these results", and at 348px they were most of a bar that
            could not fit its own controls on one line at any viewport width.
            The archetype agrees: `PageList.dc.html` puts filters in
            `.filter-bar` and its pill tabs after the spacer as a view switch,
            never a scope picker at the head of the row.
        *@
        <div class="pill-tabs oe-release__scopes" role="tablist" aria-label="What to search">
            @foreach (var (scope, label, key) in Scopes)
            {
                <button type="button"
                        role="tab"
                        class="pill-tab @(_scope == scope ? "is-active" : "")"
                        aria-selected="@(_scope == scope ? "true" : "false")"
                        aria-keyshortcuts="@key"
                        title="@label - @key"
                        @onclick="() => SetScopeAsync(scope)">
                    <span>@label</span>
                </button>
            }
        </div>

        <div class="filter-bar">
            @if (_scope == SearchScope.Compare)
            {
                <SelectBox style="width: 220px">
                    <select class="select" @bind="_compareRight" @bind:after="ReloadAsync"
                            aria-label="Release to compare with">
                        <option value="">Pick a release...</option>
                        @if (_otherReleases is not null)
                        {
                            @foreach (var r in _otherReleases)
                            {
                                <option value="@r.Id">@r.Label</option>
                            }
                        }
                    </select>
                </SelectBox>

                @* Naming both ends rather than "A → B": nothing on the page
                   says which release is A, so the reader had to guess which
                   direction counts as added and which as removed. *@
                <SelectBox style="width: 280px">
                    <select class="select" @bind="_compareDirection" @bind:after="ReloadAsync"
                            aria-label="Which release to treat as the starting point">
                        <option value="ab">@_release!.Label → @CompareRightLabel</option>
                        <option value="ba">@CompareRightLabel → @_release!.Label</option>
                    </select>
                </SelectBox>

                <SelectBox style="width: 200px">
                    <select class="select" @bind="_compareBy" @bind:after="ReloadAsync"
                            aria-label="Compare whole files or individual objects">
                        <option value="files">Show changed files</option>
                        <option value="objects">Show changed objects</option>
                    </select>
                </SelectBox>
            }
            else
            {
                <span class="search filter-bar__search">
                    <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                    @*
                        Uncontrolled input - no `value="@_search"` binding.
                        InteractiveServer renders sent for every keystroke
                        race against the user's typing on a slow circuit
                        and reorder/drop characters; the initial value is
                        seeded via JS once after first render. See
                        wwwroot/uncontrolled-input.js.
                    *@
                    <input type="search"
                           id="oe-release-search"
                           data-page-search aria-keyshortcuts="F3"
                           class="input"
                           placeholder="@SearchPlaceholder"
                           title="@SearchHelp"
                           @ref="_searchInputRef"
                           @oninput="OnSearchChanged"
                           aria-label="@SearchPlaceholder" />
                </span>

                @* The box accepts a real little syntax and renders about 26
                   characters of a placeholder that lists six forms, so most of
                   it is cut off. Until this, the only other place any of it
                   appeared was the no-results empty state - the syntax was
                   documented exclusively in a failure, and you had to search
                   wrong before the tool told you how to search right (#575).

                   A .fdrop, the same disclosure the Type and Options
                   dropdowns in this row already use, so it reads as one more
                   control rather than a new kind of thing. *@
                <details class="fdrop fdrop--tips">
                    @* Plain .btn, not .btn--sm: this sits between the search box
                       and the Type dropdown, which are both --control-h, and at
                       26px it read as a different class of control (#612). The
                       icon carries .btn__icon so it takes the design layer's
                       16px, matching Clear filters at the other end of the row. *@
                    <summary class="btn fdrop__summary fdrop__summary--plain"
                             title="What you can type in the search box"
                             aria-label="Search tips">
                        <Icon Name="info" Width="16" Height="16" Css="btn__icon" />
                        <span>Search tips</span>
                    </summary>
                    <div class="fdrop__panel menu fdrop__panel--tips">
                        <dl class="tips">
                            @foreach (var (form, means) in SearchTipForms)
                            {
                                <dt class="tips__form"><code class="code">@form</code></dt>
                                <dd class="tips__means">@means</dd>
                            }
                        </dl>
                        @if (_scope == SearchScope.Objects)
                        {
                            @* The connection nobody could make: the badges in
                               the Type column ARE the prefixes. A reader saw
                               PS beside "permissionset" and read it as
                               decoration. SearchPrefixHintTests holds the rule
                               true as kinds are added. *@
                            <p class="tips__rule">
                                A type prefix is the badge in the <strong>Type</strong> column,
                                lower-cased - so <code class="code">PS</code> means you can type
                                <code class="code">ps:</code>.
                            </p>
                            <div class="tips__kinds">
                                @foreach (var (badge, label) in SearchTipKinds)
                                {
                                    <span class="tips__kind">
                                        <code class="code">@(badge.ToLowerInvariant()):</code>
                                        <span>@label</span>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </details>
            }

            @if (_scope == SearchScope.Objects)
            {
                @* Several object types at once, which a <select> cannot do.
                   The summary borrows the design system's .select chrome so it
                   sits in the row as one of the dropdowns; the panel is a
                   .menu, same as every other overlay in the app. *@
                <details class="fdrop fdrop--kinds">
                    <summary class="select fdrop__summary">
                        <span>@KindSummary</span>
                        <Icon Name="chevron-down" Width="15" Height="15" />
                    </summary>
                    <div class="fdrop__panel menu">
                        <label class="check menu__item fdrop__option">
                            <input type="checkbox"
                                   checked="@(_selectedKinds.Count == 0)"
                                   @onchange="OnAllKindsToggled" />
                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                            <span>All types</span>
                        </label>
                        @if (_kinds is not null)
                        {
                            @foreach (var k in _kinds)
                            {
                                <label class="check menu__item fdrop__option">
                                    <input type="checkbox"
                                           checked="@_selectedKinds.Contains(k)"
                                           @onchange="@(e => OnKindToggled(k, e))" />
                                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                    <span>@k</span>
                                </label>
                            }
                        }
                    </div>
                </details>
            }

            @if (_scope != SearchScope.Compare)
            {
                <SelectBox style="width: 190px">
                    <select class="select" @bind="_moduleFilter" @bind:after="ReloadAsync"
                            aria-label="Filter by extension">
                        <option value="">All extensions</option>
                        @if (_modules is not null)
                        {
                            @foreach (var m in _modules)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        }
                    </select>
                </SelectBox>
            }

            @*
                Namespace and "include base objects" live behind Options rather
                than in the row. Five controls plus the scope tabs overflowed
                1100px and wrapped, which left the search stranded at its
                max-width with a gap beside it and dropped Clear filters onto a
                line of its own. These two are refinements you reach for after a
                search, not before it.

                The button is always rendered and disabled when it holds nothing
                (Source text has neither; Procedures has only the toggle, and
                only on a release with a parent) - a control that appears and
                disappears as you switch tabs is harder to trust than one that
                greys out.
            *@
            @if (_scope != SearchScope.Compare)
            {
                @if (HasOptions)
                {
                    <details class="fdrop fdrop--options">
                        <summary class="select fdrop__summary" title="Extra filters for this view">
                            <span>Options@(ActiveOptionCount > 0 ? $" \u00b7 {ActiveOptionCount}" : "")</span>
                            <Icon Name="chevron-down" Width="15" Height="15" />
                        </summary>
                        <div class="fdrop__panel fdrop__panel--form menu">
                            @if (_scope == SearchScope.Objects)
                            {
                                @*
                                    Uncontrolled input - same rationale as the search
                                    input above. The datalist still drives the dropdown
                                    suggestions; the input's text content is owned by
                                    the DOM after the first-render seed.
                                *@
                                <div class="fdrop__field">
                                    <label class="field__label" for="@($"ns-{ReleaseId}")">Namespace</label>
                                    <input type="search"
                                           id="@($"ns-{ReleaseId}")"
                                           class="input"
                                           list="@($"namespace-list-{ReleaseId}")"
                                           placeholder="Any namespace"
                                           @ref="_namespaceInputRef"
                                           @oninput="OnNamespaceChanged"
                                           aria-label="Filter by namespace" />
                                </div>
                                @if (_namespaces is not null)
                                {
                                    <datalist id="@($"namespace-list-{ReleaseId}")">
                                        @foreach (var n in _namespaces)
                                        {
                                            <option value="@n"></option>
                                        }
                                    </datalist>
                                }
                            }

                            @if (CanIncludeInherited)
                            {
                                <label class="check menu__item">
                                    <input type="checkbox" @bind="_includeInherited" @bind:after="OnIncludeInheritedChangedAsync" />
                                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                    <span>Include @(_release!.ParentLabel ?? "base") objects</span>
                                </label>
                            }
                        </div>
                    </details>
                }
                else
                {
                    <button type="button" class="select fdrop__summary" disabled
                            title="This view has no extra filters">
                        <span>Options</span>
                        <Icon Name="chevron-down" Width="15" Height="15" />
                    </button>
                }

                <span class="filter-bar__spacer"></span>
                <button type="button" class="btn" @onclick="ResetFilters" disabled="@(!HasActiveFilters)"
                        title="Clear every filter on this row">
                    <Icon Name="funnel-x" Width="14" Height="14" Css="btn__icon" />
                    <span>Clear filters</span>
                </button>
            }
        </div>

        @if (_rowCompareNotice is not null)
        {
            <p class="u-muted oe-release__notice" role="status">@_rowCompareNotice</p>
        }

        @switch (_scope)
        {
            case SearchScope.Objects:
                <OeObjectResults Results="_objectResults"
                                 ReleaseId="ReleaseId"
                                 Total="_objectsTotal"
                                 RankedMode="ObjectsRankedMode"
                                 HasFilters="ObjectsHasFilters"
                                 ViewReleaseSeed="ViewReleaseSeed"
                                 OnCompareRequested="OpenComparePickerAsync"
                                 SortColumn="_sortColumn"
                                 SortDescending="_sortDescending"
                                 OnSortBy="SortBy" />
                break;
            case SearchScope.Procedures:
                <OeProcedureResults Results="_procedureResults"
                                    ViewReleaseSeed="ViewReleaseSeed" />
                break;
            case SearchScope.Content:
                @* `@_search`, not `_search` - see the note on OeCompareResults
                   below. The child was being handed the text "_search", so its
                   "type something to search" state never showed and a
                   no-results message quoted the field name back at the user. *@
                <OeContentResults Results="_contentResults"
                                  Search="@_search" />
                break;
            case SearchScope.Compare:
                @* `@_compareRight`, not `_compareRight`: both parameters are
                   `string`, and Razor takes a bare attribute value for a string
                   parameter as a LITERAL. Without the `@` the child received
                   the text "_compareRight" and "_compareBy" - so its
                   "pick a release" state was unreachable, and `CompareBy ==
                   "objects"` was never true, which meant Compare-by-objects
                   computed the right rows and then drew the file table. *@
                <OeCompareResults CompareRight="@_compareRight"
                                  CompareBy="@_compareBy"
                                  FileResults="_compareResults"
                                  FileResultsTruncated="_compareTruncated"
                                  ObjectResults="_objectCompareResults"
                                  NothingToCompare="@(_otherReleases is { Count: 0 })"
                                  IsBuild="@(_release?.Kind == OeRelease.ProjectBuildKind)" />
                break;
        }
    </ChildContent>
</DetailPage>

@* Shared "Compare with..." picker - opened from any object row's actions menu.
   One modal for the page rather than a per-row dropdown of every release. *@
<CompareReleasePickerDialog @ref="_comparePicker" />

@code {
    [Parameter] public int ReleaseId { get; set; }

    private enum SearchScope { Objects, Procedures, Content, Compare }

    private ReleaseDetail? _release;
    private bool _loaded;
    private List<string> _repoUrls = new();
    private int? _artifactProjectId;
    private List<ReleaseModuleSummary>? _modules;
    private List<string>? _kinds;
    private List<string>? _namespaces;
    private List<ReleaseListItem>? _otherReleases;
    // The shared "Compare with..." picker, opened from any object row.
    private CompareReleasePickerDialog? _comparePicker;
    // Feedback when a row-level compare can't run (the picked release doesn't
    // contain the object). Cleared on the next compare attempt.
    private string? _rowCompareNotice;

    private SearchScope _scope = SearchScope.Objects;
    private string _search = string.Empty;
    private readonly HashSet<string> _selectedKinds = new(StringComparer.OrdinalIgnoreCase);
    private string _moduleFilter = string.Empty;
    private string _namespace = string.Empty;
    // When set (and the Release has a parent), object / procedure search widens
    // to the visible chain so base objects inherited from the parent Release
    // show up - e.g. searching "Prod. Order Line" from a solution Release.
    private bool _includeInherited;
    private string _compareRight = string.Empty;
    private string _compareDirection = "ab";
    private string _compareBy = "files";

    private List<ReleaseObjectMatch>? _objectResults;
    // Objects-grid sort + lazy-load paging state. A null sort column means the
    // default order: relevance when a search term is present (ObjectsRankedMode),
    // otherwise by Type ascending. Lazy paging only runs when not ranked.
    private ObjectSortColumn? _sortColumn;
    private bool _sortDescending;
    private int _objectsTotal;
    private bool _objectsLoadingMore;
    private const int ObjectsPageSize = 100;
    private List<ReleaseProcedureMatch>? _procedureResults;
    private List<ReleaseContentMatch>? _contentResults;
    private List<ReleaseCompareFileRow>? _compareResults;
    /// <summary>True when the file diff hit its cap and more files changed than are listed.</summary>
    private bool _compareTruncated;
    private List<ObjectCompareRow>? _objectCompareResults;

    // Refs to the search-style text inputs whose `value` attribute is
    // intentionally NOT bound from the server side. See the comment on
    // the inputs themselves and wwwroot/uncontrolled-input.js for why.
    private ElementReference _searchInputRef;
    private ElementReference _namespaceInputRef;

    // When browsing inherited (base) objects, tag the source-file / object
    // links with this Release so a follow-up Find references on a base object
    // stays seeded at this Release (and includes its own code). Null otherwise
    // so links to this Release's own objects stay clean.
    private int? ViewReleaseSeed => _includeInherited ? ReleaseId : null;

    /// <summary>The other release's label, for the direction picker. Falls back
    /// to a placeholder so the option still reads as a sentence before one is
    /// picked.</summary>
    private string CompareRightLabel =>
        _otherReleases?.FirstOrDefault(r => r.Id.ToString() == _compareRight)?.Label
        ?? "the other release";

    /// <summary>The whole syntax, for the box's tooltip. The placeholder shows
    /// about 26 characters of it, so on the Objects scope the wildcard, exact
    /// and prefix forms were only ever visible in the no-results state - the
    /// syntax was documented exclusively in a failure. A proper tips popover
    /// is tracked separately.</summary>
    private string SearchHelp => _scope switch
    {
        SearchScope.Objects =>
            "Name, or: an object id (18), a range (50000..99999), a wildcard (sales*), "
            + "an exact phrase (\"Sales Header\"), or a type prefix (t: table, p: page, "
            + "c: codeunit, te: table extension, pe: page extension)",
        SearchScope.Procedures => "Matches the procedure name only",
        SearchScope.Content    => "Plain text, matched anywhere in the source. Not a pattern",
        _                      => string.Empty,
    };

    /// <summary>
    /// Each form the box accepts, with one example (#575). Scope-specific:
    /// only the object search parses prefixes and ranges, and telling a
    /// content search about `t:` would be teaching a syntax that does nothing.
    /// </summary>
    private IReadOnlyList<(string Form, string Means)> SearchTipForms => _scope switch
    {
        SearchScope.Objects =>
        [
            ("sales", "Any object whose name contains it"),
            ("18", "The object with that id"),
            ("50000..99999", "Every object in that id range"),
            ("sales*", "Names starting with \"sales\""),
            ("\"Sales Header\"", "That exact name, spaces and all"),
            ("t:item", "One type only - see below"),
        ],
        SearchScope.Procedures =>
        [
            ("post", "Any procedure whose name contains it"),
        ],
        SearchScope.Content =>
        [
            ("Post Sales Document", "Plain text, matched anywhere in the source"),
        ],
        _ => [],
    };

    /// <summary>
    /// Badge → object kind, for the prefix legend. Read from
    /// <see cref="ObjectKindGlyph"/> rather than restated, so a kind added
    /// there appears here; <c>SearchPrefixHintTests</c> holds the claim that
    /// the badge lower-cased is a real prefix.
    /// </summary>
    private static IReadOnlyList<(string Badge, string Label)> SearchTipKinds { get; } =
        new (string Kind, string Label)[]
        {
            ("table", "Table"), ("page", "Page"), ("codeunit", "Codeunit"),
            ("report", "Report"), ("query", "Query"), ("xmlport", "XMLport"),
            ("enum", "Enum"), ("interface", "Interface"),
            ("permissionset", "Permission set"), ("controladdin", "Control add-in"),
            ("tableextension", "Table extension"), ("pageextension", "Page extension"),
            ("reportextension", "Report extension"), ("enumextension", "Enum extension"),
            ("permissionsetextension", "Permission set ext."),
            ("menusuite", "Menu suite"), ("profile", "Profile"),
        }
        .Select(x => (Badge: ObjectKindGlyph.For(x.Kind), x.Label))
        .Where(x => x.Badge.Length > 0)
        .ToList();

    private string SearchPlaceholder => _scope switch
    {
        SearchScope.Procedures => "Procedure name, e.g. PostSalesDocument",
        SearchScope.Content    => "Text to find in the source, e.g. Post Sales Document",
        _                      => "Name, ID, 50000..99999, sales*, \"exact\", t:item",
    };

    protected override async Task OnInitializedAsync()
    {
        _release = await ObjectExplorer.GetReleaseAsync(ReleaseId);
        _loaded = true;
        if (_release is null) return;

        // Solution releases were compiled from repositories - surface the distinct
        // source repos (from the build report's provenance) under the title.
        if (_release.Kind == OeRelease.ProjectBuildKind)
        {
            var results = await ObjectExplorer.GetProjectBuildResultsAsync(ReleaseId);
            _repoUrls = results
                .Where(r => !string.IsNullOrEmpty(r.RepoUrl))
                .Select(r => r.RepoUrl!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            // This release isn't listed in the global browser — give a deep-linked
            // user a way back to the Artifacts page that owns it.
            _artifactProjectId = await Artifacts.GetProjectIdForReleaseAsync(ReleaseId);
        }

        _modules = await ObjectExplorer.ListModuleSummariesAsync(ReleaseId);
        // Pipeline builds are left out of the global release list, so a build is
        // offered the other builds of its own solution instead (#1075).
        _otherReleases = _release.Kind == OeRelease.ProjectBuildKind
            ? await ObjectExplorer.ListBuildCompareCandidatesAsync(ReleaseId)
            : CompareCandidates(await ObjectExplorer.ListReleasesAsync(browsableOnly: true), ReleaseId, _release.Kind);

        // Seed filter state from the URL query string so back-navigation
        // from a result detail page restores what the user was searching.
        HydrateFiltersFromUrl();

        // Kind / namespace dropdowns load after hydration so they reflect the
        // inherited-objects toggle when it arrives via the URL.
        await ReloadFilterOptionsAsync();

        await ReloadAsync();
    }

    /// <summary>
    /// The releases this one can be compared with: every other ready release of
    /// the same kind. Microsoft code and customisations live in separate apps
    /// now, so a cross-kind compare is not one anyone makes, and with hundreds
    /// of customer releases imported the full list buried the few worth
    /// comparing against. The caller passes the browsable list, so a symbol
    /// package a build pulled from the feeds with no files is already gone (#1092).
    /// Pipeline builds are not in this list; they use
    /// <c>ObjectExplorerService.ListBuildCompareCandidatesAsync</c> instead.
    /// </summary>
    internal static List<ReleaseListItem> CompareCandidates(
        IEnumerable<ReleaseListItem> releases, int releaseId, string releaseKind) =>
        releases
            .Where(r => r.Id != releaseId && r.Status == "ready" && r.DeletedAt is null)
            .Where(r => r.Kind == releaseKind)
            .ToList();

    /// <summary>
    /// Reads <c>scope</c>, <c>search</c>, <c>kind</c>, <c>module</c>,
    /// <c>segment</c>, and <c>namespace</c> from <see cref="Nav.Uri"/>
    /// and hydrates the corresponding filter fields. Unknown or invalid
    /// values fall back to defaults so a malformed URL just clears the
    /// filter rather than crashing the page.
    /// </summary>
    private void HydrateFiltersFromUrl()
    {
        var query = HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var scopeRaw = query["scope"];
        if (!string.IsNullOrEmpty(scopeRaw)
            && Enum.TryParse<SearchScope>(scopeRaw, ignoreCase: true, out var parsedScope))
        {
            _scope = parsedScope;
        }
        _search = query["search"] ?? string.Empty;
        _selectedKinds.Clear();
        foreach (var k in (query["kind"] ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            _selectedKinds.Add(k);
        }
        _moduleFilter = query["module"] ?? string.Empty;
        _namespace = query["namespace"] ?? string.Empty;
        // Default to this release's own objects; widening into the parent chain
        // (a third-party / solution release's Microsoft base) is an explicit
        // opt-in via inherited=1. The toggle is only shown for parented releases.
        _includeInherited = query["inherited"] == "1";
        // Validated against the releases the picker actually offers. An id that
        // is not one of them - or this release itself - makes ReloadCompareAsync
        // null both result lists, which the child reads as "still loading" and
        // draws a skeleton that nothing can ever clear.
        var right = query["right"] ?? string.Empty;
        _compareRight = _otherReleases is not null && _otherReleases.Any(r => r.Id.ToString() == right)
            ? right
            : string.Empty;
        var dir = query["dir"];
        _compareDirection = dir == "ba" ? "ba" : "ab";
        _compareBy = query["by"] == "objects" ? "objects" : "files";
    }

    /// <summary>Loads the kind / namespace dropdown options, widened to the
    /// inherited chain when the toggle is on.</summary>
    private async Task ReloadFilterOptionsAsync()
    {
        // Under the reload gate: the toggle that calls this can land while a debounced
        // search is still awaiting the page's context.
        await _reloadGate.WaitAsync();
        try
        {
            _kinds = await Search.ListObjectKindsInReleaseAsync(ReleaseId, _includeInherited);
            _namespaces = await Search.ListNamespacesInReleaseAsync(ReleaseId, _includeInherited);
        }
        finally
        {
            _reloadGate.Release();
        }
    }

    /// <summary>Toggling "include inherited" rebuilds the filter dropdowns (the
    /// kind/namespace lists change) and re-runs the current search.</summary>
    private async Task OnIncludeInheritedChangedAsync()
    {
        await ReloadFilterOptionsAsync();
        await ReloadAsync();
    }

    /// <summary>
    /// Mirrors the current filter state into the URL bar via
    /// <c>history.replaceState</c>, so browser back-navigation from a
    /// result-detail page lands on the same search. Bypasses
    /// <c>Nav.NavigateTo</c> so the component doesn't re-initialise on
    /// every keystroke; the URL is the only thing that changes.
    /// </summary>
    private async Task UpdateUrlAsync()
    {
        // JS interop is forbidden during Blazor's static prerender
        // phase - the runtime throws InvalidOperationException because
        // the circuit isn't connected yet. The initial ReloadAsync
        // call from OnInitializedAsync runs during prerender, so skip
        // the URL sync there: the URL the user arrived on already
        // matches the filter state we just hydrated from it, so
        // there's nothing to sync. Subsequent reloads (search input,
        // dropdown changes) fire after first render when interop is
        // safe.
        if (!_isInteractive) return;

        var parts = new List<string>(8);
        if (_scope != SearchScope.Objects) parts.Add("scope=" + Uri.EscapeDataString(_scope.ToString()));
        if (!string.IsNullOrWhiteSpace(_search)) parts.Add("search=" + Uri.EscapeDataString(_search));
        if (_selectedKinds.Count > 0) parts.Add("kind=" + Uri.EscapeDataString(string.Join(",", _selectedKinds)));
        if (!string.IsNullOrWhiteSpace(_moduleFilter)) parts.Add("module=" + Uri.EscapeDataString(_moduleFilter));
        if (!string.IsNullOrWhiteSpace(_namespace)) parts.Add("namespace=" + Uri.EscapeDataString(_namespace));
        // Persist only the non-default state: a parented release defaults to
        // showing inherited objects, so record inherited=0 when toggled off;
        // a parentless release defaults off, so record inherited=1 if ever on.
        var inheritedDefault = _release?.ParentReleaseId is not null;
        if (_includeInherited != inheritedDefault) parts.Add(_includeInherited ? "inherited=1" : "inherited=0");
        if (_scope == SearchScope.Compare && !string.IsNullOrWhiteSpace(_compareRight)) parts.Add("right=" + Uri.EscapeDataString(_compareRight));
        if (_scope == SearchScope.Compare && _compareDirection == "ba") parts.Add("dir=ba");
        if (_scope == SearchScope.Compare && _compareBy == "objects") parts.Add("by=objects");

        var url = $"/object-explorer/release/{ReleaseId}";
        if (parts.Count > 0) url += "?" + string.Join("&", parts);

        await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, url);
    }

    private bool _isInteractive;
    private IJSObjectReference? _keybindModule;
    private DotNetObjectReference<OeReleaseDetail>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;

            // PageTitle alone doesn't update the head on this page because we
            // render with `prerender: false` - the initial response has no
            // <title>, and the interactive PageTitle update doesn't reach the
            // static-SSR HeadOutlet. Set document.title explicitly via JS now
            // that the circuit is connected and the release has loaded.
            if (_release is not null)
            {
                await JS.InvokeVoidAsync("aldt.setTitle", $"{_release.Label} · AL Workbench");
            }

            // Park focus in the search box on first render so a keyboard-first
            // user can land on the page and start typing. Compare mode doesn't
            // render a search input, so skip it there.
            if (_scope != SearchScope.Compare)
            {
                try { await _searchInputRef.FocusAsync(); }
                catch { /* input was removed before focus landed */ }
            }

            // Wire the document-level Alt+1..Alt+4 scope keybinds and Esc for the filter
            // panels. F3 is the shell's now (wwwroot/search-shortcut.js), via data-page-search.
            _keybindModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Pages/ObjectExplorer/OeReleaseDetail.razor.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _keybindModule.InvokeVoidAsync("init", _selfRef);
        }

        // Re-seed the uncontrolled text inputs from the URL-hydrated filter
        // state on every render, not just first render: returning to this page
        // via Blazor's enhanced navigation (e.g. browser-back from the
        // source viewer) leaves `?search=...` in the URL but blanks the input
        // node, so a once-only seed leaves the box empty. seedInput only
        // writes when the box is empty, so this re-asserts the value after a
        // nav diff without ever clobbering an in-progress query. After a Reset
        // `_search`/`_namespace` are empty, so this is a no-op there.
        if (_isInteractive && _scope != SearchScope.Compare)
        {
            if (!string.IsNullOrEmpty(_search))
            {
                await JS.InvokeVoidAsync("aldt.seedInput", _searchInputRef, _search);
            }
            if (_scope == SearchScope.Objects && !string.IsNullOrEmpty(_namespace))
            {
                await JS.InvokeVoidAsync("aldt.seedInput", _namespaceInputRef, _namespace);
            }
        }

        // Re-point the infinite-scroll observer at the current sentinel after
        // every render - the sentinel node is recreated when the result set or
        // scope changes, and watchSentinel is a no-op when it isn't present.
        if (_keybindModule is not null && _scope == SearchScope.Objects)
        {
            try { await _keybindModule.InvokeVoidAsync("watchSentinel"); }
            catch { /* circuit tearing down */ }
        }
    }

    /// <summary>
    /// The scope tabs, in the order they are drawn, each with the keystroke
    /// that also selects it. One list so the tab, its tooltip and its
    /// aria-keyshortcuts can never disagree with the handler in
    /// OeReleaseDetail.razor.js, which binds the same four.
    /// </summary>
    private static readonly (SearchScope Scope, string Label, string Key)[] Scopes =
    {
        (SearchScope.Objects,    "Objects",      "Alt+1"),
        (SearchScope.Procedures, "Procedures",   "Alt+2"),
        (SearchScope.Content,    "Source text",  "Alt+3"),
        (SearchScope.Compare,    "Compare",      "Alt+4"),
    };

    /// <summary>Tab click. Same path as the keybind, minus the parse.</summary>
    private async Task SetScopeAsync(SearchScope scope)
    {
        if (_scope == scope) return;
        _scope = scope;
        await OnScopeChanged();
    }

    /// <summary>
    /// Entry point invoked from <c>OeReleaseDetail.razor.js</c> when the
    /// user presses <kbd>Alt+1</kbd>..<kbd>Alt+4</kbd> anywhere on the
    /// page to flip the "Search in" scope.
    /// </summary>
    [JSInvokable]
    public async Task SetScopeFromKeybind(string scopeName)
    {
        if (!Enum.TryParse<SearchScope>(scopeName, ignoreCase: false, out var scope)) return;
        if (_scope == scope) return;
        _scope = scope;
        await OnScopeChanged();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        if (_keybindModule is not null)
        {
            try { await _keybindModule.InvokeVoidAsync("detach"); } catch { }
            try { await _keybindModule.DisposeAsync(); } catch { }
        }
        _selfRef?.Dispose();
    }

    private async Task OnScopeChanged()
    {
        // Crossing search-mode boundaries - the kind dropdown's options
        // differ between Objects and Procedures, and Content has neither.
        _selectedKinds.Clear();
        _sortColumn = null;
        _sortDescending = false;
        await ReloadAsync();
    }

    /// <summary>
    /// Opens the shared release picker from a row's "Compare with..." action
    /// and jumps straight into the side-by-side file diff of THAT object
    /// against its counterpart in the picked release - the same destination
    /// the source viewer's compare picker uses. The release-wide diff stays
    /// available via the "Compare with release" search scope; a row action is
    /// about the row. When the picked release doesn't contain the object, an
    /// inline notice says so instead of navigating nowhere.
    /// </summary>
    private async Task OpenComparePickerAsync(ReleaseObjectMatch row)
    {
        if (_comparePicker is null || _otherReleases is null || row.SourceFileId is not { } fileId) return;
        _rowCompareNotice = null;
        var chosen = await _comparePicker.OpenAsync(
            _otherReleases.Select(r => new CompareReleasePickerDialog.Release(r.Id, r.Label)),
            $"{row.Kind.ToLowerInvariant()} {row.Name}");
        if (chosen is not { } releaseId) return;

        var picked = _otherReleases.FirstOrDefault(r => r.Id == releaseId);
        // Under the reload gate: a debounced search may still be awaiting the page's context.
        long? otherFileId;
        await _reloadGate.WaitAsync();
        try
        {
            otherFileId = await Comparison.FindObjectFileInReleaseAsync(
                releaseId, row.Kind, row.ObjectId, row.Name);
        }
        finally
        {
            _reloadGate.Release();
        }
        if (otherFileId is null)
        {
            var otherLabel = picked?.Label ?? "That release";
            _rowCompareNotice = $"{otherLabel} doesn't contain {row.Kind.ToLowerInvariant()} {row.Name}, so there's nothing to compare against.";
            StateHasChanged();
            return;
        }

        // Older release on the LEFT of the diff, so added lines always read
        // green in the newer version - regardless of which side you started on.
        var pickedIsOlder = _release is null || picked is null
            || ReleaseComparisonService.IsOlderRelease(
                picked.BcVersion, picked.ImportedAt, _release.BcVersion, _release.ImportedAt);
        var (leftFile, rightFile) = pickedIsOlder
            ? (otherFileId.Value, fileId)
            : (fileId, otherFileId.Value);

        // The diff page is statically rendered - leave the circuit with a full load.
        Nav.NavigateTo(Links.CompareFile(leftFile, rightFile), forceLoad: true);
    }

    // Debounce window for text inputs. Without it, every keystroke triggered
    // an immediate ReloadAsync - the queries pile up and the scoped EF
    // context can't be entered concurrently, so a fast typer hits errors
    // when one search starts before the previous finishes. 250ms is short
    // enough to feel live and long enough to coalesce a burst of keystrokes
    // into a single query. _reloadGate serialises the actual reload as a
    // belt-and-braces guard for the case where a query takes longer than
    // the debounce window.
    private static readonly TimeSpan SearchDebounce = TimeSpan.FromMilliseconds(250);
    private CancellationTokenSource? _searchDebounceCts;
    private readonly SemaphoreSlim _reloadGate = new(1, 1);

    private async Task OnSearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        await DebounceReloadAsync();
    }

    private async Task OnNamespaceChanged(ChangeEventArgs args)
    {
        _namespace = args.Value?.ToString() ?? string.Empty;
        await DebounceReloadAsync();
    }

    private async Task DebounceReloadAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        var cts = new CancellationTokenSource();
        _searchDebounceCts = cts;
        try
        {
            await Task.Delay(SearchDebounce, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        if (cts.IsCancellationRequested) return;
        await ReloadAsync();
        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        // Serialise reloads so a slow query and a fast typer never share
        // the same scoped DbContext at the same time.
        await _reloadGate.WaitAsync();
        try
        {
            // Keep the URL in step with the filter state on every reload -
            // ensures a result-detail click followed by browser-back lands
            // back on the same search results without re-typing.
            await UpdateUrlAsync();

            // Dispatch to the per-scope query strategy. Each runs inside the
            // reload gate above; none of them re-enters it.
            switch (_scope)
            {
                case SearchScope.Objects:
                    await ReloadObjectsAsync();
                    break;
                case SearchScope.Procedures:
                    await ReloadProceduresAsync();
                    break;
                case SearchScope.Content:
                    await ReloadContentAsync();
                    break;
                case SearchScope.Compare:
                    await ReloadCompareAsync();
                    break;
            }
        }
        finally
        {
            _reloadGate.Release();
        }
    }

    /// <summary>Module filter parsed to a numeric id, or null for "All".</summary>
    private long? CurrentModuleId => long.TryParse(_moduleFilter, out var m) ? m : null;

    private async Task ReloadObjectsAsync()
    {
        var moduleId = CurrentModuleId;
        var trimmedSearch = string.IsNullOrWhiteSpace(_search) ? null : _search;
        var nsPrefix = string.IsNullOrWhiteSpace(_namespace) ? null : _namespace;

        var objectFilter = new ObjectListFilter(
            Kinds: _selectedKinds.Count == 0 ? null : _selectedKinds.ToList(),
            Search: trimmedSearch);
        if (ObjectsRankedMode)
        {
            // Relevance-ranked, capped - no lazy paging needed because a
            // search term keeps the match set small.
            _objectResults = await Search.SearchObjectsInReleaseAsync(
                ReleaseId, objectFilter, moduleId: moduleId, namespacePrefix: nsPrefix, take: 500,
                includeInherited: _includeInherited);
            _objectsTotal = _objectResults.Count;
        }
        else
        {
            // Column-sorted (or default Type order when browsing) - first
            // page only; the scroll sentinel pulls the rest.
            var (col, desc) = EffectiveSort();
            var page = await Search.SearchObjectsPageInReleaseAsync(
                ReleaseId, objectFilter, moduleId, nsPrefix, col, desc, skip: 0, take: ObjectsPageSize,
                includeInherited: _includeInherited);
            _objectResults = page.Rows.ToList();
            _objectsTotal = page.TotalCount;
        }
    }

    private async Task ReloadProceduresAsync()
    {
        var trimmedSearch = string.IsNullOrWhiteSpace(_search) ? null : _search;
        _procedureResults = await Search.SearchProceduresInReleaseAsync(
            ReleaseId, trimmedSearch, CurrentModuleId, take: 500, includeInherited: _includeInherited);
    }

    private async Task ReloadContentAsync()
    {
        var trimmedSearch = string.IsNullOrWhiteSpace(_search) ? null : _search;
        if (string.IsNullOrEmpty(trimmedSearch))
        {
            _contentResults = new();
        }
        else
        {
            // Clear the previous results first so the panel shows its
            // "Searching..." state (the _contentResults is null branch)
            // while this query runs, rather than leaving a stale
            // "No lines match..." message up until the query returns.
            _contentResults = null;
            StateHasChanged();
            _contentResults = await Search.SearchContentInReleaseAsync(
                ReleaseId, trimmedSearch, CurrentModuleId, take: 200);
        }
    }

    private async Task ReloadCompareAsync()
    {
        if (!int.TryParse(_compareRight, out var otherId) || otherId == ReleaseId)
        {
            _compareResults = null;
            _objectCompareResults = null;
        }
        else
        {
            var (leftId, rightId) = _compareDirection == "ba"
                ? (otherId, ReleaseId)
                : (ReleaseId, otherId);
            if (_compareBy == "objects")
            {
                _objectCompareResults = await Comparison.CompareReleaseObjectsAsync(leftId, rightId);
                _compareResults = null;
            }
            else
            {
                // The service hands back one row past the cap when it had to cut
                // the diff; trim that marker off and tell the results table, so
                // the page can say how much it is showing. See issue #685.
                var cap = ReleaseComparisonService.MaxCompareFileRows;
                var rows = await Comparison.CompareReleaseFilesFlatAsync(leftId, rightId, cap);
                _compareTruncated = rows.Count > cap;
                _compareResults = _compareTruncated ? rows.Take(cap).ToList() : rows;
                _objectCompareResults = null;
            }
        }
    }

    // ── Objects grid: sort, multi-kind, lazy paging ─────────────────────

    /// <summary>
    /// True when the objects list should use relevance ranking: a search term
    /// is present and the user hasn't picked an explicit sort column. In that
    /// case the (small) match set is fetched capped and ranked, so there's no
    /// lazy paging. Otherwise we page a column-sorted query as the user scrolls.
    /// </summary>
    private bool ObjectsRankedMode => _sortColumn is null && !string.IsNullOrWhiteSpace(_search);

    /// <summary>True when any object filter (search / kind / module / namespace) is set
    /// - drives the "no match" vs "no objects yet" empty-state copy. Excludes sort.</summary>
    private bool ObjectsHasFilters =>
        !string.IsNullOrWhiteSpace(_search)
        || _selectedKinds.Count > 0
        || !string.IsNullOrWhiteSpace(_moduleFilter)
        || !string.IsNullOrWhiteSpace(_namespace);

    /// <summary>The sort to apply when not ranking - the picked column, or Type ascending by default.</summary>
    private (ObjectSortColumn Column, bool Descending) EffectiveSort()
        => _sortColumn is { } c ? (c, _sortDescending) : (ObjectSortColumn.Default, false);

    /// <summary>
    /// Whether this release can show objects it inherits from its parent -
    /// third-party releases carry one, first-party releases do not.
    /// </summary>
    private bool CanIncludeInherited =>
        (_scope == SearchScope.Objects || _scope == SearchScope.Procedures)
        && _release?.ParentReleaseId is not null;

    /// <summary>Whether the Options dropdown has anything in it for the current scope.</summary>
    private bool HasOptions => _scope == SearchScope.Objects || CanIncludeInherited;

    /// <summary>
    /// How many of the filters behind Options are set. Shown on the button,
    /// because a filter you cannot see is a filter you cannot explain: without
    /// it a namespace left over from an earlier search silently trims the
    /// results and nothing on the row says why.
    /// </summary>
    private int ActiveOptionCount =>
        (_scope == SearchScope.Objects && !string.IsNullOrWhiteSpace(_namespace) ? 1 : 0)
        + (CanIncludeInherited && _includeInherited ? 1 : 0);

    private string KindSummary => _selectedKinds.Count switch
    {
        0 => "All types",
        1 => _selectedKinds.First(),
        var n => $"{n} types",
    };

    /// <summary>True when any object filter or sort is in effect - gates the Reset button.</summary>
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_search)
        || _selectedKinds.Count > 0
        || !string.IsNullOrWhiteSpace(_moduleFilter)
        || !string.IsNullOrWhiteSpace(_namespace)
        || _sortColumn is not null;

    /// <summary>Clears every filter + sort back to the default view, including the uncontrolled inputs.</summary>
    private async Task ResetFilters()
    {
        _search = string.Empty;
        _selectedKinds.Clear();
        _moduleFilter = string.Empty;
        _namespace = string.Empty;
        _sortColumn = null;
        _sortDescending = false;
        if (_isInteractive)
        {
            // Both are uncontrolled inputs; clear their DOM values. Use the
            // unconditional setter - seedInput refuses to overwrite a non-empty
            // box, so it can't wipe text the user typed. The search box renders
            // in every non-Compare scope; the namespace box only in Objects.
            await JS.InvokeVoidAsync("aldt.setInputValue", _searchInputRef, string.Empty);
            if (_scope == SearchScope.Objects)
            {
                await JS.InvokeVoidAsync("aldt.setInputValue", _namespaceInputRef, string.Empty);
            }
        }
        await ReloadAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Header click: first click sorts ascending, second flips to descending,
    /// third clears the sort (back to relevance/default), BC-grid style.
    /// </summary>
    private async Task SortBy(ObjectSortColumn column)
    {
        if (_sortColumn != column)
        {
            _sortColumn = column;
            _sortDescending = false;
        }
        else if (!_sortDescending)
        {
            _sortDescending = true;
        }
        else
        {
            _sortColumn = null;
            _sortDescending = false;
        }
        await ReloadAsync();
        StateHasChanged();
    }

    private async Task OnKindToggled(string kind, ChangeEventArgs e)
    {
        if (e.Value is true) _selectedKinds.Add(kind);
        else _selectedKinds.Remove(kind);
        await ReloadAsync();
        StateHasChanged();
    }

    /// <summary>
    /// The "All types" affordance. An empty selection already means "all", so
    /// this just clears any per-kind picks. It auto-checks again (the bound
    /// <c>checked</c> tracks <c>Count == 0</c>) whenever the user clears every
    /// specific kind. No-op when nothing is selected. See issue #273.
    /// </summary>
    private async Task OnAllKindsToggled()
    {
        if (_selectedKinds.Count == 0) return;
        _selectedKinds.Clear();
        await ReloadAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Invoked from JS when the scroll sentinel enters the viewport - appends
    /// the next page of objects. No-op while ranking, already loading, or once
    /// every row is in hand. Guarded by the reload gate so it never shares the
    /// scoped DbContext with an in-flight reload.
    /// </summary>
    [JSInvokable]
    public async Task LoadMoreObjects()
    {
        if (_scope != SearchScope.Objects || ObjectsRankedMode) return;
        if (_objectsLoadingMore || _objectResults is null || _objectResults.Count >= _objectsTotal) return;

        _objectsLoadingMore = true;
        try
        {
            await _reloadGate.WaitAsync();
            try
            {
                // Re-check under the gate: a reload (new search/filter) may have
                // run while we waited, flipping us into ranked mode or replacing
                // the result set.
                if (_scope != SearchScope.Objects || ObjectsRankedMode
                    || _objectResults is null || _objectResults.Count >= _objectsTotal)
                {
                    return;
                }

                long? moduleId = long.TryParse(_moduleFilter, out var m) ? m : null;
                var trimmedSearch = string.IsNullOrWhiteSpace(_search) ? null : _search;
                var nsPrefix = string.IsNullOrWhiteSpace(_namespace) ? null : _namespace;
                var filter = new ObjectListFilter(
                    Kinds: _selectedKinds.Count == 0 ? null : _selectedKinds.ToList(),
                    Search: trimmedSearch);
                var (col, desc) = EffectiveSort();
                var page = await Search.SearchObjectsPageInReleaseAsync(
                    ReleaseId, filter, moduleId, nsPrefix, col, desc,
                    skip: _objectResults.Count, take: ObjectsPageSize,
                    includeInherited: _includeInherited);
                _objectResults.AddRange(page.Rows);
                _objectsTotal = page.TotalCount;
            }
            finally
            {
                _reloadGate.Release();
            }
        }
        finally
        {
            _objectsLoadingMore = false;
        }
        StateHasChanged();
    }

    private static string FormatStatus(string s) => s switch
    {
        "ready"     => "Ready",
        "ingesting" => "Ingesting...",
        "failed"    => "Failed",
        _           => s,
    };

}
