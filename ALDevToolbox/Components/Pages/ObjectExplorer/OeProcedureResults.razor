@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerLinks Links
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Components.Shared

@*
    Procedure-search result table for the Release search page. Loading /
    empty / populated states.  Object links carry the view-Release seed so a
    follow-up Find references on an inherited base object stays seeded here.

    Archetype 5 (list) from the BC design handoff, same shape as
    TemplatesBrowser: one table, with skeleton rows in the real tbody under
    the real thead so the columns are already settled when data lands, and an
    .empty-state card rather than a bare line of muted text.
    See .design/design-migration.md.
*@

@if (Results is { Count: 0 })
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
            <span class="empty-state__title">No procedures match</span>
            <span class="empty-state__text">
                Procedure search matches on the name only. Try a shorter name, or
                switch to Source text to search the code itself.
            </span>
        </div>
    </div>
    return;
}
@if (Results is not null)
{
    <p class="u-muted">Showing @Results.Count.ToString("N0") procedure@(Results.Count == 1 ? "" : "s")@(Capped ? " (capped at " + Results.Count.ToString("N0") + " - narrow the search to see more)" : "").</p>
}
<table class="data-table">
    <thead>
        <tr>
            <th scope="col">Extension</th>
            <th scope="col">Object</th>
            <th scope="col">Kind</th>
            <th scope="col">Procedure</th>
            <th scope="col">Source</th>
        </tr>
    </thead>
    <tbody>
        @if (Results is null)
        {
            <TableSkeletonRows Columns="5" StateColumn="false" />
        }
        @foreach (var r in Results ?? new())
        {
            <tr>
                <td>@r.ModuleName</td>
                <td><a href="@ObjectLink(r.ObjectId)">@r.ObjectKind @r.ObjectName</a></td>
                <td>@r.ProcedureKind.Replace("_", " ")</td>
                <td>
                    <strong>@r.Name</strong>
                    @if (!string.IsNullOrEmpty(r.Signature))
                    {
                        <span class="u-muted">@r.Signature</span>
                    }
                    @if (!string.IsNullOrEmpty(r.ReturnType))
                    {
                        <span class="u-muted"> : @r.ReturnType</span>
                    }
                </td>
                <td>
                    @if (r.SourceFileId is { } fid)
                    {
                        <a href="@Links.SourceFile(fid, r.LineNumber, ViewReleaseSeed)">View source</a>
                    }
                    else
                    {
                        <span class="u-muted">—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Results is null)
{
    <div class="loading-block loading-block--under-table">
        <span class="spinner"></span><span>Loading procedures...</span>
    </div>
}

@code {
    [Parameter] public List<ReleaseProcedureMatch>? Results { get; set; }
    [Parameter] public int? ViewReleaseSeed { get; set; }
    /// <summary>True when the search found more procedures than it shows.</summary>
    [Parameter] public bool Capped { get; set; }

    /// <summary>Object-detail link, carrying the view-Release seed (so Find
    /// references on an inherited base object stays seeded at this Release).</summary>
    private string ObjectLink(long objectId) =>
        ViewReleaseSeed is { } from
            ? $"/object-explorer/object/{objectId}?from={from}"
            : $"/object-explorer/object/{objectId}";
}
