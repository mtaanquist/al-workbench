@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Components.Shared

@*
    Compare-scope results for the Release search page. Renders the file-level
    diff table by default and the object-level diff table when "Compare by"
    is set to objects. Both share OeCompareRowActions for the Open diff / Open
    cell. The parent owns which result list is populated (one or the other).

    Row status is the design system's edge keyline plus a leading glyph, not a
    pill - see RowStateIcon. The comparer's "added" / "removed" words map onto
    the handoff's object-diff family there, which is also where "removed"
    (absent from the handoff) was added.
*@

@if (string.IsNullOrWhiteSpace(CompareRight) && NothingToCompare)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="git-compare" Width="21" Height="21" /></span>
            <span class="empty-state__title">Nothing to compare with yet</span>
            <span class="empty-state__text">
                @(IsBuild
                    ? "This is the only finished build of its solution. Run another build, and you can compare the two here."
                    : "There is no other release of this kind to compare with. Import another one, and you can compare the two here.")
            </span>
        </div>
    </div>
    return;
}
@if (string.IsNullOrWhiteSpace(CompareRight))
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="git-compare" Width="21" Height="21" /></span>
            <span class="empty-state__title">Pick a release to compare against</span>
            <span class="empty-state__text">
                Choose the other release above and this page lists every file - or
                object - that differs between the two.
            </span>
        </div>
    </div>
    return;
}
@if (CompareBy == "objects")
{
    @RenderObjectCompareResults
    return;
}
@if (FileResults is { Count: 0 })
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="circle-check" Width="21" Height="21" /></span>
            <span class="empty-state__title">These two releases have the same files</span>
            <span class="empty-state__text">
                Nothing was added, removed or changed between them.
            </span>
        </div>
    </div>
    return;
}
@if (FileResults is not null)
{
    <p class="u-muted">
        @if (FileResultsTruncated)
        {
            <text>
                Showing the first @FileResults.Count.ToString("N0") of more than
                @FileResults.Count.ToString("N0") changed files - narrow the comparison.
            </text>
        }
        else
        {
            <text>Showing @FileResults.Count.ToString("N0") changed file@(FileResults.Count == 1 ? "" : "s").</text>
        }
    </p>
}
<table class="data-table data-table--edge">
    <thead>
        <tr>
            <th class="data-table__col-state"><span class="u-sr">Status</span></th>
            <th scope="col">Extension</th>
            <th scope="col">File</th>
            <th scope="col">Status</th>
            <th class="data-table__actions"><span class="u-sr">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @if (FileResults is null)
        {
            <TableSkeletonRows Columns="4" />
        }
        @* Virtualized: a release-to-release diff runs to thousands of rows, and
           rendering them all costs the same again in render-tree nodes held on
           the circuit plus a first-paint payload down the wire. The rows are a
           fixed --row-h tall, so ItemSize is exact; the spacers have to be
           `tr`s to stay legal inside a tbody. See issue #685. *@
        <Virtualize Items="FileResults ?? new()" Context="r" ItemSize="40" SpacerElement="tr" OverscanCount="12">
            <tr class="@RowStateIcon.RowClass(r.Status)">
                <td class="data-table__col-state"><RowStateIcon State="@r.Status" /></td>
                <td>@r.ModuleName</td>
                <td><code class="code">@r.Path</code></td>
                <td>@r.Status</td>
                <td class="data-table__actions">
                    <OeCompareRowActions Status="@r.Status" LeftFileId="r.LeftFileId" RightFileId="r.RightFileId" />
                </td>
            </tr>
        </Virtualize>
    </tbody>
</table>
@if (FileResults is null)
{
    <div class="loading-block loading-block--under-table">
        <span class="spinner"></span><span>Comparing releases...</span>
    </div>
}

@code {
    [Parameter] public string CompareRight { get; set; } = string.Empty;
    [Parameter] public string CompareBy { get; set; } = "files";
    [Parameter] public List<ReleaseCompareFileRow>? FileResults { get; set; }
    /// <summary>True when more files changed than <see cref="FileResults"/> lists.</summary>
    [Parameter] public bool FileResultsTruncated { get; set; }
    [Parameter] public List<ObjectCompareRow>? ObjectResults { get; set; }
    /// <summary>True when the picker has no release to offer, so the page says why instead of asking for a pick.</summary>
    [Parameter] public bool NothingToCompare { get; set; }
    /// <summary>True when the current release is a pipeline build, which changes how to get something to compare with.</summary>
    [Parameter] public bool IsBuild { get; set; }

    private RenderFragment RenderObjectCompareResults => __builder =>
    {
        // Unchanged objects are the bulk and rarely interesting - hide them and
        // surface the changes (matches the C/AL Base-vs-Customer use case).
        var changed = ObjectResults?.Where(r => r.Status != "unchanged").ToList();
        if (changed is { Count: 0 })
        {
            <div class="card">
                <div class="empty-state">
                    <span class="empty-state__icon"><Icon Name="circle-check" Width="21" Height="21" /></span>
                    <span class="empty-state__title">No objects changed</span>
                    <span class="empty-state__text">
                        @if (ObjectResults!.Count == 0)
                        {
                            <text>Neither release has any indexed objects to compare.</text>
                        }
                        else
                        {
                            <text>
                                All @ObjectResults.Count.ToString("N0") objects are identical in
                                both releases. Show changed files to catch a change outside an object.
                            </text>
                        }
                    </span>
                </div>
            </div>
            return;
        }
        if (changed is not null)
        {
            <p class="u-muted">Showing @changed.Count.ToString("N0") changed object@(changed.Count == 1 ? "" : "s") of @ObjectResults!.Count.ToString("N0").</p>
        }
        <table class="data-table data-table--edge">
            <thead>
                <tr>
                    <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                    <th scope="col">Type</th>
                    <th class="data-table__num">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Status</th>
                    <th class="data-table__actions"><span class="u-sr">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (changed is null)
                {
                    <TableSkeletonRows Columns="5" />
                }
                @foreach (var r in changed ?? new())
                {
                    <tr class="@RowStateIcon.RowClass(r.Status)">
                        <td class="data-table__col-state"><RowStateIcon State="@r.Status" /></td>
                        <td>@r.Kind</td>
                        <td class="data-table__num">@(r.ObjectId?.ToString() ?? "—")</td>
                        <td>@r.Name</td>
                        <td>@r.Status</td>
                        <td class="data-table__actions">
                            <OeCompareRowActions Status="@r.Status" LeftFileId="r.LeftFileId" RightFileId="r.RightFileId" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        if (changed is null)
        {
            <div class="loading-block loading-block--under-table">
                <span class="spinner"></span><span>Comparing objects...</span>
            </div>
        }
    };
}
