@page "/object-explorer/file/{FileId:long}"
@attribute [Authorize]
@inject ALDevToolbox.Services.ObjectExplorer.Explore.SourceViewerService SourceViewer
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ExplorerTreeService ExplorerTree
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ReleaseComparisonService Comparison
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerLinks Links
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ReferenceSessionService ReferenceSessions
@inject IHttpContextAccessor Http
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Explore
@using ALDevToolbox.Components.Shared
@using System.Text.Json
@using System.Security.Claims

@*
    Object Explorer source-file viewer (static SSR + source-viewer.js).
    Server renders the file content, outline and declarations into the HTML
    response; a small ES module (wwwroot/source-viewer.js) wires up the
    in-document affordances (outline filter, same-file jumps, Cmd-click,
    right-click menu, Find in this file). The page is intentionally not
    InteractiveServer - see .design/source-viewer-redesign.md for the
    rationale (Blazor enhanced-nav strips CodeMirror's runtime <style>
    tags on every interaction in the interactive mode).

    There was a second, interactive copy of this page for a while, as an
    env-flag rollback path. It outlived its one release by fifty-four more
    and was retired in #562; this is the only source viewer.
*@

<PageTitle>@(_header is null ? "Source" : BuildBreadcrumb(_header)) · AL Workbench</PageTitle>

@if (_header is null || _file is null)
{
    <div class="page">
        <PageHead Title="We couldn't find that file"
                  Subtitle="The release it belonged to may have been removed. Open Object Explorer to see what's available now." />
        <p><a class="btn" href="/object-explorer">Back to Object Explorer</a></p>
    </div>
}
else
{
@*
    The power-tool frame from pages-power.css. Head names the tool and the
    open file, bar carries the controls that change what you are looking at,
    body is the three-pane grid, foot is the status line. No <h1>: a .pw fills
    the shell's content area edge to edge and the page title lives in
    .pw__name, the same call the Translator took in PR 13.
*@
@* The explorer's width is rendered here, not applied by the script after
   load: the pane used to paint at its default width and jump to the
   reader's a frame later, on every navigation (#603). *@
<div class="pw u-compact object-explorer source-viewer"
     style="@_explorerWidthStyle"
     data-file-id="@FileId"
     data-initial-line="@(_highlightLine?.ToString() ?? string.Empty)"
     data-ref-set="@(_session?.Token ?? string.Empty)">
        <div class="pw__head">
            <div class="pw__title">
                <span class="pw__name">Object Explorer</span>
                @* The full module-relative path. The breadcrumb below carries
                   the release and module as links; this slot is the one place
                   the raw path is readable, so it keeps its title for the
                   deep folder layouts that ellipsise. *@
                <span class="pw__file" title="@_header.Path">@_header.Path</span>
            </div>

            <span class="pw__spacer"></span>

            <button type="button" class="btn btn--sm sv-explorer-toggle"
                    aria-pressed="@(_explorerHidden ? "false" : "true")"
                    aria-controls="sv-explorer"
                    title="Show or hide the file list">
                <Icon Name="panel-left" Width="14" Height="14" Css="btn__icon" />
                <span>Explorer</span>
            </button>

            <a class="btn btn--sm"
               href="@($"/api/object-explorer/files/{FileId}/download")"
               download
               title="Download the raw source for this file">
                <Icon Name="download" Width="14" Height="14" Css="btn__icon" />
                <span>Download source</span>
            </a>
        </div>

        <div class="pw__bar">
            @* Starts at the release, not at "Object Explorer": the tool's name is
               already in .pw__name one row above, and rendering it twice - once
               as plain text, once as a link - only asks the reader to work out
               which one is clickable. *@
            <nav class="sv-crumbs" aria-label="Breadcrumb">
                <a href="/object-explorer">@_header.ReleaseLabel</a>
                <span aria-hidden="true">›</span>
                <a href="@($"/object-explorer/module/{_header.ModuleId}")">@_header.ModuleName</a>
            </nav>

            <span class="pw__spacer"></span>

            @if (_compareTargets is { Count: > 0 })
            {
                @* Each option carries a prebuilt diff URL with the OLDER
                   release on the left, so added lines always read green in
                   the newer version regardless of which file you started
                   from. *@
                <SelectBox Class="sv-comparesel">
                    <select class="select" onchange="if (this.value) location.assign(this.value)" aria-label="Compare this file with the same file in another release">
                        <option value="">Compare with release...</option>
                        @foreach (var t in _compareTargets)
                        {
                            <option value="@(t.TargetIsOlder ? Links.CompareFile(t.TargetFileId, FileId) : Links.CompareFile(FileId, t.TargetFileId))">@t.ReleaseLabel</option>
                        }
                    </select>
                </SelectBox>
            }
        </div>

        <div class="pw__body">
        @* Folded here when the reader has folded it: a pane the script alone
           knows is hidden is rendered open, painted, and folded a frame
           later - the flash on every navigation in #603. *@
        <div class="oe@(_explorerHidden ? " is-explorer-hidden" : "")">
            @*
                Left pane: the release's modules, with the one holding this
                file expanded down to it. Rendered server-side along the
                current file's folder chain only; every other folder is a
                closed caret that fetches its children on first open (see
                wireExplorerTree in source-viewer.js). A Base Application
                module runs to thousands of files - shipping the whole tree
                in the page response is not an option.
            *@
            <div class="pane oe__left sv-pane--tools" id="sv-explorer">
                <div class="pane__head">
                    <span class="pane__title">Explorer</span>
                    @* Apps, not objects. The pane lists every app in the
                       release, so a count of the current app's objects here
                       would be counting a different thing than the pane
                       shows; that number belongs in the status line, where
                       the subject is the open file's app. *@
                    <span class="pane__count sv-tree-count"
                          data-apps="@_appCount.ToString("N0") @(_appCount == 1 ? "app" : "apps")">@_appCount.ToString("N0") @(_appCount == 1 ? "app" : "apps")</span>
                    <span class="pw__spacer"></span>
                    @* A vendor's folder layout is somebody else's filing
                       system. Grouping by object kind is usually what a reader
                       wants from an app they did not write. *@
                    <SelectBox Class="sv-tree-group">
                        <select class="select" aria-label="Group the file list by">
                            <option value="folder" selected="@(_grouping == ExplorerTreeService.TreeGrouping.Folder)">Folder</option>
                            <option value="kind" selected="@(_grouping == ExplorerTreeService.TreeGrouping.Kind)">Object type</option>
                            <option value="none" selected="@(_grouping == ExplorerTreeService.TreeGrouping.None)">No grouping</option>
                        </select>
                    </SelectBox>
                    <button type="button" class="btn btn--icon btn--sm sv-tree-collapse"
                            aria-label="Collapse all" title="Collapse every folder">
                        <Icon Name="chevrons-down-up" Width="14" Height="14" Css="btn__icon" />
                    </button>
                </div>
                @* Searches the whole release, not the rows on screen: the tree
                   only holds what has been opened, so filtering it would search
                   a handful of apps out of eighty-six. *@
                <div class="sv-sec-tools sv-tree-tools" data-release-id="@_header.ReleaseId">
                    <span class="search">
                        <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                        @* The shortcut lives on the control rather than in the
                           status line: the box is already visible, so the key
                           is a convenience, and the foot is for the gestures
                           in the code pane that have no on-screen affordance. *@
                        <input type="search"
                               class="input sv-tree-search"
                               placeholder="Search this release..."
                               title="Search every app in this release (F3 or Ctrl/Cmd+Shift+F)"
                               data-page-search aria-keyshortcuts="F3 Control+Shift+F"
                               aria-label="Search every app in this release for a file or object" />
                    </span>
                </div>
                <div class="pane__body">
                    <div class="otree sv-tree" data-view-release="@(_viewReleaseId?.ToString())" data-module-id="@_header.ModuleId" data-release-id="@_header.ReleaseId" data-grouping="@_grouping">
                        @foreach (var node in _tree)
                        {
                            <OeTreeRow Node="node" ViewReleaseId="_viewReleaseId" />
                        }
                    </div>
                </div>
            </div>

            @* Drag handle between the tree and the editor. source-viewer.js
               wires the pointer events and persists the chosen width in
               localStorage so subsequent loads inherit the user's choice. *@
            <div class="pw-split"
                 role="separator"
                 aria-orientation="vertical"
                 aria-label="Resize the explorer"
                 data-split="left"
                 tabindex="0"><span class="pw-split__grip" aria-hidden="true"></span></div>

            <div class="oe__centre">
                @*
                    spellcheck="false" - AL identifiers (camelCase names,
                    quoted phrases like "Sell-to Customer Name") trigger
                    browser spellcheck's red squiggly underline, which is
                    trivially confusable with the resolvable / declaration
                    dotted underlines this viewer paints. Turning it off
                    across the whole editor surface so what you see under
                    a token is always us, never Chrome / Firefox.
                *@
                <div class="source-viewer__code"
                     data-language="al"
                     @* The status bar's two facts about the FILE rather than
                        about the editor (#568). Language is constant here -
                        every file the Object Explorer ingests is AL - and the
                        runtime is the owning module's App.Runtime, absent when
                        the manifest did not declare one. *@
                     data-runtime="@_header.Runtime"
                     data-content="@_file.Content"
                     data-declarations="@SerializeDeclarations(FilterNavigableDeclarations(_declarations))"
                     data-resolvables="@SerializeResolvables(_resolvables)"
                     data-procedures="@SerializeProcedures(_outline)"
                     data-view-release="@(_viewReleaseId?.ToString())"
                     spellcheck="false"></div>
            </div>

            <div class="pw-split"
                 role="separator"
                 aria-orientation="vertical"
                 aria-label="Resize the inspector"
                 data-split="right"
                 tabindex="0"><span class="pw-split__grip" aria-hidden="true"></span></div>

            @*
                The inspector rail. .pane is the power-tool pane shell from
                pages-power.css: a fixed head over a scrolling body. The grid
                column owns the width (the drag handle writes --oe-right on
                the .pw root); the pane owns the internal scroll, so width and
                overflow never fight on the same element.
            *@
                <div class="pane oe__right">
                @{
                    var defaultTab = _session is not null ? "references" : "outline";
                }
                <div class="pane__head">
                    <span class="pane__title">Inspector</span>
                    <span class="pw__spacer"></span>
                    <span class="pill-tabs" role="tablist">
                        <button type="button"
                                class="pill-tab source-viewer__tab @(defaultTab == "outline" ? "is-active" : null)"
                                role="tab"
                                data-tab="outline"
                                aria-selected="@(defaultTab == "outline" ? "true" : "false")">Outline</button>
                        <button type="button"
                                class="pill-tab source-viewer__tab @(defaultTab == "references" ? "is-active" : null)"
                                role="tab"
                                data-tab="references"
                                aria-selected="@(defaultTab == "references" ? "true" : "false")"
                                hidden="@(_session is null)">
                            Refs
                            @if (_session is not null)
                            {
                                <span class="pill-tab__count source-viewer__tab-count">@_session.Results.Count.ToString("N0")</span>
                            }
                        </button>
                        <button type="button"
                                class="pill-tab source-viewer__tab"
                                role="tab"
                                data-tab="find"
                                aria-selected="false"
                                hidden>Find</button>
                    </span>
                </div>

                <div class="pane__body">

                <div class="source-viewer__panel @(defaultTab == "outline" ? "is-active" : null)"
                     data-panel="outline"
                     role="tabpanel">
                    @if (_outline is null || _outline.Count == 0)
                    {
                        <p class="u-muted source-viewer__panel-empty">
                            We couldn't read any procedures or fields out of this file.
                            You can still search it with <span data-mod-key>Ctrl</span>+F, or download the source.
                        </p>
                    }
                    else
                    {
                        <div class="sv-sec-tools">
                            <span class="search">
                                <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                                <input type="text"
                                       class="input sv-filter"
                                       placeholder="Filter outline..."
                                       aria-label="Filter the outline" />
                            </span>
                        </div>

                        var groups = SourceFileOutlineGrouper.Build(_outline, filter: null);
                        <p class="u-muted sv-empty" hidden>No matches.</p>
                        @foreach (var group in groups)
                        {
                            <section class="pane__sec sv-section is-open"
                                     data-section-key="@group.Key">
                                <button type="button"
                                        class="pane__sec-h sv-sec-h sv-section__toggle"
                                        aria-expanded="true">
                                    <span class="otree__caret is-open" aria-hidden="true">
                                        <Icon Name="chevron-right" Width="12" Height="12" />
                                    </span>
                                    <span class="sv-section__title">@group.Title</span>
                                    <span class="pane__count sv-section__count">@group.Items.Count</span>
                                </button>
                                <div class="olist sv-list">
                                    @foreach (var entry in group.Items)
                                    {
                                        var item = entry.Item;
                                        var href = item.ObjectId is { } oid
                                            ? $"/object-explorer/object/{oid}"
                                            : $"/object-explorer/file/{FileId}?line={item.LineNumber}";
                                        <a class="orow sv-row @(entry.IsChild ? "orow--child" : null)"
                                           href="@href"
                                           title="@FormatTooltip(item)"
                                           data-row-name="@item.Name"
                                           data-symbol-id="@(item.SymbolId?.ToString() ?? "")"
                                           data-object-id="@(item.ObjectId?.ToString() ?? "")"
                                           data-line="@(item.ObjectId is null ? item.LineNumber.ToString() : null)">
                                            <span class="orow__glyph @KindGlyphClass(item.Kind)" aria-hidden="true">@KindGlyph(item.Kind)</span>
                                            <span class="orow__name">@item.Name</span>
                                            <span class="orow__type">@OutlineRowType(item)</span>
                                        </a>
                                    }
                                </div>
                            </section>
                        }
                    }

                    @* Outline-bottom dependency sections (#148). The shells
                       render empty on SSR; source-viewer.js fetches
                       /api/object-explorer/files/{id}/dependencies on mount
                       and fills in the lists. Outside the `else` on purpose:
                       these answer "what does this touch", which is still a
                       question worth answering for a file whose body we
                       could not parse. *@
                    <section class="pane__sec sv-section is-open"
                             data-section-key="using"
                             data-deps-section="using">
                        <button type="button"
                                class="pane__sec-h sv-sec-h sv-section__toggle"
                                aria-expanded="true">
                            <span class="otree__caret is-open" aria-hidden="true">
                                <Icon Name="chevron-right" Width="12" Height="12" />
                            </span>
                            <span class="sv-section__title">Uses</span>
                            <span class="pane__count sv-section__count" data-deps-count>...</span>
                        </button>
                        <div class="olist sv-list" data-deps-list="using"></div>
                    </section>
                    <section class="pane__sec sv-section is-open"
                             data-section-key="used-by"
                             data-deps-section="used-by">
                        <button type="button"
                                class="pane__sec-h sv-sec-h sv-section__toggle"
                                aria-expanded="true">
                            <span class="otree__caret is-open" aria-hidden="true">
                                <Icon Name="chevron-right" Width="12" Height="12" />
                            </span>
                            <span class="sv-section__title">Used by</span>
                            <span class="pane__count sv-section__count" data-deps-count>...</span>
                        </button>
                    <div class="olist sv-list" data-deps-list="used-by"></div>
                </section>
                </div>

                @*
                    References panel: when a refSet token is present on the
                    URL, ship the session payload as a data-* attribute and
                    let source-viewer.js render the panel client-side. This
                    keeps the grouping / row rendering logic in one place
                    (renderReferencesPanel) - the server is the cache for
                    the result list, the client is the single renderer.
                *@
                <div class="source-viewer__panel @(defaultTab == "references" ? "is-active" : null)"
                     data-panel="references"
                     role="tabpanel"
                     data-session="@SerializeSession(_session)"
                     hidden="@(_session is null)"></div>

                <div class="source-viewer__panel" data-panel="find" role="tabpanel" hidden>
                    <div class="source-viewer__find-host"></div>
                </div>

                <p class="u-muted source-viewer__notice" role="status" hidden></p>
                </div>
                </div>
        </div>
        </div>

        @* Status line. The keyboard and mouse model used to live entirely
           behind an unlabelled (i) in the inspector head, which is where the
           handoff says it does not belong: it puts the hints in the footer,
           always visible, never switched to. #566. The Inspector's shortcuts
           panel stays for the two gestures too long to spell out here. *@
        <div class="pw__foot">
            <span>@_header.ModuleName - @_moduleObjectCount.ToString("N0") objects</span>
            <span class="pw__sep"></span>
            <span class="kbd-hint">
                <span class="kbd" data-mod-key>Ctrl</span><span class="kbd">click</span><span class="kbd-hint__label">definition</span>
            </span>
            <span class="kbd-hint">
                <span class="kbd">Shift</span><span class="kbd">F12</span><span class="kbd-hint__label">references</span>
            </span>
            <span class="kbd-hint">
                <span class="kbd" data-mod-key>Ctrl</span><span class="kbd">F</span><span class="kbd-hint__label">find in this file</span>
            </span>
            @* Searching the whole release IS in the foot, where the other
               shortcut used to argue it did not belong: "the box is already
               visible, so the key is a convenience". That stopped being true
               when the explorer started folding away by default below 1100px
               and on demand at any width (#569) - with the pane hidden the box
               is not visible, the shortcut is the only route to it, and it was
               advertised nowhere a reader would look. #567. *@
            <span class="kbd-hint">
                <span class="kbd" data-mod-key>Ctrl</span><span class="kbd">Shift</span><span class="kbd">F</span><span class="kbd-hint__label">search the release</span>
            </span>
            @* No line count here: the editor's own status bar already carries
               one, and the two disagreed - the header column counts newlines,
               CodeMirror counts lines. One of them has to be the answer, and
               it is the one that moves with the cursor. *@
            <span class="kbd-hint">
                <span class="kbd-hint__label">Right-click a name, in the code or the outline, for more</span>
            </span>
        </div>

        @* source-viewer.js is loaded at the shell (App.razor) - Blazor
           enhanced-nav doesn't execute <script> tags injected via page
           responses. The module's MutationObserver picks up the
           .source-viewer DOM as soon as it appears. *@
</div>
}

@code {
    [Parameter] public long FileId { get; set; }

    private SourceFileHeader? _header;
    private SourceFileDetail? _file;
    private List<SourceFileOutlineItem>? _outline;
    private IReadOnlyList<CodeViewerDeclaration>? _declarations;
    private IReadOnlyList<CodeViewerResolvable>? _resolvables;
    private List<CompareTargetOption>? _compareTargets;
    private List<OeTreeNode> _tree = [];
    private int _moduleObjectCount;
    private int _appCount;
    /// <summary>
    /// How the explorer arranges this app's files. Read from a cookie the
    /// select writes, so a navigation renders the reader's arrangement
    /// straight away rather than painting folders and correcting itself.
    /// </summary>
    private string _grouping = ExplorerTreeService.TreeGrouping.Folder;
    /// <summary>
    /// Whether the reader has folded the explorer away. Read from the cookie
    /// the toggle writes, so a folded pane is folded in the HTML rather than
    /// painting open and correcting itself a frame later (#603).
    /// </summary>
    private bool _explorerHidden;
    /// <summary>
    /// The explorer's stored width as an inline <c>--oe-left</c> declaration,
    /// or null when the reader has never dragged the divider. Same reason as
    /// <see cref="_explorerHidden"/>: applying it after load makes the pane
    /// stick at its default width for a frame on every navigation.
    /// </summary>
    private string? _explorerWidthStyle;

    // Kept in step with SPLIT_SPECS.left in wwwroot/source-viewer.js - the
    // script clamps to the same range before it writes the cookie, and a
    // hand-edited cookie must not be able to squeeze the code column out.
    private const int ExplorerMinWidthPx = 180;
    private const int ExplorerMaxWidthPx = 520;
    private int? _highlightLine;
    private ReferenceSession? _session;
    // Release the user is viewing from (?from=). When this file is a base
    // object opened from a solution Release, find-references and go-to-def
    // navigation stay seeded here so the solution's own code is included.
    private int? _viewReleaseId;

    protected override async Task OnInitializedAsync()
    {
        _header = await SourceViewer.GetFileHeaderAsync(FileId);
        if (_header is null) return;
        _file = await SourceViewer.GetFileAsync(FileId);
        _outline = await SourceViewer.GetFileOutlineAsync(FileId);
        _declarations = await SourceViewer.ListDeclarationsInFileAsync(FileId);
        _resolvables = await SourceViewer.ListResolvablesInFileAsync(FileId);
        _compareTargets = await Comparison.GetCompareTargetsAsync(FileId);
        _grouping = ExplorerTreeService.TreeGrouping.Parse(
            Http.HttpContext?.Request.Cookies["aldt-oe-grouping"]);
        _explorerHidden = Http.HttpContext?.Request.Cookies["aldt-oe-explorer-hidden"] == "1";
        _explorerWidthStyle = BuildExplorerWidthStyle(
            Http.HttpContext?.Request.Cookies["aldt-oe-explorer-width"]);
        _tree = await ExplorerTree.GetExplorerTreeAsync(FileId, _grouping);
        _moduleObjectCount = await ExplorerTree.CountModuleObjectsAsync(_header.ModuleId);
        _appCount = _tree.Count(n => n.Kind == "module");

        var ctx = Http.HttpContext;
        if (ctx is not null && int.TryParse(ctx.Request.Query["line"], out var line) && line > 0)
        {
            _highlightLine = line;
        }

        if (ctx is not null && int.TryParse(ctx.Request.Query["from"], out var from) && from > 0)
        {
            _viewReleaseId = from;
        }

        var refSet = ctx?.Request.Query["refSet"].ToString();
        if (!string.IsNullOrEmpty(refSet))
        {
            var owner = OwnerKey(ctx);
            if (owner is not null)
            {
                _session = ReferenceSessions.Get(refSet, owner);
            }
        }
    }

    /// <summary>
    /// The stored explorer width as an inline custom-property declaration.
    /// Returns null for a missing, unparsable, or out-of-range cookie so the
    /// stylesheet's own default stands.
    /// </summary>
    private static string? BuildExplorerWidthStyle(string? cookie)
    {
        if (!int.TryParse(cookie, out var px)) return null;
        if (px < ExplorerMinWidthPx || px > ExplorerMaxWidthPx) return null;
        return $"--oe-left: {px}px";
    }

    private string RefUrl(long fileId, int line)
    {
        var url = Links.SourceFile(fileId, line, _viewReleaseId);
        if (_session is not null)
        {
            url += "&refSet=" + Uri.EscapeDataString(_session.Token);
        }
        return url;
    }

    private static string? OwnerKey(HttpContext? ctx)
    {
        var user = ctx?.User;
        if (user?.Identity?.IsAuthenticated != true) return null;
        return user.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? user.Identity.Name;
    }

    private static string FormatSignature(string signature) => signature;

    /// <summary>
    /// Renders the page heading as <c>{Module} · {Namespace} · {File}</c> when
    /// the file has an AL namespace, otherwise <c>{Module} · {File}</c>. AL
    /// namespaces are the canonical "where does this live" identifier - the
    /// physical folder layout differs across vendors and BC versions, so the
    /// breadcrumb prefers the declared namespace over the raw <c>src/...</c>
    /// path. The full path is still available on the <c>title</c> of the
    /// heading for the rare cases when the folder layout matters.
    /// </summary>
    private static string BuildBreadcrumb(SourceFileHeader header)
    {
        var fileName = ExtractFileName(header.Path);
        if (!string.IsNullOrWhiteSpace(header.ObjectNamespace))
        {
            return $"{header.ModuleName} · {header.ObjectNamespace} · {fileName}";
        }
        return $"{header.ModuleName} · {fileName}";
    }

    private static string ExtractFileName(string path)
    {
        if (string.IsNullOrEmpty(path)) return path;
        // Module file paths are stored with forward slashes (the import
        // pipeline normalises both src/ and .Source.zip layouts to the same
        // shape). Stick to '/' rather than Path.GetFileName so the rendering
        // stays platform-independent in tests.
        var slash = path.LastIndexOf('/');
        return slash < 0 ? path : path[(slash + 1)..];
    }

    /// <summary>
    /// Serialises a reference session into the JSON shape source-viewer.js
    /// expects on the panel's data-session attribute. Empty string when
    /// there's no session - the JS reader treats that as "no panel".
    /// </summary>
    private static string SerializeSession(ReferenceSession? session)
    {
        if (session is null) return string.Empty;
        return JsonSerializer.Serialize(session, SessionJsonOptions);
    }

    private static readonly JsonSerializerOptions SessionJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
    };

    /// <summary>
    /// Human-readable form of a raw symbol / object kind
    /// (<c>event_publisher</c> -> "event pub"). The outline row leads with a
    /// one-character glyph now, so this reaches the user through the row's
    /// <c>title</c> and the reference group header's tooltip rather than a
    /// badge. Mirrored by <c>kindBadgeLabel</c> in <c>source-viewer.js</c> —
    /// keep the two in step when a new kind lands.
    /// </summary>
    private static string KindBadgeLabel(string kind) => kind.ToLowerInvariant() switch
    {
        "table_field" or "page_field" => "field",
        "page_action" => "action",
        "trigger" => "trigger",
        "label" => "label",
        "procedure" => "proc",
        "internal_procedure" => "internal",
        "protected_procedure" => "protected",
        "local_procedure" => "local",
        "event_publisher" => "event pub",
        "event_subscriber" => "event sub",
        "codeunit" => "codeunit",
        "table" => "table",
        "tableextension" => "table ext",
        "page" => "page",
        "pageextension" => "page ext",
        "report" => "report",
        "reportextension" => "report ext",
        "xmlport" => "xmlport",
        "query" => "query",
        "controladdin" => "controladd",
        "enum" => "enum",
        "enumextension" => "enum ext",
        "interface" => "interface",
        "permissionset" => "permset",
        "permissionsetextension" => "permset ext",
        "profile" => "profile",
        // Legacy C/AL object kinds (NAV exports).
        "menusuite" => "menusuite",
        "form" => "form",
        "dataport" => "dataport",
        "implemented_by" => "codeunit",
        _ => kind,
    };

    private static string FormatTooltip(SourceFileOutlineItem item)
    {
        var sb = new System.Text.StringBuilder(item.Name);
        if (!string.IsNullOrEmpty(item.Signature))
        {
            sb.Append(item.Signature);
        }
        // The outline row shows a one-character glyph rather than a kind
        // badge, so the tooltip is where the kind and the line number live.
        sb.Append(" - ").Append(KindBadgeLabel(item.Kind));
        if (item.Kind != "implemented_by")
        {
            sb.Append(", line ").Append(item.LineNumber);
        }
        // The description last, on its own line: the identity of the row is
        // what someone scanning the outline is checking, and a sentence in
        // front of it would push the name and line out of the first glance.
        if (!string.IsNullOrEmpty(item.Doc))
        {
            sb.Append('\n').Append(item.Doc);
        }
        return sb.ToString();
    }

    /// <summary>
    /// Leading glyph in an outline row. Exactly the three the handoff draws --
    /// <c>#</c> field, <c>f</c> procedure, <c>t</c> trigger -- and nothing for
    /// any other kind.
    ///
    /// An earlier version invented five more (<c>"</c> label, <c>{</c> object,
    /// <c>a</c> action, <c>e</c> event, <c>i</c> implemented-by). A fresh-eyes
    /// review found them undecodable, which they are: a single character can
    /// only be a mnemonic for a word the reader can guess from it. The column
    /// stays because it is doing two other jobs -- the glyph is tinted, so it
    /// reads as colour at a glance, and it gives every row a fixed left gutter
    /// that aligns the names. A blank one keeps both and claims nothing.
    ///
    /// The kind is never lost: <see cref="FormatTooltip"/> spells it out, and
    /// the section header above the row already names it.
    /// </summary>
    private static string KindGlyph(string kind) => kind.ToLowerInvariant() switch
    {
        "table_field" or "page_field" => "#",
        "trigger" => "t",
        "procedure" or "internal_procedure" or "protected_procedure" or "local_procedure" => "f",
        _ => string.Empty,
    };

    /// <summary>
    /// Tint for <see cref="KindGlyph"/> -- the three variants the handoff
    /// declares, on the three kinds that have a glyph to tint. A kind with no
    /// glyph gets no accent: colouring an empty span accents nothing.
    /// </summary>
    private static string KindGlyphClass(string kind) => kind.ToLowerInvariant() switch
    {
        "table_field" or "page_field" => "orow__glyph--field",
        "procedure" or "internal_procedure" or "protected_procedure" or "local_procedure"
            => "orow__glyph--proc",
        "trigger" => "orow__glyph--trig",
        _ => string.Empty,
    };

    /// <summary>
    /// Right-hand column of an outline row.
    ///
    /// Fields carry their AL type in <c>Signature</c>. Procedures carry a
    /// return type only when the symbol-package importer captured one -- the
    /// source-text extractor's <c>DeclarationRegex</c> captures the parameter
    /// list and nothing else, so there is no return type to find in a
    /// signature and an earlier version of this method that looked for one
    /// returned empty for every source-extracted procedure.
    ///
    /// When there is no type to show, the column falls back to the line
    /// number. That is a divergence from the handoff, whose slot is always a
    /// type -- but an always-empty column is worse than a slightly different
    /// one, and the line number is what this row used to carry.
    /// </summary>
    private static string OutlineRowType(SourceFileOutlineItem item)
    {
        var kind = item.Kind.ToLowerInvariant();
        if (kind is "table_field" or "page_field" && !string.IsNullOrWhiteSpace(item.Signature))
        {
            return item.Signature.Trim();
        }
        if (!string.IsNullOrWhiteSpace(item.ReturnType)) return item.ReturnType.Trim();
        if (kind is "trigger") return "trigger";
        // "implemented_by" rows put the implementing module in Signature and
        // have no line of their own to fall back to.
        if (kind is "implemented_by") return item.Signature?.Trim() ?? string.Empty;
        return $"L{item.LineNumber}";
    }

    /// <summary>
    /// Serialises declarations to JSON the way <c>code-editor.js</c>'s
    /// <c>mountReadOnly</c> expects them: camelCase keys, single line, safe
    /// to embed into a <c>data-*</c> attribute (browser unescaping +
    /// JSON.parse on the client). Symbol ids round-trip as numbers since
    /// JavaScript handles all current ALDevToolbox IDs (well below 2^53).
    /// </summary>
    private static string SerializeDeclarations(IReadOnlyList<CodeViewerDeclaration>? declarations)
    {
        if (declarations is null || declarations.Count == 0) return "[]";
        return JsonSerializer.Serialize(declarations, DeclarationJsonOptions);
    }

    /// <summary>
    /// Serialises resolvable ranges into the JSON shape code-editor.js'
    /// <c>buildResolvableDecorationExtensions</c> expects on the
    /// <c>data-resolvables</c> attribute - camelCase keys, plain array.
    /// Underlines the tokens that <see cref="ObjectExplorerService.GoToDefinitionAsync"/>
    /// can resolve to a definition; right-click + Cmd-click already work on
    /// any position, but the underline tells users which tokens are clickable
    /// without having to probe by hovering.
    /// </summary>
    private static string SerializeResolvables(IReadOnlyList<CodeViewerResolvable>? resolvables)
    {
        if (resolvables is null || resolvables.Count == 0) return "[]";
        return JsonSerializer.Serialize(resolvables, DeclarationJsonOptions);
    }

    /// <summary>
    /// Serialises the procedure-like rows of the outline into the JSON shape
    /// code-editor.js's status-bar lookup expects on the
    /// <c>data-procedures</c> attribute - camelCase keys, plain array. Drives
    /// the "in CheckDates (line 13)" suffix that maps absolute editor lines
    /// to Business Central's procedure-relative stack-trace numbering (where
    /// the <c>procedure</c> declaration is line 0). Only kinds that BC can
    /// surface in a stack trace are included; fields, actions, labels and
    /// object headers are filtered out.
    /// </summary>
    private static string SerializeProcedures(IReadOnlyList<SourceFileOutlineItem>? outline)
    {
        if (outline is null || outline.Count == 0) return "[]";
        var procs = new List<ProcedureRange>(outline.Count);
        foreach (var item in outline)
        {
            if (!ProcedureKinds.IsProcedureLike(item.Kind)) continue;
            procs.Add(new ProcedureRange(item.LineNumber, item.EndLine, item.Name, item.Kind));
        }
        if (procs.Count == 0) return "[]";
        return JsonSerializer.Serialize(procs, DeclarationJsonOptions);
    }

    private sealed record ProcedureRange(int StartLine, int? EndLine, string Name, string Kind);

    /// <summary>
    /// Drops <b>field</b> and <b>trigger</b> declarations from the list
    /// passed to <c>code-editor.js</c>. The declarations list drives both
    /// <c>buildDeclarationDecorationExtensions</c> (the <c>cm-symbol-decl</c>
    /// underline) and the right-click "Find references" routing, so
    /// filtering at the source removes the visual noise AND stops the
    /// menu from offering an action that returns nothing useful:
    /// <list type="bullet">
    ///   <item>A page-side field LHS (the page's own field name) is a
    ///         declaration, not a navigation target - the RHS
    ///         <c>Rec."Field"</c> is what users want to click through
    ///         to the table's field. Underlining the LHS distracted
    ///         from the meaningful RHS reference.</item>
    ///   <item>Triggers (<c>OnValidate</c>, <c>OnAssistEdit</c>, ...) are
    ///         invoked by the runtime, not by user code. There's
    ///         nothing useful to navigate to from the trigger
    ///         declaration - Find references on a trigger returns the
    ///         empty set in practice.</item>
    /// </list>
    /// Object headers (codeunit / table / page / ...) and member-symbol
    /// declarations (procedures, event publishers / subscribers, labels)
    /// stay in the set - they ARE useful navigation targets.
    /// </summary>
    private static IReadOnlyList<CodeViewerDeclaration> FilterNavigableDeclarations(
        IReadOnlyList<CodeViewerDeclaration>? declarations)
    {
        if (declarations is null || declarations.Count == 0)
            return Array.Empty<CodeViewerDeclaration>();
        var kept = new List<CodeViewerDeclaration>(declarations.Count);
        foreach (var d in declarations)
        {
            if (IsNonNavigableDeclaration(d.Kind)) continue;
            kept.Add(d);
        }
        return kept;
    }

    /// <summary>
    /// Decides whether a declaration's underline + right-click "Find
    /// references" affordance should be shown. After the symbol-kind
    /// split (see .design/al-reference-extractor-refactor.md step 1),
    /// the kind alone carries the navigation intent - no owner-kind
    /// join needed:
    /// <list type="bullet">
    ///   <item><c>table_field</c> is the canonical field declaration -
    ///         a legitimate navigation target.</item>
    ///   <item><c>page_field</c> / <c>page_action</c> are page-local
    ///         control names - not navigation targets.</item>
    ///   <item><c>trigger</c> is runtime-invoked everywhere - never a
    ///         useful Find-references target.</item>
    /// </list>
    /// </summary>
    private static bool IsNonNavigableDeclaration(string kind) =>
        string.Equals(kind, "trigger", StringComparison.OrdinalIgnoreCase)
        || string.Equals(kind, "page_field", StringComparison.OrdinalIgnoreCase)
        || string.Equals(kind, "page_action", StringComparison.OrdinalIgnoreCase);

    private static readonly JsonSerializerOptions DeclarationJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
    };
}
