@page "/upgrades"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Bc.UpgradeFleetService Fleet
@inject ALDevToolbox.Services.ObjectExplorer.Bc.UpgradeActionService Actions
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ALDevToolbox.Services.ObjectExplorer.ProjectAccess Access
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<UpgradesPage> Log
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone
@using ALDevToolbox.Components.Shared
@using static ALDevToolbox.Components.Shared.FleetRowState
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer

@*
    Upgrades: every customer environment in one table, with the date Business
    Central will next update it, and the three moves the upgrade team makes in
    bulk: push the dates out, start the update, and change the version it goes to.

    Named user: a member of the BC upgrade team who schedules platform updates
    for around a hundred customers. Twice a quarter they push every customer's
    date out to the latest Microsoft allows; when a customer agrees a slot they
    start that one environment's update straight away. They know Business
    Central; they know nothing about this codebase.

    Archetype 15 (actionable list, PageUpgrades.dc.html): one sticky command bar
    over a table with a selection column. The bar holds the search, the view and
    the commands, in that order - the order Solutions and Environments use (#966;
    the sheet draws the view first, and the maintainer chose alignment); commands that need a selection are plainly disabled until rows
    are ticked, the way Business Central's own lists behave. No instruction - the
    checkboxes and the disabled buttons already say it. Filters live in the address,
    so a filtered fleet is something you can send a colleague.

    A search or a view change never unticks a row (#985): the team builds an evening's
    batch by finding each customer by short name in turn. So, unlike the sheet, the
    bar counts the selection once there is one, says how much of it is off screen,
    and offers Show selected and Clear selection beside the count.

    "Move dates" is this page's one primary: it is what the team comes here to do,
    a hundred at a time. "Start update..." is irreversible, and its dialog is where that
    is said - a typed word and a danger button - rather than in the bar.

    Where this page departs from the sheet, and why, is in
    .design/environment-updates.md. See also .design/saas-delivery.md and #657.
*@

<PageTitle>Upgrades · AL Workbench</PageTitle>

@* The subtitle describes what you do here; someone who can't do it is told
   that instead, by the card below.

   Archetype 15 has a sticky .cmdbar where a list has its filter row, so the bar
   goes in ListPage's Toolbar slot rather than being forced into FilterBar. *@
<ListPage Title="Upgrades"
          Subtitle="@(_denied ? string.Empty : "When each solution's environment moves to its next Business Central version, and how much longer you can put that off. Times you book land in the customer's local time.")"
          IsLoading="@(!_denied && _rows is null)"
          IsEmpty="@(_denied || (_rows is not null && _totalCount == 0))"
          HasNoMatches="@(_rows is { Count: 0 })"
          Trail='@([new("Home", "/"), new("Solutions", "/solutions"), new("Upgrades")])'>
    <Loading>
        <div class="upg-scroll">
        <table class="data-table data-table--edge">
            <thead>@TableHead(selectable: false)</thead>
            <tbody>
                @for (var i = 0; i < 4; i++)
                {
                    <tr aria-hidden="true">
                        <td class="data-table__col-check"></td>
                        <td class="data-table__col-state">
                            <span class="skeleton" style="display:block;width:15px;height:15px;border-radius:var(--r-pill)"></span>
                        </td>
                        @for (var c = 0; c < 7; c++)
                        {
                            <td><span class="skeleton" style="display:block;width:@(c == 6 ? "15px" : "60%")"></span></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <LoadingBlock Text="Loading environments..." UnderTable="true" />
    </Loading>
    <Empty>
        @if (_denied)
        {
            <div class="card">
                <EmptyState Icon="lock" Title="You don't have access to Upgrades">
                    <Text>Changing a solution's update date acts on its live Business Central environment. Access to Upgrades is granted per team. Ask an administrator to add environment updates to one of your teams.</Text>
                    <Action>
                        <a class="btn" href="/">
                            <Icon Name="house" Width="15" Height="15" />
                            <span>Go to Home</span>
                        </a>
                    </Action>
                </EmptyState>
            </div>
        }
        else
        {
            <div class="card">
                <EmptyState Icon="calendar" Title="No environments yet">
                    <Text>This page lists the Business Central environments of the solutions you can see. Connect a solution to its Business Central from the solution's own page, and its environments show up here.</Text>
                    <Action>
                        <a class="btn" href="/solutions">
                            <Icon Name="folder-git-2" Width="15" Height="15" />
                            <span>Go to Solutions</span>
                        </a>
                    </Action>
                </EmptyState>
            </div>
        }
    </Empty>
    <Toolbar>
        <div class="cmdbar">
            <div class="cmdbar__row">
                @* Filters as you type - the fleet is already in hand - and puts the
                   search in the address once you leave the box or press Enter. *@
                <span class="search cmdbar__search upg-search">
                    <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                    @* Bound, not value= plus oninput: a redraw must never write an older
                       value over what is still being typed (#981). *@
                    <input class="input" type="search"
                           placeholder="Search solution or environment..."
                           aria-label="Search solutions and environments"
                           data-page-search aria-keyshortcuts="F3" title="Search solutions and environments (F3)"
                           @bind="_search" @bind:event="oninput" @bind:after="OnSearchInput"
                           @onchange="OnSearchCommitted" />
                </span>
                <div class="cmdbar__group">
                    <SelectBox Class="upg-view">
                        <select class="select" aria-label="Filter environments"
                                value="@ViewValue(_type, _onlyWaiting)" @onchange="OnViewChanged">
                            <option value="@ViewValue(string.Empty, false)">All environments</option>
                            <option value="@ViewValue(string.Empty, true)">With an update waiting</option>
                            @if (_typeOptions.Count > 0)
                            {
                                <option disabled>--</option>
                                @foreach (var option in _typeOptions)
                                {
                                    <option value="@ViewValue(option, false)">@option only</option>
                                }
                                @foreach (var option in _typeOptions)
                                {
                                    <option value="@ViewValue(option, true)">@option, update waiting</option>
                                }
                            }
                        </select>
                    </SelectBox>
                </div>
                @if (_selection.Count > 0)
                {
                    @* Only once something is ticked. The count says how many of the
                       ticks a search or the view has taken off screen; the commands
                       act on all of them, and each dialog names every one first. *@
                    <div class="cmdbar__group">
                        <span class="upg-picked__count" aria-live="polite">@_selection.Summary(ShownActionableIds())</span>
                        <button type="button" class="btn btn--ghost @(_selection.ShowSelectedOnly ? "is-active" : "")"
                                aria-pressed="@(_selection.ShowSelectedOnly ? "true" : "false")"
                                disabled="@_running" @onclick="ToggleShowSelected">
                            <Icon Name="eye" Width="15" Height="15" />
                            <span>Show selected</span>
                        </button>
                        <button type="button" class="btn btn--ghost" disabled="@_running" @onclick="ClearSelection">
                            <Icon Name="x" Width="15" Height="15" />
                            <span>Clear selection</span>
                        </button>
                    </div>
                }
                <div class="cmdbar__group">
                    <button type="button" class="btn btn--primary" disabled="@ActionsDisabled"
                            title="Move the selected environments to their latest possible update date"
                            @onclick="() => ConfirmPushAsync()">
                        <Icon Name="calendar" Width="15" Height="15" />
                        <span>Move dates</span>
                    </button>
                    <button type="button" class="btn" disabled="@ActionsDisabled"
                            title="Start the Business Central update on the selected environments, now or at a time you book"
                            @onclick="() => ConfirmUpdateNowAsync()">
                        <Icon Name="zap" Width="15" Height="15" />
                        <span>Start update...</span>
                    </button>
                    <button type="button" class="btn" disabled="@ActionsDisabled"
                            title="Choose which Business Central version the selected environments update to next"
                            @onclick="() => ConfirmSelectVersionAsync()">
                        <Icon Name="tag" Width="15" Height="15" />
                        <span>Change the next version...</span>
                    </button>
                    <button type="button" class="btn" disabled="@_running"
                            title="Read the environments again from Business Central"
                            @onclick="RefreshDataAsync">
                        <Icon Name="refresh-cw" Width="15" Height="15" />
                        <span class="btn__label">Refresh</span>
                    </button>
                </div>
            </div>
        </div>

        @if (_notice is { } notice)
        {
            <div class="@notice.CssClass">
                <Icon Name="@(notice.Tone == "warn" ? "triangle-alert" : "info")" Width="14" Height="14" />
                <span>@notice.Text</span>
                @if (notice.ShowReloadNow)
                {
                    <button type="button" class="btn btn--sm" @onclick="ReloadNowAsync">
                        <Icon Name="refresh-cw" Width="13" Height="13" />
                        <span>Reload now</span>
                    </button>
                }
            </div>
        }

    </Toolbar>
    <NoMatches>
        <div class="card">
            <EmptyState Icon="funnel-x" Title="No environments match these filters">
                <Text>Try a shorter search, or clear the filters to see all @_totalCount.</Text>
                <Action>
                    <a class="btn" href="/upgrades">Clear filters</a>
                </Action>
            </EmptyState>
        </div>
    </NoMatches>
    <ChildContent>
        @* A narrow window cannot hold nine columns, and the page's own container
           clips rather than scrolls (#574), so the table gets a box of its own
           to scroll in. *@
        <div class="upg-scroll">
        <table class="data-table data-table--edge">
            <thead>@TableHead(selectable: true)</thead>
            <tbody>
                @foreach (var row in _rows!)
                {
                    var picked = _selection.Contains(row.EnvironmentId);
                    <tr @key="row.EnvironmentId"
                        class="@RowClass(row, picked)">
                        <td class="data-table__col-check">
                            @if (row.CanAct)
                            {
                                <label class="check" aria-label="@($"Select {row.ProjectName} {row.EnvironmentName}")">
                                    <input type="checkbox" checked="@picked" disabled="@_running"
                                           @onchange="e => TogglePick(row.EnvironmentId, e)" />
                                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                </label>
                            }
                            else
                            {
                                @* The legend under the table carries the explanation;
                                   this needs a name of its own so it isn't a silent
                                   glyph to a screen reader. *@
                                <span role="img" aria-label="Locked - you can't change this solution's dates">
                                    <Icon Name="lock" Width="13" Height="13" />
                                </span>
                            }
                        </td>
                        <td class="data-table__col-state">
                            <span class="data-table__state data-table__state--icon" role="img"
                                  aria-label="@StatusWord(row)" title="@StatusWord(row)">
                                <Icon Name="@StatusIcon(row)" Width="15" Height="15" />
                            </span>
                        </td>
                        @* The environment leads: the page is a list of environments, so the
                           first link in a row opens the environment. The solution sits
                           beside it and both stay put when the table scrolls sideways. *@
                        <td class="upg-env">
                            <span class="cell-stack">
                                <a class="cell-stack__main" href="@($"/environments/{row.EnvironmentId}")" title="@row.EnvironmentName">@row.EnvironmentName</a>
                                <span class="cell-stack__sub">@row.EnvironmentType</span>
                            </span>
                        </td>
                        <td class="upg-customer">
                            <a href="@($"/solutions/{row.ProjectId}")">@row.ProjectName</a>
                            @if (!string.IsNullOrEmpty(row.ProjectShortName))
                            {
                                <span class="sol-list__short" title="Short name">@row.ProjectShortName</span>
                            }
                        </td>
                        @* Major.minor in both version columns so "27.5" and "27.6" can be
                           compared at a glance; the full build is on hover. *@
                        <td class="u-num" title="@row.Version">@ShortVersion(row.Version)</td>
                        <td class="upg-next">
                            <span class="cell-stack">
                                <span class="cell-stack__main" style="font-weight: var(--fw-semibold)"
                                      title="@row.NextUpdateVersion">@(row.HasUpdate ? ShortVersion(row.NextUpdateVersion) : "—")</span>
                                <span class="cell-stack__sub">@if (row.NextUpdateDate is { } nextAt) { <Timestamp Value="@nextAt" Format="dd MMM yyyy, HH:mm" /> } else { @UpdateWhen(row) }</span>
                            </span>
                            @if (row.NextUpdateIgnoresWindow == true)
                            {
                                <div class="upg-note upg-note--warn">
                                    <Icon Name="triangle-alert" Width="12" Height="12" />
                                    <span>Runs outside the solution's update window</span>
                                </div>
                            }
                            @* A short outcome sits here, under the update it is about and
                               in line with the marker above. Only a result that needs
                               room - a refusal, a link, a booking to call off - gets the
                               full-width line under the row. *@
                            @if (_results.TryGetValue(row.EnvironmentId, out var brief) && brief.IsBrief)
                            {
                                <div class="@brief.CssClass">
                                    @if (brief.Tone == "busy")
                                    {
                                        <span class="spinner"></span>
                                    }
                                    else if (brief.Tone == "ok")
                                    {
                                        <Icon Name="circle-check" Width="12" Height="12" />
                                    }
                                    <span>@brief.Text</span>
                                </div>
                            }
                            @* An update somebody is sitting on the page to see through (#982):
                               re-read from Business Central every few seconds until it ends,
                               then the ending, in the same place. *@
                            @if (_watched.TryGetValue(row.EnvironmentId, out var watch))
                            {
                                <div class="upg-note upg-note--busy" role="status">
                                    <span class="spinner"></span>
                                    <span>Updating... started <Timestamp Value="@watch.StartedUtc" Relative="true" /></span>
                                </div>
                            }
                            else if (_watchEnded.TryGetValue(row.EnvironmentId, out var ended))
                            {
                                <div class="@ended.CssClass" role="status">
                                    @if (ended.Tone == "ok")
                                    {
                                        <Icon Name="circle-check" Width="12" Height="12" />
                                    }
                                    else if (ended.Tone == "bad")
                                    {
                                        <Icon Name="circle-alert" Width="12" Height="12" />
                                    }
                                    <span>@ended.Text</span>
                                    @if (ended.ShowOperations)
                                    {
                                        <a class="upg-note__link" href="@($"/environments/{row.EnvironmentId}/operations")">See what happened →</a>
                                    }
                                </div>
                            }
                            @* A booking survives a reload, and this marker is the only
                               trace of one on the table - the batch result that announced
                               it is gone the moment the page reloads. So it carries the
                               whole fact (when, whose) and both ways to act on it: the
                               marker itself opens the history, and a single booking can
                               be called off without opening anything. It sits under the
                               date Business Central would otherwise run on, because a
                               booked slot and that date are two answers to one question
                               and reading them in different columns invites picking the
                               wrong one. *@
                            @if (PendingFor(row.EnvironmentId) is { Count: > 0 } waiting)
                            {
                                <div class="upg-booked">
                                    <button type="button" class="upg-booked__open"
                                            aria-expanded="@(_feedEnvId == row.EnvironmentId ? "true" : "false")"
                                            @onclick="() => ToggleFeedAsync(row)">
                                        <Icon Name="clock" Width="12" Height="12" />
                                        <span>@BookedMarkerText(row, waiting)</span>
                                    </button>
                                    @if (waiting.Count == 1 && row.CanAct)
                                    {
                                        <button type="button" class="btn btn--sm upg-booked__cancel"
                                                @onclick="() => CancelActionAsync(waiting[0].Id)">Cancel booking</button>
                                    }
                                </div>
                            }
                        </td>
                        <td><Timestamp Value="@row.EffectiveLatestDate" Format="dd MMM yyyy" Placeholder="—" /></td>
                        <td class="upg-checked @(IsStale(row) ? "upg-stale" : "u-muted")">
                            @if (row.FetchedAt is { } at) { <Timestamp Value="@at" Relative="true" /> } else { <text>Not checked yet</text> }
                        </td>
                        <td class="data-table__actions">
                            @* History leads the menu: it is the one entry every row
                               has, and the only one that changes nothing. The two
                               that act go through the same dialogs as the bar, on
                               this row alone, and leave the ticked rows as they were. *@
                            <RowActions Label="@($"Actions for {row.ProjectName} {row.EnvironmentName}")">
                                <button type="button" class="menu__item" role="menuitem"
                                        @onclick="() => ToggleFeedAsync(row)">
                                    @(_feedEnvId == row.EnvironmentId ? "Hide update history" : "Update history")
                                </button>
                                @if (row.CanAct)
                                {
                                    <button type="button" class="menu__item" role="menuitem" disabled="@_running"
                                            @onclick="() => ConfirmPushAsync(row)">Move this date to the latest</button>
                                    <button type="button" class="menu__item" role="menuitem" disabled="@_running"
                                            @onclick="() => ConfirmUpdateNowAsync(row)">Start this update...</button>
                                    <button type="button" class="menu__item" role="menuitem" disabled="@_running"
                                            @onclick="() => ConfirmSelectVersionAsync(row)">Change the next version...</button>
                                }
                                @* The two ways out of this page, after the things done on it. *@
                                <div class="menu__sep"></div>
                                <a class="menu__item" role="menuitem" href="@($"/environments/{row.EnvironmentId}")">Open environment</a>
                                @if (row.BusinessCentralUrl is { } bcUrl)
                                {
                                    <a class="menu__item" role="menuitem" href="@bcUrl"
                                       target="_blank" rel="noopener">Open in Business Central</a>
                                }
                            </RowActions>
                        </td>
                    </tr>
                    @* What the last run did to this row, on a line of its own. It used
                       to sit in the Next update cell, where a long refusal from Business
                       Central widened that column and squeezed every other one. *@
                    @if (_results.TryGetValue(row.EnvironmentId, out var result) && !result.IsBrief)
                    {
                        @* The row's own classes, so its state bar and its ticked tint run
                           through the result: the two read as one block. *@
                        <tr class="is-subrow upg-result-row @RowClass(row, picked)" @key="@($"result-{row.EnvironmentId}")">
                            <td colspan="2"></td>
                            <td colspan="7">
                                <div class="upg-result">
                                    <div class="@result.CssClass">
                                        @if (result.Tone == "busy")
                                        {
                                            <span class="spinner"></span>
                                        }
                                        <span>@result.Text</span>
                                        @if (result.LinkLabel is { } linkLabel)
                                        {
                                            <a class="upg-note__link" href="@($"/solutions/{result.ProjectId}")">@linkLabel</a>
                                        }
                                        @* A booked slot is the one result you might want to
                                           take back, so the way to do that is on the result
                                           itself rather than two clicks away in the feed. *@
                                        @if (result.ActionId is { } bookedId)
                                        {
                                            <button type="button" class="btn btn--sm upg-note__cancel"
                                                    @onclick="() => CancelActionAsync(bookedId)">Cancel booking</button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (_feedEnvId == row.EnvironmentId)
                    {
                        <tr class="is-subrow" @key="@($"feed-{row.EnvironmentId}")">
                            <td colspan="9">
                                <div class="upg-feed">
                                    @* Named in full: a dozen rows have an environment
                                       called Production, so the environment alone does
                                       not say whose history this is. *@
                                    <h2 class="upg-feed__title">Update history - @row.ProjectName, @row.EnvironmentName</h2>
                                    @* No CanActOnUploads: this page is the update team's, and a booked
                                       upload is called off from the environment's own page. *@
                                    <EnvironmentActivityFeed Entries="_feed"
                                                             CanAct="row.CanAct"
                                                             TimeZone="UpdateWindow.ResolveTimeZone(row.TimeZone)"
                                                             TimeZoneLabel="@ZoneLabel(row.TimeZone)"
                                                             OnCancel="CancelActionAsync" />
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
    </ChildContent>
    <Footer>
        <div class="pager">
            <span class="pager__count">Showing @_rows!.Count of @_totalCount environment@(_totalCount == 1 ? "" : "s")</span>
        </div>

        @* Only when there is actually a padlock on screen to explain. A hover
           title alone was invisible on a touch screen, to the keyboard, and to a
           screen reader. *@
        @if (_rows.Any(r => !r.CanAct))
        {
            <p class="upg-legend">
                <Icon Name="lock" Width="13" Height="13" />
                <span>Rows with a padlock belong to a team you're not on, so you can't change their dates.</span>
            </p>
        }
    </Footer>
</ListPage>

@* Both confirms preview exactly what the run will do, row by row, including the
   rows it will pass over - the alternative is a person pressing a button on
   ninety customers and finding out afterwards. The ones that will be passed over
   are grouped at the bottom so the top of the list is only what will happen. *@
<ConfirmDialog @ref="_pushConfirm" Wide="true"
               Title="@(_single is null ? "Move these update dates?" : "Move this update date?")"
               Message="The version each environment updates to doesn't change - only the date it runs. Each date moves to the latest Business Central still allows."
               ConfirmLabel="Move the dates" ConfirmButtonClass="btn" ConfirmIcon="calendar"
               WorkingContent="@RunProgress()">
    @PreviewList()
</ConfirmDialog>

@* One dialog, two voices. Starting an update now is irreversible and wears the
   danger button and the typed word; booking one for later can be called off from
   this page until it runs, and saying "you cannot stop it" over a thing with a
   Cancel button would be a straight contradiction. So the title, the sentence, the
   button label and its colour all follow the choice. *@
<ConfirmDialog @ref="_nowConfirm" Wide="true"
               Title="@NowDialogTitle"
               Message="@NowDialogMessage"
               ConfirmLabel="@NowConfirmLabel"
               ConfirmButtonClass="@(_scheduleLater ? "btn" : "btn--danger")"
               ConfirmIcon="@(_scheduleLater ? "clock" : "zap")"
               ConfirmDisabled="@(_scheduleLater && SlotProblem() is not null)"
               RequireWord="@(_scheduleLater ? null : "update")"
               GraceSeconds="@(_scheduleLater ? 0 : StartGraceSeconds)"
               GraceContent="@PreviewList()"
               WorkingContent="@RunProgress()">
    @PreviewList()

    @* The whole reason a slot exists: the team agrees "tonight at 20:00" with a
       customer in the morning and books it, rather than sitting on the page all
       evening. Immediately stays the default, because most of the time that is
       what a customer on the phone is asking for. *@
    <fieldset class="upg-when">
        <legend class="upg-when__legend">When should this run?</legend>
        <label class="upg-when__opt">
            <input type="radio" name="upg-when" checked="@(!_scheduleLater)"
                   @onchange="() => SetScheduleLater(false)" />
            <span>Immediately</span>
        </label>
        <label class="upg-when__opt">
            <input type="radio" name="upg-when" checked="@_scheduleLater"
                   @onchange="() => SetScheduleLater(true)" />
            <span>Later, at a time I pick</span>
        </label>
        @if (_scheduleLater)
        {
            <div class="upg-when__pick">
                <input type="datetime-local" class="input" @bind="_slotLocal" @bind:event="oninput" />
            </div>
            @* The browser draws that field in its own locale, which on a machine set
               to English (US) is a 12-hour clock while every other time on this page
               is 24-hour. So the booking is said back in the page's own words, always
               visible, and that sentence is what settles what was picked. *@
            <p class="upg-when__echo">@SlotEchoText()</p>
            @if (SlotProblem() is { } problem)
            {
                <FieldError Message="@problem" />
            }
            <small class="field__hint">
                You can cancel a booked update from this page right up until it runs.
            </small>
        }
    </fieldset>

    @* Directly above the confirm: the last thing read before the click should be
       how much of the fleet this is, and how much of it is production. *@
    <p class="upg-preview__count">@PreviewCountLine()</p>
</ConfirmDialog>

@* The third move (#960): "everyone goes to 29.2". The versions come from what Business
   Central last offered the selected rows, so the list can only hold something at least
   one of them can take, and each says how many. Picking one sorts every selected row into
   the group it lands in, from the same mirror - the run re-reads each environment before
   it writes, so a stale mirror can make this preview hopeful but never the write wrong.
   The typed word is the one the page already asks for before touching a customer's
   production update. *@
<ConfirmDialog @ref="_versionConfirm" Wide="true"
               Title="@(_single is null ? "Change the next version?" : "Change this environment's next version?")"
               Message="Pick the Business Central version to update to next. Environments set to a later version move back to it."
               ConfirmLabel="@VersionConfirmLabel" ConfirmButtonClass="btn" ConfirmIcon="tag"
               ConfirmDisabled="@(_targetVersion is null || !_versionPreview.Any(p => p.WillChange))"
               RequireWord="update"
               WorkingContent="@RunProgress()">
    @if (_versionOptions.Count == 0)
    {
        <p class="upg-version__none">
            Business Central hasn't offered these environments a version to change to. Refresh them, then try again.
        </p>
    }
    else
    {
        <fieldset class="upg-when">
            <legend class="upg-when__legend">Version</legend>
            <div class="upg-version__opts">
                @foreach (var option in _versionOptions)
                {
                    <label class="upg-when__opt">
                        <input type="radio" name="upg-version" value="@option.Version"
                               checked="@(option.Version == _targetVersion)"
                               @onchange="() => PickVersion(option.Version)" />
                        <span class="upg-version__name">@option.Version</span>
                        <span class="upg-version__count">for @option.RowCount of the selected</span>
                    </label>
                }
            </div>
        </fieldset>

        @* The sum and the date note lead, under the picker: the groups below can run
           long enough to scroll, and the line that says how much of the fleet this
           touches must not be the part scrolled out of view. *@
        @if (_targetVersion is not null)
        {
            <p class="upg-preview__count">@VersionCountLine()</p>
            <p class="upg-version__date">
                <Icon Name="calendar" Width="13" Height="13" />
                <span>Business Central sets the date; use Move dates afterwards to push it out.</span>
            </p>
            @VersionPreviewList()
        }
    }
</ConfirmDialog>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "type")] public string? TypeFilter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "waiting")] public string? WaitingFilter { get; set; }

    /// <summary>
    /// The rows on screen: the fleet after the filters, or every ticked row while Show
    /// selected is on. Null while it is still loading.
    /// </summary>
    private List<UpgradeFleetRow>? _rows;
    private List<UpgradeFleetRow> _all = new();

    /// <summary>The rows on screen that this person can act on - what the header checkbox ticks.</summary>
    private List<UpgradeFleetRow> _actionableRows = new();
    private List<string> _typeOptions = new();
    private int _totalCount;

    private bool _denied;
    private string _search = string.Empty;
    private string _type = string.Empty;
    private bool _onlyWaiting;

    /// <summary>
    /// The ticked rows. The search and the view leave them ticked when they take them
    /// off screen (#985); only a re-read drops a tick, for a row that is gone or that
    /// this person can no longer act on.
    /// </summary>
    private readonly SelectionSet _selection = new();
    private readonly Dictionary<int, RowResult> _results = new();
    private List<PreviewItem> _preview = new();

    private bool _running;
    private bool _stopRequested;
    private string _progressText = string.Empty;
    private int _progressDone;
    private int _progressTotal;

    /// <summary>
    /// How long an immediate update waits after the confirm before anything is sent.
    /// Starting one cannot be taken back, so the dialog gives the person this long to
    /// notice the wrong customer. A booking has no wait: it can be cancelled for hours.
    /// </summary>
    private const int StartGraceSeconds = 10;

    /// <summary>
    /// The run, reported in the dialog that started it rather than in a strip above a
    /// table the scrim has just uncovered. Stop only appears when there is a next one
    /// to stop before.
    /// </summary>
    private RenderFragment RunProgress() => @<div class="upg-run" role="status">
        <p class="upg-run__text">@_progressText</p>
        <progress class="progress" value="@_progressDone" max="@Math.Max(1, _progressTotal)"></progress>
        @if (_progressTotal > 1)
        {
            <div class="upg-run__foot">
                <span class="u-muted">@_progressDone of @_progressTotal done. Each result appears on its row.</span>
                <button type="button" class="btn btn--sm" @onclick="() => _stopRequested = true" disabled="@_stopRequested">
                    <span>@(_stopRequested ? "Stopping after this one" : "Stop after this one")</span>
                </button>
            </div>
        }
    </div>;
    private Notice? _notice;

    private ConfirmDialog? _pushConfirm;
    private ConfirmDialog? _nowConfirm;
    private ConfirmDialog? _versionConfirm;

    // ── Changing the next version (#960) ────────────────────────────────

    /// <summary>What the picker offers for the rows the dialog was opened on, newest first.</summary>
    private List<OfferedVersionOption> _versionOptions = new();

    /// <summary>The version picked, or null until one is; the preview waits for it.</summary>
    private string? _targetVersion;

    /// <summary>Every selected row sorted into its group for <see cref="_targetVersion"/>.</summary>
    private List<SelectVersionPreviewRow> _versionPreview = new();

    // ── Booking an update for a slot instead of running it now ──────────
    //
    // The wall clock the person picks is read in each customer's own time zone, so
    // "20:00" across a selection means 20:00 for each of them - which is what the team
    // means when they say "tonight at eight". The instant that produces is what gets
    // stored.

    private bool _scheduleLater;
    private DateTime _slotLocal = DateTime.UtcNow;

    /// <summary>Everything booked and not yet run, across the whole visible fleet, keyed by environment.</summary>
    private List<UpgradeActionRow> _pending = new();

    /// <summary>The environment whose activity is open, and its entries (null while loading).</summary>
    private int? _feedEnvId;
    private List<UpgradeActionRow>? _feed;

    private bool ActionsDisabled => _selection.Count == 0 || _running;

    protected override async Task OnInitializedAsync()
    {
        await Zone.EnsureLoadedAsync();
        var snapshot = await Access.GetSnapshotAsync();
        // The grant is deliberately not in the sign-in claims, so the page asks the
        // same service the sidebar does rather than reading a role.
        if (!snapshot.CanUseEnvironmentOps)
        {
            _denied = true;
            return;
        }

        ReadQuery();
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (_denied) return;
        ReadQuery();
        // Only once the fleet is in hand: the first pass runs before it is loaded.
        if (_rows is not null) ApplyFilters();
    }

    public void Dispose()
    {
        StopPolling();
        _searchDebounce.Dispose();
        _disposed = true;
        StopWatching();
        // A read in flight is abandoned with the page rather than finishing into it.
        _watchCts.Cancel();
    }

    private void ReadQuery()
    {
        _search = (Query ?? string.Empty).Trim();
        _type = (TypeFilter ?? string.Empty).Trim();
        _onlyWaiting = WaitingFilter == "1";
    }

    /// <summary>
    /// The view select's value for one combination of the two filters behind it. The
    /// sheet offers them as one list ("Production, update waiting") because that is
    /// how the team thinks of them; the address keeps them apart so old links hold.
    /// </summary>
    private static string ViewValue(string type, bool waiting) => (waiting ? "1" : "0") + type;

    private async Task OnViewChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await RememberViewAsync(value);
        GoToFilters(type: value.Length > 1 ? value[1..] : string.Empty, waiting: value.StartsWith('1'));
    }

    // ── The view, remembered ────────────────────────────────────────────

    /// <summary>
    /// Where the last view picked is kept for as long as this browser session lasts:
    /// coming back to the page, or reloading it, keeps the slice somebody was working in
    /// (production, usually), and a new session starts on everything again. Session
    /// storage on purpose (maintainer's decision, 2026-09-21) - not the account, and not
    /// for good. The search box is not part of it: a search is a question, not a habit.
    /// </summary>
    private const string ViewStorageKey = "aldt-upgrades-view";

    private bool _viewRestored;

    /// <summary>
    /// A bare /upgrades opens on the remembered view. An address that already names a
    /// filter is left alone: a link somebody sent shows what they meant it to show.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_viewRestored || _denied) return;
        _viewRestored = true;
        if (Query is not null || TypeFilter is not null || WaitingFilter is not null) return;

        string? saved;
        try
        {
            saved = await JS.InvokeAsync<string?>("sessionStorage.getItem", ViewStorageKey);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException or TaskCanceledException)
        {
            return; // no storage, or no browser yet: the page simply opens on everything
        }

        if (string.IsNullOrEmpty(saved) || saved == ViewValue(string.Empty, false)) return;
        GoToFilters(type: saved.Length > 1 ? saved[1..] : string.Empty, waiting: saved.StartsWith('1'));
    }

    private async Task RememberViewAsync(string view)
    {
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", ViewStorageKey, view);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException or TaskCanceledException)
        {
            // Private window, blocked storage: the view still applies, it just isn't kept.
        }
    }

    /// <summary>How long the search box waits for typing to stop before it filters. Tests set it to zero.</summary>
    internal static TimeSpan SearchDebounce { get; set; } = TimeSpan.FromMilliseconds(200);

    private readonly Debouncer _searchDebounce = new(SearchDebounce);

    // The box is bound to _search as it is typed, untrimmed - trimming it here would
    // eat the space between two words. The table follows once typing pauses.
    private void OnSearchInput() =>
        _searchDebounce.Trigger(() => InvokeAsync(() =>
        {
            ApplyFilters();
            StateHasChanged();
        }));

    private void OnSearchCommitted(ChangeEventArgs e)
    {
        _searchDebounce.Cancel();
        ApplyFilters();
        GoToFilters(_type, _onlyWaiting);
    }

    /// <summary>
    /// Applies a filter change by changing the address, so every state of this table
    /// has a link - including the one someone wants to send to a colleague.
    /// </summary>
    private void GoToFilters(string type, bool waiting)
    {
        var parts = new List<string>();
        var search = _search.Trim();
        if (search.Length > 0) parts.Add("q=" + Uri.EscapeDataString(search));
        if (type.Length > 0) parts.Add("type=" + Uri.EscapeDataString(type));
        if (waiting) parts.Add("waiting=1");
        Nav.NavigateTo(parts.Count == 0 ? "/upgrades" : "/upgrades?" + string.Join("&", parts));
    }

    private async Task LoadAsync()
    {
        _all = await Fleet.ListFleetAsync();
        _pending = await Actions.ListPendingAsync();
        // Against the whole fleet, not the rows on screen: a tick the search has
        // hidden is still wanted. A row that has gone, or that is no longer this
        // person's to change, is not.
        _selection.Prune(_all.Where(r => r.CanAct).Select(r => r.EnvironmentId));
        _totalCount = _all.Count;
        _typeOptions = _all
            .Select(r => r.EnvironmentType)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
            .ToList();
        ApplyFilters();
        JoinUpdatesUnderWay();
    }

    private void ApplyFilters()
    {
        IEnumerable<UpgradeFleetRow> q = _all;
        var term = _search.Trim();
        if (term.Length > 0)
        {
            q = q.Where(r =>
                r.ProjectName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (r.ProjectShortName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || r.EnvironmentName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        if (_type.Length > 0)
        {
            q = q.Where(r => string.Equals(r.EnvironmentType, _type, StringComparison.OrdinalIgnoreCase));
        }
        if (_onlyWaiting)
        {
            q = q.Where(r => r.HasUpdate);
        }

        // Filtering never unticks anything (#985): the count in the bar says how many
        // of the ticks are off screen, and the commands act on all of them.
        _rows = _selection.Shown(q, _all, r => r.EnvironmentId, FilterKey()).ToList();
        _actionableRows = _rows.Where(r => r.CanAct).ToList();
    }

    /// <summary>
    /// The search and the view as they stand. Show selected holds only while this
    /// does: changing either is asking to see something else.
    /// </summary>
    private (string Search, string Type, bool Waiting) FilterKey() => (_search, _type, _onlyWaiting);

    private List<int> ShownActionableIds() => _actionableRows.Select(r => r.EnvironmentId).ToList();

    private bool AllPicked => _selection.AllShownPicked(ShownActionableIds());

    /// <summary>The keyline state, plus the tint of a ticked row and the mark of a locked one.</summary>
    private static string RowClass(UpgradeFleetRow row, bool picked) =>
        RowState(row) + (picked ? " is-selected" : "") + (row.CanAct ? "" : " upg-row--locked");

    /// <summary>Some of the rows on screen but not all: the header box shows a dash rather than a tick.</summary>
    private bool SomePicked => _selection.SomeShownPicked(ShownActionableIds());

    /// <summary>
    /// The header box ticks or unticks the rows on screen, and only those: a tick the
    /// search has hidden is left as it was.
    /// </summary>
    private void ToggleAll(ChangeEventArgs e)
    {
        _selection.ToggleShown(ShownActionableIds(), e.Value is true);
        ApplyFilters();
    }

    private void TogglePick(int environmentId, ChangeEventArgs e)
    {
        _selection.Set(environmentId, e.Value is true);
        // Under Show selected, a row unticked leaves the table; the last one ends the view.
        if (_selection.ShowSelectedOnly || _selection.Count == 0) ApplyFilters();
    }

    private void ToggleShowSelected()
    {
        _selection.ShowSelected(!_selection.ShowSelectedOnly, FilterKey());
        ApplyFilters();
    }

    private void ClearSelection()
    {
        _selection.Clear();
        ApplyFilters();
    }

    /// <summary>
    /// The one row a row-menu command is acting on, while its dialog and run are open.
    /// Kept apart from the ticked rows so that starting one customer's update from its
    /// own menu neither uses nor disturbs a selection made for something else.
    /// </summary>
    private UpgradeFleetRow? _single;

    /// <summary>
    /// What the open dialog or the running batch acts on: every ticked row, whether the
    /// search and the view have it on screen or not. Each dialog lists them all by name
    /// before anything is sent, so a hidden tick is seen before it is acted on.
    /// </summary>
    private List<UpgradeFleetRow> SelectedRows() => _single is { } one
        ? new List<UpgradeFleetRow> { one }
        : _all.Where(r => r.CanAct && _selection.Contains(r.EnvironmentId)).ToList();

    // ── The three bulk actions ──────────────────────────────────────────

    private async Task ConfirmPushAsync(UpgradeFleetRow? only = null)
    {
        _single = only;
        try
        {
            await ConfirmPushCoreAsync();
        }
        finally
        {
            _single = null;
        }
    }

    private async Task ConfirmUpdateNowAsync(UpgradeFleetRow? only = null)
    {
        _single = only;
        try
        {
            await ConfirmUpdateNowCoreAsync();
        }
        finally
        {
            _single = null;
        }
    }

    private async Task ConfirmSelectVersionAsync(UpgradeFleetRow? only = null)
    {
        _single = only;
        try
        {
            await ConfirmSelectVersionCoreAsync();
        }
        finally
        {
            _single = null;
        }
    }

    private async Task ConfirmPushCoreAsync()
    {
        var rows = SelectedRows();
        if (rows.Count == 0 || _pushConfirm is null) return;

        _preview = rows.Select(r => r.CanPushDate
            ? new PreviewItem(r.ProjectName, r.EnvironmentName, r.IsProduction,
                $"{WhenText(r.NextUpdateDate)} → {DateText(r.EffectiveLatestDate)}", PreviewGroup.Acting)
            : new PreviewItem(r.ProjectName, r.EnvironmentName, r.IsProduction,
                WhyNoPush(r), PreviewGroup.Skipped)).ToList();

        if (await _pushConfirm.OpenAsync())
        {
            await RunBatchAsync(UpgradeActionKind.PushDateToLatest);
        }
    }

    private async Task ConfirmUpdateNowCoreAsync()
    {
        var rows = SelectedRows();
        if (rows.Count == 0 || _nowConfirm is null) return;

        // Every open of the dialog starts at "immediately": a slot is a deliberate
        // choice, never something left over from the last batch.
        _scheduleLater = false;
        _slotLocal = DefaultSlot(rows);

        // A row that already has a booking waiting is not refused - somebody may well
        // want a second one - but pressing the button without being told is how a
        // customer ends up updated twice.
        _preview = rows.Select(r =>
        {
            if (!r.HasUpdate)
            {
                return new PreviewItem(r.ProjectName, r.EnvironmentName, r.IsProduction,
                    "no update is waiting", PreviewGroup.Skipped);
            }
            if (PendingFor(r.EnvironmentId) is { Count: > 0 } booked)
            {
                return new PreviewItem(r.ProjectName, r.EnvironmentName, r.IsProduction,
                    $"already booked for {SlotText(r, booked[0].ExecuteAfter)} - this adds another",
                    PreviewGroup.AlreadyBooked);
            }
            return new PreviewItem(r.ProjectName, r.EnvironmentName, r.IsProduction,
                $"starts updating to {ShortVersion(r.NextUpdateVersion)}", PreviewGroup.Acting);
        }).ToList();

        if (await _nowConfirm.OpenAsync())
        {
            await RunBatchAsync(UpgradeActionKind.RunNow);
        }
    }

    private async Task ConfirmSelectVersionCoreAsync()
    {
        var rows = SelectedRows();
        if (rows.Count == 0 || _versionConfirm is null) return;

        // Every open starts with nothing picked: a version is a deliberate choice, and
        // the one picked last week is exactly the wrong thing to have ready this week.
        // A selection offered only one version has nothing to choose between.
        _versionOptions = UpgradeFleetService.OfferedVersions(rows);
        _targetVersion = null;
        _versionPreview = new();
        if (_versionOptions.Count == 1) PickVersion(_versionOptions[0].Version);

        if (await _versionConfirm.OpenAsync())
        {
            await RunBatchAsync(UpgradeActionKind.SelectVersion);
        }
    }

    private void PickVersion(string version)
    {
        _targetVersion = version;
        _versionPreview = UpgradeFleetService.PreviewSelectVersion(SelectedRows(), version, _pending);
    }

    private string VersionConfirmLabel => _targetVersion is { } version
        ? $"Change to {version}"
        : "Change the version";

    /// <summary>
    /// Runs the selection one environment at a time, in this page's own circuit.
    /// Each row reports for itself and a refusal never costs the rest of the batch -
    /// the whole point of the sweep is that ninety-nine customers still get done when
    /// one of them has nothing to move. Stop applies before the next environment;
    /// nothing is ever abandoned half-written on a customer's tenant.
    ///
    /// <para>Booking for a slot goes through the same loop, and is fast (nothing leaves
    /// the building), but it is the same shape so one selection of ninety customers
    /// reports the same way whichever the person chose. Each row's slot is worked out
    /// from that customer's own time zone.</para>
    /// </summary>
    private async Task RunBatchAsync(UpgradeActionKind kind)
    {
        var rows = SelectedRows();
        if (rows.Count == 0) return;

        var push = kind == UpgradeActionKind.PushDateToLatest;
        var version = kind == UpgradeActionKind.SelectVersion ? _targetVersion : null;
        if (kind == UpgradeActionKind.SelectVersion && version is null) return;

        StopPolling();
        _running = true;
        _stopRequested = false;
        _notice = null;
        _results.Clear();
        foreach (var row in rows) _results[row.EnvironmentId] = new RowResult("Waiting", "muted");
        _progressDone = 0;
        _progressTotal = rows.Count;

        var done = 0;
        var skipped = 0;
        var failed = 0;
        var needSetup = 0;
        // Updates this run started, and when, to watch through to the end once it is over.
        var started = new Dictionary<int, DateTime>();
        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            if (_stopRequested)
            {
                _results[row.EnvironmentId] = new RowResult("Stopped before this one", "muted");
                continue;
            }

            // A version change leaves alone what its preview said it would: a row already
            // on the version, one not offered it, one with something booked. Asking
            // Business Central would at best do nothing, and a row with a booked update
            // would have the version changed under the booking.
            if (version is not null
                && _versionPreview.FirstOrDefault(p => p.Row.EnvironmentId == row.EnvironmentId) is { WillChange: false } passed)
            {
                _results[row.EnvironmentId] = new RowResult("Skipped — " + passed.Detail, "muted");
                skipped++;
                _progressDone = i + 1;
                continue;
            }

            var booking = kind == UpgradeActionKind.RunNow && _scheduleLater;
            _progressDone = i;
            _progressText = (push ? "Moving the date on " : version is not null ? "Changing the version on "
                    : booking ? "Booking " : "Starting the update on ")
                + $"{row.ProjectName} {row.EnvironmentName}...";
            _results[row.EnvironmentId] = new RowResult(
                push ? "Moving the date..." : version is not null ? "Changing the version..."
                    : booking ? "Booking..." : "Starting the update...", "busy");
            StateHasChanged();

            try
            {
                // Push-to-latest and the version change are always immediate: the first
                // is housekeeping ahead of a release, and the second leaves the date to
                // Business Central. Only starting an update is agreed for a time.
                var slot = booking ? SlotFor(row) : (DateTimeOffset?)null;
                var action = await Actions.ScheduleUpgradeActionAsync(
                    row.ProjectId, row.EnvironmentId, kind, slot, targetVersion: version);
                _results[row.EnvironmentId] = action.IsPending
                    ? new RowResult($"Booked for {SlotText(row, action.ExecuteAfter)}", "ok", ActionId: action.Id)
                    : new RowResult(push ? "Date moved" : version is not null ? $"Now set to {version}" : "Update started", "ok");
                if (kind == UpgradeActionKind.RunNow && action.Status == UpgradeActionStatus.Sent)
                {
                    started[row.EnvironmentId] = action.SentAt ?? DateTime.UtcNow;
                }
                done++;
            }
            catch (PlanValidationException ex)
            {
                // Our own plain-words refusals, shown as they are. The field key tells
                // the two kinds apart without reading the sentence: "Environment" means
                // the customer's connection needs setting up somewhere else, so the row
                // says where; "Update" means this update simply can't move, which the
                // message already explains in full.
                var isSetup = ex.Errors.ContainsKey("Environment");
                if (isSetup) needSetup++;
                _results[row.EnvironmentId] = new RowResult(
                    "Skipped — " + FirstMessage(ex),
                    isSetup ? "warn" : "muted",
                    isSetup ? row.ProjectId : null,
                    isSetup ? $"Set it up on {row.ProjectName} →" : null);
                skipped++;
            }
            catch (ProjectAccessDeniedException ex)
            {
                _results[row.EnvironmentId] = new RowResult("Skipped — " + ex.Message, "muted");
                skipped++;
            }
            catch (Exception ex)
            {
                // Never the raw exception text: a 401 body or a null-reference message
                // is not something to hand a consultant. The detail goes to the log,
                // and the row points at the solution, where the connection lives.
                Log.LogError(ex,
                    "The upgrades page failed on environment {EnvironmentId} of solution {ProjectId}.",
                    row.EnvironmentId, row.ProjectId);
                _results[row.EnvironmentId] = new RowResult(
                    "Didn't work — Business Central didn't accept the change. Try again, or check the connection.",
                    "bad", row.ProjectId, $"Open {row.ProjectName} →");
                failed++;
            }

            _progressDone = i + 1;
            StateHasChanged();
        }

        _running = false;
        _progressText = string.Empty;
        // The dialog stayed open to show the run; the rows and the summary take over.
        _nowConfirm?.Close();
        _pushConfirm?.Close();
        _versionConfirm?.Close();
        _notice = Summary(done, skipped, failed, needSetup, kind, version,
            kind == UpgradeActionKind.RunNow && _scheduleLater ? BookedForText() : null);

        // Re-read the fleet so the table shows what Business Central now says rather
        // than what we asked it for. The ticks stay, less any row that has gone.
        await LoadAsync();
        WatchStartedUpdates(started);
    }

    /// <summary>
    /// The one line above the table after a run. "Moved the date on 0 environments"
    /// is a sentence nobody wants to read, so a run that changed nothing leads with
    /// that instead of with a zero. A run with anything skipped or failed is not a
    /// neutral outcome, so it does not get the neutral tone - and when the reason was
    /// a missing connection, the line says what to do next.
    /// </summary>
    /// <param name="bookedFor">
    /// When the run booked things for, already worded ("for 20:00 on 30 Aug, each in their
    /// own time"), or null when it acted immediately. A summary that says only how many
    /// were booked leaves the one fact somebody would double-check off the screen.
    /// </param>
    /// <param name="version">The version a version change set; null for the other two moves.</param>
    private static Notice Summary(
        int done, int skipped, int failed, int needSetup, UpgradeActionKind kind, string? version, string? bookedFor)
    {
        var push = kind == UpgradeActionKind.PushDateToLatest;
        var booking = bookedFor is not null;
        var parts = new List<string>();
        if (done == 0)
        {
            parts.Add(push ? "No dates were moved" : version is not null ? "No versions were changed"
                : booking ? "Nothing was booked" : "No updates were started");
        }
        else
        {
            var verb = push ? "Moved the date on" : version is not null ? $"Set the next version to {version} on"
                : booking ? "Booked the update on" : "Started the update on";
            var where = $"{done} environment{(done == 1 ? "" : "s")}";
            parts.Add(booking ? $"{verb} {where} {bookedFor}" : $"{verb} {where}");
        }
        if (skipped > 0) parts.Add($"{skipped} skipped");
        if (failed > 0) parts.Add($"{failed} didn't work");

        var text = string.Join(", ", parts) + ".";
        if (needSetup > 0)
        {
            // Deliberately wider than "has no connection": the same refusal covers a
            // customer nobody has set up yet and one whose credentials were rejected,
            // and the summary must not claim which. The row says which; this says where
            // to go.
            text += $" {needSetup} of them need{(needSetup == 1 ? "s" : "")} the solution's "
                + "Business Central connection checked - open the solution, then try again.";
        }

        return new Notice(text, skipped > 0 || failed > 0 ? "warn" : "info", false);
    }

    // ── Refresh ─────────────────────────────────────────────────────────

    private async Task RefreshDataAsync()
    {
        // With a selection, refresh those customers; with none, everything you can act
        // on - which is what someone starting their morning wants.
        var projectIds = _selection.Count > 0
            ? SelectedRows().Select(r => r.ProjectId).Distinct().ToList()
            : _actionableRows.Select(r => r.ProjectId).Distinct().ToList();

        if (projectIds.Count == 0)
        {
            _notice = new Notice("There is nothing here you can refresh.", "info", false);
            return;
        }

        var result = await Fleet.RequestRefreshAsync(projectIds, force: true);
        var asked = result.Queued + result.AlreadyRunning;
        _notice = new Notice(
            $"Asking Business Central about {asked} solution{(asked == 1 ? "" : "s")}. "
            + "New answers will appear here.",
            "info", true);
        StartPolling();
    }

    /// <summary>Re-reads the fleet now, for someone who doesn't want to wait for the next poll.</summary>
    private async Task ReloadNowAsync() => await LoadAsync();

    // ── Polling while a refresh is outstanding ──────────────────────────
    //
    // The answers arrive in the background worker's own time, so the page collects
    // them itself rather than telling the reader to reload. Every tick goes through
    // InvokeAsync, which puts the query on the renderer's sync context - the same
    // thing that keeps it from colliding with a click handler on this circuit's one
    // AppDbContext. It gives up after a few minutes: a refresh that hasn't answered
    // by then isn't going to, and a page left open overnight must not poll forever.

    private System.Threading.Timer? _poll;
    private DateTime _pollUntilUtc;

    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(20);
    private static readonly TimeSpan PollFor = TimeSpan.FromMinutes(3);

    private void StartPolling()
    {
        StopPolling();
        // "Refresh restarts it": a watch that gave up may join again on the reload.
        ForgetStoppedWatches();
        _pollUntilUtc = DateTime.UtcNow.Add(PollFor);
        _poll = new System.Threading.Timer(_ => _ = PollTickAsync(), null, PollEvery, PollEvery);
    }

    private void StopPolling()
    {
        _poll?.Dispose();
        _poll = null;
    }

    private async Task PollTickAsync()
    {
        if (DateTime.UtcNow > _pollUntilUtc)
        {
            StopPolling();
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                // Never while a batch is mid-flight: that run owns the table.
                if (_running || _denied) return;
                await ReloadNowAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            StopPolling();
        }
        catch (Exception ex)
        {
            // A failed poll is not worth breaking the page over; stop asking.
            Log.LogWarning(ex, "The upgrades page stopped polling for refreshed environments.");
            StopPolling();
        }
    }

    // ── Watching an update through to its end (#982) ────────────────────
    //
    // After "Start update" the person often stays on the page to see it finish before
    // calling the customer back. So an update that is under way is re-read from Business
    // Central - that one environment, two requests - every ten seconds until it ends.
    // It is a timer of its own, not the refresh poll above: that one reads our database
    // for a few minutes after a Refresh, this one asks the customer's tenant about one
    // environment for as long as its update runs, up to a cap. Ticks go through
    // InvokeAsync for the same reason the poll's do, and skip while a run or a dialog
    // is open. See .design/environment-updates.md, "The page".

    /// <summary>One update being watched.</summary>
    private sealed class WatchedUpdate
    {
        public required int ProjectId { get; init; }

        /// <summary>When the update started, as near as the page knows, for "started 6 minutes ago".</summary>
        public required DateTime StartedUtc { get; init; }

        /// <summary>When the watch gives up if the update still hasn't ended.</summary>
        public required DateTime UntilUtc { get; init; }

        /// <summary>The version the update goes to, to tell a finished update from one that came back unchanged.</summary>
        public string? TargetVersion { get; init; }

        /// <summary>
        /// True once Business Central has been seen working on it. Until then a running
        /// environment on the old version is an update not picked up yet, not a failed one.
        /// </summary>
        public bool SeenBusy { get; set; }

        /// <summary>Reads in a row that got no answer; a few in a row stops the watch.</summary>
        public int Misses { get; set; }

        /// <summary>When it was last read, so a tick with more than it may read takes the longest-waiting first.</summary>
        public DateTime LastReadUtc { get; set; }
    }

    /// <summary>
    /// How a watch ended, shown under the row until the row is watched again or the page
    /// is left. <paramref name="Stopped"/>
    /// marks a watch that gave up rather than one that saw the update end; only Refresh
    /// starts that one again.
    /// </summary>
    private sealed record WatchEnd(string Text, string Tone, bool ShowOperations = false, bool Stopped = false)
    {
        public string CssClass => $"upg-note upg-note--{Tone}";
    }

    /// <summary>How an update looks from one re-read.</summary>
    internal enum WatchVerdict { StillUpdating, Updated, Failed }

    internal static readonly TimeSpan WatchEvery = TimeSpan.FromSeconds(10);
    internal static readonly TimeSpan WatchEveryWhenMany = TimeSpan.FromSeconds(30);
    internal static readonly TimeSpan WatchFor = TimeSpan.FromMinutes(45);

    /// <summary>
    /// The most environments one tick reads. Above it the tick also slows to
    /// <see cref="WatchEveryWhenMany"/>, so fifty updates started at once cost at most
    /// twenty requests every thirty seconds rather than a hundred every ten.
    /// </summary>
    internal const int WatchPerTick = 10;

    /// <summary>Reads in a row without an answer before the watch stops.</summary>
    private const int WatchMaxMisses = 3;

    private readonly Dictionary<int, WatchedUpdate> _watched = new();
    private readonly Dictionary<int, WatchEnd> _watchEnded = new();
    private readonly CancellationTokenSource _watchCts = new();
    private System.Threading.Timer? _watchTimer;
    private TimeSpan _watchPeriod;
    private bool _watchBusy;
    private bool _disposed;

    /// <summary>The environments being watched. For tests, which drive the tick by hand.</summary>
    internal IReadOnlyCollection<int> WatchedEnvironmentIds => _watched.Keys;

    private bool DialogOpen =>
        _pushConfirm?.IsOpen == true || _nowConfirm?.IsOpen == true || _versionConfirm?.IsOpen == true;

    /// <summary>
    /// True when Business Central is busy with the environment: its state says so, or its
    /// next update says it is running. Either is enough, because the two are read from
    /// different places and do not always change together.
    /// </summary>
    internal static bool IsUpdating(UpgradeFleetRow row) =>
        BcEnvironmentStatus.Classify(row.Status) == BcEnvironmentReadiness.Busy
        || ProjectConnectionService.IsUpdateUnderWay(row.NextUpdateStatus);

    /// <summary>
    /// Whether an update has ended, and how, from one fresh read of its row. It has ended
    /// when the environment is running again and the update is no longer under way; it
    /// went through when the environment is now on the version it was going to (or on a
    /// later one), and otherwise it failed. An environment that is running on the old
    /// version before Business Central was ever seen busy has simply not picked the update
    /// up yet.
    /// </summary>
    internal static WatchVerdict Judge(UpgradeFleetRow row, string? targetVersion, bool seenBusy)
    {
        if (BcEnvironmentStatus.Classify(row.Status) == BcEnvironmentReadiness.Failed) return WatchVerdict.Failed;
        if (IsUpdating(row) || !BcEnvironmentStatus.IsRunning(row.Status)) return WatchVerdict.StillUpdating;

        var reached = !string.IsNullOrWhiteSpace(targetVersion) && !string.IsNullOrWhiteSpace(row.Version)
            && ProjectConnectionService.CompareVersions(row.Version, targetVersion) >= 0;
        if (reached) return WatchVerdict.Updated;
        if (!seenBusy) return WatchVerdict.StillUpdating;
        return string.IsNullOrWhiteSpace(targetVersion) ? WatchVerdict.Updated : WatchVerdict.Failed;
    }

    /// <summary>
    /// Starts watching the updates a run has just started, from the rows the run's reload
    /// brought back. The watch line takes over from "Update started" on the row.
    /// </summary>
    private void WatchStartedUpdates(Dictionary<int, DateTime> started)
    {
        foreach (var (environmentId, sentAt) in started)
        {
            if (_all.FirstOrDefault(r => r.EnvironmentId == environmentId) is not { } row) continue;
            BeginWatch(row, sentAt, seenBusy: IsUpdating(row));
            _results.Remove(environmentId);
        }
    }

    /// <summary>
    /// Joins every row whose update is already under way - one a booking fired at 20:00,
    /// or one somebody else started - so opening the page finds it watched. Only rows the
    /// person may act on: the re-read asks for the same grant the update did.
    /// </summary>
    private void JoinUpdatesUnderWay()
    {
        var now = DateTime.UtcNow;
        foreach (var row in _all)
        {
            if (!row.CanAct || row.IsSoftDeleted || _watched.ContainsKey(row.EnvironmentId) || !IsUpdating(row)) continue;
            if (_watchEnded.TryGetValue(row.EnvironmentId, out var ended) && ended.Stopped) continue;

            // Business Central does not say when it started; the date it was set to run is
            // the nearest thing, once that date has come.
            var started = row.NextUpdateDate is { } at && at <= now ? at : now;
            BeginWatch(row, started, seenBusy: true);
        }
    }

    private void BeginWatch(UpgradeFleetRow row, DateTime startedUtc, bool seenBusy)
    {
        _watchEnded.Remove(row.EnvironmentId);
        _watched[row.EnvironmentId] = new WatchedUpdate
        {
            ProjectId = row.ProjectId,
            StartedUtc = startedUtc,
            UntilUtc = DateTime.UtcNow.Add(WatchFor),
            TargetVersion = row.NextUpdateVersion,
            SeenBusy = seenBusy,
            LastReadUtc = DateTime.MinValue,
        };
        ScheduleWatchTimer();
    }

    private void ForgetStoppedWatches()
    {
        foreach (var id in _watchEnded.Where(e => e.Value.Stopped).Select(e => e.Key).ToList())
        {
            _watchEnded.Remove(id);
        }
    }

    /// <summary>Starts, re-paces or stops the timer to suit how many are being watched.</summary>
    private void ScheduleWatchTimer()
    {
        if (_watched.Count == 0 || _disposed)
        {
            StopWatching();
            return;
        }

        var period = _watched.Count > WatchPerTick ? WatchEveryWhenMany : WatchEvery;
        if (_watchTimer is null)
        {
            _watchTimer = new System.Threading.Timer(_ => _ = OnWatchTimerAsync(), null, period, period);
        }
        else if (period != _watchPeriod)
        {
            _watchTimer.Change(period, period);
        }
        _watchPeriod = period;
    }

    private void StopWatching()
    {
        _watchTimer?.Dispose();
        _watchTimer = null;
    }

    private async Task OnWatchTimerAsync()
    {
        try
        {
            await InvokeAsync(WatchTickAsync);
        }
        catch (ObjectDisposedException)
        {
            StopWatching();
        }
        catch (OperationCanceledException) when (_watchCts.IsCancellationRequested)
        {
            // The page went while a read was in flight.
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "The upgrades page stopped watching updates under way.");
            StopWatching();
        }
    }

    /// <summary>
    /// One tick: re-reads up to <see cref="WatchPerTick"/> watched environments, the
    /// longest-waiting first, lays each answer over its row and ends the watches whose
    /// update has ended. Internal so tests can drive it without waiting on the timer.
    /// </summary>
    internal async Task WatchTickAsync()
    {
        // Never while a run owns the table, and never under an open dialog: the rows a
        // person is reading there must not move under them.
        if (_watchBusy || _running || _denied || _disposed || DialogOpen || _watched.Count == 0) return;
        _watchBusy = true;
        try
        {
            var now = DateTime.UtcNow;
            foreach (var id in _watched.Where(w => now > w.Value.UntilUtc).Select(w => w.Key).ToList())
            {
                EndWatch(id, new WatchEnd(
                    $"Stopped watching after {(int)WatchFor.TotalMinutes} minutes. Refresh to start again.", "muted", Stopped: true));
            }

            var due = _watched.OrderBy(w => w.Value.LastReadUtc).Take(WatchPerTick).ToList();
            var changed = false;
            foreach (var (environmentId, watch) in due)
            {
                if (_running || _disposed) break;
                watch.LastReadUtc = DateTime.UtcNow;
                changed |= await ReadWatchedAsync(environmentId, watch);
            }

            // One pass over the filters for the whole tick rather than one per row.
            if (changed) ApplyFilters();
        }
        finally
        {
            _watchBusy = false;
        }

        ScheduleWatchTimer();
        StateHasChanged();
    }

    /// <summary>Reads one watched environment. True when its row changed.</summary>
    private async Task<bool> ReadWatchedAsync(int environmentId, WatchedUpdate watch)
    {
        BcEnvironmentReading reading;
        try
        {
            reading = await Connection.RefreshEnvironmentAsync(watch.ProjectId, environmentId, _watchCts.Token);
        }
        catch (OperationCanceledException) when (_watchCts.IsCancellationRequested)
        {
            throw;
        }
        catch (PlanValidationException ex) when (ex.Errors.ContainsKey("Environment"))
        {
            // Gone, or the connection needs setting up: asking again will not help.
            EndWatch(environmentId, new WatchEnd("Stopped watching - " + FirstMessage(ex), "warn", Stopped: true));
            return false;
        }
        catch (ProjectAccessDeniedException)
        {
            EndWatch(environmentId, new WatchEnd(
                "Stopped watching - you can no longer change this solution's updates.", "muted", Stopped: true));
            return false;
        }
        catch (Exception ex)
        {
            if (ex is not PlanValidationException)
            {
                Log.LogWarning(ex, "The upgrades page couldn't re-read environment {EnvironmentId} while watching its update.", environmentId);
            }
            if (++watch.Misses >= WatchMaxMisses)
            {
                EndWatch(environmentId, new WatchEnd(
                    "Stopped watching - Business Central isn't answering. Refresh to start again.", "warn", Stopped: true));
            }
            return false;
        }

        watch.Misses = 0;
        var index = _all.FindIndex(r => r.EnvironmentId == environmentId);
        if (index < 0)
        {
            _watched.Remove(environmentId);
            return false;
        }

        var row = reading.ApplyTo(_all[index]);
        _all[index] = row;
        if (IsUpdating(row)) watch.SeenBusy = true;

        switch (Judge(row, watch.TargetVersion, watch.SeenBusy))
        {
            case WatchVerdict.Updated:
                EndWatch(environmentId, new WatchEnd($"Updated to {ShortVersion(row.Version)}", "ok"));
                Log.LogInformation("Watched update on environment {EnvironmentId} finished on {Version}.", environmentId, row.Version);
                break;
            case WatchVerdict.Failed:
                EndWatch(environmentId, new WatchEnd("Update failed", "bad", ShowOperations: true));
                Log.LogInformation("Watched update on environment {EnvironmentId} ended without reaching {Version}.", environmentId, watch.TargetVersion);
                break;
        }
        return true;
    }

    private void EndWatch(int environmentId, WatchEnd end)
    {
        _watched.Remove(environmentId);
        _watchEnded[environmentId] = end;
    }

    // ── Slots, the activity feed, and cancelling ────────────────────────

    private void SetScheduleLater(bool later) => _scheduleLater = later;

    /// <summary>
    /// Where the slot picker starts: this evening at 20:00 in the customer's own time,
    /// which is the slot the upgrade team agrees more often than any other. Tomorrow
    /// evening once today's has gone.
    /// </summary>
    private static DateTime DefaultSlot(List<UpgradeFleetRow> rows)
    {
        var tz = UpdateWindow.ResolveTimeZone(rows.Count > 0 ? rows[0].TimeZone : null);
        var localNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz);
        var evening = localNow.Date.AddHours(20);
        if (evening <= localNow) evening = evening.AddDays(1);
        return evening;
    }

    /// <summary>
    /// The instant one customer's booking fires: the wall clock the person typed, read
    /// in <em>that customer's</em> zone. A selection spanning Copenhagen and Auckland
    /// books each of them for their own 20:00, which is what "tonight at eight" means to
    /// the person agreeing it with the customer.
    /// </summary>
    private DateTimeOffset SlotFor(UpgradeFleetRow row)
    {
        var tz = UpdateWindow.ResolveTimeZone(row.TimeZone);
        var wall = DateTime.SpecifyKind(_slotLocal, DateTimeKind.Unspecified);
        // A time that doesn't exist locally (the spring-forward hour) is nudged forward
        // rather than refused - the person meant "that evening", not that instant.
        for (var i = 0; i < 4 && tz.IsInvalidTime(wall); i++) wall = wall.AddHours(1);
        return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(wall, tz), TimeSpan.Zero);
    }

    /// <summary>
    /// A customer's time zone the way a consultant names it - the city, not the raw
    /// region/city id. Matches how the project page says the same thing.
    /// </summary>
    private static string ZoneLabel(string? ianaId) =>
        string.IsNullOrWhiteSpace(ianaId) ? "UTC" : BcUpdateWindow.CityLabel(ianaId);

    // -- What the dialog says, which depends on the choice in it ---------

    /// <summary>
    /// The sentence under the title. Starting now is irreversible and says so; a booking
    /// leads with the guarantee that makes it safe, and only then with what happens once
    /// it does run.
    /// </summary>
    /// <summary>
    /// Singular when the dialog came from one row's menu: rows ticked for something else
    /// are still tinted behind it, and the title is what says they are not part of this.
    /// </summary>
    private string NowDialogTitle => (_scheduleLater, _single is null) switch
    {
        (true, true) => "Book these updates?",
        (true, false) => "Book this update?",
        (false, true) => "Start these updates?",
        (false, false) => "Start this update?",
    };

    private string NowDialogMessage => _scheduleLater
        ? "Business Central will start these updates at the time you pick. You can cancel from the Upgrades page any time before it runs; once it starts it can't be stopped."
        : "Business Central will start updating these environments as soon as it picks them up, whatever time of day their update window says. Once it starts you cannot stop it.";

    /// <summary>
    /// The confirm button. A booking's label carries the time, so the last thing read
    /// before the click is the commitment being made.
    /// </summary>
    private string NowConfirmLabel => _scheduleLater
        ? $"Book for {_slotLocal:HH:mm} on {_slotLocal:d MMM}"
        : "Start the updates";

    /// <summary>
    /// The booking said back in this page's own words, under the picker. The browser draws
    /// a datetime field in its own locale - a 12-hour clock on a US-English machine, while
    /// every other time here is 24-hour - so this line, not the field, is what settles what
    /// was picked.
    /// </summary>
    private string SlotEchoText()
    {
        var when = $"Runs at {_slotLocal:HH:mm} on {_slotLocal:d MMM}";
        var zones = SelectedZones();
        return zones.Count <= 1
            ? $"{when}, {(zones.FirstOrDefault() ?? "UTC")} time."
            : $"{when}, in each customer's own time - {ZoneList(zones)} here.";
    }

    /// <summary>
    /// The "for 20:00 on 30 Aug..." tail the run's summary carries. Same clock and same
    /// zone rule as the picker's echo, so the sentence before the click and the one after
    /// it cannot disagree.
    /// </summary>
    private string BookedForText()
    {
        var when = $"for {_slotLocal:HH:mm} on {_slotLocal:d MMM}";
        var zones = SelectedZones();
        return zones.Count <= 1
            ? $"{when}, {(zones.FirstOrDefault() ?? "UTC")} time"
            : $"{when}, each in their own time";
    }

    private List<string> SelectedZones() => SelectedRows()
        .Select(r => ZoneLabel(r.TimeZone))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(z => z, StringComparer.OrdinalIgnoreCase)
        .ToList();

    /// <summary>
    /// The zones in a selection, named. Somebody checking whether "20:00" means what they
    /// agreed needs to see which countries are in the batch, not just how many; past three
    /// the list stops being readable, so the rest are counted.
    /// </summary>
    private static string ZoneList(List<string> zones)
    {
        if (zones.Count <= 3)
        {
            return zones.Count == 2
                ? $"{zones[0]} and {zones[1]}"
                : string.Join(", ", zones[..^1]) + " and " + zones[^1];
        }
        return string.Join(", ", zones[..3]) + $" and {zones.Count - 3} more";
    }

    /// <summary>One booked slot, said back in the customer's own words: "20:00 on 11 Sep, Europe/Copenhagen time".</summary>
    private static string SlotText(UpgradeFleetRow row, DateTime utc)
    {
        var local = LocalTime(row, utc);
        return $"{local:HH:mm} on {local:d MMM}, {ZoneLabel(row.TimeZone)} time";
    }

    /// <summary>
    /// Warns before the run when the picked time has already gone for at least one of
    /// the customers - a slot in the past is refused per row, and finding that out row by
    /// row after pressing the button is no way to learn it.
    /// </summary>
    private string? SlotProblem()
    {
        var rows = SelectedRows();
        if (rows.Count == 0) return null;
        var past = rows.Where(r => SlotFor(r) <= DateTimeOffset.UtcNow).ToList();
        if (past.Count == 0) return null;
        if (past.Count == rows.Count) return "That time has already passed. Pick a time later than now.";

        // Named, not counted: "3 of these customers" leaves the person to work out which,
        // and the whole reason only some of them are past is that they are in another
        // country - which is exactly the thing to show.
        var first = $"{past[0].ProjectName} - {past[0].EnvironmentName}";
        var rest = past.Count == 2
            ? $" and {past[1].ProjectName} - {past[1].EnvironmentName}"
            : past.Count > 2 ? $" and {past.Count - 1} others" : string.Empty;
        return $"Already past for {first}{rest}. Pick a later time.";
    }

    private List<UpgradeActionRow> PendingFor(int environmentId) =>
        _pending.Where(a => a.EnvironmentId == environmentId).OrderBy(a => a.ExecuteAfter).ToList();

    /// <summary>
    /// What the row says about the bookings waiting on it. One booking gets the whole fact
    /// - when, in whose time, and who booked it - because that is what a colleague needs
    /// in order to decide whether to leave it alone. Several get the nearest one and a
    /// count, and the history behind them opens from the same words.
    /// </summary>
    private static string BookedMarkerText(UpgradeFleetRow row, List<UpgradeActionRow> waiting)
    {
        var next = waiting[0];
        // The zone in brackets rather than as "... time", and dropped entirely once there
        // is more than one booking: this sits in a table cell beside the environment name,
        // and the long form wrapped onto three lines.
        // A booked version change names its version: "Booked for 20:00" alone would read as
        // the update itself starting then. Nothing on this page books one yet, but the
        // worker runs them, so the marker has to be able to say so.
        var local = LocalTime(row, next.ExecuteAfter);
        var what = next.Kind == UpgradeActionKind.SelectVersion && next.TargetVersion is { } version
            ? $"Booked a change to {version}"
            : "Booked";
        return waiting.Count == 1
            ? $"{what} for {local:HH:mm} on {local:d MMM} ({ZoneLabel(row.TimeZone)}) by {next.RequestedByName}"
            : $"{waiting.Count} bookings - next at {local:HH:mm} on {local:d MMM}";
    }

    /// <summary>One instant in one customer's own time.</summary>
    private static DateTime LocalTime(UpgradeFleetRow row, DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc), UpdateWindow.ResolveTimeZone(row.TimeZone));

    /// <summary>Opens (or closes) one environment's history, reading it when it opens.</summary>
    private async Task ToggleFeedAsync(UpgradeFleetRow row)
    {
        if (_feedEnvId == row.EnvironmentId)
        {
            _feedEnvId = null;
            _feed = null;
            return;
        }

        _feedEnvId = row.EnvironmentId;
        _feed = null;
        StateHasChanged();
        _feed = await Actions.ListEnvironmentActivityAsync(row.ProjectId, row.EnvironmentId);
    }

    /// <summary>
    /// Cancels a booked update, from the feed or from the result of the batch that booked
    /// it. A cancel that loses to the worker starting the update comes back as a plain
    /// refusal, which is shown as-is: it says the action has already run, which is the
    /// truth and the only thing worth knowing.
    /// </summary>
    private async Task CancelActionAsync(int actionId)
    {
        try
        {
            await Actions.CancelUpgradeActionAsync(actionId);
            _notice = new Notice("The booked update was cancelled.", "info", false);
        }
        catch (PlanValidationException ex)
        {
            _notice = new Notice(FirstMessage(ex), "warn", false);
        }
        catch (ProjectAccessDeniedException ex)
        {
            _notice = new Notice(ex.Message, "warn", false);
        }

        // Both the row markers and the open feed have to agree with what just happened.
        _results.Clear();
        await ReloadNowAsync();
        if (_feedEnvId is { } envId && _all.FirstOrDefault(r => r.EnvironmentId == envId) is { } row)
        {
            _feed = await Actions.ListEnvironmentActivityAsync(row.ProjectId, envId);
        }
    }

    /// <summary>
    /// The header row, shared by the loading skeleton and the real table so the
    /// columns are already where they will be when the data lands.
    /// </summary>
    private RenderFragment TableHead(bool selectable) => @<tr>
        <th class="data-table__col-check">
            @if (selectable && _actionableRows.Count > 0)
            {
                <label class="check@(SomePicked ? " is-indeterminate" : "")" aria-label="Select every environment you can change">
                    <input type="checkbox" checked="@AllPicked" disabled="@_running" @onchange="ToggleAll" />
                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                </label>
            }
            else
            {
                <span class="u-sr">Select</span>
            }
        </th>
        <th class="data-table__col-state"><span class="u-sr">State</span></th>
        <th scope="col" class="upg-env">Environment</th>
        <th scope="col" class="upg-customer">Solution</th>
        <th scope="col">Now on</th>
        <th scope="col">Next update</th>
        <th scope="col">Latest possible date</th>
        <th scope="col">Last checked</th>
        <th scope="col" class="data-table__actions">Actions</th>
    </tr>;

    // ── Confirm-dialog previews ─────────────────────────────────────────

    /// <summary>
    /// The preview both dialogs show: what will happen, then - under its own heading -
    /// what will be passed over. Shared so the two dialogs cannot drift apart.
    /// </summary>
    private RenderFragment PreviewList() => @<div>
        <ul class="upg-preview">
            @foreach (var item in _preview.Where(p => p.Group == PreviewGroup.Acting))
            {
                <li>
                    <span class="upg-preview__who">
                        @item.ProjectName - @item.EnvironmentName
                        @if (item.IsProduction)
                        {
                            <StatusPill Tone="muted" Class="upg-prod"><span>Production</span>
                            </StatusPill>
                        }
                    </span>
                    <span class="upg-preview__what">@item.What</span>
                </li>
            }
        </ul>
        @if (_preview.Any(p => p.Group == PreviewGroup.AlreadyBooked))
        {
            <p class="upg-preview__head">Already booked (@_preview.Count(p => p.Group == PreviewGroup.AlreadyBooked))</p>
            <ul class="upg-preview">
                @foreach (var item in _preview.Where(p => p.Group == PreviewGroup.AlreadyBooked))
                {
                    <li>
                        <span class="upg-preview__who">
                            @item.ProjectName - @item.EnvironmentName
                            @if (item.IsProduction)
                            {
                                <StatusPill Tone="muted" Class="upg-prod"><span>Production</span>
                                </StatusPill>
                            }
                        </span>
                        <span class="upg-preview__what upg-preview__booked">@item.What</span>
                    </li>
                }
            </ul>
        }
        @if (_preview.Any(p => p.Skipped))
        {
            <p class="upg-preview__head">Will be skipped (@_preview.Count(p => p.Skipped))</p>
            <ul class="upg-preview">
                @foreach (var item in _preview.Where(p => p.Skipped))
                {
                    <li class="upg-preview__skip">
                        <span class="upg-preview__who">@item.ProjectName - @item.EnvironmentName</span>
                        <span class="upg-preview__what">@item.What</span>
                    </li>
                }
            </ul>
        }
    </div>;

    /// <summary>
    /// The version change's preview: the rows that will change, then each group that
    /// will be passed over under its own heading, in the order a person asks "why not
    /// this one?" - already done, not possible, busy, not theirs, gone. Same markup as
    /// the other two dialogs, so the three read as one page.
    /// </summary>
    private RenderFragment VersionPreviewList() => @<div class="upg-version__groups">
        @if (_versionPreview.Any(p => p.WillChange))
        {
            <section class="upg-version__group">
            <p class="upg-preview__head">Will change (@_versionPreview.Count(p => p.WillChange))</p>
            <ul class="upg-preview">
                @foreach (var item in _versionPreview.Where(p => p.WillChange))
                {
                    <li>
                        <span class="upg-preview__who">
                            @item.Row.ProjectName - @item.Row.EnvironmentName
                            @if (item.Row.IsProduction)
                            {
                                <StatusPill Tone="muted" Class="upg-prod"><span>Production</span>
                                </StatusPill>
                            }
                        </span>
                        <span class="upg-preview__what">@ChangeText(item)</span>
                    </li>
                }
            </ul>
            </section>
        }
        @foreach (var (group, heading) in SkippedGroups)
        {
            var items = _versionPreview.Where(p => p.Group == group).ToList();
            if (items.Count == 0) continue;
            <section class="upg-version__group">
            <p class="upg-preview__head">@heading (@items.Count)</p>
            <ul class="upg-preview">
                @foreach (var item in items)
                {
                    <li class="upg-preview__skip">
                        <span class="upg-preview__who">@item.Row.ProjectName - @item.Row.EnvironmentName</span>
                        <span class="upg-preview__what">@item.Detail</span>
                    </li>
                }
            </ul>
            </section>
        }
    </div>;

    /// <summary>The groups a version change passes over, in the order the preview lists them.</summary>
    private static readonly (SelectVersionGroup Group, string Heading)[] SkippedGroups =
    [
        (SelectVersionGroup.AlreadyOnIt, "Already on it"),
        (SelectVersionGroup.AlreadyChosen, "Already chosen"),
        (SelectVersionGroup.NotOffered, "Not offered"),
        (SelectVersionGroup.UpdateUnderWay, "Update under way"),
        (SelectVersionGroup.NoAccess, "No access"),
        (SelectVersionGroup.Missing, "Missing or being deleted"),
    ];

    /// <summary>
    /// "28.5 to 29.2", or with a proviso when the environment's offer list has never been
    /// read: the row is counted as a change, and the read before the write decides.
    /// </summary>
    private static string ChangeText(SelectVersionPreviewRow item) => item.OfferUnknown
        ? $"{item.Detail}, if Business Central offers it"
        : item.Detail;

    private string VersionCountLine()
    {
        var acting = _versionPreview.Where(p => p.WillChange).ToList();
        if (acting.Count == 0) return "Nothing to change for this version.";
        var production = acting.Count(p => p.Row.IsProduction);
        var envs = $"{acting.Count} environment{(acting.Count == 1 ? "" : "s")}";
        return production == 0
            ? $"{envs}, none of them production."
            : $"{envs}, including {production} production.";
    }

    /// <summary>How much of the fleet this is, and how much of it is production.</summary>
    private string PreviewCountLine()
    {
        var acting = _preview.Where(p => !p.Skipped).ToList();  // acting + already-booked
        var production = acting.Count(p => p.IsProduction);
        var envs = $"{acting.Count} environment{(acting.Count == 1 ? "" : "s")}";
        return production == 0
            ? $"{envs}, none of them production."
            : $"{envs}, including {production} production.";
    }

    // ── Wording ─────────────────────────────────────────────────────────

    /// <summary>
    /// When the environment's next update happens, in the same words the solution
    /// page uses for the same fact - a person who reads both must not have to learn
    /// two vocabularies. A dated update is a Timestamp in the markup, in the
    /// organisation's zone; this is the line for one without a date.
    /// </summary>
    private static string UpdateWhen(UpgradeFleetRow row)
    {
        // The dated line is bare, the way the sheet has it: the row's other "when" - a
        // slot somebody here booked - announces itself ("Booked for 20:00 on 30 Aug ...
        // by Anna Jensen"), so the pair stay tellable apart.
        if (row.HasUpdate)
        {
            return string.IsNullOrWhiteSpace(row.NextUpdateStatus) ? "no date set yet" : row.NextUpdateStatus;
        }
        // With nothing waiting, this line is where the sheet names a state that is not
        // plain Running - the state cell is a glyph, and this keeps the word on screen.
        return IsRunning(row) ? "Nothing waiting" : StatusWord(row);
    }

    /// <summary>
    /// The major.minor a person actually compares. Business Central reports a four-part
    /// build ("27.5.34567.0"), and reading that next to "27.6" is arithmetic; the full
    /// string stays on the cell's title for anyone who needs it.
    /// </summary>
    private static string ShortVersion(string? version)
    {
        if (string.IsNullOrWhiteSpace(version)) return "—";
        var parts = version.Split('.');
        return parts.Length >= 2 ? $"{parts[0]}.{parts[1]}" : version;
    }

    // The confirm dialog's preview lines are plain text, so these go through the display
    // zone directly rather than through a Timestamp.
    private string DateText(DateTime? at) =>
        at is { } value ? Zone.Format(value, "dd MMM yyyy") : "no date";

    private string WhenText(DateTime? at) =>
        at is { } value ? Zone.Format(value, "dd MMM yyyy") : "No date set";

    /// <summary>
    /// Why a selected row won't move, in the same words the service refuses with, so
    /// the preview and the run never disagree.
    /// </summary>
    private static string WhyNoPush(UpgradeFleetRow row)
    {
        if (!row.HasUpdate) return "no update is waiting";
        if (row.EffectiveLatestDate is null) return "Business Central hasn't given it a last possible date";
        return "its date is already the latest allowed";
    }

    /// <summary>
    /// A mirror older than a day and a half has missed a nightly refresh, so the row
    /// is saying something nobody has checked since. Muted, not alarming: the answer
    /// is probably still right, it is just old.
    /// </summary>
    private static bool IsStale(UpgradeFleetRow row) =>
        row.FetchedAt is null || DateTime.UtcNow - row.FetchedAt.Value > TimeSpan.FromHours(36);

    private static string FirstMessage(PlanValidationException ex) =>
        ex.Errors.Values.FirstOrDefault() ?? "Business Central refused the change.";

    /// <summary>
    /// One line in a confirm dialog's preview: who it is about, and what will happen to
    /// them. <paramref name="Group"/> decides which of the three lists it lands in - what
    /// will happen, what already has a booking waiting, and what will be passed over.
    /// </summary>
    private sealed record PreviewItem(
        string ProjectName, string EnvironmentName, bool IsProduction, string What, PreviewGroup Group)
    {
        public bool Skipped => Group == PreviewGroup.Skipped;
    }

    /// <summary>
    /// Which part of the preview a row belongs in. "Already booked" is deliberately its
    /// own group rather than a skip: the run <em>will</em> act on it, it just adds a
    /// second booking to an environment that already has one, and that is a thing to
    /// notice before pressing the button rather than after.
    /// </summary>
    private enum PreviewGroup { Acting, AlreadyBooked, Skipped }

    /// <summary>
    /// One row's live result during and after a run. The class is built here rather
    /// than interpolated into the markup, so every class name the page renders is a
    /// whole name a stylesheet can be checked against. A result that needs the reader
    /// to go somewhere else carries the link to get there.
    /// </summary>
    private sealed record RowResult(
        string Text, string Tone, int? ProjectId = null, string? LinkLabel = null, int? ActionId = null)
    {
        public string CssClass => $"upg-note upg-note--{Tone}";

        /// <summary>
        /// Short enough for the Next update cell without widening it: a few words, and
        /// nothing to click. Refusals carry Business Central's sentence and stay below.
        /// </summary>
        public bool IsBrief => ProjectId is null && LinkLabel is null && ActionId is null && Text.Length <= 28;
    }

    /// <summary>
    /// The line above the table after an action. Its tone is part of the message: a
    /// run that skipped or failed something must not read like a success.
    /// </summary>
    private sealed record Notice(string Text, string Tone, bool ShowReloadNow)
    {
        public string CssClass => $"upg-notice upg-notice--{Tone}";
    }
}
