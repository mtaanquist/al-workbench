@code {
    /// <summary>Which view: <c>open</c> (the default), <c>archive</c> or <c>fleet</c>.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "view")] public string? ViewName { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "type")] public string? TypeFilter { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "waiting")] public string? WaitingFilter { get; set; }

    /// <summary>
    /// The rows on screen: the fleet after the filters, or every ticked row while Show
    /// selected is on. Null while it is still loading.
    /// </summary>
    private List<UpgradeFleetRow>? _rows;
    private List<UpgradeFleetRow> _all = new();

    /// <summary>The rows on screen that this person can act on - what the header checkbox ticks.</summary>
    private List<UpgradeFleetRow> _actionableRows = new();
    private List<string> _typeOptions = new();
    private int _totalCount;

    private bool _denied;
    private string _search = string.Empty;
    private string _type = string.Empty;
    private bool _onlyWaiting;

    /// <summary>
    /// The ticked rows. The search and the view leave them ticked when they take them
    /// off screen (#985); only a re-read drops a tick, for a row that is gone or that
    /// this person can no longer act on.
    /// </summary>
    private readonly SelectionSet _selection = new();
    private UpgradeNotice? _notice;

    /// <summary>
    /// The three commands' dialogs and the run behind them. Null until the first render;
    /// the page's rows read the run's results from it.
    /// </summary>
    private UpgradeActionRunner? _runner;

    private static readonly IReadOnlyDictionary<int, UpgradeRowResult> NoResults = new Dictionary<int, UpgradeRowResult>();

    /// <summary>What the last run did to each row.</summary>
    private IReadOnlyDictionary<int, UpgradeRowResult> Results => _runner?.Results ?? NoResults;

    /// <summary>True while a run is working through its rows; the page's own controls wait for it.</summary>
    private bool Running => _runner?.IsRunning == true;

    /// <summary>Everything booked and not yet run, across the whole visible fleet, keyed by environment.</summary>
    private List<UpgradeActionRow> _pending = new();

    /// <summary>The environment whose activity is open, and its entries (null while loading).</summary>
    private int? _feedEnvId;
    private List<UpgradeActionRow>? _feed;

    private bool ActionsDisabled => _selection.Count == 0 || Running;

    protected override async Task OnInitializedAsync()
    {
        await Zone.EnsureLoadedAsync();
        var snapshot = await Access.GetSnapshotAsync();
        // The grant is deliberately not in the sign-in claims, so the page asks the
        // same service the sidebar does rather than reading a role.
        if (!snapshot.CanUseEnvironmentOps)
        {
            _denied = true;
            return;
        }

        ReadQuery();
        // The view on screen first; the other two only need their counts for the tabs.
        if (_view == UpgradesView.Fleet) await LoadAsync();
        await LoadPlannedAsync();
        if (_view != UpgradesView.Fleet) await CountFleetAsync();
        _initialised = true;
    }

    /// <summary>True once the first load is done; a view change before then is the first load's to make.</summary>
    private bool _initialised;

    protected override async Task OnParametersSetAsync()
    {
        if (_denied || !_initialised) return;
        var was = _view;
        ReadQuery();
        if (_view != was) await OnViewChangedAsync(was);
        // Only once the fleet is in hand: the first pass runs before it is loaded.
        else if (_view == UpgradesView.Fleet && _rows is not null) ApplyFilters();
    }

    public void Dispose()
    {
        StopPolling();
        _searchDebounce.Dispose();
        _watch.Dispose();
    }

    private void ReadQuery()
    {
        _view = ParseView(ViewName);
        _search = (Query ?? string.Empty).Trim();
        _type = (TypeFilter ?? string.Empty).Trim();
        _onlyWaiting = WaitingFilter == "1";
    }

    /// <summary>
    /// The view select's value for one combination of the two filters behind it. The
    /// sheet offers them as one list ("Production, update waiting") because that is
    /// how the team thinks of them; the address keeps them apart so old links hold.
    /// </summary>
    private static string ViewValue(string type, bool waiting) => (waiting ? "1" : "0") + type;

    private async Task OnViewChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await RememberViewAsync(value);
        GoToFilters(type: value.Length > 1 ? value[1..] : string.Empty, waiting: value.StartsWith('1'));
    }

    // ── The view, remembered ────────────────────────────────────────────

    /// <summary>
    /// Where the last view picked is kept for as long as this browser session lasts:
    /// coming back to the page, or reloading it, keeps the slice somebody was working in
    /// (production, usually), and a new session starts on everything again. Session
    /// storage on purpose (maintainer's decision, 2026-09-21) - not the account, and not
    /// for good. The search box is not part of it: a search is a question, not a habit.
    /// </summary>
    private const string ViewStorageKey = "aldt-upgrades-view";

    private bool _viewRestored;

    /// <summary>
    /// A bare /upgrades opens on the remembered view. An address that already names a
    /// filter is left alone: a link somebody sent shows what they meant it to show.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only the Fleet view has a remembered slice; the first time it is shown counts.
        if (_viewRestored || _denied || _view != UpgradesView.Fleet || _rows is null) return;
        _viewRestored = true;
        if (Query is not null || TypeFilter is not null || WaitingFilter is not null) return;

        string? saved;
        try
        {
            saved = await JS.InvokeAsync<string?>("sessionStorage.getItem", ViewStorageKey);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException or TaskCanceledException)
        {
            return; // no storage, or no browser yet: the page simply opens on everything
        }

        if (string.IsNullOrEmpty(saved) || saved == ViewValue(string.Empty, false)) return;
        GoToFilters(type: saved.Length > 1 ? saved[1..] : string.Empty, waiting: saved.StartsWith('1'));
    }

    private async Task RememberViewAsync(string view)
    {
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", ViewStorageKey, view);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException or TaskCanceledException)
        {
            // Private window, blocked storage: the view still applies, it just isn't kept.
        }
    }

    /// <summary>How long the search box waits for typing to stop before it filters. Tests set it to zero.</summary>
    internal static TimeSpan SearchDebounce { get; set; } = TimeSpan.FromMilliseconds(200);

    private readonly Debouncer _searchDebounce = new(SearchDebounce);

    // The box is bound to _search as it is typed, untrimmed - trimming it here would
    // eat the space between two words. The table follows once typing pauses.
    private void OnSearchInput() =>
        _searchDebounce.Trigger(() => InvokeAsync(() =>
        {
            ApplyFilters();
            StateHasChanged();
        }));

    private void OnSearchCommitted(ChangeEventArgs e)
    {
        _searchDebounce.Cancel();
        ApplyFilters();
        GoToFilters(_type, _onlyWaiting);
    }

    /// <summary>
    /// Applies a filter change by changing the address, so every state of this table
    /// has a link - including the one someone wants to send to a colleague.
    /// </summary>
    private void GoToFilters(string type, bool waiting)
    {
        // The Fleet view by name: a bare /upgrades is the Open view.
        var parts = new List<string> { "view=fleet" };
        var search = _search.Trim();
        if (search.Length > 0) parts.Add("q=" + Uri.EscapeDataString(search));
        if (type.Length > 0) parts.Add("type=" + Uri.EscapeDataString(type));
        if (waiting) parts.Add("waiting=1");
        Nav.NavigateTo("/upgrades?" + string.Join("&", parts));
    }

    private async Task LoadAsync()
    {
        _all = await Fleet.ListFleetAsync();
        _fleetCount = _all.Count;
        _offeredVersions = OfferedVersionNames(_all);
        _pending = await Actions.ListPendingAsync();
        // Against the whole fleet, not the rows on screen: a tick the search has
        // hidden is still wanted. A row that has gone, or that is no longer this
        // person's to change, is not.
        _selection.Prune(_all.Where(r => r.CanAct).Select(r => r.EnvironmentId));
        _totalCount = _all.Count;
        _typeOptions = _all
            .Select(r => r.EnvironmentType)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
            .ToList();
        ApplyFilters();
        _watch.JoinUnderWay(_all);
    }

    private void ApplyFilters()
    {
        IEnumerable<UpgradeFleetRow> q = _all;
        var term = _search.Trim();
        if (term.Length > 0)
        {
            q = q.Where(r =>
                r.ProjectName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (r.ProjectShortName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || r.EnvironmentName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        if (_type.Length > 0)
        {
            q = q.Where(r => string.Equals(r.EnvironmentType, _type, StringComparison.OrdinalIgnoreCase));
        }
        if (_onlyWaiting)
        {
            q = q.Where(r => r.HasUpdate);
        }

        // Filtering never unticks anything (#985): the count in the bar says how many
        // of the ticks are off screen, and the commands act on all of them.
        _rows = _selection.Shown(q, _all, r => r.EnvironmentId, FilterKey()).ToList();
        _actionableRows = _rows.Where(r => r.CanAct).ToList();
    }

    /// <summary>
    /// The search and the view as they stand. Show selected holds only while this
    /// does: changing either is asking to see something else.
    /// </summary>
    private (string Search, string Type, bool Waiting) FilterKey() => (_search, _type, _onlyWaiting);

    private List<int> ShownActionableIds() => _actionableRows.Select(r => r.EnvironmentId).ToList();

    private bool AllPicked => _selection.AllShownPicked(ShownActionableIds());

    /// <summary>The keyline state, plus the tint of a ticked row and the mark of a locked one.</summary>
    private static string RowClass(UpgradeFleetRow row, bool picked) =>
        RowState(row) + (picked ? " is-selected" : "") + (row.CanAct ? "" : " upg-row--locked");

    /// <summary>Some of the rows on screen but not all: the header box shows a dash rather than a tick.</summary>
    private bool SomePicked => _selection.SomeShownPicked(ShownActionableIds());

    /// <summary>
    /// The header box ticks or unticks the rows on screen, and only those: a tick the
    /// search has hidden is left as it was.
    /// </summary>
    private void ToggleAll(ChangeEventArgs e)
    {
