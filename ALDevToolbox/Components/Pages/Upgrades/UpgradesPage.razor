        ApplyFilters();
    }

    private void TogglePick(int environmentId, ChangeEventArgs e)
    {
        _selection.Set(environmentId, e.Value is true);
        // Under Show selected, a row unticked leaves the table; the last one ends the view.
        if (_selection.ShowSelectedOnly || _selection.Count == 0) ApplyFilters();
    }

    private void ToggleShowSelected()
    {
        _selection.ShowSelected(!_selection.ShowSelectedOnly, FilterKey());
        ApplyFilters();
    }

    private void ClearSelection()
    {
        _selection.Clear();
        ApplyFilters();
    }

    /// <summary>
    /// What the bar's commands act on: every ticked row, whether the search and the view
    /// have it on screen or not. Each dialog lists them all by name before anything is
    /// sent, so a hidden tick is seen before it is acted on.
    /// </summary>
    private List<UpgradeFleetRow> SelectedRows() =>
        _all.Where(r => r.CanAct && _selection.Contains(r.EnvironmentId)).ToList();

    // ── The three bulk actions ──────────────────────────────────────────
    //
    // The dialogs and the loop that runs them live in UpgradeActionRunner, which an
    // upgrade's own page shares. A row-menu command hands over that one row, kept apart
    // from the ticked rows so that starting one customer's update from its own menu
    // neither uses nor disturbs a selection made for something else.

    private UpgradeActionTarget Target(UpgradeFleetRow? only) => only is null
        ? UpgradeActionTarget.ForSelection(SelectedRows())
        : UpgradeActionTarget.ForRow(only);

    private Task ConfirmPushAsync(UpgradeFleetRow? only = null) =>
        _runner?.ConfirmPushAsync(Target(only)) ?? Task.CompletedTask;

    private Task ConfirmUpdateNowAsync(UpgradeFleetRow? only = null) =>
        _runner?.ConfirmUpdateNowAsync(Target(only)) ?? Task.CompletedTask;

    private Task ConfirmSelectVersionAsync(UpgradeFleetRow? only = null) =>
        _runner?.ConfirmSelectVersionAsync(Target(only)) ?? Task.CompletedTask;

    /// <summary>A run owns the table while it lasts: no refresh poll, and no old summary.</summary>
    private void OnRunStarted()
    {
        StopPolling();
        _notice = null;
    }

    /// <summary>
    /// Re-reads the fleet so the table shows what Business Central now says rather than
    /// what we asked it for, then watches the updates the run started. The ticks stay,
    /// less any row that has gone. The summary goes up once the re-read is in: the page
    /// redraws while it is in flight, and the summary is the sign the run is over.
    /// </summary>
    private async Task OnRunFinishedAsync(UpgradeRunOutcome outcome)
    {
        await LoadAsync();
        _notice = outcome.Notice;
        foreach (var environmentId in _watch.WatchStarted(outcome.Started))
        {
            _runner?.ForgetResult(environmentId);
        }
    }

    // ── Refresh ─────────────────────────────────────────────────────────

    private async Task RefreshDataAsync()
    {
        // With a selection, refresh those customers; with none, everything you can act
        // on - which is what someone starting their morning wants.
        var projectIds = _selection.Count > 0
            ? SelectedRows().Select(r => r.ProjectId).Distinct().ToList()
            : _actionableRows.Select(r => r.ProjectId).Distinct().ToList();

        if (projectIds.Count == 0)
        {
            _notice = new UpgradeNotice("There is nothing here you can refresh.", "info", false);
            return;
        }

        var result = await Fleet.RequestRefreshAsync(projectIds, force: true);
        var asked = result.Queued + result.AlreadyRunning;
        _notice = new UpgradeNotice(
            $"Asking Business Central about {asked} solution{(asked == 1 ? "" : "s")}. "
            + "New answers will appear here.",
            "info", true);
        StartPolling();
    }

    /// <summary>Re-reads the fleet now, for someone who doesn't want to wait for the next poll.</summary>
    private async Task ReloadNowAsync() => await LoadAsync();

    // ── Polling while a refresh is outstanding ──────────────────────────
    //
    // The answers arrive in the background worker's own time, so the page collects
    // them itself rather than telling the reader to reload. Every tick goes through
    // InvokeAsync, which puts the query on the renderer's sync context - the same
    // thing that keeps it from colliding with a click handler on this circuit's one
    // AppDbContext. It gives up after a few minutes: a refresh that hasn't answered
    // by then isn't going to, and a page left open overnight must not poll forever.

    private System.Threading.Timer? _poll;
    private DateTime _pollUntilUtc;

    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(20);
    private static readonly TimeSpan PollFor = TimeSpan.FromMinutes(3);

    private void StartPolling()
    {
        StopPolling();
        // "Refresh restarts it": a watch that gave up may join again on the reload.
        _watch.ForgetStopped();
        _pollUntilUtc = DateTime.UtcNow.Add(PollFor);
        _poll = new System.Threading.Timer(_ => _ = PollTickAsync(), null, PollEvery, PollEvery);
    }

    private void StopPolling()
    {
        _poll?.Dispose();
        _poll = null;
    }

    private async Task PollTickAsync()
    {
        if (DateTime.UtcNow > _pollUntilUtc)
        {
            StopPolling();
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                // Never while a batch is mid-flight: that run owns the table.
                if (Running || _denied) return;
                await ReloadNowAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            StopPolling();
        }
        catch (Exception ex)
        {
            // A failed poll is not worth breaking the page over; stop asking.
            Log.LogWarning(ex, "The upgrades page stopped polling for refreshed environments.");
            StopPolling();
        }
    }

    // ── Watching an update through to its end (#982) ────────────────────
    //
    // After "Start update" the person often stays on the page to see it finish before
    // calling the customer back, so an update under way is re-read from Business Central
    // every ten seconds until it ends. UpdateWatch holds the timer, the reads and the
    // verdicts; an upgrade's own page (#984) watches its lines with the same one. It pauses
    // while a run or a dialog is open, as the refresh poll does. See
    // .design/environment-updates.md, "The page".

    private UpdateWatch _watch = null!;

    protected override void OnInitialized()
    {
        _watch = new UpdateWatch(Connection, Log, InvokeAsync,
            paused: () => Running || _denied || _runner?.IsDialogOpen == true,
            find: id => _all.FirstOrDefault(r => r.EnvironmentId == id),
            replace: row =>
            {
                var index = _all.FindIndex(r => r.EnvironmentId == row.EnvironmentId);
                if (index >= 0) _all[index] = row;
            },
            afterTick: changed =>
            {
                // One pass over the filters for the whole tick rather than one per row.
                if (changed) ApplyFilters();
                StateHasChanged();
                return Task.CompletedTask;
            });
    }

    /// <summary>The environments being watched. For tests, which drive the tick by hand.</summary>
    internal IReadOnlyCollection<int> WatchedEnvironmentIds => _watch.Watching.Keys.ToList();

    /// <summary>One tick of the watch, for tests that drive it without waiting on the timer.</summary>
    internal Task WatchTickAsync() => _watch.TickAsync();

    // ── Bookings, the activity feed, and cancelling ─────────────────────

    /// <summary>A customer's time zone the way a consultant names it, as the dialogs say it.</summary>
    private static string ZoneLabel(string? ianaId) => UpgradeActionRunner.ZoneLabel(ianaId);

    private List<UpgradeActionRow> PendingFor(int environmentId) =>
        _pending.Where(a => a.EnvironmentId == environmentId).OrderBy(a => a.ExecuteAfter).ToList();

    /// <summary>
    /// What the row says about the bookings waiting on it. One booking gets the whole fact
    /// - when, in whose time, and who booked it - because that is what a colleague needs
    /// in order to decide whether to leave it alone. Several get the nearest one and a
    /// count, and the history behind them opens from the same words.
    /// </summary>
    private static string BookedMarkerText(UpgradeFleetRow row, List<UpgradeActionRow> waiting)
    {
        var next = waiting[0];
        // The zone in brackets rather than as "... time", and dropped entirely once there
        // is more than one booking: this sits in a table cell beside the environment name,
        // and the long form wrapped onto three lines.
        // A booked version change names its version: "Booked for 20:00" alone would read as
        // the update itself starting then. Nothing on this page books one yet, but the
        // worker runs them, so the marker has to be able to say so.
        var local = LocalTime(row, next.ExecuteAfter);
        var what = next.Kind == UpgradeActionKind.SelectVersion && next.TargetVersion is { } version
            ? $"Booked a change to {version}"
            : "Booked";
        return waiting.Count == 1
            ? $"{what} for {local:HH:mm} on {local:d MMM} ({ZoneLabel(row.TimeZone)}) by {next.RequestedByName}"
            : $"{waiting.Count} bookings - next at {local:HH:mm} on {local:d MMM}";
    }

    private static DateTime LocalTime(UpgradeFleetRow row, DateTime utc) => UpgradeActionRunner.LocalTime(row, utc);

    /// <summary>Opens (or closes) one environment's history, reading it when it opens.</summary>
    private async Task ToggleFeedAsync(UpgradeFleetRow row)
    {
        if (_feedEnvId == row.EnvironmentId)
        {
            _feedEnvId = null;
            _feed = null;
            return;
        }

        _feedEnvId = row.EnvironmentId;
        _feed = null;
        StateHasChanged();
        _feed = await Actions.ListEnvironmentActivityAsync(row.ProjectId, row.EnvironmentId);
    }

    /// <summary>
    /// Cancels a booked update, from the feed or from the result of the batch that booked
    /// it. A cancel that loses to the worker starting the update comes back as a plain
    /// refusal, which is shown as-is: it says the action has already run, which is the
    /// truth and the only thing worth knowing.
    /// </summary>
    private async Task CancelActionAsync(int actionId)
    {
        try
        {
            await Actions.CancelUpgradeActionAsync(actionId);
            _notice = new UpgradeNotice("The booked update was cancelled.", "info", false);
        }
        catch (PlanValidationException ex)
        {
            _notice = new UpgradeNotice(FirstMessage(ex), "warn", false);
        }
        catch (ProjectAccessDeniedException ex)
        {
            _notice = new UpgradeNotice(ex.Message, "warn", false);
        }

        // Both the row markers and the open feed have to agree with what just happened.
        _runner?.ClearResults();
        await ReloadNowAsync();
        if (_feedEnvId is { } envId && _all.FirstOrDefault(r => r.EnvironmentId == envId) is { } row)
        {
            _feed = await Actions.ListEnvironmentActivityAsync(row.ProjectId, envId);
        }
    }

    /// <summary>
    /// The header row, shared by the loading skeleton and the real table so the
    /// columns are already where they will be when the data lands.
    /// </summary>
    private RenderFragment TableHead(bool selectable) => @<tr>
        <th class="data-table__col-check">
            @if (selectable && _actionableRows.Count > 0)
            {
                <label class="check@(SomePicked ? " is-indeterminate" : "")" aria-label="Select every environment you can change">
                    <input type="checkbox" checked="@AllPicked" disabled="@Running" @onchange="ToggleAll" />
                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                </label>
            }
            else
            {
                <span class="u-sr">Select</span>
            }
        </th>
        <th class="data-table__col-state"><span class="u-sr">State</span></th>
        <th scope="col" class="upg-env">Environment</th>
        <th scope="col" class="upg-customer">Solution</th>
        <th scope="col">Now on</th>
        <th scope="col">Next update</th>
        <th scope="col">Latest possible date</th>
        <th scope="col">Last checked</th>
        <th scope="col" class="data-table__actions">Actions</th>
    </tr>;

    // ── Wording ─────────────────────────────────────────────────────────

    /// <summary>
    /// When the environment's next update happens, in the same words the solution
    /// page uses for the same fact - a person who reads both must not have to learn
    /// two vocabularies. A dated update is a Timestamp in the markup, in the
    /// organisation's zone; this is the line for one without a date.
    /// </summary>
    private static string UpdateWhen(UpgradeFleetRow row)
    {
        // The dated line is bare, the way the sheet has it: the row's other "when" - a
        // slot somebody here booked - announces itself ("Booked for 20:00 on 30 Aug ...
        // by Anna Jensen"), so the pair stay tellable apart.
        if (row.HasUpdate)
        {
            return string.IsNullOrWhiteSpace(row.NextUpdateStatus) ? "no date set yet" : row.NextUpdateStatus;
        }
        // With nothing waiting, this line is where the sheet names a state that is not
        // plain Running - the state cell is a glyph, and this keeps the word on screen.
        return IsRunning(row) ? "Nothing waiting" : StatusWord(row);
    }

    /// <summary>Major.minor, the way the runner's dialogs say it too; the full build is on hover.</summary>
    private static string ShortVersion(string? version) => UpgradeActionRunner.ShortVersion(version);

    /// <summary>
    /// A mirror older than a day and a half has missed a nightly refresh, so the row
    /// is saying something nobody has checked since. Muted, not alarming: the answer
    /// is probably still right, it is just old.
    /// </summary>
    private static bool IsStale(UpgradeFleetRow row) =>
        row.FetchedAt is null || DateTime.UtcNow - row.FetchedAt.Value > TimeSpan.FromHours(36);

    private static string FirstMessage(PlanValidationException ex) => UpgradeActionRunner.FirstMessage(ex);
}

@code {
    // ── The Open and Archive views' markup ──────────────────────────────
    //
    // The rows are UpgradesOpenList and UpgradesArchiveList; these are the pieces the
    // frame asks for around them. The logic is in UpgradesPage.Planned.cs.

    /// <summary>The Open and Archive views before their rows arrive: the columns where they will be, and a line saying so.</summary>
    private RenderFragment PlannedLoading() => @<text>
        <table class="data-table upg-plan-skeleton">
            <thead>
                <tr>
                    <th scope="col">Upgrade</th>
                    <th scope="col">@(_view == UpgradesView.Archive ? "Target" : "Status")</th>
                    <th scope="col">Environments</th>
                    <th scope="col">@(_view == UpgradesView.Archive ? "Closed" : "Checked")</th>
                    <th scope="col">@(_view == UpgradesView.Archive ? "Created by" : "Planned")</th>
                    <th scope="col" class="data-table__actions"><span class="u-sr">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < 4; i++)
                {
                    <tr aria-hidden="true">
                        <td><span class="skeleton upg-skel upg-skel--wide"></span></td>
                        <td><span class="skeleton upg-skel upg-skel--pill"></span></td>
                        <td><span class="skeleton upg-skel"></span></td>
                        <td><span class="skeleton upg-skel"></span></td>
                        <td><span class="skeleton upg-skel"></span></td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
        @* The page reads its own record of the upgrades, not Business Central, so the
           line says nothing about Business Central (port note on the sheet). *@
        <LoadingBlock Text="Loading upgrades..." UnderTable="true" />
    </text>;

    /// <summary>The Open view's search and status filter, or the Archive's search.</summary>
    private RenderFragment PlannedFilters() => @<div class="upg-plan-filters">
        @if (_view == UpgradesView.Archive)
        {
            <FilterBar>
                <Search>
                    <input class="input" type="search" placeholder="Search by name or target version..."
                           aria-label="Search done upgrades by name or target version"
                           data-page-search aria-keyshortcuts="F3" title="Search done upgrades (F3)"
                           @bind="_archiveSearch" @bind:event="oninput" @bind:after="OnArchiveSearch" />
                </Search>
            </FilterBar>
        }
        else
        {
            <FilterBar>
                <Search>
                    <input class="input" type="search" placeholder="Search upgrades..."
                           aria-label="Search open upgrades by name or target version"
                           data-page-search aria-keyshortcuts="F3" title="Search open upgrades (F3)"
                           @bind="_openSearch" @bind:event="oninput" />
                </Search>
                <ChildContent>
                    <SelectBox Class="upg-status">
                        <select class="select" aria-label="Status" @bind="_openStatus">
                            <option value="">Every status</option>
                            <option value="@UpgradeStatus.Planned">Planned</option>
                            <option value="@UpgradeStatus.InProgress">In progress</option>
                            <option value="@UpgradeStatus.Updated">Updated</option>
                        </select>
                    </SelectBox>
                </ChildContent>
            </FilterBar>
        }
    </div>;

    private RenderFragment PlannedNoMatches() => @<div class="card">
        <EmptyState Icon="funnel-x" Title="@(_view == UpgradesView.Archive ? "No done upgrades match this search" : "No open upgrades match these filters")">
            <Text>Try a shorter search, or clear the filters to see all @(_view == UpgradesView.Archive ? _archive?.Count : _open?.Count).</Text>
            <Action>
                <button type="button" class="btn" @onclick="ClearPlannedFilters">Clear filters</button>
            </Action>
        </EmptyState>
    </div>;

    private RenderFragment PlannedRows() => @<text>
        @if (_view == UpgradesView.Archive)
        {
            <UpgradesArchiveList Rows="ShownArchive()" OnReopen="ReopenAsync" Busy="_planBusy" />
        }
        else
        {
            <UpgradesOpenList Rows="ShownOpen()" OnMarkDone="MarkDoneAsync" OnDelete="DeleteUpgradeAsync" Busy="_planBusy" />
        }
    </text>;

    private RenderFragment PlannedFooter() => @<text>
        @if (_view == UpgradesView.Archive)
        {
            var all = ShownArchiveAll();
            var shown = ShownArchive();
            <div class="pager">
                <span class="pager__count">Showing @shown.Count of @all.Count done upgrade@(all.Count == 1 ? "" : "s")</span>
                @if (all.Count > ArchivePageSize)
                {
                    <span class="pager__buttons">
                        <button type="button" class="btn btn--sm" disabled="@(_archivePage == 0)"
                                @onclick="() => _archivePage--">Previous</button>
                        <button type="button" class="btn btn--sm" disabled="@((_archivePage + 1) * ArchivePageSize >= all.Count)"
                                @onclick="() => _archivePage++">Next</button>
                    </span>
                }
            </div>
        }
        else
        {
            var shown = ShownOpen().Count;
            var total = _open?.Count ?? 0;
            <div class="pager">
                <span class="pager__count">@(shown == total ? $"{total} open upgrade{(total == 1 ? "" : "s")}" : $"Showing {shown} of {total} open upgrades")</span>
            </div>
        }
    </text>;

    /// <summary>The Mark done confirm's list of what is still unchecked, and where the leftovers go next.</summary>
    private RenderFragment MarkDoneList() => @<text>
        @if (_doneUnchecked.Count > 0)
        {
            <ul class="upg-done-list">
                @foreach (var line in _doneUnchecked)
                {
                    <li class="upg-done-list__row">
                        <span class="cell-stack">
                            <span class="cell-stack__main upg-done-list__name">@line.Environment.ProjectName</span>
                            <span class="cell-stack__sub">@EnvironmentLabel(line.Environment)</span>
                        </span>
                        <StatusPill Tone="@UpgradesListWording.LineStateTone(line.State)">@UpgradesListWording.LineStateWord(line.State)</StatusPill>
                    </li>
                }
            </ul>
            @if (LeftoversHint(_doneUnchecked) is { } hint)
            {
                <p class="upg-done-hint">@hint</p>
            }
        }
    </text>;
}
