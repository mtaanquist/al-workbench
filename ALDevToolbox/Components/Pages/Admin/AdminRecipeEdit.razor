@page "/admin/cookbook/new"
@page "/admin/cookbook/{Id:int}"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject RecipeService Recipes
@inject ApplicationVersionService ApplicationVersions
@inject NavigationManager Nav
@inject ILogger<AdminRecipeEdit> Log
@inject GitHubRepositoryService Repositories
@inject GitHubRecipeDeliveryService RecipeDelivery
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Services.Cookbook
@using ALDevToolbox.Services.Templates

<PageTitle>@(IsEdit ? "Edit recipe" : "New recipe") · Admin · AL Workbench</PageTitle>

<div class="page">
    <PageHead Title="@(IsEdit ? "Edit recipe" : "New recipe")" Sticky="true"
              Trail='@([new("Admin", "/admin"), new("Cookbook", "/admin/cookbook"), new(IsEdit ? "Edit recipe" : "New recipe")])'>
        <SubtitleContent>
            @(IsEdit
                ? "Update the published recipe. Changes apply on next reload of the user-facing cookbook."
                : "Add a new recipe to the published cookbook for this organisation.")
        </SubtitleContent>
        <Actions>
            @if (!IsEdit || !_loadFailed)
            {
                <button type="button" class="btn btn--sm btn--primary" @onclick="SaveAsync" disabled="@_busy">
                    <Icon Name="save" Width="14" Height="14" />
                    <span>@(_busy ? "Saving..." : IsEdit ? "Save changes" : "Create recipe")</span>
                </button>
            }
        </Actions>
    </PageHead>

    @if (IsEdit && _loadFailed)
    {
        <Alert Tone="AlertTone.Danger">
            <span>Recipe @Id was not found.</span>
        </Alert>
    }
    else
    {
        @* Archetype 6's form column, capped at 900px - "forms do not get wider
           than they can be read" (PagesForms.dc.html). The usage-history card
           below stays outside it at full content width, which is the same split
           the archetype makes for its audit panel: a log wants the characters,
           a form does not. Without this the inputs stretched to 625px in a
           1304px card. See #549. *@
        <div class="edit-col">
        <section class="card">
            <div class="card__head"><h2 class="card__title">Details</h2></div>
            <div class="card__body form-sec">
            <div class="form-grid">
                <div class="field">
                    <label class="field__label" for="recipe-title">Title</label>
                    <input class="input" id="recipe-title" type="text" maxlength="200"
                           @bind="_title" @bind:event="oninput"
                           placeholder="e.g. Doc. Attachment List Factbox for an unsupported table" />
                    <FieldError Field="Title" Errors="_errors" />
                </div>

                <div class="field">
                    <label class="field__label" for="recipe-type">Type</label>
                    <SelectBox>
                        <select class="select" id="recipe-type" @bind="_type">
                            <option value="@RecipeType.Snippet">Snippet - small, one or two files</option>
                            <option value="@RecipeType.Pattern">Pattern - a few related files</option>
                            <option value="@RecipeType.Module">Module - near-complete feature</option>
                        </select>
                    </SelectBox>
                    <FieldError Field="Type" Errors="_errors" />
                </div>

                <div class="field field--full">
                    <label class="field__label" for="recipe-description">Description</label>
                    <textarea class="textarea" id="recipe-description" rows="4" maxlength="2000"
                              @bind="_description" @bind:event="oninput"
                              placeholder="What does this recipe do, and when would you use it?"></textarea>
                    <FieldError Field="Description" Errors="_errors" />
                </div>

                <div class="field field--full">
                    <label class="field__label" for="recipe-keywords">Keywords</label>
                    <input class="input" id="recipe-keywords" type="text" maxlength="500"
                           @bind="_keywords" @bind:event="oninput"
                           placeholder="space-separated; wrap a phrase in quotes, e.g. &quot;document attachments&quot; factbox subscriber" />
                    <span class="field__hint">
                        Separate tags with spaces or commas. Wrap a multi-word tag in
                        double quotes to keep it as one - e.g.
                        <code class="code">"document attachments"</code>.
                    </span>
                    <FieldError Field="Keywords" Errors="_errors" />
                </div>

                <div class="field">
                    <label class="field__label" for="recipe-value-hours">Estimated value (hours)</label>
                    <input class="input" id="recipe-value-hours" type="number" min="0" step="0.25"
                           @bind="_estimatedValueHours" @bind:event="oninput"
                           placeholder="e.g. 8" />
                    <span class="field__hint">
                        Optional. Roughly how many hours of work this recipe saves an
                        implementer - shown on the recipe so a customer is billed at
                        least this much. Leave blank if not estimated.
                    </span>
                    <FieldError Field="EstimatedValueHours" Errors="_errors" />
                </div>

                <div class="field">
                    <label class="field__label" for="recipe-min-version">Minimum BC application version</label>
                    <SelectBox>
                        <select class="select" id="recipe-min-version" @bind="_minimumApplicationVersionId">
                            <option value="">No minimum</option>
                            @foreach (var v in _applicationVersions)
                            {
                                <option value="@v.Id">@v.Name (@v.Application)</option>
                            }
                        </select>
                    </SelectBox>
                    <span class="field__hint">
                        Shown as a badge on the browser card and detail page so users can
                        tell at a glance whether this recipe targets their runtime.
                    </span>
                    <FieldError Field="MinimumApplicationVersionId" Errors="_errors" />
                </div>

                <div class="field field--full">
                    <label class="field__label" for="recipe-instructions">Instructions (Markdown)</label>
                    <textarea class="textarea" id="recipe-instructions" rows="6" maxlength="10000"
                              @bind="_instructions" @bind:event="oninput"
                              placeholder="Optional setup notes. Markdown is rendered on the public detail page (headings, lists, code fences, links)."></textarea>
                    <FieldError Field="Instructions" Errors="_errors" />
                </div>
            </div>
                <label class="check @(_deprecated ? "is-checked" : "")">
                    <input type="checkbox" @bind="_deprecated" />
                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                    <span>Deprecated - hidden from the cookbook your team browses</span>
                </label>
            </div>
        </section>

        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Files</h2>
                    <p class="card__sub">Each file becomes one AL object.</p>
                </div>
            </div>
            <div class="card__body form-sec">
                <p class="form-sec__cap">
                    Set <strong>Folder</strong> to put a file inside a directory when
                    the recipe is downloaded - leave it blank for files at the top.
                </p>
                <RecipeFileEditor Files="_files" Errors="_errors" />
            </div>
        </section>
        </div>

        @if (IsEdit)
        {
            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Where this recipe has been used</h2>
                        <p class="card__sub">
                            Downloads, copies and repositories are all recorded, so a bug found
                            here can be traced to who has it. A blank customer means the person
                            had none to give, not that the use went unrecorded.
                        </p>
                    </div>
                </div>
                @if (_downloads is null)
                {
                    <div class="loading-block">
                        <span class="spinner"></span><span>Loading...</span>
                    </div>
                }
                else if (_downloads.Count == 0)
                {
                    <div class="empty-state empty-state--quiet">
                        <span class="empty-state__title">Not used yet</span>
                        <span class="empty-state__text">Uses show up here as people take it.</span>
                    </div>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr><th>Customer</th><th>How</th><th>Repository</th><th>By</th><th>When</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _downloads)
                            {
                                <tr>
                                    <td>
                                        @if (string.IsNullOrEmpty(d.CustomerName))
                                        {
                                            <span class="u-muted">Not recorded</span>
                                        }
                                        else if (d.Project is { } project)
                                        {
                                            @* The name matched one of the org's solutions when the
                                               recipe was taken, so this row points at a real row
                                               rather than a string. See issue #541. *@
                                            <a href="/solutions/@project.Id">@d.CustomerName</a>
                                        }
                                        else
                                        {
                                            @d.CustomerName
                                        }
                                    </td>
                                    <td>@DescribeUse(d.Source)</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(d.Repository))
                                        {
                                            <span class="u-muted">—</span>
                                        }
                                        else
                                        {
                                            <a href="@($"https://github.com/{d.Repository}")"
                                               target="_blank" rel="noopener">@d.Repository</a>
                                        }
                                    </td>
                                    <td>@(d.DownloadedByUser?.Email ?? "—")</td>
                                    <td><Timestamp Value="@d.DownloadedAt" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            @* The card that turns the history above into an action (issue #626).
               It appears only when it can act - the recipe has landed in at
               least one repository, and this admin's own GitHub account is
               connected - because a button that would only ever refuse is worse
               than no button. Named user: an admin who has just fixed a bug in
               this recipe and wants the fix everywhere it went. *@
            @if (_appliedRepositories is { Count: > 0 } applied)
            {
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Update the repositories that use this recipe</h2>
                            <p class="card__sub">
                                Each of these opens a pull request with the recipe as it stands now,
                                in your name - nothing changes in a repository until somebody there
                                merges it.
                            </p>
                        </div>
                        @if (_repoReady)
                        {
                            <button type="button" class="btn btn--sm"
                                    disabled="@(_updatingAll || IsDirty)"
                                    title="@(IsDirty ? "Save your changes to enable" : null)"
                                    @onclick="ConfirmUpdateAllAsync">
                                <Icon Name="git-branch" Width="14" Height="14" />
                                <span>@(_updatingAll ? "Opening pull requests..." : "Open a pull request in each")</span>
                            </button>
                        }
                    </div>
                    @if (!_repoReady)
                    {
                        <div class="card__body">
                            <p class="u-muted">
                                Connect your GitHub account on your account page to open pull requests from here.
                            </p>
                        </div>
                    }
                    <table class="data-table">
                        <thead>
                            <tr><th>Repository</th><th>Result</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var repo in applied)
                            {
                                <tr>
                                    <td>
                                        <a href="@($"https://github.com/{repo}")" target="_blank" rel="noopener">@repo</a>
                                    </td>
                                    <td>
                                        @if (_updateOutcomes.TryGetValue(repo, out var outcome))
                                        {
                                            @if (outcome.PullRequestUrl is { } url)
                                            {
                                                <a href="@url" target="_blank" rel="noopener">@outcome.Message</a>
                                            }
                                            else
                                            {
                                                <FieldError Message="@outcome.Message" />
                                            }
                                        }
                                        else if (_updatingRepository == repo)
                                        {
                                            <span class="u-muted">Opening pull request...</span>
                                        }
                                        else
                                        {
                                            <span class="u-muted">No update sent</span>
                                        }
                                    </td>
                                    <td class="data-table__actions">
                                        @if (_repoReady)
                                        {
                                            <button type="button" class="btn btn--sm"
                                                    disabled="@(_updatingAll || _updatingRepository is not null || IsDirty)"
                                                    title="@(IsDirty ? "Save your changes to enable" : null)"
                                                    @onclick="() => UpdateRepositoryAsync(repo)">
                                                Open pull request
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }
        }

        @if (_okMessage is not null)
        {
            <Alert Tone="AlertTone.Success">
                <span>@_okMessage</span>
            </Alert>
        }

        @if (_lastError is not null)
        {
            <Alert Tone="AlertTone.Danger">
                <span>@_lastError</span>
            </Alert>
        }
    }
</div>

<ConfirmDialog @ref="_confirmUpdateAll" />

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsEdit => Id is not null;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string _keywords = string.Empty;
    private RecipeType _type = RecipeType.Snippet;
    private bool _deprecated;
    private string _instructions = string.Empty;
    private string _minimumApplicationVersionId = string.Empty;
    private decimal? _estimatedValueHours;
    private List<RecipeDownload>? _downloads;
    private List<ApplicationVersion> _applicationVersions = new();
    private List<RecipeFileEditor.EditableFile> _files = new() { new RecipeFileEditor.EditableFile() };
    private IReadOnlyDictionary<string, string>? _errors;
    private string? _lastError;
    private string? _okMessage;
    private bool _busy;
    private bool _loadFailed;

    // The repositories this recipe has been applied to, and what happened the
    // last time each was asked for an update (issue #626).
    private List<string>? _appliedRepositories;
    private readonly Dictionary<string, UpdateOutcome> _updateOutcomes = new(StringComparer.OrdinalIgnoreCase);
    private bool _repoReady;
    private bool _updatingAll;
    private string? _updatingRepository;
    private ConfirmDialog? _confirmUpdateAll;

    // What was loaded, so the card can refuse to send a pull request that would
    // carry the recipe as it is saved rather than as it is on screen.
    private string _loadedSnapshot = string.Empty;

    private string Snapshot() => string.Join("", new[]
    {
        _title, _description, _keywords, _type.ToString(), _deprecated ? "1" : "0",
        _instructions, _minimumApplicationVersionId, _estimatedValueHours?.ToString() ?? "",
    }.Concat(_files.Select(f => $"{f.RelativePath}/{f.FileName}{f.Content}")));

    /// <summary>True while the form holds edits the repositories would not get.</summary>
    private bool IsDirty => Snapshot() != _loadedSnapshot;

    /// <summary>One repository's result: the words to show, and a link when there is a pull request.</summary>
    private sealed record UpdateOutcome(string Message, string? PullRequestUrl);

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>
    /// Fills the form from the stored recipe and takes the snapshot the dirty
    /// check compares against. Called again after a save, so the page a person
    /// stays on is the recipe as it now is.
    /// </summary>
    private async Task LoadAsync()
    {
        _applicationVersions = await ApplicationVersions.GetActiveAsync();
        if (Id is null) return;
        var existing = await Recipes.GetAsync(Id.Value);
        if (existing is null)
        {
            _loadFailed = true;
            return;
        }
        _title = existing.Title;
        _description = existing.Description;
        _keywords = existing.Keywords;
        _type = existing.Type;
        _deprecated = existing.Deprecated;
        _instructions = existing.Instructions ?? string.Empty;
        _minimumApplicationVersionId = existing.MinimumApplicationVersionId?.ToString() ?? string.Empty;
        _estimatedValueHours = existing.EstimatedValueHours;
        _downloads = await Recipes.GetDownloadsAsync(Id.Value);
        _appliedRepositories = await Recipes.GetAppliedRepositoriesAsync(Id.Value);
        // Answered from the database alone, so the card decides whether to
        // appear without waiting on GitHub.
        _repoReady = (await Repositories.GetAccessAsync()).IsReady;
        // If the recipe points at a deprecated or soft-deleted catalogue row
        // the active-only list wouldn't include it; surface the existing
        // navigation entity as a synthetic option so the dropdown stays
        // consistent with what's persisted.
        if (existing.MinimumApplicationVersion is { } current
            && !_applicationVersions.Any(v => v.Id == current.Id))
        {
            _applicationVersions = _applicationVersions.Append(current).ToList();
        }
        _files = existing.Files
            .OrderBy(f => f.Ordering)
            .Select(f => new RecipeFileEditor.EditableFile
            {
                RelativePath = f.RelativePath,
                FileName = f.FileName,
                Content = f.Content,
            })
            .ToList();
        if (_files.Count == 0)
        {
            _files.Add(new RecipeFileEditor.EditableFile());
        }
        _loadedSnapshot = Snapshot();
    }

    /// <summary>How a use is described in the history table.</summary>
    private static string DescribeUse(RecipeUseSource source) => source switch
    {
        RecipeUseSource.Copy => "Copied",
        RecipeUseSource.Repository => "Pull request",
        _ => "Downloaded",
    };

    /// <summary>
    /// Asks first: every repository on the list gets a pull request, and each
    /// one notifies the people watching it - a click that reaches other teams
    /// is worth a confirmation.
    /// </summary>
    private async Task ConfirmUpdateAllAsync()
    {
        if (_updatingAll || IsDirty || _confirmUpdateAll is null) return;
        var count = _appliedRepositories?.Count ?? 0;
        if (count == 0) return;
        var confirmed = await _confirmUpdateAll.OpenAsync(
            "Open a pull request in each repository?",
            $"Open a pull request in all {count} repositories? Each one notifies whoever watches that repository.",
            "Open pull requests",
            "btn--primary",
            "git-branch");
        if (confirmed) await UpdateAllRepositoriesAsync();
    }

    private async Task UpdateAllRepositoriesAsync()
    {
        if (_updatingAll) return;
        _updatingAll = true;
        try
        {
            foreach (var repo in _appliedRepositories ?? [])
            {
                await ApplyToAsync(repo);
                StateHasChanged();
            }
        }
        finally
        {
            _updatingAll = false;
        }
    }

    private async Task UpdateRepositoryAsync(string repository)
    {
        if (_updatingRepository is not null || _updatingAll) return;
        _updatingRepository = repository;
        try
        {
            await ApplyToAsync(repository);
        }
        finally
        {
            _updatingRepository = null;
        }
    }

    /// <summary>
    /// One repository's turn. Every failure is recorded rather than thrown, so
    /// the caller above can keep going and each row says for itself what
    /// happened.
    /// </summary>
    private async Task ApplyToAsync(string repository)
    {
        if (Id is null) return;
        try
        {
            var delivery = await RecipeDelivery.ApplyAsync(Id.Value, repository);
            _updateOutcomes[repository] = new UpdateOutcome(
                delivery.IsNewPullRequest
                    ? $"Pull request #{delivery.PullRequest.Number} opened"
                    : $"Added to pull request #{delivery.PullRequest.Number}",
                delivery.PullRequest.HtmlUrl);
        }
        catch (PlanValidationException ex)
        {
            _updateOutcomes[repository] = new UpdateOutcome(string.Join(" ", ex.Errors.Values), null);
        }
        catch (GitHubApiException ex)
        {
            Log.LogWarning(ex, "GitHub refused the update pull request on {RepoFullName}.", repository);
            _updateOutcomes[repository] = new UpdateOutcome($"GitHub would not do that: {ex.Message}", null);
        }
        catch (Exception ex) when (ex is GitHubAppNotConfiguredException or HttpRequestException or TaskCanceledException)
        {
            Log.LogWarning(ex, "Could not reach GitHub to update {RepoFullName}.", repository);
            _updateOutcomes[repository] = new UpdateOutcome(
                "The workbench could not reach GitHub just now, so nothing was committed. Try again in a minute.", null);
        }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        _errors = null;
        _lastError = null;
        _okMessage = null;
        try
        {
            var input = new RecipeInput(
                _title,
                _description,
                _keywords,
                _type,
                _deprecated,
                _files.Select(f => new RecipeFileInput(f.FileName, f.Content, f.RelativePath)).ToList(),
                Instructions: _instructions,
                MinimumApplicationVersionId: int.TryParse(_minimumApplicationVersionId, out var avId) ? avId : null,
                EstimatedValueHours: _estimatedValueHours);
            if (Id is null)
            {
                var created = await Recipes.CreateAsync(input);
                Nav.NavigateTo($"/admin/cookbook/{created.Id}");
            }
            else
            {
                await Recipes.UpdateAsync(Id.Value, input);
                // Stay here. The card below only offers to open pull requests
                // once the form is saved, and navigating away the moment it is
                // meant the person could never act on that.
                await LoadAsync();
                _okMessage = "Saved.";
            }
        }
        catch (PlanValidationException ex)
        {
            _errors = ex.Errors;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save recipe.");
            _lastError = "An unexpected error occurred. The recipe was not saved.";
        }
        finally
        {
            _busy = false;
        }
    }
}
