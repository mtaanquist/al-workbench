@page "/admin/object-explorer/new/cal"
@attribute [Authorize(Roles = "Admin,Editor")]
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor Http
@using Microsoft.AspNetCore.Antiforgery

@*
    C/AL tab of the Import Release page. Statically rendered; posts the classic
    NAV "Export Objects to text" dump to the shared /admin/object-explorer/import
    endpoint, which dispatches to the C/AL ingest (Services/Cal/) on the presence
    of CalTxtFile and always stamps kind='cal' server-side. Deliberately minimal:
    a C/AL export is a self-contained snapshot, so there's no Kind, Publisher, or
    Parent Release here - just a label, the file, and the codepage. Comparing a
    customer export against the standard objects = import both files as two C/AL
    releases and use Compare.
*@

<PageTitle>Import Release · C/AL · Admin · AL Workbench</PageTitle>

<div class="page">
    <AdminReleasesImportHeader ActiveTab="AdminReleasesImportHeader.Tab.Cal" />

    @if (_errorMessage is not null)
    {
        <Alert Tone="AlertTone.Danger">
            <span>@_errorMessage</span>
        </Alert>
    }

    @* No layout class on the form: .form-sec siblings separate themselves with
       their own padding and top border. *@
    <form method="post"
          action="/admin/object-explorer/import"
          enctype="multipart/form-data"
          data-oe-import-form>
        @if (_antiforgeryToken is not null)
        {
            <input type="hidden" name="@_antiforgeryToken.FormFieldName" value="@_antiforgeryToken.RequestToken" />
        }

        <ImportProgressBanner />

        <ReleaseImportMetadataFields FixedKind="cal"
                                     ShowParent="false"
                                     ShowPublisher="false"
                                     LabelPlaceholder="e.g. CRONUS objects 2016"
                                     LabelGoodExample="CRONUS objects 2016"
                                     LabelBadExample="export_final_v3" />

        <section class="form-sec">
            <label class="field">
                <span class="field__label">Legacy C/AL TXT export</span>
                <input type="file" name="CalTxtFile" accept=".txt" required
                       class="input input--file" />
                <small class="field__hint">
                    A classic NAV <em>Export Objects to text</em> file. Up to
                    1 GB. To compare a customer's objects against the standard,
                    import both exports and open Compare from either one.
                </small>
            </label>

            <label class="field">
                <span class="field__label">C/AL codepage</span>
                <SelectBox>
                    <select name="CalEncoding" class="select">
                        <option value="850" selected>IBM 850 (OEM - classic NAV default)</option>
                        <option value="1252">Windows-1252</option>
                    </select>
                </SelectBox>
                <small class="field__hint">
                    The classic Windows client exports in the OEM codepage (850 for
                    Western Europe); pick 1252 if accented characters look wrong
                    after import.
                </small>
            </label>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary" data-oe-import-submit>
                <Icon Name="file-code" Width="16" Height="16" />
                <span>Import Release</span>
            </button>
        </div>
    </form>
</div>

@code {
    private AntiforgeryTokenSet? _antiforgeryToken;
    private string? _errorMessage;

    protected override Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is not null)
        {
            _antiforgeryToken = Antiforgery.GetAndStoreTokens(ctx);
            var err = ctx.Request.Query["err"].ToString();
            var msg = ctx.Request.Query["msg"].ToString();
            if (!string.IsNullOrEmpty(err) && !string.IsNullOrEmpty(msg))
            {
                _errorMessage = msg;
            }
        }
        return Task.CompletedTask;
    }
}
