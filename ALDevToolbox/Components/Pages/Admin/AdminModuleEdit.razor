@page "/admin/modules/new"
@page "/admin/modules/{Key}"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject ModuleService Modules
@inject CatalogService Catalog
@inject NavigationManager Nav
@inject ILogger<AdminModuleEdit> Log
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Templates

@*
    Combined create/edit page for modules. Dependency rows are reordered with
    Up/Down buttons (no drag-and-drop in v1, matching AdminTemplateEdit).
*@

<PageTitle>@PageTitleText · Admin · AL Workbench</PageTitle>

<EditPage Title="@PageTitleText"
          IsLoading="@(!(IsEdit && _loadFailed) && _form is null)"
          IsNotFound="@(IsEdit && _loadFailed)" Sticky="true"
          Trail='@([new("Admin", "/admin"), new("Modules", "/admin/modules"), new(PageTitleText)])'>
    <SubtitleContent>
        @if (IsEdit)
        {
            <span>Editing module <code class="code">@Key</code>. Changes apply the next time someone generates a workspace.</span>
        }
        else
        {
            <span>Create a new module. Dependencies and the optional ID range size override can be edited later.</span>
        }
    </SubtitleContent>
    <Actions>
        <button type="button" class="btn btn--sm btn--primary"
                @onclick="SaveAsync"
                disabled="@(_saving || _form is null || _loadFailed)">
            <Icon Name="save" Width="14" Height="14" />
            <span>@(_saving ? "Saving..." : (IsEdit ? "Save changes" : "Create module"))</span>
        </button>
    </Actions>
    <NotFound>
        <Alert Tone="AlertTone.Danger">
            <span>
                No module with key <code class="code">@Key</code> was found. It may have been
                renamed or permanently removed.
            </span>
        </Alert>
    </NotFound>
    <ChildContent>
        @if (_isDeleted)
        {
            <Alert Tone="AlertTone.Warn">
                <span>
                    This module is deleted. Restore it from the
                    <a href="/admin/modules">Modules list</a> to bring it back to the picker.
                </span>
            </Alert>
        }
        @if (_saveError is not null)
        {
            <Alert Tone="AlertTone.Danger">
                <span>@_saveError</span>
            </Alert>
        }
        @if (_saveSuccess is not null)
        {
            <Alert Tone="AlertTone.Success">
                <span>@_saveSuccess</span>
            </Alert>
        }

        <form class="edit-col" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <section class="card">
                <div class="card__head"><h2 class="card__title">Module</h2></div>
                <div class="card__body form-sec">
                    <div class="form-grid">
                        <div class="field">
                            <label class="field__label" for="mod-key">Key</label>
                            <input class="input" id="mod-key" type="text" @bind="_form!.Key" @bind:event="oninput"
                                   readonly="@IsEdit" pattern="[a-z0-9-]+" required
                                   placeholder="e.g. document-capture" />
                            <span class="field__hint">
                                @(IsEdit ? "The key is fixed once a module is created." : "Lowercase letters, digits, hyphens. Used in admin URLs.")
                            </span>
                            <FieldError Field="Key" Errors="_fieldErrors" />
                        </div>

                        <div class="field">
                            <label class="field__label" for="mod-name">Name</label>
                            <input class="input" id="mod-name" type="text" required
                                   @bind="_form!.Name" @bind:event="oninput"
                                   placeholder="e.g. Document Capture" />
                            <span class="field__hint">Display name shown to users in the module picker.</span>
                            <FieldError Field="Name" Errors="_fieldErrors" />
                        </div>

                        <div class="field">
                            <label class="field__label" for="mod-ext-name">Extension name</label>
                            <input class="input" id="mod-ext-name" type="text" required
                                   pattern="[A-Z][A-Za-z0-9]*"
                                   @bind="_form!.ExtensionName" @bind:event="oninput"
                                   placeholder="e.g. DocumentCapture" />
                            <span class="field__hint">
                                PascalCase. Used as the folder name in the generated
                                workspace and as the AL extension name. Letters and
                                digits only; start with an uppercase letter.
                            </span>
                            <FieldError Field="ExtensionName" Errors="_fieldErrors" />
                        </div>

                        <div class="field">
                            <label class="field__label" for="mod-id-range-size">ID range size override</label>
                            <input class="input" id="mod-id-range-size" type="number" min="1"
                                   @bind="_form!.IdRangeSize" @bind:event="oninput"
                                   placeholder="(inherit from template)" />
                            <span class="field__hint">
                                Optional. Leave blank and this module takes the size
                                set on the template it is generated with.
                            </span>
                            <FieldError Field="IdRangeSize" Errors="_fieldErrors" />
                        </div>
                    </div>

                    <label class="check @(_form!.Deprecated ? "is-checked" : "")">
                        <input type="checkbox" @bind="_form!.Deprecated" />
                        <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                        <span>Deprecated - hide from the user-facing module picker but keep available for admin regeneration.</span>
                    </label>
                </div>
            </section>

            <section class="card">
                <div class="card__head"><h2 class="card__title">Dependencies</h2></div>
                <div class="card__body form-sec">
                @{
                    var unusedCatalog = _catalog
                        .Where(c => !_form.Dependencies.Any(d => string.Equals(d.DepId, c.DepId, StringComparison.OrdinalIgnoreCase)))
                        .OrderBy(c => c.Category ?? string.Empty, StringComparer.Ordinal)
                        .ThenBy(c => c.DepName)
                        .ToList();
                }
                @if (_catalog.Count == 0)
                {
                    <EmptyState Icon="book-open" Title="Nothing to depend on yet">
                        <Text>
                            Module dependencies are picked from the shared catalogue,
                            and it's empty. Add the apps your team depends on first.
                        </Text>
                        <Action>
                            <a class="btn" href="/admin/catalog">
                                <Icon Name="book-open" Width="14" Height="14" />
                                <span>Open the catalogue</span>
                            </a>
                        </Action>
                    </EmptyState>
                }
                else
                {
                    <p class="form-sec__cap">
                        Each dependency becomes a row in the module's generated
                        <code class="code">app.json</code> in the order shown. The name and
                        publisher are copied from the catalogue when you add the row, so
                        editing the catalogue later won't change modules already built.
                        The version is yours to set per module.
                    </p>

                    <div class="sub-rows sub-rows--reorder">
                        <div class="sub-rows__head">
                            <span><span class="u-sr">Reorder</span></span>
                            <span>Dependency</span>
                            <span>Id</span>
                            <span>Version</span>
                            <span><span class="u-sr">Actions</span></span>
                        </div>
                        @if (_form!.Dependencies.Count == 0)
                        {
                            <p class="sub-rows__empty">
                                No dependencies yet. Pick one below to add it.
                            </p>
                        }
                        else
                        {
                            @for (var i = 0; i < _form!.Dependencies.Count; i++)
                            {
                                var index = i;
                                var row = _form!.Dependencies[index];
                                var offCatalogue = !_catalog.Any(c => string.Equals(c.DepId, row.DepId, StringComparison.OrdinalIgnoreCase));
                                <div class="sub-row">
                                    <span class="sub-row__move">
                                        <button type="button" class="btn btn--sm" disabled="@(index == 0)"
                                                @onclick="() => MoveDependency(index, -1)" title="Move up">
                                            <Icon Name="arrow-up" Width="12" Height="12" />
                                        </button>
                                        <button type="button" class="btn btn--sm" disabled="@(index == _form!.Dependencies.Count - 1)"
                                                @onclick="() => MoveDependency(index, 1)" title="Move down">
                                            <Icon Name="arrow-down" Width="12" Height="12" />
                                        </button>
                                    </span>
                                    <span class="sub-row__stack">
                                        <span class="sub-row__name">@row.DepName</span>
                                        @* Flex with a gap, not text-then-element: Razor strips the
                                           whitespace between an interpolation and an @if, so the
                                           publisher ran straight into the tag. A gap cannot be
                                           swallowed. *@
                                        <span class="field__hint u-row">
                                            <span>@row.DepPublisher</span>
                                            @if (offCatalogue)
                                            {
                                                <span class="tag" title="Remove it and pick a catalogue entry to replace it.">Not in catalogue</span>
                                            }
                                        </span>
                                    </span>
                                    <span class="sub-row__stack">
                                        <span class="sub-row__val" title="@row.DepId">@row.DepId</span>
                                        <FieldError Field="@($"Dependencies[{index}].DepId")" Errors="_fieldErrors" />
                                    </span>
                                    <span class="sub-row__stack">
                                        <input class="input" type="text" required placeholder="e.g. 1.0.0.0"
                                               aria-label="@($"Version of {row.DepName}")"
                                               @bind="row.DepVersion" @bind:event="oninput" />
                                        <FieldError Field="@($"Dependencies[{index}].DepVersion")" Errors="_fieldErrors" />
                                    </span>
                                    <span class="sub-row__acts">
                                        <button type="button" class="btn btn--sm btn--icon" @onclick="() => RemoveDependency(index)"
                                                title="@($"Remove {row.DepName}")">
                                            <Icon Name="trash-2" Width="12" Height="12" />
                                        </button>
                                    </span>
                                </div>
                            }
                        }
                        <div class="sub-rows__foot">
                            <label class="u-sr" for="mod-dep-picker">Catalogue entry to add</label>
                            <SelectBox>
                                <select class="select" id="mod-dep-picker" @bind="_pickerDepId" disabled="@(unusedCatalog.Count == 0)">
                                    <option value="">
                                        @(unusedCatalog.Count == 0 ? "All catalogue entries are already in this module." : "Pick a catalogue entry...")
                                    </option>
                                    @foreach (var group in unusedCatalog
                                        .GroupBy(c => string.IsNullOrWhiteSpace(c.Category) ? "Other" : c.Category!)
                                        .OrderBy(g => g.Key, StringComparer.Ordinal))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var item in group)
                                            {
                                                <option value="@item.DepId">@item.DepName · @item.DepPublisher</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </SelectBox>
                            <button type="button" class="btn btn--sm"
                                    disabled="@(string.IsNullOrEmpty(_pickerDepId))"
                                    @onclick="AddFromCatalogue">
                                <Icon Name="plus" Width="14" Height="14" />
                                <span>Add</span>
                            </button>
                        </div>
                    </div>
                }
                </div>
            </section>

            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Folder structure</h2>
                        <p class="card__sub">
                            Folders and files generated inside this module's extension
                            whenever a workspace includes it.
                        </p>
                    </div>
                    <button type="button" class="btn btn--sm" @onclick="AddRootFolder">
                        <Icon Name="folder-plus" Width="14" Height="14" />
                        <span>Add folder</span>
                    </button>
                </div>
                <div class="card__body form-sec">
                    <MustacheVarsHint />
                    @if (_form!.Folders.Count == 0)
                    {
                        <EmptyState Title="No folders yet" Quiet="true">
                            <Text>
                                Add one (for example <code class="code">src</code>) to give this
                                module a starting layout. Leaving it empty is fine too.
                            </Text>
                        </EmptyState>
                    }
                    else
                    {
                        <div class="folder-editor__list">
                            @for (var f = 0; f < _form!.Folders.Count; f++)
                            {
                                var folderIndex = f;
                                var folder = _form!.Folders[folderIndex];
                                <RecursiveFolderEditor Folder="folder"
                                                       Index="folderIndex"
                                                       SiblingCount="_form!.Folders.Count"
                                                       Depth="0"
                                                       FieldKeyPrefix="@($"Folders[{folderIndex}]")"
                                                       Errors="_fieldErrors"
                                                       OnMove="d => MoveRootFolder(folderIndex, d)"
                                                       OnRemove="() => RemoveRootFolder(folderIndex)" />
                            }
                        </div>
                    }
                </div>
            </section>

            @* Hidden submit so pressing Enter inside an input still triggers
               SaveAsync - the visible Save button moved to the header. *@
            <button type="submit" class="u-sr" aria-hidden="true" tabindex="-1">Save</button>
        </form>
    </ChildContent>
    <History>
        @if (_form is not null && IsEdit && _existingId is not null)
        {
            <AuditHistoryPanel EntityType="AuditEntityType.Module" EntityId="_existingId.Value" Title="Module history" />
        }
    </History>
</EditPage>

@code {
    [Parameter] public string? Key { get; set; }

    private bool IsEdit => !string.IsNullOrEmpty(Key);
    private string PageTitleText => IsEdit ? "Edit module" : "New module";

    private FormState? _form;
    private int? _existingId;
    private bool _isDeleted;
    private bool _loadFailed;
    private bool _saving;
    private string? _saveError;
    private string? _saveSuccess;
    private IReadOnlyDictionary<string, string> _fieldErrors = new Dictionary<string, string>();
    private List<WellKnownDependency> _catalog = new();
    private string _pickerDepId = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _saveError = null;
        _saveSuccess = null;
        _fieldErrors = new Dictionary<string, string>();
        _pickerDepId = string.Empty;
        _catalog = await Catalog.GetAllAsync();

        if (!IsEdit)
        {
            _form ??= FormState.Blank();
            _existingId = null;
            _isDeleted = false;
            _loadFailed = false;
            return;
        }

        var existing = await Modules.GetByKeyAsync(Key!);
        if (existing is null)
        {
            _loadFailed = true;
            _form = null;
            return;
        }

        _loadFailed = false;
        _existingId = existing.Id;
        _isDeleted = existing.DeletedAt is not null;
        _form = FormState.From(existing);
    }

    private void AddFromCatalogue()
    {
        if (_form is null || string.IsNullOrEmpty(_pickerDepId)) return;
        var entry = _catalog.FirstOrDefault(c =>
            string.Equals(c.DepId, _pickerDepId, StringComparison.OrdinalIgnoreCase));
        if (entry is null) return;
        if (_form.Dependencies.Any(d => string.Equals(d.DepId, entry.DepId, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }
        _form.Dependencies.Add(new DependencyRow
        {
            DepId = entry.DepId,
            DepName = entry.DepName,
            DepPublisher = entry.DepPublisher,
            DepVersion = entry.DepVersionDefault,
        });
        _pickerDepId = string.Empty;
    }

    private void RemoveDependency(int index)
    {
        if (_form is null) return;
        if (index >= 0 && index < _form.Dependencies.Count)
        {
            _form.Dependencies.RemoveAt(index);
        }
    }

    private void MoveDependency(int index, int delta)
    {
        if (_form is null) return;
        var target = index + delta;
        if (index < 0 || index >= _form.Dependencies.Count || target < 0 || target >= _form.Dependencies.Count)
        {
            return;
        }
        (_form.Dependencies[index], _form.Dependencies[target]) =
            (_form.Dependencies[target], _form.Dependencies[index]);
    }

    // Top-level folder handlers. RecursiveFolderEditor owns nested operations
    // and files; these only manage the module's root folder list, mirroring
    // TemplateExtensionsEditor.
    private void AddRootFolder()
    {
        _form?.Folders.Add(new TemplateFolderForm());
    }

    private void RemoveRootFolder(int index)
    {
        if (_form is null) return;
        if (index >= 0 && index < _form.Folders.Count) _form.Folders.RemoveAt(index);
    }

    private void MoveRootFolder(int index, int delta)
    {
        if (_form is null) return;
        var target = index + delta;
        if (index < 0 || index >= _form.Folders.Count || target < 0 || target >= _form.Folders.Count)
        {
            return;
        }
        (_form.Folders[index], _form.Folders[target]) = (_form.Folders[target], _form.Folders[index]);
    }

    private async Task SaveAsync()
    {
        if (_form is null || _saving) return;
        _saving = true;
        _saveError = null;
        _saveSuccess = null;
        _fieldErrors = new Dictionary<string, string>();

        var payload = _form.ToInput();

        try
        {
            if (IsEdit && _existingId is not null)
            {
                await Modules.UpdateAsync(_existingId.Value, payload);
                _saveSuccess = "Saved.";
            }
            else
            {
                await Modules.CreateAsync(payload);
                // Land back on the list so admins can see the new row in
                // context. Editing it further is one click away.
                Nav.NavigateTo("/admin/modules");
                return;
            }
        }
        catch (PlanValidationException ex)
        {
            _fieldErrors = ex.Errors;
            _saveError = $"Couldn't save: {ex.Errors.Count} validation error(s). See messages next to each field.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Unexpected error saving module '{Key}'.", payload.Key);
            _saveError = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Mutable form-state mirror of <see cref="ModuleInput"/>. Lives in the
    /// page so Razor's <c>@bind</c> can write into individual fields without
    /// the per-keystroke record allocations a record-based form would need.
    /// </summary>
    private sealed class FormState
    {
        public string Key { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string ExtensionName { get; set; } = string.Empty;
        public int? IdRangeSize { get; set; }
        public bool Deprecated { get; set; }
        public List<DependencyRow> Dependencies { get; } = new();

        /// <summary>
        /// Recursive folder/file tree for the module's generated extension.
        /// Reuses the shared <see cref="TemplateFolderForm"/> the template
        /// editor binds against, so <c>RecursiveFolderEditor</c> drives both.
        /// </summary>
        public List<TemplateFolderForm> Folders { get; } = new();

        public static FormState Blank() => new();

        public static FormState From(Module module)
        {
            var state = new FormState
            {
                Key = module.Key,
                Name = module.Name,
                ExtensionName = module.ExtensionName,
                IdRangeSize = module.IdRangeSize,
                Deprecated = module.Deprecated,
            };
            foreach (var d in module.Dependencies.OrderBy(d => d.Ordering))
            {
                state.Dependencies.Add(new DependencyRow
                {
                    DepId = d.DepId,
                    DepName = d.DepName,
                    DepPublisher = d.DepPublisher,
                    DepVersion = d.DepVersion,
                });
            }
            foreach (var folder in module.ExtensionFolders.OrderBy(f => f.Ordering))
            {
                state.Folders.Add(TemplateFolderForm.From(ModuleAuthoringMapper.BuildFolderAuthoring(folder)));
            }
            return state;
        }

        public ModuleInput ToInput() => new(
            Key: Key,
            Name: Name,
            ExtensionName: ExtensionName,
            IdRangeSize: IdRangeSize,
            Deprecated: Deprecated,
            Dependencies: Dependencies
                .Select(d => new ModuleDependencyInput(d.DepId, d.DepName, d.DepPublisher, d.DepVersion))
                .ToList(),
            Folders: Folders.Select(f => f.ToAuthoring()).ToList());
    }

    private sealed class DependencyRow
    {
        public string DepId { get; set; } = string.Empty;
        public string DepName { get; set; } = string.Empty;
        public string DepPublisher { get; set; } = string.Empty;
        public string DepVersion { get; set; } = string.Empty;
    }
}
