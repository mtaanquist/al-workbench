@page "/admin/translation-memory"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@implements IDisposable
@using ALDevToolbox.Services.Translation
@using ALDevToolbox.Services.GitHub
@inject TranslationMemoryService Memory
@inject TranslationMemoryIngestService Ingest
@inject GitHubRepositoryService Repositories
@inject ILogger<AdminTranslationMemory> Log

@*
    Curate the org's translation memory: browse / search, vote good pairs up and
    bad ones down (which re-ranks suggestions), and soft-delete bad entries
    (recoverable via the "include removed" toggle). See the Translator curation
    feature.
*@

<PageTitle>Translation memory · Admin · AL Workbench</PageTitle>

<ListPage Title="Translation memory" ShowActions="true" FiltersWhenEmpty="true"
          IsLoading="@(_result is null)"
          IsEmpty="@(_result is not null && _result.Items.Count == 0 && !HasFilters)"
          HasNoMatches="@(_result is not null && _result.Items.Count == 0)" Sticky="true"
          Trail='@([new("Admin", "/admin"), new("Translation memory")])'>
    <SubtitleContent>
        Every source→target pair your organisation has learned (from Object Explorer imports,
        the Translator, imported XLIFF files, and the translation files in your own repositories).
        Vote good translations up and bad ones down to steer suggestion ranking, or remove a bad
        pair so it stops being suggested. Removals are recoverable.
    </SubtitleContent>
    <Actions>
        @if (_canRefreshFromRepositories)
        {
            <button type="button" class="btn btn--sm" disabled="@_refreshing" @onclick="RefreshFromRepositoriesAsync">
                @if (_refreshing)
                {
                    <span class="spinner"></span>
                    <span>Reading your repositories...</span>
                }
                else
                {
                    <Icon Name="refresh-cw" Width="14" Height="14" />
                    <span>Read from repositories</span>
                }
            </button>
        }
        <a class="btn btn--sm" href="/admin/translation-memory/import">
            <Icon Name="upload" Width="14" Height="14" />
            <span>Import XLIFF</span>
        </a>
    </Actions>
    <Notices>
        @if (_refreshMessage is not null)
        {
            <Alert Tone="@(_refreshFailed ? AlertTone.Warn : AlertTone.Success)" Role="status" Class="tr-mem-refresh">
                <span>@_refreshMessage</span>
                <button type="button" class="btn btn--sm btn--ghost tr-mem-refresh__dismiss"
                        aria-label="Dismiss" @onclick="() => _refreshMessage = null">
                    <Icon Name="x" Width="14" Height="14" />
                </button>
            </Alert>
        }

        <form class="filter-bar tr-mem-filters" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
            <input class="input filter-bar__search" aria-label="Search source or target" placeholder="Search source or target..."
                   data-page-search aria-keyshortcuts="F3" title="Search source or target (F3)" @bind="_text" @bind:event="oninput" />
            <input class="input tr-mem-mini" aria-label="Target language" placeholder="Target lang (e.g. da-DK)" @bind="_targetLang" @bind:event="oninput" />
            <SelectBox>
                <select class="select tr-mem-mini" aria-label="Kind" @bind="_kind">
                    <option value="">All kinds</option>
                    <option value="caption">Caption</option>
                    <option value="tooltip">Tooltip</option>
                    <option value="label">Label</option>
                    <option value="option">Option</option>
                    <option value="instructional">Instructional</option>
                    <option value="other">Other</option>
                </select>
            </SelectBox>
            <input class="input tr-mem-mini" aria-label="Origin" placeholder="Origin contains..." @bind="_origin" @bind:event="oninput" />
            <label class="check tr-mem-incl @(_includeDeleted ? "is-checked" : "")">
                <input type="checkbox" @bind="_includeDeleted" />
                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                <span>Include removed</span>
            </label>
            <button type="submit" class="btn btn--sm btn--primary">
                <Icon Name="search" Width="14" Height="14" /><span>Search</span>
            </button>
        </form>

        @if (_loadError is not null)
        {
            <Alert Tone="AlertTone.Warn" Class="tr-mem-load-error">
                <span>@_loadError</span>
            </Alert>
        }
    </Notices>
    <Loading>
        @if (_loadError is null)
        {
            <LoadingBlock Text="Loading..." />
        }
    </Loading>
    @* Two different situations, and only one of them is about the filters:
       a memory that has never been filled needs the ways to fill it, a
       search that found nothing needs a way back to everything. *@
    <Empty>
        <div class="card">
            <EmptyState Icon="languages" Title="No translations learned yet">
                <Text>Memory fills up as you translate and import language files.</Text>
                <Action>
                    <span class="u-row">
                        <a class="btn" href="/admin/translation-memory/import">
                            <Icon Name="upload" Width="14" Height="14" />
                            <span>Import XLIFF</span>
                        </a>
                        @if (_canRefreshFromRepositories)
                        {
                            <button type="button" class="btn" disabled="@_refreshing"
                                    @onclick="RefreshFromRepositoriesAsync">
                                <Icon Name="refresh-cw" Width="14" Height="14" />
                                <span>Read translations from repositories</span>
                            </button>
                        }
                    </span>
                </Action>
            </EmptyState>
        </div>
    </Empty>
    <NoMatches>
        <div class="card">
            <EmptyState Icon="languages" Title="Nothing matches">
                <Text>No entry matches what you searched for.</Text>
                <Action>
                    <button type="button" class="btn" @onclick="ClearFiltersAsync">
                        <Icon Name="x" Width="14" Height="14" />
                        <span>Clear filters</span>
                    </button>
                </Action>
            </EmptyState>
        </div>
    </NoMatches>
    <ChildContent>
        <div class="tr-mem-count u-muted">@CountText · showing @(_skip + 1)-@(_skip + _result!.Items.Count)</div>
        <table class="data-table tr-mem-table">
            <thead>
                <tr>
                    <th>Source</th>
                    <th>Target</th>
                    <th>Kind</th>
                    <th>Origin</th>
                    <th>Repository</th>
                    <th class="tr-mem-num">Score</th>
                    <th class="tr-mem-num">Hits</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _result!.Items)
                {
                    <tr class="@(e.IsDeleted ? "tr-mem-removed" : "")">
                        <td class="tr-mem-src">@e.SourceText<span class="tr-mem-lang">@e.SourceLanguage</span></td>
                        <td>@e.TargetText<span class="tr-mem-lang">@e.TargetLanguage</span></td>
                        <td><span class="tr-mem-kind">@e.Kind</span></td>
                        <td class="u-muted">@(e.Origin ?? "—")</td>
                        <td class="u-muted tr-mem-from">
                            @if (e.SourceRepository is not null && e.SourcePath is not null)
                            {
                                <a href="@FileUrl(e.SourceRepository, e.SourcePath)" target="_blank" rel="noopener noreferrer"
                                   title="@($"{e.SourceRepository} - {e.SourcePath}")">
                                    <Icon Name="external-link" Width="12" Height="12" />
                                    <span>@e.SourceRepository</span>
                                </a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="tr-mem-num">
                            <div class="tr-vote">
                                <button class="tr-vbtn @(e.MyVote > 0 ? "on" : "")" title="Vote up"
                                        @onclick="() => VoteAsync(e.Id, e.MyVote > 0 ? 0 : 1)">
                                    <Icon Name="thumbs-up" Width="13" Height="13" />
                                </button>
                                <span class="tr-vscore @(e.Score > 0 ? "pos" : e.Score < 0 ? "neg" : "")">@e.Score</span>
                                <button class="tr-vbtn @(e.MyVote < 0 ? "on" : "")" title="Vote down"
                                        @onclick="() => VoteAsync(e.Id, e.MyVote < 0 ? 0 : -1)">
                                    <Icon Name="thumbs-down" Width="13" Height="13" />
                                </button>
                            </div>
                        </td>
                        <td class="tr-mem-num u-muted">@e.HitCount</td>
                        <td class="tr-mem-actions">
                            @if (e.IsDeleted)
                            {
                                <button class="btn btn--sm" @onclick="() => RestoreAsync(e.Id)">
                                    <Icon Name="history" Width="13" Height="13" /><span>Restore</span>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn--sm btn--danger" @onclick="() => ConfirmDeleteAsync(e)">
                                    <Icon Name="trash-2" Width="13" Height="13" /><span>Remove</span>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_skip > 0 || _result!.HasMore)
        {
            <div class="tr-mem-pager">
                <button class="btn btn--sm" disabled="@(_skip == 0)" @onclick="() => PageAsync(-1)">Previous</button>
                <span class="pager__count">@PageText</span>
                <button class="btn btn--sm" disabled="@(!_result!.HasMore)" @onclick="() => PageAsync(1)">Next</button>
            </div>
        }
    </ChildContent>
</ListPage>

<ConfirmDialog @ref="_confirm"
               Title="Remove this translation?"
               Message="It will stop appearing as a suggestion. You can restore it from this page (toggle 'Include removed')."
               ConfirmLabel="Remove"
               ConfirmIcon="trash-2" />

@code {
    private string _text = "";
    private string _targetLang = "";
    private string _kind = "";
    private string _origin = "";
    private bool _includeDeleted;

    private const int _pageSize = 50;
    private int _skip;
    private MemorySearchResult? _result;
    private ConfirmDialog? _confirm;

    private string? _loadError;

    /// <summary>
    /// One database operation at a time. Everything here runs on the circuit's
    /// single scoped <c>AppDbContext</c>, which allows one operation at a time,
    /// and nothing stops someone pressing Search twice, or voting while a
    /// search is still running: the second one starts on a busy context and EF
    /// throws. Same reason as the reload gate on the Object Explorer's module
    /// page (#739 is the same hazard on the template editor).
    /// </summary>
    private readonly SemaphoreSlim _dbGate = new(1, 1);

    private bool _canRefreshFromRepositories;
    private bool _refreshing;
    private bool _refreshFailed;
    private string? _refreshMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // Offered only once the organisation has connected GitHub. The read acts
        // as the organisation, so it needs no link of the viewer's own - but with
        // nothing connected there is nothing to read, and a button that can only
        // report that is worse than no button.
        try
        {
            var access = await GuardedAsync(() => Repositories.GetAccessAsync());
            _canRefreshFromRepositories = access.Readiness
                is GitHubRepositoryReadiness.NotLinked
                or GitHubRepositoryReadiness.LinkNeedsRepair
                or GitHubRepositoryReadiness.Ready;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Could not tell whether GitHub is connected; the refresh button stays hidden.");
        }
    }

    /// <summary>
    /// Reads the translation files in the organisation's repositories and learns
    /// from the ones that have changed. It never fails the page: a repository
    /// that could not be read is counted and reported.
    /// </summary>
    private async Task RefreshFromRepositoriesAsync()
    {
        _refreshing = true;
        _refreshFailed = false;
        _refreshMessage = null;
        try
        {
            var summary = await GuardedAsync(() => Ingest.IngestCurrentOrganisationAsync());
            _refreshFailed = summary.RepositoriesFailed > 0;
            _refreshMessage = Describe(summary);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Refreshing the translation memory from repositories failed.");
            _refreshFailed = true;
            _refreshMessage = "GitHub could not be reached just now, so nothing was read. Try again in a moment.";
        }
        finally
        {
            _refreshing = false;
        }
    }

    /// <summary>What the refresh did, in the words someone curating the memory would use.</summary>
    private static string Describe(TranslationMemoryIngestSummary s)
    {
        if (s.FoundNothingToScan)
        {
            return "None of your solutions point at a repository in your connected GitHub organisation yet, "
                + "so there was nothing to read.";
        }

        var parts = new List<string>
        {
            $"Read {Count(s.FilesRead, "translation file", "translation files")} "
                + $"in {Count(s.RepositoriesScanned, "repository", "repositories")}.",
            s.PairsLearned == 0
                ? "Nothing new to learn - every translation in them was already in the memory."
                : $"Learned {Count(s.PairsLearned, "new translation", "new translations")}.",
        };
        if (s.FilesUnchanged > 0)
        {
            parts.Add($"{Count(s.FilesUnchanged, "file", "files")} had not changed since last time.");
        }
        if (s.RepositoriesFailed > 0)
        {
            parts.Add($"{Count(s.RepositoriesFailed, "repository", "repositories")} could not be read.");
        }
        return string.Join(" ", parts);
    }

    private static string Count(int n, string one, string many) => $"{n} {(n == 1 ? one : many)}";

    /// <summary>
    /// The file on GitHub. The ref is HEAD, which GitHub resolves to whatever
    /// the repository's default branch is called today, so the link survives a
    /// rename without a column to keep in step.
    /// </summary>
    private static string FileUrl(string repository, string path) =>
        $"https://github.com/{repository}/blob/HEAD/{path}";

    /// <summary>
    /// The match count. The search stops counting at a limit (an exact count of
    /// the whole memory was most of this page's load time), so past it the
    /// count reads "More than 10,000" and the pager drops its "of N".
    /// </summary>
    private string CountText => _result!.TotalIsCapped
        ? $"More than {_result.Total:N0} entries"
        : $"{_result.Total:N0} entr{(_result.Total == 1 ? "y" : "ies")}";

    private string PageText
    {
        get
        {
            var page = _skip / _pageSize + 1;
            return _result!.TotalIsCapped || _result.Total is not { } total
                ? $"Page {page:N0}"
                : $"Page {page:N0} of {(total - 1) / _pageSize + 1:N0}";
        }
    }

    /// <summary>True when the list is narrowed, so an empty result is the search's doing.</summary>
    private bool HasFilters =>
        _text.Length > 0 || _targetLang.Length > 0 || _kind.Length > 0 || _origin.Length > 0;

    private async Task SearchAsync()
    {
        _skip = 0;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _text = _targetLang = _kind = _origin = string.Empty;
        _skip = 0;
        await LoadAsync();
    }

    private async Task PageAsync(int dir)
    {
        _skip = Math.Max(0, _skip + dir * _pageSize);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _result = await GuardedAsync(() => Memory.SearchAsync(new MemorySearchQuery(
                Text: _text, TargetLanguage: _targetLang, Kind: string.IsNullOrEmpty(_kind) ? null : _kind,
                Origin: _origin, IncludeDeleted: _includeDeleted, Skip: _skip, Take: _pageSize)));
            _loadError = null;

            // Removing the last row on the last page leaves this page empty, and an
            // empty page renders the "nothing learned yet" state with no pager to go
            // back with. Step back to the last page that has rows instead.
            if (_result.Items.Count == 0 && _skip > 0)
            {
                _skip = Math.Max(0, _skip - _pageSize);
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Translation memory search failed.");
            // Say so. A failed search that leaves the previous list on screen
            // looks to the user like a search that matched everything.
            _loadError = "The list could not be loaded just now. Try again in a moment.";
        }
    }

    /// <summary>
    /// Runs one database operation, waiting for any the page already has in
    /// flight. See <see cref="_dbGate"/> for why the page needs this.
    /// </summary>
    private async Task<T> GuardedAsync<T>(Func<Task<T>> operation)
    {
        await _dbGate.WaitAsync();
        try
        {
            return await operation();
        }
        finally
        {
            _dbGate.Release();
        }
    }

    public void Dispose() => _dbGate.Dispose();

    private async Task VoteAsync(long entryId, int direction)
    {
        try
        {
            await GuardedAsync(async () => { await Memory.VoteAsync(entryId, direction); return 0; });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Vote on memory entry {EntryId} failed.", entryId);
        }
    }

    private async Task ConfirmDeleteAsync(MemoryEntryView e)
    {
        if (_confirm is null) return;
        if (!await _confirm.OpenAsync()) return;
        try
        {
            await GuardedAsync(async () => { await Memory.DeleteAsync(e.Id); return 0; });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Remove of memory entry {EntryId} failed.", e.Id);
        }
    }

    private async Task RestoreAsync(long entryId)
    {
        try
        {
            await GuardedAsync(async () => { await Memory.RestoreAsync(entryId); return 0; });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Restore of memory entry {EntryId} failed.", entryId);
        }
    }
}
