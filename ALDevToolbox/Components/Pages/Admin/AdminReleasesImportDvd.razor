@page "/admin/object-explorer/new/dvd"
@attribute [Authorize(Roles = "Admin,Editor")]
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerService ObjectExplorer
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor Http
@using ALDevToolbox.Services.ObjectExplorer
@using Microsoft.AspNetCore.Antiforgery

@*
    DVD tab of the Import Release page. Statically rendered; posts to the shared
    /admin/object-explorer/import endpoint with just a download URL. The server
    downloads the ZIP (behind the SiteAdmin allow-list + SSRF guard) and ingests
    it in the background. For the common Microsoft DVD case the metadata is a
    first-party label; the same Kind/Parent fields let a partner DVD hosted at a
    URL still resolve against its base.
*@

<PageTitle>Import Release · DVD · Admin · AL Workbench</PageTitle>

<div class="page">
    <AdminReleasesImportHeader ActiveTab="AdminReleasesImportHeader.Tab.Microsoft" />

    <p class="form-sec__cap">
        <strong>Advanced.</strong> Most Microsoft releases import more reliably
        from the <a href="/admin/object-explorer/new/artifacts">Artifacts</a> CDN
        path. Use this DVD-URL form only when you have a download link the
        artifacts index doesn't cover.
    </p>

    @if (_errorMessage is not null)
    {
        <Alert Tone="AlertTone.Danger">
            <span>@_errorMessage</span>
        </Alert>
    }

    @* No layout class on the form: .form-sec siblings separate themselves with
       their own padding and top border. *@
    <form method="post"
          action="/admin/object-explorer/import"
          enctype="multipart/form-data"
          data-oe-import-form>
        @if (_antiforgeryToken is not null)
        {
            <input type="hidden" name="@_antiforgeryToken.FormFieldName" value="@_antiforgeryToken.RequestToken" />
        }

        <ImportProgressBanner />

        <ReleaseImportMetadataFields ParentCandidates="_parentCandidates" />

        <section class="form-sec">
            <label class="field">
                <span class="field__label">Download URL</span>
                <input type="url" name="DvdUrl" inputmode="url" required
                       placeholder="https://download.microsoft.com/.../Dynamics.365.BC....DVD.zip"
                       class="input" />
                <small class="field__hint">
                    Paste the link to Microsoft's BC DVD ZIP and we'll download
                    and import it for you. The import runs in the background, and
                    the file is deleted once it's done. The link's host has to be
                    approved by a site administrator first (Site administration →
                    Settings).
                    <br />
                    Want the latest Microsoft release without hunting for a link?
                    Use the <strong>Artifacts</strong> tab instead.
                </small>
            </label>
        </section>

        <section class="form-sec">
            <label class="check">
                <input type="checkbox" name="StoreSymbolReference" value="true" />
                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                <span>Keep each app's symbol file for troubleshooting</span>
            </label>
            <small class="field__hint">
                Stores extra technical detail that helps diagnose import problems.
                These files are large, so leave this off unless you're looking into
                a specific issue.
            </small>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary" data-oe-import-submit>
                <Icon Name="download" Width="16" Height="16" />
                <span>Import Release</span>
            </button>
        </div>
    </form>
</div>

@code {
    private AntiforgeryTokenSet? _antiforgeryToken;
    private List<ReleaseListItem>? _parentCandidates;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is not null)
        {
            _antiforgeryToken = Antiforgery.GetAndStoreTokens(ctx);
            var err = ctx.Request.Query["err"].ToString();
            var msg = ctx.Request.Query["msg"].ToString();
            if (!string.IsNullOrEmpty(err) && !string.IsNullOrEmpty(msg))
            {
                _errorMessage = $"{err}: {msg}";
            }
        }

        var all = await ObjectExplorer.ListReleasesAsync();
        _parentCandidates = all
            // Previews are left out: a third-party release parented on one would
            // lose its parent when the preview is retired.
            .Where(r => r.Status == "ready" && r.Kind == "first_party" && !r.IsPrerelease)
            .OrderBy(r => r.Label)
            .ToList();
    }
}
