@page "/admin/templates/defaults"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject OrganizationConfigService Config
@inject OrganizationBrandingService Branding
@inject NavigationManager Nav
@inject ILogger<AdminTemplateDefaults> Log
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using Microsoft.AspNetCore.Components.Forms
@using ALDevToolbox.Services.Generation
@using ALDevToolbox.Services.Organizations

@*
    Defaults sub-page (Issue #61). Pre-fills for the New Workspace and New
    Extension forms. The form posts only this section's columns; the other
    configuration sub-pages save independently.
*@

<PageTitle>Defaults · Configuration · AL Workbench</PageTitle>

<EditPage Title="Defaults"
          IsLoading="@(_loading)" Sticky="true"
          Trail='@([new("Admin", "/admin"), new("Defaults")])'>
    <SubtitleContent>
        Pre-filled into the New Workspace and New Extension forms. Users
        can still edit on the form - these are defaults, not locks.
    </SubtitleContent>
    <Actions>
        @* Save lives in the sticky .form-actions bar at the foot of the form,
           not up here — this page is longer than a viewport and the archetype
           ends a long form with its action bar. *@
    </Actions>
    <ChildContent>
        @if (!string.IsNullOrEmpty(_okMessage))
        {
            <Alert Tone="AlertTone.Success">
                <span>@_okMessage</span>
            </Alert>
        }
        @if (!string.IsNullOrEmpty(_errMessage))
        {
            <Alert Tone="AlertTone.Danger">
                <span>@_errMessage</span>
            </Alert>
        }

        <section class="card">
            <div class="card__head"><h2 class="card__title">App details</h2></div>
            <div class="card__body form-sec">
                <div class="form-grid">
                    <div class="field">
                        <label class="field__label" for="cfg-publisher">Publisher</label>
                        <input class="input" id="cfg-publisher" type="text" required
                               placeholder="e.g. CRONUS A/S"
                               @bind="_publisher" @bind:event="oninput" />
                        <span class="field__hint">The publisher name on every extension you generate.</span>
                    </div>

                    <div class="field">
                        <label class="field__label" for="cfg-url">Default URL</label>
                        <input class="input" id="cfg-url" type="text"
                               placeholder="e.g. https://cronus.com"
                               @bind="_url" @bind:event="oninput" />
                        <span class="field__hint">Your support or company URL. Leave blank to omit it.</span>
                    </div>

                    <div class="field">
                        <label class="field__label" for="cfg-logo-path">Default logo path</label>
                        <input class="input" id="cfg-logo-path" type="text"
                               placeholder="e.g. ../.assets/images/logo.png"
                               pattern="\s*(\.\.[\/\\])[A-Za-z0-9._\-]+([\/\\][A-Za-z0-9._\-]+)*\s*"
                               @bind="_logoPath" @bind:event="oninput" />
                        <span class="field__hint">Where each extension looks for the logo below, starting from its own folder. Leave blank to omit it.</span>
                        <FieldError Field="@nameof(OrganizationSettingsInput.DefaultLogo)" Errors="_errors" />
                    </div>

                    @* IdRangeEditor rather than a hand-rolled pair, so this page gets
                       the running "N IDs" count the generator pages have. A range is
                       a size; without the count you subtract in your head. *@
                    <IdRangeEditor IdPrefix="cfg" FromName="cfg-from" ToName="cfg-to"
                                   Label="Default ID range"
                                   FromLabel="First object ID" ToLabel="Last object ID"
                                   Hint="Pre-fills the range on New Workspace and New Extension."
                                   From="_idFrom" FromChanged="v => _idFrom = v"
                                   To="_idTo" ToChanged="v => _idTo = v" />

                    <div class="field field--full">
                        <label class="field__label" for="cfg-brief">Default brief</label>
                        <input class="input" id="cfg-brief" type="text"
                               placeholder="e.g. Customisations and reports for {{workspace_name}}."
                               @bind="_brief" @bind:event="oninput" />
                    </div>

                    <div class="field field--full">
                        <label class="field__label" for="cfg-desc">Default core description</label>
                        <textarea class="textarea" id="cfg-desc" rows="3"
                                  placeholder="Longer description prefilled into the New Workspace form."
                                  @bind="_description" @bind:event="oninput"></textarea>
                    </div>
                </div>

                <MustacheVarsHint />
            </div>
        </section>

        @* Naming (#757). The two derived names and the extension prefix are an
           organisation convention, so they are set once here rather than on
           every workspace. Each style option is labelled with the name it
           produces, run through the same CustomerNaming the generator uses, so
           what an admin reads is what the generator will write.
           See .design/customer-naming.md. *@
        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Naming</h2>
                    <p class="card__sub">
                        How a customer's name becomes the names in a generated
                        workspace. Applies to workspaces generated from now on.
                        Anything already downloaded is unchanged.
                    </p>
                </div>
            </div>
            <div class="card__body form-sec">
                <div class="form-grid">
                    <div class="field">
                        <label class="field__label" for="cfg-folder-style">Workspace folder name</label>
                        <SelectBox>
                            @* Each option shows what it does to one customer's
                               name, run through the generator's own CustomerNaming
                               so the label cannot drift from the result. *@
                            <select class="select" id="cfg-folder-style" @bind="_folderStyle">
                                @foreach (var style in FolderStyles)
                                {
                                    <option value="@style">@StyleOption(style)</option>
                                }
                            </select>
                        </SelectBox>
                        <span class="field__hint">
                            Examples are for a customer called @ExampleCustomer. The
                            <code class="code">.code-workspace</code> file inside takes the same name.
                        </span>
                    </div>

                    <div class="field">
                        <label class="field__label" for="cfg-repo-style">Repository name</label>
                        <SelectBox>
                            <select class="select" id="cfg-repo-style" @bind="_repositoryStyle">
                                @foreach (var style in RepositoryStyles)
                                {
                                    <option value="@style">@StyleOption(style)</option>
                                }
                            </select>
                        </SelectBox>
                        <span class="field__hint">
                            Suggested on New Workspace - the consultant can still type another name.
                        </span>
                    </div>

                    <div class="field">
                        <label class="field__label" for="cfg-prefix-mode">Where the extension prefix comes from</label>
                        <SelectBox>
                            <select class="select" id="cfg-prefix-mode" @bind="_prefixMode">
                                <option value="@ExtensionPrefixMode.Hidden">The customer's short name</option>
                                <option value="@ExtensionPrefixMode.Fixed">Always the same word</option>
                                <option value="@ExtensionPrefixMode.PerWorkspace">Decided on each workspace</option>
                            </select>
                        </SelectBox>
                        <span class="field__hint">@PrefixModeHint</span>
                    </div>

                    @if (_prefixMode != ExtensionPrefixMode.Hidden)
                    {
                        <div class="field">
                            <label class="field__label" for="cfg-prefix">
                                @(_prefixMode == ExtensionPrefixMode.Fixed ? "Prefix to use" : "Suggested prefix")
                                @if (_prefixMode == ExtensionPrefixMode.Fixed)
                                {
                                    <span class="req">*</span>
                                }
                            </label>
                            <input class="input" id="cfg-prefix" type="text" placeholder="e.g. CRONUS"
                                   maxlength="@OrganizationConfigService.MaxExtensionPrefixLength"
                                   required="@(_prefixMode == ExtensionPrefixMode.Fixed)"
                                   @bind="_prefix" @bind:event="oninput" />
                            <span class="field__hint">
                                @(_prefixMode == ExtensionPrefixMode.Fixed
                                    ? "Extension names are the same for every customer, as in JM Core."
                                    : "Fills the field on New Workspace. Leave blank to fill it with the customer's short name instead.")
                                Up to @OrganizationConfigService.MaxExtensionPrefixLength characters.
                            </span>
                            <FieldError Field="@nameof(OrganizationNamingInput.ExtensionPrefix)" Errors="_errors" />
                        </div>
                    }
                </div>
            </div>
        </section>

        @* Logo section - folded in from the retired /admin/templates/logo page so
           admins manage one Defaults form instead of two. The image is bundled
           into every generated workspace under .assets/images/logo.<ext>.
           SVG uploads have <script> tags and on* attributes stripped on save. *@
        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Logo</h2>
                    <p class="card__sub">
                        Bundled into every generated workspace. SVG or PNG,
                        up to @(OrganizationBrandingService.MaxLogoBytes / 1024) KB.
                    </p>
                </div>
                @* .btn--file hides the native input under the label. It used to
                   have no styling at all, so the browser's own "Choose File /
                   No file chosen" rendered inside our button. *@
                <label class="btn btn--sm btn--file">
                    <Icon Name="upload" Width="14" Height="14" />
                    <span>Choose file...</span>
                    <InputFile id="cfg-logo-file" OnChange="OnLogoChosen" accept="image/png,image/svg+xml" />
                </label>
            </div>
            <div class="card__body form-sec">
                @if (_pendingLogoBytes is not null)
                {
                    <Alert Tone="AlertTone.Info" Icon="circle-check" Role="status">
                        <span>New logo selected (@_pendingLogoFileName). Click <strong>Save changes</strong> to apply.</span>
                    </Alert>
                }
                else if (_removeLogo)
                {
                    <Alert Tone="AlertTone.Warn">
                        <span>The logo will be removed when you save.</span>
                    </Alert>
                }
                else if (_logo is not null)
                {
                    <span class="logo-preview">
                        <img src="/admin/configuration/logo/preview?t=@_logoCacheBust" alt="Current logo" class="logo-preview__img" />
                    </span>
                }
                else
                {
                    <EmptyState Title="No logo yet" Quiet="true">
                        <Text>Generated workspaces will ship without one.</Text>
                    </EmptyState>
                }
            </div>
            @if (_logo is not null || _pendingLogoBytes is not null)
            {
                <div class="card__foot">
                    @if (_pendingLogoBytes is not null || _removeLogo)
                    {
                        <button type="button" class="btn btn--sm" @onclick="ResetLogoChanges">
                            <Icon Name="rotate-ccw" Width="14" Height="14" />
                            <span>Undo</span>
                        </button>
                    }
                    <button type="button" class="btn btn--sm" @onclick="MarkLogoForRemoval" disabled="@_removeLogo">
                        <Icon Name="trash-2" Width="14" Height="14" />
                        <span>Remove logo</span>
                    </button>
                </div>
            }
        </section>

        <div class="form-actions form-actions--sticky">
            <span class="form-actions__spacer"></span>
            @if (IsDirty)
            {
                <span class="form-actions__note">Unsaved changes</span>
            }
            <button type="button" class="btn btn--primary"
                    @onclick="SaveAsync"
                    disabled="@(_saving || !IsDirty)">
                <Icon Name="save" Width="16" Height="16" />
                <span>@(_saving ? "Saving..." : "Save changes")</span>
            </button>
        </div>
    </ChildContent>
</EditPage>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? OkParam { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _okMessage;
    private string? _errMessage;

    /// <summary>
    /// Field-keyed problems from the last save attempt, straight from
    /// <see cref="PlanValidationException.Errors"/>, so a refusal is shown
    /// beside the field that caused it rather than only in the alert at the top
    /// of a page longer than a viewport - the same contract New Workspace uses.
    /// </summary>
    private IReadOnlyDictionary<string, string> _errors =
        new Dictionary<string, string>();

    private string _publisher = string.Empty;
    private int _idFrom;
    private int _idTo;
    private string _brief = string.Empty;
    private string _description = string.Empty;
    private string _url = string.Empty;
    private string _logoPath = string.Empty;

    private NamingStyle _folderStyle = NamingStyle.PascalCase;
    private NamingStyle _repositoryStyle = NamingStyle.KebabCase;
    private ExtensionPrefixMode _prefixMode = ExtensionPrefixMode.PerWorkspace;
    private string _prefix = string.Empty;

    private NamingStyle _baseFolderStyle = NamingStyle.PascalCase;
    private NamingStyle _baseRepositoryStyle = NamingStyle.KebabCase;
    private ExtensionPrefixMode _basePrefixMode = ExtensionPrefixMode.PerWorkspace;
    private string _basePrefix = string.Empty;

    /// <summary>
    /// The name the examples are worked through. A Danish customer with two
    /// letters that have to be transliterated, so an admin sees what the styles
    /// do to a real name rather than to an ASCII one.
    /// </summary>
    private const string ExampleCustomer = "Jørgensen Møbler";

    private static readonly NamingStyle[] FolderStyles =
        Enum.GetValues<NamingStyle>();

    /// <summary>Every style but None - a repository name cannot contain spaces.</summary>
    private static readonly NamingStyle[] RepositoryStyles =
        Enum.GetValues<NamingStyle>().Where(s => s != NamingStyle.None).ToArray();

    /// <summary>
    /// What one option does, shown as the result first and the convention's
    /// name second: "JorgensenMobler (PascalCase)". The result is computed
    /// through <see cref="CustomerNaming"/>, the generator's own code, so a
    /// label can never promise something the generator would not write.
    /// </summary>
    private static string StyleOption(NamingStyle style) =>
        $"{CustomerNaming.Apply(ExampleCustomer, style)} ({StyleLabel(style)})";

    private static string StyleLabel(NamingStyle style) => style switch
    {
        NamingStyle.PascalCase => "PascalCase",
        NamingStyle.CamelCase => "camelCase",
        NamingStyle.KebabCase => "kebab-case",
        NamingStyle.SnakeCase => "snake_case",
        NamingStyle.Lowercase => "lowercase",
        // Not "as typed": accented letters are still transliterated and runs of
        // punctuation still collapse. The example beside it shows both.
        _ => "plain words",
    };

    /// <summary>What the picked prefix policy means, in one sentence.</summary>
    private string PrefixModeHint => _prefixMode switch
    {
        ExtensionPrefixMode.Hidden =>
            "Extension names start with each customer's short name, as in JM Core.",
        ExtensionPrefixMode.Fixed =>
            "Every extension name starts with the same word, whatever the customer.",
        _ =>
            "The consultant sets the prefix when creating the workspace; you can suggest a starting value below.",
    };

    private string _basePublisher = string.Empty;
    private int _baseIdFrom;
    private int _baseIdTo;
    private string _baseBrief = string.Empty;
    private string _baseDescription = string.Empty;
    private string _baseUrl = string.Empty;
    private string _baseLogoPath = string.Empty;

    // Logo upload state - folded in from the retired /admin/templates/logo
    // page. Pending bytes live in memory until Save commits via UploadLogoAsync.
    private OrganizationAsset? _logo;
    private byte[]? _pendingLogoBytes;
    private string? _pendingLogoContentType;
    private string? _pendingLogoFileName;
    private bool _removeLogo;
    private long _logoCacheBust = DateTimeOffset.UtcNow.ToUnixTimeSeconds();

    private bool IsDirty =>
        _publisher != _basePublisher
        || _idFrom != _baseIdFrom
        || _idTo != _baseIdTo
        || _brief != _baseBrief
        || _description != _baseDescription
        || _url != _baseUrl
        || _logoPath != _baseLogoPath
        || _folderStyle != _baseFolderStyle
        || _repositoryStyle != _baseRepositoryStyle
        || _prefixMode != _basePrefixMode
        || _prefix != _basePrefix
        || _pendingLogoBytes is not null
        || _removeLogo;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _okMessage = OkParam == "saved" ? "Defaults saved." : null;
    }

    private async Task LoadAsync()
    {
        var config = await Config.GetCurrentAsync();
        _publisher = _basePublisher = config.Settings.DefaultPublisher;
        _idFrom = _baseIdFrom = config.Settings.DefaultIdRangeFrom;
        _idTo = _baseIdTo = config.Settings.DefaultIdRangeTo;
        _brief = _baseBrief = config.Settings.DefaultBrief;
        _description = _baseDescription = config.Settings.DefaultCoreDescription;
        _url = _baseUrl = config.Settings.DefaultUrl ?? string.Empty;
        _logoPath = _baseLogoPath = config.Settings.DefaultLogo ?? string.Empty;
        _folderStyle = _baseFolderStyle = config.Settings.NamingFolderStyle;
        _repositoryStyle = _baseRepositoryStyle = config.Settings.NamingRepositoryStyle;
        _prefixMode = _basePrefixMode = config.Settings.ExtensionPrefixMode;
        _prefix = _basePrefix = config.Settings.ExtensionPrefix ?? string.Empty;
        _logo = config.Logo;
        _pendingLogoBytes = null;
        _pendingLogoContentType = null;
        _pendingLogoFileName = null;
        _removeLogo = false;
        _logoCacheBust = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        _loading = false;
    }

    private async Task OnLogoChosen(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > OrganizationBrandingService.MaxLogoBytes)
        {
            _errMessage = $"Logo must be {OrganizationBrandingService.MaxLogoBytes / 1024} KB or smaller.";
            return;
        }
        try
        {
            await using var stream = file.OpenReadStream(OrganizationBrandingService.MaxLogoBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _pendingLogoBytes = ms.ToArray();
            _pendingLogoContentType = file.ContentType;
            _pendingLogoFileName = file.Name;
            _removeLogo = false;
            _errMessage = null;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Failed to read uploaded logo '{Name}'.", file.Name);
            _errMessage = $"Could not read the file: {ex.Message}";
        }
    }

    private void MarkLogoForRemoval()
    {
        _removeLogo = true;
        _pendingLogoBytes = null;
        _pendingLogoContentType = null;
        _pendingLogoFileName = null;
    }

    private void ResetLogoChanges()
    {
        _pendingLogoBytes = null;
        _pendingLogoContentType = null;
        _pendingLogoFileName = null;
        _removeLogo = false;
    }

    private async Task SaveAsync()
    {
        if (_saving || !IsDirty) return;
        _saving = true;
        _errMessage = null;
        _okMessage = null;
        _errors = new Dictionary<string, string>();
        try
        {
            await Config.SaveSettingsAsync(new OrganizationSettingsInput(
                DefaultPublisher: _publisher.Trim(),
                DefaultIdRangeFrom: _idFrom,
                DefaultIdRangeTo: _idTo,
                DefaultBrief: _brief,
                DefaultCoreDescription: _description,
                DefaultUrl: _url,
                DefaultLogo: _logoPath));
            await Config.SaveNamingAsync(new OrganizationNamingInput(
                FolderStyle: _folderStyle,
                RepositoryStyle: _repositoryStyle,
                ExtensionPrefixMode: _prefixMode,
                ExtensionPrefix: _prefix));
            // Settings landed; now apply the logo change (if any). Both calls
            // touch the same org-config cache, so a partial failure here still
            // leaves the settings save committed - surface the error so the
            // admin can retry the logo step.
            if (_removeLogo)
            {
                await Branding.RevertLogoAsync();
            }
            else if (_pendingLogoBytes is not null)
            {
                await Branding.UploadLogoAsync(_pendingLogoContentType ?? string.Empty, _pendingLogoBytes);
            }
            Nav.NavigateTo("/admin/templates/defaults?ok=saved", forceLoad: true);
        }
        catch (PlanValidationException ex)
        {
            _errors = ex.Errors;
            _errMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save organisation defaults.");
            _errMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }
}
