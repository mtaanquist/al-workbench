@page "/admin/object-explorer/new"
@attribute [Authorize(Roles = "Admin,Editor")]
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerService ObjectExplorer
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor Http
@using ALDevToolbox.Services.ObjectExplorer
@using Microsoft.AspNetCore.Antiforgery

@*
    Upload tab of the Import Release page. Statically rendered (no @rendermode):
    it posts a multipart body - up to 1 GB - straight to
    /admin/object-explorer/import through Kestrel rather than the SignalR
    circuit. The DVD (URL) and Artifacts (Microsoft CDN) modes live on sibling
    routes behind the shared pill header; this tab is the manual-files path.
*@

<PageTitle>Import Release · Third-party · Admin · AL Workbench</PageTitle>

<div class="page">
    <AdminReleasesImportHeader ActiveTab="AdminReleasesImportHeader.Tab.ThirdParty" />

    @if (_errorMessage is not null)
    {
        <Alert Tone="AlertTone.Danger">
            <span>@_errorMessage</span>
        </Alert>
    }

    @* No layout class on the form: .form-sec siblings separate themselves with
       their own padding and top border. *@
    <form method="post"
          action="/admin/object-explorer/import"
          enctype="multipart/form-data"
          data-oe-import-form>
        @if (_antiforgeryToken is not null)
        {
            <input type="hidden" name="@_antiforgeryToken.FormFieldName" value="@_antiforgeryToken.RequestToken" />
        }

        <ImportProgressBanner />

        <ReleaseImportMetadataFields ParentCandidates="_parentCandidates" FixedKind="third_party" />

        <section class="form-sec">
            <label class="field">
                <span class="field__label">Application folder ZIP</span>
                <input type="file" name="FolderZip" accept=".zip" class="input input--file" />
                <small class="field__hint">
                    Drop the third-party <code>.app</code> files in a single ZIP -
                    e.g. an AppSource or partner app you have the file for. Test
                    and helper apps are skipped automatically. Up to 1 GB.
                    <br />
                    For a Microsoft release, use the
                    <a href="/admin/object-explorer/new/artifacts">Microsoft</a>
                    tab instead - it pulls the exact build from the CDN.
                    <br />
                    The <code>.app</code> files alone are enough to browse
                    objects. To also see source code and where things are called,
                    add each app's <code>.Source.zip</code> to the same ZIP.
                </small>
            </label>
        </section>

        <section class="form-sec">
            <label class="check">
                <input type="checkbox" name="StoreSymbolReference" value="true" />
                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                <span>Keep each app's symbol file for troubleshooting</span>
            </label>
            <small class="field__hint">
                Stores extra technical detail that helps diagnose import problems.
                These files are large, so leave this off unless you're looking into
                a specific issue.
            </small>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary" data-oe-import-submit>
                <Icon Name="upload" Width="16" Height="16" />
                <span>Import Release</span>
            </button>
        </div>
    </form>
</div>

@code {
    private AntiforgeryTokenSet? _antiforgeryToken;
    private List<ReleaseListItem>? _parentCandidates;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is not null)
        {
            _antiforgeryToken = Antiforgery.GetAndStoreTokens(ctx);

            // Read query-string error feedback set by the endpoint's Redirect helper.
            var err = ctx.Request.Query["err"].ToString();
            var msg = ctx.Request.Query["msg"].ToString();
            if (!string.IsNullOrEmpty(err) && !string.IsNullOrEmpty(msg))
            {
                _errorMessage = $"{err}: {msg}";
            }
        }

        // Only ready first-party Releases are sensible parents - failed /
        // ingesting ones would resolve references to nothing.
        var all = await ObjectExplorer.ListReleasesAsync();
        _parentCandidates = all
            // Previews are left out: a third-party release parented on one would
            // lose its parent when the preview is retired.
            .Where(r => r.Status == "ready" && r.Kind == "first_party" && !r.IsPrerelease)
            .OrderBy(r => r.Label)
            .ToList();
    }
}
