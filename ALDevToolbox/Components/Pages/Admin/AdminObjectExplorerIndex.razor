@page "/admin/object-explorer"
@attribute [Authorize(Roles = "Admin,Editor")]
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerService ObjectExplorer
@inject IHttpContextAccessor Http
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer

@*
    Admin index for the Object Explorer surface: lists every Release in the
    organisation (active + soft-deleted) and exposes per-row admin actions.
    Statically rendered so the action forms post normally; the Object Explorer
    endpoints (see ObjectExplorerEndpoints.cs) handle the writes.

    The user-facing browser at /object-explorer keeps showing only active
    Releases without admin affordances - this page is the admin counterpart.
*@

<PageTitle>Object Explorer · Admin · AL Workbench</PageTitle>

<div class="page">
    <AdminObjectExplorerHeader ActiveTab="AdminObjectExplorerHeader.Tab.Releases">
        <HeaderActions>
            @if (_releases is not null && _releases.Any(r => r.Status == "ingesting"))
            {
                <a class="btn btn--sm" href="/admin/object-explorer" title="Reload to see import progress">
                    <Icon Name="refresh-cw" Width="14" Height="14" />
                    <span>Refresh</span>
                </a>
            }
            @if (_releases is not null && _releases.Any(r => r.Status == "ready" && r.DeletedAt is null))
            {
                <form method="post" action="/admin/object-explorer/backfill-system-references-all">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn--sm"
                            title="Re-extract built-in/system method calls (Insert, Modify, SetRange, ...) over stored source for every ready release. For releases imported before Find System References shipped - no re-upload needed.">
                        <Icon Name="rotate-ccw" Width="14" Height="14" />
                        <span>Backfill system references</span>
                    </button>
                </form>
            }
        </HeaderActions>
    </AdminObjectExplorerHeader>

    @if (Status is { } status)
    {
        @if (status.IsError)
        {
            <Alert Tone="AlertTone.Danger">
                <span>@status.Message</span>
            </Alert>
        }
        else
        {
            <Alert Tone="AlertTone.Success">
                <span>@status.Message</span>
            </Alert>
        }
    }

    @if (_releases is null)
    {
        <LoadingBlock Text="Loading..." />
    }
    else if (_totalCount == 0)
    {
        <EmptyState Icon="layers" Title="No releases yet">
            <Text>
                A release is one Business Central version's objects, imported once so
                everyone can search and read them. Bring in a Microsoft build, a
                partner app, or a legacy C/AL export.
            </Text>
            <Action>
                <a class="btn btn--primary" href="/admin/object-explorer/new/artifacts">
                    <Icon Name="download" Width="14" Height="14" />
                    <span>Import a release</span>
                </a>
            </Action>
        </EmptyState>
    }
    else
    {
        <form method="get" class="filter-bar" role="search">
            <span class="search filter-bar__search">
                <Icon Name="search" Width="15" Height="15" Css="search__icon" />
                <input type="search" name="q" value="@_search" class="input"
                       placeholder="Search releases by name, version, publisher, or solution..."
                       aria-label="Search releases"
                       data-page-search aria-keyshortcuts="F3" title="Search releases (F3)" />
            </span>
            @if (!string.IsNullOrEmpty(_search))
            {
                <a class="btn btn--sm" href="/admin/object-explorer">Clear</a>
            }
        </form>

        @if (_releases.Count == 0)
        {
            <div class="empty-state empty-state--quiet">
                <span class="empty-state__title">No releases match "@_search"</span>
                <a class="btn btn--sm empty-state__action" href="/admin/object-explorer">
                    <Icon Name="funnel-x" Width="14" Height="14" />
                    <span>Clear the search</span>
                </a>
            </div>
        }
        else
        {
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Label</th>
                    <th scope="col">Kind</th>
                    <th scope="col">Publisher</th>
                    <th scope="col">Solution</th>
                    <th scope="col">Status</th>
                    <th scope="col">Files</th>
                    <th scope="col">Size</th>
                    <th scope="col">Imported</th>
                    <th scope="col" class="data-table__actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _releases)
                {
                    <tr>
                        <td>
                            <a href="@($"/object-explorer/release/{r.Id}")">
                                <strong>@r.Label</strong>
                            </a>
                            @if (r.IsPrerelease)
                            {
                                <StatusPill Tone="warn" Class="status-pill--inline">Preview</StatusPill>
                            }
                            @if (r.DeletedAt is not null)
                            {
                                <span class="u-muted"> · soft-deleted</span>
                            }
                        </td>
                        <td>@FormatKind(r.Kind)</td>
                        <td>@(string.IsNullOrEmpty(r.Publisher) ? "—" : r.Publisher)</td>
                        <td>@(string.IsNullOrEmpty(r.ProjectName) ? "—" : r.ProjectName)</td>
                        <td>
                            @FormatStatus(r.Status, r.Kind)
                            @if (r.Status == "failed" && !string.IsNullOrEmpty(r.StatusMessage))
                            {
                                <FieldError Message="@r.StatusMessage" />
                            }
                        </td>
                        <td>@r.SourceFileCount.ToString("N0")</td>
                        <td>@FormatBytes(r.SourceContentLength)</td>
                        <td><Timestamp Value="@r.ImportedAt" Format="yyyy-MM-dd" /></td>
                        <td class="data-table__actions">
                            <a class="btn btn--sm" href="@($"/admin/object-explorer/release/{r.Id}/manage")"
                               title="Edit details, add modules, translations, delete">
                                <Icon Name="settings" Width="14" Height="14" />
                                <span>Manage</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    }
</div>

@code {
    private List<ReleaseListItem>? _releases;
    private int _totalCount;
    private string _search = string.Empty;
    private (string Message, bool IsError)? Status { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is not null)
        {
            _search = ctx.Request.Query["q"].ToString().Trim();
        }
        if (ctx is not null)
        {
            var err = ctx.Request.Query["err"].ToString();
            var msg = ctx.Request.Query["msg"].ToString();
            if (!string.IsNullOrEmpty(err) && !string.IsNullOrEmpty(msg))
            {
                Status = ($"{err}: {msg}", true);
            }
            else
            {
                var ok = ctx.Request.Query["ok"].ToString();
                if (!string.IsNullOrEmpty(ok))
                {
                    Status = (FormatOkMessage(ok, ctx.Request.Query["id"].ToString()), false);
                }
            }
        }

        var all = await ObjectExplorer.ListReleasesAsync(includeSoftDeleted: true);
        _totalCount = all.Count;
        _releases = string.IsNullOrEmpty(_search)
            ? all
            : all.Where(MatchesSearch).ToList();
    }

    /// <summary>Substring match (case-insensitive) over label, publisher, solution, and BC version.</summary>
    private bool MatchesSearch(ReleaseListItem r)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return Has(r.Label) || Has(r.Publisher) || Has(r.ProjectName) || Has(r.BcVersion);

        bool Has(string? value) =>
            !string.IsNullOrEmpty(value) && value.Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatOkMessage(string ok, string id) => ok switch
    {
        "queued"       => $"Release {id} queued - importing in the background. Refresh this page to check on its progress.",
        "imported"     => $"Release {id} imported.",
        "updated"      => $"Release {id} metadata updated.",
        "soft-deleted" => $"Release {id} soft-deleted. Restore from this page if it was a mistake.",
        "restored"     => $"Release {id} restored.",
        "hard-deleted" => $"Release {id} permanently deleted.",
        "backfill-all-queued" => $"Queued a system-reference backfill for {id} ready release(s). They run in the background - watch progress on the workers page.",
        _              => "Done.",
    };

    private static string FormatKind(string kind) => kind switch
    {
        "first_party" => "First-party",
        "third_party" => "Third-party",
        "cal"         => "C/AL",
        OeRelease.ProjectBuildKind     => "Pipeline build",
        _             => kind,
    };

    // A solution release that's ingesting is mid-build (clone → compile → ingest),
    // so "Building..." reads truer than the generic "Ingesting...".
    private static string FormatStatus(string s, string kind) => s switch
    {
        "ready"                              => "Ready",
        "ingesting" when kind == OeRelease.ProjectBuildKind  => "Building...",
        "ingesting"                          => "Ingesting...",
        "failed"                             => "Failed",
        _                                    => s,
    };

    private static string FormatBytes(long n)
    {
        if (n < 1024) return n + " B";
        if (n < 1024L * 1024) return (n / 1024d).ToString("0.0") + " KB";
        if (n < 1024L * 1024 * 1024) return (n / (1024d * 1024)).ToString("0.0") + " MB";
        return (n / (1024d * 1024 * 1024)).ToString("0.0") + " GB";
    }
}
