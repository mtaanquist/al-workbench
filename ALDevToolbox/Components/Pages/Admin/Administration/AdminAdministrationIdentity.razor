@page "/admin/administration/identity"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject OrganizationBrandingService Branding
@inject OrganizationAdminService OrgAdmin
@inject DisplayTimeZone DisplayTimeZone
@inject NavigationManager Nav
@inject ILogger<AdminAdministrationIdentity> Log
@using ALDevToolbox.Data
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using Microsoft.EntityFrameworkCore
@using ALDevToolbox.Services.Organizations

@*
    Organisation identity and email-domain claims. The display name shown in
    the top bar comes from Organization.Name; rename it here. Email domains
    are globally unique - claiming one routes future signups from that domain
    into this org as Pending users (admin still approves via the Users tab).
*@

<PageTitle>Identity · Administration · AL Workbench</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.Identity">
    <Body>
        @if (_loading)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            <div class="setting-list">
                <SettingRow Name="Organisation name"
                            Hint="Shown beside your name in the top bar. A new name shows up the next time a page loads - nobody has to sign out.">
                    <span class="u-row">
                        <input class="input" id="org-name" type="text" required minlength="2" maxlength="80"
                               aria-label="Organisation name"
                               @bind="_name" @bind:event="oninput" />
                        @* Plain, not primary: the page grew a card foot when
                           Microsoft sign-in landed, and the archetype's foot is
                           where the primary save lives. Two primaries on one
                           page is the thing the house style forbids. *@
                        <button type="button" class="btn"
                                @onclick="SaveNameAsync"
                                disabled="@(_savingName || _name == _baseName)">
                            <Icon Name="save" Width="14" Height="14" />
                            <span>@(_savingName ? "Renaming..." : "Rename")</span>
                        </button>
                    </span>
                    <FeedbackLine Ok="@_nameOkMessage" Error="@_nameErrMessage" />
                </SettingRow>

                <SettingRow Name="Short name used in links"
                            Hint="Appears in every link to this organisation and in every signed-in session, so it cannot be changed.">
                    <input class="input" id="org-slug" type="text" value="@_slug" readonly disabled
                           aria-label="Short name used in links" />
                </SettingRow>

                <SettingRow Name="Time zone"
                            Hint="Times in AL Workbench are shown in this zone. Hover a time for the UTC instant.">
                    <SelectBox>
                        <select class="select" id="org-time-zone" aria-label="Time zone"
                                value="@(_timeZoneId ?? string.Empty)" @onchange="OnTimeZoneChangedAsync"
                                disabled="@_savingTimeZone">
                            <option value="">UTC (default)</option>
                            @foreach (var zone in _timeZoneOptions)
                            {
                                <option value="@zone.Id">@zone.Label</option>
                            }
                        </select>
                    </SelectBox>
                    <FeedbackLine Ok="@_timeZoneOkMessage" Error="@_timeZoneErrMessage" />
                </SettingRow>

                <SettingRow Name="Require a second step to sign in">
                    <HintContent>
                        Everyone here must set up an authenticator app, email codes or a
                        passkey. Anyone without one is sent to
                        <a href="/account">their account page</a> and cannot use anything
                        else until they have.
                    </HintContent>
                    <ChildContent>
                        <Switch Checked="_requireStrongAuth" CheckedChanged="OnStrongAuthChangedAsync"
                                Disabled="@_savingStrongAuth"
                                Label="@(_requireStrongAuth ? "Required" : "Not required")" />
                        <FeedbackLine Ok="@_strongAuthOkMessage" Error="@_strongAuthErrMessage" />
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Email domains">
                    <HintContent>
                        Anyone signing up with an address at one of these domains joins
                        this organisation. A domain can belong to only one organisation.
                    </HintContent>
                    <ChildContent>
                        <div class="sub-rows sub-rows--plain">
                            @if (_domains.Count == 0)
                            {
                                <p class="sub-rows__empty">No domains yet - add one below to route signups here.</p>
                            }
                            else
                            {
                                @foreach (var domain in _domains)
                                {
                                    <div class="sub-row">
                                        <span class="sub-row__val">@domain.Domain</span>
                                        <span class="sub-row__acts">
                                            <button type="button" class="btn btn--sm" @onclick="() => RemoveAsync(domain.Id)" disabled="@_savingDomain">
                                                <Icon Name="trash-2" Width="14" Height="14" />
                                                <span>Remove</span>
                                            </button>
                                        </span>
                                    </div>
                                }
                            }
                            <div class="sub-rows__foot">
                                <label class="u-sr" for="org-domain">Domain to add</label>
                                <input class="input" id="org-domain" type="text" placeholder="e.g. cronus.com" maxlength="253"
                                       @bind="_newDomain" @bind:event="oninput" />
                                <button type="button" class="btn"
                                        @onclick="AddAsync"
                                        disabled="@(_savingDomain || string.IsNullOrWhiteSpace(_newDomain))">
                                    <Icon Name="plus" Width="14" Height="14" />
                                    <span>@(_savingDomain ? "Saving..." : "Add domain")</span>
                                </button>
                            </div>
                        </div>
                        <FeedbackLine Ok="@_domainOkMessage" Error="@_domainErrMessage" />
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Let them in without approval"
                            Hint="Only works once email is set up on this site, so the address can be confirmed first. Otherwise new people wait for an admin.">
                    <Switch Checked="_autoJoinVerifiedDomainUsers" CheckedChanged="OnAutoJoinChangedAsync"
                            Disabled="@_savingAutoJoin"
                            Label="@(_autoJoinVerifiedDomainUsers ? "Join straight away" : "Wait for approval")" />
                    <FeedbackLine Ok="@_autoJoinOkMessage" Error="@_autoJoinErrMessage" />
                </SettingRow>

            </div>

            @* Its own block behind its own heading, because it saves differently:
               every row above writes the moment you touch it, and these four wait
               for the button in the card foot. The tenant list and the policy are
               one decision - half-saving them could lock the organisation out - so
               they cannot be folded into the instant-save list above. A shared list
               would have made a switch that does not stick look exactly like four
               that do. *@
            <div class="card__head">
                <div>
                    <h2 class="card__title">Microsoft sign-in</h2>
                    <p class="card__sub">Saves as one change, when you press Save below.</p>
                </div>
                @if (_entraEnabled)
                {
                    <StatusPill Tone="success">On</StatusPill>
                }
                else
                {
                    <StatusPill Tone="muted">Off</StatusPill>
                }
            </div>

            <div class="setting-list">
                <SettingRow Name="Sign in with Microsoft">
                    <HintContent>
                        Lets people here use their work Microsoft account instead of a
                        password. Only the Microsoft organisations listed below are let
                        in - everyone else is turned away.
                    </HintContent>
                    <ChildContent>
                        <Switch Checked="_entraEnabled"
                                CheckedChanged="@(v => _entraEnabled = v)"
                                Disabled="@(_savingEntra || (!_deploymentAppConfigured && string.IsNullOrWhiteSpace(_entraClientId)))"
                                Label="@(_entraEnabled ? "On" : "Off")" />
                        @if (!_deploymentAppConfigured && string.IsNullOrWhiteSpace(_entraClientId))
                        {
                            <span class="form-actions__note">
                                Can't be turned on until Microsoft sign-in is set up - by a site
                                administrator, or with your own registration below.
                            </span>
                        }
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Microsoft organisations allowed">
                    <HintContent>
                        Your company's Directory (tenant) ID, from the Overview page of the
                        Microsoft Entra admin center. Anyone from a Microsoft organisation
                        that isn't on this list is refused. Microsoft sign-in only links to
                        an existing account when Microsoft confirms the email, or when the
                        email domain is one this organisation has verified. Otherwise the
                        sign-in is refused and the person is told to ask you to verify
                        the domain.
                    </HintContent>
                    <ChildContent>
                        <div class="sub-rows sub-rows--plain">
                            @if (_entraTenantIds.Count == 0)
                            {
                                <p class="sub-rows__empty">
                                    Nothing listed yet - add the Microsoft organisation your
                                    colleagues sign in from.
                                </p>
                            }
                            else
                            {
                                @foreach (var tenantId in _entraTenantIds)
                                {
                                    <div class="sub-row">
                                        <span class="sub-row__val">@tenantId</span>
                                        <span class="sub-row__acts">
                                            <button type="button" class="btn btn--sm"
                                                    @onclick="() => RemoveTenantId(tenantId)" disabled="@_savingEntra">
                                                <Icon Name="trash-2" Width="14" Height="14" />
                                                <span>Remove</span>
                                            </button>
                                        </span>
                                    </div>
                                }
                            }
                            <div class="sub-rows__foot">
                                <label class="u-sr" for="entra-tenant">Microsoft organisation to add</label>
                                <input class="input" id="entra-tenant" type="text" maxlength="36"
                                       placeholder="e.g. 00000000-0000-0000-0000-000000000000"
                                       @bind="_newTenantId" @bind:event="oninput" />
                                <button type="button" class="btn"
                                        @onclick="AddTenantId"
                                        disabled="@(_savingEntra || string.IsNullOrWhiteSpace(_newTenantId))">
                                    <Icon Name="plus" Width="14" Height="14" />
                                    <span>Add</span>
                                </button>
                            </div>
                        </div>
                        @if (_entraEnabled && _entraTenantIds.Count == 0)
                        {
                            <FieldError Message="Add at least one before you can turn Microsoft sign-in on." />
                        }
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="How people sign in"
                            Danger="@(_entraOnlyPolicy && !_baseEntraOnlyPolicy)"
                            Lock="@(_entraOnlyPolicy && !_baseEntraOnlyPolicy ? "Asks you to confirm before saving" : null)">
                    <HintContent>
                        Turning passwords off applies to everyone here. Site administrators
                        keep their password as a way back in.
                    </HintContent>
                    <ChildContent>
                        <div class="check-list">
                            <label class="check @(_entraOnlyPolicy ? "" : "is-checked")">
                                <input type="radio" name="entra-policy" checked="@(!_entraOnlyPolicy)"
                                       @onchange="() => _entraOnlyPolicy = false" disabled="@_savingEntra" />
                                <span class="check__dot"></span>
                                <span>Any way they like - password, email link, passkey or Microsoft</span>
                            </label>
                            <label class="check @(_entraOnlyPolicy ? "is-checked" : "") @(_adminHasEntraLink ? "" : "is-disabled")">
                                <input type="radio" name="entra-policy" checked="@_entraOnlyPolicy"
                                       @onchange="() => _entraOnlyPolicy = true"
                                       disabled="@(_savingEntra || !_adminHasEntraLink)" />
                                <span class="check__dot"></span>
                                <span>Microsoft or a passkey only - no passwords, no email links</span>
                            </label>
                        </div>
                        @if (!_adminHasEntraLink)
                        {
                            <span class="form-actions__note">
                                Before you can turn passwords off, an admin has to connect their
                                own Microsoft account on <a href="/account?section=security">your
                                account page</a>. Otherwise everyone would be locked out.
                            </span>
                        }
                        else if (_entraOnlyPolicy && !_baseEntraOnlyPolicy && _membersWithoutLink > 0)
                        {
                            @* Blast radius, before the confirm dialog repeats it. *@
                            <FieldError>
                                @_membersWithoutLink of @_membersTotal people here haven't connected a
                                Microsoft account yet and won't be able to sign in once you save.
                                <a href="/admin/administration/users">See who</a>.
                            </FieldError>
                        }
                        else if (_membersWithoutLink > 0)
                        {
                            @* The same count, stated as a fact, *before* the second
                               option is chosen. Showing it only afterwards made the
                               admin pick the radio to find out what it would cost. *@
                            <span class="form-actions__note">
                                @(_membersTotal - _membersWithoutLink) of @_membersTotal people here have
                                connected a Microsoft account. The other @_membersWithoutLink could not sign
                                in under the second option.
                            </span>
                        }
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Your own Microsoft app registration">
                    <HintContent>
                        Optional. Sign-in normally runs through the registration a site
                        administrator set up, and the list above is all you need.
                    </HintContent>
                    <ChildContent>
                        <details class="hint-details" open="@(!string.IsNullOrEmpty(_entraClientId))">
                            <summary>
                                <Icon Name="key-round" Width="14" Height="14" />
                                <span>Use my own registration instead</span>
                            </summary>
                            <p class="hint-details__intro">
                                Fill this in only if your security policy needs the app
                                registration to live in your own Microsoft organisation. When you
                                create it, add a <strong>Web</strong> platform with this
                                <strong>Redirect URI</strong>:
                                <code class="code">@RedirectUri</code>.
                                Under Token configuration, add <strong>auth_time</strong> as an
                                optional ID token claim: it lets AL Workbench check that a
                                "confirm it's you" Microsoft sign-in really happened just now.
                            </p>
                            <div class="field">
                                <label class="field__label" for="entra-client-id">Application (client) ID</label>
                                <input class="input" id="entra-client-id" type="text" maxlength="36"
                                       placeholder="e.g. 00000000-0000-0000-0000-000000000000"
                                       @bind="_entraClientId" @bind:event="oninput" />
                                <span class="field__hint">Leave this blank to use the registration set up for the whole site.</span>
                            </div>
                            <div class="field">
                                <label class="field__label" for="entra-client-secret">Client secret</label>
                                <input class="input" id="entra-client-secret" type="password" autocomplete="off"
                                       placeholder="@(_entraHasSecret ? "Unchanged" : "Paste the secret value")"
                                       @bind="_entraClientSecret" @bind:event="oninput" />
                                <span class="field__hint">Stored encrypted. Leave blank to keep the one already saved.</span>
                            </div>
                        </details>
                        <FeedbackLine Ok="@_entraOkMessage" Error="@_entraErrMessage" />
                    </ChildContent>
                </SettingRow>
            </div>
        }
    </Body>
    <Foot>
        @if (!_loading)
        {
            @* The note sits beside the button, not up on the tab row: a disabled
               primary with no reason next to it is the thing an admin stares at.
               Whichever of the three conditions is holding the save back says so
               here, where the button is. *@
            <span class="form-actions__note">@SaveNote</span>
            <button type="button" class="btn btn--primary"
                    @onclick="SaveEntraAsync"
                    disabled="@(_savingEntra || !IsEntraDirty || (_entraEnabled && _entraTenantIds.Count == 0))">
                <Icon Name="save" Width="16" Height="16" />
                <span>@(_savingEntra ? "Saving..." : "Save Microsoft sign-in")</span>
            </button>
        }
    </Foot>
    <Aside>
        <section class="card">
            <div class="card__head"><div><h2 class="card__title">Who can get in</h2></div></div>
            <div class="card__body settings-aside__body">
                <a class="btn btn--sm" href="/admin/administration/users">
                    <Icon Name="users" Width="14" Height="14" />
                    <span>Manage users</span>
                </a>
            </div>
        </section>
        @if (!_loading)
        {
            @* Whether Microsoft sign-in is even available to switch on is set
               by a site administrator, not here - so say which it is before an
               admin wonders why the toggle refuses. *@
            <Alert Tone="@(_deploymentAppConfigured ? AlertTone.Success : AlertTone.Info)" Role="status">
                <span>
                    @(_deploymentAppConfigured
                        ? "Microsoft sign-in is set up on this site. All you need is the list of Microsoft organisations below."
                        : "Microsoft sign-in isn't set up on this site yet. Ask a site administrator to set it up, or use your own registration below.")
                </span>
            </Alert>
        }
        <Alert Tone="AlertTone.Info">
            <span>Everything on this page applies to this organisation only.</span>
        </Alert>
    </Aside>
</AdministrationHeader>

<ConfirmDialog @ref="_confirmEntraOnly" />

@code {
    private bool _loading = true;
    private bool _savingName;
    private bool _savingDomain;
    private bool _savingStrongAuth;
    private bool _savingAutoJoin;
    private bool _savingTimeZone;
    private string? _timeZoneOkMessage;
    private string? _timeZoneErrMessage;
    private string? _timeZoneId;
    private List<(string Id, string Label)> _timeZoneOptions = new();
    private string? _nameOkMessage;
    private string? _nameErrMessage;
    private string? _domainOkMessage;
    private string? _domainErrMessage;
    private string? _strongAuthOkMessage;
    private string? _strongAuthErrMessage;
    private string? _autoJoinOkMessage;
    private string? _autoJoinErrMessage;

    private string _name = string.Empty;
    private string _baseName = string.Empty;
    private string _slug = string.Empty;
    private string _newDomain = string.Empty;
    private bool _requireStrongAuth;
    private bool _autoJoinVerifiedDomainUsers;
    private List<OrganizationEmailDomain> _domains = new();

    private bool _savingEntra;
    private string? _entraOkMessage;
    private string? _entraErrMessage;
    private bool _entraEnabled;
    private List<string> _entraTenantIds = new();
    private string _newTenantId = string.Empty;
    private string _entraClientId = string.Empty;
    private string _entraClientSecret = string.Empty;
    private bool _entraHasSecret;
    private bool _deploymentAppConfigured;
    private bool _adminHasEntraLink;
    private int _membersTotal;
    private int _membersWithoutLink;
    private ConfirmDialog? _confirmEntraOnly;
    private bool _entraOnlyPolicy;
    private bool _baseEntraEnabled;
    private bool _baseEntraOnlyPolicy;
    private List<string> _baseEntraTenantIds = new();
    private string _baseEntraClientId = string.Empty;

    /// <summary>
    /// The section saves explicitly (unlike the toggle-to-save checkboxes
    /// above), so the pending state must be visible: this drives the "Not
    /// saved yet" caption and the Save button's enabled state.
    /// </summary>
    private bool IsEntraDirty =>
        _entraEnabled != _baseEntraEnabled
        || _entraOnlyPolicy != _baseEntraOnlyPolicy
        || !_entraTenantIds.SequenceEqual(_baseEntraTenantIds)
        || _entraClientId.Trim().ToLowerInvariant() != _baseEntraClientId
        || _entraClientSecret.Length > 0;

    private string RedirectUri => Nav.BaseUri.TrimEnd('/') + "/signin-microsoft";

    /// <summary>
    /// Why the Save button is off, in the order the admin hits the conditions.
    /// A disabled primary that says nothing is a dead end; this is what stands
    /// next to it.
    /// </summary>
    private string SaveNote =>
        _entraEnabled && _entraTenantIds.Count == 0
            ? "List at least one Microsoft organisation before saving."
            : IsEntraDirty
                ? "Not saved yet."
                : "Everything above this heading saves on its own.";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var identity = await OrgAdmin.GetIdentityViewAsync();
        _name = _baseName = identity.Name;
        _slug = identity.Slug;
        _requireStrongAuth = identity.RequireStrongAuth;
        _autoJoinVerifiedDomainUsers = identity.AutoJoinVerifiedDomainUsers;
        _timeZoneId = identity.DisplayTimeZoneId;
        _timeZoneOptions = BuildTimeZoneOptions(_timeZoneId);
        _domains = await OrgAdmin.ListEmailDomainsAsync();
        ApplyEntraView(await OrgAdmin.GetEntraViewAsync());
        // Blast-radius numbers for the Microsoft-only policy: who would lose
        // password sign-in.
        _adminHasEntraLink = identity.AdminHasEntraLink;
        _membersTotal = identity.MembersTotal;
        _membersWithoutLink = identity.MembersWithoutEntraLink;
        _loading = false;
    }

    private void ApplyEntraView(OrgEntraView view)
    {
        _entraEnabled = _baseEntraEnabled = view.Enabled;
        _entraTenantIds = view.AllowedTenantIds.ToList();
        _baseEntraTenantIds = view.AllowedTenantIds.ToList();
        _entraClientId = _baseEntraClientId = view.ClientId ?? string.Empty;
        _entraHasSecret = view.HasClientSecret;
        _deploymentAppConfigured = view.DeploymentAppConfigured;
        _entraOnlyPolicy = _baseEntraOnlyPolicy = view.LocalLoginPolicy == LocalLoginPolicy.EntraOnly;
    }

    private void AddTenantId()
    {
        var trimmed = _newTenantId.Trim().ToLowerInvariant();
        if (trimmed.Length == 0) return;
        _entraErrMessage = null;
        if (!Guid.TryParse(trimmed, out _))
        {
            // Instant feedback; SaveEntraAsync re-validates server-side.
            _entraErrMessage = $"'{trimmed}' is not a Microsoft organisation ID. Copy the Directory (tenant) ID from the Entra admin center - it looks like 00000000-0000-0000-0000-000000000000.";
            return;
        }
        if (!_entraTenantIds.Contains(trimmed)) _entraTenantIds.Add(trimmed);
        _newTenantId = string.Empty;
    }

    private void RemoveTenantId(string tenantId)
    {
        _entraTenantIds.Remove(tenantId);
    }

    private async Task SaveEntraAsync()
    {
        if (_savingEntra) return;
        // Flipping to Microsoft-only cuts off password sign-in for the whole
        // org - destructive enough for a confirm step.
        if (_entraOnlyPolicy && !_baseEntraOnlyPolicy && _confirmEntraOnly is not null)
        {
            var detail = _membersWithoutLink > 0
                ? $" {_membersWithoutLink} of {_membersTotal} members haven't connected a Microsoft account yet and won't be able to sign in until they do."
                : string.Empty;
            var confirmed = await _confirmEntraOnly.OpenAsync(
                title: $"Turn off password sign-in for {_baseName}?",
                message: $"Everyone in this organisation will sign in with Microsoft (or a passkey) from now on.{detail}",
                confirmLabel: "Turn off passwords");
            if (!confirmed) return;
        }
        _savingEntra = true;
        _entraOkMessage = null;
        _entraErrMessage = null;
        try
        {
            await OrgAdmin.SaveEntraAsync(new OrgEntraInput(
                Enabled: _entraEnabled,
                AllowedTenantIds: _entraTenantIds,
                ClientId: _entraClientId,
                ClientSecret: _entraClientSecret,
                ClearClientSecret: false,
                LocalLoginPolicy: _entraOnlyPolicy ? LocalLoginPolicy.EntraOnly : LocalLoginPolicy.AllowAll));
            _entraClientSecret = string.Empty;
            ApplyEntraView(await OrgAdmin.GetEntraViewAsync());
            _entraOkMessage = _entraEnabled
                ? "Saved. People from the Microsoft organisations you listed can now choose \"Sign in with Microsoft\" when they sign in."
                : "Saved. Microsoft sign-in is off.";
        }
        catch (PlanValidationException ex)
        {
            _entraErrMessage = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save Microsoft sign-in settings.");
            _entraErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingEntra = false;
        }
    }

    /// <summary>
    /// The switch reports the value it moved to rather than writing a bound
    /// field, so a failed save can put it back where it was without the two
    /// ever disagreeing.
    /// </summary>
    private async Task OnStrongAuthChangedAsync(bool next)
    {
        if (_savingStrongAuth) return;
        _requireStrongAuth = next;
        _savingStrongAuth = true;
        _strongAuthOkMessage = null;
        _strongAuthErrMessage = null;
        try
        {
            await OrgAdmin.SetRequireStrongAuthAsync(_requireStrongAuth);
            _strongAuthOkMessage = _requireStrongAuth
                ? "Everyone here now needs a second step to sign in. Anyone who has not set one up will be asked to next time they use the site."
                : "A second step is no longer required.";
        }
        catch (PlanValidationException ex)
        {
            // Revert the toggle so the UI reflects the unchanged DB state.
            _requireStrongAuth = !_requireStrongAuth;
            _strongAuthErrMessage = ex.Errors.FirstOrDefault().Value ?? "That did not save. Check the value and try again.";
        }
        catch (Exception ex)
        {
            _requireStrongAuth = !_requireStrongAuth;
            Log.LogError(ex, "Failed to toggle strong-auth requirement.");
            _strongAuthErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingStrongAuth = false;
        }
    }

    /// <summary>
    /// The zones on offer, labelled with their offset today. A saved id that is
    /// not among them (an alias typed in before this list existed) is kept at
    /// the top so the select still shows what is stored.
    /// </summary>
    private static List<(string Id, string Label)> BuildTimeZoneOptions(string? savedId)
    {
        var now = DateTime.UtcNow;
        var options = DisplayTimeZone.SelectableZones()
            .Select(z => (z.Id, DisplayTimeZone.Label(z, now)))
            .ToList();
        if (!string.IsNullOrEmpty(savedId) && options.All(o => o.Id != savedId)
            && TimeZoneInfo.TryFindSystemTimeZoneById(savedId, out var saved))
        {
            options.Insert(0, (savedId, DisplayTimeZone.Label(saved, now)));
        }
        return options;
    }

    /// <summary>
    /// Saves as soon as a zone is picked, like the switches around it. A refused
    /// value puts the select back on the zone that is still stored.
    /// </summary>
    private async Task OnTimeZoneChangedAsync(ChangeEventArgs e)
    {
        if (_savingTimeZone) return;
        var previous = _timeZoneId;
        var next = e.Value as string;
        _timeZoneId = string.IsNullOrEmpty(next) ? null : next;
        _savingTimeZone = true;
        _timeZoneOkMessage = null;
        _timeZoneErrMessage = null;
        try
        {
            await OrgAdmin.SetDisplayTimeZoneAsync(_timeZoneId);
            // This circuit read the old zone already; the next page load picks up the new one anyway.
            DisplayTimeZone.Invalidate();
            _timeZoneOkMessage = _timeZoneId is null
                ? "Times are shown in UTC from the next page you open."
                : $"Times are shown in {_timeZoneId} from the next page you open.";
        }
        catch (PlanValidationException ex)
        {
            _timeZoneId = previous;
            _timeZoneErrMessage = ex.Errors.FirstOrDefault().Value ?? "That did not save. Pick a zone from the list.";
        }
        catch (Exception ex)
        {
            _timeZoneId = previous;
            Log.LogError(ex, "Failed to save the display time zone.");
            _timeZoneErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingTimeZone = false;
        }
    }

    private async Task OnAutoJoinChangedAsync(bool next)
    {
        if (_savingAutoJoin) return;
        _autoJoinVerifiedDomainUsers = next;
        _savingAutoJoin = true;
        _autoJoinOkMessage = null;
        _autoJoinErrMessage = null;
        try
        {
            await OrgAdmin.SetAutoJoinVerifiedDomainUsersAsync(_autoJoinVerifiedDomainUsers);
            _autoJoinOkMessage = _autoJoinVerifiedDomainUsers
                ? "People signing up with an address at your domains will join straight away, once they have confirmed their email."
                : "New people from your domains will wait for an admin to approve them.";
        }
        catch (Exception ex)
        {
            // Revert the toggle so the UI reflects the unchanged DB state.
            _autoJoinVerifiedDomainUsers = !_autoJoinVerifiedDomainUsers;
            Log.LogError(ex, "Failed to toggle auto-join for verified domain users.");
            _autoJoinErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingAutoJoin = false;
        }
    }

    private async Task SaveNameAsync()
    {
        if (_savingName || _name == _baseName) return;
        _savingName = true;
        _nameOkMessage = null;
        _nameErrMessage = null;
        try
        {
            await Branding.RenameOrganizationAsync(_name);
            _baseName = _name.Trim();
            _name = _baseName;
            _nameOkMessage = "Renamed. The new name shows up the next time a page loads - nobody has to sign out.";
        }
        catch (PlanValidationException ex)
        {
            _nameErrMessage = ex.Errors.FirstOrDefault().Value ?? "That did not save. Check the value and try again.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to rename organisation.");
            _nameErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingName = false;
        }
    }

    private async Task AddAsync()
    {
        if (_savingDomain) return;
        _savingDomain = true;
        _domainOkMessage = null;
        _domainErrMessage = null;
        try
        {
            await OrgAdmin.AddEmailDomainAsync(_newDomain);
            _newDomain = string.Empty;
            _domains = await OrgAdmin.ListEmailDomainsAsync();
            _domainOkMessage = "Domain added.";
        }
        catch (PlanValidationException ex)
        {
            _domainErrMessage = ex.Errors.FirstOrDefault().Value ?? "That did not save. Check the value and try again.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to add email domain.");
            _domainErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingDomain = false;
        }
    }

    private async Task RemoveAsync(int domainId)
    {
        if (_savingDomain) return;
        _savingDomain = true;
        _domainOkMessage = null;
        _domainErrMessage = null;
        try
        {
            await OrgAdmin.RemoveEmailDomainAsync(domainId);
            _domains = await OrgAdmin.ListEmailDomainsAsync();
            _domainOkMessage = "Domain removed.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to remove email domain.");
            _domainErrMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingDomain = false;
        }
    }
}
