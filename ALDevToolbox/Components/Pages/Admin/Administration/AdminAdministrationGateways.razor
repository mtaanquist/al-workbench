@page "/admin/administration/gateways"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IDisposable
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Endpoints
@using ALDevToolbox.Services.Gateways
@using ALWorkbench.Gateway.Contracts
@inject GatewayService Gateways
@inject GatewayBuild Build
@inject PublicOrigin Origin
@inject NavigationManager Nav
@inject IServiceScopeFactory ScopeFactory
@inject TimeProvider Clock
@inject ILogger<AdminAdministrationGateways> Log

@*
    Gateways tab of the Administration surface (.design/on-prem-gateway.md).

    Named user: an org Admin setting up the first gateway for a customer whose
    Business Central runs in their own network, working with that customer's IT,
    who installs it on a Windows server there. They know Business Central; they
    have never seen a gateway. Primary action: Add gateway, which shows a one-time
    code and the command to run on the server. The second step that matters is
    Approve, after comparing the code the server printed with the one shown here -
    so a pending gateway carries that button on its row, not in the menu.

    The gateway itself is downloaded from the GitHub release that matches this
    AL Workbench (GatewayDownloadLink), with its SHA-256 for customer IT to check.
    A row whose gateway is older than this AL Workbench says "Out of date", or
    "Unsupported" when AL Workbench refuses it; the download card under the list
    says how to update one. No second primary button: the download is an outline
    link, Add gateway stays the one primary.
*@

<PageTitle>Gateways · Administration · AL Workbench</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.Gateways">
    <Actions>
        @if (_gateways is { Count: > 0 } && _issued is null)
        {
            <button type="button" class="btn btn--sm btn--primary" @onclick="AddGatewayAsync" disabled="@_busy">
                <Icon Name="plus" Width="14" Height="14" />
                <span>Add gateway</span>
            </button>
        }
    </Actions>
    <Body>
        @if (_error is not null)
        {
            <Alert Tone="AlertTone.Danger"><span>@_error</span></Alert>
        }
        @if (_success is not null)
        {
            <Alert Tone="AlertTone.Success"><span>@_success</span></Alert>
        }

        @if (_issued is not null)
        {
            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">@(_issuedFor is null ? "Register the new gateway" : $"Re-register {_issuedFor}")</h2>
                        <p class="card__sub">
                            Works once, until <Timestamp Value="@_issued.ExpiresAt" Format="HH:mm" />.
                            This code is shown only now - if you lose it, create a new one.
                        </p>
                    </div>
                </div>
                <div class="card__body">
                    <ol class="gw-steps">
                        @if (_issuedFor is null)
                        {
                            <li>
                                Download the AL Workbench Gateway and copy it to a folder on a Windows server in the
                                customer's network that can reach Business Central.
                                <GatewayDownloadLink IdPrefix="gw-add" />
                            </li>
                        }
                        <li>
                            On that server, open a command prompt as an administrator and run this command:
                            <div class="code-block code-block--inlinebar">
                                <pre id="gateway-register-command">@RegisterCommand</pre>
                                <CopyButton Target="#gateway-register-command" />
                            </div>
                        </li>
                        <li>Approve it here, once the check code the server prints matches the check code that will appear below.</li>
                    </ol>
                    @if (_registered is null)
                    {
                        <p class="u-muted" role="status">Waiting for the server to register...</p>
                    }
                    else
                    {
                        <p role="status"><strong>@_registered</strong> has registered. Check its code below and approve it.</p>
                    }
                </div>
                <div class="card__foot">
                    <button type="button" class="btn" @onclick="CloseCode">
                        <Icon Name="check" Width="16" Height="16" />
                        <span>Close</span>
                    </button>
                </div>
            </section>
        }

        @if (_gateways is null)
        {
            <LoadingBlock Text="Loading gateways..." />
        }
        else if (_gateways.Count == 0)
        {
            @if (_issued is null)
            {
                <div class="card">
                    <EmptyState Icon="server" Title="No gateways yet">
                        <Text>
                            A gateway lets AL Workbench manage Business Central servers in a
                            customer's own network, without opening their firewall.
                            Add one to get a one-time code that connects it to AL Workbench.
                            <ol class="gw-steps gw-steps--empty">
                                <li>Download the AL Workbench Gateway onto a Windows server in the customer's network that can reach Business Central.</li>
                                <li>On that server, run the command you get when you add the gateway.</li>
                                <li>Approve it here.</li>
                            </ol>
                        </Text>
                        <Action>
                            <button type="button" class="btn btn--primary" @onclick="AddGatewayAsync" disabled="@_busy">
                                <Icon Name="plus" Width="15" Height="15" />
                                <span>Add gateway</span>
                            </button>
                        </Action>
                    </EmptyState>
                </div>
            }
        }
        else
        {
            <section class="card">
                <div class="card__head"><h2 class="card__title">Gateways (@_gateways.Count)</h2></div>
                @* Scrolls sideways inside the card on a phone rather than running
                   off the screen with the Approve button out of reach. *@
                <div class="gw-table">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Gateway</th>
                            <th scope="col">Status</th>
                            <th scope="col">Last seen</th>
                            <th scope="col" class="gw-col-version">Version</th>
                            <th scope="col" class="data-table__actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var g in _gateways)
                    {
                        var gateway = g;
                        <tr>
                            <td>
                                @* Its own page lists the service tiers it reports. *@
                                <a class="u-nowrap" href="@($"/admin/administration/gateways/{gateway.Id}")">@gateway.Name</a>
                                @if (!string.Equals(gateway.Name, gateway.MachineName, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="u-muted">on <span class="u-nowrap">@gateway.MachineName</span></div>
                                }
                            </td>
                            <td>
                                @* On a phone the column headers are hidden, so the cell says what the pill is. *@
                                <span class="gw-label-narrow">Status: </span>
                                <StatusPill Tone="@ToneOf(gateway.Status)">@LabelOf(gateway.Status)</StatusPill>
                                @if (gateway.Status == GatewayStatus.WaitingForApproval)
                                {
                                    <div class="u-muted">Check code <span class="code u-nowrap">@gateway.KeyFingerprint</span></div>
                                }
                                else if (gateway.Status == GatewayStatus.NotConnectedYet)
                                {
                                    <div class="u-muted">Start the AL Workbench Gateway service on the server</div>
                                }
                                @if (gateway.ReportedVersion is not null)
                                {
                                    @* Takes the Version column's place on a phone, after the status. *@
                                    <div class="u-muted gw-version-inline">
                                        Version @gateway.ReportedVersion
                                        @VersionPill(gateway)
                                    </div>
                                }
                            </td>
                            <td class="u-muted">
                                @if (gateway.Status == GatewayStatus.WaitingForApproval && gateway.LastSeenAt is null)
                                {
                                    <span>Registered <Timestamp Value="@gateway.KeyRegisteredAt" Relative="true" /></span>
                                }
                                else
                                {
                                    @* The column header is hidden on a phone, so the cell says what it is. *@
                                    <span class="gw-label-narrow">Last seen: </span>
                                    <Timestamp Value="@gateway.LastSeenAt" Relative="true" Placeholder="@("Never")" />
                                }
                            </td>
                            <td class="u-muted gw-col-version">
                                <span class="u-nowrap">@(gateway.ReportedVersion ?? "-")</span>
                                @VersionPill(gateway)
                            </td>
                            <td class="data-table__actions">
                                @if (gateway.Status != GatewayStatus.Revoked)
                                {
                                    <span class="u-row">
                                        @if (gateway.Status == GatewayStatus.WaitingForApproval)
                                        {
                                            <button type="button" class="btn btn--sm" @onclick="() => ApproveAsync(gateway)" disabled="@_busy">
                                                <Icon Name="shield" Width="14" Height="14" />
                                                <span>Approve</span>
                                            </button>
                                        }
                                        <RowActions Label="@($"Actions for {gateway.Name}")">
                                            <button type="button" class="menu__item" role="menuitem" @onclick="() => RenameAsync(gateway)">
                                                <Icon Name="pencil" Width="14" Height="14" />
                                                <span>Rename</span>
                                            </button>
                                            <button type="button" class="menu__item" role="menuitem" @onclick="() => RotateAsync(gateway)">
                                                <Icon Name="key-round" Width="14" Height="14" />
                                                <span>Re-register</span>
                                            </button>
                                            <button type="button" class="menu__item menu__item--danger" role="menuitem" @onclick="() => RevokeAsync(gateway)">
                                                <Icon Name="shield-off" Width="14" Height="14" />
                                                <span>Revoke</span>
                                            </button>
                                        </RowActions>
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </section>

            <section class="card" id="gateway-download">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Download the gateway</h2>
                        @if (Build.Download is not null)
                        {
                            <p class="card__sub">For a new server, or to update a gateway that is out of date.</p>
                        }
                    </div>
                </div>
                <div class="card__body">
                    <GatewayDownloadLink IdPrefix="gw-card" />
                    @if (Build.Download is not null)
                    {
                        <p class="gw-update-title">To update a gateway, on its server:</p>
                        <ol class="gw-steps">
                            <li>Stop the AL Workbench Gateway service.</li>
                            <li>Replace <span class="code u-nowrap">@GatewayBuild.ExecutableName</span> with the one you downloaded.</li>
                            <li>Start the service again. Its registration and settings are kept, so there is nothing to approve.</li>
                        </ol>
                    }
                </div>
            </section>
        }
    </Body>
</AdministrationHeader>

<ConfirmDialog @ref="_approveDialog" Title="Approve this gateway?" ConfirmLabel="Approve gateway"
               ConfirmButtonClass="btn--primary" ConfirmIcon="shield" HeadIcon="shield">
    @if (_target is not null)
    {
        <p>
            When <strong>@_target.MachineName</strong> registered, the gateway printed a check code on
            that server. Approve only if it is exactly this one:
        </p>
        <p class="gw-check"><span class="code">@_target.KeyFingerprint</span></p>
        <p class="u-muted">
            If the codes differ, or nobody you know installed this gateway, revoke it instead.
        </p>
    }
</ConfirmDialog>

<ConfirmDialog @ref="_revokeDialog" />

<ConfirmDialog @ref="_rotateDialog" />

<ConfirmDialog @ref="_renameDialog" Title="Rename gateway" ConfirmLabel="Rename"
               ConfirmButtonClass="btn--primary" HeadIcon="pencil"
               ConfirmDisabled="@string.IsNullOrWhiteSpace(_nameDraft)">
    <div class="field">
        <label class="field__label" for="gateway-name">Name</label>
        <input class="input" type="text" id="gateway-name" @bind="_nameDraft" @bind:event="oninput"
               maxlength="@GatewayService.MaxNameLength" required placeholder="e.g. CRONUS server room" />
        <span class="field__hint">How the gateway is listed here. The server's own name does not change.</span>
    </div>
</ConfirmDialog>

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(3);

    private List<GatewaySummary>? _gateways;
    private IssuedGatewayCode? _issued;
    private string? _issuedFor;
    private int? _issuedForId;
    /// <summary>Name of the gateway that used the open code, once one has.</summary>
    private string? _registered;
    /// <summary>Each gateway's key time when the code was shown, to spot the one that uses it.</summary>
    private Dictionary<int, DateTime> _keysWhenIssued = new();
    private PeriodicTimer? _poll;
    private CancellationTokenSource? _pollCts;
    private GatewaySummary? _target;
    private string _nameDraft = string.Empty;
    private string? _error;
    private string? _success;
    private bool _busy;

    private ConfirmDialog _approveDialog = default!;
    private ConfirmDialog _revokeDialog = default!;
    private ConfirmDialog _rotateDialog = default!;
    private ConfirmDialog _renameDialog = default!;

    /// <summary>
    /// The address the gateway registers with: the configured public origin, else
    /// the one this page was opened on - the same rule the gateway handler uses for
    /// the token audience (<see cref="PublicOrigin.For"/>), so the two always agree.
    /// </summary>
    private string WorkbenchUrl => Origin.Configured ?? Nav.BaseUri.TrimEnd('/');

    private string RegisterCommand => $"ALWorkbench.Gateway register --url {WorkbenchUrl} --code {_issued?.Code}";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _gateways = await Gateways.ListAsync();

    private async Task AddGatewayAsync()
    {
        await RunAsync(async () =>
        {
            _issued = await Gateways.CreateRegistrationCodeAsync();
            _issuedFor = null;
            _issuedForId = null;
        });
        if (_issued is not null) StartWatching();
    }

    private void CloseCode()
    {
        StopWatching();
        _issued = null;
        _issuedFor = null;
        _issuedForId = null;
        _registered = null;
    }

    private async Task ApproveAsync(GatewaySummary gateway)
    {
        _target = gateway;
        if (!await _approveDialog.OpenAsync($"Approve {gateway.Name}?", string.Empty, "Approve gateway", "btn--primary", "shield")) return;
        await RunAsync(async () =>
        {
            // The fingerprint the Admin just compared: if the gateway registered a new
            // key since this list was read, the service refuses rather than approving it.
            await Gateways.ApproveAsync(gateway.Id, gateway.KeyFingerprint);
            _success = $"Approved. {gateway.Name} can now receive work from AL Workbench.";
        });
    }

    private async Task RevokeAsync(GatewaySummary gateway)
    {
        var confirmed = await _revokeDialog.OpenAsync(
            $"Revoke {gateway.Name}?",
            "AL Workbench will refuse everything this gateway sends from now on. This cannot be undone: "
            + "to use that server again, add it as a new gateway.",
            "Revoke gateway");
        if (!confirmed) return;
        await RunAsync(async () =>
        {
            await Gateways.RevokeAsync(gateway.Id);
            _success = $"{gateway.Name} is revoked.";
        });
    }

    private async Task RotateAsync(GatewaySummary gateway)
    {
        var confirmed = await _rotateDialog.OpenAsync(
            $"Re-register {gateway.Name}?",
            "Use this when the server was rebuilt, or you think the gateway's key may have been copied. "
            + "You get a new code to run on the server. The gateway keeps working until it registers with it; "
            + "after that it waits for your approval again.",
            "Create code", "btn--primary", "key-round");
        if (!confirmed) return;
        await RunAsync(async () =>
        {
            _issued = await Gateways.CreateRotationCodeAsync(gateway.Id);
            _issuedFor = gateway.Name;
            _issuedForId = gateway.Id;
        });
        if (_issued is not null) StartWatching();
    }

    private async Task RenameAsync(GatewaySummary gateway)
    {
        _nameDraft = gateway.Name;
        if (!await _renameDialog.OpenAsync()) return;
        await RunAsync(async () =>
        {
            await Gateways.RenameAsync(gateway.Id, _nameDraft);
            _success = $"Renamed to {_nameDraft.Trim()}.";
        });
    }

    /// <summary>
    /// While the code card is open, re-reads the list every few seconds so the
    /// gateway appears (waiting for approval) without a reload. Stops once it has,
    /// when the code expires, or when the card is closed or the page left.
    /// </summary>
    private void StartWatching()
    {
        StopWatching();
        _registered = null;
        _keysWhenIssued = (_gateways ?? []).ToDictionary(g => g.Id, g => g.KeyRegisteredAt);
        _pollCts = new CancellationTokenSource();
        _poll = new PeriodicTimer(PollInterval);
        _ = WatchAsync(_poll, _issued!.ExpiresAt, _issuedForId, _pollCts.Token);
    }

    private async Task WatchAsync(PeriodicTimer timer, DateTime expiresAt, int? rotatingId, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                // Own DI scope per tick: this runs off the circuit's dispatcher, and the
                // page's own GatewayService shares the circuit's DbContext with clicks (#679).
                List<GatewaySummary> list;
                await using (var scope = ScopeFactory.CreateAsyncScope())
                {
                    list = await scope.ServiceProvider.GetRequiredService<GatewayService>().ListAsync(token);
                }
                if (token.IsCancellationRequested) break;

                // A new code is used by a gateway that was not in the list; a re-register
                // code by the same gateway, which then carries a newer key.
                var arrived = list.FirstOrDefault(g => rotatingId is { } id
                    ? g.Id == id && _keysWhenIssued.TryGetValue(id, out var before) && g.KeyRegisteredAt != before
                    : !_keysWhenIssued.ContainsKey(g.Id));
                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested) return;
                    _gateways = list;
                    if (arrived is not null) _registered = arrived.Name;
                    StateHasChanged();
                });
                if (arrived is not null || Clock.GetUtcNow().UtcDateTime >= expiresAt) break;
            }
        }
        catch (OperationCanceledException) { /* card closed or circuit torn down */ }
        catch (ObjectDisposedException) when (token.IsCancellationRequested) { /* torn down mid-poll */ }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Refreshing the gateway list failed; it stops refreshing until the page is reloaded.");
        }
    }

    private void StopWatching()
    {
        var cts = Interlocked.Exchange(ref _pollCts, null);
        var timer = Interlocked.Exchange(ref _poll, null);
        try { cts?.Cancel(); } catch (ObjectDisposedException) { /* already gone */ }
        cts?.Dispose();
        timer?.Dispose();
    }

    public void Dispose() => StopWatching();

    /// <summary>One action at a time, its outcome in the alert, and the list re-read after.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _success = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (PlanValidationException ex)
        {
            _error = string.Join(" ", ex.Errors.Values);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogError(ex, "Gateway action failed.");
            _error = "That did not work. Try again, and if it keeps failing, ask your site administrator to check the log.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// "Out of date" while a newer gateway is offered, "Unsupported" once AL Workbench
    /// refuses it; nothing for a current, preview or unknown version.
    /// </summary>
    private RenderFragment? VersionPill(GatewaySummary gateway) => Build.StateOf(gateway.ReportedVersion) switch
    {
        GatewayVersionState.OutOfDate => @<span class="gw-version-state">
            <StatusPill Tone="warn">Out of date</StatusPill>
            <a href="#gateway-download">Update to @Build.ExpectedVersion</a>
        </span>,
        GatewayVersionState.Unsupported when Build.Download is not null => @<span class="gw-version-state">
            <StatusPill Tone="danger">Unsupported</StatusPill>
            <span>AL Workbench refuses this version. <a href="#gateway-download">Update it</a></span>
        </span>,
        // A local or staging AL Workbench has nothing to download, so nothing to link to.
        GatewayVersionState.Unsupported => @<span class="gw-version-state">
            <StatusPill Tone="danger">Unsupported</StatusPill>
            <span>AL Workbench refuses this version. Ask whoever runs AL Workbench for gateway version @GatewayProtocol.MinimumGatewayVersion or later.</span>
        </span>,
        _ => null,
    };

    private static string ToneOf(GatewayStatus status) => GatewayStatusText.ToneOf(status);

    private static string LabelOf(GatewayStatus status) => GatewayStatusText.LabelOf(status);
}
