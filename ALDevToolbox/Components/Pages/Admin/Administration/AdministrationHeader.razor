@*
    The /admin/administration/* family on page archetype 7, the same one
    /site-admin/settings/* uses. Fills in the crumbs, title, description and
    tab row; a page supplies its own rows, save button and aside.

    It kept the name it had when it rendered only a <header>, because every
    page in the family references it and the rename would be the whole diff.
    What it renders now is the page.
*@

@using ALDevToolbox.Components.Shared

<SettingsPage Title="Administration"
              CrumbLabel="Admin" CrumbHref="/admin"
              Tabs="@_tabs" TabsLabel="Administration sections"
              Alerts="@Alerts" Body="@Body" Foot="@Foot" Aside="@Aside" TabNote="@TabNote"
              HeadActions="@Actions">
    <Sub>Settings for this organisation only. Nothing here affects other organisations.</Sub>
</SettingsPage>

@code {
    public enum Tab { Identity, Tools, Translation, Repositories, BusinessCentral, Gateways, Users, Teams, OAuthClients, Export }

    [Parameter, EditorRequired] public Tab ActiveTab { get; set; }

    /// <summary>Page-head buttons. Reserved for actions that are not "save this
    /// page" - the save button belongs in <see cref="Foot"/>.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? Alerts { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Foot { get; set; }
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public RenderFragment? TabNote { get; set; }

    private IReadOnlyList<HeaderTabs.HeaderTabItem> _tabs = Array.Empty<HeaderTabs.HeaderTabItem>();

    protected override void OnParametersSet()
    {
        _tabs = new[]
        {
            new HeaderTabs.HeaderTabItem("Identity",      "/admin/administration/identity",      ActiveTab == Tab.Identity),
            new HeaderTabs.HeaderTabItem("Tools",         "/admin/administration/tools",         ActiveTab == Tab.Tools),
            new HeaderTabs.HeaderTabItem("Translation",   "/admin/administration/translation",   ActiveTab == Tab.Translation),
            new HeaderTabs.HeaderTabItem("Repositories",  "/admin/administration/repositories",  ActiveTab == Tab.Repositories),
            new HeaderTabs.HeaderTabItem("Business Central", "/admin/administration/business-central", ActiveTab == Tab.BusinessCentral),
            new HeaderTabs.HeaderTabItem("Gateways",      "/admin/administration/gateways",      ActiveTab == Tab.Gateways),
            new HeaderTabs.HeaderTabItem("Users",         "/admin/administration/users",         ActiveTab == Tab.Users),
            new HeaderTabs.HeaderTabItem("Teams",         "/admin/administration/teams",         ActiveTab == Tab.Teams),
            new HeaderTabs.HeaderTabItem("OAuth clients", "/admin/administration/oauth-clients", ActiveTab == Tab.OAuthClients),
            new HeaderTabs.HeaderTabItem("Export",        "/admin/administration/export",        ActiveTab == Tab.Export),
        };
    }
}
