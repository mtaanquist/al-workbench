@page "/admin/administration/business-central"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ALDevToolbox.Services.Organizations.OrganizationAdminService OrgAdmin
@inject ILogger<AdminAdministrationBusinessCentral> Log
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using ALDevToolbox.Services.Organizations

@*
    The organisation's own app registration for reaching customers' Business Central.
    One registration serves every customer, because each customer authorises it in
    their own admin center; a solution then needs only a tenant ID, and one that has a
    registration of its own overrides this on its Business Central tab.

    Named user: the administrator of a partner that looks after many customers, setting
    this up once - and coming back every year or two when the secret is about to expire.

    The secret is encrypted with the Data Protection key ring and never shown again.
    See .design/saas-delivery.md, "Authentication".
*@

<PageTitle>Business Central · Administration · AL Workbench</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.BusinessCentral">
    <Alerts>
        @if (!string.IsNullOrEmpty(_okMessage))
        {
            <Alert Tone="AlertTone.Success"><span>@_okMessage</span></Alert>
        }
        @if (!string.IsNullOrEmpty(_errMessage))
        {
            <Alert Tone="AlertTone.Danger"><span>@_errMessage</span></Alert>
        }
        @if (_view?.SecretExpiresAt is { } expiry && _view.IsConfigured && expiry <= DateTime.UtcNow.AddDays(30))
        {
            <Alert Tone="@(expiry <= DateTime.UtcNow ? AlertTone.Danger : AlertTone.Warn)">
                <span>
                    @(expiry <= DateTime.UtcNow
                        ? $"The client secret expired on {expiry:d MMM yyyy}."
                        : $"The client secret expires on {expiry:d MMM yyyy}.")
                    @ExpiryConsequence(_view.SolutionsUsingIt, expiry <= DateTime.UtcNow)
                    Create a new secret in Entra and enter it below.
                </span>
            </Alert>
        }
    </Alerts>
    <Body>
        @if (_loading)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            @* Two blocks behind two headings because they save differently: the delivery
               windows write as soon as a pair is complete, and the app registration waits
               for the button in the foot. The instant block comes first so that button sits
               directly under the rows it saves - the same split, in the same order, as
               Identity's Microsoft sign-in block. The frame has one card, so the heading is
               the boundary. Issue #962. *@
            <div class="card__head">
                <div>
                    <h2 class="card__title">Delivery windows for new environments</h2>
                    <p class="card__sub">@WindowCaption Times are in each solution's own time zone, set on its Business Central tab.</p>
                </div>
            </div>
            <div class="setting-list">
                <SettingRow Name="Default delivery window for Production" Hint="Production environments start with this window.">
                    @WindowControls(_production)
                </SettingRow>
                <SettingRow Name="Default delivery window for Sandbox" Hint="Sandbox environments start with this window.">
                    @WindowControls(_sandbox)
                </SettingRow>
            </div>

            <div class="card__head">
                <div>
                    <h2 class="card__title">Keeping environments up to date</h2>
                    <p class="card__sub">AL Workbench asks Business Central about every solution's environments in the background, so the Environments and Upgrades pages are current without anyone pressing Refresh.</p>
                </div>
            </div>
            <div class="setting-list">
                <SettingRow Name="Check environments">
                    <HintContent>
                        By default, environments are checked once a night. Checking more often shows status changes and new update dates sooner. If Business Central asks AL Workbench to wait, that customer's environments are checked again once the wait is over.
                    </HintContent>
                    <ChildContent>
                        <select id="org-bc-refresh-interval" class="input" style="max-width:260px" aria-label="Check environments"
                                @bind="_refreshInterval" @bind:after="SaveRefreshIntervalAsync" disabled="@_refreshSaving">
                            @foreach (var choice in EnvironmentRefreshInterval.Choices)
                            {
                                <option value="@choice.Minutes">@choice.Label</option>
                            }
                        </select>
                        <FeedbackLine Ok="@_refreshOk" Error="@_refreshError" />
                    </ChildContent>
                </SettingRow>
            </div>

            <div class="card__head">
                <div>
                    <h2 class="card__title">App registration</h2>
                    <p class="card__sub">One app registration for every customer, set up once here. Each customer authorises it in their own Business Central admin center, and a solution then needs only that customer's tenant ID.</p>
                </div>
            </div>
            <div class="setting-list">
                <SettingRow Name="Client ID">
                    <HintContent>
                        The Application (client) ID of the app registration your organisation uses for every customer.
                    </HintContent>
                    <ChildContent>
                        <input id="org-bc-client" type="text" class="input" @bind="_clientId" disabled="@_saving"
                               aria-label="Client ID" placeholder="00000000-0000-0000-0000-000000000000"
                               pattern="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" />
                        @if (Err("BcClientId") is { } eBcClientId)
                        {
                            <FieldError Message="@eBcClientId" />
                        }
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Client secret">
                    <HintContent>
                        @(_view?.HasSecret == true
                            ? "A secret is stored. Enter a new one only to replace it."
                            : "Stored encrypted and never shown again. Entra shows the value once, when you create it.")
                    </HintContent>
                    <ChildContent>
                        <input id="org-bc-secret" type="password" class="input" autocomplete="off" @bind="_secret" disabled="@_saving"
                               aria-label="Client secret" placeholder="@(_view?.HasSecret == true ? "Unchanged" : "Paste the secret's value")" />
                        @if (Err("BcClientSecret") is { } eBcClientSecret)
                        {
                            <FieldError Message="@eBcClientSecret" />
                        }
                    </ChildContent>
                </SettingRow>

                <SettingRow Name="Secret expires">
                    <HintContent>
                        Entra shows this when you create the secret (it lasts at most two years). Once it has passed, solutions stop connecting and deployments to customers are refused.
                    </HintContent>
                    <ChildContent>
                        <input id="org-bc-expiry" type="date" class="input" style="max-width:220px" @bind="_expires" disabled="@_saving"
                               aria-label="Secret expires" />
                        @if (Err("BcClientSecretExpiresAt") is { } eBcClientSecretExpiresAt)
                        {
                            <FieldError Message="@eBcClientSecretExpiresAt" />
                        }
                    </ChildContent>
                </SettingRow>

                @if (_view?.IsConfigured == true)
                {
                    <SettingRow Name="Solutions">
                        <HintContent>
                            A solution with a registration of its own keeps using it; that is chosen on the solution's Business Central tab.
                        </HintContent>
                        <ChildContent>
                            <span>@Count(_view.SolutionsUsingIt) @(_view.SolutionsUsingIt == 1 ? "connects" : "connect") through this registration. @Count(_view.SolutionsWithTheirOwn) @(_view.SolutionsWithTheirOwn == 1 ? "uses" : "use") a registration of @(_view.SolutionsWithTheirOwn == 1 ? "its" : "their") own.</span>
                        </ChildContent>
                    </SettingRow>

                    <SettingRow Name="Remove" Danger="true">
                        <HintContent>
                            @(_view.SolutionsUsingIt == 0
                                ? "No solution uses it yet, so removing it changes nothing for anyone."
                                : StopsConnecting(_view.SolutionsUsingIt) + " until a new one is saved here, or the solution is given a registration of its own.")
                        </HintContent>
                        <ChildContent>
                            <span>
                                <button type="button" class="btn btn--danger" @onclick="RemoveAsync" disabled="@_saving">Remove the app registration</button>
                            </span>
                        </ChildContent>
                    </SettingRow>
                }
            </div>
        }
    </Body>
    <Foot>
        @if (!_loading)
        {
            <button type="button" class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">
                <Icon Name="save" Width="16" Height="16" />
                <span>@(_saving ? "Saving..." : "Save app registration")</span>
            </button>
        }
    </Foot>
    <Aside>
        <section class="card">
            <div class="card__head"><div><h2 class="card__title">Before this will connect</h2></div></div>
            <div class="card__body settings-aside__body">
                <p class="bc-setup__lead">One app registration, set up once here. Each customer then authorises it themselves.</p>
                <ol class="bc-setup">
                    <li>
                        <span class="bc-setup__where">Microsoft Entra admin center, in your own tenant</span>
                        <span>Register an app that accounts in <b>any organisational directory</b> can use, and add the Business Central <b>application</b> permission <code>AdminCenter.ReadWrite.All</code> - not the delegated one, because the connection signs in as the app rather than as a person. Create a client secret and copy its value and expiry date into this form.</span>
                    </li>
                    <li>
                        <span class="bc-setup__where">Each customer's Business Central admin center → Authorized Microsoft Entra apps</span>
                        <span>The customer adds the client ID and grants consent. Until they do, that customer's solution gets no environments back. The solution's Business Central tab shows the client ID to give them.</span>
                    </li>
                </ol>
                <p class="bc-setup__note">Managing tenants as the customer's partner? Also add the app to the AdminAgents group in Partner Center, and check that each delegated admin (GDAP) relationship covers Business Central.</p>
                <a class="btn btn--sm" href="https://learn.microsoft.com/dynamics365/business-central/dev-itpro/administration/administration-center-api" target="_blank" rel="noopener">
                    <Icon Name="external-link" Width="14" Height="14" />
                    <span>Microsoft's admin center API docs</span>
                </a>
            </div>
        </section>
    </Aside>
</AdministrationHeader>

<ConfirmDialog @ref="_confirm" />

@code {
    private OrganizationBcRegistration? _view;
    private bool _loading = true;
    private bool _saving;
    private string? _okMessage;
    private string? _errMessage;
    private Dictionary<string, string> _errors = new();
    private string _clientId = string.Empty;
    private string _secret = string.Empty;
    private DateTime? _expires;
    private ConfirmDialog? _confirm;
    private readonly WindowEditor _production = new("Production", "default-window-production");
    private readonly WindowEditor _sandbox = new("Sandbox", "default-window-sandbox");

    private const string WindowCaption =
        "Applied to environments the first time they appear. Change an existing environment on its own page, or several at once on the Environments list.";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _view = await Connection.GetOrganizationRegistrationAsync();
            _clientId = _view.ClientId ?? string.Empty;
            _secret = string.Empty;
            _expires = _view.SecretExpiresAt?.Date;
            _production.Load(_view.DefaultWindows.ProductionStart, _view.DefaultWindows.ProductionEnd);
            _sandbox.Load(_view.DefaultWindows.SandboxStart, _view.DefaultWindows.SandboxEnd);
            _refreshInterval = _savedRefreshInterval = await OrgAdmin.GetEnvironmentRefreshIntervalAsync();
        }
        catch (ProjectAccessDeniedException ex)
        {
            _errMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private string? Err(string key) => _errors.TryGetValue(key, out var message) ? message : null;

    /// <summary>What losing this registration costs, as a clause a sentence can finish: "... until a new one is saved."</summary>
    private static string StopsConnecting(int count) => count switch
    {
        0 => "No solution uses it yet, so nothing stops connecting",
        1 => "The 1 solution that uses it stops connecting",
        _ => $"The {count} solutions that use it stop connecting",
    };

    private static string ExpiryConsequence(int count, bool expired) => (count, expired) switch
    {
        (0, _) => "No solution uses it yet.",
        (1, true) => "The 1 solution that uses it has stopped connecting.",
        (1, false) => "The 1 solution that uses it stops connecting that day.",
        (_, true) => $"The {count} solutions that use it have stopped connecting.",
        (_, false) => $"The {count} solutions that use it stop connecting that day.",
    };

    private static string Count(int solutions) => solutions == 1 ? "1 solution" : $"{solutions} solutions";

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        _okMessage = _errMessage = null;
        _errors = new();
        try
        {
            var expires = _expires is { } d ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : (DateTime?)null;
            await Connection.SaveOrganizationRegistrationAsync(new OrganizationBcRegistrationInput(
                _clientId, string.IsNullOrWhiteSpace(_secret) ? null : _secret, expires));
            await LoadAsync();
            _okMessage = _view?.SolutionsUsingIt > 0
                ? "App registration saved. Open each solution's Business Central tab and test its connection to confirm it still works."
                : "App registration saved. A solution now needs only the customer's tenant ID to connect - try it on a solution's Business Central tab.";
        }
        catch (PlanValidationException ex)
        {
            _errors = new(ex.Errors);
            _errMessage = "Check the fields marked below.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _errMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving the organisation's Business Central app registration failed.");
            _errMessage = "Couldn't save the app registration. Try again in a moment.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveAsync()
    {
        if (_confirm is null || _view is null) return;
        var confirmed = await _confirm.OpenAsync(
            "Remove your organisation's app registration?",
            (_view.SolutionsUsingIt == 0
                ? "No solution uses it yet."
                : StopsConnecting(_view.SolutionsUsingIt) + " to Business Central until a new one is saved, and deployments to those customers are refused.")
            + " The stored secret is deleted.",
            "Remove it", "btn--danger");
        if (!confirmed) return;

        _saving = true;
        _okMessage = _errMessage = null;
        try
        {
            await Connection.ClearOrganizationRegistrationAsync();
            await LoadAsync();
            _okMessage = "App registration removed.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _errMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Removing the organisation's Business Central app registration failed.");
            _errMessage = "Couldn't remove the app registration. Try again in a moment.";
        }
        finally
        {
            _saving = false;
        }
    }

    // ── How often environments are checked ──────────────────────────────

    private int _refreshInterval = EnvironmentRefreshInterval.DefaultMinutes;
    private int _savedRefreshInterval = EnvironmentRefreshInterval.DefaultMinutes;
    private bool _refreshSaving;
    private string? _refreshOk;
    private string? _refreshError;

    private async Task SaveRefreshIntervalAsync()
    {
        _refreshOk = _refreshError = null;
        if (_refreshInterval == _savedRefreshInterval) return;
        _refreshSaving = true;
        try
        {
            await OrgAdmin.SetEnvironmentRefreshIntervalAsync(_refreshInterval);
            _savedRefreshInterval = _refreshInterval;
            _refreshOk = _refreshInterval == EnvironmentRefreshInterval.DefaultMinutes
                ? "Saved. Environments are checked once a night."
                : $"Saved. Environments are checked {EnvironmentRefreshInterval.Choices.First(c => c.Minutes == _refreshInterval).Label.ToLowerInvariant()}.";
        }
        catch (PlanValidationException ex)
        {
            _refreshInterval = _savedRefreshInterval;
            _refreshError = ex.Errors.Values.FirstOrDefault() ?? "That did not save. Choose one of the listed intervals.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving the environment refresh interval failed.");
            _refreshInterval = _savedRefreshInterval;
            _refreshError = "Couldn't save how often environments are checked. Try again in a moment.";
        }
        finally
        {
            _refreshSaving = false;
        }
    }

    // ── Default delivery windows (issue #962) ───────────────────────────

    /// <summary>One row's worth of state: what is typed, what is stored, and how the last save went.</summary>
    private sealed class WindowEditor
    {
        public WindowEditor(string type, string idPrefix)
        {
            Type = type;
            IdPrefix = idPrefix;
        }

        public string Type { get; }
        public string IdPrefix { get; }
        public TimeOnly? Start { get; set; }
        public TimeOnly? End { get; set; }
        public TimeOnly? SavedStart { get; set; }
        public TimeOnly? SavedEnd { get; set; }
        public bool Saving { get; set; }
        public string? Ok { get; set; }
        public string? Error { get; set; }
        public bool IsHalfFilled => Start is null != (End is null);

        public void Load(TimeOnly? start, TimeOnly? end)
        {
            Start = SavedStart = start;
            End = SavedEnd = end;
        }
    }

    private RenderFragment WindowControls(WindowEditor w) =>
        @<text>
            <span class="bc-window">
                <label class="bc-window__time">From <input id="@(w.IdPrefix + "-start")" type="time" class="input input--sm"
                       @bind="w.Start" @bind:after="() => OnWindowChangedAsync(w)" disabled="@w.Saving"
                       aria-label="@($"{w.Type} window start")" /></label>
                <label class="bc-window__time">To <input id="@(w.IdPrefix + "-end")" type="time" class="input input--sm"
                       @bind="w.End" @bind:after="() => OnWindowChangedAsync(w)" disabled="@w.Saving"
                       aria-label="@($"{w.Type} window end")" /></label>
                <button type="button" class="btn btn--sm" @onclick="() => ClearWindowAsync(w)"
                        disabled="@(w.Saving || (w.Start is null && w.End is null))">Any time</button>
            </span>
            @if (w.IsHalfFilled && w.Error is null)
            {
                <small class="field__hint">Not saved yet. Enter the @(w.Start is null ? "start" : "end") time too, or press Any time to clear the row.</small>
            }
            else if (w.Start is null && w.End is null && w.Ok is null && w.Error is null)
            {
                <small class="field__hint">No window yet — new @w.Type environments accept deliveries at any time.</small>
            }
            <FeedbackLine Ok="@w.Ok" Error="@w.Error" />
        </text>;

    private async Task ClearWindowAsync(WindowEditor w)
    {
        w.Start = null;
        w.End = null;
        await OnWindowChangedAsync(w);
    }

    /// <summary>
    /// Saves a row once its pair is complete (both times, or neither). Half a pair waits
    /// for the other half rather than failing, because typing the start is how every
    /// window begins. The other row goes along as it is stored, never as it is typed.
    /// </summary>
    private async Task OnWindowChangedAsync(WindowEditor w)
    {
        w.Ok = w.Error = null;
        if (w.IsHalfFilled || (w.Start == w.SavedStart && w.End == w.SavedEnd)) return;

        var windows = new DefaultDeliveryWindows(
            _production == w ? w.Start : _production.SavedStart,
            _production == w ? w.End : _production.SavedEnd,
            _sandbox == w ? w.Start : _sandbox.SavedStart,
            _sandbox == w ? w.End : _sandbox.SavedEnd);
        w.Saving = true;
        try
        {
            await OrgAdmin.SetDefaultDeliveryWindowsAsync(windows);
            w.SavedStart = w.Start;
            w.SavedEnd = w.End;
            w.Ok = w.Start is { } s && w.End is { } e
                ? $"Saved. New {w.Type} environments start with a {UpdateWindow.Clock(s)} to {UpdateWindow.Clock(e)} window{(e < s ? " (overnight)" : "")}."
                : $"Saved. New {w.Type} environments start with no window, so deliveries can go at any time.";
        }
        catch (PlanValidationException ex)
        {
            w.Error = ex.Errors.Values.FirstOrDefault() ?? "That did not save. Enter both times, or press Any time.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving the default {EnvironmentType} delivery window failed.", w.Type);
            w.Error = "Couldn't save the window. Try again in a moment.";
        }
        finally
        {
            w.Saving = false;
        }
    }
}
