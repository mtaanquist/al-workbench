@page "/admin/administration/repositories/migrate"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject RepositoryMigrationService Migration
@inject TemplateService Templates
@inject NavigationManager Nav
@inject ILogger<AdminAdministrationMigrate> Log
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Generation
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Services.Migration
@using ALDevToolbox.Services.Templates
@using ALDevToolbox.Services.ObjectExplorer.Projects

@*
    Migrate repositories (issue #1698; parts #1699, #1700 and #1701). Reached from the
    "Migrate repositories" row on Administration -> Repositories.

    Named user: an org Admin moving one customer at a time from Azure DevOps
    to GitHub. They know Azure DevOps, GitHub and AL extensions; they know
    nothing about this codebase. They have done this before for other
    customers, or are about to do it for a hundred of them, so the page is a
    short straight line: name the project, tick the repositories, name the
    customer and template, look at what would move and change, create the
    repository. Earlier migrations are listed at the bottom, because with a
    hundred customers to move the Admin needs to see which are done.
*@

<PageTitle>Migrate repositories · Administration · AL Workbench</PageTitle>

<EditPage Title="Migrate repositories"
          IsLoading="@_loading" ShowActions="false"
          Trail='@([new("Administration", "/admin/administration"), new("Repositories", "/admin/administration/repositories"), new("Migrate repositories")])'>
    <SubtitleContent>
        Move a customer's repositories from an Azure DevOps project into one new GitHub repository.
        Only the newest commit on main is copied, without history. Nothing in Azure DevOps is changed.
    </SubtitleContent>
    <ChildContent>
        <div class="u-stack mig">
            @if (!_hasToken)
            {
                <Alert Tone="AlertTone.Warn">
                    <span>
                        You need an Azure DevOps token with the Code (Read) scope before you can start. Add one under
                        <a href="/account/repos">Account → Repository access</a>, then come back.
                    </span>
                </Alert>
            }

            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">1. Azure DevOps project</h2>
                        <p class="card__sub">The project the customer's repositories are in.</p>
                    </div>
                </div>
                <div class="card__body form-sec">
                    <div class="field">
                        <label class="field__label" for="mig-project">Project address</label>
                        <div class="u-row mig__address">
                            <input class="input" id="mig-project" type="text" required
                                   placeholder="e.g. https://dev.azure.com/cronus/Sales"
                                   @bind="_projectAddress" @bind:event="oninput"
                                   @onkeydown="OnAddressKeyAsync"
                                   disabled="@(!_hasToken || _listing)" />
                            <button type="button" class="btn" @onclick="ListAsync" disabled="@(!_hasToken || _listing)">
                                <Icon Name="search" Width="16" Height="16" />
                                <span>@(_listing ? "Looking..." : "Show repositories")</span>
                            </button>
                        </div>
                        <span class="field__hint">Copy it from your browser while the project is open.</span>
                        <FieldError Field="@RepositoryMigrationService.ProjectField" Errors="_errors" />
                    </div>
                </div>
            </section>

            @if (_listed is not null)
            {
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">2. Repositories to move</h2>
                            <p class="card__sub">
                                Tick every repository of this customer, including the ones the others depend on.
                                They all end up in the same GitHub repository.
                            </p>
                        </div>
                    </div>
                    <div class="card__body">
                        @if (_listed.Repositories.Count == 0)
                        {
                            <EmptyState Icon="folder-git-2" Title="This project has no repositories">
                                <Text>Check that the address names the right project, then show the repositories again.</Text>
                            </EmptyState>
                        }
                        else
                        {
                            <div class="mig__scroll">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th class="mig__pick">
                                                <label class="check @(AllChosen ? "is-checked" : "")" title="Choose all">
                                                    <input type="checkbox" checked="@AllChosen" @onchange="ToggleAll" aria-label="Choose all repositories" />
                                                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                                </label>
                                            </th>
                                            <th>Repository</th>
                                            <th>Default branch</th>
                                            <th class="u-num">Size</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var repo in _listed.Repositories)
                                        {
                                            <tr>
                                                <td class="mig__pick">
                                                    <label class="check @(IsChosen(repo.Id) ? "is-checked" : "") @(repo.IsDisabled ? "is-disabled" : "")">
                                                        <input type="checkbox" checked="@IsChosen(repo.Id)" disabled="@repo.IsDisabled"
                                                               @onchange="e => Toggle(repo.Id, e)" aria-label="@($"Move {repo.Name}")" />
                                                        <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                                    </label>
                                                </td>
                                                <td>
                                                    <a class="u-nowrap" href="@repo.WebUrl" target="_blank" rel="noopener">@repo.Name</a>
                                                    @if (repo.IsDisabled)
                                                    {
                                                        <span class="u-muted"> · switched off in Azure DevOps</span>
                                                    }
                                                    else if (repo.DefaultBranch is not null && repo.DefaultBranch != RepositoryMigrationPreviewer.Branch)
                                                    {
                                                        <span class="u-muted"> · needs a main branch to be moved</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (repo.DefaultBranch is null)
                                                    {
                                                        <span class="u-muted">Empty</span>
                                                    }
                                                    else
                                                    {
                                                        @repo.DefaultBranch
                                                    }
                                                </td>
                                                <td class="u-num u-nowrap">@FormatSize(repo.Size)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <p class="field__hint mig__note">
                                Only the newest commit is copied, so large repositories still preview quickly.
                            </p>
                            <FieldError Field="@RepositoryMigrationService.RepositoriesField" Errors="_errors" />
                        }
                    </div>
                </section>

                @if (_listed.Repositories.Count > 0)
                {
                    <section class="card">
                        <div class="card__head">
                            <div>
                                <h2 class="card__title">3. New repository</h2>
                                <p class="card__sub">The customer, and the template the new repository is laid out by.</p>
                            </div>
                        </div>
                        <div class="card__body form-sec">
                            @if (_templates.Count == 0)
                            {
                                <EmptyState Icon="layers" Title="No templates yet">
                                    <Text>The new repository is laid out by a workspace template. Import one first, then come back.</Text>
                                    <Action><a class="btn" href="/admin/templates">Go to templates</a></Action>
                                </EmptyState>
                            }
                            else
                            {
                                <div class="field">
                                    <label class="field__label" for="mig-customer">Customer name</label>
                                    <input class="input" id="mig-customer" type="text" required
                                           maxlength="@CustomerNaming.MaxLength" placeholder="e.g. CRONUS A/S"
                                           @bind="_customerName" @bind:event="oninput" />
                                    <span class="field__hint">Names the workspace and the solution. If a solution of this name has no GitHub repository yet, the repository is added to it; otherwise a new solution is created.</span>
                                    <FieldError Field="@RepositoryMigrationService.CustomerField" Errors="_errors" />
                                </div>
                                <div class="field">
                                    <label class="field__label" for="mig-short">Short name <span class="u-muted">(optional)</span></label>
                                    <input class="input mig__short" id="mig-short" type="text"
                                           maxlength="@CustomerNaming.MaxShortNameLength" placeholder="e.g. CRO"
                                           @bind="_shortName" @bind:event="oninput" />
                                    <span class="field__hint">Used in the names of the template's extensions, for example CRO Core. Leave blank to use the full name.</span>
                                    <FieldError Field="@RepositoryMigrationService.ShortNameField" Errors="_errors" />
                                </div>
                                <div class="field">
                                    <label class="field__label" for="mig-template">Template</label>
                                    <SelectBox>
                                        <select class="select" id="mig-template" required @bind="_templateKey">
                                            @foreach (var t in _templates)
                                            {
                                                <option value="@t.Key">@t.Name</option>
                                            }
                                        </select>
                                    </SelectBox>
                                    <span class="field__hint">
                                        The template's workspace file, .gitignore and app.json settings replace the ones in the repositories.
                                        Each extension keeps its id, name, publisher, version, object ranges and dependencies.
                                    </span>
                                    <FieldError Field="@RepositoryMigrationService.TemplateField" Errors="_errors" />
                                </div>
                                <div class="field">
                                    <Switch Name="mig-template-extensions" Label="Also add the template's own extensions"
                                            Checked="_addTemplateExtensions" CheckedChanged="v => _addTemplateExtensions = v" />
                                    <span class="field__hint">Adds the extensions a new workspace from this template would start with, next to the customer's own.</span>
                                </div>
                                <div class="u-row mig__go">
                                    @* Once a preview is ready, Create repository is the page's one primary action. *@
                                    <button type="button" class="btn @(ReadyToCreate ? "" : "btn--primary")" @onclick="PreviewAsync"
                                            disabled="@(_chosen.Count == 0 || _starting || _preview?.IsActive == true)">
                                        <Icon Name="eye" Width="16" Height="16" />
                                        <span>@(_starting ? "Starting..." : $"Preview migration of {_chosen.Count} {(_chosen.Count == 1 ? "repository" : "repositories")}")</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </section>
                }
            }

            @if (_preview is not null)
            {
                <section class="card" aria-live="polite">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">@(_preview.IsMigration ? "Migration" : "4. Preview")</h2>
                            <p class="card__sub">
                                From <a href="@_preview.ProjectUrl" target="_blank" rel="noopener">@_preview.ProjectName</a>
                                into @_preview.CustomerName, laid out by @_preview.TemplateName.
                                @if (!_preview.IsMigration)
                                {
                                    <text>Nothing has been created on GitHub.</text>
                                }
                                else if (_preview.Create is { } create)
                                {
                                    <text>New repository: @create.RepositoryName.</text>
                                }
                            </p>
                        </div>
                        <StatusPill Tone="@PreviewTone(_preview)">@PreviewLabel(_preview)</StatusPill>
                    </div>
                    <div class="card__body u-stack">
                        @if (_preview.Error is { } error)
                        {
                            <Alert Tone="AlertTone.Danger"><span>@error</span></Alert>
                        }

                        @if (_preview is { IsMigration: false, MigratedBy: { } runId })
                        {
                            <Alert Tone="AlertTone.Info">
                                <span>A migration has already been started from this preview. <a href="@($"/admin/administration/repositories/migrate?preview={runId}")">See how it went</a>, or preview again to start another.</span>
                            </Alert>
                        }

                        @if (_preview.Outcome is { } outcome)
                        {
                            <Alert Tone="AlertTone.Success">
                                <span>
                                    Created <a href="@outcome.RepositoryUrl" target="_blank" rel="noopener">@outcome.RepositoryFullName</a>
                                    with @outcome.FileCount files.
                                    @if (outcome.SolutionId is { } solutionId)
                                    {
                                        <text>The solution is <a href="@SolutionLinks.Solution(outcome.SolutionSlug, solutionId)">@(outcome.SolutionName ?? _preview.CustomerName)</a>.</text>
                                    }
                                    @if (outcome.PipelineNames.Count > 0)
                                    {
                                        <text> Build pipelines: @string.Join(", ", outcome.PipelineNames).</text>
                                    }
                                </span>
                            </Alert>
                            @foreach (var warning in outcome.Warnings)
                            {
                                <Alert Tone="AlertTone.Warn"><span>@warning</span></Alert>
                            }
                            <p class="field__hint">
                                The repositories in Azure DevOps are unchanged. Once the team works in the new repository,
                                you can archive or remove them there.
                            </p>
                        }

                        <div class="mig__scroll">
                            <table class="data-table">
                                <thead>
                                    <tr><th>Repository</th><th>Commit on main</th><th>Status</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var repo in _preview.Repositories)
                                    {
                                        <tr>
                                            <td><a class="u-nowrap" href="@repo.WebUrl" target="_blank" rel="noopener">@repo.Name</a></td>
                                            <td class="u-nowrap">
                                                @if (repo.Commit is { Length: >= 7 } sha)
                                                {
                                                    <a href="@($"{repo.WebUrl}/commit/{sha}")" target="_blank" rel="noopener"><code>@sha[..7]</code></a>
                                                }
                                                else
                                                {
                                                    <span class="u-muted">-</span>
                                                }
                                            </td>
                                            <td><StatusPill Tone="@RepositoryTone(repo.Status)">@RepositoryLabel(repo.Status)</StatusPill></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (_preview.Analysis is { } analysis)
                        {
                            var findings = analysis.Findings.Concat(_preview.Workspace?.Findings ?? []).ToList();
                            @if (_preview.CanMigrate && !_preview.IsMigration)
                            {
                                <Alert Tone="AlertTone.Success">
                                    <span>Nothing stands in the way. @analysis.Extensions.Count @(analysis.Extensions.Count == 1 ? "extension" : "extensions") would be moved, @_preview.Workspace!.FileCount files in all. Look through the details below, then create the repository.</span>
                                </Alert>
                            }
                            else if (findings.Any(f => f.Severity == MigrationFindingSeverity.Blocking))
                            {
                                <Alert Tone="AlertTone.Danger">
                                    <span>@(_preview.IsMigration ? "Nothing was created. " : "")Fix the problems below, then preview again.</span>
                                </Alert>
                            }

                            @if (findings.Count > 0)
                            {
                                <ul class="mig__findings">
                                    @foreach (var finding in findings)
                                    {
                                        <li class="mig__finding">
                                            <StatusPill Tone="@(finding.Severity == MigrationFindingSeverity.Blocking ? "danger" : "warn")">
                                                @(finding.Severity == MigrationFindingSeverity.Blocking ? "Problem" : "Note")
                                            </StatusPill>
                                            <span>
                                                @if (finding.RepositoryName is { } name)
                                                {
                                                    <strong>@name:</strong>@(" ")
                                                }
                                                @finding.Message
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }

                            @if (analysis.Extensions.Count > 0)
                            {
                                <h3 class="mig__subhead">Extensions found</h3>
                                <div class="mig__scroll">
                                    <table class="data-table">
                                        <thead>
                                            <tr><th>Folder in the new repository</th><th>Extension</th><th>Publisher</th><th>Version</th><th>From</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ext in analysis.Extensions)
                                            {
                                                <tr>
                                                    <td class="u-nowrap"><Icon Name="folder" Width="14" Height="14" /> @ext.Folder</td>
                                                    <td>@ext.Name</td>
                                                    <td>@ext.Publisher</td>
                                                    <td class="u-nowrap">@ext.Version</td>
                                                    <td class="u-muted">@ext.RepositoryName@(ext.SourcePath.Length > 0 ? "/" + ext.SourcePath : "")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (_preview.Workspace is { } workspace)
                            {
                                @if (workspace.TemplateFolders.Count > 0)
                                {
                                    <p>
                                        Added from the template:
                                        @foreach (var folder in workspace.TemplateFolders)
                                        {
                                            <span class="u-nowrap"><Icon Name="folder" Width="14" Height="14" /> @folder</span>@(" ")
                                        }
                                    </p>
                                }
                                @if (workspace.RootFiles.Count > 0)
                                {
                                    <p>
                                        Added in the root folder of the repository:
                                        @for (var i = 0; i < workspace.RootFiles.Count; i++)
                                        {
                                            <code>@workspace.RootFiles[i]</code>@(i < workspace.RootFiles.Count - 1 ? ", " : ".")
                                        }
                                        @(" ")<span class="u-muted">
                                            <code>@MigrationWorkspaceBuilder.ArchiveFile</code> links each Azure DevOps repository and the commit that was copied,
                                            so the old history stays easy to find. The rest come from the template.
                                        </span>
                                    </p>
                                }

                                <h3 class="mig__subhead">Changes to app.json</h3>
                                @if (workspace.AppJson.All(a => a.Changes.Count == 0))
                                {
                                    <p class="u-muted">Every app.json already matches the template.</p>
                                }
                                else
                                {
                                    @foreach (var report in workspace.AppJson)
                                    {
                                        var (changes, blanks) = Split(report.Changes);
                                        <details class="mig__changes">
                                            <summary>
                                                <span class="u-nowrap"><Icon Name="folder" Width="14" Height="14" /> @report.Folder</span>
                                                <span class="u-muted">· @Summary(changes, blanks.Count)</span>
                                            </summary>
                                            @if (blanks.Count > 0)
                                            {
                                                <p class="field__hint">
                                                    Added empty, as the template has them:
                                                    @for (var i = 0; i < blanks.Count; i++)
                                                    {
                                                        <code>@blanks[i]</code>@(i < blanks.Count - 1 ? ", " : ".")
                                                    }
                                                </p>
                                            }
                                            @if (changes.Count > 0)
                                            {
                                                <div class="mig__scroll">
                                                    <table class="data-table">
                                                        <thead><tr><th>Setting</th><th>Now</th><th>After the move</th></tr></thead>
                                                        <tbody>
                                                            @foreach (var change in changes)
                                                            {
                                                                <tr>
                                                                    <td class="u-nowrap"><code>@change.Property</code></td>
                                                                    <td class="mig__value">@ShowValue(change.Before, "not set")</td>
                                                                    <td class="mig__value">@ShowValue(change.After, "removed")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </details>
                                    }
                                }

                                <h3 class="mig__subhead">Left behind</h3>
                                <p class="field__hint">These stay in Azure DevOps. If you still need one, copy it into the new repository after it is created.</p>
                                @if (workspace.LeftBehind.Count == 0)
                                {
                                    <p class="u-muted">Nothing. Every file in the extensions moves.</p>
                                }
                                else
                                {
                                    <div class="mig__scroll">
                                        <table class="data-table">
                                            <thead><tr><th>Repository</th><th>File or folder</th><th>Why</th><th class="u-num">Files</th></tr></thead>
                                            <tbody>
                                                @foreach (var left in workspace.LeftBehind)
                                                {
                                                    <tr>
                                                        <td class="u-nowrap">@left.RepositoryName</td>
                                                        <td class="mig__path"><code>@left.Path</code></td>
                                                        <td>@LeftBehindLabel(left.Reason)</td>
                                                        <td class="u-num">@left.FileCount</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                <p class="field__hint">.alpackages folders are never copied. The build downloads the symbols it needs.</p>
                            }
                        }
                        else if (_preview.IsActive)
                        {
                            <p class="u-muted">
                                @(_preview.Status == MigrationPreviewStatus.Waiting
                                    ? "Waiting for another preview or migration on the server to finish."
                                    : $"{_preview.Stage ?? "Copying the newest commit of each repository"}. This page updates by itself.")
                            </p>
                        }

                        @* After a reload steps 1 to 3 are empty, so this is the way to run the same preview again.
                           With them on screen, the button in step 3 does that and takes the current ticks. *@
                        @if (!_preview.IsActive && _listed is null && _preview.Outcome is null)
                        {
                            <div class="u-row">
                                <button type="button" class="btn" @onclick="PreviewAgainAsync" disabled="@_starting">
                                    <Icon Name="refresh-cw" Width="16" Height="16" />
                                    <span>@(_starting ? "Starting..." : "Preview again")</span>
                                </button>
                            </div>
                            @foreach (var message in _againErrors.Values)
                            {
                                <FieldError Message="@message" />
                            }
                        }
                    </div>
                </section>
            }

            @if (ReadyToCreate)
            {
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">5. Create the repository</h2>
                            <p class="card__sub">
                                Creates the repository in your GitHub organisation with the files shown above in a single commit,
                                and @(_clash is { CanJoin: true } ? "adds it to the existing solution" : "a new solution") for @_preview!.CustomerName.
                            </p>
                        </div>
                    </div>
                    <div class="card__body form-sec">
                        @if (_github?.Blocker is { } blocker)
                        {
                            <Alert Tone="AlertTone.Warn"><span>@blocker</span></Alert>
                        }
                        <div class="field">
                            <label class="field__label" for="mig-repo">Repository name</label>
                            <input class="input" id="mig-repo" type="text" required maxlength="@GitHubWorkspaceRepositoryService.MaxNameLength"
                                   pattern="@GitHubWorkspaceRepositoryService.NamePattern"
                                   placeholder="e.g. cronus-as"
                                   @bind="_repositoryName" @bind:event="oninput" />
                            <span class="field__hint">
                                @if (_github?.OrgLogin is { } org)
                                {
                                    <text>Created as @org/@(_repositoryName.Trim().Length > 0 ? _repositoryName.Trim() : "..."). </text>
                                }
                                Letters, digits, hyphens, underscores and full stops.
                            </span>
                            <FieldError Field="@RepositoryMigrationService.RepositoryNameField" Errors="_createErrors" />
                        </div>
                        <div class="field">
                            <Switch Name="mig-private" Label="Private repository" Checked="_isPrivate" CheckedChanged="v => _isPrivate = v" />
                            <span class="field__hint">Only people you give access to in GitHub can see it.</span>
                        </div>
                        <div class="field">
                            <Switch Name="mig-pipelines" Label="Set up build pipelines" Checked="_addPipelines" CheckedChanged="v => _addPipelines = v" />
                            <span class="field__hint">Adds build pipelines to the solution in AL Workbench, so it builds straight away.</span>
                        </div>
                        @if (_clash is { CanReplace: true } replaceable)
                        {
                            <div class="field">
                                <Switch Name="mig-replace" Label="Replace the existing solution" Checked="_replace" CheckedChanged="v => _replace = v" />
                                <span class="field__hint">
                                    A solution called @replaceable.Name came from an earlier migration, and its repository has since been
                                    deleted from GitHub. Replacing it deletes that solution and its pipelines first.
                                </span>
                            </div>
                        }
                        else if (_clash is { CanJoin: true } joined)
                        {
                            <Alert Tone="AlertTone.Info">
                                <span>
                                    The repository is added to the existing solution
                                    <a href="@SolutionLinks.Solution(joined.Slug, joined.Id)">@joined.Name</a>, which has no GitHub repository yet.
                                </span>
                            </Alert>
                        }
                        else if (_clash is { } taken)
                        {
                            <Alert Tone="AlertTone.Warn">
                                <span>
                                    A solution called <a href="@SolutionLinks.Solution(taken.Slug, taken.Id)">@taken.Name</a> already has a GitHub repository, so this would be refused.
                                    Change the customer name above and preview again, or remove that repository from the solution first.
                                </span>
                            </Alert>
                        }
                        <FieldError Field="@RepositoryMigrationService.SolutionField" Errors="_createErrors" />
                        <FieldError Field="@RepositoryMigrationService.RepositoryField" Errors="_createErrors" />
                        @foreach (var (field, message) in _createErrors.Where(e => e.Key is not (RepositoryMigrationService.SolutionField or RepositoryMigrationService.RepositoryField or RepositoryMigrationService.RepositoryNameField)))
                        {
                            <FieldError Message="@message" />
                        }
                        <div class="u-row mig__go">
                            <button type="button" class="btn btn--primary" @onclick="CreateAsync"
                                    disabled="@(_starting || string.IsNullOrWhiteSpace(_repositoryName) || _clash is { CanReplace: false } || _github?.Blocker is not null)">
                                <Icon Name="folder-git-2" Width="16" Height="16" />
                                <span>@(_starting ? "Starting..." : "Create repository")</span>
                            </button>
                        </div>
                    </div>
                </section>
            }

            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Earlier migrations</h2>
                        <p class="card__sub">Every migration run in your organisation, newest first.</p>
                    </div>
                </div>
                <div class="card__body">
                    @if (_history is null)
                    {
                        <LoadingBlock />
                    }
                    else if (_history.Count == 0)
                    {
                        <EmptyState Icon="history" Title="No migrations yet">
                            <Text>When you create a repository from a preview above, it is listed here.</Text>
                        </EmptyState>
                    }
                    else
                    {
                        <div class="mig__scroll">
                            <table class="data-table">
                                <thead>
                                    <tr><th>When</th><th>Customer</th><th>From</th><th>Repository</th><th>Result</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _history)
                                    {
                                        <tr>
                                            <td class="u-nowrap"><Timestamp Value="@row.CreatedAt" /></td>
                                            <td>
                                                @if (row.SolutionId is { } solutionId)
                                                {
                                                    <a class="u-nowrap" href="@SolutionLinks.Solution(row.SolutionSlug, solutionId)">@row.CustomerName</a>
                                                }
                                                else
                                                {
                                                    <span class="u-nowrap">@row.CustomerName</span>
                                                }
                                                @if (row.StartedBy is { } by)
                                                {
                                                    <div class="field__hint">by @by</div>
                                                }
                                            </td>
                                            <td><a href="@row.SourceProjectUrl" target="_blank" rel="noopener">@row.SourceProject</a></td>
                                            <td>
                                                @if (row.RepositoryUrl is { } url)
                                                {
                                                    <a class="u-nowrap" href="@url" target="_blank" rel="noopener">@row.RepositoryFullName</a>
                                                }
                                                else
                                                {
                                                    <span class="u-muted">-</span>
                                                }
                                            </td>
                                            <td class="mig__result">
                                                <StatusPill Tone="@(row.Succeeded ? "succeeded" : "failed")">@(row.Succeeded ? "Created" : "Failed")</StatusPill>
                                                @if (row.Message is { } message)
                                                {
                                                    <div class="field__hint">@message</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>
    </ChildContent>
</EditPage>

<ConfirmDialog @ref="_confirmReplace" />

@code {
    [SupplyParameterFromQuery(Name = "preview")] public Guid? PreviewId { get; set; }

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    private bool _loading = true;
    private bool _hasToken;
    private bool _listing;
    private bool _starting;
    private string _projectAddress = string.Empty;
    private SourceProjectListing? _listed;
    private List<RuntimeTemplate> _templates = [];
    private string _templateKey = string.Empty;
    private string _customerName = string.Empty;
    private string _shortName = string.Empty;
    private bool _addTemplateExtensions;
    private readonly HashSet<string> _chosen = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyDictionary<string, string> _errors = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, string> _againErrors = new Dictionary<string, string>();
    private MigrationPreview? _preview;
    private List<RepositoryMigrationHistoryRow>? _history;
    private MigrationSolutionClash? _clash;
    private MigrationGitHubReadiness? _github;
    private Guid? _preparedFor;
    private string _repositoryName = string.Empty;
    private bool _isPrivate = true;
    private bool _addPipelines = true;
    private bool _replace;
    private IReadOnlyDictionary<string, string> _createErrors = new Dictionary<string, string>();
    private ConfirmDialog? _confirmReplace;

    // The page's services share one database context, and the poll loop's reads
    // can overlap a button's; a context allows one operation at a time.
    private readonly SemaphoreSlim _dbGate = new(1, 1);
    private PeriodicTimer? _poll;
    private CancellationTokenSource? _pollCts;

    /// <summary>A finished preview that nothing stands in the way of: the repository can be created from it.</summary>
    private bool ReadyToCreate => _preview is { CanCreate: true };

    private bool AllChosen => _listed is { Repositories.Count: > 0 } listed
        && listed.Repositories.Where(r => !r.IsDisabled).All(r => _chosen.Contains(r.Id))
        && _chosen.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        _hasToken = await Migration.HasAzureDevOpsTokenAsync();
        _templates = (await Templates.GetTemplatesAsync(includeDeprecated: false))
            .OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _templateKey = (await Templates.GetDefaultAsync())?.Key ?? _templates.FirstOrDefault()?.Key ?? string.Empty;
        if (PreviewId is { } id)
        {
            _preview = Migration.GetPreview(id);
            if (_preview is not null)
            {
                // A reload keeps what the preview was asked with.
                if (_templates.Any(t => t.Key == _preview.TemplateKey)) _templateKey = _preview.TemplateKey;
                _customerName = _preview.CustomerName;
                _shortName = _preview.ShortName ?? string.Empty;
                _addTemplateExtensions = _preview.AddTemplateExtensions;
            }
        }
        _history = await Migration.ListHistoryAsync();
        await PrepareCreateAsync();
        _loading = false;
    }

    /// <summary>
    /// Once per ready preview: suggests the repository name from the customer's,
    /// and looks for a solution that already has that name.
    /// </summary>
    private async Task PrepareCreateAsync()
    {
        if (!ReadyToCreate || _preparedFor == _preview!.Id) return;
        _preparedFor = _preview.Id;
        _repositoryName = GitHubWorkspaceRepositoryService.SuggestName(_preview.CustomerName);
        _replace = false;
        _createErrors = new Dictionary<string, string>();
        var customer = _preview.CustomerName;
        _clash = await Db(() => Migration.FindSolutionClashAsync(customer));
        _github = await Db(() => Migration.CheckGitHubAsync());
    }

    private async Task CreateAsync()
    {
        if (_starting || _preview is null) return;
        if (_replace && _clash is { CanReplace: true } clash && _confirmReplace is not null
            && !await _confirmReplace.OpenAsync(
                $"Replace {clash.Name}?",
                $"The solution {clash.Name} and its pipelines are deleted, then the new repository and a new solution are created.",
                "Replace and create", "btn--danger", "trash-2"))
        {
            return;
        }

        _starting = true;
        _createErrors = new Dictionary<string, string>();
        try
        {
            var input = new MigrationCreateInput(_repositoryName, _isPrivate, _addPipelines, _replace);
            var previewId = _preview.Id;
            _preview = await Db(() => Migration.StartMigrationAsync(previewId, input));
            Nav.NavigateTo($"/admin/administration/repositories/migrate?preview={_preview.Id}", replace: true);
            StartPoll();
        }
        catch (PlanValidationException ex)
        {
            _createErrors = ex.Errors;
        }
        finally
        {
            _starting = false;
        }
    }

    // Not only on the first render: initialisation awaits a database read, so the
    // first render can come before a reloaded preview has been read.
    protected override void OnAfterRender(bool firstRender)
    {
        if (_preview?.IsActive == true && _poll is null) StartPoll();
    }

    private async Task OnAddressKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ListAsync();
    }

    private async Task ListAsync()
    {
        if (_listing) return;
        _listing = true;
        _errors = new Dictionary<string, string>();
        try
        {
            var address = _projectAddress;
            _listed = await Db(() => Migration.ListRepositoriesAsync(address));
            _projectAddress = _listed.Project.WebUrl;
            // One project is usually one customer, so every repository that can be
            // moved starts ticked.
            _chosen.Clear();
            foreach (var repo in _listed.Repositories.Where(r => !r.IsDisabled)) _chosen.Add(repo.Id);
        }
        catch (PlanValidationException ex)
        {
            _listed = null;
            _errors = ex.Errors;
        }
        finally
        {
            _listing = false;
        }
    }

    private bool IsChosen(string repositoryId) => _chosen.Contains(repositoryId);

    private void Toggle(string id, ChangeEventArgs e)
    {
        if (e.Value is true) _chosen.Add(id); else _chosen.Remove(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (_listed is null) return;
        if (e.Value is true)
        {
            foreach (var repo in _listed.Repositories.Where(r => !r.IsDisabled)) _chosen.Add(repo.Id);
        }
        else
        {
            _chosen.Clear();
        }
    }

    private MigrationTargetInput Target() => new(_templateKey, _customerName, _shortName, _addTemplateExtensions);

    private Task PreviewAsync() => StartAsync(_projectAddress, _chosen.ToList(), Target(), errors => _errors = errors);

    /// <summary>Runs the same project and repositories again, also after a reload, when steps 1 to 3 are empty.</summary>
    private Task PreviewAgainAsync() => _preview is null
        ? Task.CompletedTask
        : StartAsync(_preview.ProjectUrl, _preview.Repositories.Select(r => r.Id).ToList(), Target(),
            errors => _againErrors = errors);

    private async Task StartAsync(
        string projectAddress, IReadOnlyCollection<string> repositoryIds, MigrationTargetInput target,
        Action<IReadOnlyDictionary<string, string>> showErrors)
    {
        if (_starting) return;
        _starting = true;
        _errors = new Dictionary<string, string>();
        _againErrors = new Dictionary<string, string>();
        try
        {
            _preview = await Db(() => Migration.StartPreviewAsync(projectAddress, repositoryIds, target));
            // The preview's id in the address lets a reload, or a second tab, show it.
            Nav.NavigateTo($"/admin/administration/repositories/migrate?preview={_preview.Id}", replace: true);
            StartPoll();
        }
        catch (PlanValidationException ex)
        {
            showErrors(ex.Errors);
        }
        finally
        {
            _starting = false;
        }
    }

    private async Task<T> Db<T>(Func<Task<T>> read)
    {
        await _dbGate.WaitAsync();
        try { return await read(); }
        finally { _dbGate.Release(); }
    }

    private void StartPoll()
    {
        if (_poll is not null) return;
        _pollCts = new CancellationTokenSource();
        _poll = new PeriodicTimer(PollInterval);
        _ = PollLoopAsync(_poll, _pollCts.Token);
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                var keepGoing = true;
                // Reads an in-memory snapshot only, on the circuit's own dispatcher.
                await InvokeAsync(async () =>
                {
                    if (_preview is null) { keepGoing = false; return; }
                    _preview = Migration.GetPreview(_preview.Id) ?? _preview;
                    keepGoing = _preview.IsActive;
                    if (!keepGoing)
                    {
                        await PrepareCreateAsync();
                        if (_preview.IsMigration) _history = await Db(() => Migration.ListHistoryAsync());
                    }
                    StateHasChanged();
                });
                if (!keepGoing) break;
            }
        }
        catch (OperationCanceledException) { /* navigated away */ }
        catch (ObjectDisposedException) { /* torn down mid-poll */ }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Polling a migration preview failed.");
        }
        finally
        {
            StopPoll();
        }
    }

    private void StopPoll()
    {
        var cts = Interlocked.Exchange(ref _pollCts, null);
        var timer = Interlocked.Exchange(ref _poll, null);
        try { cts?.Cancel(); } catch (ObjectDisposedException) { }
        cts?.Dispose();
        timer?.Dispose();
    }

    public ValueTask DisposeAsync()
    {
        StopPoll();
        return ValueTask.CompletedTask;
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 * 1024 => $"{Math.Max(1, bytes / 1024.0):0} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):0.#} GB",
    };

    private static string PreviewTone(MigrationPreview p) => p.Status switch
    {
        MigrationPreviewStatus.Waiting => "queued",
        MigrationPreviewStatus.Running => "running",
        MigrationPreviewStatus.Failed => "failed",
        _ when p.IsMigration => p.Outcome is not null ? "succeeded" : "danger",
        _ => p.CanMigrate ? "succeeded" : "danger",
    };

    private static string PreviewLabel(MigrationPreview p) => p.Status switch
    {
        MigrationPreviewStatus.Waiting => "Waiting",
        MigrationPreviewStatus.Running => p.IsMigration ? "Migrating" : "Reading repositories",
        MigrationPreviewStatus.Failed => "Failed",
        _ when p.IsMigration => p.Outcome is not null ? "Migrated" : "Not migrated",
        _ => p.CanMigrate ? "Ready to migrate" : "Needs fixing",
    };

    private static string LeftBehindLabel(MigrationLeftBehindReason reason) => reason switch
    {
        MigrationLeftBehindReason.ReplacedByTemplate => "The template has its own",
        MigrationLeftBehindReason.IgnoredByGitignore => "Ignored by the template's .gitignore",
        _ => "Not part of an extension",
    };

    /// <summary>
    /// Splits off the settings that only gain an empty value from the template
    /// ("privacyStatement": ""), which say nothing and would bury the real changes.
    /// </summary>
    private static (List<MigrationAppJsonChange> Changes, List<string> Blanks) Split(IReadOnlyList<MigrationAppJsonChange> all)
    {
        static bool Blank(MigrationAppJsonChange c) => c.Before is null && c.After is "\"\"" or "[]" or "{}";
        return (all.Where(c => !Blank(c)).ToList(), all.Where(Blank).Select(c => c.Property).ToList());
    }

    /// <summary>The line under each extension: the version changes that can break a compile, then a count of the rest.</summary>
    private static string Summary(List<MigrationAppJsonChange> changes, int blanks)
    {
        if (changes.Count == 0 && blanks == 0) return "no changes";
        var versions = changes
            .Where(c => c.Property is "application" or "platform" or "runtime")
            .Select(c => $"{c.Property} {Trim(c.Before) ?? "not set"} → {Trim(c.After) ?? "removed"}")
            .ToList();
        var rest = changes.Count - versions.Count + blanks;
        if (rest > 0) versions.Add(versions.Count == 0 ? $"{rest} {(rest == 1 ? "change" : "changes")}" : $"{rest} more");
        return string.Join(", ", versions);

        static string? Trim(string? json) => json?.Trim('"');
    }

    /// <summary>An app.json value as the table shows it: short, and a word in place of nothing.</summary>
    private static string ShowValue(string? json, string missing) =>
        json is null ? missing : json.Length > 160 ? json[..160] + "..." : json;

    private static string RepositoryTone(MigrationRepositoryStatus s) => s switch
    {
        MigrationRepositoryStatus.Waiting => "queued",
        MigrationRepositoryStatus.Cloning => "running",
        MigrationRepositoryStatus.Cloned => "succeeded",
        _ => "failed",
    };

    private static string RepositoryLabel(MigrationRepositoryStatus s) => s switch
    {
        MigrationRepositoryStatus.Waiting => "Waiting",
        MigrationRepositoryStatus.Cloning => "Copying",
        MigrationRepositoryStatus.Cloned => "Copied",
        _ => "Failed",
    };
}
