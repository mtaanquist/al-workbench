@page "/admin/administration/oauth-clients"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.OAuth
@inject OAuthClientAdminService Clients
@inject IOrganizationContext Org

@*
    OAuth clients tab of the Administration surface. Read-only table with a
    Revoke action per row - no global "Save changes" applies here; revokes
    are immediate.
*@

<PageTitle>OAuth clients · Administration · AL Workbench</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.OAuthClients">
    <Body>

        @if (Ok == "revoked")
        {
            <Alert Tone="AlertTone.Success">
                <span>Consent revoked.</span>
            </Alert>
        }

        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Connected assistants</h2>
                    <p class="card__sub">One row per person, per assistant they've allowed in.</p>
                </div>
            </div>
            <div class="card__body form-sec">
                <p class="form-sec__cap">
                    Every AI assistant (Claude, Cursor, agent) that someone in your organisation
                    has authorised to use AL Workbench. Each row is one user's consent - the same
                    assistant can appear multiple times when several users have connected it.
                    Revoking here signs that user's assistant out and forces it to ask for
                    permission again next time. Access tokens - the desktop and command-line
                    path - are personal, and each member manages their own under
                    <a href="/account/ai">Account → AI assistants</a>.
                </p>
            </div>

            @if (_rows is null)
            {
                <LoadingBlock Text="Loading..." />
            }
            else if (_rows.Count == 0)
            {
                <EmptyState Icon="plug" Title="No assistants connected yet">
                    <Text>
                        When someone adds AL Workbench as a connector in Claude (or another
                        supported assistant) and clicks <strong>Allow</strong>, their connection
                        appears here.
                    </Text>
                </EmptyState>
            }
            else
            {
                <table class="data-table data-table--edge">
                    <thead>
                        <tr>
                            <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                            <th>Assistant</th>
                            <th>User</th>
                            <th>Permissions</th>
                            <th>Granted</th>
                            <th class="data-table__actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in _rows)
                    {
                        var state = c.RevokedAt is null ? "active" : "revoked";
                        <tr class="@RowStateIcon.RowClass(state)">
                            <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                            <td>
                                @c.DisplayName
                                @if (c.RedirectHosts.Count > 0)
                                {
                                    <div class="u-muted">@string.Join(", ", c.RedirectHosts)</div>
                                }
                            </td>
                            <td>@c.UserEmail</td>
                            <td class="u-muted">@HumanScopes(c.Scopes)</td>
                            <td class="u-muted u-num"><Timestamp Value="@c.GrantedAt" Format="yyyy-MM-dd" /></td>
                            <td class="data-table__actions">
                                @if (c.RevokedAt is null)
                                {
                                    <button type="button" class="btn btn--sm btn--danger" @onclick="() => RevokeAsync(c.ConsentId)">
                                        Revoke
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>
    </Body>
</AdministrationHeader>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private IReadOnlyList<ConnectedClient>? _rows;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var orgId = Org.CurrentOrganizationId;
        if (orgId is null) return;
        _rows = await Clients.ListForOrganizationAsync(orgId.Value);
    }

    private async Task RevokeAsync(int consentId)
    {
        // Org admin revokes consent without owning it; ignoreOrgScope=true so the
        // per-user ownership check doesn't bounce us. Authorisation is enforced by
        // the [Authorize(Roles="Admin")] attribute on the page, and scoping the
        // revoke to our own org (expectedOrganizationId) keeps an admin from ever
        // reaching another tenant's consent. See #488.
        var orgId = Org.CurrentOrganizationId;
        if (orgId is null) return;
        await Clients.RevokeConsentAsync(consentId, actorUserId: 0, ignoreOrgScope: true, expectedOrganizationId: orgId.Value);
        await LoadAsync();
        Ok = "revoked";
    }

    private static string HumanScopes(string scopes)
    {
        var parts = scopes.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var labels = parts.Select(s => s switch
        {
            "mcp" => "use AL Workbench tools",
            "offline_access" => "stay signed in",
            _ => s,
        });
        return string.Join(", ", labels);
    }
}
