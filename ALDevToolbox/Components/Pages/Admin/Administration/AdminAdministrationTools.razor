@page "/admin/administration/tools"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject OrganizationAdminService OrgAdmin
@inject IToolAvailability ToolAvailability
@inject ILogger<AdminAdministrationTools> Log
@using ALDevToolbox.Data
@using ALDevToolbox.Domain.Tools
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Tools
@using Microsoft.EntityFrameworkCore
@using ALDevToolbox.Services.Organizations
@using ALDevToolbox.Services.Account

@*
    Per-organisation tool switches. Only tools the site keeps on are shown — a
    tool switched off site-wide is gone for every org and can't be turned back
    on here. Turning a tool off hides it for this org's users on their next
    sign-in (or within a few minutes) and 404s its pages. MCP is folded in:
    its checkbox writes the org's MCP opt-out, the rest write the disabled set.

    The second block is the step-up rule: a tool marked there asks members to
    confirm it is them (a second factor within the last few minutes) before its
    pages open or its writing MCP tools run. Reads and writes go through
    OrganizationAdminService; the gate itself is ToolAccessGate, the MCP call
    filter, and the OAuth consent check. See .design/auth-and-audit.md.
*@

<PageTitle>Tools · Administration · AL Workbench</PageTitle>

<AdministrationHeader ActiveTab="AdministrationHeader.Tab.Tools">
    <Alerts>
        @if (!string.IsNullOrEmpty(_okMessage))
        {
            <Alert Tone="AlertTone.Success">
                <span>@_okMessage</span>
            </Alert>
        }
        @if (!string.IsNullOrEmpty(_errMessage))
        {
            <Alert Tone="AlertTone.Danger">
                <span>@_errMessage</span>
            </Alert>
        }
    </Alerts>
    <Body>
        @if (_loading)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else if (_visible.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="puzzle" Width="21" Height="21" /></span>
                <span class="empty-state__title">No tools to choose from</span>
                <span class="empty-state__text">
                    Your site administrator has not left any tools for organisations to
                    manage. Ask them if you were expecting one here.
                </span>
            </div>
        }
        else
        {
            @* One row per tool, matching /site-admin/settings/tools. The two pages
               answer the same question at different scopes, so they should not look
               like different pages. *@
            <div class="setting-list">
                @foreach (var tool in _visible)
                {
                    var key = tool.Key;
                    <SettingRow Name="@tool.Name" Hint="@tool.Blurb">
                        <Switch Name="@($"tool-{key}")"
                                Checked="_enabled[key]"
                                CheckedChanged="@(v => _enabled[key] = v)"
                                Disabled="@_saving"
                                Label="@(_enabled[key] ? "On" : "Off")" />
                    </SettingRow>
                }
            </div>

            @* Step-up rules sit under the switches, in the same card, because they are
               the same decision made twice: first whether a tool is on, then how sure
               you want to be about who is using it. Only the tools that reach GitHub or
               a customer's Business Central are offered; the rest have nothing to protect. *@
            <div class="card__head">
                <div>
                    <h2 class="card__title">Confirm identity before use</h2>
                    <p class="card__sub">
                        People confirm it's them before these tools open, then aren't asked again for
                        a while. Anyone without an authenticator app, email codes or a passkey is asked
                        to add one first.
                    </p>
                </div>
            </div>
            <div class="setting-list">
                <SettingRow Name="Ask again after" Hint="How long one confirmation lasts. Shorter means more prompts and less time for an unattended screen to be misused.">
                    <span class="u-row">
                        <input class="input input--num" type="number" id="step-up-window"
                               @bind="_windowMinutes" disabled="@_saving"
                               min="@StepUpAuth.MinWindowMinutes" max="@StepUpAuth.MaxWindowMinutes" style="width: 92px"
                               aria-label="Ask again after, in minutes" />
                        <span class="form-actions__note">minutes</span>
                    </span>
                </SettingRow>
                @foreach (var tool in _visible.Where(t => StepUpOffered.Contains(t.Key)))
                {
                    var key = tool.Key;
                    var toolOn = _enabled[key];
                    <SettingRow Name="@tool.Name" Hint="@(toolOn ? StepUpHint(key) : "Switch the tool on above to change this.")">
                        <Switch Name="@($"step-up-{key}")"
                                Checked="_stepUp[key]"
                                CheckedChanged="@(v => _stepUp[key] = v)"
                                Disabled="@(_saving || !toolOn)"
                                Label="@(_stepUp[key] ? "Required" : "Not required")" />
                    </SettingRow>
                }
            </div>
            @* What an AI assistant may do once it is connected. Only shown while MCP is
               on site-wide, because without it there is no assistant to allow anything. *@
            @if (_enabled.ContainsKey(ToolKey.Mcp))
            {
                <div class="card__head">
                    <div>
                        <h2 class="card__title">AI assistants</h2>
                        <p class="card__sub">What a connected AI assistant may do on its own.</p>
                    </div>
                </div>
                <div class="setting-list">
                    <SettingRow Name="Let AI assistants deploy to production environments"
                                Hint="@(_enabled[ToolKey.Mcp] ? AgentsHint : "Switch the tool on above to change this.")">
                        <Switch Name="agents-deploy-production"
                                Checked="_agentsMayDeployToProduction"
                                CheckedChanged="@(v => _agentsMayDeployToProduction = v)"
                                Disabled="@(_saving || !_enabled[ToolKey.Mcp])"
                                Label="@(_agentsMayDeployToProduction ? "Allowed" : "Not allowed")"
                                AriaLabel="Let AI assistants deploy to production environments" />
                    </SettingRow>
                </div>
            }

            @if (_visible.Any(t => _enabled[t.Key] && _stepUp[t.Key]))
            {
                <Alert Tone="AlertTone.Warn">
                    <span>
                        AI assistants connected with a personal access token become read-only in these
                        tools, because a token can't confirm who is using it. Assistants connected through
                        the permission screen need approving again once, so the person confirms it's them.
                    </span>
                </Alert>
            }
        }
    </Body>
    <Foot>
        @if (!_loading && _visible.Count > 0)
        {
            <button type="button" class="btn btn--primary"
                    @onclick="SaveAsync"
                    disabled="@(_saving || !IsDirty())">
                <Icon Name="save" Width="16" Height="16" />
                <span>@(_saving ? "Saving..." : "Save changes")</span>
            </button>
        }
    </Foot>
    <Aside>
        <Alert Tone="AlertTone.Info">
            <span>
                Switching a tool off hides it from everyone here and stops it working.
                People already signed in see the change within a few minutes, or right
                away next time they sign in.
            </span>
        </Alert>
        <Alert Tone="AlertTone.Info">
            <span>
                Asking people to confirm identity takes effect the next time they open the tool.
                Someone who confirmed within the "ask again after" time isn't asked again until it
                runs out.
            </span>
        </Alert>
    </Aside>
</AdministrationHeader>

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _okMessage;
    private string? _errMessage;

    // Tools the site keeps on, in catalogue order — the only ones we offer.
    private List<ToolDescriptor> _visible = new();
    // Current org state, keyed by tool: true = on for this org.
    private readonly Dictionary<ToolKey, bool> _enabled = new();
    private Dictionary<ToolKey, bool> _baseline = new();
    // Step-up per tool: true = confirm it's you before the tool opens.
    private readonly Dictionary<ToolKey, bool> _stepUp = new();
    private Dictionary<ToolKey, bool> _stepUpBaseline = new();
    private HashSet<ToolKey> _storedStepUp = new();
    private const string AgentsHint =
        "Off: AI assistants can only deploy to sandboxes. A deployment to production has to be confirmed by a person on the pipeline's page. "
        + "On: when an AI assistant deploys to production, it starts straight away, with no confirmation.";

    private bool _agentsMayDeployToProduction;
    private bool _agentsBaseline;
    private int _windowMinutes = 15;
    private int _windowBaseline = 15;
    // The org's stored disabled set as loaded — used to preserve entries for
    // tools that are currently hidden site-wide (so a later site re-enable
    // keeps this org's choice) rather than silently dropping them.
    private HashSet<ToolKey> _storedDisabled = new();

    protected override async Task OnInitializedAsync()
    {
        var org = await OrgAdmin.GetToolsViewAsync();
        _storedDisabled = org.DisabledTools;
        _storedStepUp = org.StepUpTools;
        _windowMinutes = _windowBaseline = org.StepUpWindowMinutes;
        _agentsMayDeployToProduction = _agentsBaseline = org.AgentsMayDeployToProduction;
        _visible = ToolCatalog.All.Where(t => ToolAvailability.IsSiteEnabled(t.Key)).ToList();
        foreach (var tool in _visible)
        {
            _enabled[tool.Key] = tool.Key == ToolKey.Mcp
                ? org.McpEnabled
                : !_storedDisabled.Contains(tool.Key);
            _stepUp[tool.Key] = _storedStepUp.Contains(tool.Key);
        }
        _baseline = new Dictionary<ToolKey, bool>(_enabled);
        _stepUpBaseline = new Dictionary<ToolKey, bool>(_stepUp);
        _loading = false;
    }

    private bool IsDirty() =>
        _windowMinutes != _windowBaseline
        || _agentsMayDeployToProduction != _agentsBaseline
        || _visible.Any(t => _enabled[t.Key] != _baseline[t.Key] || _stepUp[t.Key] != _stepUpBaseline[t.Key]);

    // The tools with something outside the workbench to protect: a GitHub
    // repository, a customer's Business Central, or the assistant connection
    // that reaches both. Piper, Diff and Object Explorer only read what is
    // already here, so a rule on them would ask for nothing.
    private static readonly HashSet<ToolKey> StepUpOffered =
        [ToolKey.Templates, ToolKey.Cookbook, ToolKey.Translator, ToolKey.Projects, ToolKey.Pipelines, ToolKey.Releases, ToolKey.Mcp];

    private static string StepUpHint(ToolKey key) => key switch
    {
        ToolKey.Templates => "Generating into GitHub creates repositories and pull requests in your name.",
        ToolKey.Cookbook => "Applying a recipe opens a pull request in your name.",
        ToolKey.Translator => "Opening a translation pull request writes to GitHub in your name.",
        ToolKey.Projects => "Solutions can change a customer's Business Central connection details.",
        ToolKey.Pipelines => "Build pipelines run against your GitHub repositories and can deploy a build.",
        ToolKey.Releases => "Deploying installs apps in a customer's Business Central environment.",
        ToolKey.Mcp => "Asks before someone opens the page where they connect an AI assistant.",
        _ => "This tool reaches outside the workbench.",
    };

    private async Task SaveAsync()
    {
        if (_saving || !IsDirty()) return;
        _saving = true;
        _okMessage = null;
        _errMessage = null;
        try
        {
            // Keep stored entries for tools that aren't visible right now (hidden
            // site-wide), then add the ones the admin just switched off here.
            var visibleKeys = _visible.Select(t => t.Key).ToHashSet();
            var disabled = _storedDisabled.Where(k => !visibleKeys.Contains(k))
                .Concat(_visible.Where(t => t.Key != ToolKey.Mcp && !_enabled[t.Key]).Select(t => t.Key))
                .ToList();
            // Same preservation rule for the step-up set: keep entries for tools
            // hidden site-wide, and keep a rule on a tool that is merely switched
            // off here so switching it back on restores it.
            var stepUp = _storedStepUp.Where(k => !visibleKeys.Contains(k))
                .Concat(_visible.Where(t => _enabled[t.Key] ? _stepUp[t.Key] : _storedStepUp.Contains(t.Key)).Select(t => t.Key))
                .ToList();

            // Changing the step-up rules or window, or allowing agents into production,
            // needs a fresh session whenever step-up rules are set, before or after the
            // save. Check it before the first write, so a refusal leaves the whole page
            // unsaved (#1196); each setter keeps its own check.
            var stepUpChanged = !_storedStepUp.SetEquals(stepUp);
            var needsFresh = (stepUpChanged && (_storedStepUp.Count > 0 || stepUp.Count > 0))
                || (_windowMinutes != _windowBaseline && stepUp.Count > 0)
                || (_enabled.ContainsKey(ToolKey.Mcp) && _agentsMayDeployToProduction && !_agentsBaseline && stepUp.Count > 0);
            if (needsFresh)
            {
                await OrgAdmin.RequireFreshSessionAsync();
            }

            await OrgAdmin.SetDisabledToolsAsync(disabled);

            // MCP rides its own flag; only touch it when MCP is on site-wide
            // (otherwise it isn't in the visible list at all).
            if (_enabled.ContainsKey(ToolKey.Mcp))
            {
                await OrgAdmin.SetMcpEnabledAsync(_enabled[ToolKey.Mcp]);
            }

            await OrgAdmin.SetStepUpToolsAsync(stepUp);
            await OrgAdmin.SetStepUpWindowAsync(_windowMinutes);
            _windowBaseline = _windowMinutes;
            if (_enabled.ContainsKey(ToolKey.Mcp))
            {
                await OrgAdmin.SetAgentsMayDeployToProductionAsync(_agentsMayDeployToProduction);
                _agentsBaseline = _agentsMayDeployToProduction;
            }

            _storedDisabled = ToolCatalog.ParseDisabled(ToolCatalog.Format(disabled));
            _storedStepUp = ToolCatalog.ParseKeys(ToolCatalog.Format(stepUp));
            _baseline = new Dictionary<ToolKey, bool>(_enabled);
            _stepUpBaseline = new Dictionary<ToolKey, bool>(_stepUp);
            _okMessage = "Tools saved.";
        }
        catch (PlanValidationException ex)
        {
            // Includes "confirm it's you first": changing the step-up rules
            // needs a fresh session, and the message says where to get one.
            _errMessage = ex.Errors.FirstOrDefault().Value ?? "That did not save. Check the values and try again.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save per-org tool toggles.");
            _errMessage = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }
}
