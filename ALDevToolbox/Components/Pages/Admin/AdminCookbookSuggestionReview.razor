@page "/admin/cookbook/suggestions/{Id:int}"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject RecipeSuggestionService Suggestions
@inject MarkdownRenderer Markdown
@inject NavigationManager Nav
@inject ILogger<AdminCookbookSuggestionReview> Log
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Cookbook

<PageTitle>Review suggestion · Admin · AL Workbench</PageTitle>

<EditPage Title="@(_suggestion?.Title ?? (_loaded ? "Suggestion not found" : "Review suggestion"))"
          IsLoading="@(!_loaded)" IsNotFound="@(_suggestion is null)" Sticky="true"
          PageClass="suggestion-review"
          Trail='@([new("Suggestions", "/admin/cookbook/suggestions"), new("Review")])'>
    <SubtitleContent>
        @if (_suggestion is { } s)
        {
            @* The facts a reviewer weighs before reading the code, on the line
               under the title rather than as small tags at the far end of the
               card header where they were easy to miss. *@
            <span class="suggestion-meta">
                <span>
                    Suggested by @(s.SuggestedByUser?.DisplayName ?? "an unknown user")
                    on <Timestamp Value="@s.RequestedAt" />
                </span>
                <RecipeTypeBadge Type="s.Type" />
                @if (s.MinimumApplicationVersion is { } minV)
                {
                    <span>Requires @minV.Name or later</span>
                }
                @if (s.EstimatedValueHours is { } hours)
                {
                    <span>Time saved: @hours.ToString("0.##") @(hours == 1 ? "hour" : "hours")</span>
                }
            </span>
        }
        else if (_loaded)
        {
            <text>This suggestion doesn't exist.</text>
        }
    </SubtitleContent>
    <Notices>
        @if (!string.IsNullOrEmpty(_lastError))
        {
            <Alert Tone="AlertTone.Danger">
                <span>@_lastError</span>
            </Alert>
        }
        @* A decided suggestion is reached by an old link or a bookmark. Saying
           what happened to it beats "not found", which reads as if it was lost. *@
        @if (_suggestion is { Decision: RecipeSuggestionDecision.Approved } approved)
        {
            <Alert Tone="AlertTone.Success">
                <span>
                    Approved by @(approved.DecidedByUser?.DisplayName ?? "an unknown user")@if (approved.DecidedAt is { } at)
                    {<text> on <Timestamp Value="@at" /></text>}.
                    The suggestion is shown below as it was submitted; the published
                    recipe may have been edited since.
                </span>
            </Alert>
        }
        else if (_suggestion is { Decision: RecipeSuggestionDecision.Rejected } rejected)
        {
            <Alert Tone="AlertTone.Neutral">
                <span>
                    Rejected by @(rejected.DecidedByUser?.DisplayName ?? "an unknown user")@if (rejected.DecidedAt is { } at)
                    {<text> on <Timestamp Value="@at" /></text>}.
                    @if (!string.IsNullOrWhiteSpace(rejected.DecisionNote))
                    {
                        <text> Reason: @rejected.DecisionNote</text>
                    }
                </span>
            </Alert>
        }
    </Notices>
    @* In the sticky head so the decision stays in view however long the
       suggestion runs, instead of at the foot of the page. *@
    <Actions>
        @if (_suggestion is { Decision: RecipeSuggestionDecision.Approved, ApprovedRecipeId: { } recipeId })
        {
            <a class="btn" href="@($"/cookbook/{recipeId}")">
                <Icon Name="book-open" Width="14" Height="14" />
                <span>Open published recipe</span>
            </a>
        }
        else if (_suggestion is not null && !IsPending)
        {
            <a class="btn" href="/admin/cookbook/suggestions">
                <Icon Name="arrow-left" Width="14" Height="14" />
                <span>Back to suggestions</span>
            </a>
        }
        @if (IsPending)
        {
            if (_rejecting)
            {
                <input class="input suggestion-reject-note" type="text" aria-label="Reason for rejecting"
                       placeholder="Reason (optional)"
                       @bind="_rejectNote" @bind:event="oninput"
                       maxlength="500" />
                <button type="button" class="btn" @onclick="() => _rejecting = false" disabled="@_busy">Cancel</button>
                <button type="button" class="btn btn--danger" @onclick="RejectAsync" disabled="@_busy">
                    <Icon Name="x" Width="14" Height="14" />
                    <span>Confirm reject</span>
                </button>
            }
            else
            {
                <button type="button" class="btn" @onclick="StartReject" disabled="@_busy">
                    <Icon Name="x" Width="14" Height="14" />
                    <span>Reject</span>
                </button>
            }
            <button type="button" class="btn btn--primary" @onclick="ApproveAsync" disabled="@_busy">
                <Icon Name="check" Width="14" Height="14" />
                <span>Approve and publish</span>
            </button>
        }
    </Actions>
    @* Not found has no body of its own: the head already says it, and offers the way back. *@
    <ChildContent>
    <section class="card">
        <div class="card__head">
            <h2 class="card__title">What was suggested</h2>
        </div>
        <div class="card__body form-sec">
            <p class="suggestion-text suggestion-desc">@_suggestion!.Description</p>
            @if (_keywords.Count > 0)
            {
                @* Keywords are mostly there to help assistants find the recipe,
                   so a long list is noise to a person: show the first few and
                   let the rest open on request. *@
                <div class="u-row suggestion-tags">
                    <span class="suggestion-tags__label">Search keywords</span>
                    @foreach (var kw in _showAllKeywords ? _keywords : _keywords.Take(KeywordPreview))
                    {
                        <span class="tag">@kw</span>
                    }
                    @if (_keywords.Count > KeywordPreview)
                    {
                        <button type="button" class="btn btn--sm btn--ghost suggestion-more"
                                aria-expanded="@(_showAllKeywords ? "true" : "false")"
                                @onclick="() => _showAllKeywords = !_showAllKeywords">
                            @(_showAllKeywords ? "Show fewer" : $"and {_keywords.Count - KeywordPreview} more")
                        </button>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_suggestion!.Instructions))
            {
                <details class="hint-details" open>
                    <summary>
                        <Icon Name="list" Width="14" Height="14" />
                        <span>Suggested instructions</span>
                    </summary>
                    <div class="hint-details__intro suggestion-text">@Markdown.Render(_suggestion!.Instructions)</div>
                </details>
            }
        </div>
    </section>

    <section class="card">
        <div class="card__head">
            <h2 class="card__title">@_suggestion!.Files.Count file@(_suggestion!.Files.Count == 1 ? "" : "s")</h2>
        </div>
        <div class="card__body">
            <FileBrowser Files="_files" />
        </div>
    </section>

    <ConfirmDialog @ref="_approveConfirm"
                   Title="Publish this recipe?"
                   Message="It goes into the Cookbook straight away, where everyone in your organisation can find and use it. You can still edit it afterwards."
                   ConfirmLabel="Approve and publish"
                   ConfirmIcon="check"
                   ConfirmButtonClass="btn--primary" />
    </ChildContent>
</EditPage>

@code {
    [Parameter] public int Id { get; set; }

    private RecipeSuggestion? _suggestion;
    private bool _loaded;
    private bool _busy;
    private string? _lastError;
    private bool _rejecting;
    private string _rejectNote = string.Empty;
    private ConfirmDialog? _approveConfirm;
    private IReadOnlyList<string> _keywords = [];
    private bool _showAllKeywords;
    private IReadOnlyList<FileBrowser.Entry> _files = [];

    private const int KeywordPreview = 10;

    private bool IsPending => _suggestion is { Decision: RecipeSuggestionDecision.Pending };

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        // A decided suggestion still renders, read-only and with its outcome
        // in the notices; only a pending one offers Approve and Reject.
        _suggestion = await Suggestions.GetAsync(Id);
        _keywords = _suggestion?.Keywords
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [];
        _files = _suggestion?.Files
            .OrderBy(f => f.Ordering)
            .Select(f => new FileBrowser.Entry(f.RelativePath, f.FileName, f.Content))
            .ToList() ?? [];
        _loaded = true;
    }

    private async Task ApproveAsync()
    {
        if (_busy || !IsPending || _approveConfirm is null) return;
        if (!await _approveConfirm.OpenAsync()) return;
        _busy = true;
        _lastError = null;
        try
        {
            var recipe = await Suggestions.ApproveAsync(_suggestion!.Id);
            // Replace, not push: once decided, this page is a dead end, so Back
            // from the new recipe should land on the review list instead.
            Nav.NavigateTo($"/admin/cookbook/{recipe.Id}", replace: true);
        }
        catch (PlanValidationException ex)
        {
            _lastError = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
            // Most often someone else decided it first: reload so the page
            // shows that outcome instead of still offering the decision.
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to approve recipe suggestion {Id}.", _suggestion!.Id);
            _lastError = "An unexpected error occurred. The suggestion was not approved.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartReject()
    {
        _rejecting = true;
        _rejectNote = string.Empty;
    }

    private async Task RejectAsync()
    {
        if (_busy || !IsPending) return;
        _busy = true;
        _lastError = null;
        try
        {
            await Suggestions.RejectAsync(_suggestion!.Id, _rejectNote);
            Nav.NavigateTo("/admin/cookbook/suggestions", replace: true);
        }
        catch (PlanValidationException ex)
        {
            _lastError = ex.Errors.FirstOrDefault().Value ?? "Validation failed.";
            // Most often someone else decided it first: reload so the page
            // shows that outcome instead of still offering the decision.
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to reject recipe suggestion {Id}.", _suggestion!.Id);
            _lastError = "An unexpected error occurred. The suggestion was not rejected.";
        }
        finally
        {
            _busy = false;
        }
    }
}
