@page "/admin/object-explorer/new/artifacts"
@attribute [Authorize(Roles = "Admin,Editor")]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.Import.BcArtifactService Artifacts
@inject ALDevToolbox.Services.ObjectExplorer.Import.ArtifactReleaseImporter Importer
@inject ALDevToolbox.Services.ObjectExplorer.Explore.ObjectExplorerService ObjectExplorer
@inject ALDevToolbox.Services.Organizations.OrganizationConfigService Config
@inject ILogger<AdminReleasesImportArtifacts> Log
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.ObjectExplorer.Import

@*
    Artifacts tab of the Import Release page. Interactive (InteractiveServer):
    browse Microsoft's available OnPrem builds for a country and import any one
    of them (newest, or an older version to backfill), plus opt the org into a
    daily auto-import. Microsoft releases are always first-party with the label
    "Business Central {Major}.{Minor} ({CC})"; a version already in the catalogue
    shows "Imported" instead of an Import button so we never re-download it.
    The browse table lists shipped (OnPrem) builds only; preview builds of
    upcoming versions are an opt-in on the automatic-import card and never
    imported by hand from here. See .design/object-explorer.md, "Preview builds".
*@

<PageTitle>Import Release · Artifacts · Admin · AL Workbench</PageTitle>

<div class="page">
    <AdminReleasesImportHeader ActiveTab="AdminReleasesImportHeader.Tab.Microsoft" />

    <div class="dash-cols">
    @* ── Browse & import a specific version (main column) ───────────── *@
    <section class="form-sec">
        <div class="form-sec__head"><span class="section-label">Browse versions</span></div>
        <p class="form-sec__cap">
            Pick a country and refresh to list the available OnPrem builds, then
            import the newest - or an older one to backfill a specific release.
        </p>

        @if (_message is not null)
        {
            <Alert Tone="AlertTone.Success">
                <span>@_message</span>
            </Alert>
        }
        @if (_error is not null)
        {
            <Alert Tone="AlertTone.Danger">
                <span>@_error</span>
            </Alert>
        }

        <div class="filter-bar">
            <div class="field">
                <label class="field__label" for="browse-country">Country code</label>
                <input id="browse-country" type="text" class="input" maxlength="20"
                       placeholder="e.g. dk or w1"
                       @bind="_browseCountry" @bind:event="oninput"
                       @onkeydown="OnBrowseCountryKeyDown" />
            </div>
            <button type="button" class="btn" @onclick="RefreshAsync" disabled="@(_refreshing || string.IsNullOrWhiteSpace(_browseCountry))">
                <Icon Name="refresh-cw" Width="14" Height="14" />
                <span>@(_refreshing ? "Refreshing..." : "Refresh from Microsoft")</span>
            </button>
        </div>

        @if (_refreshing && _rows.Count == 0)
        {
            <div class="loading-block"><span class="spinner"></span><span>Querying Microsoft's artifact index...</span></div>
        }
        else if (_loadedCountry is null)
        {
            <div class="empty-state empty-state--quiet">
                <span class="empty-state__title">Nothing listed yet</span>
                <span class="empty-state__text">
                    Enter a country code above and refresh to see the builds
                    Microsoft publishes for it.
                </span>
            </div>
        }
        else if (_rows.Count == 0)
        {
            <div class="empty-state empty-state--quiet">
                <span class="empty-state__icon"><Icon Name="funnel-x" Width="21" Height="21" /></span>
                <span class="empty-state__title">No OnPrem builds for "@_loadedCountry"</span>
                <span class="empty-state__text">
                    Double-check the country code - <code>dk</code> and <code>w1</code>
                    are the usual ones - and refresh again.
                </span>
            </div>
        }
        else
        {
            <table class="data-table u-compact">
                <thead>
                    <tr>
                        <th scope="col">Version</th>
                        <th scope="col">Major.Minor</th>
                        <th scope="col">Discovered</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="data-table__actions">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var label = BcArtifactIndex.FormatLabel(row.Version, _loadedCountry!);
                        var importedId = ImportedReleaseId(label);
                        <tr @key="row.Version">
                            <td>@row.Version</td>
                            <td>@row.MajorMinor</td>
                            <td><Timestamp Value="@row.RefreshedAt" Format="yyyy-MM-dd" /></td>
                            <td>
                                @if (importedId is int rid)
                                {
                                    <a href="@($"/object-explorer/release/{rid}")">Imported</a>
                                }
                                else if (_queuedVersions.Contains(row.Version))
                                {
                                    <span class="u-muted">Queued...</span>
                                }
                                else
                                {
                                    <span class="u-muted">—</span>
                                }
                            </td>
                            <td class="data-table__actions">
                                @if (importedId is null && !_queuedVersions.Contains(row.Version))
                                {
                                    <button type="button" class="btn btn--sm"
                                            @onclick="() => ImportAsync(row.Version)"
                                            disabled="@_importing">
                                        <Icon Name="download" Width="14" Height="14" />
                                        <span>Import</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <small class="field__hint">
                Versions come straight from Microsoft. Importing downloads the
                release and runs in the background - watch its progress on the
                releases list.
            </small>
        }
    </section>

    @* ── Automatic import (right rail card) ─────────────────────────── *@
    <aside>
        <section class="card">
            <div class="card__head">
                <h2 class="card__title">
                    <Icon Name="refresh-cw" Width="13" Height="13" />
                    <span>Automatic import</span>
                </h2>
                @if (_autoEnabled)
                {
                    <StatusPill Tone="live">Active</StatusPill>
                }
            </div>
            <div class="card__body">
                <p class="form-sec__cap">
                    Import the newest Microsoft <strong>OnPrem</strong> release for
                    one or more countries once a day. Versions already in the
                    catalogue are skipped.
                </p>
                @if (_autoMessage is not null)
                {
                    <Alert Tone="AlertTone.Success">
                <span>@_autoMessage</span>
            </Alert>
                }
                @if (_autoError is not null)
                {
                    <Alert Tone="AlertTone.Danger">
                <span>@_autoError</span>
            </Alert>
                }
                <div class="form-sec">
                    <label class="check">
                        <input type="checkbox" @bind="_autoEnabled" />
                        <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                        <span>Import new releases automatically</span>
                    </label>
                    <div class="field">
                        <label class="field__label" for="auto-country">Country codes</label>
                        <input id="auto-country" type="text" class="input" maxlength="100"
                               placeholder="e.g. dk or w1,dk,nl"
                               @bind="_autoCountry" @bind:event="oninput" />
                        <small class="field__hint">BC country codes, separated by commas.</small>
                    </div>
                    <label class="check">
                        <input type="checkbox" @bind="_autoPreviews" disabled="@(!_autoEnabled)" />
                        <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                        <span>Also import preview builds of upcoming versions</span>
                    </label>
                    <small class="field__hint">
                        Adds Microsoft's pre-release build of each upcoming major release
                        for the same countries, marked "Preview" in the release list. The
                        preview is refreshed every two weeks and retired once the version
                        ships. Preview builds are published under Microsoft's insider
                        programme terms.
                    </small>
                    <div class="form-actions">
                        <button type="button" class="btn" @onclick="SaveAutoImportAsync" disabled="@_savingAuto">
                            <Icon Name="save" Width="14" Height="14" />
                            <span>@(_savingAuto ? "Saving..." : "Save automatic import")</span>
                        </button>
                    </div>
                    <small class="field__hint">
                        @if (_autoLastRunAt is DateTime last)
                        {
                            <span>Last checked <Timestamp Value="@last" />.</span>
                        }
                        else if (_autoEnabled)
                        {
                            <span>Not checked yet - the first daily check is still ahead.</span>
                        }
                    </small>
                </div>
            </div>
        </section>
    </aside>
    </div>
</div>

@code {
    // Auto-import settings (persisted to OrganizationSettings).
    private bool _autoEnabled;
    private bool _autoPreviews;
    private string _autoCountry = string.Empty;
    private bool _savingAuto;
    private DateTime? _autoLastRunAt;
    private string? _autoMessage;
    private string? _autoError;

    // Browse / version-table state.
    private string _browseCountry = string.Empty;
    private string? _loadedCountry;
    private IReadOnlyList<OeArtifactVersion> _rows = Array.Empty<OeArtifactVersion>();
    private bool _refreshing;
    private bool _importing;
    private readonly HashSet<string> _queuedVersions = new(StringComparer.OrdinalIgnoreCase);

    // Label → release id for the "Imported" status, refreshed after each import.
    private Dictionary<string, int> _importedByLabel = new(StringComparer.OrdinalIgnoreCase);

    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var config = await Config.GetCurrentAsync();
        _autoEnabled = config.Settings.AutoImportReleasesEnabled;
        _autoCountry = config.Settings.AutoImportCountry ?? string.Empty;
        _autoPreviews = config.Settings.AutoImportPreviewsEnabled;
        _autoLastRunAt = config.Settings.AutoImportLastRunAt;
        // Pre-fill the browse country from the auto-import list (its first code)
        // so the common case is one click to refresh.
        _browseCountry = ALDevToolbox.Services.Organizations.OrganizationConfigService
            .ParseAutoImportCountries(_autoCountry)
            .FirstOrDefault() ?? string.Empty;

        await LoadImportedLabelsAsync();

        // If the org already tracks a country, show its cached versions immediately.
        if (!string.IsNullOrWhiteSpace(_browseCountry))
        {
            try
            {
                var cached = await Artifacts.GetCachedVersionsAsync(_browseCountry);
                if (cached.Count > 0)
                {
                    _rows = cached;
                    _loadedCountry = _browseCountry.Trim().ToLowerInvariant();
                }
            }
            catch (Exception ex)
            {
                Log.LogWarning(ex, "Failed to load cached artifact versions for {Country}.", _browseCountry);
            }
        }
    }

    private async Task LoadImportedLabelsAsync()
    {
        var releases = await ObjectExplorer.ListReleasesAsync();
        _importedByLabel = releases
            .Where(r => r.Status != "failed")
            .GroupBy(r => r.Label, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().Id, StringComparer.OrdinalIgnoreCase);
    }

    private int? ImportedReleaseId(string label) =>
        _importedByLabel.TryGetValue(label, out var id) ? id : null;

    private async Task OnBrowseCountryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_refreshing && !string.IsNullOrWhiteSpace(_browseCountry))
        {
            await RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        if (_refreshing || string.IsNullOrWhiteSpace(_browseCountry)) return;
        _refreshing = true;
        _message = null;
        _error = null;
        try
        {
            _rows = await Artifacts.RefreshIndexAsync(_browseCountry);
            _loadedCountry = _browseCountry.Trim().ToLowerInvariant();
            await LoadImportedLabelsAsync();
            _message = $"Found {_rows.Count} OnPrem version(s) for '{_loadedCountry}'.";
        }
        catch (PlanValidationException ex)
        {
            _error = ex.Errors.FirstOrDefault().Value ?? "Couldn't refresh the artifact index.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to refresh artifact index for {Country}.", _browseCountry);
            _error = "Couldn't reach Microsoft's artifact index. Check connectivity and try again.";
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task ImportAsync(string version)
    {
        if (_importing || _loadedCountry is null) return;
        _importing = true;
        _message = null;
        _error = null;
        try
        {
            var outcome = await Importer.ImportAsync(_loadedCountry, version);
            switch (outcome.Status)
            {
                case ArtifactImportStatus.Queued:
                    _queuedVersions.Add(version);
                    _message = $"Queued '{outcome.Label}' - it'll appear on the releases list as it ingests.";
                    break;
                case ArtifactImportStatus.AlreadyImported:
                    _message = $"'{outcome.Label}' is already in the catalogue.";
                    await LoadImportedLabelsAsync();
                    break;
                case ArtifactImportStatus.NotFound:
                    _error = $"Version {version} is no longer available for '{_loadedCountry}'. Refresh and try again.";
                    break;
            }
        }
        catch (PlanValidationException ex)
        {
            _error = ex.Errors.FirstOrDefault().Value ?? "Couldn't queue the import.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to queue artifact import {Version} for {Country}.", version, _loadedCountry);
            _error = "Couldn't queue the import. Check connectivity and try again.";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task SaveAutoImportAsync()
    {
        if (_savingAuto) return;
        _savingAuto = true;
        _autoMessage = null;
        _autoError = null;
        try
        {
            await Config.SaveAutoImportAsync(_autoEnabled, _autoCountry, _autoPreviews);
            _autoCountry = string.Join(",",
                ALDevToolbox.Services.Organizations.OrganizationConfigService.ParseAutoImportCountries(_autoCountry));
            _autoPreviews = _autoEnabled && _autoPreviews;
            _autoMessage = _autoEnabled
                ? $"Automatic import enabled for '{_autoCountry}'{(_autoPreviews ? ", including preview builds" : "")}."
                : "Automatic import disabled.";
        }
        catch (PlanValidationException ex)
        {
            _autoError = ex.Errors.FirstOrDefault().Value ?? "Couldn't save automatic import settings.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save auto-import settings.");
            _autoError = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _savingAuto = false;
        }
    }
}
