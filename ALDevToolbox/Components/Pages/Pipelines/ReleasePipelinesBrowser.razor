@page "/pipelines/deployments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.ReleasePipelineService Releases
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ProjectService Projects
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<ReleasePipelinesBrowser> Log
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects

@*
    The Deployment pipelines landing: every deployment pipeline across the org's solutions, and what
    each one is shipping, shipped last and ships next. A deployment pipeline is a reusable
    "install this build pipeline's apps into this Business Central environment" target.
    Create one here, or edit/remove an existing one; deploying a build happens on the
    pipeline's own page. See .design/saas-delivery.md.

    Named user: a BC consultant looking after several customers' environments, who opens
    this page to see what is going out right now, what failed and what is queued for
    tonight - and only occasionally to set up a new target.

    Built to .design/handoff/PageReleasePipelines.dc.html / ReleasePipelinesBody.dc.html,
    with the adaptations in .design/handoff/briefs/2026-09-release-pipelines-review.md:
    no "on every new build" (deployments never start on their own), relative times with
    the exact UTC time on hover, Production in the danger tone. The header sort buttons
    are left out; the order is fixed by urgency (shipping now, needs attention,
    scheduled, the rest, then name); a deployment prepared from a new build and waiting for
    someone to approve it (#934) counts as needing attention, and the page opens with a
    line saying how many there are. While something is shipping the list re-reads
    itself every two seconds, the way the pipeline's own page does, and stops when
    nothing is.
*@

<PageTitle>Deployment pipelines · AL Workbench</PageTitle>

<ListPage Title="Deployment pipelines"
          Subtitle="Every deployment pipeline in your organisation, and what each one deployed last. Times are relative; hover one for the exact time in UTC."
          IsLoading="@(_rows is null)" IsEmpty="@(_rows is { Count: 0 })" HasNoMatches="@(_rows is { Count: > 0 } && Visible.Count == 0)"
          FiltersWhileLoading="true" ShowActions="@(_rows is null || _rows.Count > 0 || _projectOptions.Count == 0)"
          Trail='@([new("Home", "/"), new("Deployment pipelines")])'>
    <Actions>
        @if (_rows is { Count: 0 } && _projectOptions.Count == 0)
        {
            <button type="button" class="btn" disabled title="Create a solution first. A deployment pipeline always belongs to one.">
                <Icon Name="plus" Width="16" Height="16" />
                <span>New deployment pipeline</span>
            </button>
        }
        else
        {
            <a class="btn btn--primary" href="@NewPipelineHref">
                <Icon Name="plus" Width="16" Height="16" />
                <span>New deployment pipeline</span>
            </a>
        }
    </Actions>

    <Notices>
        @if (_error is { } error)
        {
            <Alert Tone="AlertTone.Danger">
                <span>@error</span>
            </Alert>
        }
        @if (_notice is { } notice)
        {
            <Alert Tone="AlertTone.Info" Role="status"><span>@notice</span></Alert>
        }
        @if (WaitingRows.Count > 0)
        {
            var waiting = WaitingRows;
            <Alert Tone="AlertTone.Warn">
                <span>
                    <b>@(waiting.Count == 1 ? "1 deployment" : $"{waiting.Count} deployments") waiting for approval:</b>
                    @for (var i = 0; i < waiting.Count; i++)
                    {
                        var w = waiting[i];
                        @(i == 0 ? " " : ", ")<a href="@($"/pipelines/deployments/{w.Id}")">@w.Name</a>
                    }.
                    Open @(waiting.Count == 1 ? "it" : "one") to approve or dismiss it.
                </span>
            </Alert>
        }
        @foreach (var r in LiveRows)
        {
            var live = r.LiveDelivery!;
            <div class="rp-live" role="status">
                <span class="spinner spinner--lg rp-live__spinner"></span>
                <div class="rp-live__body">
                    <div class="rp-live__head">
                        <span class="rp-live__eyebrow">Shipping now</span>
                        <span class="rp-live__name">@r.Name</span>
                    </div>
                    <span class="rp-live__text">@LiveSentence(r)@if (live.StartedAt is { } liveStarted) { <text> Started <Timestamp Value="@liveStarted" Relative="true" />@LiveTook(live)</text> }</span>
                    <div class="rp-live__meter">
                        @if (live.AppCount > 0)
                        {
                            <progress class="progress rp-live__progress" value="@live.AppsDone" max="@live.AppCount"></progress>
                            <span class="u-num rp-live__step">@live.AppsDone of @live.AppCount apps done</span>
                        }
                        else
                        {
                            <progress class="progress rp-live__progress"></progress>
                        }
                    </div>
                </div>
                <a class="btn btn--sm rp-live__open" href="@($"/pipelines/deployments/{r.Id}")">View progress</a>
            </div>
        }
    </Notices>

    <Search>
        <input type="search" class="input" placeholder="Search pipeline, solution or environment..."
               @bind="_search" @bind:event="oninput" disabled="@(_rows is null)"
               aria-label="Search deployment pipelines"
               aria-keyshortcuts="F3" title="Search deployment pipelines (F3)" />
    </Search>
    <Filters>
        <SelectBox style="width: 170px">
            <select class="select" aria-label="Solution" @bind="_solution" disabled="@(_rows is null)">
                <option value="">All solutions</option>
                @foreach (var name in SolutionNames)
                {
                    <option value="@name">@name</option>
                }
            </select>
        </SelectBox>
        <SelectBox style="width: 170px">
            <select class="select" aria-label="Environment type" @bind="_envType" disabled="@(_rows is null)">
                <option value="">All environments</option>
                <option value="production">Production only</option>
                <option value="sandbox">Sandbox only</option>
            </select>
        </SelectBox>
    </Filters>
    <Trailing>
        @if (_rows is not null)
        {
            <div class="rp-list__tabs">
                <div class="pill-tabs" role="group" aria-label="Show">
                    @foreach (var tab in Tabs)
                    {
                        <button type="button" class="pill-tab @(_tab == tab ? "is-active" : "")"
                                aria-pressed="@(_tab == tab ? "true" : "false")" @onclick="() => _tab = tab">
                            @TabLabel(tab)<span class="pill-tab__count">@CountFor(tab)</span>
                        </button>
                    }
                </div>
            </div>
        }
    </Trailing>

    <Loading>
        <table class="data-table data-table--edge rp-list__table">
            <thead><tr>
                <th class="data-table__col-state"><span class="u-sr">State</span></th>
                <th class="rp-list__col-pipeline">Pipeline</th>
                <th class="rp-list__col-env">Environment</th>
                <th class="rp-list__col-delivery">Last deployment</th>
                <th class="rp-list__col-next">Next deployment</th>
                <th class="rp-list__col-source">Apps from</th>
                <th class="rp-list__col-installs">When deployed</th>
                <th class="data-table__actions rp-list__col-actions"><span class="u-sr">Actions</span></th>
            </tr></thead>
            <tbody><TableSkeletonRows Columns="7" Rows="5" /></tbody>
        </table>
        <LoadingBlock Text="Loading deployment pipelines and their latest deployments..." UnderTable="true" />
    </Loading>

    <Empty>
        <div class="card">
            @if (_projectOptions.Count > 0)
            {
                <EmptyState Icon="send" Title="No deployment pipelines yet">
                    <Text>
                        A deployment pipeline installs a solution's builds, or a GitHub release, into one
                        of its environments. Nothing installs on its own: when you deploy a build, it
                        goes in right away, at a time you choose, or with the environment's next
                        Business Central update.
                    </Text>
                    <Action>
                        <a class="btn btn--primary" href="@NewPipelineHref">
                            <Icon Name="plus" Width="15" Height="15" />
                            <span>New deployment pipeline</span>
                        </a>
                    </Action>
                </EmptyState>
            }
            else
            {
                <EmptyState Icon="folder-plus" Title="No solutions yet">
                    <Text>
                        A deployment pipeline installs a solution's apps into one of that customer's
                        environments, so it always belongs to a solution. Create the solution for your
                        customer first, then connect its environments.
                    </Text>
                    <Action>
                        <a class="btn btn--primary" href="/solutions/new">
                            <Icon Name="plus" Width="15" Height="15" />
                            <span>New solution</span>
                        </a>
                    </Action>
                </EmptyState>
            }
        </div>
    </Empty>

    <NoMatches>
        <div class="card">
            <EmptyState Icon="funnel-x" Title="No deployment pipelines match">
                <Text>Nothing matches these filters. Clear them to see all @(_rows?.Count ?? 0).</Text>
                <Action>
                    <button type="button" class="btn" @onclick="ClearFilters">Clear filters</button>
                </Action>
            </EmptyState>
        </div>
    </NoMatches>

    <ChildContent>
        <table class="data-table data-table--edge rp-list__table rp-list__wide">
            <thead>
                <tr>
                    <th class="data-table__col-state"><span class="u-sr">State</span></th>
                    <th scope="col" class="rp-list__col-pipeline">Pipeline</th>
                    <th scope="col" class="rp-list__col-env">Environment</th>
                    <th scope="col" class="rp-list__col-delivery">Last deployment</th>
                    <th scope="col" class="rp-list__col-next">Next deployment</th>
                    <th scope="col" class="rp-list__col-source">Apps from</th>
                    <th scope="col" class="rp-list__col-installs">When deployed</th>
                    <th scope="col" class="data-table__actions rp-list__col-actions"><span class="u-sr">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Visible)
                {
                    var state = StateOf(r);
                    var rowState = state.Row;
                    var next = NextOf(r);
                    <tr class="@rowState" data-pipeline="@r.Id">
                        <td class="data-table__col-state">
                            <span class="data-table__state data-table__state--icon @(state.Spin ? "data-table__state--spin" : "")"
                                  role="img" aria-label="@state.Label" title="@state.Label">
                                <Icon Name="@state.Icon" Width="15" Height="15" />
                            </span>
                        </td>
                        <td>
                            <span class="cell-stack">
                                <span class="cell-stack__main rp-list__name"><a href="@($"/pipelines/deployments/{r.Id}")">@r.Name</a></span>
                                <span class="cell-stack__sub"><a class="rp-list__quiet" href="@($"/solutions/{r.ProjectId}")">@r.ProjectName</a></span>
                            </span>
                        </td>
                        <td>
                            <span class="cell-stack">
                                <span class="cell-stack__main"><a href="@($"/environments/{r.ProjectEnvironmentId}")">@r.EnvironmentName</a></span>
                                <span class="cell-stack__sub">
                                    <span class="@(IsProduction(r) ? "rp-list__prod" : null)">@r.EnvironmentType</span>
                                    @if (HealthOf(r) is { } health)
                                    {
                                        <text> - </text><span class="@health.Tone">@health.Text</span>
                                    }
                                </span>
                            </span>
                        </td>
                        <td>
                            @if (r.LiveDelivery is { } live)
                            {
                                <span class="cell-stack">
                                    <span class="cell-stack__main rp-list__live">@LiveText(live)</span>
                                    <span class="cell-stack__sub rp-list__live-sub">
                                        @if (live.AppCount > 0)
                                        {
                                            <progress class="progress rp-list__meter" value="@live.AppsDone" max="@live.AppCount"
                                                      aria-label="@($"{live.AppsDone} of {live.AppCount} apps done")"></progress>
                                        }
                                        else
                                        {
                                            <progress class="progress rp-list__meter" aria-label="Starting"></progress>
                                        }
                                        @if (live.StartedAt is { } started)
                                        {
                                            <span>started <Timestamp Value="@started" Relative="true" /></span>
                                        }
                                    </span>
                                </span>
                            }
                            else if (r.LastDelivery is { } last)
                            {
                                <span class="cell-stack">
                                    <span class="cell-stack__main @OutcomeTone(r)" title="@OutcomeText(last)">@OutcomeText(last)</span>
                                    <span class="cell-stack__sub"><Timestamp Value="@last.At" Relative="true" /></span>
                                </span>
                            }
                            else
                            {
                                <span class="rp-list__none">Nothing deployed yet</span>
                            }
                        </td>
                        <td>
                            <span class="cell-stack">
                                <span class="cell-stack__main @next.Tone" title="@next.Title">@next.Text</span>
                                @if (next.Sub is not null)
                                {
                                    @if (next.SubHref is { } subHref)
                                    {
                                        @* A dead target says where to fix it, not only that it is dead. *@
                                        <a class="cell-stack__sub rp-list__fix" href="@subHref" title="@next.Title">@next.Sub</a>
                                    }
                                    else
                                    {
                                        <span class="cell-stack__sub @next.SubTone" title="@next.Sub">@next.Sub</span>
                                    }
                                }
                            </span>
                        </td>
                        <td>
                            <span class="rp-list__source">
                                <Icon Name="@(FromGitHub(r) ? "tag" : "rocket")" Width="15" Height="15" Css="rp-list__source-icon" />
                                <span class="cell-stack">
                                    @if (!FromGitHub(r) && r.BuildPipelineId is { } buildPipelineId)
                                    {
                                        <span class="cell-stack__main"><a class="rp-list__quiet" href="@($"/pipelines/{buildPipelineId}")">@SourceName(r)</a></span>
                                    }
                                    else
                                    {
                                        <span class="cell-stack__main">@SourceName(r)</span>
                                    }
                                    <span class="cell-stack__sub">@(FromGitHub(r) ? "GitHub release" : "Build pipeline")</span>
                                </span>
                            </span>
                        </td>
                        <td>
                            <span class="cell-stack">
                                <span class="cell-stack__main">@DeliveryModeDisplay.ScheduleSentence(r.DeploymentSchedule)</span>
                                @if (r.SchemaSyncMode == BcSyncMode.ForceSync)
                                {
                                    <span class="cell-stack__sub rp-list__force"
                                          title="Force sync can drop tables and columns, and the data in them, when the new app no longer has them.">
                                        <Icon Name="triangle-alert" Width="13" Height="13" />Force sync
                                    </span>
                                }
                                else
                                {
                                    <span class="cell-stack__sub">Schema sync: @DeliveryModeDisplay.SyncMode(r.SchemaSyncMode)</span>
                                }
                            </span>
                        </td>
                        <td class="data-table__actions">@RowMenu(r, "btn--sm")</td>
                    </tr>
                }
            </tbody>
        </table>

        @* The phone layout from the sheet's compact variant: one card per pipeline,
           the keyline on its edge, the table's cells folded into lines. The page is
           a size container, so the swap follows the page's width, not the window's. *@
        <div class="rp-cards">
            @foreach (var r in Visible)
            {
                var state = StateOf(r);
                var rowState = state.Row;
                var next = NextOf(r);
                <div class="rp-card @rowState">
                    <span class="data-table__state data-table__state--icon rp-card__state @(state.Spin ? "data-table__state--spin" : "")"
                          role="img" aria-label="@state.Label" title="@state.Label">
                        <Icon Name="@state.Icon" Width="15" Height="15" />
                    </span>
                    <span class="cell-stack rp-card__head">
                        <span class="cell-stack__main rp-card__name"><a href="@($"/pipelines/deployments/{r.Id}")">@r.Name</a></span>
                        <span class="cell-stack__sub">
                            @r.ProjectName - @r.EnvironmentName
                            <span class="@(IsProduction(r) ? "rp-list__prod" : null)">@r.EnvironmentType</span>
                        </span>
                    </span>
                    @RowMenu(r, "rp-card__menu")
                    <div class="rp-card__lines">
                        @if (r.LiveDelivery is { } live)
                        {
                            <span class="rp-list__live">
                                <span>@LiveText(live)</span>
                                @if (live.StartedAt is { } started)
                                {
                                    <span> - started <Timestamp Value="@started" Relative="true" /></span>
                                }
                            </span>
                            @if (live.AppCount > 0)
                            {
                                <progress class="progress rp-card__meter" value="@live.AppsDone" max="@live.AppCount"></progress>
                            }
                            else
                            {
                                <progress class="progress rp-card__meter"></progress>
                            }
                        }
                        else if (r.LastDelivery is { } last)
                        {
                            <span>
                                <span class="rp-card__outcome @OutcomeTone(r)">@OutcomeText(last)</span>
                                <span class="rp-list__none"><Timestamp Value="@last.At" Relative="true" /></span>
                            </span>
                        }
                        else
                        {
                            <span class="rp-list__none">Nothing deployed yet</span>
                        }
                        @if (next.Scheduled)
                        {
                            <span class="rp-card__next">
                                Next: <span class="rp-card__next-when" title="@next.Title">@next.Text</span>
                                @if (next.Sub is not null)
                                {
                                    <span class="rp-list__none">@(" - " + next.Sub)</span>
                                }
                            </span>
                        }
                        @if (WarningOf(r) is { } warning)
                        {
                            <span class="rp-card__warn @warning.Tone">@warning.Text</span>
                        }
                    </div>
                </div>
            }
        </div>
    </ChildContent>

    <Footer>
        <div class="pager">
            <span class="pager__count">@PagerCount</span>
        </div>
    </Footer>
</ListPage>

<RescheduleDeploymentDialog @ref="_rescheduleDialog" OnRescheduled="_ => ReloadAsync()" />

<ConfirmDialog @ref="_deleteConfirm" Title="Delete deployment pipeline?"
               ConfirmLabel="Delete deployment pipeline" ConfirmButtonClass="btn--danger" ConfirmIcon="trash-2" />

@code {
    private List<ReleasePipelineRow>? _rows;
    private List<PipelineProjectOption> _projectOptions = new();
    private ConfirmDialog? _deleteConfirm;
    private string? _error;

    // The filters. All of them work on the rows already loaded: the list is one
    // organisation's pipelines, which is tens, not thousands.
    private string _search = string.Empty;
    private string _solution = string.Empty;
    private string _envType = string.Empty;
    private ListTab _tab = ListTab.All;

    private enum ListTab { All, ShippingNow, NeedsAttention, Scheduled }

    private static readonly ListTab[] Tabs = [ListTab.All, ListTab.ShippingNow, ListTab.NeedsAttention, ListTab.Scheduled];

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);
    private PeriodicTimer? _poll;
    private CancellationTokenSource? _pollCts;

    /// <summary>
    /// The tab to open on, from <c>?show=</c> (<c>shipping</c>, <c>attention</c> or
    /// <c>scheduled</c>): how the Pipelines dashboard's tiles land on the rows they count.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "show")]
    public string? Show { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _tab = Show switch
        {
            "shipping" => ListTab.ShippingNow,
            "attention" => ListTab.NeedsAttention,
            "scheduled" => ListTab.Scheduled,
            _ => ListTab.All,
        };
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var projects = await Projects.ListProjectsAsync();
        _projectOptions = projects.Select(p => new PipelineProjectOption(p.Id, p.Name)).ToList();
        _rows = await Releases.ListReleasePipelineOverviewAsync();
        EnsurePolling();
    }

    // ── What the table shows ─────────────────────────────────────────────────

    /// <summary>The rows after the search, the two selects and the tab, most urgent first.</summary>
    private List<ReleasePipelineRow> Visible =>
        Filtered.Where(r => InTab(r, _tab)).OrderBy(Urgency).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase).ToList();

    /// <summary>The rows after the search and the two selects; the tab counts are taken over these.</summary>
    private IEnumerable<ReleasePipelineRow> Filtered
    {
        get
        {
            IEnumerable<ReleasePipelineRow> rows = _rows ?? [];
            var term = _search.Trim();
            if (term.Length > 0)
            {
                rows = rows.Where(r => r.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                                       || r.ProjectName.Contains(term, StringComparison.OrdinalIgnoreCase)
                                       || r.EnvironmentName.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            if (_solution.Length > 0)
            {
                rows = rows.Where(r => r.ProjectName == _solution);
            }
            rows = _envType switch
            {
                "production" => rows.Where(IsProduction),
                "sandbox" => rows.Where(r => !IsProduction(r)),
                _ => rows,
            };
            return rows;
        }
    }

    /// <summary>The pipelines holding a deployment prepared from a new build, waiting for approval (#934).</summary>
    private List<ReleasePipelineRow> WaitingRows =>
        (_rows ?? []).Where(r => r.ProposedDelivery is not null).OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase).ToList();

    private IEnumerable<ReleasePipelineRow> LiveRows =>
        (_rows ?? []).Where(r => r.LiveDelivery is not null).OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> SolutionNames =>
        (_rows ?? []).Select(r => r.ProjectName).Distinct().OrderBy(n => n, StringComparer.OrdinalIgnoreCase);

    private int CountFor(ListTab tab) => Filtered.Count(r => InTab(r, tab));

    private static string TabLabel(ListTab tab) => tab switch
    {
        ListTab.ShippingNow => "Shipping now",
        ListTab.NeedsAttention => "Needs attention",
        ListTab.Scheduled => "Scheduled",
        _ => "All",
    };

    private static bool InTab(ReleasePipelineRow r, ListTab tab) => tab switch
    {
        ListTab.ShippingNow => r.LiveDelivery is not null,
        ListTab.NeedsAttention => NeedsAttention(r),
        ListTab.Scheduled => IsScheduled(r),
        _ => true,
    };

    /// <summary>The fixed order: shipping now, needs attention, scheduled, the rest.</summary>
    private static int Urgency(ReleasePipelineRow r) =>
        r.LiveDelivery is not null ? 0 : NeedsAttention(r) ? 1 : IsScheduled(r) ? 2 : 3;

    /// <summary>
    /// The last deployment failed, or the environment can no longer take one - including
    /// one being deleted, which leaves the pipeline useless until someone re-points it -
    /// or a deployment prepared from a new build is waiting for someone to approve it.
    /// </summary>
    private static bool NeedsAttention(ReleasePipelineRow r) =>
        r.LiveDelivery is null
        && (EnvironmentBroken(r) || EnvironmentDeleting(r) || r.LastDelivery?.Status == ProjectDeliveryStatus.Failed
            || r.ProposedDelivery is not null);

    /// <summary>A deployment waiting for its time, or one handed to Business Central that it has yet to install.</summary>
    private static bool IsScheduled(ReleasePipelineRow r) =>
        r.LiveDelivery is null && !EnvironmentBroken(r)
        && (r.NextDelivery is not null || r.LastDelivery?.Status == ProjectDeliveryStatus.HandedOff);

    /// <summary>
    /// An environment gone from Business Central, or failed there: no deployment will
    /// run until someone sorts it out. One being deleted is said in its own words
    /// instead - there is nothing to sort out, only a pipeline to re-point.
    /// </summary>
    private static bool EnvironmentBroken(ReleasePipelineRow r) =>
        r.EnvironmentMissing || BcEnvironmentStatus.Classify(r.EnvironmentStatus) == BcEnvironmentReadiness.Failed;

    private static bool EnvironmentDeleting(ReleasePipelineRow r) =>
        !r.EnvironmentMissing && BcEnvironmentStatus.Classify(r.EnvironmentStatus) == BcEnvironmentReadiness.Deleting;

    private string PagerCount
    {
        get
        {
            var rows = Visible;
            var solutions = rows.Select(r => r.ProjectId).Distinct().Count();
            return $"{rows.Count} deployment pipeline{(rows.Count == 1 ? "" : "s")} across {solutions} solution{(solutions == 1 ? "" : "s")}";
        }
    }

    // ── One row, in words ────────────────────────────────────────────────────

    private sealed record RowState(string Row, string Icon, string Label, bool Spin = false);

    /// <summary>
    /// The row's keyline, glyph and the words behind the glyph. The mapping is the
    /// sheet's: a handed-off deployment is still waiting on Business Central, so it takes
    /// the queued keyline, not a success.
    /// </summary>
    private static RowState StateOf(ReleasePipelineRow r)
    {
        if (r.LiveDelivery is { } live) return new("is-running", "refresh-cw", "Shipping now: " + LiveText(live), Spin: true);
        if (r.EnvironmentMissing) return new("is-failed", "circle-alert", "Environment missing, deployments cannot run");
        if (EnvironmentBroken(r)) return new("is-failed", "circle-alert", "Environment failed in Business Central, deployments cannot run");
        if (r.LastDelivery?.Status == ProjectDeliveryStatus.Failed) return new("is-failed", "circle-x", "Last deployment failed");
        if (r.ProposedDelivery is not null) return new("is-draft", "user", "Deployment waiting for approval");
        if (r.NextDelivery is not null) return new("is-queued", "clock", "Next deployment scheduled");
        return r.LastDelivery?.Status switch
        {
            ProjectDeliveryStatus.HandedOff => new("is-queued", "send", "Waiting for the Business Central update"),
            ProjectDeliveryStatus.Deployed => new("is-succeeded", "circle-check", "Last deployment succeeded"),
            ProjectDeliveryStatus.Cancelled => new("is-cancelled", "x", "Last deployment cancelled"),
            _ => new("rp-list__idle", "circle-dashed", "Nothing deployed yet"),
        };
    }

    /// <summary>"Installing app 2 of 3". The engine sends one app at a time.</summary>
    private static string LiveText(ReleasePipelineLiveDelivery live)
    {
        var verb = live.Phase switch
        {
            ProjectDeliveryResultStatus.Uploading => "Uploading",
            ProjectDeliveryResultStatus.Installing => "Installing",
            _ => live.Status == ProjectDeliveryStatus.Claimed ? "Starting" : "Sending",
        };
        return live.AppCount > 0 ? $"{verb} app {live.CurrentApp} of {live.AppCount}" : verb;
    }

    /// <summary>
    /// The band's sentence: what, where and for whom. Since when follows it in the
    /// markup as a Timestamp, then <see cref="LiveTook"/>.
    /// </summary>
    private static string LiveSentence(ReleasePipelineRow r)
    {
        var live = r.LiveDelivery!;
        return $"{LiveText(live)} into {r.EnvironmentName} ({r.EnvironmentType}) for {r.ProjectName}.";
    }

    /// <summary>The tail after "Started 4 minutes ago": how long the last deployment here took.</summary>
    private static string LiveTook(ReleasePipelineLiveDelivery live) =>
        live.PreviousDuration is { } took
            ? $"; the last deployment here took {RelativeTime.Duration(took)}."
            : ".";

    private static string OutcomeText(ReleasePipelineLastDelivery last) => last.Status switch
    {
        ProjectDeliveryStatus.Deployed => "Deployed",
        ProjectDeliveryStatus.Failed => last.FailedAppName is { Length: > 0 } app ? $"Failed on {app}" : "Failed",
        ProjectDeliveryStatus.HandedOff => "Handed to Business Central",
        ProjectDeliveryStatus.Cancelled => "Cancelled",
        _ => last.Status,
    };

    private static string OutcomeTone(ReleasePipelineRow r) => r.LastDelivery?.Status switch
    {
        ProjectDeliveryStatus.Deployed => "rp-tone--success",
        ProjectDeliveryStatus.Failed => "rp-tone--danger",
        ProjectDeliveryStatus.Cancelled => "rp-tone--muted",
        _ => "rp-tone--ink",
    };

    private sealed record Toned(string Text, string Tone);

    /// <summary>The environment's health beside its type; null for a state not worth a word.</summary>
    private static Toned? HealthOf(ReleasePipelineRow r)
    {
        if (r.EnvironmentMissing) return new("Missing", "rp-tone--danger");
        return BcEnvironmentStatus.Classify(r.EnvironmentStatus) switch
        {
            BcEnvironmentReadiness.Ready => new("Ready", "rp-tone--muted"),
            BcEnvironmentReadiness.Busy => new(BcEnvironmentStatus.StatusWord(r.EnvironmentStatus), "rp-tone--muted"),
            BcEnvironmentReadiness.Deleting => new("Being deleted", "rp-tone--warning"),
            BcEnvironmentReadiness.Failed => new("Failed", "rp-tone--danger"),
            _ => null,
        };
    }

    /// <summary>The line the phone card adds for something wrong with the target or the settings.</summary>
    private static Toned? WarningOf(ReleasePipelineRow r)
    {
        if (r.EnvironmentMissing) return new("Environment missing. Reconnect it in solution settings.", "rp-tone--danger");
        if (EnvironmentBroken(r)) return new("Environment failed in Business Central.", "rp-tone--danger");
        if (EnvironmentDeleting(r)) return new("Environment is being deleted.", "rp-tone--warning");
        if (r.ProposedDelivery is { } waiting && r.NextDelivery is null) return new($"Deployment of build #{waiting.BuildId} waiting for approval.", "rp-tone--warning");
        if (r.SchemaSyncMode == BcSyncMode.ForceSync) return new("Force sync: can drop columns and their data.", "rp-tone--warning");
        return null;
    }

    private sealed record NextRelease(string Text, string Tone, string? Sub = null, string? SubTone = null, string? Title = null, bool Scheduled = false, string? SubHref = null);

    /// <summary>
    /// The Next deployment cell. Deployments never start on their own, so without a
    /// scheduled one it is "None scheduled" - except for a deployment already handed to
    /// Business Central, which installs with the environment's next update.
    /// </summary>
    private static NextRelease NextOf(ReleasePipelineRow r)
    {
        if (r.EnvironmentMissing) return new("Blocked", "rp-tone--danger rp-list__strong", "Environment not found", SubHref: $"/solutions/{r.ProjectId}/bc", Title: "Reconnect it on the solution's Business Central tab");
        if (EnvironmentBroken(r)) return new("Blocked", "rp-tone--danger rp-list__strong", "Environment failed in Business Central", SubHref: $"/solutions/{r.ProjectId}/bc", Title: "Sort it out in the Business Central admin center, or point this pipeline at another environment");

        if (r.NextDelivery is { } next)
        {
            string? sub = next.OutsideWindow ? "Outside the update window"
                : next.ScheduledBy is { Length: > 0 } by ? $"Scheduled by {by}" : null;
            return new(RelativeTime.Until(next.ScheduledFor), "rp-tone--ink rp-list__strong", sub,
                next.OutsideWindow ? "rp-tone--warning" : null, RelativeTime.ExactUtc(next.ScheduledFor), Scheduled: true);
        }

        if (r.ProposedDelivery is { } waiting)
        {
            return new("Waiting for approval", "rp-tone--warning rp-list__strong", $"Build #{waiting.BuildId}",
                Title: $"Prepared {RelativeTime.Ago(waiting.PreparedAt)} from build #{waiting.BuildId}. Open the pipeline to approve or dismiss it.");
        }

        if (r.LiveDelivery is null && r.LastDelivery is { Status: ProjectDeliveryStatus.HandedOff } handed)
        {
            var schedule = BcDeploymentSchedule.Normalize(handed.DeploymentSchedule);
            if (r.EnvironmentNextUpdate is { Date: { } date } update && date > DateTime.UtcNow
                && (schedule == BcDeploymentSchedule.NextMinorUpdate
                    || (schedule == BcDeploymentSchedule.NextMajorUpdate
                        && string.Equals(update.Type, "major", StringComparison.OrdinalIgnoreCase))))
            {
                return new(RelativeTime.Until(date), "rp-tone--ink rp-list__strong", $"With update {update.Version}",
                    Title: RelativeTime.ExactUtc(date), Scheduled: true);
            }
            return new(DeliveryModeDisplay.Schedule(handed.DeploymentSchedule), "rp-tone--ink rp-list__strong",
                "No date set yet", Scheduled: true);
        }

        return EnvironmentDeleting(r)
            ? new("None scheduled", "rp-list__none", "Deployments are refused while the environment is being deleted", "rp-tone--warning")
            : new("None scheduled", "rp-list__none");
    }

    /// <summary>
    /// Production targets read louder than sandboxes: installing into one is the
    /// action with consequences, so its type takes the danger tone the rest of the
    /// app uses for Production.
    /// </summary>
    private static bool IsProduction(ReleasePipelineRow r) =>
        r.EnvironmentType.Equals("Production", StringComparison.OrdinalIgnoreCase);

    private static bool FromGitHub(ReleasePipelineRow r) => r.ArtifactSource == ReleaseArtifactSource.GithubRelease;

    /// <summary>What a deployment pipeline draws from: its build pipeline, or the repository whose GitHub releases it installs (#632).</summary>
    private static string SourceName(ReleasePipelineRow r) =>
        FromGitHub(r) ? r.GithubReleaseRepositoryName ?? "a GitHub repository" : r.BuildPipelineName;

    private RenderFragment RowMenu(ReleasePipelineRow r, string cssClass) =>
        @<span class="ra">
            <button type="button" class="btn btn--icon @cssClass" data-ra-toggle
                    title="More actions" aria-label="@($"Actions for {r.Name}")"
                    aria-haspopup="menu" aria-expanded="false">
                <Icon Name="ellipsis-vertical" Width="17" Height="17" />
            </button>
            <div class="ra__menu menu" role="menu">
                @if (r.NextDelivery is { } nextDelivery)
                {
                    <button type="button" class="menu__item" @onclick="() => OpenRescheduleAsync(nextDelivery.DeliveryId)" role="menuitem">
                        <Icon Name="calendar" Width="15" Height="15" />
                        <span>Reschedule next deployment</span>
                    </button>
                }
                else if (r.LiveDelivery is null && r.LastDelivery is { StillHeld: true } held)
                {
                    @* Business Central is holding it for its update; moving it re-uploads the build. *@
                    <button type="button" class="menu__item" @onclick="() => OpenRescheduleAsync(held.DeliveryId)" role="menuitem">
                        <Icon Name="calendar" Width="15" Height="15" />
                        <span>Reschedule next deployment</span>
                    </button>
                }
                <a class="menu__item" href="@($"/pipelines/deployments/{r.Id}/edit?returnUrl={ListPath}")" role="menuitem">
                    <Icon Name="pencil" Width="15" Height="15" />
                    <span>Edit</span>
                </a>
                <a class="menu__item" href="@($"/solutions/{r.ProjectId}")" role="menuitem">
                    <Icon Name="folder-git-2" Width="15" Height="15" />
                    <span>Solution settings</span>
                </a>
                <div class="menu__sep"></div>
                <button type="button" class="menu__item menu__item--danger" @onclick="() => DeleteAsync(r)" role="menuitem">
                    <Icon Name="trash-2" Width="15" Height="15" />
                    <span>Delete</span>
                </button>
            </div>
        </span>;

    // ── Actions ──────────────────────────────────────────────────────────────

    private void ClearFilters()
    {
        _search = string.Empty;
        _solution = string.Empty;
        _envType = string.Empty;
        _tab = ListTab.All;
    }

    /// <summary>This list, escaped for a returnUrl, so Cancel on the editor comes back here.</summary>
    private const string ListPath = "%2Fpipelines%2Fdeployments";

    private const string NewPipelineHref = "/pipelines/deployments/new?returnUrl=" + ListPath;

    private RescheduleDeploymentDialog? _rescheduleDialog;
    // Set when Reschedule finds nothing waiting any more.
    private string? _notice;

    /// <summary>
    /// Reschedule from the list: the same dialog as the pipeline page's. A deployment that
    /// started since the list was read can't be moved any more, so the list is reloaded to show it.
    /// </summary>
    private async Task OpenRescheduleAsync(int deliveryId)
    {
        if (_rescheduleDialog is null) return;
        try
        {
            _notice = null;
            if (!await _rescheduleDialog.OpenAsync(deliveryId, secretExpiresAt: null))
            {
                await ReloadAsync();
                _notice = _rescheduleDialog.LastRefusal;
            }
        }
        catch (ProjectAccessDeniedException)
        {
            // Not this person's to move: say so rather than leave the click doing nothing.
            _notice = "Only the solution's owner or an Admin can reschedule its deployments.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to open the reschedule dialog for delivery {DeliveryId}.", deliveryId);
        }
    }

    private async Task DeleteAsync(ReleasePipelineRow row)
    {
        if (_deleteConfirm is null) return;
        WaitingDeploymentCounts waiting;
        try
        {
            waiting = await Releases.CountWaitingDeploymentsAsync(row.Id);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to count waiting deployments of deployment pipeline {ReleasePipelineId}.", row.Id);
            waiting = new WaitingDeploymentCounts(0, 0);
        }
        var confirmed = await _deleteConfirm.OpenAsync(
            "Delete deployment pipeline?",
            DeleteMessage(row.Name, waiting),
            "Delete deployment pipeline");
        if (!confirmed) return;

        _error = null;
        try
        {
            await Releases.SoftDeleteReleasePipelineAsync(row.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            // Silently logging left the row on screen with no explanation - the person
            // is entitled to know their delete did not happen.
            Log.LogError(ex, "Failed to delete deployment pipeline {ReleasePipelineId}.", row.Id);
            _error = $"Couldn't delete \"{row.Name}\". Try again, and if it keeps failing tell an administrator.";
        }
    }

    /// <summary>
    /// The delete confirmation, saying what happens to deployments still waiting: the
    /// delete cancels them (#1108), except ones Business Central already holds.
    /// </summary>
    internal static string DeleteMessage(string name, WaitingDeploymentCounts waiting)
    {
        var text = $"Delete \"{name}\"? This removes the deployment target. Build pipelines and past builds are untouched.";
        if (waiting.Waiting > 0)
        {
            text += waiting.Waiting == 1
                ? " 1 deployment is waiting to run and will be cancelled."
                : $" {waiting.Waiting} deployments are waiting to run and will be cancelled.";
        }
        if (waiting.HeldByBusinessCentral > 0)
        {
            text += waiting.HeldByBusinessCentral == 1
                ? " 1 deployment is already booked in Business Central and will still install; cancel it from the environment's page if you don't want it."
                : $" {waiting.HeldByBusinessCentral} deployments are already booked in Business Central and will still install; cancel them from the environment's page if you don't want them.";
        }
        return text;
    }

    // ── Live polling while something ships ───────────────────────────────────

    private void EnsurePolling()
    {
        if (_poll is not null) return;
        if (_rows is null || !_rows.Any(r => r.LiveDelivery is not null)) return;
        _pollCts = new CancellationTokenSource();
        _poll = new PeriodicTimer(PollInterval);
        _ = PollLoopAsync(_poll, _pollCts.Token);
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                // Own DI scope per tick: this runs off the circuit's dispatcher, so sharing
                // the circuit's DbContext would let a tick and a click have two commands in
                // flight on one context. Same as the pipeline page (#679).
                List<ReleasePipelineRow> rows;
                await using (var scope = ScopeFactory.CreateAsyncScope())
                {
                    rows = await scope.ServiceProvider.GetRequiredService<ReleasePipelineService>()
                        .ListReleasePipelineOverviewAsync(token);
                }

                if (token.IsCancellationRequested) break;
                await InvokeAsync(() => { _rows = rows; StateHasChanged(); });
                if (!rows.Any(r => r.LiveDelivery is not null)) break;
            }
        }
        catch (OperationCanceledException) { /* navigating away */ }
        catch (ObjectDisposedException) when (token.IsCancellationRequested) { /* torn down mid-poll */ }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deployment pipeline list poll failed.");
        }
        finally
        {
            StopPoll();
        }
    }

    /// <summary>
    /// Idempotent, single-shot teardown: disposal (renderer thread) and the poll loop's
    /// finally (thread pool) both call this, so the fields are claimed atomically.
    /// </summary>
    private void StopPoll()
    {
        var cts = Interlocked.Exchange(ref _pollCts, null);
        var timer = Interlocked.Exchange(ref _poll, null);
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
    }

    public ValueTask DisposeAsync()
    {
        StopPoll();
        return ValueTask.CompletedTask;
    }
}
