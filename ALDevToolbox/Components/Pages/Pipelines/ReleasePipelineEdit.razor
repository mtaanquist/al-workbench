@page "/pipelines/deployments/new"
@page "/pipelines/deployments/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ProjectService Projects
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.PipelineService Pipelines
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.ReleasePipelineService Releases
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connections
@inject ALDevToolbox.Services.GitHub.GitHubReleaseService GitHubReleases
@inject ALDevToolbox.Services.Tools.IToolAvailability ToolAvailability
@inject NavigationManager Nav
@inject ILogger<ReleasePipelineEdit> Log
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer

@*
    Create / edit a deployment pipeline (#1080): where its apps come from, the target
    Business Central environment, when installs run and how they reconcile schema.
    Force sync is gated behind an explicit acknowledgement because it can drop columns.
    Deploying a build lives on the pipeline's own page; this only configures the
    reusable target. It was a modal until the options outgrew one. See
    .design/saas-delivery.md.

    Named user: a BC consultant who has connected a customer's environment and wants a
    reusable "publish this build to Production" target.

    Query: ?solution= fixes the solution for a new pipeline, ?buildPipeline= fills in the build
    pipeline to deploy from, ?deploy= is a build to deploy once the pipeline exists (the
    "Deploy..." action on a build row, #938), and ?returnUrl= is where Cancel goes.
*@

<PageTitle>@HeadTitle · Pipelines · AL Workbench</PageTitle>

<EditPage Title="@HeadTitle" Sticky="true"
          IsLoading="@_loadingPage" IsNotFound="@_notFound"
          Trail="@Trail">
    <SubtitleContent>
        @if (DeployBuildId is { } deployBuild && !_editing && _artifactSource == ReleaseArtifactSource.Build && _buildPipelineId == BuildPipelineId)
        {
            <span>After you create it, you choose when build #@deployBuild installs.</span>
        }
        else if (_editing)
        {
            <span>Changes apply to the next deployment.</span>
        }
        else
        {
            <span>Choose where a build pipeline's apps are installed and when. You deploy from the pipeline's page once it is created.</span>
        }
    </SubtitleContent>
    <Actions>
        <a class="btn btn--sm" href="@CancelHref">Cancel</a>
        @if (ShowPrimary)
        {
            <button type="button" class="btn btn--sm btn--primary" @onclick="SaveAsync" disabled="@(!CanSave)">
                <Icon Name="@(_editing ? "save" : "plus")" Width="14" Height="14" />
                <span>@(_saving ? "Saving..." : _editing ? "Save deployment pipeline" : "Create deployment pipeline")</span>
            </button>
        }
    </Actions>
    <NotFound>
        <EmptyState Icon="send" Title="This deployment pipeline doesn't exist" Heading="true">
            <Text>It may have been deleted, or it belongs to a solution you don't have access to.</Text>
            <Action>
                <a class="btn" href="/pipelines/deployments"><Icon Name="arrow-left" Width="16" Height="16" /><span>All deployment pipelines</span></a>
            </Action>
        </EmptyState>
    </NotFound>
    <ChildContent>
        @if (!_canManage)
        {
            <Alert Tone="AlertTone.Warn">
                <span>Only people who manage the solution can change this solution's deployment pipelines.</span>
            </Alert>
        }
        else if (!_editing && _projectOptions is { Count: 0 })
        {
            <EmptyState Icon="send" Title="No solutions yet">
                <Text>A deployment pipeline installs a solution's apps into one of its environments. Create a solution first.</Text>
                <Action>
                    <a class="btn" href="/solutions/new"><Icon Name="plus" Width="16" Height="16" /><span>New solution</span></a>
                </Action>
            </EmptyState>
        }
        else
        {
            @if (_saveError is { } se)
            {
                <Alert Tone="AlertTone.Danger"><span>@se</span></Alert>
            }

            <form class="edit-col" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <section class="card">
                    <div class="card__head"><h2 class="card__title">Source</h2></div>
                    <div class="card__body form-sec">
                        @if (_pickProject)
                        {
                            <div class="field">
                                <label class="field__label" for="rpe-solution">Solution</label>
                                <SelectBox>
                                    <select id="rpe-solution" class="select" @onchange="OnProjectChosenAsync" disabled="@(_saving || _loading)">
                                        <option value="0" selected="@(_projectId == 0)">Choose a solution...</option>
                                        @foreach (var p in _projectOptions ?? [])
                                        {
                                            <option value="@p.Id" selected="@(_projectId == p.Id)">@p.Name</option>
                                        }
                                    </select>
                                </SelectBox>
                            </div>
                        }
                        else
                        {
                            <div class="field">
                                <span class="field__label">Solution</span>
                                <span class="field__value" id="rpe-solution-name">@_projectName</span>
                            </div>
                        }

                        @if (_projectId == 0)
                        {
                            <p class="form-sec__cap">Choose a customer solution to set up a deployment pipeline for.</p>
                        }
                        else if (_loading)
                        {
                            <LoadingBlock Text="Loading the solution's build pipelines and environments..." />
                        }
                        else if (!_solutionManageable)
                        {
                            <Alert Tone="AlertTone.Warn">
                                <span>Only people who manage the solution can add deployment pipelines to @(_projectName ?? "this solution").</span>
                            </Alert>
                        }
                        else if (_buildPipelines is { Count: 0 } && _releaseRepositories is not { Count: > 0 })
                        {
                            <p class="form-sec__cap">
                                This solution has no build pipeline yet. A deployment installs compiled apps, so
                                create a build pipeline first.
                            </p>
                            @if (_buildsOn)
                            {
                                <div>
                                    <a class="btn btn--sm" href="@NewBuildPipelineHref">
                                        <Icon Name="plus" Width="14" Height="14" />
                                        <span>New build pipeline</span>
                                    </a>
                                </div>
                            }
                        }
                        else if (_buildPipelines is not null)
                        {
                            @if (_releaseRepositories is { Count: > 0 })
                            {
                                <div class="field">
                                    <label class="field__label" for="rpe-source">Where the apps come from</label>
                                    <SelectBox>
                                        <select id="rpe-source" class="select" @bind="_artifactSource" disabled="@_saving">
                                            <option value="@ReleaseArtifactSource.Build">Builds from a build pipeline</option>
                                            <option value="@ReleaseArtifactSource.GithubRelease">Releases published on a GitHub repository</option>
                                        </select>
                                    </SelectBox>
                                    <small class="field__hint">Choose GitHub releases when the apps were built somewhere else. AL Workbench installs whatever is attached to the release you pick.</small>
                                </div>
                            }

                            @if (_artifactSource == ReleaseArtifactSource.GithubRelease)
                            {
                                <div class="field">
                                    <label class="field__label" for="rpe-repo">Repository to deploy from</label>
                                    <SelectBox>
                                        <select id="rpe-repo" class="select" @bind="_releaseRepositoryId" disabled="@_saving">
                                            <option value="0">Choose a repository...</option>
                                            @foreach (var repo in _releaseRepositories ?? [])
                                            {
                                                <option value="@repo.Id">@repo.FullName</option>
                                            }
                                        </select>
                                    </SelectBox>
                                    <small class="field__hint">Its releases are what this pipeline installs. Only the .app files attached to the release are installed; other attachments are ignored.</small>
                                </div>
                            }
                            else if (_buildPipelines is { Count: > 0 })
                            {
                                <div class="field">
                                    <label class="field__label" for="rpe-build">Build pipeline to deploy from</label>
                                    <SelectBox>
                                        <select id="rpe-build" class="select" @bind="_buildPipelineId" @bind:after="SuggestBranchRule" disabled="@_saving">
                                            <option value="0">Choose a build pipeline...</option>
                                            @foreach (var bp in _buildPipelines)
                                            {
                                                <option value="@bp.Id">@bp.Name</option>
                                            }
                                        </select>
                                    </SelectBox>
                                    @if (_deletedSourceName is { } deletedSource && _buildPipelineId == 0)
                                    {
                                        <FieldError Message="@($"\"{deletedSource}\" was deleted. Choose the build pipeline to deploy from now.")" />
                                    }
                                    <small class="field__hint">Its successful builds are what this pipeline deploys.</small>
                                </div>
                            }
                            else
                            {
                                <Alert Tone="AlertTone.Info" Role="status">
                                    <span>
                                        This solution has no build pipeline yet. Set "Where the apps come from" to
                                        GitHub releases@(_buildsOn ? ", or " : ".")
                                        @if (_buildsOn)
                                        {
                                            <a href="@NewBuildPipelineHref">create a build pipeline</a><text>.</text>
                                        }
                                    </span>
                                </Alert>
                            }
                        }
                    </div>
                </section>

                @if (HasOptions)
                {
                    <section class="card">
                        <div class="card__head"><h2 class="card__title">Target</h2></div>
                        <div class="card__body form-sec">
                            @if (_environments is { Count: 0 })
                            {
                                <p class="form-sec__cap">
                                    This solution has no Business Central environments yet. Connect Business Central
                                    and refresh its environments to choose a target.
                                </p>
                                <div>
                                    <a class="btn btn--sm" href="@($"/solutions/{_projectId}/bc")">
                                        <Icon Name="plug" Width="14" Height="14" />
                                        <span>Connect Business Central</span>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="field">
                                    <label class="field__label" for="rpe-env">Target environment</label>
                                    <SelectBox>
                                        <select id="rpe-env" class="select" @bind="_environmentId" @bind:after="SuggestBranchRule" disabled="@_saving">
                                            <option value="0">Choose an environment...</option>
                                            @foreach (var env in _environments!)
                                            {
                                                var typeSuffix = env.Name.Equals(env.Type, StringComparison.OrdinalIgnoreCase) ? "" : $" ({env.Type})";
                                                var status = BcEnvironmentStatus.Humanise(env.Status);
                                                var statusSuffix = $" — {(status.Length > 0 ? status : "not checked yet")}";
                                                <option value="@env.Id">@env.Name@typeSuffix@statusSuffix</option>
                                            }
                                        </select>
                                    </SelectBox>
                                    <small class="field__hint">Where the apps are installed — every app in the build goes to this one. Each environment's status is shown: you can pick one that's busy, but deployments to it are refused until Business Central reports it ready.</small>
                                </div>

                                @if (_artifactSource == ReleaseArtifactSource.Build)
                                {
                                    <div class="field">
                                        <label class="@(_restrictBranch ? "check is-checked" : "check")">
                                            <input id="rpe-restrict-branch" type="checkbox" checked="@_restrictBranch" disabled="@_saving"
                                                   @onchange="OnRestrictBranchChanged" />
                                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                            <span>Only deploy builds from one branch</span>
                                        </label>
                                        <small class="field__hint">Deploying a build from any other branch is refused, so a test build can't reach this environment by mistake. On by default when the target is a Production environment.</small>
                                    </div>
                                    @if (_restrictBranch)
                                    {
                                        <div class="field">
                                            <label class="field__label" for="rpe-allowed-branch">Branch</label>
                                            <input id="rpe-allowed-branch" type="text" class="input" maxlength="@GitBranchName.MaxLength"
                                                   pattern="@GitBranchName.HtmlPattern" @bind="_allowedBranch" @bind:after="() => _branchTextEdited = true"
                                                   disabled="@_saving" placeholder="e.g. main" spellcheck="false" autocomplete="off" />
                                            <small class="field__hint">Filled in with the branch the build pipeline builds. Leave empty to allow each repository's default branch.</small>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </section>

                    @if (_environments is { Count: > 0 })
                    {
                        <section class="card">
                            <div class="card__head"><h2 class="card__title">Installing</h2></div>
                            <div class="card__body form-sec">
                                <div class="field">
                                    <label class="field__label" for="rpe-schedule">When a deployment installs</label>
                                    <SelectBox>
                                        <select id="rpe-schedule" class="select" @bind="_deploymentSchedule" disabled="@_saving">
                                            @if (!BcDeploymentSchedule.Pickable.Contains(_deploymentSchedule))
                                            {
                                                <option value="@_deploymentSchedule" disabled>No longer available - choose one</option>
                                            }
                                            @foreach (var mode in BcDeploymentSchedule.Pickable)
                                            {
                                                var unavailable = BcDeploymentSchedule.IsOurDeliveryWindow(mode) && !ChosenEnvironmentHasWindow;
                                                <option value="@mode" disabled="@unavailable">@DeliveryModeDisplay.ScheduleChoice(mode, ChosenEnvironment?.Name)@(unavailable && ChosenEnvironment is not null ? " (none set yet)" : "")</option>
                                            }
                                        </select>
                                    </SelectBox>
                                    <small class="field__hint">A deployment starts when you press Deploy or approve a prepared one. This is when it installs.</small>
                                    @if (ChosenEnvironment is { } chosenEnv && !ChosenEnvironmentHasWindow)
                                    {
                                        @if (BcDeploymentSchedule.IsOurDeliveryWindow(_deploymentSchedule))
                                        {
                                            <small class="field__hint">
                                                @chosenEnv.Name has no delivery window yet.
                                                <a href="@($"/environments/{chosenEnv.Id}")" target="_blank" rel="noopener">Set one on the environment's page</a>
                                                (opens in a new tab), or choose another time for installs.
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="field__hint">@ScheduleHint</small>
                                            <small class="field__hint">
                                                To install in @(chosenEnv.Name)'s delivery window, first
                                                <a href="@($"/environments/{chosenEnv.Id}")" target="_blank" rel="noopener">set one on the environment's page</a>
                                                (opens in a new tab).
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <small class="field__hint">@ScheduleHint</small>
                                    }
                                </div>

                                <div class="field">
                                    <label class="field__label" for="rpe-sync">Schema sync</label>
                                    <SelectBox>
                                        <select id="rpe-sync" class="select" @bind="_schemaSyncMode" disabled="@_saving">
                                            @if (!BcSyncMode.IsValid(_schemaSyncMode))
                                            {
                                                <option value="@_schemaSyncMode" disabled>No longer available - choose one</option>
                                            }
                                            @foreach (var mode in BcSyncMode.All)
                                            {
                                                <option value="@mode">@DeliveryModeDisplay.SyncMode(mode)</option>
                                            }
                                        </select>
                                    </SelectBox>
                                    <small class="field__hint"><b>Add</b> only ever adds — the safe default. <b>Force sync</b> can drop table columns and lose data.</small>
                                </div>

                                @if (_schemaSyncMode == BcSyncMode.ForceSync)
                                {
                                    <label class="check check--ack @(_forceSyncAck ? "is-checked" : "")">
                                        <input type="checkbox" checked="@_forceSyncAck"
                                               @onchange="e => _forceSyncAck = (bool)(e.Value ?? false)" disabled="@_saving" />
                                        <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                        <span>I understand Force sync can drop columns and permanently lose data in this environment.</span>
                                    </label>
                                }
                            </div>
                        </section>

                        @* Only a build pipeline has "a new build" to follow (#934). *@
                        @if (_artifactSource == ReleaseArtifactSource.Build)
                        {
                            <section class="card">
                                <div class="card__head"><h2 class="card__title">Automation</h2></div>
                                <div class="card__body form-sec">
                                    <div class="field">
                                        <label class="@(_prepareOnNewBuild ? "check is-checked" : "check")">
                                            <input id="rpe-prepare" type="checkbox" checked="@_prepareOnNewBuild" disabled="@_saving"
                                                   @onchange="e => _prepareOnNewBuild = (bool)(e.Value ?? false)" />
                                            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                            <span>Prepare a deployment when a new build succeeds</span>
                                        </label>
                                        <small class="field__hint">@PrepareHint</small>
                                    </div>
                                    @if (_prepareOnNewBuild && ChosenEnvironment is not null && !ChosenEnvironmentIsSandbox)
                                    {
                                        <p class="field__hint">To deploy new builds without waiting for approval, choose a sandbox as the target environment. Production environments always wait for approval.</p>
                                    }
                                    @if (_prepareOnNewBuild && ChosenEnvironmentIsSandbox)
                                    {
                                        <div class="field">
                                            <label class="@(_deployWithoutApproval ? "check is-checked" : "check")">
                                                <input id="rpe-without-approval" type="checkbox" checked="@_deployWithoutApproval" disabled="@_saving"
                                                       @onchange="e => _deployWithoutApproval = (bool)(e.Value ?? false)" />
                                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                                <span>Deploy it automatically, without waiting for approval</span>
                                            </label>
                                            <small class="field__hint">@WithoutApprovalHint</small>
                                        </div>
                                    }
                                </div>
                            </section>
                        }

                        <section class="card">
                            <div class="card__head"><h2 class="card__title">Name</h2></div>
                            <div class="card__body form-sec">
                                @if (_showCustomName)
                                {
                                    <div class="field">
                                        <label class="field__label" for="rpe-name">Name</label>
                                        <input id="rpe-name" type="text" class="input" maxlength="@PipelineNames.MaxLength" @bind="_customName"
                                               disabled="@_saving" placeholder="@($"e.g. {GeneratedName ?? "main to Production"} - hotfix")" @ref="_nameInput" />
                                        @if (_nameError is not null)
                                        {
                                            <FieldError Message="@_nameError" />
                                        }
                                        else
                                        {
                                            <small class="field__hint" id="rpe-name-hint">Clear it to name the pipeline after where its apps come from and where they go. Changing either of those does the same, unless you also type a new name.</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="field">
                                        <span class="field__label">Will be named</span>
                                        <span class="field__value" id="rpe-generated-name">@(GeneratedName ?? "-")</span>
                                        <small class="field__hint">Deployment pipelines are named after where the apps come from and the environment they go to.</small>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                }

                @if (MissingStep is { } missing)
                {
                    <p class="field__hint">@missing</p>
                }
            </form>
        }
    </ChildContent>
</EditPage>

@code {
    /// <summary>The deployment pipeline being edited; null on <c>/pipelines/deployments/new</c>.</summary>
    [Parameter] public int? Id { get; set; }

    /// <summary>A solution to create the pipeline under, fixed rather than picked.</summary>
    [SupplyParameterFromQuery(Name = "solution")] public int? Solution { get; set; }

    /// <summary>The build pipeline to deploy from, filled in when the person came from its page (#938).</summary>
    [SupplyParameterFromQuery(Name = "buildPipeline")] public int? BuildPipelineId { get; set; }

    /// <summary>A build to deploy once the new pipeline exists: saving opens Deploy on the pipeline's page with it chosen.</summary>
    [SupplyParameterFromQuery(Name = "deploy")] public int? DeployBuildId { get; set; }

    /// <summary>Where Cancel goes: the page the person came from. Local paths only.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private bool _loadingPage = true;
    private bool _notFound;
    private bool _canManage = true;
    private bool _editing;
    private bool _pickProject;
    private List<PipelineProjectOption>? _projectOptions;
    private int _projectId;
    private string? _projectName;
    // The pipeline's name when the page opened, for the crumbs.
    private string? _loadedName;

    // A name the person typed, shown only when the generated one is taken (or the
    // pipeline already carries a typed name). Blank means the generated name.
    private string _customName = string.Empty;
    private bool _showCustomName;
    // Why the name field is showing: the name it would get is taken. Shown under the field.
    private string? _nameError;
    private ElementReference _nameInput;
    private bool _focusName;
    private string _artifactSource = ReleaseArtifactSource.Build;
    private int _buildPipelineId;
    private int _releaseRepositoryId;
    private int _environmentId;
    private string _deploymentSchedule = BcDeploymentSchedule.Immediate;
    private string _schemaSyncMode = BcSyncMode.Add;
    private bool _forceSyncAck;
    private bool _prepareOnNewBuild;
    private bool _deployWithoutApproval;
    // Who deployments without approval run as, for an existing pipeline that has it on.
    private string? _withoutApprovalBy;
    // The branch rule: only builds from _allowedBranch (blank = the default branch).
    private bool _restrictBranch;
    private string _allowedBranch = string.Empty;
    // Set once the person ticks or unticks the rule, so picking another environment no
    // longer turns it on or off for them.
    private bool _branchRuleTouched;
    // Set once the person types a branch, so picking another build pipeline no longer
    // refills it.
    private bool _branchTextEdited;

    private bool _loading;
    private bool _saving;
    private string? _saveError;
    private List<OePipeline>? _buildPipelines;
    private List<ProjectEnvironmentRow>? _environments;
    // The solution's GitHub repositories inside the connected organisation. Empty when
    // there is no GitHub connection, and then the source choice isn't offered at all.
    private IReadOnlyList<GitHubReleaseRepositoryOption>? _releaseRepositories;

    /// <summary>
    /// True when the repository list could not be read at all, as opposed to
    /// there being none. A pipeline that draws from GitHub cannot be saved while
    /// this stands: the picker would be empty for a reason that has nothing to do
    /// with the solution.
    /// </summary>
    private bool _repositoriesFailed;

    // Whether the chosen solution may get a new pipeline from this person. The picker lists
    // every solution they can see, and a read-only one can be seen but not changed.
    private bool _solutionManageable = true;
    // Whether the build pipelines tool is on, so the "create a build pipeline" links lead somewhere.
    private bool _buildsOn = true;

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private string HeadTitle => _editing ? "Edit deployment pipeline" : "New deployment pipeline";

    /// <summary>A new build pipeline for this solution, coming back here when it is cancelled.</summary>
    private string NewBuildPipelineHref =>
        $"/pipelines/new?solution={_projectId}&returnUrl={Uri.EscapeDataString($"/pipelines/deployments/new?solution={_projectId}")}";

    /// <summary>The primary action, except where the page shows a step to take first instead.</summary>
    private bool ShowPrimary =>
        _canManage && !_loadingPage && !_notFound
        && !(!_editing && _projectOptions is { Count: 0 })
        && !(_projectId != 0 && !_loading && (!_solutionManageable || !HasOptions || _environments is { Count: 0 }));

    /// <summary>Why Save is still off, once the page has loaded and the reason is something to choose.</summary>
    private string? MissingStep
    {
        get
        {
            if (_saving || _loading || !HasOptions || _environments is not { Count: > 0 }) return null;
            // The source card already says what to do when there is no build pipeline to choose.
            if (_artifactSource == ReleaseArtifactSource.Build && _buildPipelines is not { Count: > 0 }) return null;
            if (_artifactSource == ReleaseArtifactSource.GithubRelease ? _releaseRepositoryId == 0 : _buildPipelineId == 0)
                return _artifactSource == ReleaseArtifactSource.GithubRelease
                    ? "Choose a repository to deploy from to continue."
                    : "Choose a build pipeline to deploy from to continue.";
            if (_environmentId == 0) return "Choose a target environment to continue.";
            if (BcDeploymentSchedule.IsOurDeliveryWindow(_deploymentSchedule) && !ChosenEnvironmentHasWindow)
                return "Choose another time for installs, or set a delivery window on the environment, to continue.";
            if (_schemaSyncMode == BcSyncMode.ForceSync && !_forceSyncAck)
                return "Tick the Force sync acknowledgement to continue.";
            return null;
        }
    }

    private IReadOnlyList<Crumb> Trail => _editing && Id is { } id
        ? [new("Deployment pipelines", "/pipelines/deployments"), new(_loadedName ?? "Deployment pipeline", $"/pipelines/deployments/{id}"), new("Edit")]
        : [new("Deployment pipelines", "/pipelines/deployments"), new("New deployment pipeline")];

    /// <summary>The page the person came from, else the pipeline (editing) or the list (creating).</summary>
    private string CancelHref
    {
        get
        {
            var fallback = _editing && Id is { } id ? $"/pipelines/deployments/{id}" : "/pipelines/deployments";
            if (string.IsNullOrEmpty(ReturnUrl)) return fallback;
            var safe = ALDevToolbox.Endpoints.EndpointHelpers.ResolveSafeReturn(ReturnUrl);
            return safe == "/" && ReturnUrl != "/" ? fallback : safe;
        }
    }

    /// <summary>The solution's options are loaded and there is something to deploy from.</summary>
    private bool HasOptions =>
        !_loading && _projectId != 0 && _buildPipelines is not null && _environments is not null
        && (_buildPipelines.Count > 0 || _releaseRepositories is { Count: > 0 });

    /// <summary>The environment currently picked as the target, or null before one is chosen.</summary>
    private ProjectEnvironmentRow? ChosenEnvironment =>
        _environmentId == 0 ? null : _environments?.FirstOrDefault(e => e.Id == _environmentId);

    /// <summary>
    /// Only a sandbox may be deployed to without approval (#1096). The server refuses it
    /// for anything else and checks again before every such deployment.
    /// </summary>
    private bool ChosenEnvironmentIsSandbox =>
        ChosenEnvironment is { } env && BcEnvironmentTypes.IsSandbox(env.Type);

    private string PrepareHint => DeploysWithoutApproval
        ? "Each new build is deployed automatically. A newer build replaces a deployment still waiting for its time."
        : "The deployment waits on this pipeline's page until someone approves it. A newer build replaces one still waiting. Nothing is installed before then.";

    private bool DeploysWithoutApproval => _prepareOnNewBuild && _deployWithoutApproval && ChosenEnvironmentIsSandbox;

    private string WithoutApprovalHint =>
        "Installs at the time chosen under 'When a deployment installs', using your access, and recorded as started by you. "
        + (_withoutApprovalBy is { Length: > 0 } who ? $"Saving makes you the person it runs as instead of {who}. " : "")
        + "Production environments always wait for approval.";

    /// <summary>
    /// Whether the picked environment has a delivery window. The "in its delivery
    /// window" choice is offered only when it does, and re-evaluated whenever the
    /// environment changes, because the window belongs to the environment.
    /// </summary>
    private bool ChosenEnvironmentHasWindow =>
        ChosenEnvironment is { } env && UpdateWindow.IsConfigured(env.UpdateWindowStart, env.UpdateWindowEnd);

    /// <summary>What the chosen timing does, in a sentence.</summary>
    private string ScheduleHint
    {
        get
        {
            if (BcDeploymentSchedule.IsOurDeliveryWindow(_deploymentSchedule))
            {
                return ChosenEnvironment is { } env && ChosenEnvironmentHasWindow
                    ? $"Deployments are scheduled for the next opening of the delivery window agreed with the customer for {env.Name} ({env.UpdateWindowStart:HH:mm}-{env.UpdateWindowEnd:HH:mm}, solution's time zone). This is not Business Central's own update window. The person releasing can still choose to release now."
                    : "Deployments default to the next opening of the environment's delivery window.";
            }
            return BcDeploymentSchedule.Normalize(_deploymentSchedule) switch
            {
                BcDeploymentSchedule.NextMinorUpdate => "Hands the app to Business Central, which installs it with the environment's next minor update.",
                BcDeploymentSchedule.NextMajorUpdate => "Hands the app to Business Central, which installs it with the environment's next major update.",
                _ => "Installs as soon as the deployment is sent.",
            };
        }
    }

    /// <summary>Save is live once the required fields are chosen and any Force-Sync acknowledgement is given.</summary>
    /// <summary>The name of the deleted build pipeline this one drew from, when it did; null otherwise.</summary>
    private string? _deletedSourceName;

    private bool CanSave =>
        _canManage && _solutionManageable && !_saving && !_loading
        && _environments is { Count: > 0 }
        && (_artifactSource == ReleaseArtifactSource.GithubRelease
            ? _releaseRepositoryId != 0 && !_repositoriesFailed
            : _buildPipelines is { Count: > 0 } && _buildPipelineId != 0)
        && _environmentId != 0
        && (!BcDeploymentSchedule.IsOurDeliveryWindow(_deploymentSchedule) || ChosenEnvironmentHasWindow)
        && (_schemaSyncMode != BcSyncMode.ForceSync || _forceSyncAck);

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        _buildsOn = ToolAvailability.IsSiteEnabled(ALDevToolbox.Domain.Tools.ToolKey.Pipelines)
            && !ALDevToolbox.Endpoints.EndpointHelpers.ReadDisabledTools(user).Contains(ALDevToolbox.Domain.Tools.ToolKey.Pipelines);
        if (Id is { } id)
        {
            await LoadForEditAsync(id);
        }
        else
        {
            await LoadForCreateAsync();
        }
        _loadingPage = false;
        if (_notFound || !_canManage || _projectId == 0) return;
        await LoadProjectAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusName && _showCustomName)
        {
            _focusName = false;
            try { await _nameInput.FocusAsync(); }
            catch { /* element already detached */ }
        }
    }

    private async Task LoadForEditAsync(int id)
    {
        _editing = true;
        try
        {
            var rp = await Releases.GetReleasePipelineAsync(id);
            if (rp is null) { _notFound = true; return; }
            _canManage = await Releases.CanManageAsync(id);
            _projectId = rp.ProjectId;
            _projectName = rp.Project?.Name ?? string.Empty;
            _loadedName = rp.Name;
            _customName = rp.NameIsCustom ? rp.Name : string.Empty;
            _showCustomName = rp.NameIsCustom;
            _artifactSource = ReleaseArtifactSource.IsValid(rp.ArtifactSource) ? rp.ArtifactSource : ReleaseArtifactSource.Build;
            // A deleted source can't be picked again (#1123): start the choice empty and
            // say why, rather than showing a placeholder over a value Save would send.
            _deletedSourceName = rp.BuildPipeline?.DeletedAt is not null ? rp.BuildPipeline.Name : null;
            _buildPipelineId = _deletedSourceName is null ? rp.BuildPipelineId ?? 0 : 0;
            _releaseRepositoryId = rp.GithubReleaseRepositoryId ?? 0;
            _environmentId = rp.ProjectEnvironmentId;
            _deploymentSchedule = rp.DeploymentSchedule;
            _schemaSyncMode = rp.SchemaSyncMode;
            _forceSyncAck = rp.SchemaSyncMode == BcSyncMode.ForceSync; // already-saved choice is pre-acknowledged
            _prepareOnNewBuild = rp.PrepareReleaseOnNewBuild;
            _deployWithoutApproval = rp.DeployWithoutApproval;
            _withoutApprovalBy = rp.DeployWithoutApproval ? rp.DeployWithoutApprovalByUser?.DisplayName : null;
            _restrictBranch = rp.RestrictBranch;
            _allowedBranch = rp.AllowedBranch ?? string.Empty;
        }
        catch (ProjectAccessDeniedException)
        {
            // A private solution this person isn't on the team for reads the same
            // as one that no longer exists.
            _notFound = true;
        }
    }

    private async Task LoadForCreateAsync()
    {
        var projects = await Projects.ListProjectsAsync();
        _projectOptions = projects.Select(p => new PipelineProjectOption(p.Id, p.Name)).ToList();
        if (Solution is { } sid && _projectOptions.FirstOrDefault(p => p.Id == sid) is { } chosen)
        {
            _pickProject = false;
            _projectId = chosen.Id;
            _projectName = chosen.Name;
            _buildPipelineId = BuildPipelineId ?? 0;
        }
        else
        {
            _pickProject = true;
            _projectId = 0;
        }
    }

    private async Task OnProjectChosenAsync(ChangeEventArgs e)
    {
        _projectId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _buildPipelines = null;
        _environments = null;
        _releaseRepositories = null;
        _releaseRepositoryId = 0;
        // The previous solution's picks mean nothing here: its build pipeline and
        // environment ids would otherwise survive, invisible, into the save.
        _artifactSource = ReleaseArtifactSource.Build;
        _buildPipelineId = 0;
        _environmentId = 0;
        _projectName = _projectOptions?.FirstOrDefault(p => p.Id == _projectId)?.Name;
        _solutionManageable = true;
        SuggestBranchRule();
        if (_projectId != 0) await LoadProjectAsync();
    }

    /// <summary>
    /// On create, turns the branch rule on for a production environment, allowing the
    /// branch the chosen build pipeline builds, until the person changes it themselves.
    /// An existing pipeline's rule is never changed for them.
    /// </summary>
    private void SuggestBranchRule()
    {
        if (_editing) return;
        if (!_branchRuleTouched)
        {
            _restrictBranch = ChosenEnvironment is { } env && BcEnvironmentTypes.IsProduction(env.Type);
        }
        if (!_branchTextEdited) _allowedBranch = BuildPipelineBranch;
    }

    /// <summary>The branch the chosen build pipeline builds; blank for each repository's default branch.</summary>
    private string BuildPipelineBranch =>
        _buildPipelines?.FirstOrDefault(p => p.Id == _buildPipelineId)?.Branch ?? string.Empty;

    /// <summary>
    /// Turning the rule on fills in the build pipeline's branch unless a branch was typed,
    /// so an editor ticking it on an existing pipeline doesn't save "default branch only"
    /// for a pipeline that builds another one.
    /// </summary>
    private void OnRestrictBranchChanged(ChangeEventArgs e)
    {
        _restrictBranch = (bool)(e.Value ?? false);
        _branchRuleTouched = true;
        if (_restrictBranch && !_branchTextEdited && string.IsNullOrWhiteSpace(_allowedBranch))
        {
            _allowedBranch = BuildPipelineBranch;
        }
    }

    /// <summary>
    /// The name the service will give the pipeline, "{source} to {environment}",
    /// shown as the person picks. Null until both are chosen.
    /// </summary>
    private string? GeneratedName
    {
        get
        {
            var environment = _environments?.FirstOrDefault(e => e.Id == _environmentId)?.Name;
            if (string.IsNullOrWhiteSpace(environment)) return null;
            if (_artifactSource == ReleaseArtifactSource.GithubRelease)
            {
                var repository = _releaseRepositories?.FirstOrDefault(r => r.Id == _releaseRepositoryId)?.DisplayName;
                return string.IsNullOrWhiteSpace(repository) ? null : PipelineNames.ForDeploymentFromReleases(repository, environment);
            }
            var buildPipeline = _buildPipelines?.FirstOrDefault(p => p.Id == _buildPipelineId)?.Name;
            return string.IsNullOrWhiteSpace(buildPipeline) ? null : PipelineNames.ForDeploymentFromBuild(buildPipeline, environment);
        }
    }

    /// <summary>
    /// Loads the chosen solution's active build pipelines and the environments still
    /// present in Business Central. Both feed the pickers; an empty list drives the
    /// guidance states above.
    /// </summary>
    private async Task LoadProjectAsync()
    {
        _loading = true;
        _saveError = null;
        _repositoriesFailed = false;
        StateHasChanged();
        try
        {
            // A new pipeline only; an edit has already checked.
            _solutionManageable = _editing || await Projects.CanManageAsync(_projectId);
            if (!_solutionManageable) return;
            _buildPipelines = await Pipelines.ListPipelinesAsync(_projectId);
            // A build pipeline handed over in the address that isn't this solution's
            // would otherwise be saved without ever showing in the picker.
            if (_buildPipelineId != 0 && _buildPipelines.All(p => p.Id != _buildPipelineId))
            {
                _buildPipelineId = 0;
            }
            // Never fails the page: without a GitHub connection the source choice
            // isn't offered and the pipeline draws from a build pipeline as before.
            try
            {
                _releaseRepositories = await GitHubReleases.ListRepositoryOptionsAsync(_projectId);
            }
            catch (Exception ex)
            {
                Log.LogError(ex, "Reading the solution's GitHub repositories failed for solution {ProjectId}.", _projectId);
                _releaseRepositories = null;
                // Saying nothing here would leave somebody editing a pipeline that
                // already draws from GitHub staring at an empty picker with no
                // reason given - and Save is refused while this stands.
                _repositoriesFailed = true;
                _saveError = "The repositories on GitHub could not be read just now. Reload the page to try again.";
            }
            var envs = await Connections.ListEnvironmentsAsync(_projectId);
            // Every environment still present is a valid target - an extension installs
            // into the environment, so there is nothing further to choose inside one.
            // Keep an environment that's the current edit's target even if it's since gone
            // missing, so editing doesn't silently drop the existing selection.
            _environments = envs
                .Where(env => env.MissingSince is null || env.Id == _environmentId)
                .ToList();
            // With nothing built here yet, GitHub releases are the only source there is:
            // show that picker rather than an empty one for build pipelines.
            if (!_editing && _buildPipelines.Count == 0 && _releaseRepositories is { Count: > 0 })
            {
                _artifactSource = ReleaseArtifactSource.GithubRelease;
            }
        }
        catch (ProjectAccessDeniedException)
        {
            _saveError = "Only people who manage the solution can manage this solution's deployment pipelines.";
            _buildPipelines = new();
            _environments = new();
            _releaseRepositories = null;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Loading deployment pipeline options failed for solution {ProjectId}.", _projectId);
            _saveError = "Couldn't load the solution's build pipelines and environments.";
            _buildPipelines = new();
            _environments = new();
            _releaseRepositories = null;
        }
        finally
        {
            _loading = false;
            SuggestBranchRule();
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave) return;
        _saving = true;
        _saveError = null;
        _nameError = null;
        try
        {
            var input = new ReleasePipelineInput(
                _projectId, _showCustomName && !string.IsNullOrWhiteSpace(_customName) ? _customName.Trim() : null, _buildPipelineId, _environmentId, _deploymentSchedule, _schemaSyncMode,
                _artifactSource,
                _releaseRepositoryId == 0 ? null : _releaseRepositoryId,
                _prepareOnNewBuild && _artifactSource == ReleaseArtifactSource.Build,
                _restrictBranch && _artifactSource == ReleaseArtifactSource.Build,
                string.IsNullOrWhiteSpace(_allowedBranch) ? null : _allowedBranch.Trim(),
                _deployWithoutApproval && _prepareOnNewBuild && _artifactSource == ReleaseArtifactSource.Build && ChosenEnvironmentIsSandbox);

            int id;
            if (_editing && Id is { } rid)
            {
                await Releases.UpdateReleasePipelineAsync(rid, input);
                id = rid;
            }
            else
            {
                id = await Releases.CreateReleasePipelineAsync(input);
            }
            // Set up to deploy one build: carry on to deploying it, with that build chosen.
            var deploy = !_editing && DeployBuildId is { } buildId && _artifactSource == ReleaseArtifactSource.Build
                ? $"?deploy={buildId}"
                : "";
            Nav.NavigateTo($"/pipelines/deployments/{id}{deploy}");
        }
        catch (PlanValidationException ex)
        {
            // The name is taken: let the person give this one a name of their own, and
            // say so beside the field rather than in the alert above the form.
            if (ex.Errors.TryGetValue("Name", out var nameError))
            {
                _showCustomName = true;
                _nameError = nameError;
                _focusName = true;
            }
            // Anything else wrong with the form still shows in the alert.
            _saveError = ex.Errors.Where(e => e.Key != "Name").Select(e => e.Value).FirstOrDefault()
                ?? (_nameError is null ? "Couldn't save the deployment pipeline." : null);
        }
        catch (ProjectAccessDeniedException)
        {
            _saveError = "Only people who manage the solution can manage this solution's deployment pipelines.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to save deployment pipeline for solution {ProjectId}.", _projectId);
            _saveError = "Couldn't save the deployment pipeline.";
        }
        finally
        {
            _saving = false;
        }
    }
}
