@page "/pipelines/builds"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ArtifactService Artifacts
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ProjectService Projects
@inject ALDevToolbox.Services.ObjectExplorer.Projects.BuildFreshnessService Freshness
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ProjectBuildImporter Builds
@inject ILogger<PipelinesBrowser> Log
@inject NavigationManager Nav
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.Entities.ObjectExplorer

@*
    The Pipelines landing: every pipeline across the org's solutions, with its latest
    build at a glance and a one-click download of its latest successful build. A
    pipeline is a named build flow under a solution (a solution can have several, each
    compiling a different set of extensions). Open one for its build history, run a
    build, or edit which extensions it compiles. Any signed-in user can browse and
    download. See .design/artifacts.md.

    Named user: a BC developer who needs the latest compiled .app for a customer
    environment. New pipelines are created here (pick a solution) or from a solution.

    Archetype 2 (list / browser), table view. This was a bespoke .alr row grid; the
    handoff is explicit that a history like this "is a real .data-table ... not a
    bespoke row layout, so it sorts, filters and scans like every other table in the
    workbench". Build status is the row's edge keyline plus a leading glyph, and the
    passive counts strip became .pill-tabs that actually filter.
    See .design/design-migration.md.

    Under each pipeline's name, whether its watched branch has moved past its last
    successful build (#964, the engine is BuildFreshnessService). A pipeline that has
    gets the warning keyline, a Build button in its row and the "Ready to build" tab,
    so the morning question "which customers need a build before today's deployments"
    is one tab away. The sheet has no line for this; it is composed from .cell-stack.
*@

<PageTitle>Build pipelines · AL Workbench</PageTitle>

<ListPage Title="Build pipelines" SearchForm="true"
          IsLoading="@(_rows is null)" IsEmpty="@(_totalCount == 0)" HasNoMatches="@(Visible.Count == 0)"
          Trail='@([new("Home", "/"), new("Build pipelines")])'>
    <SubtitleContent>
        A build pipeline compiles a chosen set of a solution's extensions into downloadable
        <span class="u-nowrap"><code>.app</code> files</span>. To install them into one of the
        customer's environments, add a deployment pipeline under Deployments.
    </SubtitleContent>
    @* ListPage shows this only while there are pipelines. When there are none, the
       empty-state card carries the single, guided call to action - so there is no
       redundant button (which, with no solutions, would read as a bare "go make a
       solution"). *@
    <Actions>
        <button type="button" class="btn btn--primary" @onclick="NewPipelineAsync">
            <Icon Name="plus" Width="16" Height="16" />
            <span>New build pipeline</span>
        </button>
    </Actions>
    @* A plain GET form, so the search survives a reload and stays a shareable URL.
       The status tabs at the far end filter in memory - they're a view of what's
       already loaded, not a second round trip. *@
    <Search>
        <input type="search" name="q" value="@_search" class="input"
               placeholder="Search pipelines by name, solution, or owner..."
               aria-label="Search pipelines"
               aria-keyshortcuts="F3" title="Search pipelines (F3)" />
    </Search>
    <Trailing>
        <div class="pill-tabs" role="group" aria-label="Filter by build status">
            <button type="button" class="pill-tab @(_statusFilter is null ? "is-active" : "")"
                    @onclick="() => _statusFilter = null" aria-pressed="@(_statusFilter is null)">
                All<span class="pill-tab__count">@(_rows?.Count ?? 0)</span>
            </button>
            @if (_buildingCount > 0)
            {
                <button type="button" class="pill-tab @(_statusFilter == "building" ? "is-active" : "")"
                        @onclick="@(() => _statusFilter = "building")" aria-pressed="@(_statusFilter == "building")">
                    Building<span class="pill-tab__count">@_buildingCount</span>
                </button>
            }
            @if (_readyCount > 0)
            {
                <button type="button" class="pill-tab @(_statusFilter == "ready" ? "is-active" : "")"
                        @onclick="@(() => _statusFilter = "ready")" aria-pressed="@(_statusFilter == "ready")">
                    Ready to build<span class="pill-tab__count">@_readyCount</span>
                </button>
            }
            @if (_failedCount > 0)
            {
                <button type="button" class="pill-tab @(_statusFilter == "failed" ? "is-active" : "")"
                        @onclick="@(() => _statusFilter = "failed")" aria-pressed="@(_statusFilter == "failed")">
                    Needs attention<span class="pill-tab__count">@_failedCount</span>
                </button>
            }
        </div>
        @if (!string.IsNullOrEmpty(_search))
        {
            <a class="btn btn--sm" href="/pipelines/builds">Clear search</a>
        }
    </Trailing>
    <Loading>
        <table class="data-table data-table--edge">
            <thead><tr>
                <th class="data-table__col-state"><span class="u-sr">Latest build</span></th>
                <th>Pipeline</th><th>Solution</th><th>Owner</th><th>Latest build</th><th>When</th>
                <th class="data-table__actions">Actions</th>
            </tr></thead>
            <tbody><TableSkeletonRows Columns="6" /></tbody>
        </table>
        <LoadingBlock Text="Loading pipelines..." UnderTable="true" />
    </Loading>
    <Empty>
        <div class="card">
            @if (_projectOptions.Count > 0)
            {
                <EmptyState Icon="rocket" Title="No build pipelines yet">
                    <Text>
                        A pipeline picks which of a solution's extensions to compile. Create one to
                        start producing downloadable <code>.app</code> files.
                    </Text>
                    <Action>
                        <button type="button" class="btn btn--primary" @onclick="NewPipelineAsync">
                            <Icon Name="plus" Width="15" Height="15" />
                            <span>New build pipeline</span>
                        </button>
                    </Action>
                </EmptyState>
            }
            else
            {
                <EmptyState Icon="rocket" Title="No build pipelines yet">
                    <Text>
                        A pipeline compiles the code in a solution (a customer), so the first step is
                        creating that solution and pointing it at its repositories. Once a solution
                        exists you can add a pipeline to it.
                    </Text>
                    <Action>
                        <a class="btn btn--primary" href="/solutions/new">
                            <Icon Name="plus" Width="15" Height="15" />
                            <span>Create a solution</span>
                        </a>
                    </Action>
                </EmptyState>
            }
        </div>
    </Empty>
    <NoMatches>
        <div class="card">
            <EmptyState Icon="funnel-x" Title="@NoMatchesTitle">
                <Text>Try a shorter search term, or clear the filters to see all @_totalCount.</Text>
                <Action>
                    @if (string.IsNullOrEmpty(_search))
                    {
                        <button type="button" class="btn" @onclick="() => _statusFilter = null">Clear filters</button>
                    }
                    else
                    {
                        <a class="btn" href="/pipelines/builds">Clear filters</a>
                    }
                </Action>
            </EmptyState>
        </div>
    </NoMatches>
    <ChildContent>
        @if (_buildError is { } buildError)
        {
            <Alert Tone="AlertTone.Danger"><span>@buildError</span></Alert>
        }
        <table class="data-table data-table--edge">
            <thead>
                <tr>
                    <th class="data-table__col-state"><span class="u-sr">Latest build</span></th>
                    <th scope="col">Pipeline</th>
                    <th scope="col">Solution</th>
                    <th scope="col">Owner</th>
                    <th scope="col">Latest build</th>
                    <th scope="col">When</th>
                    <th scope="col" class="data-table__actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Visible)
                {
                    var sb = p.LatestSuccessfulBuildId;
                    var failedLatest = p.Latest?.Status == "failed";
                    var fresh = _summaries.GetValueOrDefault(p.Id);
                    var ready = IsReady(p);
                    var rowState = ready ? "pl-ahead" : p.Latest is { } s ? RowStateIcon.RowClass(s.Status) : null;
                    <tr class="@rowState">
                        <td class="data-table__col-state">
                            @if (p.Latest is { } st)
                            {
                                <RowStateIcon State="@st.Status" />
                            }
                        </td>
                        <td>
                            @* Build sits beside the answer rather than in the actions
                               cell, which holds only the kebab (#574): the button is
                               about the sentence next to it. *@
                            <div class="pl-name">
                                <div class="cell-stack">
                                    <span class="cell-stack__main">
                                        <a href="@($"/pipelines/{p.Id}")"><strong>@p.Name</strong></a>
                                        @* A quiet tag, so a pipeline that exists only to check the
                                           next version reads as one at a glance (#994). *@
                                        @if (p.IsPreview)
                                        {
                                            <span class="tag pl-target">@ProjectBuildTarget.Label(p.BcTarget)</span>
                                        }
                                    </span>
                                    @if (fresh is { Headline: not PipelineFreshnessHeadline.None })
                                    {
                                        <span class="cell-stack__sub"><FreshnessLine Summary="@fresh" /></span>
                                    }
                                </div>
                                @if (ready && _canBuild.Contains(p.Id))
                                {
                                    <button type="button" class="btn btn--sm" @onclick="() => BuildAsync(p)"
                                            disabled="@(_starting == p.Id)" aria-label="@($"Build {p.Name}")">
                                        <Icon Name="hammer" Width="13" Height="13" />
                                        <span>@(_starting == p.Id ? "Starting..." : "Build")</span>
                                    </button>
                                }
                            </div>
                        </td>
                        <td><a href="@($"/solutions/{p.ProjectId}")">@p.ProjectName</a></td>
                        <td class="u-muted">@(p.OwnerName ?? "—")</td>
                        <td>
                            @if (p.Latest is { } b)
                            {
                                <span class="pl-build">
                                    @if (!string.IsNullOrEmpty(b.CommitShort))
                                    {
                                        <span class="commit-chip">
                                            <Icon Name="git-commit-vertical" Width="11" Height="11" />@b.CommitShort
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(b.Branch))
                                    {
                                        <span class="pl-branch"><Icon Name="git-branch" Width="12" Height="12" />@b.Branch</span>
                                    }
                                    <span class="u-muted">@(string.IsNullOrEmpty(b.BcVersion) ? "BC —" : $"BC {b.BcVersion}")</span>
                                </span>
                            }
                            else
                            {
                                <span class="u-muted">No builds yet</span>
                            }
                        </td>
                        <td class="u-muted">
                            @if (p.Latest is { } w)
                            {
                                <span>@Verb(w.Status) <Timestamp Value="@(w.FinishedAt ?? w.StartedAt)" Relative="true" /></span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="data-table__actions">
                            <span class="ra">
                                <button type="button" class="btn btn--icon btn--sm" data-ra-toggle
                                        title="More actions" aria-label="More actions"
                                        aria-haspopup="menu" aria-expanded="false">
                                    <Icon Name="ellipsis-vertical" Width="17" Height="17" />
                                </button>
                                <div class="ra__menu menu" role="menu">
                                    <a class="menu__item" href="@($"/pipelines/{p.Id}")" role="menuitem">
                                        <Icon Name="package" Width="15" Height="15" />
                                        <span>View builds</span>
                                    </a>
                                    @if (sb is { } good2)
                                    {
                                        <a class="menu__item" href="@($"/artifacts/build/{good2}/all")" role="menuitem">
                                            <Icon Name="archive" Width="15" Height="15" />
                                            <span>@(failedLatest ? "Download last good build" : "Download all .app files")</span>
                                        </a>
                                    }
                                    <a class="menu__item" href="@($"/solutions/{p.ProjectId}")" role="menuitem">
                                        <Icon Name="folder-git-2" Width="15" Height="15" />
                                        <span>Solution settings</span>
                                    </a>
                                    <div class="menu__sep"></div>
                                    <button type="button" class="menu__item" data-copy-url="@($"/pipelines/{p.Id}")" role="menuitem">
                                        <Icon Name="copy" Width="15" Height="15" />
                                        <span data-copy-label>Copy link</span>
                                    </button>
                                </div>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </ChildContent>
</ListPage>

<PipelineEditorDialog @ref="_editor" OnSaved="OnPipelineCreatedAsync" />

@code {
    private string NoMatchesTitle => string.IsNullOrEmpty(_search)
        ? _statusFilter switch
        {
            "failed" => "No pipelines are failing right now",
            "ready" => "Every pipeline has a build of its latest changes",
            _ => "No pipelines are building right now",
        }
        : $"No pipelines match \"{_search}\"";

    private List<PipelineArtifactsRow>? _rows;
    private List<PipelineProjectOption> _projectOptions = new();
    private int _totalCount;
    private int _buildingCount;
    private int _failedCount;
    private int _readyCount;

    /// <summary>Each pipeline's freshness, folded to one sentence (#964). A pipeline missing here says nothing.</summary>
    private Dictionary<int, PipelineFreshnessSummary> _summaries = new();

    /// <summary>The pipelines this person may build, so Build is offered only where it would work.</summary>
    private HashSet<int> _canBuild = new();

    /// <summary>The pipeline whose Build was just pressed, while it is being queued.</summary>
    private int? _starting;
    private string? _buildError;

    /// <summary>
    /// The search term, taken from <c>?q=</c>.
    ///
    /// Read as a query parameter rather than from <c>IHttpContextAccessor</c>,
    /// which is what this page did before and why its search never worked: an
    /// interactive page runs OnInitializedAsync twice — once while prerendering,
    /// where HttpContext exists, and again on the circuit, where it is null. The
    /// second run silently reset the term and every row came back. This is
    /// populated in both passes.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    /// <summary>
    /// The status tab to open on, from <c>?show=</c> (<c>failed</c>, <c>building</c> or
    /// <c>ready</c>): how the Pipelines dashboard's "Failed builds" and "Ready to build"
    /// tiles land on the pipelines they count.
    /// Read once, so choosing another tab afterwards is not undone by a re-render.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "show")]
    public string? Show { get; set; }

    private string _search = string.Empty;

    /// <summary>What <see cref="_rows"/> was last loaded for, so a re-render doesn't re-query.</summary>
    private string? _loadedFor;

    /// <summary>
    /// The status tab in force, or null for "All". Filters the loaded rows in
    /// memory — the search is what goes back to the server.
    /// </summary>
    private string? _statusFilter;

    private PipelineEditorDialog? _editor;

    /// <summary>The rows the table actually renders: the search result, narrowed by the status tab.</summary>
    private List<PipelineArtifactsRow> Visible =>
        _rows is null ? new()
        : _statusFilter switch
        {
            "building" => _rows.Where(p => p.Latest?.Status is "building" or "queued").ToList(),
            "failed" => _rows.Where(p => p.Latest?.Status == "failed").ToList(),
            "ready" => _rows.Where(IsReady).ToList(),
            _ => _rows,
        };

    protected override void OnInitialized() =>
        _statusFilter = Show is "failed" or "building" or "ready" ? Show : null;

    // OnParametersSetAsync rather than OnInitializedAsync so submitting the
    // search form — which is a navigation, not a new component — reloads.
    protected override async Task OnParametersSetAsync()
    {
        _search = (Q ?? string.Empty).Trim();
        if (_loadedFor == _search) return;
        _loadedFor = _search;

        var projects = await Projects.ListProjectsAsync();
        _projectOptions = projects.Select(p => new PipelineProjectOption(p.Id, p.Name)).ToList();

        var all = await Artifacts.ListPipelinesAsync();
        _totalCount = all.Count;
        _buildingCount = all.Count(p => p.Latest?.Status is "building" or "queued");
        _failedCount = all.Count(p => p.Latest?.Status == "failed");

        var freshness = await Freshness.ListAsync();
        _summaries = freshness.ToDictionary(f => f.PipelineId, PipelineFreshnessSummary.From);
        _canBuild = freshness.Where(f => f.CanBuild).Select(f => f.PipelineId).ToHashSet();
        _readyCount = all.Count(IsReady);

        _rows = string.IsNullOrEmpty(_search) ? all : await Artifacts.ListPipelinesAsync(_search);
    }

    /// <summary>
    /// The branch has moved past the last build and nothing is building it already: a
    /// build that is queued or running is the answer, so the row stops asking for one.
    /// </summary>
    private bool IsReady(PipelineArtifactsRow p) =>
        _summaries.GetValueOrDefault(p.Id) is { IsAhead: true }
        && p.Latest?.Status is not ("queued" or "building");

    /// <summary>
    /// Build on a ready row: queues the pipeline's build and stays on the list, so the
    /// next customer can be built straight after. The row turns to Queued; the pipeline's
    /// own page follows the build live.
    /// </summary>
    private async Task BuildAsync(PipelineArtifactsRow p)
    {
        if (_starting is not null) return;
        _starting = p.Id;
        _buildError = null;
        try
        {
            await Builds.StartBuildAsync(p.Id);
            _loadedFor = null;
            await OnParametersSetAsync();
        }
        catch (PlanValidationException ex)
        {
            _buildError = $"{p.Name}: {ex.Errors.Values.FirstOrDefault() ?? "Could not start the build."}";
        }
        catch (ProjectAccessDeniedException)
        {
            _buildError = $"Only the owner of {p.ProjectName} or an admin can build {p.Name}.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to start build for pipeline {PipelineId} from the list.", p.Id);
            _buildError = $"Could not start the build of {p.Name}. Try again from its page.";
        }
        finally
        {
            _starting = null;
        }
    }

    private async Task NewPipelineAsync()
    {
        if (_editor is null || _projectOptions.Count == 0) return;
        await _editor.OpenForCreateAsync(_projectOptions);
    }

    private void OnPipelineCreatedAsync(int pipelineId) => Nav.NavigateTo($"/pipelines/{pipelineId}");

    private static string Verb(string status) => status switch
    {
        "ready" => "Built",
        "failed" => "Failed",
        "building" => "Started",
        _ => "Queued",
    };
}
