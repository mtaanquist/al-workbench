@page "/pipelines/{PipelineId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ArtifactService Artifacts
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.PipelineService Pipelines
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ProjectBuildImporter Builds
@inject ALDevToolbox.Services.ObjectExplorer.Projects.BuildFreshnessService Freshness
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.ReleasePipelineService Releases
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject NavigationManager Nav
@inject ALDevToolbox.Services.Tools.IToolAvailability ToolAvailability
@inject ILogger<PipelineBuilds> Log
@inject IServiceScopeFactory ScopeFactory
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone
@using Microsoft.Extensions.DependencyInjection
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer
@using ALDevToolbox.Domain.Entities.ObjectExplorer

@*
    One pipeline's builds: the Build action (runs the pipeline's saved extension
    selection), the latest build's deliverables (download each .app or all at once),
    the changelog since the last successful build, the full build history, the raw
    build log, and a pipeline-scoped Compare that diffs two of this pipeline's builds
    in the Object Explorer. The only path into a build's objects is the "Explore
    objects" deep-link here. While a build is in flight the page polls so the status
    flips Building -> Ready live. Editing which extensions are built is "Edit
    pipeline", its own page (PipelineEdit, #1080). See .design/artifacts.md.

    A successful build's row carries "Deploy...", the shortcut .design/saas-delivery.md
    describes (#938): it resolves which deployment pipeline takes this pipeline's builds
    (straight on when one does, a chooser when several do, the new deployment pipeline page
    with this pipeline filled in when none does, which carries on to the deployment) and opens the same ReleaseBuildDialog
    the deployment pipeline's page opens, with this build selected. The canonical Deploy
    action stays on the deployment pipeline.

    Above the latest build, the Branch card (#964): whether the branch this pipeline
    watches has moved past its last successful build - the latest commit GitHub told
    us about, the commit the build used, and the pull requests merged (or the commits
    pushed) in between, each linking to GitHub. It only reads; Build in the head stays
    the one primary action. The sheet has no card for this; it is composed from .card,
    .kv-grid and .meta-item.

    Named user: a BC consultant cutting a customer build. Primary action: Build. Repo
    editing and solution deletion live in the Solutions tool (/solutions/{id}).
*@

<PageTitle>@(_header?.Name ?? "Pipeline") · Pipelines · AL Workbench</PageTitle>

<DetailPage IsLoading="@(_loading)"
            LoadingText="Loading pipeline..."
            IsNotFound="@(_notFound)"
            Title="@(_header?.Name)"
            PageClass="pb-page">
    <NotFound>
        <EmptyState Icon="rocket" Title="This pipeline doesn't exist" Heading="true">
            <Text>It may have been deleted. Head back to the list to pick another.</Text>
            <Action>
                <a class="btn btn--primary" href="/pipelines/builds"><Icon Name="arrow-left" Width="16" Height="16" /><span>All build pipelines</span></a>
            </Action>
        </EmptyState>
    </NotFound>
    <Crumbs>
        <a href="/pipelines/builds">Build pipelines</a>
        <Icon Name="chevron-right" Width="12" Height="12" />
        <a href="@($"/solutions/{_header!.ProjectId}")">@_header!.ProjectName</a>
        <Icon Name="chevron-right" Width="12" Height="12" />
        <span>@_header!.Name</span>
    </Crumbs>
    <TitleRow>
        @if (_header!.Disabled)
        {
            <StatusPill Tone="muted"><span>Disabled</span></StatusPill>
        }
        @if (_latest is not null)
        {
            <StatusPill Tone="@RowStateIcon.PillTone(_latest.Status)">
                <span>@RowStateIcon.StateLabel(_latest.Status)</span>
            </StatusPill>
            @if (_latest.IsPreview)
            {
                @* Beside the state, because it changes what that state means: a
                   red preview build is the check doing its job (#994). *@
                <StatusPill Tone="info" title="Compiled against an upcoming Business Central version to catch breaking changes. Preview builds cannot be deployed.">
                    <span>Preview build</span>
                </StatusPill>
            }
        }
    </TitleRow>
    <SubtitleContent>
        Pipeline in @_header!.ProjectName
    </SubtitleContent>
    <Actions>
        @if (_canManage)
        {
            @if (_header!.Disabled)
            {
                @* A disabled pipeline builds nothing, so the way back is the action. *@
                <button type="button" class="btn btn--primary" @onclick="() => SetDisabledAsync(false)" disabled="@_switching">
                    <Icon Name="circle-play" Width="15" Height="15" />
                    <span>@(_switching ? "Enabling..." : "Enable pipeline")</span>
                </button>
            }
            else
            {
                @* One build at a time per pipeline: while one runs the button says so
                   instead of queuing a second. The status poll clears it when the build
                   finishes; StartBuildAsync refuses a click from a stale page. *@
                <button type="button" class="btn btn--primary" @onclick="RunBuildAsync" disabled="@(_starting || _buildRunning)">
                    <Icon Name="hammer" Width="15" Height="15" />
                    <span>@(_starting ? "Starting..." : _buildRunning ? "Build running" : "Build")</span>
                </button>
            }
            <a class="btn" href="@($"/pipelines/{PipelineId}/edit")">
                <Icon Name="settings" Width="15" Height="15" />
                <span>Edit pipeline</span>
            </a>
            @if (!_header!.Disabled)
            {
                <button type="button" class="btn" @onclick="() => SetDisabledAsync(true)" disabled="@_switching"
                        title="Stop this pipeline building, without losing its settings or builds.">
                    <Icon Name="circle-pause" Width="15" Height="15" />
                    <span>@(_switching ? "Disabling..." : "Disable pipeline")</span>
                </button>
            }
            @if (_canDelete)
            {
                <button type="button" class="btn" @onclick="DeletePipelineAsync">
                    <Icon Name="trash-2" Width="15" Height="15" />
                    <span>Delete</span>
                </button>
            }
        }
        @if (_latest is not null && _latestDetail is { Artifacts.Count: > 0 })
        {
            <a class="btn" href="@($"/artifacts/build/{_latest.Id}/all")">
                <Icon Name="archive" Width="15" Height="15" />
                <span>Download all</span>
            </a>
        }
    </Actions>
    <Meta>
        <span class="meta-item">
            <span class="meta-item__label">Solution</span>
            <span class="meta-item__value">@_header!.ProjectName</span>
        </span>
        <span class="meta-item">
            <span class="meta-item__label">Owner</span>
            <span class="meta-item__value">@(_header!.OwnerName ?? "—")</span>
        </span>
        <span class="meta-item">
            <span class="meta-item__label">Builds</span>
            <span class="meta-item__value">@_counts.Total</span>
        </span>
        @if (_header!.PreviewCheck)
        {
            <span class="meta-item">
                <span class="meta-item__label">Preview check</span>
                <span class="meta-item__value">
                    <PreviewCheckSummary PipelineId="@PipelineId" Enabled="true" Results="@_header!.PreviewChecks" Blocked="@_header!.PreviewCheckBlocked" />
                </span>
            </span>
        }
        @if (_header!.BuildOnPush)
        {
            <span class="meta-item">
                <span class="meta-item__label">Build on push</span>
                <span class="meta-item__value">@(_header!.BuildOnPushBlocked is { Length: > 0 } ? "Paused" : "On")</span>
            </span>
        }
        <span class="meta-item">
            <span class="meta-item__label">Latest BC</span>
            <span class="meta-item__value meta-item__value--mono">@(_latest is not null && BcShown(_latest) is { Length: > 0 } mb ? mb : "—")</span>
        </span>
        <span class="meta-item">
            <span class="meta-item__label">Last build</span>
            <span class="meta-item__value">@if (_latest is null) { <text>—</text> } else { <Timestamp Value="@(_latest.FinishedAt ?? _latest.StartedAt)" Relative="true" /> }</span>
        </span>
    </Meta>
    <ChildContent>
        @* Archetype: PageDetail.dc.html. Crumbs sit outside the head, the state
           pill sits beside the title, and the facts are a full-width .meta-row
           rather than the rail of cards this page used to open with.

           The body below does have a rail (.detail-body, divergence 70), which
           the archetype has not - but it holds reference and a secondary
           action, never the facts. Those belong in the strip above. *@
        @if (_buildError is { } be)
        {
            <Alert Tone="AlertTone.Danger"><span>@be</span></Alert>
        }

        @if (_header!.Disabled)
        {
            <Alert Tone="AlertTone.Info">
                <span>
                    This pipeline is disabled. It won't build: not on new commits, not for the nightly preview check, and not by hand.
                    @(_canManage ? "Enable it to start building again." : "Ask someone who manages this solution to enable it.")
                </span>
            </Alert>
        }

        @if (_header!.PreviewCheckBlocked is { Length: > 0 } paused)
        {
            <Alert Tone="AlertTone.Warn">
                <span>The nightly preview check is paused: @paused</span>
                @if (_canManage)
                {
                    <button type="button" class="btn btn--sm" @onclick="() => TakeOverAsync(PipelineAutomation.PreviewCheck)" disabled="@_takingOver">
                        <span>@(_takingOver ? "Saving..." : "Run the check as me")</span>
                    </button>
                }
            </Alert>
        }

        @if (_header!.BuildOnPushBlocked is { Length: > 0 } pushPaused)
        {
            <Alert Tone="AlertTone.Warn">
                <span>New commits are not being built automatically: @pushPaused@(_canManage ? "" : " Ask someone who manages this solution to resume it.")</span>
                @if (_canManage)
                {
                    <button type="button" class="btn btn--sm" @onclick="() => TakeOverAsync(PipelineAutomation.BuildOnPush)" disabled="@_takingOver"
                            title="From now on, builds on push use your repository access.">
                        <span>@(_takingOver ? "Saving..." : "Resume with my access")</span>
                    </button>
                }
            </Alert>
        }

        @if (_releaseNote is { } note)
        {
            <Alert Tone="@(note.Sent ? AlertTone.Success : AlertTone.Info)" Role="status">
                <span>
                    @note.Text
                    <a href="@($"/pipelines/deployments/{note.ReleasePipelineId}")">@note.LinkText</a>
                </span>
            </Alert>
        }

        @if (_counts.Total == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="box" Width="21" Height="21" /></span>
                <div class="empty-state__title">No builds yet</div>
                @if (_canManage && !_header!.Disabled)
                {
                    @* The empty state is the one screen with nothing else to do, so it
                       carries the action itself rather than pointing at a button. *@
                    <p class="empty-state__text">
                        Building compiles this pipeline's extensions, and the resulting
                        <span class="u-nowrap"><code>.app</code> files</span> show up here to
                        download. Each private repository needs a token first — set them up under
                        <a href="/account/repos">Account → Repository access</a>.
                    </p>
                    <button type="button" class="btn empty-state__action" @onclick="RunBuildAsync" disabled="@_starting">
                        <Icon Name="hammer" Width="15" Height="15" />
                        <span>@(_starting ? "Starting..." : "Build")</span>
                    </button>
                }
                else if (_header!.Disabled)
                {
                    <p class="empty-state__text">This pipeline is disabled, so it won't build.@(_canManage ? " Enable it to start building." : "")</p>
                }
                else
                {
                    <p class="empty-state__text">
                        The owner hasn't run this pipeline yet. Once they do, its compiled
                        <code>.app</code> files show up here to download.
                    </p>
                }
            </div>
        }
        else
        {
            <div class="detail-body@(HasRail ? "" : " detail-body--wide")">
                <div class="detail-body__main">
                    @* ── Branch (#964) ─────────────────────────────────── *@
                    @if (_freshSummary is { Headline: not PipelineFreshnessHeadline.None } && _freshness is { } fresh)
                    {
                        var shown = fresh.Repositories.Where(r => r.State != BuildFreshnessState.Unknown).ToList();
                        <section class="card" aria-labelledby="pb-fresh-title">
                            <div class="card__head">
                                <h2 class="card__title" id="pb-fresh-title">Branch</h2>
                            </div>
                            <div class="card__body">
                                <p class="pb-fresh__lead"><FreshnessLine Summary="@_freshSummary" /></p>
                                @foreach (var repo in shown)
                                {
                                    <div class="pb-fresh__repo">
                                        @if (shown.Count > 1)
                                        {
                                            <div class="pb-chg__name"><Icon Name="folder-git-2" Width="12" Height="12" />@repo.RepositoryName</div>
                                        }
                                        <div class="kv-grid">
                                            <span class="meta-item">
                                                <span class="meta-item__label">Branch</span>
                                                <span class="meta-item__value meta-item__value--mono">@(repo.Branch ?? "default")</span>
                                            </span>
                                            <span class="meta-item">
                                                <span class="meta-item__label">Latest commit</span>
                                                <span class="meta-item__value">
                                                    @if (repo.HeadSha is { } headSha)
                                                    {
                                                        <CommitLink WebUrl="@repo.WebUrl" Sha="@headSha" />
                                                        @if (repo.PusherLogin is { } pusher)
                                                        {
                                                            <text> pushed by @pusher</text>
                                                        }
                                                        @if (repo.PushedAt is { } pushedAt)
                                                        {
                                                            <text>, <Timestamp Value="@pushedAt" Relative="true" /></text>
                                                        }
                                                    }
                                                    else if (repo.State == BuildFreshnessState.BranchGone)
                                                    {
                                                        <text>Branch deleted</text>
                                                    }
                                                    else
                                                    {
                                                        <text>—</text>
                                                    }
                                                </span>
                                            </span>
                                            <span class="meta-item">
                                                <span class="meta-item__label">Last build used</span>
                                                <span class="meta-item__value">
                                                    @if (repo.BuiltSha is { } builtSha)
                                                    {
                                                        <CommitLink WebUrl="@repo.WebUrl" Sha="@builtSha" />
                                                        <text> in build #@fresh.LastBuildId</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Not built yet</text>
                                                    }
                                                </span>
                                            </span>
                                        </div>

                                        @if (repo.State == BuildFreshnessState.BranchGone && _canManage)
                                        {
                                            <p class="pb-note">Edit the pipeline to build from another branch.</p>
                                        }

                                        @if (repo.State == BuildFreshnessState.Ahead)
                                        {
                                            @if (repo.MergedPullRequests.Count > 0)
                                            {
                                                <div class="section-label">Merged pull requests</div>
                                                <ul class="pb-chg__list">
                                                    @foreach (var pr in repo.MergedPullRequests)
                                                    {
                                                        <li>
                                                            @if (repo.WebUrl is { } prBase)
                                                            {
                                                                <a href="@($"{prBase}/pull/{pr.Number}")" target="_blank" rel="noopener noreferrer">#@pr.Number @pr.Title</a>
                                                            }
                                                            else
                                                            {
                                                                <span>#@pr.Number @pr.Title</span>
                                                            }
                                                            <span class="pb-fresh__by">
                                                                @(string.IsNullOrEmpty(pr.AuthorLogin) ? "" : $"by {pr.AuthorLogin}, ")<Timestamp Value="@pr.MergedAt" Relative="true" />
                                                            </span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else if (repo.Commits.Count > 0)
                                            {
                                                <div class="section-label">@(repo.Forced || !repo.CommitsComplete ? "Latest commits" : "New commits")</div>
                                                <ul class="pb-chg__list">
                                                    @foreach (var c in repo.Commits)
                                                    {
                                                        <li>@FirstLine(c.Message) <CommitLink WebUrl="@repo.WebUrl" Sha="@c.Sha" Chip="true" /></li>
                                                    }
                                                </ul>
                                            }

                                            @if (repo.Forced || !repo.CommitsComplete)
                                            {
                                                <p class="pb-note">
                                                    @(repo.Forced
                                                        ? $"The branch was force-pushed, so its history since build #{fresh.LastBuildId} was rewritten."
                                                        : "Only the newest commits are listed.")
                                                    @if (repo.WebUrl is { } compareBase && repo.BuiltSha is { } fromSha && repo.HeadSha is { } toSha)
                                                    {
                                                        <text> </text><a href="@($"{compareBase}/compare/{fromSha}...{toSha}")" target="_blank" rel="noopener noreferrer">See every change on GitHub</a>
                                                    }
                                                </p>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @* ── Latest build ──────────────────────────────────── *@
                    <section class="card">
                        <div class="card__head">
                            <h2 class="card__title">@HeroTitle</h2>
                            @if (_showingOther)
                            {
                                <a class="btn btn--sm btn--ghost" href="@($"/pipelines/{PipelineId}")">Back to the latest build</a>
                            }
                            @* No pill here: the head already carries this build's
                               state beside the page title, and two pills saying
                               the same word is one too many. No commit hash
                               here either - the topline below carries it once,
                               as a chip, alongside branch and BC version. *@
                        </div>
                        <div class="card__body">
                            <div class="pb-topline">
                                @* One commit, one source. This was showing two hashes:
                                   BuildRow.HeadCommitShort in the card head and the build
                                   detail's first repo commit here. They are usually equal
                                   but need not be - HeadCommitShort is the changelog head
                                   when a build has new commits, which on a multi-repo
                                   build can come from a different repository than the
                                   alphabetically-first one. Keep HeadCommitShort: it is
                                   the hash the history table's top row shows for this same
                                   build. The per-repo pinned commits stay in the
                                   Repositories rail. *@
                                @if (_latest!.HeadCommitShort is { Length: > 0 } heroCommit)
                                {
                                    <span class="commit-chip"><Icon Name="git-commit-vertical" Width="11" Height="11" />@heroCommit</span>
                                }
                                <span class="commit-chip"><Icon Name="git-branch" Width="11" Height="11" />@_latest.ShownBranch</span>
                                @if (BcShown(_latest) is { Length: > 0 } builtOn)
                                {
                                    <span class="pb-topline__meta">on BC @builtOn</span>
                                }
                                <span class="pb-topline__meta pb-topline__when" title="@StartedBy(_latest)">@StartedVerb(_latest) <Timestamp Value="@StartedWhen(_latest)" Relative="true" /></span>
                            </div>

                            @* The tooltip on the head's pill is not enough on its own: touch
                               and keyboard users never see it (#994). *@
                            @if (_latest.IsPreview)
                            {
                                <p class="pb-note">
                                    This preview build checks your extensions against the @ProjectBuildTarget.Label(_latest.BcTarget).ToLowerInvariant()
                                    Business Central version@(BcShown(_latest) is { Length: > 0 } previewOn ? $" ({previewOn})" : ""). It can't be deployed;
                                    fix any errors before that version reaches your customers.
                                </p>
                            }

                            @* What the compiler said, as a count rather than as a log to
                               read. Only shown once the build has something to count -
                               a queued build has said nothing yet, and "0 errors" before
                               anything compiled would be a claim, not a fact. *@
                            @if (_latestDetail is { } counted && (counted.ErrorCount > 0 || counted.WarningCount > 0))
                            {
                                <p class="pb-note">
                                    The compiler reported @counted.ErrorCount error@(counted.ErrorCount == 1 ? "" : "s")
                                    and @counted.WarningCount warning@(counted.WarningCount == 1 ? "" : "s"). The build log below has each one.
                                </p>
                            }

                            @* The live-update note is about *this* build, so it asks
                               about this build's status. _inFlight is pipeline-scoped
                               (any queued/building build keeps the poll alive, including
                               one started after this card rendered), which meant a build
                               finished days ago still claimed to be updating itself. It
                               stays the poll's trigger below; it is no longer copy. *@
                            @if (_latest.Status is "queued" or "building")
                            {
                                <p class="pb-note">This updates automatically as the build progresses.</p>
                            }

                            @if (_latest.Status == "failed")
                            {
                                @* When every extension failed, the rows below say why each
                                   one did; the recorded message would only point elsewhere. *@
                                <Alert Tone="AlertTone.Danger"><span>@(_latestDetail is { FailedApps.Count: > 0 }
                                    ? "None of the extensions compiled."
                                    : _latest.FailureMessage ?? "The build failed. See the build log below.")</span></Alert>
                            }

                            @* The extensions that did not build, above the files that did.
                               A build where only some failed still goes ready, so this is
                               the one place a partial build says so. A failure the solution can fix by supplying a
                               dependency gets the way to do it beside it (#901). *@
                            @if (_latestDetail is { FailedApps.Count: > 0 } withFailures)
                            {
                                <div class="section-label">@withFailures.FailedApps.Count extension@(withFailures.FailedApps.Count == 1 ? "" : "s") did not build</div>
                                <div class="sub-rows sub-rows--plain">
                                    @foreach (var f in withFailures.FailedApps)
                                    {
                                        <div class="sub-row">
                                            <div class="sub-row__stack">
                                                <span class="sub-row__name">@(string.IsNullOrEmpty(f.AppName) ? "Unnamed extension" : f.AppName)</span>
                                                <span class="pb-fail__msg">@(string.IsNullOrWhiteSpace(f.Message) ? "No reason was recorded. The build log below has the compiler's output." : f.Message)</span>
                                            </div>
                                            @if (f.NeedsSymbols && _canManage)
                                            {
                                                <div class="sub-row__acts">
                                                    <a class="btn btn--sm" href="@($"/solutions/{_header!.ProjectId}/symbols")">
                                                        <Icon Name="upload" Width="14" Height="14" />
                                                        <span>Upload symbols</span>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (_latest.Status == "failed")
                            {
                                @* The alert above already says so. *@
                            }
                            else if (_latestDetail is { Artifacts.Count: > 0 })
                            {
                                <div class="section-label">@_latestDetail.Artifacts.Count .app file@(_latestDetail.Artifacts.Count == 1 ? "" : "s") · @FormatBytes(_latestDetail.Artifacts.Sum(a => a.SizeBytes))</div>
                                <div class="sub-rows sub-rows--plain">
                                    @foreach (var a in _latestDetail.Artifacts)
                                    {
                                        <div class="sub-row">
                                            <div class="sub-row__stack">
                                                <span class="sub-row__name">@a.FileName</span>
                                                @* Size belongs with the file's other facts, not
                                                   beside the button - in __acts it read as part of
                                                   the Download control. PageAdminEdit.dc.html uses
                                                   __val for metadata columns and keeps __acts to
                                                   buttons only. *@
                                                <span class="sub-row__val">@a.AppName · v@(a.AppVersion)@(a.RuntimeVersion is { } rt ? $" · runtime {rt}" : "") · @FormatBytes(a.SizeBytes)@(a.CarriedFromBuildId is { } from ? $" · unchanged since build #{from}" : "")</span>
                                            </div>
                                            <div class="sub-row__acts">
                                                <a class="btn btn--sm" href="@($"/artifacts/build/{_latest.Id}/app/{a.Id}")" aria-label="@($"Download {a.FileName}")">
                                                    <Icon Name="download" Width="14" Height="14" />
                                                    <span>Download</span>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (_latest.Status is "queued" or "building")
                            {
                                <p class="pb-note">The compiled files will appear here when it finishes.</p>
                            }
                            else
                            {
                                <p class="pb-note">This build produced no downloadable files.</p>
                            }

                            @* Where the customer can get these files themselves. A build
                               that could not be published says why, without ever reading
                               as a failed build - the files above downloaded fine (#632). *@
                            @if (_latest.GitHubReleaseUrl is { Length: > 0 } releaseUrl)
                            {
                                <p class="pb-note">
                                    Published as
                                    <a href="@releaseUrl" target="_blank" rel="noopener noreferrer">@(_latest.GitHubReleaseTag ?? "a GitHub release")</a>.
                                </p>
                            }
                            else if (_latest.GitHubReleaseError is { Length: > 0 } releaseError)
                            {
                                <Alert Tone="AlertTone.Warn">
                                    <span>Not published to GitHub: @(releaseError.TrimEnd('.')). The .app files above are unaffected; fix this and run the pipeline again to publish.</span>
                                </Alert>
                            }

                            @if (_latestDetail is { HasObjects: true, ReleaseId: { } relId })
                            {
                                <div class="pb-explore">
                                    <a class="btn btn--sm" href="@($"/object-explorer/release/{relId}")">
                                        <Icon Name="package" Width="14" Height="14" />
                                        <span>Explore objects</span>
                                    </a>
                                </div>
                            }

                            @if (_latestDetail is { Changelog.Count: > 0 })
                            {
                                <div class="pb-chg">
                                    <div class="section-label">Changes since the last successful build</div>
                                    @foreach (var group in _latestDetail.Changelog)
                                    {
                                        <div class="pb-chg__repo">
                                            <div class="pb-chg__name"><Icon Name="folder-git-2" Width="12" Height="12" />@group.RepoName</div>
                                            <ul class="pb-chg__list">
                                                @foreach (var c in group.Commits)
                                                {
                                                    @if (string.IsNullOrEmpty(c.ShortHash))
                                                    {
                                                        <li class="pb-chg__note">@c.Message</li>
                                                    }
                                                    else
                                                    {
                                                        <li>@c.Message <span class="commit-chip">@c.ShortHash</span></li>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                    @* ── Build history ─────────────────────────────────── *@
                    @* PageDetail.dc.html renders exactly this - a pipeline's run
                       history - as a .data-table--edge, which settles the #528
                       question the archetype prose left ambiguous. State is the
                       4px right keyline plus a leading glyph, never a pill
                       (#527); the commit is a .commit-chip; duration is a
                       __num column and the row's buttons a __actions one.

                       The archetype titles it with a bare .state-label above a
                       bare table, and this page did too until the maintainer
                       saw the finished thing: four sections, three heading
                       treatments, which reads as unconsidered because it is.
                       Divergence 71 - the table keeps the archetype's own
                       markup and gains a card around it (.card--flush, so the
                       card's frame is the only one). *@
                    <section class="card card--flush">
                        <div class="card__head">
                            <h2 class="card__title">Build history</h2>
                            @* The nightly preview check adds two builds a night that
                               nobody deploys, so they stay out of the list until asked for. *@
                            @if (_counts.Preview > 0)
                            {
                                @* A preview build in the hero is listed below it too, so the box
                                   stays ticked while one is shown. *@
                                <label class="check @(_listingPreview ? "is-checked" : "")"
                                       title="@(PreviewForcedByHero ? "The build shown above is a preview build" : null)">
                                    <input type="checkbox" checked="@_listingPreview" disabled="@PreviewForcedByHero"
                                           @onchange="TogglePreviewBuildsAsync" />
                                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                    <span>Show preview builds</span>
                                </label>
                            }
                        </div>
                        <table class="data-table data-table--edge">
                            <thead>
                                <tr>
                                    <th class="data-table__col-state"><span class="u-sr">State</span></th>
                                    <th>Commit</th>
                                    <th>Description</th>
                                    <th>Branch</th>
                                    <th>Started</th>
                                    <th class="data-table__num">Duration</th>
                                    <th class="data-table__num">Apps</th>
                                    <th class="data-table__actions"><span class="u-sr">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (HistoryRows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="u-muted">No builds yet apart from preview builds.</td>
                                    </tr>
                                }
                                @foreach (var b in HistoryRows)
                                {
                                    <tr class="@RowStateIcon.RowClass(b.Status)">
                                        <td class="data-table__col-state"><RowStateIcon State="@b.Status" /></td>
                                        <td>
                                            @if (b.HeadCommitShort is { Length: > 0 } sha)
                                            {
                                                <span class="commit-chip"><Icon Name="git-commit-vertical" Width="11" Height="11" />@sha</span>
                                            }
                                            else
                                            {
                                                <span class="u-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(b.HeadCommitMessage))
                                            {
                                                @b.HeadCommitMessage
                                                @if (b.CommitCount > 1)
                                                {
                                                    <span class="pb-more">+@(b.CommitCount - 1) more</span>
                                                }
                                            }
                                            else if (b.Status == "failed" && !string.IsNullOrEmpty(b.FailureMessage))
                                            {
                                                @b.FailureMessage
                                            }
                                            else
                                            {
                                                <span class="u-muted">No commit details</span>
                                            }
                                            @if (b.IsPreview)
                                            {
                                                <a class="tag pb-preview" href="@($"/pipelines/{PipelineId}?build={b.Id}")"
                                                   title="Show this preview build">@ProjectBuildTarget.Label(b.BcTarget) preview build</a>
                                            }
                                            @if (BcShown(b) is { Length: > 0 } rowBc)
                                            {
                                                <span class="pb-more">on BC @rowBc</span>
                                            }
                                        </td>
                                        <td>@b.ShownBranch</td>
                                        <td><Timestamp Value="@(b.FinishedAt ?? b.StartedAt)" Relative="true" /></td>
                                        <td class="data-table__num">@(Duration(b) is { Length: > 0 } d ? d : "—")</td>
                                        <td class="data-table__num">@(b.ArtifactCount > 0 ? b.ArtifactCount.ToString() : "—")</td>
                                        <td class="data-table__actions">
                                            @if (b.Status == "failed")
                                            {
                                                <a class="btn btn--sm" href="@($"/artifacts/build/{b.Id}/log")">
                                                    <Icon Name="file-text" Width="13" Height="13" />
                                                    <span>Logs</span>
                                                </a>
                                            }
                                            else if (b.ArtifactCount > 0)
                                            {
                                                @if (b.Status == "ready" && _canManage && !b.IsPreview && _deploymentsOn)
                                                {
                                                    <button type="button" class="btn btn--sm" @onclick="() => StartReleaseAsync(b)"
                                                            disabled="@_openingRelease" aria-label="@($"Deploy build #{b.Id}")">
                                                        <Icon Name="send" Width="13" Height="13" />
                                                        <span>Deploy...</span>
                                                    </button>
                                                }
                                                <a class="btn btn--sm" href="@($"/artifacts/build/{b.Id}/all")" aria-label="@($"Download {b.ArtifactCount} apps as a zip")">
                                                    <Icon Name="download" Width="13" Height="13" />
                                                    <span>Download .zip</span>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (_builds.Count < HistoryTotal)
                        {
                            @* The newest builds only (#1138): a pipeline that builds on every
                               push gathers thousands, and the page re-reads them while a build runs. *@
                            <div class="card__body">
                                <button type="button" class="btn btn--sm" @onclick="ShowMoreBuildsAsync" disabled="@_loadingMore">
                                    <span>Show more builds</span>
                                </button>
                                <span class="u-muted">Showing @_builds.Count of @HistoryTotal</span>
                            </div>
                        }
                    </section>

                    @* ── Build log ─────────────────────────────────────── *@
                    @if (_latestDetail is { Logs.Count: > 0 })
                    {
                        @* One commit, one placement - the same call as the Latest build
                           card above: the hash lives in the card body (here, the code
                           block's own file bar) and the head note keeps only what the
                           body does not say. Sourced from BuildRow.HeadCommitShort so all
                           three places naming this build's commit agree. *@
                        var logName = string.Join(" · ", new[] { _latest.HeadCommitShort, LatestSingleRepoName() }
                            .Where(s => !string.IsNullOrEmpty(s)));
                        <section class="card">
                            <div class="card__head">
                                <h2 class="card__title">Build log</h2>
                                <span class="pb-sec__note">@LogStatusWord()</span>
                            </div>
                            <div class="card__body">
                                <div class="code-block">
                                    <div class="code-block__bar">
                                        <span class="code-block__name">@logName</span>
                                        <a class="btn btn--sm btn--ghost" href="@($"/artifacts/build/{_latest.Id}/log")">
                                            <Icon Name="download" Width="13" Height="13" />
                                            <span>Raw log</span>
                                        </a>
                                    </div>
                                    <pre class="pb-log">@RenderLog(_latestDetail)</pre>
                                </div>
                            </div>
                        </section>
                    }

                </div>

                @* The rail. Business Central puts supporting reference and
                   secondary actions in a FactBox beside the card's fields, and
                   before the port this page did the same. PR 15d dissolved that
                   rail into the .meta-row because PageDetail.dc.html has no rail
                   at all - right for the facts, which read better as a strip,
                   but these two are not facts and had nowhere else to go. Left
                   in the main column they sit under the build log, the one
                   section with no upper bound on its height. *@
                @if (HasRail)
                {
                <aside class="detail-body__aside">
                    @if (_latestDetail is { RepoCommits.Count: > 0 } repos)
                    {
                        <section class="card card--flush">
                            <div class="card__head"><h2 class="card__title">Repositories</h2></div>
                            <div class="sub-rows sub-rows--plain">
                                @foreach (var rc in repos.RepoCommits)
                                {
                                    <div class="sub-row">
                                        <div class="sub-row__stack">
                                            <span class="sub-row__name">@rc.RepoName</span>
                                            <span class="sub-row__val">@Short(rc.CommitHash)@(string.IsNullOrEmpty(_latest.Branch) ? "" : $" · {_latest.Branch}")</span>
                                        </div>
                                        <div class="sub-row__acts">
                                            @if (!string.IsNullOrEmpty(rc.RepoUrl))
                                            {
                                                <a class="btn btn--icon btn--sm" href="@rc.RepoUrl" target="_blank" rel="noopener noreferrer"
                                                   aria-label="@($"Open {rc.RepoName} repository")" title="Open on the host">
                                                    <Icon Name="external-link" Width="14" Height="14" />
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (HasCompare)
                    {
                        <section class="card">
                            <div class="card__head"><h2 class="card__title">Compare builds</h2></div>
                            <div class="card__body pb-compare">
                                <p class="pb-note">Diff the objects of two of this pipeline's builds in the Object Explorer.</p>
                                <div class="field">
                                    <label class="field__label" for="pb-cmp-left">First build</label>
                                    <SelectBox>
                                        <select id="pb-cmp-left" class="select select--sm" @bind="_compareLeft">
                                            @foreach (var c in _comparable)
                                            {
                                                <option value="@c.ReleaseId">@BuildLabel(c)</option>
                                            }
                                        </select>
                                    </SelectBox>
                                </div>
                                <div class="field">
                                    <label class="field__label" for="pb-cmp-right">Second build</label>
                                    <SelectBox>
                                        <select id="pb-cmp-right" class="select select--sm" @bind="_compareRight">
                                            @foreach (var c in _comparable)
                                            {
                                                <option value="@c.ReleaseId">@BuildLabel(c)</option>
                                            }
                                        </select>
                                    </SelectBox>
                                </div>
                                <button type="button" class="btn btn--sm" @onclick="CompareAsync" disabled="@(_compareLeft == _compareRight)">
                                    <Icon Name="git-compare" Width="14" Height="14" />
                                    <span>Compare</span>
                                </button>
                            </div>
                        </section>
                    }
                </aside>
                }
            </div>
        }
    </ChildContent>
</DetailPage>

<ReleaseBuildDialog @ref="_releaseDialog" OnReleased="OnReleasedAsync" />

@* Which deployment pipeline a build goes through, when that isn't a given: several take
   this pipeline's builds, or none does yet. One is a given, and skips this. *@
@if (_releaseBuild is { } releasing)
{
    <div class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="pb-rel-title"
         tabindex="-1" @onkeydown="OnChooserKeyDown" @ref="_chooserRoot">
        <div class="modal-backdrop" @onclick="CloseChooser" aria-hidden="true"></div>
        <div class="confirm-dialog" @onclick:stopPropagation>
            <div class="confirm-dialog__head">
                <span class="confirm-dialog__icon" aria-hidden="true">
                    <Icon Name="send" Width="17" Height="17" />
                </span>
                <h2 id="pb-rel-title" class="confirm-dialog__title">Deploy build #@releasing.Id from <Timestamp Value="@(releasing.FinishedAt ?? releasing.StartedAt)" Relative="true" /></h2>
            </div>
            <div class="confirm-dialog__body">
                @if (_releaseTargets.Count == 0)
                {
                    <p>
                        @(_header?.Name ?? "This pipeline") isn't set up to install anywhere yet. A deployment pipeline
                        says which of @(_header?.ProjectName ?? "the solution")'s Business Central environments its
                        builds go to, and how installs run. You only set it up once, then you carry on deploying
                        build #@releasing.Id.
                    </p>
                }
                else
                {
                    <p>@(_header?.Name ?? "This pipeline")'s builds can go to more than one environment. Where should build #@releasing.Id go?</p>
                    <div class="sub-rows sub-rows--plain">
                        @foreach (var target in _releaseTargets)
                        {
                            <div class="sub-row">
                                <div class="sub-row__stack">
                                    <span class="sub-row__name">@target.Name</span>
                                    <span class="sub-row__val">@TargetLine(target)</span>
                                </div>
                                <div class="sub-row__acts">
                                    <button type="button" class="btn btn--sm" @onclick="() => ChooseTargetAsync(target)"
                                            disabled="@_openingRelease" aria-label="@($"Deploy through {target.Name}")">
                                        <span>Deploy here</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="confirm-dialog__actions">
                <button type="button" class="btn" @onclick="CloseChooser">Cancel</button>
                @if (_releaseTargets.Count == 0)
                {
                    <button type="button" class="btn btn--primary" @onclick="SetUpReleasePipeline">
                        <Icon Name="plus" Width="14" Height="14" />
                        <span>Set up a deployment pipeline</span>
                    </button>
                }
            </div>
        </div>
    </div>
}
<ConfirmDialog @ref="_deleteConfirm" Title="Delete pipeline?"
               ConfirmLabel="Delete pipeline" ConfirmButtonClass="btn--danger" ConfirmIcon="trash-2" />

@code {
    [Parameter] public int PipelineId { get; set; }

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    /// <summary>
    /// Whether the deployments tool is on for this person. "Deploy..." leads into it,
    /// so it is not offered when that tool is switched off (its pages answer 404).
    /// </summary>
    private bool _deploymentsOn = true;

    /// <summary>
    /// A build to show in place of the latest one, which is how a preview check's
    /// result links to its errors (#994). Ignored when it is not one of this
    /// pipeline's builds.
    /// </summary>
    [SupplyParameterFromQuery(Name = "build")] public int? BuildId { get; set; }
    private int? _loadedBuildId;
    private int _loadedPipelineId;

    private bool _loading = true;
    private bool _notFound;
    private bool _inFlight;

    /// <summary>A build that blocks the next one is running; narrower than <see cref="_inFlight"/>, which also counts preview checks.</summary>
    private bool _buildRunning;
    private bool _canManage;
    private bool _canDelete;
    private bool _switching;
    private bool _starting;
    private string? _buildError;

    private ConfirmDialog? _deleteConfirm;

    // "Deploy..." on a build row (#938).
    private ReleaseBuildDialog? _releaseDialog;
    private ElementReference _chooserRoot;
    private bool _focusChooser;
    private bool _openingRelease;
    /// <summary>The build whose deployment target is being chosen; the chooser is open while set.</summary>
    private BuildRow? _releaseBuild;
    private List<ReleasePipelineRow> _releaseTargets = new();
    /// <summary>The deployment pipeline the open deployment dialog sends through, for the note after it.</summary>
    private (int Id, string EnvironmentName, int BuildId)? _releasingThrough;
    private ReleaseNote? _releaseNote;

    /// <summary>What the page says after a deployment was set off from here, or couldn't be.</summary>
    private sealed record ReleaseNote(bool Sent, string Text, int ReleasePipelineId, string LinkText);

    private PipelineHeader? _header;

    /// <summary>The newest builds Build history lists, at most <see cref="_historyLimit"/> of them.</summary>
    private List<BuildRow> _builds = new();

    /// <summary>How many builds the pipeline has in all, and how many are preview check builds.</summary>
    private BuildCounts _counts = new(0, 0);

    /// <summary>How many builds Build history lists; Show more raises it.</summary>
    private int _historyLimit = HistoryPageSize;
    private const int HistoryPageSize = 25;
    private bool _loadingMore;

    /// <summary>Whether the person asked Build history to list the nightly preview check's builds. Off by default.</summary>
    private bool _showPreviewBuilds;

    /// <summary>Whether the history read lists them: when asked, or when the hero shows one.</summary>
    private bool _listingPreview;
    private bool PreviewForcedByHero => _listingPreview && !_showPreviewBuilds;

    /// <summary>
    /// Bumped by every load the person sets off. A poll tick that started before one
    /// read the page's settings as they were then, so its answer is dropped.
    /// </summary>
    private int _loadGeneration;

    /// <summary>The rows Build history lists: the builds read, already without preview builds unless asked for.</summary>
    private List<BuildRow> HistoryRows => _builds;

    /// <summary>How many builds Build history would list with no limit.</summary>
    private int HistoryTotal => _listingPreview ? _counts.Total : _counts.Total - _counts.Preview;
    private BuildRow? _latest;
    private BuildDetail? _latestDetail;
    private List<ComparableBuildRow> _comparable = new();

    /// <summary>Whether the watched branch moved past the last successful build (#964), per repository.</summary>
    private PipelineFreshness? _freshness;
    private PipelineFreshnessSummary? _freshSummary;

    /// <summary>
    /// Whether anything belongs in the detail rail. Both are per-record, not
    /// per-page: a pipeline whose only build failed before it recorded a commit
    /// has neither repositories nor a second build to compare, and then the
    /// 280px column must not be reserved at all (`.detail-body--wide`).
    /// </summary>
    private bool HasRepos => _latestDetail is { RepoCommits.Count: > 0 };
    private bool HasCompare => _comparable.Count >= 2;
    private bool HasRail => HasRepos || HasCompare;
    private int _compareLeft;
    private int _compareRight;

    private PeriodicTimer? _poll;
    private CancellationTokenSource? _pollCts;
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2.5);

    protected override async Task OnInitializedAsync()
    {
        await Zone.EnsureLoadedAsync();
        var user = AuthState is null ? null : (await AuthState).User;
        _deploymentsOn = ToolAvailability.IsSiteEnabled(ALDevToolbox.Domain.Tools.ToolKey.Releases)
            && !ALDevToolbox.Endpoints.EndpointHelpers.ReadDisabledTools(user).Contains(ALDevToolbox.Domain.Tools.ToolKey.Releases);
        _loadedBuildId = BuildId;
        _loadedPipelineId = PipelineId;
        await LoadAsync();
        _loading = false;
        if (_inFlight) StartPoll();
    }

    /// <summary>A link to another build, or another pipeline, lands here rather than in a fresh page.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_loading || (BuildId == _loadedBuildId && PipelineId == _loadedPipelineId)) return;
        if (PipelineId != _loadedPipelineId)
        {
            // Another pipeline starts from the defaults, not this one's settings.
            _historyLimit = HistoryPageSize;
            _showPreviewBuilds = false;
        }
        _loadedBuildId = BuildId;
        _loadedPipelineId = PipelineId;
        await LoadAsync();
        if (_inFlight) StartPoll();
    }

    private async Task TogglePreviewBuildsAsync(ChangeEventArgs e)
    {
        _showPreviewBuilds = e.Value is true;
        await LoadAsync();
    }

    private async Task ShowMoreBuildsAsync()
    {
        _loadingMore = true;
        try
        {
            _historyLimit += HistoryPageSize;
            await LoadAsync();
        }
        finally
        {
            _loadingMore = false;
        }
    }

    /// <summary>True when the hero shows something other than the latest build.</summary>
    private bool _showingOther;

    private string HeroTitle => _latest is null || !_showingOther
        ? "Latest build"
        : _latest.IsPreview ? $"{ProjectBuildTarget.Label(_latest.BcTarget)} preview build #{_latest.Id}" : $"Build #{_latest.Id}";

    private bool _takingOver;

    /// <summary>Resumes a paused preview check or paused building on push, running it as the person who pressed the button from now on.</summary>
    private async Task TakeOverAsync(PipelineAutomation automation)
    {
        if (_takingOver) return;
        _takingOver = true;
        try
        {
            if (automation == PipelineAutomation.PreviewCheck)
            {
                await Pipelines.TakeOverPreviewCheckAsync(PipelineId);
            }
            else
            {
                await Pipelines.TakeOverBuildOnPushAsync(PipelineId);
            }
            await LoadAsync();
        }
        catch (PlanValidationException ex)
        {
            _buildError = ex.Errors.Values.FirstOrDefault();
        }
        finally
        {
            _takingOver = false;
        }
    }

    /// <summary>Everything one page load reads, so a background poll can gather it
    /// off the circuit and hand it back in a single assignment.</summary>
    private sealed record PageState(
        PipelineHeader? Header,
        bool NotFound,
        bool CanManage,
        List<BuildRow> Builds,
        BuildRow? Latest,
        bool ShowingOther,
        BuildCounts Counts,
        bool ShowPreview,
        BuildDetail? LatestDetail,
        List<ComparableBuildRow> Comparable,
        bool InFlight,
        PipelineFreshness? Freshness = null,
        bool BuildRunning = false,
        bool CanDelete = false);

    /// <summary>The user-driven load: reads through the circuit's own services.</summary>
    private async Task LoadAsync()
    {
        _loadGeneration++;
        Apply(await FetchAsync(Artifacts, Pipelines, Freshness, CancellationToken.None));
    }

    /// <summary>
    /// Reads the page's data through whichever <paramref name="artifacts"/> /
    /// <paramref name="pipelines"/> pair the caller owns. The poll loop passes a
    /// pair resolved from its own DI scope so its queries never share the
    /// circuit's <c>DbContext</c> with a click the user makes mid-poll.
    /// </summary>
    private async Task<PageState> FetchAsync(
        ArtifactService artifacts, PipelineService pipelines, BuildFreshnessService freshness, CancellationToken ct)
    {
        try
        {
            var header = await artifacts.GetPipelineHeaderAsync(PipelineId, ct);
            if (header is null)
                return NotFoundState;

            var canManage = await pipelines.CanManageAsync(PipelineId, ct);
            var canDelete = canManage && await pipelines.CanDeleteAsync(ct);
            var counts = await artifacts.CountBuildsAsync(PipelineId, ct);
            // The build asked for may be older than the history lists; it is read on its own.
            var requested = BuildId is { } id ? await artifacts.GetPipelineBuildRowAsync(PipelineId, id, ct) : null;
            // A preview build in the hero is listed below it too.
            var showPreview = _showPreviewBuilds || requested is { IsPreview: true };
            var builds = await artifacts.ListBuildsAsync(PipelineId, _historyLimit, showPreview, ct);
            // The hero shows the build asked for, else the newest of the pipeline's own. The
            // nightly preview check's builds are left out of "latest", so a red check never
            // reads as the pipeline being broken - unless they are all there is.
            // The history is only the newest few, which may all be preview builds.
            var newest = builds.FirstOrDefault(b => !b.IsPreview)
                ?? (counts.Total > counts.Preview ? (await artifacts.ListBuildsAsync(PipelineId, 1, false, ct)).FirstOrDefault() : null)
                ?? builds.FirstOrDefault()
                ?? (counts.Total > 0 ? (await artifacts.ListBuildsAsync(PipelineId, 1, true, ct)).FirstOrDefault() : null);
            var latest = requested ?? newest;
            var showingOther = latest is not null && latest.Id != newest?.Id;
            var latestDetail = latest is null ? null : await artifacts.GetBuildDetailAsync(latest.Id, ct);
            var comparable = await artifacts.ListComparableBuildsAsync(PipelineId, ct);
            var inFlight = await artifacts.HasBuildInFlightAsync(PipelineId, ct);
            var running = inFlight && await artifacts.IsBuildRunningAsync(PipelineId, ct);
            var fresh = await freshness.GetAsync(PipelineId, ct);
            return new PageState(header, false, canManage, builds, latest, showingOther, counts, showPreview,
                latestDetail, comparable, inFlight, fresh, running, canDelete);
        }
        catch (ProjectAccessDeniedException)
        {
            // The pipeline belongs to a private solution this person isn't on the
            // team for. Same answer as a pipeline that isn't there.
            return NotFoundState;
        }
    }

    private static readonly PageState NotFoundState =
        new(null, NotFound: true, false, new(), null, false, new(0, 0), false, null, new(), false);

    private void Apply(PageState s)
    {
        if (s.NotFound) { _notFound = true; return; }
        _header = s.Header;
        _canManage = s.CanManage;
        _canDelete = s.CanDelete;
        _builds = s.Builds;
        _counts = s.Counts;
        _listingPreview = s.ShowPreview;
        _latest = s.Latest;
        _showingOther = s.ShowingOther;
        _latestDetail = s.LatestDetail;
        _comparable = s.Comparable;
        // Preselect the pipeline's own two newest builds; the nightly preview check's
        // builds stay in the lists, labelled, but are not the default comparison.
        var defaults = _comparable.Where(c => !ProjectBuildTarget.IsPreview(c.BcTarget)).ToList();
        if (defaults.Count < 2) defaults = _comparable;
        if (defaults.Count >= 2)
        {
            _compareLeft = defaults[0].ReleaseId;
            _compareRight = defaults[1].ReleaseId;
        }
        _inFlight = s.InFlight;
        _buildRunning = s.BuildRunning;
        _freshness = s.Freshness;
        _freshSummary = s.Freshness is { } f ? PipelineFreshnessSummary.From(f) : null;
    }

    private void CompareAsync()
    {
        if (_compareLeft == _compareRight) return;
        Nav.NavigateTo($"/object-explorer/release/{_compareLeft}?scope=Compare&right={_compareRight}");
    }

    /// <summary>
    /// Runs the pipeline: queues a build of its saved extension selection. Owner/admin
    /// only (re-checked in <see cref="ProjectBuildImporter.StartBuildAsync"/>). The
    /// build lands queued; LoadAsync picks it up and the status poll drives
    /// Building -> Ready live. See .design/artifacts.md.
    /// </summary>
    private async Task RunBuildAsync()
    {
        if (_starting || _buildRunning) return;
        _starting = true;
        _buildError = null;
        try
        {
            await Builds.StartBuildAsync(PipelineId);
            await LoadAsync();
            if (_inFlight) StartPoll();
        }
        catch (PlanValidationException ex)
        {
            _buildError = ex.Errors.Values.FirstOrDefault() ?? "Could not start the build.";
        }
        catch (ProjectAccessDeniedException)
        {
            _buildError = "Only people who manage the solution can build this solution.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to start build for pipeline {PipelineId}.", PipelineId);
            _buildError = "Could not start the build.";
        }
        finally
        {
            _starting = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusChooser && _releaseBuild is not null)
        {
            _focusChooser = false;
            try { await _chooserRoot.FocusAsync(); }
            catch { /* detached */ }
        }
    }

    /// <summary>
    /// "Deploy..." on a successful build's row: finds the deployment pipelines that take
    /// this build pipeline's builds and goes straight to the deployment dialog when there
    /// is exactly one; otherwise the chooser asks which, or offers to set one up.
    /// A deployment pipeline that draws from GitHub releases is not a target for a build.
    /// </summary>
    private async Task StartReleaseAsync(BuildRow build)
    {
        if (_openingRelease || _header is null) return;
        _openingRelease = true;
        _buildError = null;
        _releaseNote = null;
        try
        {
            var targets = (await Releases.ListReleasePipelinesAsync(_header.ProjectId))
                .Where(r => r.BuildPipelineId == PipelineId && r.ArtifactSource == ReleaseArtifactSource.Build && !r.Disabled)
                .ToList();
            if (targets.Count == 1)
            {
                await OpenReleaseDialogAsync(targets[0].Id, build.Id);
                return;
            }
            _releaseTargets = targets;
            _releaseBuild = build;
            _focusChooser = true;
        }
        catch (ProjectAccessDeniedException)
        {
            _buildError = "Only people who manage the solution can deploy this solution's builds.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Reading deployment pipelines failed for build pipeline {PipelineId}.", PipelineId);
            _buildError = "Couldn't read this solution's deployment pipelines. Try again in a moment.";
        }
        finally
        {
            _openingRelease = false;
        }
    }

    private async Task ChooseTargetAsync(ReleasePipelineRow target)
    {
        if (_releaseBuild is not { } build || _openingRelease) return;
        _openingRelease = true;
        try
        {
            _releaseBuild = null;
            await OpenReleaseDialogAsync(target.Id, build.Id);
        }
        finally
        {
            _openingRelease = false;
        }
    }

    private void CloseChooser() => _releaseBuild = null;

    private void OnChooserKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc") CloseChooser();
    }

    /// <summary>
    /// No deployment pipeline takes these builds yet: open the create page with this build
    /// pipeline as its source. Saving it carries on to deploying this build.
    /// </summary>
    private void SetUpReleasePipeline()
    {
        if (_releaseBuild is not { } build || _header is null) return;
        _releaseBuild = null;
        var back = Uri.EscapeDataString($"/pipelines/{PipelineId}");
        Nav.NavigateTo($"/pipelines/deployments/new?solution={_header.ProjectId}&buildPipeline={PipelineId}&deploy={build.Id}&returnUrl={back}");
    }

    /// <summary>
    /// Opens the deployment dialog for one deployment pipeline with <paramref name="buildId"/>
    /// selected, fed exactly as the deployment pipeline's own page feeds it: the target
    /// environment and its update window, the solution's timezone, when the Business
    /// Central secret lapses, and this pipeline's successful builds with their apps.
    /// </summary>
    private async Task OpenReleaseDialogAsync(int releasePipelineId, int buildId)
    {
        if (_releaseDialog is null) return;
        try
        {
            var rp = await Releases.GetReleasePipelineAsync(releasePipelineId);
            if (rp?.ProjectEnvironment is null)
            {
                _buildError = "That deployment pipeline no longer exists. Try again.";
                return;
            }
            if (rp.ArtifactSource != ReleaseArtifactSource.Build || rp.BuildPipelineId != PipelineId)
            {
                // Saved from the editor with a different source than this pipeline:
                // this build is not what it deploys.
                _releaseNote = new ReleaseNote(false,
                    $"{rp.Name} takes its apps from somewhere other than this pipeline, so build #{buildId} can't go through it.",
                    rp.Id, $"Open {rp.Name}");
                return;
            }

            // The secret in use may be the organisation's rather than the solution's
            // own, so the expiry warning asks the connection.
            DateTime? secretExpiresAt = null;
            try
            {
                secretExpiresAt = (await Connection.GetConnectionAsync(rp.ProjectId))?.EffectiveSecretExpiresAt;
            }
            catch (ProjectAccessDeniedException)
            {
                secretExpiresAt = null;
            }

            var env = rp.ProjectEnvironment;
            // The newest successful builds, plus the one Deploy was pressed on when it is older.
            var deployable = await Artifacts.ListDeployableBuildsAsync(PipelineId);
            if (deployable.All(b => b.Id != buildId) && _builds.Concat(_latest is null ? [] : [_latest]).FirstOrDefault(b => b.Id == buildId) is { } pressed)
            {
                deployable.Add(pressed);
            }
            var apps = await Artifacts.ListBuildAppsAsync(PipelineId, deployable.Select(b => b.Id).ToList());
            var options = ReleaseBuildDialog.OptionsFrom(deployable, apps, Zone);
            _releasingThrough = (rp.Id, env.Name, buildId);
            await _releaseDialog.OpenAsync(
                rp.Id, rp.Project?.Name ?? _header?.ProjectName ?? "", env.Name, env.Type,
                rp.DeploymentSchedule, rp.SchemaSyncMode, options,
                rp.Project?.BcTimeZone, env.UpdateWindowStart, env.UpdateWindowEnd,
                secretExpiresAt,
                selectedBuildId: buildId);
        }
        catch (ProjectAccessDeniedException)
        {
            _buildError = "Only people who manage the solution can deploy this solution's builds.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Opening the deploy dialog failed for deployment pipeline {ReleasePipelineId}.", releasePipelineId);
            _buildError = "Couldn't open the deployment. Try again in a moment.";
        }
    }

    private Task OnReleasedAsync(int _)
    {
        if (_releasingThrough is { } through)
        {
            // "Lined up" covers both a deployment now and one scheduled for later: the
            // dialog doesn't say which, and the deployment pipeline's page has the time.
            _releaseNote = new ReleaseNote(true,
                $"Build #{through.BuildId} is lined up to install into {through.EnvironmentName}.",
                through.Id, "Follow its progress");
        }
        return Task.CompletedTask;
    }

    /// <summary>A deployment target's environment as the chooser shows it, with anything that would stop a deployment.</summary>
    private static string TargetLine(ReleasePipelineRow target)
    {
        var env = target.EnvironmentName.Equals(target.EnvironmentType, StringComparison.OrdinalIgnoreCase)
            ? target.EnvironmentName
            : $"{target.EnvironmentName} ({target.EnvironmentType})";
        return target.EnvironmentProblem is { } problem
            ? $"Installs into {env} — that environment is {problem}"
            : $"Installs into {env}";
    }

    private async Task SetDisabledAsync(bool disabled)
    {
        if (_switching) return;
        if (disabled)
        {
            if (_deleteConfirm is null) return;
            var confirmed = await _deleteConfirm.OpenAsync(
                "Disable pipeline?",
                $"Disable \"{_header?.Name}\"? Nothing builds it until someone enables it again: not new commits, not the nightly preview check, not the Build button. "
                + "A build that's already running finishes. Its settings and builds are kept. "
                + "Deployment pipelines that install from it get no new builds, but can still deploy the builds it already made.",
                "Disable pipeline", "btn--primary", "circle-pause");
            if (!confirmed) return;
        }
        _switching = true;
        _buildError = null;
        try
        {
            await Pipelines.SetPipelineDisabledAsync(PipelineId, disabled);
            await LoadAsync();
        }
        catch (PlanValidationException ex)
        {
            _buildError = ex.Errors.Values.FirstOrDefault();
        }
        catch (ProjectAccessDeniedException ex)
        {
            _buildError = ex.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to {Action} pipeline {PipelineId}.", disabled ? "disable" : "enable", PipelineId);
            _buildError = disabled ? "Could not disable the pipeline." : "Could not enable the pipeline.";
        }
        finally
        {
            _switching = false;
        }
    }

    private async Task DeletePipelineAsync()
    {
        if (_deleteConfirm is null) return;
        var confirmed = await _deleteConfirm.OpenAsync(
            "Delete pipeline?",
            $"Delete \"{_header?.Name}\"? It stops building, and its builds no longer show in Pipelines. To stop it for now and keep it, disable it instead.",
            "Delete pipeline", "btn--danger", "trash-2");
        if (!confirmed) return;
        try
        {
            await Pipelines.SoftDeletePipelineAsync(PipelineId);
            Nav.NavigateTo("/pipelines/builds");
        }
        catch (PlanValidationException ex)
        {
            _buildError = ex.Errors.Values.FirstOrDefault() ?? "Could not delete the pipeline.";
        }
        catch (ProjectAccessDeniedException ex)
        {
            _buildError = ex.Message;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to delete pipeline {PipelineId}.", PipelineId);
            _buildError = "Could not delete the pipeline.";
        }
    }

    private void StartPoll()
    {
        if (_poll is not null) return;
        _pollCts = new CancellationTokenSource();
        _poll = new PeriodicTimer(PollInterval);
        _ = PollLoopAsync(_poll, _pollCts.Token);
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                // Own DI scope per tick: this runs on a thread-pool continuation, not
                // the circuit's dispatcher, so sharing the circuit's DbContext would let
                // a tick and a click have two commands in flight on one context. See #679.
                PageState state;
                var generation = _loadGeneration;
                await using (var scope = ScopeFactory.CreateAsyncScope())
                {
                    state = await FetchAsync(
                        scope.ServiceProvider.GetRequiredService<ArtifactService>(),
                        scope.ServiceProvider.GetRequiredService<PipelineService>(),
                        scope.ServiceProvider.GetRequiredService<BuildFreshnessService>(),
                        token);
                }

                // Disposal can happen while we were parked on the queries; touching the
                // renderer after that logs an error for what is a normal navigate-away.
                if (token.IsCancellationRequested) break;
                await InvokeAsync(() =>
                {
                    // A load the person set off meanwhile has newer settings and data.
                    if (generation != _loadGeneration) return;
                    Apply(state);
                    StateHasChanged();
                });
                if (!_inFlight) break;
            }
        }
        catch (OperationCanceledException) { /* circuit tearing down */ }
        catch (ObjectDisposedException) when (token.IsCancellationRequested) { /* torn down mid-poll */ }
        catch (Exception ex)
        {
            Log.LogError(ex, "Build-status poll failed for pipeline {PipelineId}.", PipelineId);
            // Don't leave Build stuck on "Build running" until a reload; a click on a
            // build that is in fact still running is refused by StartBuildAsync.
            try { await InvokeAsync(() => { _buildRunning = false; StateHasChanged(); }); }
            catch (ObjectDisposedException) { /* torn down */ }
        }
        finally
        {
            StopPoll();
        }
    }

    /// <summary>
    /// Idempotent, single-shot teardown: disposal (renderer thread) and the poll loop's
    /// finally (thread pool) both call this, so the fields are claimed atomically to avoid
    /// a double Dispose / Cancel-on-disposed race.
    /// </summary>
    private void StopPoll()
    {
        var cts = Interlocked.Exchange(ref _pollCts, null);
        var timer = Interlocked.Exchange(ref _poll, null);
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
    }

    /// <summary>
    /// The Business Central version a build compiled against, as exact as it was
    /// recorded: the full build number where there is one ("29.0.52914.0"), else the
    /// Major.Minor older builds carry.
    /// </summary>
    private static string? BcShown(BuildRow b) =>
        b.BcArtifactVersion is { Length: > 0 } exact ? exact : b.BcVersion;

    /// <summary>
    /// The hero's verb before its relative build time ("Built 2 days ago"). The time
    /// itself is a Timestamp, whose hover title is the exact instant; who started the
    /// build is the hover title around it.
    /// </summary>

    private static string StartedVerb(BuildRow b) => b.Status switch
    {
        "ready" => "Built",
        "failed" => "Failed",
        "queued" => "Queued",
        _ => "Started",
    };

    /// <summary>When a finished build finished; for one still running, when it started.</summary>
    private static DateTime StartedWhen(BuildRow b) =>
        b.Status is "ready" or "failed" ? b.FinishedAt ?? b.StartedAt : b.StartedAt;

    private static string? StartedBy(BuildRow b) => b.StartedByName is { } n
        ? b.FromPush ? $"Started by a push, built with {n}'s access" : $"Started by {n}"
        : b.FromPush ? "Started by a push" : null;

    /// <summary>
    /// How long a build took, for the run row's duration cell. A build still in
    /// flight has no duration yet - the row shows its live progress bar instead,
    /// so an elapsed counter here would be a second, staler clock. Time spent
    /// waiting for a free worker is not counted (#1137); older builds did not
    /// record it apart, so theirs includes it.
    /// </summary>
    private static string Duration(BuildRow b)
    {
        if (b.FinishedAt is not { } done)
        {
            return "";
        }

        var span = done - (b.BuildingStartedAt ?? b.StartedAt);
        return span.TotalMinutes < 1
            ? $"{span.TotalSeconds:0}s"
            : $"{(int)span.TotalMinutes}m {span.Seconds:00}s";
    }

    /// <summary>A build in the compare picker. An option holds text only, so the time goes through the display zone here rather than through a Timestamp.</summary>
    private string BuildLabel(ComparableBuildRow c) =>
        $"{Zone.Format(c.StartedAt, "yyyy-MM-dd HH:mm")}{(string.IsNullOrEmpty(c.BcVersion) ? "" : $" · BC {c.BcVersion}")}"
        + (ProjectBuildTarget.IsPreview(c.BcTarget) ? $" · {ProjectBuildTarget.Label(c.BcTarget)} preview" : "");

    private static string Short(string hash) => hash.Length > 7 ? hash[..7] : hash;

    /// <summary>A commit message's subject line: the body is one click away on GitHub.</summary>
    private static string FirstLine(string message) => message.Split('\n', 2)[0].Trim();

    /// <summary>
    /// The captured log as colourised lines for the terminal view. Each line is
    /// HTML-encoded, then wrapped in a span whose class drives the colour
    /// (<c>l-err</c>/<c>l-warn</c>/<c>l-ok</c>/<c>l-dim</c>); ordinary output gets no
    /// class and inherits the box colour. The classification is a cheap heuristic on
    /// the compiler's own line prefixes — cosmetic emphasis, not a parser. The
    /// "Raw log" download stays the source of truth.
    /// </summary>
    private static MarkupString RenderLog(BuildDetail d)
    {
        var spans = new List<string>();
        foreach (var section in d.Logs)
        {
            spans.Add($"<span class=\"l-dim\">=== {System.Net.WebUtility.HtmlEncode(section.Section)} ===</span>");
            var lines = section.Content.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
            foreach (var line in lines)
            {
                var cls = ClassifyLogLine(line);
                var text = System.Net.WebUtility.HtmlEncode(line);
                spans.Add(cls is null ? $"<span>{text}</span>" : $"<span class=\"l-{cls}\">{text}</span>");
            }
        }
        return new MarkupString(string.Join("\n", spans));
    }

    /// <summary>Heuristic colour bucket for one log line, or null for ordinary output.</summary>
    private static string? ClassifyLogLine(string line)
    {
        var t = line.TrimStart();
        if (t.Length == 0) return null;
        const StringComparison ci = StringComparison.OrdinalIgnoreCase;
        if (t.StartsWith('✗') || t.Contains("error AL", ci) || t.Contains(": error", ci)
            || t.Contains("error:", ci) || t.Contains("FAILED", StringComparison.Ordinal)
            || t.Contains("Build failed", ci))
            return "err";
        if (t.StartsWith('⚠') || t.Contains("warning AL", ci) || t.Contains(": warning", ci)
            || t.Contains("warning:", ci))
            return "warn";
        if (t.StartsWith('✓') || t.Contains("compiled", ci) || t.Contains("succeeded", ci)
            || t.Contains("Created package", ci))
            return "ok";
        if (t.StartsWith('$') || t.StartsWith("===", ci) || t.StartsWith("Restoring", ci)
            || t.StartsWith("Provisioning", ci) || t.StartsWith('['))
            return "dim";
        return null;
    }

    /// <summary>The repo name when the latest build has exactly one, for the log terminal header.</summary>
    private string? LatestSingleRepoName()
        => _latestDetail is { RepoCommits.Count: 1 } d ? d.RepoCommits[0].RepoName : null;

    private string LogStatusWord() => _latest!.Status switch
    {
        "ready" => "ready",
        "failed" => "failed",
        "building" => "building",
        "queued" => "queued",
        _ => _latest.Status,
    };

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };

    /// <summary>Two-letter avatar initials from an owner's display name.</summary>
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0) return "?";
        var first = char.ToUpperInvariant(parts[0][0]);
        return parts.Length > 1 ? $"{first}{char.ToUpperInvariant(parts[^1][0])}" : first.ToString();
    }

    public ValueTask DisposeAsync()
    {
        StopPoll();
        return ValueTask.CompletedTask;
    }
