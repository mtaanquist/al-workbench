@page "/pipelines/deployments/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.ReleasePipelineService Releases
@inject ALDevToolbox.Services.ObjectExplorer.Delivery.DeliveryService Deliveries
@inject ALDevToolbox.Services.ObjectExplorer.Bc.ProjectConnectionService Connection
@inject ALDevToolbox.Services.ObjectExplorer.Projects.ArtifactService Artifacts
@inject ALDevToolbox.Services.GitHub.GitHubReleaseService GitHubReleases
@inject ALDevToolbox.Services.ObjectExplorer.Bc.BcPanelCache PanelCache
@inject NavigationManager Nav
@inject ILogger<ReleasePipelineDetail> Log
@inject IServiceScopeFactory ScopeFactory
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone
@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.Extensions.DependencyInjection
@using ALDevToolbox.Services.ObjectExplorer.Bc
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Domain.Entities.ObjectExplorer
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Domain.ValueObjects.ObjectExplorer

@*
    One deployment pipeline (.design/handoff/PageReleasePipeline.dc.html and
    ReleasePipelineBody.dc.html, issue #929): a summary card that answers "is this
    healthy", then the deployments, each opening into its failure, its steps, its apps and
    its log. Data stored by AL Workbench and data mirrored from Business Central sit in
    separate, labelled blocks, and nothing here calls Business Central to render.

    Named user: an ops engineer who was just told "the deployment to CRONUS's test
    environment failed" and needs what, when, how long and why without leaving the page.

    Where the sheet draws something the product does not record, the cell is hidden
    rather than filled in: old deployments have no per-app timings, no previous version and
    no "uploaded" moment (#929 started recording them), and their skipped apps fall back
    to "skipped after X failed". A failed deployment can be deployed again (#931), with Force
    sync for that one deployment. A deployment the pipeline prepared from a new build (#934)
    sits in the "Waiting for approval" band at the top of the list, not among the rows:
    it has not happened, and nothing has been sent.
*@

<PageTitle>@(_rp?.Name ?? "Deployment pipeline") · AL Workbench</PageTitle>

<DetailPage IsLoading="@(_loading)"
            LoadingText="Loading deployment pipeline..."
            IsNotFound="@(_rp is null)"
            Title="@(_rp?.Name)"
            ShowMeta="false"
            PageClass="rp-page">
    <NotFound>
        <EmptyState Icon="send" Title="This deployment pipeline doesn't exist" Heading="true">
            <Text>It may have been deleted. Head back to the list to pick another.</Text>
            <Action>
                <a class="btn btn--primary" href="/pipelines/deployments"><Icon Name="arrow-left" Width="16" Height="16" /><span>All deployment pipelines</span></a>
            </Action>
        </EmptyState>
    </NotFound>
    <Crumbs>
        <a href="/pipelines/deployments">Deployment pipelines</a>
        <Icon Name="chevron-right" Width="12" Height="12" />
        <span>@_rp!.Name</span>
    </Crumbs>
    <TitleRow>
        <StatusPill Tone="@(_isProduction ? "danger" : "muted")" title="Environment type">
            <span>@EnvType</span>
        </StatusPill>
    </TitleRow>
    <SubtitleContent>
        In <a href="@($"/solutions/{_rp!.ProjectId}")">@(_rp.Project?.Name ?? "its solution")</a>.
        @if (_fromReleases)
        {
            <text>Installs from the GitHub releases of </text>
            <a href="@SourceHref" target="_blank" rel="noopener">"@SourceName"</a>
        }
        else
        {
            <text>Installs from build pipeline </text>
            @if (SourceDeleted)
            {
                <text>"@SourceName" (deleted)</text>
            }
            else
            {
                <a href="@SourceHref">"@SourceName"</a>
            }
        }
        <text> into the @EnvType environment </text><a href="@EnvHref">"@EnvName"</a>.
    </SubtitleContent>
    <Actions>
        <a class="btn" href="/pipelines/deployments"><Icon Name="arrow-left" Width="15" Height="15" /><span>All deployment pipelines</span></a>
        @if (_canManage)
        {
            <a class="btn" href="@($"/pipelines/deployments/{Id}/edit")">
                <Icon Name="pencil" Width="15" Height="15" /><span>Edit</span>
            </a>
            @* The one primary. When there is nothing to list it moves into the empty
               state, and the head keeps an outline copy so the action never vanishes. *@
            <button type="button" class="btn@(IsEmpty ? "" : " btn--primary")" @onclick="OpenReleaseAsync" disabled="@(!HasSomethingToRelease)"
                    title="@(HasSomethingToRelease ? null : NothingToReleaseReason)">
                <Icon Name="send" Width="15" Height="15" /><span>Deploy</span>
            </button>
        }
    </Actions>
    <ChildContent>
        @if (_rescheduleNotice is { } rescheduleNotice)
        {
            <Alert Tone="AlertTone.Info" Role="status"><span>@rescheduleNotice</span></Alert>
        }
        @if (SourceDeleted)
        {
            @* Deleting a build pipeline in use is refused (#1123); this is for the ones
               deleted before that. Its old builds can still be deployed from here. *@
            <Alert Tone="AlertTone.Danger">
                <span>
                    Its build pipeline <b>@SourceName</b> was deleted, so no new builds will reach this deployment pipeline.
                    @if (_canManage)
                    {
                        <a href="@($"/pipelines/deployments/{Id}/edit")">Point it at another build pipeline</a><text>, or delete it.</text>
                    }
                </span>
            </Alert>
        }
        @if (_rp!.ProjectEnvironment!.MissingSince is not null)
        {
            <Alert Tone="AlertTone.Danger">
                <span>
                    This deployment pipeline's target environment is no longer present in Business Central. Refresh the
                    environments on <a href="@($"/solutions/{_rp!.ProjectId}/bc")">the solution's Business Central tab</a> before deploying.
                </span>
            </Alert>
        }
        else if (BcEnvironmentStatus.Classify(_rp.ProjectEnvironment.Status) is BcEnvironmentReadiness.Deleting or BcEnvironmentReadiness.Failed)
        {
            @* Not Busy: an environment that is mid-update takes deployments again on its
               own. One that is being removed or has failed never will, so the pipeline
               says it is broken now rather than when the next deployment is refused. *@
            <Alert Tone="AlertTone.Danger">
                <span>
                    @BcEnvironmentStatus.RefusalMessage(_rp.ProjectEnvironment.Name, _rp.ProjectEnvironment.Status)
                    Deployments through this pipeline are refused until it points at a different environment.
                </span>
            </Alert>
        }
        else if (_canManage && _releasesError is { } gre)
        {
            <Alert Tone="AlertTone.Danger"><span>@gre</span></Alert>
        }
        else if (_canManage && !HasSomethingToRelease && !SourceDeleted)
        {
            <Alert Tone="AlertTone.Info">
                @if (_fromReleases)
                {
                    <span><b>@SourceName</b> has no GitHub release with app files attached yet. Publish one there, then come back to install it.</span>
                }
                else
                {
                    <span>
                        <b>@SourceName</b> has no successful build yet. Run a build on
                        <a href="@SourceHref">the build pipeline</a>, then come back to deploy it.
                    </span>
                }
            </Alert>
        }

        @if (_historyLoading)
        {
            <div class="card">
                <div class="card__head rp-skel-head">
                    <span class="skeleton rp-skel-glyph"></span>
                    <span class="rp-skel-stack"><span class="skeleton rp-skel-title"></span><span class="skeleton rp-skel-sub"></span></span>
                </div>
                <div class="card__body rp-skel-grid">
                    @foreach (var w in SkeletonWidths)
                    {
                        <span class="rp-skel-stack"><span class="skeleton rp-skel-label"></span><span class="skeleton" style="width: @w"></span></span>
                    }
                </div>
            </div>
            <div class="card">
                <div class="card__head"><h2 class="card__title">Deployments</h2></div>
                @foreach (var w in SkeletonWidths)
                {
                    <div class="rp-skel-row"><span class="skeleton rp-skel-glyph"></span><span class="skeleton rp-skel-line" style="width: @w"></span><span class="rp-skel-fill"></span><span class="skeleton rp-skel-end"></span></div>
                }
                <LoadingBlock Text="Loading deployments..." />
            </div>
        }
        else
        {
            var health = Health();
            <div class="@SummaryClass">
                <div class="card__head rp-summary__head">
                    <span class="rp-summary__glyph" aria-hidden="true"><Icon Name="@health.Icon" Width="20" Height="20" /></span>
                    <div class="rp-summary__text">
                        <h2 class="card__title rp-summary__title">@health.Title</h2>
                        <p class="card__sub rp-summary__sentence">@health.Sentence</p>
                    </div>
                </div>
                <div class="rp-summary__blocks">
                    <div class="card__body rp-summary__block">
                        <p class="section-label rp-summary__label">This pipeline</p>
                        <div class="rp-facts">
                            <span class="meta-item rp-fact">
                                <span class="meta-item__label">Source</span>
                                <span class="meta-item__value">
                                    @if (_fromReleases)
                                    {
                                        <a href="@SourceHref" target="_blank" rel="noopener">@SourceName</a> <span class="u-muted">GitHub releases</span>
                                    }
                                    else
                                    {
                                        @if (SourceDeleted)
                                        {
                                            @SourceName <span class="u-muted">deleted build pipeline</span>
                                        }
                                        else
                                        {
                                            <a href="@SourceHref">@SourceName</a> <span class="u-muted">build pipeline</span>
                                        }
                                    }
                                </span>
                            </span>
                            <span class="meta-item rp-fact">
                                <span class="meta-item__label">When you deploy</span>
                                <span class="meta-item__value">@DeliveryModeDisplay.ScheduleSentence(_rp.DeploymentSchedule)</span>
                            </span>
                            @if (DeliveryWindow is { } window)
                            {
                                <span class="meta-item rp-fact">
                                    <span class="meta-item__label">Delivery window</span>
                                    <span class="meta-item__value">@window <span class="u-muted">in the solution's time zone (@_tzCity)</span></span>
                                </span>
                            }
                            <span class="meta-item rp-fact">
                                <span class="meta-item__label">Schema sync</span>
                                @if (IsForceSync)
                                {
                                    <span class="meta-item__value rp-force"><Icon Name="triangle-alert" Width="14" Height="14" />Force sync</span>
                                }
                                else
                                {
                                    <span class="meta-item__value">@DeliveryModeDisplay.SyncMode(_rp.SchemaSyncMode)</span>
                                }
                            </span>
                            <span class="meta-item rp-fact">
                                <span class="meta-item__label">Last deployment</span>
                                <span class="meta-item__value">
                                    @if (LastRelease is { } last)
                                    {
                                        var lastLook = DeliveryLook(last.Status);
                                        var rowState = $"rp-strong rp-tone--{lastLook.Tone}";
                                        <span class="@rowState">@lastLook.Word</span>
                                        <span class="u-muted"> <Timestamp Value="@LastWhen(last)" Relative="true" /></span>
                                    }
                                    else
                                    {
                                        <span class="u-muted">None yet</span>
                                    }
                                </span>
                            </span>
                            <span class="meta-item rp-fact">
                                <span class="meta-item__label">Next deployment</span>
                                @if (NextRelease is { } next)
                                {
                                    <span class="meta-item__value rp-strong" title="@Exact(next.ScheduledFor)">@When(next.ScheduledFor)</span>
                                }
                                else
                                {
                                    <span class="meta-item__value">None scheduled</span>
                                }
                            </span>
                        </div>
                        @if (IsForceSync && _isProduction)
                        {
                            <Alert Tone="AlertTone.Warn">
                                <span>Force sync is on for a Production environment. If a new build removes a table or field, its data in Production is deleted during the install.</span>
                            </Alert>
                        }
                    </div>
                    <div class="card__body rp-summary__block rp-summary__block--bc">
                        <p class="section-label rp-summary__label">
                            <Icon Name="cloud-download" Width="13" Height="13" />From Business Central@(MirrorAgeTail)
                        </p>
                        <div class="rp-facts rp-facts--narrow">
                            <span class="meta-item rp-fact">
                                <span class="meta-item__label">Environment</span>
                                <span class="meta-item__value">
                                    <a href="@EnvHref">@EnvName</a>
                                    <span class="@(_isProduction ? "rp-env-type rp-env-type--prod" : "rp-env-type")">@EnvType</span>
                                </span>
                            </span>
                            <span class="meta-item rp-fact">
                                <span class="meta-item__label">Health</span>
                                <span class="meta-item__value">@EnvHealth</span>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(_rp.ProjectEnvironment.Version))
                            {
                                <span class="meta-item rp-fact">
                                    <span class="meta-item__label">Version</span>
                                    <span class="meta-item__value">@_rp.ProjectEnvironment.Version</span>
                                </span>
                            }
                            @if (NextUpdate is { } nextUpdate)
                            {
                                <span class="meta-item rp-fact">
                                    <span class="meta-item__label">Next update</span>
                                    <span class="meta-item__value">@nextUpdate</span>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (IsEmpty)
            {
                <div class="card">
                    <div class="card__head"><h2 class="card__title">Deployments</h2></div>
                    <EmptyState Icon="send" Title="No deployments yet">
                        <Text>
                            @if (HasSomethingToRelease || !_canManage)
                            {
                                <text>Nothing has been installed by this pipeline yet. Deploy the latest build to install it now.</text>
                            }
                            else if (_fromReleases)
                            {
                                <text>Nothing has been installed by this pipeline yet. Publish a release with app files on GitHub, then deploy it here.</text>
                            }
                            else
                            {
                                <text>Nothing has been installed by this pipeline yet. Run a build on the build pipeline, then deploy it here.</text>
                            }
                        </Text>
                        <Action>
                            @if (_canManage && HasSomethingToRelease)
                            {
                                <button type="button" class="btn btn--primary" @onclick="OpenReleaseAsync">
                                    <Icon Name="send" Width="16" Height="16" /><span>Deploy</span>
                                </button>
                            }
                            else if (_canManage && !_fromReleases && !SourceDeleted)
                            {
                                <a class="btn" href="@SourceHref"><Icon Name="hammer" Width="16" Height="16" /><span>Open the build pipeline</span></a>
                            }
                        </Action>
                    </EmptyState>
                </div>
            }
            else
            {
                <div class="card rp-releases">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Deployments</h2>
                            <p class="card__sub">Newest first. Open a deployment for its apps, timings and log.</p>
                        </div>
                    </div>

                    @foreach (var p in Proposals)
                    {
                        <div class="rp-approval" @key="p.Id">
                            <span class="rp-approval__glyph" aria-hidden="true"><Icon Name="user" Width="16" Height="16" /></span>
                            <div class="rp-approval__body">
                                <span class="rp-approval__head">
                                    <span class="rp-approval__eyebrow">Waiting for approval</span>
                                    <span class="rp-approval__title">Deployment @p.Number - build #@p.ProjectBuildId</span>
                                </span>
                                <span class="rp-approval__text">@ApprovalSentence(p)</span>
                                @if (_canManage)
                                {
                                    <span class="rp-approval__acts">
                                        <button type="button" class="btn btn--sm" @onclick="() => ApproveAsync(p)" disabled="@_deciding">@(_checkingSessions ? "Checking who is online..." : "Approve")</button>
                                        <button type="button" class="btn btn--sm btn--ghost" @onclick="() => DismissAsync(p)" disabled="@_deciding">Dismiss</button>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                    @if (_approvalError is { } approvalError)
                    {
                        <div class="rp-approval-error"><Alert Tone="AlertTone.Danger"><span>@approvalError</span></Alert></div>
                    }

                    @if (Rows.Count > 0)
                    {
                        <div class="rp-cols" aria-hidden="true">
                            <span></span><span></span><span>Deployment</span><span>Outcome</span><span>Started</span><span class="rp-cols__num">Took</span><span>Apps</span><span></span>
                        </div>
                    }
                    else
                    {
                        <p class="rp-none">Nothing has been installed by this pipeline yet.</p>
                    }

                    @foreach (var d in Rows)
                    {
                        var state = LookOf(d);
                        var open = _open.Contains(d.Id);
                        var failure = Failure(d);
                        var rowState = $"rp-rel rp-bar--{state.Tone}{(open ? " is-open" : "")}";
                        <div class="@rowState" @key="d.Id">
                            <div class="rp-rel__row" @onclick="() => ToggleAsync(d)">
                                <button type="button" class="btn btn--icon btn--sm btn--ghost rp-rel__toggle"
                                        aria-expanded="@(open ? "true" : "false")"
                                        aria-label="@($"{(open ? "Hide" : "Show")} details for deployment {d.Number}")">
                                    <Icon Name="chevron-right" Width="14" Height="14" />
                                </button>
                                <span class="@GlyphClass(state)" role="img" aria-label="@state.Word" title="@state.Word">
                                    <Icon Name="@state.Icon" Width="15" Height="15" />
                                </span>
                                <span class="cell-stack rp-rel__name">
                                    <span class="cell-stack__main rp-rel__title">Deployment @d.Number <span class="@($"rp-rel__word rp-tone--{state.Tone}")">- @state.Word</span></span>
                                    <span class="cell-stack__sub rp-rel__build">@BuildLine(d)</span>
                                    @if (OneTimeForceSync(d))
                                    {
                                        <span class="cell-stack__sub rp-rel__force">Force sync, this deployment only</span>
                                    }
                                    @if (DismissedLine(d) is { } setAside)
                                    {
                                        <span class="cell-stack__sub rp-rel__why"><span>@setAside</span></span>
                                    }
                                    @if (failure is not null)
                                    {
                                        <span class="cell-stack__sub rp-rel__why">
                                            <span>@failure.Collapsed</span>
                                            @if (!string.IsNullOrEmpty(failure.Code))
                                            {
                                                <span class="tag" title="Error code from Business Central">@failure.Code</span>
                                            }
                                        </span>
                                    }
                                    <span class="cell-stack__sub rp-rel__compact">@if (d.IsScheduled) { <text>for @When(d.ScheduledFor)</text> } else { <Timestamp Value="@LastWhen(d)" Relative="true" /> }@CompactTail(d)</span>
                                </span>
                                <span class="cell-stack rp-rel__outcome">
                                    <span class="@($"cell-stack__main rp-strong rp-tone--{state.Tone}")">@state.Word</span>
                                    @if (d.IsScheduled)
                                    {
                                        <span class="cell-stack__sub" title="@Exact(d.ScheduledFor)">for @When(d.ScheduledFor)</span>
                                    }
                                    else
                                    {
                                        <span class="cell-stack__sub"><Timestamp Value="@LastWhen(d)" Relative="true" /></span>
                                    }
                                </span>
                                <span class="rp-rel__cell" title="@(StartOf(d) is { } s ? Exact(s) : null)">@(StartOf(d) is { } started ? When(started) : "Not started")</span>
                                <span class="rp-rel__cell rp-rel__took u-num">@(Took(d) ?? "-")</span>
                                <span class="rp-rel__cell">@AppsSummary(d)</span>
                                <span class="rp-rel__acts">
                                    @if (CanReleaseAgain(d))
                                    {
                                        <button type="button" class="btn btn--sm" @onclick="() => OpenReleaseAgainAsync(d, false)" @onclick:stopPropagation="true">Deploy again</button>
                                    }
                                    @if (d.IsScheduled && _canManage)
                                    {
                                        <button type="button" class="btn btn--sm" @onclick="() => OpenRescheduleAsync(d)" @onclick:stopPropagation="true">Reschedule</button>
                                        <button type="button" class="btn btn--sm btn--ghost" @onclick="() => CancelAsync(d)" @onclick:stopPropagation="true">Cancel</button>
                                    }
                                    else if (MayStillBeHeld(d))
                                    {
                                        <button type="button" class="btn btn--sm" @onclick="() => OpenRescheduleAsync(d)" @onclick:stopPropagation="true">Reschedule</button>
                                    }
                                </span>
                            </div>

                            @if (open)
                            {
                                <div class="rp-rel__detail">
                                    @if (failure is not null)
                                    {
                                        @* DeliveryRowPanel.dc.html, "Failed, expanded" (#930): our sentence
                                           from the code, then Business Central's words as given - never
                                           translated, never mined for details - then what the environment
                                           has, then what to do. *@
                                        <div class="rp-what">
                                            <span class="rp-what__label">What happened</span>
                                            <p class="rp-what__text">@failure.WhatHappened</p>
                                            @if (failure.BcMessage is { } said)
                                            {
                                                <div class="rp-what__bc">
                                                    <span class="rp-what__bc-label">Business Central's message, in the environment's language</span>
                                                    <p class="rp-what__bc-text">@said</p>
                                                    @if (failure.Clipped)
                                                    {
                                                        <span class="rp-what__bc-label">Only the start of this message was kept for this older deployment.</span>
                                                    }
                                                </div>
                                            }
                                            @if (failure.FailedApp is { } failedApp && ReportedVersion(failedApp) is { } reported)
                                            {
                                                <p class="rp-what__env">@reported</p>
                                            }
                                        </div>
                                        @if (failure.NextStep is { } nextStep)
                                        {
                                            <div class="rp-next">
                                                <span class="rp-next__label">Suggested next step</span>
                                                <span class="rp-next__text">@nextStep</span>
                                                @if (CanReleaseAgain(d) && SuggestsForceSync(d, failure))
                                                {
                                                    <span class="rp-next__acts">
                                                        <button type="button" class="btn" @onclick="() => OpenReleaseAgainAsync(d, true)">
                                                            <Icon Name="rotate-cw" Width="15" Height="15" /><span>Deploy again with Force sync</span>
                                                        </button>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    }
                                    else if (InfoSentence(d) is { } info)
                                    {
                                        <Alert Tone="AlertTone.Info"><span>@info</span></Alert>
                                    }

                                    @if (Steps(d) is { Count: > 0 } steps)
                                    {
                                        <ol class="rp-steps" aria-label="Steps">
                                            @foreach (var step in steps)
                                            {
                                                var cssClass = $"rp-step rp-step--{step.Tone}";
                                                <li class="@cssClass">
                                                    <span class="rp-step__label">@step.Label</span>
                                                    <span class="rp-step__at u-num" title="@step.Exact">@step.At</span>
                                                    <span class="rp-step__took u-num">@step.Took</span>
                                                </li>
                                            }
                                        </ol>
                                    }

                                    @if (d.Apps.Count > 0)
                                    {
                                        <div class="rp-apps">
                                            <p class="section-label rp-summary__label">Apps in this deployment</p>
                                            <div class="rp-apps__list">
                                                @for (var i = 0; i < d.Apps.Count; i++)
                                                {
                                                    var a = d.Apps[i];
                                                    var status = AppLook(a.Status);
                                                    var row = $"rp-app rp-bar--{status.Tone}";
                                                    var message = AppMessage(d, a, i);
                                                    <div class="@row">
                                                        <span class="@GlyphClass(status)" role="img" aria-label="@status.Word">
                                                            <Icon Name="@status.Icon" Width="15" Height="15" />
                                                        </span>
                                                        <span class="rp-app__main">
                                                            <span class="rp-app__line">
                                                                <span class="rp-app__name" title="@(a.OperationId is { } op ? $"Business Central operation {op}" : null)">@a.AppName</span>
                                                                <span class="rp-app__ver u-num">@AppVersionText(a)</span>
                                                            </span>
                                                            @if (message is not null)
                                                            {
                                                                <span class="@(a.Status == ProjectDeliveryResultStatus.Failed ? "rp-app__msg rp-app__msg--failed" : "rp-app__msg")">@message</span>
                                                            }
                                                        </span>
                                                        <span class="rp-app__end">
                                                            <span class="@($"rp-strong rp-tone--{status.Tone}")">@status.Word</span>
                                                            @if (AppTook(a) is { } appTook)
                                                            {
                                                                <span class="rp-app__took u-num">@appTook</span>
                                                            }
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (failure?.Raw is { } raw)
                                    {
                                        <details class="rp-raw">
                                            <summary class="rp-raw__summary">Raw response from Business Central, for support</summary>
                                            <div class="rp-raw__body">
                                                <pre class="rp-raw__text" id="@($"rp-raw-{d.Id}")">@SupportText(d, raw)</pre>
                                                <span class="rp-raw__foot">
                                                    <CopyButton Target="@($"#rp-raw-{d.Id}")" Label="Copy for support" />
                                                    <span>Includes the deployment, the environment and the time.</span>
                                                </span>
                                            </div>
                                        </details>
                                    }

                                    @if (LogLines(d) is { Count: > 0 } lines)
                                    {
                                        <details class="rp-log" open="@(d.Status == ProjectDeliveryStatus.Failed)">
                                            <summary class="rp-log__summary">
                                                <span>Diagnostics log</span>
                                                <span class="u-muted">@(lines.Count == 1 ? "1 line" : $"{lines.Count} lines"), times in UTC</span>
                                                <span class="rp-log__spacer"></span>
                                                <CopyButton Target="@($"#rp-log-{d.Id}")" Label="Copy log" />
                                            </summary>
                                            <div class="rp-log__scroll">
                                                <div class="rp-log__lines" id="@($"rp-log-{d.Id}")">
                                                    @foreach (var line in lines)
                                                    {
                                                        <div class="@(line.Error ? "rp-log__line rp-log__line--err" : "rp-log__line")"><span class="rp-log__t">@line.Time</span> <span>@line.Message</span></div>
                                                    }
                                                </div>
                                            </div>
                                        </details>
                                    }

                                    @if (CanReleaseAgain(d))
                                    {
                                        <div class="rp-rel__phone-acts rp-rel__phone-acts--one">
                                            <button type="button" class="btn" @onclick="() => OpenReleaseAgainAsync(d, false)">Deploy again</button>
                                        </div>
                                    }
                                    @if (d.IsScheduled && _canManage)
                                    {
                                        @* The phone layout's actions: the row's own cell is hidden
                                           there, and a 44px full-width pair takes its place. *@
                                        <div class="rp-rel__phone-acts">
                                            <button type="button" class="btn" @onclick="() => OpenRescheduleAsync(d)">Reschedule</button>
                                            <button type="button" class="btn btn--ghost" @onclick="() => CancelAsync(d)">Cancel</button>
                                        </div>
                                    }
                                    else if (MayStillBeHeld(d))
                                    {
                                        <div class="rp-rel__phone-acts rp-rel__phone-acts--one">
                                            <button type="button" class="btn" @onclick="() => OpenRescheduleAsync(d)">Reschedule</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (HasOlder)
                    {
                        <div class="card__foot rp-foot">
                            <button type="button" class="btn btn--sm btn--ghost" @onclick="ShowOlderAsync" disabled="@_loadingOlder">
                                @(_loadingOlder ? "Loading..." : "Show older deployments")
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </ChildContent>
</DetailPage>

<ReleaseBuildDialog @ref="_releaseDialog" OnReleased="OnReleasedAsync" />
<ReleaseAgainDialog @ref="_releaseAgainDialog" OnReleased="OnReleasedAsync" />
<ConfirmDialog @ref="_cancelConfirm" Title="Cancel this deployment?"
               ConfirmLabel="Cancel deployment" CancelLabel="Keep it scheduled"
               ConfirmButtonClass="btn--danger" ConfirmIcon="circle-x" />
<ConfirmDialog @ref="_approveConfirm" Title="Approve this deployment?"
               ConfirmLabel="Approve" CancelLabel="Not yet"
               ConfirmButtonClass="btn--primary" ConfirmIcon="check"
               ConfirmDisabled="@(_isProduction && !_approveProdAck)">
    @if (_isProduction)
    {
        <label class="@(_approveProdAck ? "check check--ack is-checked" : "check check--ack")">
            <input type="checkbox" checked="@_approveProdAck"
                   @onchange="e => _approveProdAck = (bool)(e.Value ?? false)" />
            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
            @if (string.Equals(EnvName, "Production", StringComparison.OrdinalIgnoreCase))
            {
                <span>I understand this installs the apps into <b>@CustomerName</b>'s live <b>Production</b> environment.</span>
            }
            else
            {
                <span>I understand this installs the apps into <b>@EnvName</b>, <b>@CustomerName</b>'s live <b>Production</b> environment.</span>
            }
        </label>
    }
</ConfirmDialog>
<ConfirmDialog @ref="_dismissConfirm" Title="Dismiss this deployment?"
               ConfirmLabel="Dismiss deployment" CancelLabel="Keep it"
               ConfirmButtonClass="btn--primary" ConfirmIcon="x">
    <div class="field">
        <label class="field__label" for="rp-dismiss-why">Reason <span class="u-muted">(optional)</span></label>
        <input id="rp-dismiss-why" type="text" class="input" maxlength="@DeliveryService.DismissReasonMaxLength"
               placeholder="e.g. CRONUS asked us to wait until after month-end"
               @bind="_dismissReason" @bind:event="oninput" />
        <small class="field__hint">Kept with the deployment in this pipeline's history.</small>
    </div>
</ConfirmDialog>

<RescheduleDeploymentDialog @ref="_rescheduleDialog" OnRescheduled="OnRescheduledAsync" />

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>
    /// A build to open Deploy with, chosen: the new deployment pipeline page sends people
    /// here after it was set up from a build's "Deploy..." (#938, #1080). Ignored unless
    /// it is one of the source build pipeline's successful builds.
    /// </summary>
    [SupplyParameterFromQuery(Name = "deploy")] public int? DeployBuildId { get; set; }
    private bool _deployOffered;

    /// <summary>How many deployments the list shows at first, and how many more each "Show older deployments" adds.</summary>
    internal const int PageSize = 10;

    private bool _loading = true;
    private bool _historyLoading = true;
    private bool _loadingOlder;
    private OeReleasePipeline? _rp;
    private bool _canManage;
    private bool _isProduction;
    private List<DeliveryHistoryRow> _deliveries = new();
    private int _limit = PageSize;
    private readonly HashSet<int> _open = new();
    private bool _openedDefault;

    // Why each opened deployment's skipped apps were skipped, read from the build's
    // manifests once per deployment (null = no failed app to point at, or unreadable).
    private readonly Dictionary<int, DeliverySkipReasons?> _skipReasons = new();

    private List<ReleaseBuildDialog.ReleasableBuildOption> _successfulBuilds = new();
    // A Release-sourced pipeline offers the repository's release tags instead of the
    // build pipeline's builds (#632).
    private List<ALDevToolbox.Services.GitHub.GitHubReleaseOption> _releaseOptions = new();
    private string? _releasesError;
    // Set when Reschedule on a handed-off row finds Business Central no longer holds it.
    private string? _rescheduleNotice;

    /// <summary>True when this pipeline installs apps from a repository's GitHub releases.</summary>
    private bool _fromReleases;

    private ReleaseBuildDialog? _releaseDialog;
    private ReleaseAgainDialog? _releaseAgainDialog;
    private ConfirmDialog? _cancelConfirm;
    private ConfirmDialog? _approveConfirm;
    private ConfirmDialog? _dismissConfirm;

    // The approval band (#934).
    private bool _deciding;
    private bool _checkingSessions;
    private bool _approveProdAck;
    private string _dismissReason = string.Empty;
    private string? _approvalError;

    private TimeZoneInfo _tz = TimeZoneInfo.Utc;
    private string _tzCity = "UTC";

    private RescheduleDeploymentDialog? _rescheduleDialog;

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);
    private PeriodicTimer? _poll;
    private CancellationTokenSource? _pollCts;
    private DateTime? _secretExpiresAt;

    private static readonly string[] SkeletonWidths = ["70%", "50%", "62%", "44%", "58%", "66%"];

    /// <summary>What this pipeline draws from: the build pipeline's name, or the repository's.</summary>
    private string SourceName => _fromReleases
        ? _rp?.GithubReleaseRepository?.DisplayName ?? "the repository"
        : _rp?.BuildPipeline?.Name ?? "the build pipeline";

    /// <summary>True when the build pipeline this draws from has been deleted; its page is gone with it.</summary>
    private bool SourceDeleted => !_fromReleases && _rp?.BuildPipeline?.DeletedAt is not null;

    /// <summary>
    /// Where the source lives. Same-named source and environment ("Test" into "Test") are
    /// told apart by where their links go, which is the point of #932.
    /// </summary>
    private string SourceHref => _fromReleases
        ? (_rp?.GithubReleaseRepository?.Url is { Length: > 0 } url ? RepositoryWebUrl(url) : $"/solutions/{_rp?.ProjectId}")
        : $"/pipelines/{_rp?.BuildPipelineId}";

    private string EnvName => _rp?.ProjectEnvironment?.Name ?? "";
    private string EnvType => string.IsNullOrWhiteSpace(_rp?.ProjectEnvironment?.Type) ? "Business Central" : _rp!.ProjectEnvironment!.Type;
    private string EnvHref => $"/environments/{_rp?.ProjectEnvironmentId}";

    /// <summary>True when there is at least one build (or deployment) the person could send.</summary>
    private bool HasSomethingToRelease => _fromReleases ? _releaseOptions.Count > 0 : _successfulBuilds.Count > 0;

    private string NothingToReleaseReason => _fromReleases
        ? "This repository has no GitHub release with app files attached yet."
        : "The build pipeline has no successful build to deploy yet.";

    private bool IsEmpty => !_historyLoading && _deliveries.Count == 0;
    private bool IsForceSync => BcSyncMode.Normalize(_rp?.SchemaSyncMode) == BcSyncMode.ForceSync;

    /// <summary>Deployments the pipeline prepared from a new build, waiting for someone to approve them (#934). Drawn in the band, not as rows.</summary>
    private List<DeliveryHistoryRow> Proposals => _deliveries.Where(d => d.IsProposed).ToList();

    /// <summary>The deployments list proper: everything but the prepared ones waiting in the band.</summary>
    private List<DeliveryHistoryRow> Rows => _deliveries.Where(d => !d.IsProposed).ToList();

    private string CustomerName => string.IsNullOrWhiteSpace(_rp?.Project?.Name) ? "this solution" : _rp!.Project!.Name;

    /// <summary>A row numbered above 1 at the bottom of the list means the pipeline has older deployments.</summary>
    private bool HasOlder => _deliveries.Count > 0 && _deliveries[^1].Number > 1;

    protected override async Task OnInitializedAsync()
    {
        await Zone.EnsureLoadedAsync();
        await LoadPipelineAsync();
        if (_rp is null) return;
        // Draw the head and the skeleton while the history loads, as the sheet does.
        StateHasChanged();
        await LoadHistoryAsync();
        EnsurePolling();
    }

    private async Task LoadPipelineAsync()
    {
        _loading = true;
        try
        {
            _rp = await Releases.GetReleasePipelineAsync(Id);
        }
        catch (ProjectAccessDeniedException)
        {
            // A private solution this person isn't on the team for reads the same
            // as one that no longer exists.
            _rp = null;
        }
        if (_rp is null) { _loading = false; return; }

        // The secret in use may be the organisation's rather than the solution's own,
        // so the expiry warnings ask the connection, not the solution's columns.
        try
        {
            _secretExpiresAt = (await Connection.GetConnectionAsync(_rp.ProjectId))?.EffectiveSecretExpiresAt;
        }
        catch (ProjectAccessDeniedException)
        {
            _secretExpiresAt = null;
        }

        _isProduction = string.Equals(_rp.ProjectEnvironment?.Type, "Production", StringComparison.OrdinalIgnoreCase);
        _tz = UpdateWindow.ResolveTimeZone(_rp.Project?.BcTimeZone);
        var tzId = _rp.Project?.BcTimeZone;
        _tzCity = string.IsNullOrWhiteSpace(tzId) ? "UTC" : tzId![(tzId!.LastIndexOf('/') + 1)..].Replace('_', ' ');
        _canManage = await Releases.CanManageAsync(Id);

        _fromReleases = _rp.ArtifactSource == ReleaseArtifactSource.GithubRelease;
        _successfulBuilds = new();
        _releaseOptions = new();
        _releasesError = null;

        if (_fromReleases)
        {
            // Asking GitHub is the one thing on this page that can be slow or fail; a
            // refusal is shown above the history rather than replacing the page, so the
            // deployments already made stay readable.
            try
            {
                _releaseOptions = (await GitHubReleases.ListReleasesAsync(Id))
                    .Where(r => r.AppFileNames.Count > 0)
                    .ToList();
            }
            catch (PlanValidationException ex)
            {
                _releasesError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't read this repository's releases.";
            }
            catch (Exception ex)
            {
                Log.LogError(ex, "Reading GitHub releases failed for deployment pipeline {ReleasePipelineId}.", Id);
                _releasesError = "Couldn't read this repository's releases from GitHub. Try again in a moment.";
            }
        }
        else if (_rp.BuildPipelineId is { } buildPipelineId)
        {
            // The releasable builds are the source build pipeline's newest successful builds.
            var builds = await Artifacts.ListDeployableBuildsAsync(buildPipelineId);
            // A build offered through the address may be older than those.
            if (DeployBuildId is { } offered && builds.All(b => b.Id != offered)
                && await Artifacts.GetPipelineBuildRowAsync(buildPipelineId, offered) is { Status: ProjectBuildStatus.Ready, IsPreview: false } older)
            {
                builds.Add(older);
            }
            // The apps each build carries, so the deployment dialog can show what is about
            // to be installed before the consultant confirms (#714).
            var appsByBuild = await Artifacts.ListBuildAppsAsync(buildPipelineId, builds.Select(b => b.Id).ToList());
            _successfulBuilds = ReleaseBuildDialog.OptionsFrom(builds, appsByBuild, Zone);
        }

        _loading = false;
    }

    private async Task LoadHistoryAsync()
    {
        _deliveries = await Deliveries.ListDeliveryHistoryAsync(Id, _limit);
        _historyLoading = false;
        OpenDefault();
        await LoadSkipReasonsAsync();
    }

    /// <summary>
    /// Opens the newest deployment once, when it is the one someone came to look at: a
    /// failure, one that is running, or one waiting for its time. Only on the first load,
    /// so a row the person closed stays closed while the page polls.
    /// </summary>
    private void OpenDefault()
    {
        if (_openedDefault || _deliveries.Count == 0) return;
        _openedDefault = true;
        if (Rows.FirstOrDefault() is not { } newest) return;
        if (newest.Status == ProjectDeliveryStatus.Failed || newest.IsActive || newest.IsScheduled)
        {
            _open.Add(newest.Id);
        }
    }

    private async Task ToggleAsync(DeliveryHistoryRow d)
    {
        if (!_open.Remove(d.Id))
        {
            _open.Add(d.Id);
            await LoadSkipReasonsAsync();
        }
    }

    /// <summary>
    /// Reads, once per opened deployment, why its skipped apps were skipped. Its own DI
    /// scope, because a click can land while the page's context is mid-query.
    /// </summary>
    private async Task LoadSkipReasonsAsync()
    {
        var wanted = _deliveries
            .Where(d => _open.Contains(d.Id) && !_skipReasons.ContainsKey(d.Id)
                        && d.Status == ProjectDeliveryStatus.Failed
                        && d.Apps.Any(a => a.Status == ProjectDeliveryResultStatus.Skipped))
            .Select(d => d.Id)
            .ToList();
        if (wanted.Count == 0) return;

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var service = scope.ServiceProvider.GetRequiredService<DeliveryService>();
            foreach (var id in wanted)
            {
                _skipReasons[id] = await service.GetSkipReasonsAsync(id);
            }
        }
        catch (Exception ex)
        {
            // The row falls back to "skipped after X failed", which is still true.
            Log.LogWarning(ex, "Couldn't read why apps were skipped on deployment pipeline {ReleasePipelineId}.", Id);
            foreach (var id in wanted) _skipReasons.TryAdd(id, null);
        }
    }

    private async Task ShowOlderAsync()
    {
        _loadingOlder = true;
        try
        {
            _limit += PageSize;
            _deliveries = await Deliveries.ListDeliveryHistoryAsync(Id, _limit);
        }
        finally
        {
            _loadingOlder = false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadPipelineAsync();
        if (_rp is null) return;
        await LoadHistoryAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // After the history too: Deploy writes through the same context the history reads.
        if (_deployOffered || DeployBuildId is not { } buildId || _loading || _historyLoading || _rp is null || _releaseDialog is null) return;
        _deployOffered = true;
        // Out of the address, so a reload or Back doesn't offer the same deploy again.
        Nav.NavigateTo($"/pipelines/deployments/{Id}", replace: true);
        if (!_canManage || _fromReleases || _successfulBuilds.All(b => b.Id != buildId)) return;
        await _releaseDialog.OpenAsync(
            _rp.Id, _rp.Project?.Name ?? "", _rp.ProjectEnvironment!.Name, _rp.ProjectEnvironment.Type,
            _rp.DeploymentSchedule, _rp.SchemaSyncMode, _successfulBuilds,
            _rp.Project?.BcTimeZone, _rp.ProjectEnvironment.UpdateWindowStart, _rp.ProjectEnvironment.UpdateWindowEnd,
            _secretExpiresAt,
            selectedBuildId: buildId);
    }

    private async Task OpenReleaseAsync()
    {
        if (_releaseDialog is null || _rp is null || !HasSomethingToRelease) return;
        await _releaseDialog.OpenAsync(
            _rp.Id, _rp.Project?.Name ?? "", _rp.ProjectEnvironment!.Name, _rp.ProjectEnvironment.Type,
            _rp.DeploymentSchedule, _rp.SchemaSyncMode, _successfulBuilds,
            _rp.Project?.BcTimeZone, _rp.ProjectEnvironment.UpdateWindowStart, _rp.ProjectEnvironment.UpdateWindowEnd,
            _secretExpiresAt,
            _fromReleases ? _releaseOptions : null,
            _fromReleases ? SourceName : null);
    }

    private async Task OnReleasedAsync(int _)
    {
        _openedDefault = false; // the new deployment is the one to watch
        await ReloadAsync();
        EnsurePolling(); // a deploy-now delivery is active → start watching
    }

    // ── Deploy again (failed deployments only, #931) ────────────────────────────

    /// <summary>A failed deployment can be deployed again by someone who manages the pipeline.</summary>
    private bool CanReleaseAgain(DeliveryHistoryRow d) => _canManage && d.Status == ProjectDeliveryStatus.Failed;

    /// <summary>
    /// The failure's next step offers Force sync only where it is the fix: Business Central
    /// refused a schema change, and this deployment did not already use it.
    /// </summary>
    private static bool SuggestsForceSync(DeliveryHistoryRow d, FailureView failure) =>
        failure.Code == BcFailureText.ExtensionChangeFailed
        && BcSyncMode.Normalize(d.SchemaSyncMode) != BcSyncMode.ForceSync;

    /// <summary>True when this deployment used Force sync and the pipeline does not: it was asked for once.</summary>
    private bool OneTimeForceSync(DeliveryHistoryRow d) =>
        BcSyncMode.Normalize(d.SchemaSyncMode) == BcSyncMode.ForceSync && !IsForceSync;

    private async Task OpenReleaseAgainAsync(DeliveryHistoryRow d, bool forceSync)
    {
        if (_releaseAgainDialog is null || _rp is null) return;
        var source = !string.IsNullOrWhiteSpace(d.BuildReleaseTag)
            ? $"from GitHub release {d.BuildReleaseTag}"
            : $"from build pipeline \"{SourceName}\"";
        // What this deployment left in place at the build's version: the apps it installed
        // before the failure, and any the environment already had. The run skips them.
        var alreadyOn = d.Apps
            .Where(a => a.Status == ProjectDeliveryResultStatus.Completed
                        || (a.PreviousVersion is { } before && string.Equals(before, a.AppVersion, StringComparison.OrdinalIgnoreCase)))
            .Select(a => a.AppName)
            .ToList();
        await _releaseAgainDialog.OpenAsync(new ReleaseAgainDialog.Request(
            d.Id, Id, d.ProjectBuildId, source, _rp.Project?.Name ?? "this solution",
            EnvName, _rp.ProjectEnvironment?.Type,
            BcDeploymentSchedule.ToWire(_rp.DeploymentSchedule) ?? _rp.DeploymentSchedule,
            _rp.SchemaSyncMode,
            d.Apps.Select(a => a.AppName).ToList(),
            alreadyOn,
            ReleaseNowOutsideWindow(),
            Failure(d) is { } failure && SuggestsForceSync(d, failure)), forceSync);
    }

    /// <summary>
    /// Deploying again runs now; when the environment has a delivery window that is not
    /// open, say so, as the Deployment dialog does for "Now".
    /// </summary>
    private string? ReleaseNowOutsideWindow()
    {
        var env = _rp?.ProjectEnvironment;
        if (env is null || !UpdateWindow.IsConfigured(env.UpdateWindowStart, env.UpdateWindowEnd)) return null;
        if (UpdateWindow.IsWithin(env.UpdateWindowStart, env.UpdateWindowEnd, _tz, DateTime.UtcNow)) return null;
        return $"{EnvName}'s delivery window ({DeliveryWindow}) isn't open now. Deploying again installs outside the hours agreed with the customer, and the deployment history will record that.";
    }

    // ── Waiting for approval (#934) ───────────────────────────────────────────

    /// <summary>
    /// The band's sentence: which build, when it finished, where the deployment would go and
    /// when it would install once approved. The time is the pipeline's rule, as approving
    /// applies it: the next opening of the delivery window, or right away.
    /// </summary>
    private string ApprovalSentence(DeliveryHistoryRow p)
    {
        var where = _isProduction ? $"the Production environment \"{EnvName}\"" : $"\"{EnvName}\"";
        var sentence = $"Build #{p.ProjectBuildId} finished {WhenPhrase(p.CreatedAt)} and a deployment was prepared for {where}.";
        if (!_canManage)
        {
            return sentence + " Someone who manages this solution can approve or dismiss it.";
        }
        return sentence + $" Approve it to install it {InstallsWhen()}, or dismiss it.";
    }

    /// <summary>
    /// True when approving installs right away, the same rule <see cref="InstallsWhen"/>
    /// words: not waiting for a delivery window that is shut, and not handed to Business
    /// Central's next update.
    /// </summary>
    private bool ApprovalInstallsNow()
    {
        var env = _rp?.ProjectEnvironment;
        if (BcDeploymentSchedule.IsOurDeliveryWindow(_rp?.DeploymentSchedule)
            && env is not null && UpdateWindow.IsConfigured(env.UpdateWindowStart, env.UpdateWindowEnd))
        {
            return UpdateWindow.NextOpeningUtc(env.UpdateWindowStart, env.UpdateWindowEnd, _tz, DateTime.UtcNow)
                <= DateTime.UtcNow.AddMinutes(1);
        }
        return !BcDeploymentSchedule.IsDeferred(BcDeploymentSchedule.ToWire(_rp?.DeploymentSchedule));
    }

    /// <summary>When an approved deployment installs, as a phrase: "right away", "in the next delivery window (today at 22:00)".</summary>
    private string InstallsWhen()
    {
        var env = _rp?.ProjectEnvironment;
        if (BcDeploymentSchedule.IsOurDeliveryWindow(_rp?.DeploymentSchedule)
            && env is not null && UpdateWindow.IsConfigured(env.UpdateWindowStart, env.UpdateWindowEnd))
        {
            var opening = UpdateWindow.NextOpeningUtc(env.UpdateWindowStart, env.UpdateWindowEnd, _tz, DateTime.UtcNow);
            return opening <= DateTime.UtcNow.AddMinutes(1)
                ? "right away, while the delivery window is open"
                : $"in the next delivery window ({WhenPhrase(opening)})";
        }
        var wire = BcDeploymentSchedule.ToWire(_rp?.DeploymentSchedule);
        return wire is null || wire == BcDeploymentSchedule.Immediate
            ? "right away"
            : $"with the {DeliveryModeDisplay.Schedule(wire).ToLowerInvariant()}";
    }

    private async Task ApproveAsync(DeliveryHistoryRow p)
    {
        if (_approveConfirm is null || _deciding) return;
        _approvalError = null;
        _approveProdAck = false;
        var apps = p.Apps.Count == 1 ? $"{p.Apps[0].AppName} {p.Apps[0].AppVersion}" : $"{p.Apps.Count} apps ({string.Join(", ", p.Apps.Select(a => a.AppName))})";
        var where = _isProduction
            ? $"{CustomerName}'s Production environment \"{EnvName}\""
            : $"the {EnvType} environment \"{EnvName}\"";

        // An approval that installs right away asks who is signed in first, and puts the
        // answer in the same confirmation.
        OpenSessionsCheck? sessions = null;
        if (ApprovalInstallsNow())
        {
            _deciding = true;
            _checkingSessions = true;
            StateHasChanged();
            try
            {
                // Its own scope: this waits on Business Central while the page's other
                // buttons stay live on the circuit's one context (#679).
                await using var scope = ScopeFactory.CreateAsyncScope();
                var deliveries = scope.ServiceProvider.GetRequiredService<DeliveryService>();
                sessions = await OpenSessionsCheck.AskAsync(() => deliveries.CheckOpenSessionsAsync(Id), EnvName, Log);
            }
            catch (PlanValidationException ex)
            {
                _approvalError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't approve this deployment.";
                return;
            }
            catch (ProjectAccessDeniedException)
            {
                _approvalError = "Only the solution owner or an admin can approve deployments here.";
                return;
            }
            finally
            {
                _deciding = false;
                _checkingSessions = false;
            }
        }
        var askAboutSessions = sessions is { NeedsConfirmation: true };

        var confirmed = await _approveConfirm.OpenAsync(
            $"Approve deployment {p.Number}?",
            $"This installs build #{p.ProjectBuildId}, {apps}, into {where} {InstallsWhen()}. You can still cancel it on this page until it starts."
                + (askAboutSessions ? " " + sessions!.Question : ""),
            askAboutSessions ? "Approve anyway" : "Approve", "btn--primary", "check");
        if (!confirmed) return;

        _deciding = true;
        try
        {
            await Deliveries.ApproveProposalAsync(p.Id);
            await OnReleasedAsync(p.Id);
        }
        catch (PlanValidationException ex)
        {
            _approvalError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't approve this deployment.";
            await ReloadAsync();
        }
        catch (ProjectAccessDeniedException)
        {
            _approvalError = "Only the solution owner or an admin can approve deployments here.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to approve delivery {DeliveryId}.", p.Id);
            _approvalError = "Couldn't approve this deployment. Try again, and if it keeps failing tell an administrator.";
        }
        finally
        {
            _deciding = false;
        }
    }

    private async Task DismissAsync(DeliveryHistoryRow p)
    {
        if (_dismissConfirm is null || _deciding) return;
        _approvalError = null;
        _dismissReason = string.Empty;
        var confirmed = await _dismissConfirm.OpenAsync(
            $"Dismiss deployment {p.Number}?",
            $"Build #{p.ProjectBuildId} won't be installed. The next successful build prepares a new deployment.",
            "Dismiss deployment", "btn--primary", "x");
        if (!confirmed) return;

        _deciding = true;
        try
        {
            await Deliveries.DismissProposalAsync(p.Id, _dismissReason);
            await ReloadAsync();
        }
        catch (PlanValidationException ex)
        {
            _approvalError = ex.Errors.Values.FirstOrDefault() ?? "Couldn't dismiss this deployment.";
            await ReloadAsync();
        }
        catch (ProjectAccessDeniedException)
        {
            _approvalError = "Only the solution owner or an admin can dismiss deployments here.";
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to dismiss delivery {DeliveryId}.", p.Id);
            _approvalError = "Couldn't dismiss this deployment. Try again, and if it keeps failing tell an administrator.";
        }
        finally
        {
            _deciding = false;
        }
    }

    // ── Cancel + reschedule (scheduled deployments only) ─────────────────────────

    private async Task CancelAsync(DeliveryHistoryRow d)
    {
        if (_cancelConfirm is null) return;
        var confirmed = await _cancelConfirm.OpenAsync(
            "Cancel this deployment?",
            $"Cancel deployment {d.Number} of build #{d.ProjectBuildId}, scheduled for {ScheduledWhen(d)}? It won't run.",
            "Cancel deployment");
        if (!confirmed) return;
        try
        {
            await Deliveries.CancelDeliveryAsync(d.Id);
            await ReloadAsync();
        }
        catch (PlanValidationException ex)
        {
            // Lost the race — it already started. Reflect the new state.
            Log.LogInformation(ex, "Cancel race on delivery {DeliveryId}.", d.Id);
            await ReloadAsync();
            EnsurePolling();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to cancel delivery {DeliveryId}.", d.Id);
        }
    }

    /// <summary>
    /// True for a run cancelled after Business Central took it: only moving a held
    /// deployment does that (#1097); a plain cancel stops a run before anything is sent.
    /// </summary>
    private static bool IsMoved(DeliveryHistoryRow d) =>
        d.Status == ProjectDeliveryStatus.Cancelled && d.Apps.Any(a => a.OperationId is not null);

    /// <summary>
    /// True for a handed-off run Business Central is still holding, as the service read it:
    /// one app, not replaced by a later run, and not installed yet.
    /// </summary>
    private bool MayStillBeHeld(DeliveryHistoryRow d) => _canManage && d.StillHeld;

    private async Task OpenRescheduleAsync(DeliveryHistoryRow d)
    {
        if (_rescheduleDialog is null) return;
        _rescheduleNotice = null;
        try
        {
            if (!await _rescheduleDialog.OpenAsync(d.Id, _secretExpiresAt))
            {
                if (d.Status == ProjectDeliveryStatus.HandedOff)
                {
                    _rescheduleNotice = _rescheduleDialog.LastRefusal;
                }
                // It started (or went) since the list was read: show what it is now.
                await ReloadAsync();
                EnsurePolling();
            }
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Failed to open the reschedule dialog for delivery {DeliveryId}.", d.Id);
        }
    }

    private async Task OnRescheduledAsync(int deliveryId)
    {
        await ReloadAsync();
        EnsurePolling();
    }

    // ── Live polling of in-flight deployments ────────────────────────────────────

    private void EnsurePolling()
    {
        if (_poll is not null) return;
        if (!_deliveries.Any(d => d.IsActive)) return;
        _pollCts = new CancellationTokenSource();
        _poll = new PeriodicTimer(PollInterval);
        _ = PollLoopAsync(_poll, _pollCts.Token);
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                // Own DI scope per tick: this runs on a thread-pool continuation, not the
                // circuit's dispatcher, so sharing the circuit's DbContext would let a tick
                // and a click have two commands in flight on one context. See #679.
                List<DeliveryHistoryRow> rows;
                await using (var scope = ScopeFactory.CreateAsyncScope())
                {
                    rows = await scope.ServiceProvider.GetRequiredService<DeliveryService>()
                        .ListDeliveryHistoryAsync(Id, _limit, token);
                }

                // Disposal can happen while we were parked on the query; touching the
                // renderer after that logs an error for what is a normal navigate-away.
                if (token.IsCancellationRequested) break;
                await InvokeAsync(async () =>
                {
                    _deliveries = rows;
                    // A deployment that just finished may have skipped apps worth explaining.
                    await LoadSkipReasonsAsync();
                    StateHasChanged();
                });
                if (!rows.Any(d => d.IsActive)) { StopPoll(); break; }
            }
        }
        catch (OperationCanceledException) { /* navigating away */ }
        catch (ObjectDisposedException) when (token.IsCancellationRequested) { /* torn down mid-poll */ }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deployment poll failed for deployment pipeline {ReleasePipelineId}.", Id);
        }
        finally
        {
            StopPoll();
        }
    }

    /// <summary>
    /// Idempotent, single-shot teardown: disposal (renderer thread) and the poll loop's
    /// finally (thread pool) both call this, so the fields are claimed atomically to avoid
    /// a double Dispose / Cancel-on-disposed race.
    /// </summary>
    private void StopPoll()
    {
        var cts = Interlocked.Exchange(ref _pollCts, null);
        var timer = Interlocked.Exchange(ref _poll, null);
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
    }

    public ValueTask DisposeAsync()
    {
        StopPoll();
        return ValueTask.CompletedTask;
    }

    // ── The summary card ──────────────────────────────────────────────────────

    private sealed record HealthView(string Tone, string Icon, string Title, RenderFragment Sentence);

    /// <summary>
    /// The card's keyline, title and one sentence. Facts only: what happened last, what
    /// the environment reported, what is next. Never a reassurance the product cannot
    /// back ("nothing is broken for users"), per the review brief.
    /// </summary>
    private string SummaryClass => $"card rp-summary rp-summary--{Health().Tone}";

    private HealthView Health()
    {
        var active = _deliveries.FirstOrDefault(d => d.IsActive);
        if (active is not null)
        {
            return new HealthView("running", "refresh-cw", "Deploying now",
                Plain($"Deployment {active.Number} is {DeliveryLook(active.Status).Word.ToLowerInvariant()} into \"{EnvName}\". {RunningSentence(active)}"));
        }

        var last = LastRelease;
        if (last is { Status: ProjectDeliveryStatus.Failed })
        {
            var failedApp = last.Apps.FirstOrDefault(a => a.Status == ProjectDeliveryResultStatus.Failed);
            var sentence = failedApp is null ? "." : $" on {failedApp.AppName}.";
            // The apps before the failure did install, so the environment is on a mix of
            // versions; say which went in rather than leave "failed" to imply none did.
            var installed = last.Apps.Where(a => a.Status == ProjectDeliveryResultStatus.Completed).ToList();
            if (failedApp is not null && installed.Count > 0)
            {
                sentence += " " + string.Join(", ", installed.Select(a => $"{a.AppName} {a.AppVersion}"))
                    + (installed.Count == 1 ? " was" : " were") + " installed before it.";
            }
            var reported = failedApp is null ? null : ReportedVersion(failedApp);
            var queuedTail = NextRelease is { } queued
                ? $" Deployment {queued.Number} is scheduled {WhenPhrase(queued.ScheduledFor)}."
                : "";
            var failedAt = LastWhen(last);
            var reportedLead = reported is null ? "" : " ";
            return new HealthView("failed", "circle-x", "Last deployment failed",
                @<text>Deployment @last.Number failed <Timestamp Value="@failedAt" Relative="true" />@sentence@reportedLead@reported@queuedTail</text>);
        }

        if (Proposals.FirstOrDefault() is { } waiting)
        {
            return new HealthView("draft", "user", "Waiting for approval",
                @<text>Deployment @waiting.Number (build #@waiting.ProjectBuildId) was prepared <Timestamp Value="@waiting.CreatedAt" Relative="true" /> and waits for approval under Deployments below. Nothing has been sent to "@EnvName".</text>);
        }

        if (NextRelease is { } next)
        {
            var sentence = $"Deployment {next.Number} installs into \"{EnvName}\" {WhenPhrase(next.ScheduledFor)}.";
            if (IsForceSync && _isProduction) sentence += " Force sync is on for this Production environment.";
            return new HealthView("queued", "clock", "Scheduled", Plain(sentence));
        }

        if (last is { Status: ProjectDeliveryStatus.Deployed })
        {
            var succeededAt = LastWhen(last);
            return new HealthView("succeeded", "circle-check", "Healthy",
                @<text>The last deployment succeeded <Timestamp Value="@succeededAt" Relative="true" />. Nothing is scheduled.</text>);
        }
        if (last is { Status: ProjectDeliveryStatus.HandedOff })
        {
            var handedAt = LastWhen(last);
            return new HealthView("handed", "send", "Handed to Business Central",
                @<text>Deployment @last.Number was handed to Business Central <Timestamp Value="@handedAt" Relative="true" />, to install with its own update. Nothing else is scheduled.</text>);
        }

        return new HealthView("none", "circle-dashed", "Nothing deployed yet",
            Plain($"This pipeline has not installed anything into \"{EnvName}\" yet."));
    }

    private static RenderFragment Plain(string text) => builder => builder.AddContent(0, text);

    /// <summary>
    /// What the environment has of the app that failed, and where that fact came from.
    /// A panel read still in the cache is Business Central's word after the run (a
    /// finished deployment clears the cache, so it is only there when someone read the
    /// environment since); otherwise the version the run itself read before it began.
    /// </summary>
    private RenderFragment? ReportedVersion(DeliveryAppRow failed)
    {
        var panel = _rp is null ? null : PanelCache.Get(_rp.ProjectId, _rp.ProjectEnvironmentId);
        var installed = panel?.InstalledApps.FirstOrDefault(a =>
            (Guid.TryParse(failed.AppId, out var id) && a.AppId == id)
            || string.Equals(a.Name, failed.AppName, StringComparison.OrdinalIgnoreCase));
        if (installed is not null)
        {
            var readAt = panel!.FetchedAtUtc;
            return @<text>The environment reports @installed.Name @installed.Version installed (<Timestamp Value="@readAt" Relative="true" />).</text>;
        }
        return failed.PreviousVersion is { } before
            ? Plain($"Before this deployment the environment had {failed.AppName} {before} installed.")
            : null;
    }

    /// <summary>
    /// The newest deployment that has started or finished. Cancelled ones count: they are
    /// what happened last. A prepared deployment that is waiting, or that was dismissed or
    /// replaced before anyone approved it, does not: it never was a deployment (#934).
    /// </summary>
    private DeliveryHistoryRow? LastRelease => _deliveries.FirstOrDefault(d =>
        !d.IsScheduled && !d.IsActive && !d.IsProposed && !d.IsDismissed);

    private DeliveryHistoryRow? NextRelease => _deliveries.Where(d => d.IsScheduled).MinBy(d => d.ScheduledFor);

    private static DateTime LastWhen(DeliveryHistoryRow d) => d.FinishedAt ?? d.StartedAt ?? d.CreatedAt;

    private string? DeliveryWindow
    {
        get
        {
            var env = _rp?.ProjectEnvironment;
            if (env?.UpdateWindowStart is not { } start || env.UpdateWindowEnd is not { } end) return null;
            return $"{start:HH\\:mm}-{end:HH\\:mm}";
        }
    }

    /// <summary>", 4 minutes ago" after the Business Central section's label; nothing when never read.</summary>
    private RenderFragment? MirrorAgeTail => MirrorAt is { } age
        ? @<text>, <Timestamp Value="@age" Relative="true" /></text>
        : null;

    /// <summary>When the stored mirror of the environment was last read.</summary>
    private DateTime? MirrorAt
    {
        get
        {
            var env = _rp?.ProjectEnvironment;
            if (env is null || env.FetchedAt == default) return null;
            return env.StatusFetchedAt is { } s && s > env.FetchedAt ? s : env.FetchedAt;
        }
    }

    private string EnvHealth => _rp?.ProjectEnvironment?.MissingSince is not null
        ? "No longer in Business Central"
        : BcEnvironmentStatus.StatusWord(_rp?.ProjectEnvironment?.Status);

    /// <summary>The mirrored next platform update, e.g. "28.3, 14 Oct"; "None scheduled" once read and empty; hidden if never read.</summary>
    private string? NextUpdate
    {
        get
        {
            var env = _rp?.ProjectEnvironment;
            if (env is null) return null;
            if (!string.IsNullOrWhiteSpace(env.BcNextUpdateVersion))
            {
                return env.BcNextUpdateDate is { } date
                    ? $"{env.BcNextUpdateVersion}, {Zone.Format(date, "d MMM")}"
                    : env.BcNextUpdateVersion;
            }
            return env.BcNextUpdateFetchedAt is not null ? "None scheduled" : null;
        }
    }

    // ── One deployment ───────────────────────────────────────────────────────────

    internal readonly record struct Look(string Tone, string Icon, bool Spin, string Word);

    /// <summary>A deployment's state in the sheet's vocabulary: tone (colour and keyline), glyph, the word.</summary>
    internal static Look DeliveryLook(string status) => status switch
    {
        ProjectDeliveryStatus.Proposed => new("draft", "user", false, "Waiting for approval"),
        ProjectDeliveryStatus.Scheduled => new("queued", "clock", false, "Scheduled"),
        ProjectDeliveryStatus.Claimed => new("running", "refresh-cw", true, "Claimed"),
        ProjectDeliveryStatus.Uploading => new("running", "refresh-cw", true, "Uploading"),
        ProjectDeliveryStatus.Installing => new("running", "refresh-cw", true, "Installing"),
        ProjectDeliveryStatus.Deployed => new("succeeded", "circle-check", false, "Deployed"),
        ProjectDeliveryStatus.Failed => new("failed", "circle-x", false, "Failed"),
        ProjectDeliveryStatus.Cancelled => new("cancelled", "x", false, "Cancelled"),
        ProjectDeliveryStatus.Dismissed => new("cancelled", "x", false, "Dismissed"),
        ProjectDeliveryStatus.HandedOff => new("handed", "send", false, "Handed to Business Central"),
        _ => new("queued", "clock", false, status),
    };

    /// <summary>
    /// A row's look. A dismissed prepared deployment says whether a person dismissed it or a
    /// newer build replaced it - read from the stored build id, never from the log.
    /// </summary>
    private static Look LookOf(DeliveryHistoryRow d) => d.IsDismissed && d.ReplacedByBuildId is not null
        ? new("cancelled", "x", false, "Replaced")
        : DeliveryLook(d.Status);

    /// <summary>
    /// What became of a dismissed prepared deployment, in one line: "Replaced by build #41
    /// before anyone approved it." or "Dismissed by K. Jensen: wrong branch". Built from
    /// the stored facts; null for every other deployment.
    /// </summary>
    private static string? DismissedLine(DeliveryHistoryRow d)
    {
        if (!d.IsDismissed) return null;
        if (d.ReplacedByBuildId is { } newer) return $"Replaced by build #{newer} before anyone approved it.";
        var who = d.CancelledByName ?? "someone";
        return string.IsNullOrWhiteSpace(d.DismissReason) ? $"Dismissed by {who}." : $"Dismissed by {who}: {d.DismissReason}";
    }

    /// <summary>
    /// An app's state. Every state gets its word, not only Failed: a Skipped app with
    /// the Failed app's glyph beside it read as a second failed install (#929).
    /// </summary>
    internal static Look AppLook(string status) => status switch
    {
        ProjectDeliveryResultStatus.Pending => new("pending", "circle-dashed", false, "Pending"),
        ProjectDeliveryResultStatus.Uploading => new("running", "refresh-cw", true, "Uploading"),
        ProjectDeliveryResultStatus.Installing => new("running", "refresh-cw", true, "Installing"),
        ProjectDeliveryResultStatus.Scheduled => new("queued", "clock", false, "Scheduled"),
        ProjectDeliveryResultStatus.Completed => new("succeeded", "circle-check", false, "Completed"),
        ProjectDeliveryResultStatus.Failed => new("failed", "circle-x", false, "Failed"),
        ProjectDeliveryResultStatus.Skipped => new("skipped", "circle-minus", false, "Skipped"),
        ProjectDeliveryResultStatus.Unconfirmed => new("queued", "circle-alert", false, "Not confirmed"),
        _ => new("pending", "circle-dashed", false, status),
    };

    private static string GlyphClass(Look look) =>
        $"data-table__state data-table__state--icon rp-glyph rp-tone--{look.Tone}{(look.Spin ? " data-table__state--spin" : "")}";

    private static string BuildLine(DeliveryHistoryRow d) =>
        !string.IsNullOrWhiteSpace(d.BuildReleaseTag) ? $"Build #{d.ProjectBuildId} from GitHub release {d.BuildReleaseTag}"
        : !string.IsNullOrWhiteSpace(d.BuildBranch) ? $"Build #{d.ProjectBuildId} from {d.BuildBranch}"
        : $"Build #{d.ProjectBuildId}";

    /// <summary>
    /// The phone layout's second line, which carries what the hidden columns do. The
    /// markup leads with when (a Timestamp); this is the rest, took and apps.
    /// </summary>
    private string CompactTail(DeliveryHistoryRow d) =>
        string.Concat(new[] { Took(d), AppsSummary(d) }.Where(s => !string.IsNullOrEmpty(s)).Select(s => " - " + s));

    private static DateTime? StartOf(DeliveryHistoryRow d) => d.ClaimedAt ?? d.StartedAt;


    private static string? Took(DeliveryHistoryRow d) =>
        d.FinishedAt is { } end && (StartOf(d) ?? (d.Status is ProjectDeliveryStatus.Cancelled or ProjectDeliveryStatus.Dismissed ? null : d.CreatedAt)) is { } start
            ? Duration(end - start)
            : d.IsActive && StartOf(d) is { } running ? Duration(DateTime.UtcNow - running) : null;

    private static string AppsSummary(DeliveryHistoryRow d)
    {
        var n = d.Apps.Count;
        var done = d.Apps.Count(a => a.Status == ProjectDeliveryResultStatus.Completed);
        string Apps(int k) => k == 1 ? "1 app" : $"{k} apps";
        return d.Status switch
        {
            ProjectDeliveryStatus.Scheduled => $"{Apps(n)} pending",
            ProjectDeliveryStatus.HandedOff => $"{n} handed over",
            ProjectDeliveryStatus.Cancelled when IsMoved(d) => "Moved",
            ProjectDeliveryStatus.Cancelled => done == 0 ? "None installed" : $"{done} of {n} installed",
            ProjectDeliveryStatus.Dismissed => "None sent",
            ProjectDeliveryStatus.Claimed or ProjectDeliveryStatus.Uploading or ProjectDeliveryStatus.Installing
                => $"App {Math.Min(n, done + 1)} of {n}",
            _ => $"{done} of {n} installed",
        };
    }

    private string RunningSentence(DeliveryHistoryRow d)
    {
        var current = d.Apps.FirstOrDefault(a => a.Status is ProjectDeliveryResultStatus.Uploading or ProjectDeliveryResultStatus.Installing);
        if (current is null) return "Connecting to the environment.";
        var index = d.Apps.ToList().IndexOf(current) + 1;
        var verb = current.Status == ProjectDeliveryResultStatus.Uploading ? "Uploading" : "Installing";
        return $"{verb} {current.AppName}, app {index} of {d.Apps.Count}.";
    }

    /// <summary>The sentence a deployment that did not fail opens with, when it has one worth saying.</summary>
    private string? InfoSentence(DeliveryHistoryRow d)
    {
        switch (d.Status)
        {
            case ProjectDeliveryStatus.Dismissed:
                return $"{DismissedLine(d)!.TrimEnd('.')}. Nothing was sent.";
            case ProjectDeliveryStatus.Cancelled when IsMoved(d):
                // Only a move cancels a run after its upload (#1097): Business Central's copy
                // was cancelled and a newer deployment of the same build took its place.
                return d.CancelledByName is { } mover
                    ? $"Moved by {mover}: Business Central's copy was cancelled, and a new deployment of the same build replaces it."
                    : "Moved: Business Central's copy was cancelled, and a new deployment of the same build replaces it.";
            case ProjectDeliveryStatus.Cancelled:
                return d.CancelledByName is { } who
                    ? $"Cancelled by {who} before it started. No app was uploaded."
                    : "Cancelled before it started. No app was uploaded.";
            case ProjectDeliveryStatus.HandedOff:
                return MayStillBeHeld(d)
                    ? "Business Central has the apps and installs them with the customer's next update. Reschedule moves it to another time."
                    : "Business Central has the apps and installs them with the customer's next update. Cancel it there if you need to stop it.";
            case ProjectDeliveryStatus.Scheduled:
            {
                var sentence = $"Installs {WhenPhrase(d.ScheduledFor)}";
                sentence += d.ScheduledOutsideWindow ? ", outside the environment's delivery window." : ".";
                if (BcSyncMode.Normalize(d.SchemaSyncMode) == BcSyncMode.ForceSync)
                {
                    sentence += " Force sync is on: if this build removes tables or fields, their data is deleted.";
                }
                return sentence;
            }
            case ProjectDeliveryStatus.Claimed or ProjectDeliveryStatus.Uploading or ProjectDeliveryStatus.Installing:
                return RunningSentence(d);
            default:
                return null;
        }
    }

    internal sealed record StepView(string Label, string Tone, string At, string? Exact, string Took);

    /// <summary>
    /// The step strip. Only the steps whose moments were recorded are drawn: an old
    /// deployment has no "uploaded" moment, and a scheduled one has not reached the rest,
    /// which show as pending rather than invented.
    /// </summary>
    private List<StepView> Steps(DeliveryHistoryRow d)
    {
        if (d.IsDismissed)
        {
            var prepared = new List<StepView> { new("Prepared", "queued", When(d.CreatedAt, seconds: true), Exact(d.CreatedAt), "from a new build") };
            if (d.FinishedAt is { } endedAt)
            {
                var word = LookOf(d).Word;
                prepared.Add(new(word, "cancelled", Clock(endedAt), Exact(endedAt),
                    word == "Dismissed" && d.CancelledByName is { } dismisser ? $"by {dismisser}" : ""));
            }
            return prepared;
        }

        var steps = new List<StepView>
        {
            new("Scheduled", "queued", When(d.ScheduledFor, seconds: true), Exact(d.ScheduledFor),
                d.DeployedWithoutApproval
                    ? (d.TriggeredByName is { } runsAs ? $"automatically after a new build (no approval), set up by {runsAs}" : "automatically after a new build (no approval)")
                    : d.TriggeredByName is { } by ? $"by {by}" : ""),
        };

        if (d.Status == ProjectDeliveryStatus.Cancelled)
        {
            // A moved run had reached Business Central first, so its upload stays on the timeline.
            if (IsMoved(d) && d.InstallStartedAt is { } handedAt)
            {
                steps.Add(new("Uploaded", "running", Clock(handedAt), Exact(handedAt), ""));
            }
            if (d.FinishedAt is { } cancelledAt)
            {
                steps.Add(new(IsMoved(d) ? "Moved" : "Cancelled", "cancelled", Clock(cancelledAt), Exact(cancelledAt),
                    d.CancelledByName is { } who ? $"by {who}" : ""));
            }
            return steps;
        }

        if (d.ClaimedAt is { } claimed)
        {
            var wait = claimed - d.ScheduledFor;
            steps.Add(new("Claimed", "running", Clock(claimed), Exact(claimed),
                wait > TimeSpan.FromSeconds(1) ? $"after {(wait.TotalSeconds < 60 ? $"{(int)wait.TotalSeconds}s" : Duration(wait))}" : ""));
        }
        else if (d.IsScheduled)
        {
            steps.Add(new("Claim", "pending", "-", null, ""));
        }

        if (d.InstallStartedAt is { } uploaded)
        {
            steps.Add(new(d.Apps.Count > 1 ? "First app uploaded" : "Uploaded", "running", Clock(uploaded), Exact(uploaded),
                (d.StartedAt ?? d.ClaimedAt) is { } from ? Duration(uploaded - from) : ""));
        }
        else if (d.IsScheduled || (d.IsActive && d.InstallStartedAt is null && d.DeploymentSchedule == BcDeploymentSchedule.Immediate))
        {
            steps.Add(new("Upload", "pending", "-", null, ""));
        }

        if (d.IsScheduled || d.IsActive)
        {
            steps.Add(new("Install", "pending", "-", null, ""));
            return steps;
        }

        if (d.FinishedAt is { } end)
        {
            var from = d.InstallStartedAt ?? d.StartedAt;
            var word = DeliveryLook(d.Status);
            var stepLabel = d.Status switch
            {
                ProjectDeliveryStatus.Deployed => "Installed",
                ProjectDeliveryStatus.HandedOff => "Handed over",
                _ => d.InstallStartedAt is not null ? "Installing failed" : null,
            };
            if (stepLabel is not null && from is { } began)
            {
                steps.Add(new(stepLabel, word.Tone, Clock(end), Exact(end), Duration(end - began)));
            }
            var totalFrom = d.ClaimedAt ?? d.StartedAt;
            steps.Add(new(word.Word, word.Tone, Clock(end), Exact(end),
                totalFrom is { } t ? $"total {Duration(end - t)}" : ""));
        }
        return steps;
    }

    /// <summary>"2.2.0.104 to 2.3.0.118" when the previous version was recorded; the new version alone when it was not.</summary>
    private static string AppVersionText(DeliveryAppRow a)
    {
        if (a.PreviousVersion is not { } before) return a.AppVersion;
        if (a.Status == ProjectDeliveryResultStatus.Skipped) return $"{before}, not changed";
        if (string.Equals(before, a.AppVersion, StringComparison.OrdinalIgnoreCase)) return $"{a.AppVersion}, already installed";
        return $"{before} to {a.AppVersion}";
    }

    private static string? AppTook(DeliveryAppRow a) =>
        a.StartedAt is { } s && a.FinishedAt is { } f ? Duration(f - s) : null;

    /// <summary>
    /// The line under an app. For a Skipped app it says why (#929's comment): "because
    /// it depends on X" only when the build's manifests show it does, else "after X
    /// failed", which is true either way.
    /// </summary>
    private string? AppMessage(DeliveryHistoryRow d, DeliveryAppRow a, int ordering)
    {
        switch (a.Status)
        {
            case ProjectDeliveryResultStatus.Skipped:
            {
                _skipReasons.TryGetValue(d.Id, out var reasons);
                var failed = d.Apps.FirstOrDefault(x => x.Status == ProjectDeliveryResultStatus.Failed);
                if (reasons?.DependentOrderings is { } dependents && dependents.Contains(ordering))
                {
                    return $"Skipped because it depends on {reasons.FailedAppName} {reasons.FailedAppVersion}.";
                }
                // The run's own reason, when it gave one: "Already on 2.3.0.118." (#931).
                if (!string.IsNullOrWhiteSpace(a.Message)) return a.Message;
                return failed is not null
                    ? $"Skipped after {failed.AppName} failed."
                    : "Not attempted: the deployment stopped before this app.";
            }
            case ProjectDeliveryResultStatus.Scheduled:
                return a.Message ?? "Business Central installs it with its own update.";
            case ProjectDeliveryResultStatus.Failed when Failure(d) is { } failure:
                // "What happened" above already carries why; the app says where it was
                // left, so the deployment and the app never say the same thing twice (#930).
                return failure.FromBusinessCentral
                    ? a.PreviousVersion is { } still ? $"Not installed. Still on {still}." : "Not installed."
                    : null;
            default:
                return string.IsNullOrWhiteSpace(a.Message) ? null : a.Message;
        }
    }

    /// <param name="Collapsed">The short line on the closed row: "Business Central refused a schema change".</param>
    /// <param name="Code">Business Central's error code, drawn as a tag beside it; null when there is none.</param>
    /// <param name="WhatHappened">The opening of the expanded failure, naming the app.</param>
    /// <param name="BcMessage">Business Central's own message, as given; null when the failure was ours.</param>
    /// <param name="NextStep">What to do about it; null when the failure was ours and already says.</param>
    /// <param name="Raw">The text Business Central sent, for support; null when the failure was ours.</param>
    /// <param name="FailedApp">The app that failed, when one did.</param>
    /// <param name="FromBusinessCentral">True when Business Central reported the failure, rather than the run refusing to go on.</param>
    /// <param name="Clipped">True when only the start of the message was stored (deployments before #930 were cut at 300 characters).</param>
    internal sealed record FailureView(
        string Collapsed, string? Code, string WhatHappened, string? BcMessage, string? NextStep,
        string? Raw, DeliveryAppRow? FailedApp, bool FromBusinessCentral, bool Clipped = false);

    /// <summary>
    /// A failed deployment's text, taken apart for the page (#930). Business Central's
    /// response is read back from the log line the run wrote for the failed app, which
    /// keeps it whole; a deployment stored before #930 has only the long line it kept as its
    /// failure message, and goes through the same parser so it reads the same way. A
    /// failure the run raised itself (the environment was busy, the build changed) is
    /// shown as the run wrote it.
    /// </summary>
    private FailureView? Failure(DeliveryHistoryRow d)
    {
        if (d.Status != ProjectDeliveryStatus.Failed) return null;

        var failedApp = d.Apps.FirstOrDefault(a => a.Status == ProjectDeliveryResultStatus.Failed);
        var label = failedApp is null ? null : $"{failedApp.AppName} {failedApp.AppVersion}";

        string? raw = null;
        if (label is not null)
        {
            var marker = $"FAILED {label}: ";
            raw = LogLines(d).LastOrDefault(l => l.Message.StartsWith(marker, StringComparison.Ordinal))?.Message[marker.Length..];
        }
        var stored = string.IsNullOrWhiteSpace(d.FailureMessage) ? null : d.FailureMessage.Trim();
        var parsed = BcFailureText.Parse(raw);
        // Before #930 both the log line and the stored failure were clipped; whichever kept
        // more of Business Central's message is the one to show.
        if ((!parsed.FromBusinessCentral || parsed.Truncated) && stored is not null)
        {
            // Before #930 the deployment kept "{app} {version} failed: " and the whole response.
            var legacy = label is not null && stored.StartsWith($"{label} failed: ", StringComparison.Ordinal)
                ? stored[$"{label} failed: ".Length..]
                : stored;
            var fromStored = BcFailureText.Parse(legacy);
            if (fromStored.FromBusinessCentral
                && (!parsed.FromBusinessCentral || fromStored.Message.Length > parsed.Message.Length))
            {
                parsed = fromStored;
                raw = legacy;
            }
        }

        if (!parsed.FromBusinessCentral)
        {
            var ours = stored ?? failedApp?.Message ?? "The deployment failed.";
            return new FailureView(ours, null, ours, null, null, null, failedApp, false);
        }

        var code = parsed.Code.Length > 0 ? parsed.Code : null;
        var response = raw is null ? null : BcFailureText.WithoutRunPrefix(raw).Trim();
        var said = string.Join(" ", new[] { parsed.Message, parsed.InnerMessage }.Where(s => s.Length > 0));
        if (parsed.Truncated && said.Length > 0) said += "...";
        return new FailureView(
            BcFailureText.Summary(code),
            code,
            BcFailureText.WhatHappened(code, label ?? "the app"),
            said.Length > 0 ? said : null,
            BcFailureText.NextStep(code, d.EnvironmentName, BcSyncMode.Normalize(d.SchemaSyncMode) == BcSyncMode.ForceSync),
            // A clipped response adds nothing to the quote above, so there is no fold for it.
            string.IsNullOrEmpty(response) || parsed.Truncated ? null : response,
            failedApp,
            true,
            parsed.Truncated);
    }

    /// <summary>
    /// What "Copy for support" copies: which deployment, where and when, then Business
    /// Central's response as it came. Shown as it is copied, so nothing hidden travels.
    /// </summary>
    private string SupportText(DeliveryHistoryRow d, string raw)
    {
        var when = d.FinishedAt ?? d.StartedAt ?? d.CreatedAt;
        // In UTC on purpose: this is pasted into a ticket for someone in another zone.
        return $"Deployment {d.Number} of \"{_rp?.Name}\" into \"{d.EnvironmentName}\", failed {Zone.UtcTooltip(when)}\n{raw}";
    }

    internal sealed record LogLine(string Time, string Message, bool Error);

    private static readonly Regex LogLinePattern = new(@"^(\d{2}:\d{2}:\d{2})\s{1,2}(.*)$", RegexOptions.Compiled);

    /// <summary>
    /// The stored log is <c>HH:mm:ss  message</c> lines; the time goes in its own column.
    /// A line the run wrote about a failure is tinted, keyed on the words the run itself
    /// writes ("FAILED", "Delivery failed"), not on anything Business Central said.
    /// </summary>
    private static List<LogLine> LogLines(DeliveryHistoryRow d)
    {
        if (string.IsNullOrWhiteSpace(d.DiagnosticsLog)) return [];
        return d.DiagnosticsLog
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.TrimEnd('\r'))
            .Where(l => l.Length > 0)
            .Select(l =>
            {
                var m = LogLinePattern.Match(l);
                var time = m.Success ? m.Groups[1].Value : "";
                var message = m.Success ? m.Groups[2].Value : l;
                var error = message.StartsWith("FAILED", StringComparison.Ordinal)
                            || message.StartsWith("Delivery failed", StringComparison.Ordinal);
                return new LogLine(time, message, error);
            })
            .ToList();
    }

    // ── Time ──────────────────────────────────────────────────────────────────

    // Instants on this page are shown in the organisation's display zone (#942), with the
    // exact UTC instant as the hover title (Exact). "Today 02:00" has no Timestamp format,
    // so these go through the same zone service the component uses. The two things that
    // stay in the solution's own zone are the delivery window (a time of day agreed with
    // the customer) and the reschedule picker, which says so beside it.

    /// <summary>Whole days between the instant and today, both counted in the display zone.</summary>
    private int DaysFromToday(DateTime utc) =>
        (Zone.ToDisplay(utc).Date - Zone.ToDisplay(DateTime.UtcNow).Date).Days;

    /// <summary>"Today 02:00", "Yesterday 15:02", "Tomorrow 22:00", else "20 Sep 11:40".</summary>
    private string When(DateTime utc, bool seconds = false)
    {
        var time = Zone.Format(utc, seconds ? "HH:mm:ss" : "HH:mm");
        return DaysFromToday(utc) switch
        {
            0 => $"Today {time}",
            -1 => $"Yesterday {time}",
            1 => $"Tomorrow {time}",
            _ => $"{Zone.Format(utc, "d MMM")} {time}",
        };
    }

    /// <summary>The same moment inside a sentence: "today at 22:00", "on 20 Sep at 11:40".</summary>
    private string WhenPhrase(DateTime utc)
    {
        var time = Zone.Format(utc, "HH:mm");
        return DaysFromToday(utc) switch
        {
            0 => $"today at {time}",
            -1 => $"yesterday at {time}",
            1 => $"tomorrow at {time}",
            _ => $"on {Zone.Format(utc, "d MMM")} at {time}",
        };
    }

    private string Clock(DateTime utc) => Zone.Format(utc, "HH:mm:ss");

    /// <summary>The hover title behind a time: the exact instant in UTC, as every Timestamp has.</summary>
    private string Exact(DateTime utc) => Zone.UtcTooltip(utc);

    /// <summary>The scheduled time, e.g. "2026-07-01 22:00", for the cancel confirmation.</summary>
    private string ScheduledWhen(DeliveryHistoryRow d) => Zone.Format(d.ScheduledFor, "yyyy-MM-dd HH:mm");

    /// <summary>"3m 32s", "0m 48s", "1h 05m" - the sheet's durations.</summary>
    internal static string Duration(TimeSpan span)
    {
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}h {span.Minutes:00}m"
            : $"{(int)span.TotalMinutes}m {span.Seconds:00}s";
    }

    /// <summary>A repository's web address from its clone URL, for the source link.</summary>
    private static string RepositoryWebUrl(string url) =>
        url.EndsWith(".git", StringComparison.OrdinalIgnoreCase) ? url[..^4] : url;
}
