@*
    The Password card of the account page's Security section. A member of an
    organisation that only allows Microsoft sign-in has no password to change
    (the server refuses it too, #1455), so they get a line saying how they sign
    in instead of a form they can only fail.
*@

<section class="card">
    <div class="card__head">
        <div>
            <h2 class="card__title">Password</h2>
            @if (PasswordSignInDisabled)
            {
                <p class="card__sub">
                    Your organisation signs in with Microsoft, so there is no password to change.
                    Use "Sign in with Microsoft" on the login page.
                </p>
            }
            else
            {
                <p class="card__sub">A long phrase you'll remember is stronger than a short, complicated one.</p>
            }
        </div>
    </div>
    @if (!PasswordSignInDisabled)
    {
        <form method="post" action="/auth/account/password">
            <AntiforgeryToken />
            <div class="card__body">
                <div class="form-grid">
                    <label class="field">
                        <span class="field__label">Current password</span>
                        <input class="input" type="password" name="CurrentPassword" required
                               autocomplete="current-password" placeholder="Enter your current password" />
                    </label>
                    <label class="field">
                        <span class="field__label">New password</span>
                        <input class="input" type="password" name="NewPassword" required minlength="12"
                               autocomplete="new-password" placeholder="Choose a new password" />
                        <span class="field__hint">Use at least 12 characters.</span>
                    </label>
                </div>
            </div>
            <div class="card__foot">
                <span class="form-actions__note">You'll stay signed in on this device.</span>
                <button type="submit" class="btn btn--primary">
                    <Icon Name="lock" Width="16" Height="16" />
                    <span>Update password</span>
                </button>
            </div>
        </form>
    }
</section>

@code {
    /// <summary>
    /// True when the signed-in person's organisation refuses password sign-in
    /// and they are not a SiteAdmin, the rule <c>AuthService.IsLocalLoginDisabledAsync</c> applies.
    /// </summary>
    [Parameter] public bool PasswordSignInDisabled { get; set; }
}
