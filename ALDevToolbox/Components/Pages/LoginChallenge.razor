@page "/login/challenge"
@layout ALDevToolbox.Components.Layout.AuthLayout
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Endpoints
@using Microsoft.AspNetCore.DataProtection
@inject IHttpContextAccessor Http
@inject IDataProtectionProvider Protection
@inject TimeProvider Clock
@inject ALDevToolbox.Services.Account.WebAuthnConfig WebAuthn
@inject ALDevToolbox.Services.Tools.ToolEnablement Tools

<PageTitle>@(_state?.StepUp == true ? "Confirm it's you" : "Verify it's you") · AL Workbench</PageTitle>

@*
    The second factor, on the auth-card archetype.

    Three stacked <details> accordions became a .pill-tabs strip over one form.
    The accordions were a mechanic: every method was on screen at once, each
    behind a disclosure triangle, and which one started open was decided by a
    query parameter the reader could not see. The tabs carry that same ?method=
    in a control that says what it does, and only the chosen method's fields
    render - which is also what lets the field keep autofocus.

    The page-scoped <style> block it used to carry is gone with them; nothing
    here needs a rule the design layer does not already have.
*@

@if (_state is null && _signedIn)
{
    @* A signed-in person whose step-up state lapsed, or who came back to
       this address later. They never signed out, so don't tell them to sign
       in again: opening the tool starts a fresh confirmation. *@
    <AuthCard Title="That took too long">
        <Sub>Open the tool again and you'll be asked to confirm.</Sub>
        <ChildContent>
            <a class="btn btn--primary" href="/" style="height: var(--control-h-lg)">
                <Icon Name="arrow-left" Width="16" Height="16" />
                <span>Back to the workbench</span>
            </a>
        </ChildContent>
    </AuthCard>
}
else if (_state is null)
{
    @* Its own card: the old one kept the title "Verify it's you" over a
       message saying you no longer can, said the same thing twice, and left
       12px of foot text reading "Cancel and sign in again" as the only exit —
       a strange label when there is nothing left to cancel. *@
    <AuthCard Title="That took too long">
        <Sub>The verification step only stays open for a few minutes.</Sub>
        <ChildContent>
            <a class="btn btn--primary" href="/login" style="height: var(--control-h-lg)">
                <Icon Name="log-in" Width="16" Height="16" />
                <span>Sign in again</span>
            </a>
        </ChildContent>
    </AuthCard>
}
else if (_state.StepUp && _methods.Count == 0 && !_state.PasskeyAvailable && !_state.EntraAvailable)
{
    @* A signed-in person with nothing to confirm with. The tool stays closed
       until they set something up; say so, and take them there. *@
    <AuthCard Title="Set up two-factor sign-in first">
        <Sub>
            Your organisation asks people to confirm it's them before using this tool, and
            your account has no way to do that yet. Add an authenticator app@(string.IsNullOrEmpty(WebAuthn.RpId) ? " or email codes" : ", email codes or a passkey")
            under Sign-in &amp; security on your account, then open the tool again.
        </Sub>
        <ChildContent>
            <a class="btn btn--primary" href="/account?section=security" style="height: var(--control-h-lg)">
                <Icon Name="shield" Width="16" Height="16" />
                <span>Go to Sign-in &amp; security</span>
            </a>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/">Back to the workbench</a>
        </Foot>
    </AuthCard>
}
else
{
<AuthCard Title="@(_state.StepUp ? "Confirm it's you" : "Verify it's you")">
    <Sub>
        @if (_state.StepUp)
        {
            <text>The tool you opened asks you to confirm it's you first. We'll take you straight back, and you won't be asked again for the next @_windowMinutes minutes.</text>
        }
        else
        {
            <text>One more step: enter a code to finish signing in.</text>
        }
    </Sub>
    <Alerts>
        @{
            @if (!string.IsNullOrEmpty(Error))
            {
                <Alert Tone="AlertTone.Danger">
                    <span>@ErrorText(Error)</span>
                </Alert>
            }
            @if (Ok == "sent")
            {
                <Alert Tone="AlertTone.Success">
                    <span>Code sent. It's good for a few minutes.</span>
                </Alert>
            }
        }
    </Alerts>
    <ChildContent>
        @{
            @* Step-up only: the two ceremonies that are not a typed code, above
               the code tabs. A passkey with user verification, or a fresh
               Microsoft sign-in. *@
            @* One primary per card: the passkey when there is one, else
               Microsoft, else the code form's own button. *@
            @if (_state.StepUp && _state.PasskeyAvailable)
            {
                <StepUpPasskeyButton Primary="true" HasOtherWays="@(_methods.Count > 0 || _state.EntraAvailable)" />
            }
            @if (_state.StepUp && _state.EntraAvailable)
            {
                <form method="post" action="/auth/step-up/entra">
                    <AntiforgeryToken />
                    <button type="submit" class="btn @(_state.PasskeyAvailable ? "" : "btn--primary")" style="height: var(--control-h-lg); width: 100%">
                        <Icon Name="log-in" Width="16" Height="16" />
                        <span>Confirm with Microsoft</span>
                    </button>
                </form>
            }
            @if (_state.StepUp && _methods.Count > 0 && (_state.PasskeyAvailable || _state.EntraAvailable))
            {
                <span class="auth__or">or enter a code</span>
            }

            @if (_methods.Count > 1)
            {
                <span class="pill-tabs" role="tablist" aria-label="Verification method">
                    @foreach (var (key, label) in _methods)
                    {
                        <a class="pill-tab @(key == _method ? "is-active" : "")" role="tab"
                           aria-selected="@(key == _method ? "true" : "false")"
                           href="@($"/login/challenge?method={key}")">@label</a>
                    }
                </span>
            }

            @if (_method == "email")
            {
                @if (Ok != "sent")
                {
                    @* Nothing has been sent yet, so asking for the code IS the
                       primary action. Leading with an empty field and a Verify
                       button made the main action impossible until you found
                       the outline button under a divider. *@
                    <form method="post" action="/auth/login/challenge/email/issue">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg); width: 100%">
                            <Icon Name="mail" Width="16" Height="16" />
                            <span>Email me a code</span>
                        </button>
                    </form>
                }
                <form method="post" action="/auth/login/challenge/email/verify" class="auth__fields">
                    <AntiforgeryToken />
                    <div class="field">
                        <label class="field__label" for="email-code">Six-digit code from your email</label>
                        <input class="input" id="email-code" type="text" name="Code" inputmode="numeric"
                               pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code"
                               placeholder="123456" autofocus="@(Ok == "sent")" />
                    </div>
                    <button type="submit" class="btn @(Ok == "sent" && !_ceremonyIsPrimary ? "btn--primary" : "")"
                            style="@(Ok == "sent" ? "height: var(--control-h-lg)" : "")">@VerifyLabel</button>
                </form>
                @if (Ok == "sent")
                {
                    <form method="post" action="/auth/login/challenge/email/issue">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn--sm" style="width: 100%">Send another code</button>
                    </form>
                }
            }
            else if (_method == "recovery")
            {
                <form method="post" action="/auth/login/challenge/recovery" class="auth__fields">
                    <AntiforgeryToken />
                    <div class="field">
                        <label class="field__label" for="rec">One of your recovery codes</label>
                        <input class="input" id="rec" type="text" name="Code" required maxlength="11"
                               autocomplete="off" placeholder="XXXXX-XXXXX" autofocus />
                        <span class="field__hint">One of the codes you saved when you turned on two-factor sign-in. Each works once.</span>
                    </div>
                    <button type="submit" class="btn @(_ceremonyIsPrimary ? "" : "btn--primary")" style="height: var(--control-h-lg)">@VerifyLabel</button>
                </form>
            }
            else if (_methods.Count > 0)
            {
                <form method="post" action="/auth/login/challenge/totp" class="auth__fields">
                    <AntiforgeryToken />
                    <div class="field">
                        <label class="field__label" for="totp">Six-digit code from your authenticator app</label>
                        <input class="input" id="totp" type="text" name="Code" inputmode="numeric"
                               pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code"
                               placeholder="123456" autofocus />
                    </div>
                    <button type="submit" class="btn @(_ceremonyIsPrimary ? "" : "btn--primary")" style="height: var(--control-h-lg)">@VerifyLabel</button>
                </form>
            }
        }
    </ChildContent>
    <Foot>
        @if (_state.StepUp)
        {
            <a class="auth__link" href="/">Not now, back to the workbench</a>
        }
        else
        {
            <a class="auth__link" href="/login">Cancel and sign in again</a>
        }
    </Foot>
</AuthCard>
}

@code {
    [SupplyParameterFromQuery(Name = "method")] public string? Method { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private EndpointHelpers.MfaPending? _state;
    private List<(string Key, string Label)> _methods = new();
    private string _method = "totp";
    private bool _signedIn;
    // Step-up with a passkey or Microsoft on offer: that button is the
    // primary, and the code forms' buttons step down to outline.
    private bool _ceremonyIsPrimary;

    private int _windowMinutes = (int)ALDevToolbox.Services.Account.StepUpAuth.DefaultWindow.TotalMinutes;
    private string VerifyLabel => _state?.StepUp == true ? "Confirm" : "Verify";

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        if (ctx is null) return;
        _signedIn = ctx.User?.Identity?.IsAuthenticated == true;
        _state = EndpointHelpers.ReadMfaPendingCookie(ctx, Protection, Clock);
        if (_state is null) return;
        if (_state.StepUp) _windowMinutes = (int)(await Tools.StepUpWindowAsync()).TotalMinutes;
        _ceremonyIsPrimary = _state.StepUp && (_state.PasskeyAvailable || _state.EntraAvailable);

        // Recovery codes are issued with TOTP, so they ride on the same flag.
        if (_state.TotpEnabled) _methods.Add(("totp", "Authenticator app"));
        if (_state.EmailMfaEnabled) _methods.Add(("email", "Email code"));
        if (_state.TotpEnabled) _methods.Add(("recovery", "Recovery code"));

        // Fall back to whatever the account actually has rather than trusting
        // the query string: ?method=email on an account without email MFA would
        // otherwise render a form its endpoint refuses.
        _method = _methods.Any(m => m.Key == Method)
            ? Method!
            : _methods.FirstOrDefault().Key ?? "totp";
    }

    /// <summary>True when something other than the email code is available.</summary>
    private bool HasAnotherWayIn => _state?.TotpEnabled == true;

    private string ErrorText(string err) => err switch
    {
        "invalid" => "That code wasn't valid. Try again.",
        "rate-limited" => "Too many codes requested. Wait a few minutes before asking for another.",
        "too-many-attempts" => "Too many incorrect attempts. Wait a few minutes and try again.",
        // Deliberately not one string: an account whose only second factor is
        // email has no authenticator app and no recovery codes, so telling it
        // to use them is a locked door with a sign pointing at another locked
        // door. The only real move is a person with admin rights.
        "not-configured" when !HasAnotherWayIn && _state?.StepUp == true =>
            "We can't send email codes right now, and email is the only way this account can confirm. "
            + "Ask your administrator to fix email sending, or add an authenticator app under Sign-in & security on your account.",
        "not-configured" when !HasAnotherWayIn =>
            "We can't send email codes right now, and email is the only second factor on this account. "
            + "Ask your administrator to set up email, or to switch off two-factor sign-in for you.",
        "not-configured" => "We can't send email codes right now. Use your authenticator app or a recovery code instead.",
        "entra-mismatch" => "That Microsoft sign-in didn't match your account. Sign in with the Microsoft account connected to it.",
        "entra-unavailable" => "Microsoft sign-in isn't available right now. Use another way to confirm.",
        _ => "Something went wrong. Try again.",
    };
}
