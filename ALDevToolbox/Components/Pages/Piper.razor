@page "/piper"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Piper · AL Workbench</PageTitle>

<div class="page piper-page">
    <PageHead Title="Piper"
              Subtitle="Paste separated values and get back a piped string, a SQL list, or anything in between. Detection is automatic; everything is tweakable from the panel on the right." />

    <div class="piper-layout">
        <section class="piper-main">
            <nav class="pill-tabs" role="tablist" aria-label="Input mode">
                <button type="button"
                        class="pill-tab @(_mode == InputMode.Text ? "is-active" : "")"
                        role="tab" aria-selected="@(_mode == InputMode.Text ? "true" : "false")"
                        aria-keyshortcuts="Alt+1"
                        title="Alt+1"
                        @onclick="() => SetMode(InputMode.Text)">
                    <Icon Name="type" Width="14" Height="14" />
                    <span>Text</span>
                </button>
                <button type="button"
                        class="pill-tab @(_mode == InputMode.Table ? "is-active" : "")"
                        role="tab" aria-selected="@(_mode == InputMode.Table ? "true" : "false")"
                        aria-keyshortcuts="Alt+2"
                        title="Alt+2"
                        @onclick="() => SetMode(InputMode.Table)">
                    <Icon Name="table" Width="14" Height="14" />
                    <span>Table</span>
                </button>
            </nav>

            <div class="field">
                <label class="field__label" for="piper-input">Input</label>
                <textarea id="piper-input" rows="10" class="textarea"
                          placeholder="@_inputPlaceholder"
                          spellcheck="false"
                          @ref="_inputRef"></textarea>
                <p class="field__hint piper-meta">@_inputMetaText</p>
            </div>

            @if (_mode == InputMode.Table)
            {
                <div class="field">
                    <label class="field__label" for="piper-table-sep">Cell separator</label>
                    <SelectBox>
                        <select id="piper-table-sep" class="select" @bind="TableSeparatorKey">
                            <option value="tab">Tab</option>
                            <option value="comma">Comma</option>
                            <option value="semicolon">Semicolon</option>
                            <option value="pipe">Pipe</option>
                        </select>
                    </SelectBox>
                </div>
                <label class="check">
                    <input type="checkbox" @bind="TableHasHeaders" />
                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                    <span>First row is headers</span>
                </label>

                @if (_table is not null)
                {
                    <div class="field">
                        <label class="field__label" for="piper-column">Column</label>
                        <SelectBox>
                            <select id="piper-column" class="select" @bind="SelectedColumn">
                                @foreach (var header in _table.Headers)
                                {
                                    <option value="@header">@(string.IsNullOrEmpty(header) ? "(unnamed column)" : header)</option>
                                }
                            </select>
                        </SelectBox>
                    </div>
                }
            }

            <div class="field">
                <label class="field__label" for="piper-output">Result</label>
                <textarea id="piper-output" rows="3" class="textarea" readonly spellcheck="false">@_output</textarea>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn--primary"
                        @onclick="CopyAsync" disabled="@string.IsNullOrEmpty(_output)">
                    <Icon Name="copy" Width="14" Height="14" />
                    <span>@(_justCopied ? "Copied!" : "Copy result")</span>
                </button>
                <button type="button" class="btn" @onclick="SwapInputOutputAsync"
                        disabled="@string.IsNullOrEmpty(_output)"
                        title="Move the result back into the input box for chained transforms">
                    <Icon Name="arrow-up" Width="14" Height="14" />
                    <span>Use result as input</span>
                </button>
                <button type="button" class="btn" @onclick="ClearAllAsync">
                    <Icon Name="trash-2" Width="14" Height="14" />
                    <span>Clear both fields</span>
                </button>
            </div>
        </section>

        <aside class="card piper-settings">
            <div class="card__head">
                <h2 class="card__title">
                    <Icon Name="settings" Width="16" Height="16" />
                    <span>Settings</span>
                </h2>
            </div>
            <div class="card__body piper-settings__body">

            <div class="field">
                <label class="field__label" for="piper-format">Output format</label>
                <SelectBox>
                    <select id="piper-format" class="select" @bind="Format">
                        <option value="@PiperOutputFormat.BcOr">BC OR (a|b|c)</option>
                        <option value="@PiperOutputFormat.BcAnd">BC AND (&lt;&gt;a&amp;&lt;&gt;b&amp;&lt;&gt;c)</option>
                        <option value="@PiperOutputFormat.Sql">SQL ('a','b','c')</option>
                        <option value="@PiperOutputFormat.Custom">Custom...</option>
                    </select>
                </SelectBox>
            </div>

            @if (Format == PiperOutputFormat.Custom)
            {
                <div class="field">
                    <label class="field__label" for="piper-prefix">Item prefix</label>
                    <input id="piper-prefix" type="text" class="input" placeholder="e.g. ["
                           @bind="CustomPrefix" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field__label" for="piper-suffix">Item suffix</label>
                    <input id="piper-suffix" type="text" class="input" placeholder="e.g. ]"
                           @bind="CustomSuffix" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field__label" for="piper-join">Join with</label>
                    <input id="piper-join" type="text" class="input" placeholder="e.g. , or  → "
                           @bind="CustomJoin" @bind:event="oninput" />
                </div>
            }

            <div class="field">
                <label class="field__label" for="piper-wrap-prefix">Wrap result with</label>
                <div class="piper-wrap-row">
                    <input id="piper-wrap-prefix" type="text" class="input" placeholder="prefix, e.g. ("
                           @bind="ResultPrefix" @bind:event="oninput" />
                    <input id="piper-wrap-suffix" type="text" class="input" placeholder="suffix, e.g. )"
                           aria-label="Result suffix"
                           @bind="ResultSuffix" @bind:event="oninput" />
                </div>
            </div>

            @if (_mode == InputMode.Text)
            {
                <div class="field">
                    <label class="field__label" for="piper-sep">Input separator</label>
                    <input id="piper-sep" type="text" class="input" placeholder="@_separatorPlaceholder"
                           @bind="SeparatorOverride" @bind:event="oninput" />
                    <p class="field__hint piper-hint">
                        Use <code>\t</code>, <code>\n</code>, <code>\r</code> for whitespace.
                    </p>
                </div>
            }

            <div class="field">
                <label class="field__label" for="piper-sort">Sort items</label>
                <SelectBox>
                    <select id="piper-sort" class="select" @bind="Sort">
                        <option value="@PiperSortOrder.None">None (keep input order)</option>
                        <option value="@PiperSortOrder.Ascending">Ascending (A → Z, 1 → 9)</option>
                        <option value="@PiperSortOrder.Descending">Descending (Z → A, 9 → 1)</option>
                    </select>
                </SelectBox>
            </div>

            @if (_mode == InputMode.Text)
            {
                <label class="check">
                    <input type="checkbox" @bind="SplitOnNewlinesOnly" />
                    <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                    <span>Auto-detect: split on new lines only</span>
                </label>
            }
            <label class="check">
                <input type="checkbox" @bind="TrimItems" />
                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                <span>Trim whitespace around items</span>
            </label>
            <label class="check">
                <input type="checkbox" @bind="SkipEmpty" />
                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                <span>Skip empty items</span>
            </label>
            <label class="check">
                <input type="checkbox" @bind="RemoveDuplicates" />
                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                <span>Remove duplicate items</span>
            </label>
            </div>
        </aside>
    </div>
</div>

@code {
    // Heavy lifting (delimiter detection, format application, sort, escape
    // handling) lives in PiperTransform - see Services/PiperTransform.cs.
    // The @code block here is just Blazor plumbing: bindings, the JS
    // clipboard call, and the meta strings that aren't part of the
    // transform contract.

    private enum InputMode { Text, Table }

    private string _input = "";
    private string _output = "";
    private string _inputMetaText = "Awaiting input...";
    private string _separatorPlaceholder = DefaultSeparatorPlaceholder;
    private string _inputPlaceholder = TextPlaceholder;

    private PiperOptions _options = new();
    private InputMode _mode = InputMode.Text;
    private PiperTable? _table;
    private string? _selectedColumn;
    private string _tableSeparatorKey = "tab";
    private bool _tableHasHeaders = true;

    // <select> can't bind to a control character directly in Razor markup,
    // so the UI binds to a short key and we map to the actual separator
    // when calling ParseTable.
    private static readonly Dictionary<string, string> TableSeparators = new(StringComparer.Ordinal)
    {
        ["tab"] = "\t",
        ["comma"] = ",",
        ["semicolon"] = ";",
        ["pipe"] = "|",
    };

    private bool _justCopied;
    private CancellationTokenSource? _copyTimer;
    private ElementReference _inputRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Piper>? _selfRef;

    private const string DefaultSeparatorPlaceholder = "leave blank to auto-detect";
    private const string TextPlaceholder = "e.g. 1001, 1005, 1007 - or one value per line";
    private const string TablePlaceholder = "Paste rows from a list or CSV - one row per line, cells split by the selected separator";

    private string Input { get => _input; set { _input = value; Transform(); } }
    private PiperOutputFormat Format { get => _options.Format; set { _options = _options with { Format = value }; Transform(); } }
    private string CustomPrefix { get => _options.CustomPrefix; set { _options = _options with { CustomPrefix = value }; Transform(); } }
    private string CustomSuffix { get => _options.CustomSuffix; set { _options = _options with { CustomSuffix = value }; Transform(); } }
    private string CustomJoin { get => _options.CustomJoin; set { _options = _options with { CustomJoin = value }; Transform(); } }
    private string ResultPrefix { get => _options.ResultPrefix; set { _options = _options with { ResultPrefix = value }; Transform(); } }
    private string ResultSuffix { get => _options.ResultSuffix; set { _options = _options with { ResultSuffix = value }; Transform(); } }
    private string SeparatorOverride { get => _options.SeparatorOverride; set { _options = _options with { SeparatorOverride = value }; Transform(); } }
    private PiperSortOrder Sort { get => _options.Sort; set { _options = _options with { Sort = value }; Transform(); } }
    private bool SplitOnNewlinesOnly { get => _options.SplitOnNewlinesOnly; set { _options = _options with { SplitOnNewlinesOnly = value }; Transform(); } }
    private bool TrimItems { get => _options.TrimItems; set { _options = _options with { TrimItems = value }; Transform(); } }
    private bool SkipEmpty { get => _options.SkipEmpty; set { _options = _options with { SkipEmpty = value }; Transform(); } }
    private bool RemoveDuplicates { get => _options.RemoveDuplicates; set { _options = _options with { RemoveDuplicates = value }; Transform(); } }
    private string? SelectedColumn { get => _selectedColumn; set { _selectedColumn = value; Transform(); } }
    private string TableSeparatorKey { get => _tableSeparatorKey; set { _tableSeparatorKey = value; Transform(); } }
    private bool TableHasHeaders { get => _tableHasHeaders; set { _tableHasHeaders = value; Transform(); } }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Pages/Piper.razor.js");
        _selfRef = DotNetObjectReference.Create(this);
        // The input box reports its value through the module rather than a
        // bind: see OnLargeInputChanged for why.
        await _module.InvokeVoidAsync("init", _selfRef, _inputRef);

        // Restore the last-used input mode from localStorage. Done after the
        // first render so the SSR pass doesn't depend on per-browser state.
        try
        {
            var stored = await _module.InvokeAsync<string?>("readMode");
            if (!string.IsNullOrEmpty(stored)
                && Enum.TryParse<InputMode>(stored, ignoreCase: false, out var restored)
                && restored != _mode)
            {
                SetMode(restored);
                StateHasChanged();
            }
        }
        catch { /* storage unavailable - leave default mode */ }

        // Routes.razor's <FocusOnNavigate Selector="h1" /> announces the page
        // title for screen readers; once that's done, hand focus to the input
        // so a keyboard user can just start typing.
        try { await _inputRef.FocusAsync(); }
        catch { /* element gone - nothing to focus */ }
    }

    /// <summary>
    /// Entry point invoked from <c>Piper.razor.js</c> when the user presses
    /// <kbd>Alt+1</kbd> or <kbd>Alt+2</kbd> anywhere on the page (the JS
    /// handler listens at the document level so focus inside the textarea
    /// doesn't swallow the shortcut).
    /// </summary>
    [JSInvokable]
    public Task SetModeFromKeybind(string modeName)
    {
        if (Enum.TryParse<InputMode>(modeName, ignoreCase: false, out var mode))
        {
            SetMode(mode);
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    /// <summary>
    /// The input box's value, from <c>Piper.razor.js</c>, when it is short
    /// enough to travel as an ordinary call argument.
    /// </summary>
    [JSInvokable]
    public Task OnInputChanged(string value)
    {
        Input = value ?? string.Empty;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// The input box's value when it is too long for an ordinary call. A
    /// <c>@bind</c> sent the whole box as one SignalR message per keystroke, and
    /// the hub drops the connection on any message over 32 KB - so pasting a few
    /// thousand item numbers broke the page, and every keystroke after it
    /// broke it again (issue #1253). A stream is sent in chunks under that
    /// limit, so the hub's own limit stays where it is. The size cap is
    /// <see cref="PiperTransform.MaxInputLength"/>, applied to the byte count
    /// before any of the bytes are sent.
    /// </summary>
    [JSInvokable]
    public async Task OnLargeInputChanged(IJSStreamReference value)
    {
        string text;
        try
        {
            await using var stream = await value.OpenReadStreamAsync(maxAllowedSize: PiperTransform.MaxInputLength);
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8);
            text = await reader.ReadToEndAsync();
        }
        catch (ArgumentOutOfRangeException)
        {
            _input = string.Empty;
            _output = string.Empty;
            _table = null;
            _inputMetaText = $"Input is too large ({value.Length:N0} bytes). Trim it under {PiperTransform.MaxInputLength:N0} and try again.";
            StateHasChanged();
            return;
        }
        finally
        {
            await value.DisposeAsync();
        }

        Input = text;
        StateHasChanged();
    }

    private void Transform()
    {
        if (_mode == InputMode.Table)
        {
            TransformTable();
            return;
        }

        var result = PiperTransform.Run(_input, _options);
        _output = result.Output;
        _inputMetaText = string.IsNullOrEmpty(_input)
            ? result.DelimiterDescription
            : $"{result.ItemCount} item{(result.ItemCount == 1 ? "" : "s")} · {result.DelimiterDescription}";
        _separatorPlaceholder = result.DetectedSeparatorDisplay is null
            ? DefaultSeparatorPlaceholder
            : $"auto-detected: {result.DetectedSeparatorDisplay}";
    }

    private void TransformTable()
    {
        _separatorPlaceholder = DefaultSeparatorPlaceholder;

        if (string.IsNullOrEmpty(_input))
        {
            _table = null;
            _selectedColumn = null;
            _output = "";
            _inputMetaText = "Awaiting input...";
            return;
        }

        var separator = TableSeparators.GetValueOrDefault(_tableSeparatorKey, "\t");
        _table = PiperTransform.ParseTable(_input, separator, _tableHasHeaders);
        if (_table is null)
        {
            _selectedColumn = null;
            _output = "";
            var minRows = _tableHasHeaders ? 2 : 1;
            var separatorName = _tableSeparatorKey switch
            {
                "tab" => "tab-separated",
                "comma" => "comma-separated",
                "semicolon" => "semicolon-separated",
                "pipe" => "pipe-separated",
                _ => "separated",
            };
            _inputMetaText = $"No table detected - paste at least {minRows} {separatorName} row{(minRows == 1 ? "" : "s")}.";
            return;
        }

        // Keep the user's selection across edits when possible; otherwise
        // fall back to the first header so the dropdown always has a
        // valid value selected.
        if (_selectedColumn is null || !_table.Headers.Contains(_selectedColumn))
        {
            _selectedColumn = _table.Headers.FirstOrDefault();
        }

        var columnIndex = _selectedColumn is null
            ? -1
            : _table.Headers.ToList().IndexOf(_selectedColumn);

        var values = columnIndex < 0
            ? Array.Empty<string>()
            : _table.Rows.Select(row => row[columnIndex]).ToArray();

        var description = _selectedColumn is null
            ? "table"
            : $"table column: \"{_selectedColumn}\"";

        var result = PiperTransform.RunOnItems(values, _options, description);
        _output = result.Output;

        var rows = _table.Rows.Count;
        var cols = _table.Headers.Count;
        _inputMetaText = _selectedColumn is null
            ? $"{rows} row{(rows == 1 ? "" : "s")} × {cols} column{(cols == 1 ? "" : "s")}"
            : $"{rows} row{(rows == 1 ? "" : "s")} × {cols} column{(cols == 1 ? "" : "s")} · using column \"{_selectedColumn}\"";
    }

    private void SetMode(InputMode mode)
    {
        if (_mode == mode) return;
        _mode = mode;
        _inputPlaceholder = mode == InputMode.Table ? TablePlaceholder : TextPlaceholder;
        if (mode == InputMode.Text)
        {
            _table = null;
            _selectedColumn = null;
        }
        Transform();
        if (_module is not null)
        {
            _ = _module.InvokeVoidAsync("writeMode", mode.ToString()).AsTask();
        }
    }

    private async Task CopyAsync()
    {
        if (string.IsNullOrEmpty(_output)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _output);
            _justCopied = true;
            _copyTimer?.Cancel();
            _copyTimer?.Dispose();
            _copyTimer = new CancellationTokenSource();
            var token = _copyTimer.Token;
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(1500, token);
                    if (token.IsCancellationRequested) return;
                    await InvokeAsync(() =>
                    {
                        _justCopied = false;
                        StateHasChanged();
                    });
                }
                catch (TaskCanceledException) { }
            });
        }
        catch
        {
            // Clipboard write can fail (insecure context, denied permission).
            // Surface nothing - the textarea is still selectable.
        }
    }

    private async Task SwapInputOutputAsync()
    {
        if (string.IsNullOrEmpty(_output)) return;
        // The piped result is a flat string, not a table - flipping back to
        // Text mode keeps chained transforms working without the user
        // having to toggle the pill manually.
        if (_mode == InputMode.Table)
        {
            _mode = InputMode.Text;
            _inputPlaceholder = TextPlaceholder;
            _table = null;
            _selectedColumn = null;
        }
        _input = _output;
        Transform();
        await ShowInputAsync();
    }

    private async Task ClearAllAsync()
    {
        _input = "";
        _output = "";
        _inputMetaText = "Awaiting input...";
        _separatorPlaceholder = DefaultSeparatorPlaceholder;
        _mode = InputMode.Text;
        _inputPlaceholder = TextPlaceholder;
        _table = null;
        _selectedColumn = null;
        await ShowInputAsync();
    }

    /// <summary>Puts the input back into the box after the page changed it; the box has no bind to do that.</summary>
    private async Task ShowInputAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("setInput", _inputRef, _input); }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _copyTimer?.Cancel();
        _copyTimer?.Dispose();
        // Await the JS teardown before releasing the callback reference: a
        // fire-and-forget detach can still be running when _selfRef goes, and
        // the module would then call back into a disposed reference. Both calls
        // go via the circuit and can fault if it's already torn down; swallow.
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach"); } catch { }
            try { await _module.DisposeAsync(); } catch { }
        }
        _selfRef?.Dispose();
    }
}
