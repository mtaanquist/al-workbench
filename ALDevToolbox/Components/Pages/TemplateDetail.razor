@page "/templates/{Key}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject TemplateService Templates
@inject FolderTreeHydrator FolderTree
@using System.Text.Json
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Templates

<PageTitle>@PageTitleText · AL Workbench</PageTitle>

@* Onto the detail archetype, alongside RecipeDetail — .page / .page-head with
   crumbs, .meta-row for the facts, .card per section. It had been on a bespoke
   .template-detail__* family in tools.css and was the last page in the app
   sitting off the shell's layout grid. Issue #545.

   The two JSON blocks are the reason this page needed more than a re-skin. They
   were <textarea readonly> — editable-looking, resizable, and scroll-clipped —
   on a page whose own subtitle says it is read-only. They are .code-block now,
   and collapsed by default: a consultant choosing a template wants the ID
   ranges and the layout, not appSourceCop.json. It is one click away when they
   do want it. *@

<DetailPage IsLoading="@(_template is null && !_loadFailed)" IsNotFound="@(_template is null)"
            Title="@PageTitleText"
            ShowActions="@(_template is { Deprecated: false, DeletedAt: null })"
            Subtitle="A read-only look at this template's layout and defaults."
            Trail='@([new("Templates", "/templates"), new(PageTitleText)])'>
    <NotFound>
        <div class="card">
            @* search-x is what the hand-off's not-found state uses; it is not
               vendored, and the icon-catalogue test rightly refuses a name
               with no SVG behind it. `search` carries the same meaning here
               without adding an icon for one call site. *@
            <EmptyState Icon="search" Title="@($"No template with key {Key}")" Heading="true">
                <Text>
                    It may have been renamed or removed. The list shows everything
                    available to you.
                </Text>
                <Action><a class="btn" href="/templates">Back to templates</a></Action>
            </EmptyState>
        </div>
    </NotFound>
    <TitleRow>
        @if (_template?.Deprecated == true)
        {
            <StatusPill Tone="warn">
                <Icon Name="archive" Width="12" Height="12" />
                Deprecated
            </StatusPill>
        }
    </TitleRow>
    <Actions>
        <a class="btn btn--primary" href="@($"/templates/workspace?template={Uri.EscapeDataString(_template!.Key)}")">
            <Icon Name="folder-plus" Width="16" Height="16" />
            <span>New workspace from this template</span>
        </a>
    </Actions>
    <Meta>
        <div class="meta-item">
            <span class="meta-item__label">Key</span>
            <span class="meta-item__value"><code class="code">@_template!.Key</code></span>
        </div>
        <div class="meta-item">
            <span class="meta-item__label">Runtime</span>
            <span class="meta-item__value">@_template!.Runtime</span>
        </div>
        <div class="meta-item">
            <span class="meta-item__label">Default application</span>
            <span class="meta-item__value">@OrNotSet(_template!.Defaults.Application)</span>
        </div>
        <div class="meta-item">
            <span class="meta-item__label">Default platform</span>
            <span class="meta-item__value">@OrNotSet(_template!.Defaults.Platform)</span>
        </div>
        <div class="meta-item">
            <span class="meta-item__label">Core object IDs</span>
            <span class="meta-item__value">
                @_template!.CoreIdRangeFrom-@_template!.CoreIdRangeTo
                <span class="u-muted">(@(_template!.CoreIdRangeTo - _template!.CoreIdRangeFrom + 1) ids)</span>
            </span>
        </div>
        <div class="meta-item">
            <span class="meta-item__label">Per-module IDs</span>
            <span class="meta-item__value">
                @_template!.ModuleIdRangeSize each
                <span class="u-muted">from @_template!.ModuleIdRangeStart</span>
            </span>
        </div>
    </Meta>
    <ChildContent>
    @if (!string.IsNullOrWhiteSpace(_template!.Description))
    {
        <p class="u-muted">@_template!.Description</p>
    }

    <section class="card">
        <div class="card__head"><h2 class="card__title">Extensions</h2></div>
        <div class="card__body">
            @if (_template!.WorkspaceExtensions.Count == 0)
            {
                <div class="empty-state empty-state--quiet">
                    <span class="empty-state__text">This template doesn't define any extensions yet.</span>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr><th>Folder</th><th>Extension name</th><th>Included</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ext in _template!.WorkspaceExtensions.OrderBy(e => e.Ordering))
                        {
                            <tr>
                                <td><code class="code">@ext.Path</code></td>
                                <td>@ext.NameTemplate</td>
                                <td>@(ext.Required ? "Always" : "Optional")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    @if (_tree is not null)
    {
        <section class="card">
            <div class="card__head">
                <div>
                    <h2 class="card__title">Layout preview</h2>
                    <p class="card__sub">
                        What the generated workspace looks like with this template's
                        required extensions, including example files.
                    </p>
                </div>
            </div>
            <div class="card__body">
                <FolderTreePreview Root="_tree" />
            </div>
        </section>
    }

    <details class="card card--collapsible">
        <summary class="card__head"><h2 class="card__title">Defaults</h2></summary>
        <div class="card__body">
            <p class="form-sec__cap">Merged into every generated <code class="code">app.json</code>.</p>
            <div class="code-block">
                <div class="code-block__bar"><span class="code-block__name">app.json (defaults)</span></div>
                <pre>@_defaultsJson</pre>
            </div>
        </div>
    </details>

    <details class="card card--collapsible">
        <summary class="card__head"><h2 class="card__title">AppSourceCop</h2></summary>
        <div class="card__body">
            <p class="form-sec__cap">Written verbatim into each <code class="code">AppSourceCop.json</code>.</p>
            <div class="code-block">
                <div class="code-block__bar"><span class="code-block__name">AppSourceCop.json</span></div>
                <pre>@_appSourceCopJson</pre>
            </div>
        </div>
    </details>
    </ChildContent>
</DetailPage>

@code {
    [Parameter] public string? Key { get; set; }

    private RuntimeTemplate? _template;
    private bool _loadFailed;
    private PreviewNode? _tree;
    private string _defaultsJson = string.Empty;
    private string _appSourceCopJson = string.Empty;

    private string PageTitleText => _template?.Name ?? (string.IsNullOrEmpty(Key) ? "Template" : Key!);

    /// <summary>
    /// A meta-item with nothing in it used to render as a label above an empty
    /// &lt;code&gt;, which reads as a broken page rather than an unset field.
    /// </summary>
    private static string OrNotSet(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not set" : value;

    private static readonly JsonSerializerOptions PrettyJson = new() { WriteIndented = true };

    protected override async Task OnParametersSetAsync()
    {
        _template = null;
        _tree = null;
        _loadFailed = false;
        if (string.IsNullOrEmpty(Key)) { _loadFailed = true; return; }

        var template = await Templates.GetByKeyAsync(Key);
        // Hide soft-deleted templates from anonymous users - admins still see
        // them via /admin/templates/{key}, where they can restore.
        if (template is null || template.DeletedAt is not null)
        {
            _loadFailed = true;
            return;
        }

        // The preview draws paths only; the example file bodies stay in the database.
        await FolderTree.HydrateExtensionFolderTreeAsync(new[] { template }, pathsOnly: true);

        _template = template;
        _defaultsJson = JsonSerializer.Serialize(template.Defaults, PrettyJson);
        _appSourceCopJson = JsonSerializer.Serialize(template.AppSourceCop, PrettyJson);
        _tree = BuildTree(template);
    }

    /// <summary>
    /// Builds a workspace-shaped <see cref="PreviewNode"/> tree from the
    /// template's required extensions, each rendered through the same
    /// <see cref="ExtensionPreviewBuilder"/> the generation pages use.
    /// Examples are included so admins see the seeded content; optional
    /// extensions are omitted because there's no per-user toggle here.
    /// </summary>
    private static PreviewNode BuildTree(RuntimeTemplate template)
    {
        // Per-extension org files the template has opted into come from
        // RuntimeTemplate.IncludedFiles (joined OrganizationFile rows).
        // The detail view is read-only, so we just need the path list.
        var perExtensionPaths = template.IncludedFiles
            .OrderBy(j => j.Ordering)
            .Where(j => j.OrganizationFile is not null
                && j.OrganizationFile.Scope == ALDevToolbox.Domain.ValueObjects.OrganizationFileScope.EveryExtension)
            .Select(j => j.OrganizationFile!.Path)
            .ToList();

        var children = new List<PreviewNode>();
        foreach (var ext in template.WorkspaceExtensions
            .Where(e => e.Required)
            .OrderBy(e => e.Ordering))
        {
            children.Add(PreviewNode.Extension(
                ext.Path,
                ExtensionPreviewBuilder.BuildContents(ext.Folders, includeExamples: true, perExtensionPaths)));
        }
        // The folders the template creates empty, each showing the placeholder
        // the generator puts inside. Workspace-root-scoped included files can
        // fill one, so pass them for the same skip the generator applies.
        var workspaceRootPaths = template.IncludedFiles
            .OrderBy(j => j.Ordering)
            .Where(j => j.OrganizationFile is not null
                && j.OrganizationFile.Scope == ALDevToolbox.Domain.ValueObjects.OrganizationFileScope.WorkspaceRoot)
            .Select(j => j.OrganizationFile!.Path)
            .ToList();
        PreviewTreeBuilder.GraftEmptyFolders(
            children,
            template.RootFolders.OrderBy(f => f.Ordering).Select(f => f.Path),
            workspaceRootPaths);

        return PreviewTreeBuilder.SortForDisplay(
            new PreviewNode(template.Key, PreviewNodeKind.Workspace, children));
    }
}
