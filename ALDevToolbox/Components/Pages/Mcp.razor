@page "/tools/mcp"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using ALDevToolbox.Domain.Tools
@using ALDevToolbox.Services
@using ALDevToolbox.Data
@using ALDevToolbox.Services.Account
@using Microsoft.EntityFrameworkCore
@using ALDevToolbox.Services.Mcp
@using ALDevToolbox.Components.Shared
@inject IMcpAvailability McpAvailability
@inject IHttpContextAccessor Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<Mcp> Logger
@inject IOrganizationContext OrgContext
@inject PersonalAccessTokenService Pats
@inject ALDevToolbox.Services.OAuth.OAuthConsentService Consents

<PageTitle>MCP · AL Workbench</PageTitle>

@*
    Page archetype 13 (setup steps): `.steps` / `.step` from pages-content.css,
    which retires this page's 190-line `Mcp.razor.css`. That sheet had been
    quietly broken for a while - `.mcp-step__number` and `.mcp-tab--active`
    painted themselves with `var(--blue)` and `var(--blue-50)`, and
    `.mcp-snippet` set `font-family: var(--mono)`; none of those three tokens
    survived the move to tokens.css, so the step numbers had no fill and the
    snippet was rendering in the body font.

    Step 1 is a genuine fork rather than a step - two ways to authenticate - so
    it keeps the two cards inside one step body. Steps 2 and 3 are the sequence
    the reader is actually walking.

    The tool table is `McpToolCatalog` rather than a literal: this page listed
    13 of the 38 registered tools and two names that no longer exist. See
    Components/Pages/Docs/McpDocs.razor for the same change and
    ALDevToolbox.Tests/Tools/McpToolCatalogTests.cs for the guard.

    The "switched off" state is belt-and-braces rather than the usual path: MCP
    is a toggleable tool, and ToolAccessGate 404s a disabled tool's routes before
    this page renders at all (verified - with mcp_enabled false, /tools/mcp is a
    404, not this card). It stays because the flag it reads is real and the guard
    is correct; do not go looking for how to see it on screen.

    NOT resolved here: issue #556, which asks whether this tool should be called
    "AI assistants" (as the Account page already calls it) rather than by its
    protocol acronym. That rename spans the sidebar, the launcher, ToolCatalog
    and this page, so it is its own change rather than a rider on the port.
*@

<div class="page">
    <PageHead Title="Model Context Protocol"
              Subtitle="Connect an AI assistant so it can generate workspaces, search Business Central objects and read your recipes on your behalf.">
        <Actions>
            <a class="btn" href="/docs/mcp">
                <Icon Name="book-open" Width="16" Height="16" />
                <span>Full setup guide</span>
            </a>
        </Actions>
    </PageHead>

    @* No loading branch: OnInitialized reads a singleton and a header, both
       synchronously, so it has already run before the first render. The old
       one could not be reached. *@
    @if (!_mcpEnabled)
    {
        <EmptyState Icon="plug" Title="AI assistants are switched off here">
            <Text>
                Nobody can connect an assistant to this site until an administrator
                switches assistants back on. Ask yours - there is nothing to set up on your
                side in the meantime.
            </Text>
        </EmptyState>
    }
    else
    {
        @* steps--wide (divergence 72): this list's bodies are a two-up card
           row, a token field and JSON config, not prose. The reading measure
           stays on .step__text, where it belongs. *@
        <SetupSteps Wide="true">
            @* Step 1 is a fork, not a stage. The two cards used to point at the
               same URL and only the token half continued into steps 2 and 3, so
               a Claude-web reader picked "permission screen", landed on the same
               page as everyone else, then hit "pick your assistant" listing four
               desktop clients and an instruction to paste a token they were
               never given. The connector card is terminal now: it carries the
               one thing that path needs, and says so. *@
            <SetupStep Number="1" Title="Choose how your assistant signs in" State="@(_alreadySetUp ? SetupStepState.Done : SetupStepState.Current)">
                <HeadExtra>
                    @if (_alreadySetUp)
                    {
                        <span class="badge">@SetUpSummary</span>
                    }
                </HeadExtra>
                <Text>
                    Either way the assistant ends up acting as you, with your organisation
                    and your role. Which one you need depends on the assistant.
                </Text>
                <ChildContent>
                    <div class="mcp-choice">
                        <div class="card">
                            <div class="card__head">
                                <span class="u-row">
                                    <Icon Name="key-round" Width="18" Height="18" />
                                    <span class="card__title">A personal access token</span>
                                </span>
                            </div>
                            <div class="card__body">
                                For VS Code, Claude Desktop, Cursor, Claude Code and
                                anything else you configure by editing a file. The token
                                is shown once, so copy it before you close the screen.
                                Then carry on with step 2.
                            </div>
                            <div class="card__foot">
                                <a class="btn btn--primary" href="/account/ai">
                                    <Icon Name="key-round" Width="16" Height="16" />
                                    <span>@(_hasToken ? "Manage your tokens" : "Create a token")</span>
                                </a>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card__head">
                                <span class="u-row">
                                    <Icon Name="plug" Width="18" Height="18" />
                                    <span class="card__title">A permission screen</span>
                                </span>
                            </div>
                            <div class="card__body">
                                <p>
                                    For Claude on the web and mobile, and ChatGPT. No token
                                    to paste: add this address in the assistant's own
                                    connector settings and approve it once.
                                </p>
                                <div class="code-block code-block--inlinebar">
                                    <pre id="mcp-server-url">@_serverUrl</pre>
                                    <CopyButton Target="#mcp-server-url" />
                                </div>
                                <p><strong>That is the whole setup - steps 2 and 3 are not yours.</strong></p>
                            </div>
                            <div class="card__foot">
                                <a class="btn" href="/account/ai">
                                    <Icon Name="plug" Width="16" Height="16" />
                                    <span>See what's connected</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </ChildContent>
            </SetupStep>

            <SetupStep Number="2" Title="Paste the settings into your assistant">
                <Text>
                    Only if you chose a token. Pick your assistant, paste your token in
                    below, and the snippet fills itself in.
                </Text>
                <ChildContent>
                    <span class="pill-tabs" role="tablist" aria-label="Assistant">
                        @foreach (var tab in Tabs)
                        {
                            <button type="button" role="tab"
                                    aria-selected="@(tab == _selectedTab ? "true" : "false")"
                                    class="pill-tab @(tab == _selectedTab ? "is-active" : "")"
                                    @onclick="() => Select(tab)">
                                @tab
                            </button>
                        }
                    </span>

                    @* The token is shown once and lives in the clipboard until the
                       reader presses Copy here - at which point the snippet
                       overwrites it and the token is gone from both the clipboard
                       and the screen. Pasting it in first is what makes Copy hand
                       over something that actually works. *@
                    <span class="field">
                        <label class="field__label" for="mcp-token">Your token</label>
                        <input class="input" id="mcp-token" type="text" autocomplete="off"
                               spellcheck="false" placeholder="@TokenPlaceholder"
                               value="@_token" @oninput="OnTokenInput" />
                        <span class="field__hint">
                            Only used to fill in the snippet below. It is not sent anywhere
                            and not saved - leave it blank and you can paste it into the
                            snippet yourself.
                        </span>
                    </span>

                    <div class="code-block">
                        <div class="code-block__bar">
                            <span class="code-block__lang">@CurrentLang</span>
                            @if (CurrentFile is { } file)
                            {
                                <span class="code-block__name">@file</span>
                            }
                            <span class="code-block__spacer"></span>
                            <button type="button" class="btn btn--sm copy-btn @(_copied ? "is-copied" : "")"
                                    @onclick="CopySnippetAsync">
                                <Icon Name="copy" Width="14" Height="14" />
                                <span>@(_copied ? "Copied" : "Copy")</span>
                            </button>
                        </div>
                        <pre>@CurrentSnippet</pre>
                    </div>
                    @if (_copyFailed)
                    {
                        <span class="step__text">
                            Your browser wouldn't let us reach the clipboard - select the
                            snippet above and copy it by hand.
                        </span>
                    }
                    <span class="step__text">@CurrentHint</span>
                </ChildContent>
            </SetupStep>

            <SetupStep Number="3" Title="Try it">
                <Text>
                    Reload your assistant, then ask it something only the workbench can
                    answer. If it comes back with a real answer, you're connected.
                </Text>
                <ChildContent>
                    <ul class="mcp-prompts">
                        <li>"Make a new workspace for CRONUS using the default template."</li>
                        <li>"Which procedures touch the No. field on Sales Line in BC 28.1?"</li>
                        <li>"Walk me through what happens when you post a sales order in BC 28.1."</li>
                        <li>"Find me a recipe for posting validation overrides."</li>
                    </ul>
                    @* Otherwise a working connection reads as a failed one: these
                       prompts name content an organisation may simply not have
                       imported yet. *@
                    <span class="step__text">
                        If it answers but says it can't find a release or a recipe, the
                        connection is fine - your organisation just hasn't imported that
                        content yet.
                    </span>
                </ChildContent>
            </SetupStep>
        </SetupSteps>

        <details class="mcp-tools">
            <summary>
                <span class="u-row">
                    <Icon Name="chevron-right" Width="15" Height="15" Css="mcp-tools__caret" />
                    <span>What your assistant can do - @McpToolCatalog.All.Count tools across @McpToolCatalog.Groups.Count areas</span>
                </span>
            </summary>
            <div class="mcp-tools__body">
                <p class="step__text">
                    Reference, not something to read now - the assistant picks the right
                    tool for what you asked. Tools marked <strong>Changes something</strong>
                    can create or update data here; everything else only looks things up.
                </p>
                @foreach (var group in McpToolCatalog.Groups)
                {
                    <h3 class="mcp-tools__group">@group</h3>
                    <table class="data-table">
                        <thead>
                            <tr><th>What it does</th><th>Tool</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var tool in McpToolCatalog.InGroup(group))
                            {
                                <tr>
                                    <td>
                                        @tool.Blurb
                                        @if (tool.Writes)
                                        {
                                            @* &#160; rather than a literal space: Razor trims
                                               leading whitespace inside an element. *@
                                            <strong>&#160;Changes something.</strong>
                                        }
                                    </td>
                                    <td><code class="mcp-tools__name">@tool.Name</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </details>

        <section class="card">
            <div class="card__head">
                <p class="card__title">If it isn't working</p>
            </div>
            <div class="card__body">
                <div class="note note--info">
                    <span class="note__icon"><Icon Name="info" Width="17" Height="17" /></span>
                    <span class="note__title">My assistant doesn't see the workbench</span>
                    <span class="note__body">
                        Check the URL is reachable from your machine and that the config
                        file is saved where your client looks for it. VS Code needs Copilot
                        agent mode switched on; Claude Desktop needs a restart after the
                        config changes.
                    </span>
                </div>
                <div class="note note--info">
                    <span class="note__icon"><Icon Name="info" Width="17" Height="17" /></span>
                    <span class="note__title">401 Unauthorized</span>
                    <span class="note__body">
                        The token is missing, expired or revoked. Issue a fresh one from
                        <a href="/account/ai">your account page</a> and update the
                        client.
                    </span>
                </div>
                <div class="note note--info">
                    <span class="note__icon"><Icon Name="info" Width="17" Height="17" /></span>
                    <span class="note__title">404 Not Found</span>
                    <span class="note__body">
                        Either the address is wrong, or an administrator has switched
                        assistants off since you set this up. Reload this page - if it 404s
                        too, that's the answer, and it's your administrator you need.
                    </span>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private static readonly string[] Tabs = new[] { "VS Code", "Claude Desktop", "Cursor", "Claude Code" };

    private bool _mcpEnabled;
    private string _serverUrl = string.Empty;
    private string _selectedTab = "VS Code";
    private bool _copied;
    private bool _copyFailed;

    /// <summary>Long enough to read, short enough to be back before you press it again.</summary>
    private const int CopiedLabelMs = 1200;

    private string _token = string.Empty;
    private bool _hasToken;
    private bool _hasConnectedAssistant;

    /// <summary>
    /// True once the reader has done step 1 by either route. The archetype ships
    /// `.step.is-done`, and without it a returning user re-reads the fork every
    /// visit instead of seeing a checklist with the first box ticked.
    /// </summary>
    private bool _alreadySetUp => _hasToken || _hasConnectedAssistant;

    private string SetUpSummary => (_hasToken, _hasConnectedAssistant) switch
    {
        (true, true) => "Token and connected assistant",
        (true, false) => "You have a token",
        _ => "Assistant connected",
    };

    /// <summary>
    /// Shaped like a real token so the field reads as "paste here", without
    /// being a value anyone could mistake for one that works.
    /// </summary>
    private const string TokenPlaceholder = "aldt_pat_...";

    protected override async Task OnInitializedAsync()
    {
        var userId = OrgContext.CurrentUserId;
        if (userId is null) return;

        // Both are small per-user reads and only decide whether step 1 shows as
        // done; a failure here must not take the setup instructions down with it.
        try
        {
            _hasToken = (await Pats.ListForUserAsync(userId.Value)).Any(p => p.RevokedAt is null);
            // Read through the consent-only service, not the admin one: that
            // joins the OAuth application registry for display names and drags the
            // OpenIddict managers along for what is a yes/no here.
            _hasConnectedAssistant = await Consents.HasAnyConsentAsync(userId.Value);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read the sign-in state for the MCP setup page; showing step 1 as not started.");
        }
    }

    protected override void OnInitialized()
    {
        _mcpEnabled = McpAvailability.IsEnabled;
        var ctx = Http.HttpContext;
        if (ctx is not null)
        {
            _serverUrl = $"{ctx.Request.Scheme}://{ctx.Request.Host}/mcp";
        }
        else
        {
            // OnInitialized after the SSR pass - fall back to the URL the
            // page itself is on so the snippet still has a sensible default.
            var uri = new Uri(Nav.Uri);
            _serverUrl = $"{uri.Scheme}://{uri.Authority}/mcp";
        }
    }

    private void Select(string tab)
    {
        _selectedTab = tab;
        _copied = false;
        _copyFailed = false;
    }

    private void OnTokenInput(ChangeEventArgs e)
    {
        _token = e.Value?.ToString() ?? string.Empty;
        _copied = false;
    }

    /// <summary>
    /// What goes into the snippet where the token belongs. Blank until the
    /// reader pastes one, so the snippet is honest about what is still missing.
    /// </summary>
    private string TokenForSnippet =>
        string.IsNullOrWhiteSpace(_token) ? "PASTE-YOUR-TOKEN-HERE" : _token.Trim();

    /// <summary>
    /// Copies the snippet and reverts the label after a beat.
    ///
    /// The revert is the point: without it the button read "Copied" for the rest
    /// of the circuit, so someone who copied, went to their editor and came back
    /// could not tell whether the clipboard still held it. The catch matters for
    /// the same kind of reason - navigator.clipboard is unavailable on a
    /// non-HTTPS, non-localhost origin, which is exactly what an internal LAN
    /// deployment is, and the button would otherwise do nothing at all and say
    /// nothing about it.
    /// </summary>
    private async Task CopySnippetAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentSnippet);
        }
        catch (JSException)
        {
            _copyFailed = true;
            return;
        }

        _copied = true;
        _copyFailed = false;
        // Explicit, because Blazor's own re-render happens when the handler hits
        // its FIRST await - the JS interop above - by which point _copied is
        // still false. Without this the label never showed "Copied" at all: it
        // went straight from Copy to Copy, 1.2s apart.
        StateHasChanged();

        await Task.Delay(CopiedLabelMs);
        _copied = false;
        StateHasChanged();
    }

    private string CurrentSnippet => _selectedTab switch
    {
        "Claude Desktop" => ClaudeDesktopSnippet(_serverUrl, TokenForSnippet),
        "Cursor" => CursorSnippet(_serverUrl, TokenForSnippet),
        "Claude Code" => ClaudeCodeSnippet(_serverUrl, TokenForSnippet),
        _ => VsCodeSnippet(_serverUrl, TokenForSnippet),
    };

    private string CurrentLang => _selectedTab == "Claude Code" ? "shell" : "json";

    /// <summary>
    /// The file the snippet belongs in, shown on the code block's bar. Claude
    /// Code has none - it is a command you run, not a file you edit.
    /// </summary>
    private string? CurrentFile => _selectedTab switch
    {
        "Claude Desktop" => "claude_desktop_config.json",
        "Cursor" => "~/.cursor/mcp.json",
        "Claude Code" => null,
        _ => ".vscode/mcp.json",
    };

    private string CurrentHint => _selectedTab switch
    {
        "VS Code" => "Save this in your workspace and reload the window. Needs Copilot agent mode.",
        "Claude Desktop" => "Settings → Developer → Edit Config, then restart the app.",
        "Cursor" => "Cursor Settings → MCP, or edit the file directly. It reloads on its own.",
        "Claude Code" => "Run it in any project directory; Claude Code remembers it there.",
        _ => string.Empty,
    };

    private static string VsCodeSnippet(string url, string token) => $$"""
        {
          "servers": {
            "aldevtoolbox": {
              "type": "http",
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer {{token}}"
              }
            }
          }
        }
        """;

    private static string ClaudeDesktopSnippet(string url, string token) => $$"""
        {
          "mcpServers": {
            "aldevtoolbox": {
              "type": "http",
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer {{token}}"
              }
            }
          }
        }
        """;

    private static string CursorSnippet(string url, string token) => $$"""
        {
          "mcpServers": {
            "aldevtoolbox": {
              "url": "{{url}}",
              "headers": {
                "Authorization": "Bearer {{token}}"
              }
            }
          }
        }
        """;

    private static string ClaudeCodeSnippet(string url, string token) =>
        $"claude mcp add aldevtoolbox \\\n  --transport http \\\n  --url {url} \\\n  --header \"Authorization: Bearer {token}\"";
}
