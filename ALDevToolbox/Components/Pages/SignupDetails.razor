@page "/signup/details"
@layout ALDevToolbox.Components.Layout.AuthLayout
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Data
@using ALDevToolbox.Endpoints
@using ALDevToolbox.Services
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.EntityFrameworkCore
@inject IHttpContextAccessor Http
@inject IDataProtectionProvider Protection
@inject AppDbContext Db
@inject TimeProvider Clock
@inject NavigationManager Nav
@inject ALDevToolbox.Services.SingleTenant.ISingleTenantMode SingleTenant

<PageTitle>Finish signing up · AL Workbench</PageTitle>

@*
    The second half of signup, reached only with a verified-email cookie. Three
    outcomes, decided by whether an organisation has claimed the email's domain:
    join it, start a new one, or - in single-tenant hosting, where there is
    nothing to start - a dead end that says who to ask.
*@

@if (!_domainMatched && SingleTenant.IsEnabled)
{
    <AuthCard Title="You'll need an invite">
        <Sub>
            <text>
                We verified <strong>@_email</strong>, but no organisation on this site has
                claimed that email domain, and this site doesn't let people start their own.
                Ask an administrator to invite you.
            </text>
        </Sub>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
    </AuthCard>
}
else
{
    <AuthCard Title="@(_domainMatched ? "Finish joining " + _domainOrgName : "Name your organisation")"
              FormAction="/auth/signup/complete">
        <Sub>
            @if (_domainMatched)
            {
                <text>
                    We verified <strong>@_email</strong>, and its domain belongs to
                    <strong>@_domainOrgName</strong>. Pick a name and a password to finish.
                </text>
            }
            else
            {
                <text>
                    We verified <strong>@_email</strong>. No organisation has claimed that
                    domain yet, so you'll start one and be its first admin.
                </text>
            }
        </Sub>
        <Alerts>
            @if (Error == "invalid" && !string.IsNullOrEmpty(Field))
            {
                <Alert Tone="AlertTone.Danger">
                    <span>
                        @if (AuthCard.FieldLabel(@Field) is { } label)
                        {
                            <strong>@label:</strong>
                        }
                        @Message
                    </span>
                </Alert>
            }
        </Alerts>
        <ChildContent>
            <div class="auth__fields">
                <div class="field">
                    <label class="field__label" for="su-display">Full name</label>
                    <input class="input" id="su-display" type="text" name="DisplayName" required
                           minlength="2" maxlength="80" autofocus placeholder="Kirsten Jensen" />
                </div>
                <div class="field">
                    <label class="field__label" for="su-password">Password</label>
                    <input class="input" id="su-password" type="password" name="Password" required
                           minlength="12" autocomplete="new-password" />
                    <span class="field__hint">At least 12 characters, and not one you use anywhere else.</span>
                </div>
                @if (!_domainMatched)
                {
                    <div class="field">
                        <label class="field__label" for="su-org-name">Organisation name</label>
                        <input class="input" id="su-org-name" type="text" name="OrganizationName" required
                               minlength="2" maxlength="80" placeholder="CRONUS International Ltd." />
                    </div>
                    <div class="field">
                        <label class="field__label" for="su-org-slug">Organisation ID</label>
                        <input class="input" id="su-org-slug" type="text" name="OrganizationSlug"
                               pattern="[a-z0-9-]*" maxlength="64" placeholder="cronus" />
                        <span class="field__hint">
                            Used in links to your organisation, for example cronus. Lowercase letters,
                            digits and hyphens — we'll make one from the name if you leave this blank.
                        </span>
                    </div>
                }
            </div>
            <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg)">
                <Icon Name="user-plus" Width="16" Height="16" />
                <span>@(_domainMatched ? "Join organisation" : "Create organisation")</span>
            </button>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
    </AuthCard>
}

@code {
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "field")] public string? Field { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }

    private string _email = string.Empty;
    private bool _domainMatched;
    private string? _domainOrgName;

    protected override async Task OnInitializedAsync()
    {
        var ctx = Http.HttpContext;
        var state = ctx is null ? null : EndpointHelpers.ReadSignupVerifiedCookie(ctx, Protection, Clock);
        if (state is null)
        {
            // No verified email in scope - send them back to start over.
            Nav.NavigateTo("/signup");
            return;
        }

        _email = state.Email;
        var domain = EmailAddress.DomainOf(_email);
        if (domain is not null)
        {
            // Fence category 1 (pre-auth routing): the visitor isn't signed in and
            // the domain claim is globally unique; pinned to d.Domain == domain.
            _domainOrgName = await Db.OrganizationEmailDomains
                .IgnoreQueryFilters()
                .AsNoTracking()
                .Where(d => d.Domain == domain)
                .Select(d => d.Organization!.Name)
                .FirstOrDefaultAsync();
            _domainMatched = _domainOrgName is not null;
        }
    }
}
