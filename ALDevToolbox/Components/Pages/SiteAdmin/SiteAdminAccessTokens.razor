@page "/site-admin/connections/access-tokens"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Account
@using ALDevToolbox.Components.Shared
@inject PersonalAccessTokenService Tokens

<PageTitle>Access tokens · Site administration · AL Workbench</PageTitle>

<SiteAdminConnectionsHeader ActiveTab="SiteAdminConnectionsHeader.Tab.AccessTokens">
    @if (Ok == "revoked")
    {
        <Alert Tone="AlertTone.Success">
            <span>Token revoked. Anything using it stops working immediately.</span>
        </Alert>
    }

    <section class="card">
        <div class="card__head">
            <div>
                <h2 class="card__title">Every access token on this site</h2>
                <p class="card__sub">Revoke one if it has leaked, or if its owner has left.</p>
            </div>
        </div>

        @if (_rows is null)
        {
            <div class="loading-block">
                <span class="spinner"></span><span>Loading...</span>
            </div>
        }
        else if (_rows.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="key-round" Width="21" Height="21" /></span>
                <span class="empty-state__title">No access tokens yet</span>
                <span class="empty-state__text">
                    Tokens appear here when someone creates one for a command-line
                    tool or a desktop app, under their own account.
                </span>
            </div>
        }
        else
        {
            @* .data-table--edge with a leading state cell, not a pill per row -
               see RowStateIcon. *@
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                        <th>Name</th>
                        <th>Starts with</th>
                        <th>Owner</th>
                        <th>Organisation</th>
                        <th>Created</th>
                        <th>Last used</th>
                        <th>Expires</th>
                        <th class="data-table__actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in _rows)
                {
                    var state = StateFor(t);
                    <tr class="@RowStateIcon.RowClass(state)">
                        <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                        <td>@t.Name</td>
                        <td><code class="code">@t.TokenPrefix...</code></td>
                        <td>@(t.User?.Email ?? "Unknown")</td>
                        <td>@(t.Organization?.Name ?? "Unknown")</td>
                        <td class="u-muted"><Timestamp Value="@t.CreatedAt" Format="yyyy-MM-dd" /></td>
                        <td class="u-muted"><Timestamp Value="@t.LastUsedAt" Placeholder="Never" /></td>
                        <td class="u-muted"><Timestamp Value="@t.ExpiresAt" Format="yyyy-MM-dd" Placeholder="Never" /></td>
                        <td class="data-table__actions">
                            @if (t.RevokedAt is null)
                            {
                                @* No interpolation into the JS string: a token
                                   name is free text, and an apostrophe in it
                                   would terminate the literal. *@
                                <form method="post" action="/site-admin/access-tokens/@t.Id/revoke"
                                      onsubmit="return confirm('Revoke this token? Whatever is using it stops working straight away, and this cannot be undone.');">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn btn--sm btn--danger">Revoke</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</SiteAdminConnectionsHeader>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private IReadOnlyList<PersonalAccessToken>? _rows;

    protected override async Task OnInitializedAsync()
    {
        _rows = await Tokens.ListAllAsync();
    }

    private static string StateFor(PersonalAccessToken t)
    {
        if (t.RevokedAt is not null) return "revoked";
        if (t.ExpiresAt is { } exp && exp <= DateTime.UtcNow) return "expired";
        return "active";
    }
}
