@page "/site-admin/audit"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Services
@using ALDevToolbox.Components.Shared
@using static ALDevToolbox.Components.Shared.AdminPageHelpers
@using ALDevToolbox.Services.Account
@inject SiteAdminService SiteAdmin
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone

<PageTitle>Audit log · Site administration · AL Workbench</PageTitle>

@*
    The cross-organisation twin of /admin/audit, on the same .audit list. The
    organisation moved out of its own column and into the sentence -- "Mads
    changed Template #3 in CRONUS A/S" -- which is the one thing this page has
    that the org-scoped one does not, and reads better than a column of names.
    See .design/design-migration.md.
*@

<ListPage Title="Audit log" ShowActions="true" FiltersWhenEmpty="true"
          IsLoading="@(_rows is null)"
          IsEmpty="@(_rows is not null && _rows.Count == 0)">
    <SubtitleContent>
        Changes across every organisation on this deployment, newest
        first. Filters are optional; without any, this is the most recent
        activity everywhere. Open an entry to see which fields changed.
    </SubtitleContent>
    <Notices>
        @*
            Filters apply on change rather than waiting for a submit button:
            selects and date pickers fire change events synchronously, and the
            Actor text input submits on Enter or when it loses focus. Keeping
            the form GET-based preserves bookmarkable URLs and uses the same
            SupplyParameterFromQuery wiring as before.
        *@
        <form method="get" action="/site-admin/audit" class="card filter-grid" onchange="this.submit()">
            <label class="field">
                <span class="field__label">Entity type</span>
                <SelectBox>
                    <select class="select" name="entityType">
                        <option value="">Any</option>
                        @foreach (var type in Enum.GetValues<AuditEntityType>())
                        {
                            <option value="@type" selected="@(EntityType == type.ToString())">@FriendlyAuditType(type)</option>
                        }
                    </select>
                </SelectBox>
            </label>
            <label class="field">
                <span class="field__label">Organisation</span>
                <SelectBox>
                    <select class="select" name="organizationId">
                        <option value="">Any</option>
                        @if (_orgs is not null)
                        {
                            @foreach (var o in _orgs)
                            {
                                <option value="@o.Id" selected="@(OrganizationId == o.Id)">@o.Name</option>
                            }
                        }
                    </select>
                </SelectBox>
            </label>
            <label class="field">
                <span class="field__label">Changed by</span>
                <input class="input" type="text" name="actor" value="@Actor" placeholder="email or name" />
            </label>
            <label class="field">
                <span class="field__label">From</span>
                <input class="input" type="datetime-local" name="from" value="@FromInput" />
            </label>
            <label class="field">
                <span class="field__label">To</span>
                <input class="input" type="datetime-local" name="to" value="@ToInput" />
            </label>
        </form>
    </Notices>
    <Loading>
        <LoadingBlock Text="Loading changes..." />
    </Loading>
    <Empty>
        <div class="card">
            <EmptyState Icon="funnel-x" Title="No changes match these filters">
                <Text>Try widening the date range, or clear the filters to see everything.</Text>
                <Action>
                    <a class="btn" href="/site-admin/audit">Clear filters</a>
                </Action>
            </EmptyState>
        </div>
    </Empty>
    <ChildContent>
        <div class="card">
            <div class="audit">
                @foreach (var e in _rows ?? new())
                {
                    <div class="audit__entry">
                        <a class="audit__sum" href="@($"/site-admin/audit/{e.Id}/diff")">
                            <span class="audit__time">
                                <Timestamp Value="@e.Timestamp" Format="yyyy-MM-dd HH:mm" />
                            </span>
                            <span class="audit__avatar" aria-hidden="true">@Avatar.Initials(AuditActor.Display(e.ChangedBy, e.ChangedByUserId, e.EntityType))</span>
                            <span class="audit__what">
                                <span class="audit__who">@AuditActor.Display(e.ChangedBy, e.ChangedByUserId, e.EntityType)</span>
                                @AuditVerb(e.Action) <AuditSubjectText EntityType="e.EntityType" EntityId="e.EntityId" EntityName="@e.EntityName" SnapshotJson="@e.SnapshotJson" />
                                @* Leading space inside the <text> block, not
                                   before it: Razor strips the whitespace between
                                   </code> and an @if, which ran "#42" straight
                                   into "in Default". *@
                                @if (!string.IsNullOrEmpty(e.OrganizationName))
                                {
                                    <text> in @e.OrganizationName</text>
                                }
                            </span>
                            <StatusPill Tone="@AuditActionPill(e.Action)">@e.Action</StatusPill>
                            <Icon Name="chevron-right" Width="15" Height="15" Css="audit__caret" />
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (_total > PageSize)
        {
            <nav class="pager" aria-label="Audit log pages">
                <span class="pager__count">Page @_page of @TotalPages - @_total.ToString("N0") entries</span>
                <span class="pager__buttons">
                    @if (_page > 1)
                    {
                        <a class="btn btn--sm" href="@PageUrl(_page - 1)">
                            <Icon Name="chevron-left" Width="14" Height="14" />
                            <span>Previous</span>
                        </a>
                    }
                    else
                    {
                        <span class="btn btn--sm is-disabled" aria-hidden="true">
                            <Icon Name="chevron-left" Width="14" Height="14" />
                            <span>Previous</span>
                        </span>
                    }
                    @if (_page < TotalPages)
                    {
                        <a class="btn btn--sm" href="@PageUrl(_page + 1)">
                            <span>Next</span>
                            <Icon Name="chevron-right" Width="14" Height="14" />
                        </a>
                    }
                    else
                    {
                        <span class="btn btn--sm is-disabled" aria-hidden="true">
                            <span>Next</span>
                            <Icon Name="chevron-right" Width="14" Height="14" />
                        </span>
                    }
                </span>
            </nav>
        }
    </ChildContent>
</ListPage>

@code {
    private const int PageSize = 100;

    [SupplyParameterFromQuery(Name = "entityType")] public string? EntityType { get; set; }
    [SupplyParameterFromQuery(Name = "organizationId")] public int? OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "actor")] public string? Actor { get; set; }
    /// <summary>
    /// As the date picker posts it: a wall-clock time in the display zone, the
    /// same zone the rows below are shown in. Converted to UTC only for the query.
    /// </summary>
    [SupplyParameterFromQuery(Name = "from")] public string? FromInput { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToInput { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }

    private List<SiteAdminAuditRow>? _rows;
    private List<Organization>? _orgs;
    private int _total;
    private int _page = 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        _orgs = await SiteAdmin.ListOrganizationsAsync();
        _page = Page is int p && p > 1 ? p : 1;
        AuditEntityType? entity = Enum.TryParse<AuditEntityType>(EntityType, out var et) ? et : null;
        await Zone.EnsureLoadedAsync();
        var from = Zone.ParseInput(FromInput);
        var to = Zone.ParseInput(ToInput);
        var result = await SiteAdmin.SearchAuditAsync(
            entity, OrganizationId, Actor, from, to,
            skip: (_page - 1) * PageSize, take: PageSize);
        _rows = result.Rows.ToList();
        _total = result.Total;
    }

    /// <summary>
    /// Builds a page link that carries over the current filters - the page is
    /// static SSR, so pagination is plain bookmarkable anchors rather than
    /// interactive button handlers, matching the GET filter form above.
    /// </summary>
    private string PageUrl(int page)
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(EntityType)) query.Add($"entityType={Uri.EscapeDataString(EntityType)}");
        if (OrganizationId is int oid) query.Add($"organizationId={oid}");
        if (!string.IsNullOrEmpty(Actor)) query.Add($"actor={Uri.EscapeDataString(Actor)}");
        if (!string.IsNullOrEmpty(FromInput)) query.Add($"from={Uri.EscapeDataString(FromInput)}");
        if (!string.IsNullOrEmpty(ToInput)) query.Add($"to={Uri.EscapeDataString(ToInput)}");
        query.Add($"page={page}");
        return "/site-admin/audit?" + string.Join("&", query);
    }
}
