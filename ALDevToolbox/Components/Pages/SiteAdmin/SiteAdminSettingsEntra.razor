@page "/site-admin/settings/entra"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Operations
@inject SystemSettingsService Settings
@inject NavigationManager Nav

<PageTitle>Microsoft sign-in · Site administration · AL Workbench</PageTitle>

<SiteAdminSettingsPage ActiveTab="SiteAdminSettingsPage.Tab.Entra">
    <Alerts>
        <SettingsBanner Message="@Message" Ok="@Ok" SavedText="Microsoft sign-in settings saved." />
    </Alerts>
    <Body>
        @if (_view is null)
        {
            <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
        }
        else
        {
            @* The confirm fires only when a client id that *was* set is being
               emptied - that turns Microsoft sign-in off for every org relying
               on the shared registration, so it is not a change to make by
               accident. Inline because this form posts to a minimal API
               endpoint rather than through Blazor's event pipeline. *@
            <form method="post" action="/site-admin/settings/entra/save" id="settings-entra-form"
                  onsubmit="var f = this.elements['EntraClientId']; if (f.dataset.had === 'true' &amp;&amp; f.value.trim() === '') { return confirm('This will turn Microsoft sign-in off for every organisation on this server that relies on the shared registration, and remove the stored secret. Continue?'); } return true;">
                <AntiforgeryToken />
                <div class="setting-list">
                    <SettingRow Name="Redirect URI"
                                Hint="In the Entra admin center, add a Web platform with this address before you save here. Sign-in fails without it. Under Token configuration, also add auth_time as an optional ID token claim so a 'confirm it's you' Microsoft sign-in can be checked to have happened just now.">
                        <input class="input input--ro" type="text" value="@RedirectUri" readonly
                               aria-label="Redirect URI to copy into Microsoft Entra" />
                    </SettingRow>

                    <SettingRow Name="Application (client) ID"
                                Hint="From the app registration's Overview page in the Microsoft Entra admin center.">
                        <input class="input" type="text" name="EntraClientId" value="@_view.ClientId"
                               maxlength="36" autocomplete="off"
                               data-had="@(string.IsNullOrEmpty(_view.ClientId) ? "false" : "true")"
                               placeholder="e.g. 00000000-0000-0000-0000-000000000000" />
                    </SettingRow>

                    <SettingRow Name="Client secret"
                                Hint="Stored encrypted. Leave blank to keep the one already saved. Secrets expire - paste a new one before the old one lapses.">
                        <input class="input" type="password" name="EntraClientSecret" value=""
                               autocomplete="new-password"
                               placeholder="@(_view.HasClientSecret ? "Unchanged" : "Not set")" />
                        @if (_view.HasClientSecret)
                        {
                            <label class="check">
                                <input type="checkbox" name="ClearEntraClientSecret" value="true" />
                                <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
                                <span>Forget the saved secret</span>
                            </label>
                        }
                    </SettingRow>
                </div>
            </form>
        }
    </Body>
    <Foot>
        @if (_view is not null)
        {
            <button type="submit" form="settings-entra-form" class="btn btn--primary">
                <Icon Name="save" Width="16" Height="16" />
                <span>Save changes</span>
            </button>
        }
    </Foot>
    <Aside>
        <SettingsAside UpdatedAt="@_updatedAt">
            @if (_view is not null)
            {
                @* IsConfigured rather than a local: the unstyled-markup check
                   reads a bare identifier inside class="" as a CSS class name,
                   and a lowercase local would be reported as an undefined one. *@
                <Alert Tone="@(IsConfigured ? AlertTone.Success : AlertTone.Info)" Role="status">
                    <span>
                        @(IsConfigured
                            ? "Set up. Organisations can now turn Microsoft sign-in on for themselves."
                            : "Not set up yet - no organisation can offer Microsoft sign-in.")
                    </span>
                </Alert>
            }
            <Alert Tone="AlertTone.Info">
                <span>
                    One Microsoft app registration, shared by every organisation on this
                    site. Filling it in doesn't let anyone in on its own: each organisation
                    still turns Microsoft sign-in on, and lists which Microsoft organisations
                    may use it, on its own Administration → Identity page.
                </span>
            </Alert>
        </SettingsAside>
    </Aside>
</SiteAdminSettingsPage>

@code {
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private EntraAppView? _view;
    private DateTime? _updatedAt;

    private bool IsConfigured => !string.IsNullOrEmpty(_view?.ClientId);

    private string RedirectUri => Nav.BaseUri.TrimEnd('/') + "/signin-microsoft";

    protected override async Task OnInitializedAsync()
    {
        _view = await Settings.GetEntraAppViewAsync();
        // Entra lives on the same system_settings singleton as the rest of the
        // family, so that row's timestamp is this tab's "last saved" too.
        _updatedAt = (await Settings.GetViewAsync()).UpdatedAt;
    }
}
