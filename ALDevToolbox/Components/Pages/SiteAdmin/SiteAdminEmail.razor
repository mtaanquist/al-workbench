@*
    Where an operator goes when someone says "I never got the email".

    Written for a site operator who does not know how the sending works and
    should not need to: no queue, no worker, no token vocabulary. The page
    answers three questions in order - is mail going out at all, did anything
    fail, is anything still waiting - and every failure row names the person
    who did not get their mail and what the mail was for.

    The order matters. A site whose mail server has been misconfigured for a
    week has nothing in either list, so a page that led with two empty tables
    would look healthier than a working one. The count in the header is what
    tells those two apart, which is why it is the first thing on the page and
    says so plainly when it is zero.

    Message bodies are deliberately absent. The one for a reset link would
    carry a working reset link, and nothing here needs it. See issue #790.
*@

@page "/site-admin/email"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Services
@inject EmailOutbox Outbox
@inject TimeProvider Clock

<PageTitle>Email delivery · Site administration · AL Workbench</PageTitle>

<SiteAdminEmailHeader ActiveTab="SiteAdminEmailHeader.Tab.Delivery">
    <Sub>
        @if (_snapshot is null)
        {
            <span>Reset links, invites and sign-in links are sent in the background.</span>
        }
        else if (_snapshot.SentLastDay > 0)
        {
            <span>
                <strong>@_snapshot.SentLastDay email@(_snapshot.SentLastDay == 1 ? "" : "s")</strong>
                went out in the last 24 hours. Anything that never got through is listed below.
            </span>
        }
        else
        {
            <span>No email has gone out in the last 24 hours.</span>
        }
    </Sub>
    <Actions>
        <a class="btn btn--sm" href="/site-admin/email">
            <Icon Name="refresh-cw" Width="14" Height="14" />
            <span>Refresh</span>
        </a>
        <a class="btn btn--sm" href="/site-admin/settings/smtp">
            <Icon Name="server-cog" Width="14" Height="14" />
            <span>Email settings</span>
        </a>
    </Actions>
    <ChildContent>
        @if (_loadError is not null)
        {
            <section class="card">
                <div class="error-block">
                    <span class="error-block__icon"><Icon Name="circle-alert" Width="21" Height="21" /></span>
                    <span class="error-block__title">Could not read the email history</span>
                    <span class="error-block__text">The database did not answer. Try again in a moment.</span>
                    <span class="error-block__detail">@_loadError</span>
                </div>
            </section>
        }
        else if (_snapshot is null)
        {
            <section class="card">
                <div class="loading-block">
                    <span class="spinner"></span><span>Loading...</span>
                </div>
            </section>
        }
        else
        {
            @if (_snapshot.SentLastDay == 0 && NothingIsGettingThrough)
            {
                @* Nothing out and something stuck: the email server is the problem,
                   and saying "that can be normal" here would be wrong. *@
                <Alert Tone="AlertTone.Danger">
                    <span>
                        Nothing has gone out in the last 24 hours and email is not getting through.
                        Check <a href="/site-admin/settings/smtp">Email settings</a> and send yourself
                        a test email.
                    </span>
                </Alert>
            }
            else if (_snapshot.SentLastDay == 0)
            {
                @* The one state the two lists below cannot show: they are empty
                   because nothing is being sent at all, which looks identical to a
                   healthy site until someone says they never got their email. *@
                <Alert Tone="AlertTone.Warn">
                    <span>
                        Nothing has been sent in the last 24 hours. On a quiet site that is normal.
                        If someone was expecting an email, send yourself a test from
                        <a href="/site-admin/settings/smtp">Email settings</a> to check the connection.
                    </span>
                </Alert>
            }

            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Never got through</h2>
                        <p class="card__sub">
                            Tried several times over a few hours, then stopped. Nobody was warned - not the
                            person waiting for the email, and not you. These cannot be sent again from here:
                            once the cause is fixed, ask the person to request the email again.
                        </p>
                        @if (_snapshot.FailedTotal > _snapshot.Failed.Count)
                        {
                            <p class="card__sub">
                                Showing the @_snapshot.Failed.Count most recent of @_snapshot.FailedTotal.
                            </p>
                        }
                    </div>
                </div>

                @if (_snapshot.Failed.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-state__icon"><Icon Name="circle-check" Width="21" Height="21" /></span>
                        <span class="empty-state__title">Nothing has failed</span>
                        <span class="empty-state__text">
                            Nothing has been given up on in the last 30 days. If someone is missing an email,
                            ask them to check their spam folder and request it again. If it keeps happening,
                            check the email settings.
                        </span>
                        <span class="empty-state__action">
                            <a class="btn btn--sm" href="/site-admin/settings/smtp">Email settings</a>
                        </span>
                    </div>
                }
                else
                {
                    <table class="data-table data-table--edge">
                        <thead>
                            <tr>
                                <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                <th>Who it was for</th>
                                <th>What it was</th>
                                <th>Tried</th>
                                <th>First tried</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in _snapshot.Failed)
                        {
                            <tr class="@RowStateIcon.RowClass("failed")">
                                <td class="data-table__col-state">
                                    <RowStateIcon State="failed" Label="Never got through" />
                                </td>
                                <td>
                                    @row.ToEmail
                                    @if (row.OrganizationName is not null)
                                    {
                                        <div class="u-muted">@row.OrganizationName</div>
                                    }
                                </td>
                                <td>@Describe(row.Purpose)</td>
                                <td class="u-muted">@row.AttemptCount time@(row.AttemptCount == 1 ? "" : "s")</td>
                                <td class="u-muted"><Timestamp Value="@row.CreatedAt" /></td>
                            </tr>
                            @if (Reason(row.LastError) is { } reason)
                            {
                                <tr class="@RowStateIcon.RowClass("failed")">
                                    <td></td>
                                    <td colspan="4">
                                        <div class="code-block">
                                            <div class="code-block__bar">
                                                <span class="code-block__name">What the email server said</span>
                                            </div>
                                            <pre>@reason</pre>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                }
            </section>

            <section class="card">
                <div class="card__head">
                    <div>
                        <h2 class="card__title">Still waiting</h2>
                        <p class="card__sub">Sent within a minute or so, and tried again for a few hours if it does not get through.</p>
                        @if (_snapshot.WaitingTotal > _snapshot.Waiting.Count)
                        {
                            <p class="card__sub">
                                Showing the @_snapshot.Waiting.Count most recent of @_snapshot.WaitingTotal.
                            </p>
                        }
                    </div>
                </div>

                @if (_snapshot.Waiting.Count == 0)
                {
                    <div class="empty-state empty-state--quiet">
                        <span class="empty-state__title">Nothing waiting</span>
                    </div>
                }
                else
                {
                    <table class="data-table data-table--edge">
                        <thead>
                            <tr>
                                <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                <th>Who it is for</th>
                                <th>What it is</th>
                                <th>Tried</th>
                                <th>Next try</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in _snapshot.Waiting)
                        {
                            <tr class="@RowStateIcon.RowClass("pending")">
                                <td class="data-table__col-state">
                                    <RowStateIcon State="pending" Label="Waiting to send" />
                                </td>
                                <td>
                                    @row.ToEmail
                                    @if (row.OrganizationName is not null)
                                    {
                                        <div class="u-muted">@row.OrganizationName</div>
                                    }
                                </td>
                                <td>@Describe(row.Purpose)</td>
                                <td class="u-muted">
                                    @(row.AttemptCount == 0 ? "Not yet" : $"{row.AttemptCount} time{(row.AttemptCount == 1 ? "" : "s")}")
                                </td>
                                <td class="u-muted"><Timestamp Value="@row.NextAttemptAt" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </section>

            <p class="u-muted">As of <Timestamp Value="@_loadedAt" />.</p>
        }
    </ChildContent>
</SiteAdminEmailHeader>

@code {
    private EmailOutboxSnapshot? _snapshot;

    /// <summary>
    /// True when something has already failed at least once. A message merely
    /// waiting its first turn is not evidence of anything - it arrived seconds ago.
    /// </summary>
    private bool NothingIsGettingThrough =>
        _snapshot is not null
        && (_snapshot.Failed.Count > 0 || _snapshot.Waiting.Any(w => w.AttemptCount > 0));
    private string? _loadError;
    private DateTime _loadedAt;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snapshot = await Outbox.SnapshotAsync();
            _loadedAt = Clock.GetUtcNow().UtcDateTime;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    /// <summary>
    /// What the email was, in the words of someone who would have been waiting
    /// for it. Noun phrases throughout: the column sits next to a recipient
    /// address, so "Verify your email address" would read as addressed to the
    /// operator. <c>EmailPurposeLabelTests</c> keeps every value mapped, so the
    /// fallback is a plain last resort rather than the enum name leaking out.
    /// </summary>
    public static string Describe(EmailPurpose purpose) => purpose switch
    {
        EmailPurpose.SignupVerification => "Email address verification",
        EmailPurpose.SignupPendingNotice => "New signup - notice to admins",
        EmailPurpose.SignupDecision => "Signup decision",
        EmailPurpose.PasswordReset => "Password reset link",
        EmailPurpose.MagicLink => "Sign-in link",
        EmailPurpose.Invite => "Invitation to join",
        EmailPurpose.EmailChangeConfirmation => "New email address confirmation",
        EmailPurpose.MfaCode => "Two-factor code",
        EmailPurpose.SiteAdminTest => "Test email",
        EmailPurpose.BuildNotification => "Build notification",
        EmailPurpose.DeploymentNotification => "Deployment notification",
        EmailPurpose.UpgradeNotification => "Upgrade notification",
        EmailPurpose.SolutionNotification => "Solution notification",
        EmailPurpose.NotificationDigest => "Daily or weekly digest",
        _ => "Other email",
    };

    /// <summary>
    /// The readable part of what the server said. The stored text is whatever
    /// the mail library raised, which leads with its own class name and can run
    /// to a stack trace; the first line after that prefix is the sentence an
    /// operator can act on, and the rest is in the logs.
    /// </summary>
    public static string? Reason(string? lastError)
    {
        if (string.IsNullOrWhiteSpace(lastError)) return null;
        var firstLine = lastError.Split('\n', StringSplitOptions.RemoveEmptyEntries)[0].Trim();
        // "MailKit.Net.Smtp.SmtpCommandException: 5.7.57 Client was not authenticated"
        // carries one useful half. Only strip a prefix that really is a type
        // name, so a server that answers "550: no such user" keeps its code.
        var colon = firstLine.IndexOf(": ", StringComparison.Ordinal);
        if (colon > 0)
        {
            var prefix = firstLine[..colon];
            if (prefix.Contains('.') && !prefix.Contains(' ')) firstLine = firstLine[(colon + 2)..].Trim();
        }
        return firstLine.Length == 0 ? null : firstLine;
    }
}
