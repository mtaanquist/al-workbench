@page "/site-admin/users"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Account
@inject SiteAdminService SiteAdmin
@inject NavigationManager Navigation

<PageTitle>Users · Site administration · AL Workbench</PageTitle>

<div class="page">
    <PageHead Title="Users"
              Trail='@([new("Site administration", "/site-admin"), new("Users")])'>
        <SubtitleContent>
            Everyone on this site, across every organisation. This is where you
            decide who else can run the site itself. Roles <em>inside</em> an
            organisation are set by that organisation's own admin, on their
            Administration page - not here.
        </SubtitleContent>
    </PageHead>

    @if (!string.IsNullOrEmpty(Error))
    {
        <Alert Tone="AlertTone.Danger">
            <span>@Error</span>
        </Alert>
    }
    @if (Ok == "promoted")
    {
        <Alert Tone="AlertTone.Success">
            <span>They can now run the site.</span>
        </Alert>
    }
    else if (Ok == "demoted")
    {
        <Alert Tone="AlertTone.Success">
            <span>They can no longer run the site. Their own organisation is unaffected.</span>
        </Alert>
    }

    <form method="get" action="/site-admin/users" class="filter-bar">
        <label for="q" class="u-sr">Search by email or name</label>
        <span class="filter-bar__search">
            <input id="q" name="q" type="search" value="@Query" class="input"
                   placeholder="e.g. kirsten@cronus.com"
                   data-page-search aria-keyshortcuts="F3" title="Search by email or name (F3)" />
        </span>
        <button type="submit" class="btn btn--sm">
            <Icon Name="search" Width="14" Height="14" />
            <span>Search</span>
        </button>
    </form>

    <section class="card">
        @if (_rows is null)
        {
            <div class="loading-block">
                <span class="spinner"></span><span>Loading...</span>
            </div>
        }
        else if (_rows.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="users" Width="21" Height="21" /></span>
                <span class="empty-state__title">
                    @(string.IsNullOrEmpty(Query) ? "Nobody has signed up yet" : "Nothing matched that search")
                </span>
                <span class="empty-state__text">
                    @(string.IsNullOrEmpty(Query)
                        ? "As soon as someone signs up, they appear here."
                        : "Try part of an email address or a first name.")
                </span>
                @if (!string.IsNullOrEmpty(Query))
                {
                    <span class="empty-state__action">
                        <a class="btn btn--sm" href="/site-admin/users">Show everyone</a>
                    </span>
                }
            </div>
        }
        else
        {
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                        <th>Email</th>
                        <th>Name</th>
                        <th>Organisation</th>
                        <th>Role there</th>
                        <th>Runs the site</th>
                        <th>Last signed in</th>
                        <th class="data-table__actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in _rows)
                {
                    var state = u.Status.ToString().ToLowerInvariant();
                    <tr class="@RowStateIcon.RowClass(state)">
                        <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                        <td>@u.Email</td>
                        <td>@u.DisplayName</td>
                        @* Slug on its own line, as on the Storage page. Inline it
                           ran straight on from the name: "CRONUS Ltd. default". *@
                        <td>@u.OrganizationName<div class="u-muted">@u.OrganizationSlug</div></td>
                        <td>@u.Role</td>
                        <td>
                            @if (u.IsSiteAdmin)
                            {
                                <span class="tag">Yes</span>
                            }
                        </td>
                        <td class="u-muted"><Timestamp Value="@u.LastLoginAt" Placeholder="Never" /></td>
                        <td class="data-table__actions">
                            @* Neither is the page's primary action - there is no one
                               thing you come here to do, and a primary button on
                               every row of a table means none of them stands out.

                               In the kebab since #574. The labels are sentences
                               ("Stop them running the site"), which is right for a
                               consequence this size and wrong for a table cell: at
                               200px of a 934px table the actions column opened the
                               content column and the right of the page was clipped.
                               A menu is where a sentence-long label belongs. *@
                            <RowActions Label="@($"Actions for {u.Email}")">
                            @if (u.IsSiteAdmin)
                            {
                                @* Static-SSR page, so this is the same onsubmit
                                   confirm the backups table uses rather than
                                   ConfirmDialog, which needs a circuit.

                                   The message deliberately does NOT interpolate
                                   the email. Razor encodes it for the attribute,
                                   the browser decodes it again before the JS
                                   parser sees it, and an apostrophe would then
                                   terminate the string literal. The row being
                                   confirmed is the one you clicked, so "this
                                   person" is unambiguous anyway. *@
                                <form method="post" action="/site-admin/users/@u.UserId/demote"
                                      onsubmit="return confirm('Stop this person running the site? They keep their access inside their own organisation.');">
                                    <AntiforgeryToken />
                                    <button type="submit" class="menu__item menu__item--danger" role="menuitem">
                                        <Icon Name="shield-off" Width="15" Height="15" Css="menu__icon" />
                                        <span>Stop them running the site</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="/site-admin/users/@u.UserId/promote"
                                      onsubmit="return confirm('Let this person run the site? They will be able to see and change every organisation on it.');">
                                    <AntiforgeryToken />
                                    <button type="submit" class="menu__item" role="menuitem">
                                        <Icon Name="shield" Width="15" Height="15" Css="menu__icon" />
                                        <span>Let them run the site</span>
                                    </button>
                                </form>
                            }
                            </RowActions>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }

    private List<SiteAdminUserRow>? _rows;

    protected override async Task OnInitializedAsync()
    {
        _rows = await SiteAdmin.SearchUsersAsync(Query);
    }
}
