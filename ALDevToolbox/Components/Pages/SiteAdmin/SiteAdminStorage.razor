@page "/site-admin/backup-storage/storage"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.SingleTenant
@using ALDevToolbox.Services.Organizations
@inject DatabaseUsageService Usage
@inject ISingleTenantMode SingleTenant
@inject NavigationManager Nav

<PageTitle>Space used · Site administration · AL Workbench</PageTitle>

<SiteAdminBackupStorageHeader ActiveTab="SiteAdminBackupStorageHeader.Tab.Storage">
    @if (Ok == "quota-saved")
    {
        <Alert Tone="AlertTone.Success">
            <span>Limit saved.</span>
        </Alert>
    }
    @if (!string.IsNullOrEmpty(Msg))
    {
        <Alert Tone="AlertTone.Danger">
            <span>@Msg</span>
        </Alert>
    }

    <section class="card">
        <div class="card__head">
            <div>
                <h2 class="card__title">Space used by each organisation</h2>
                <p class="card__sub">
                    Counted against the limit: their own data, plus a share of the
                    space the database uses to keep it fast to search. Set the share
                    on the <a href="/site-admin/settings/quotas">Storage quotas</a> tab.
                    The figures are close estimates, not exact measurements.
                </p>
            </div>
            @if (_rows is { Count: > 0 })
            {
                <span class="form-actions__note">
                    @if (LatestMeasurement() is { } measured)
                    {
                        <text>Measured <Timestamp Value="@measured" />, and again every hour</text>
                    }
                    else
                    {
                        <text>Not measured yet - the first measurement runs shortly after start-up</text>
                    }
                </span>
            }
        </div>

        @if (_rows is null)
        {
            <div class="loading-block">
                <span class="spinner"></span><span>Loading...</span>
            </div>
        }
        else if (_rows.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="hard-drive" Width="21" Height="21" /></span>
                <span class="empty-state__title">No organisations yet</span>
                <span class="empty-state__text">
                    Once someone signs up and an organisation exists, its size shows up here.
                </span>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Organisation</th>
                        <th class="data-table__num">Their data</th>
                        <th class="data-table__num" title="The extra space the database uses to keep their data fast to search.">Search data</th>
                        <th class="data-table__num">On disk</th>
                        <th class="data-table__num">Counts as</th>
                        <th class="data-table__num">Limit</th>
                        <th class="data-table__num">Used</th>
                        <th class="data-table__actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>
                            @r.Name
                            @if (r.IsSystem)
                            {
                                <span class="tag">System</span>
                            }
                            <div class="u-muted">@r.Slug</div>
                        </td>
                        <td class="data-table__num">@FormatBytes(r.LogicalBytes)</td>
                        <td class="data-table__num">@FormatBytes(r.IndexBytes)</td>
                        <td class="data-table__num">@FormatBytes(r.TotalBytes)</td>
                        <td class="data-table__num">@FormatBytes(r.BillableBytes)</td>
                        <td class="data-table__num">
                            @(r.EffectiveQuotaMb is { } q ? $"{q} MB" : "No limit")
                            @if (r.OrgOverrideMb is null && r.SystemDefaultMb is not null)
                            {
                                <div class="u-muted">site default</div>
                            }
                        </td>
                        <td class="data-table__num">
                            @if (r.UsedFraction is { } used)
                            {
                                <span>@($"{used * 100:0.0}%")</span>
                            }
                            else
                            {
                                <span class="u-muted">-</span>
                            }
                        </td>
                        <td class="data-table__actions">
                            <form method="post" action="@($"/site-admin/storage/{r.OrganizationId}/quota")"
                                  class="u-row">
                                <AntiforgeryToken />
                                <input type="number" name="QuotaMb" min="0" step="1"
                                       value="@(r.OrgOverrideMb?.ToString() ?? string.Empty)"
                                       placeholder="Site default"
                                       aria-label="@($"Limit for {r.Name}, in MB")"
                                       class="input input--num" style="width: 108px" />
                                <button type="submit" class="btn btn--sm">Save</button>
                            </form>
                            @if (!r.IsSystem)
                            {
                                <form method="post" action="@($"/site-admin/storage/{r.OrganizationId}/backup")">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn btn--sm">Back up now</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</SiteAdminBackupStorageHeader>

@code {
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Msg { get; set; }

    private IReadOnlyList<DatabaseUsageService.OrgUsageRow>? _rows;

    protected override async Task OnInitializedAsync()
    {
        // Storage quotas are a multi-tenant surface - hidden in single-tenant
        // deployments. Bounce a typed URL back to the surviving first tab.
        if (SingleTenant.IsEnabled)
        {
            Nav.NavigateTo("/site-admin/backup-storage/database", replace: true);
            return;
        }
        // Reads the background-maintained snapshots, not a live count - the
        // live sweep counts every tenanted table and is too slow for a page load.
        _rows = await Usage.ListFromSnapshotsAsync(CancellationToken.None);
    }

    /// <summary>
    /// These figures are up to an hour old, which matters when an admin is
    /// watching a number they just changed. Says so next to them rather than in
    /// a paragraph above the card.
    /// </summary>
    private DateTime? LatestMeasurement()
    {
        if (_rows is null) return null;
        DateTime? latest = null;
        foreach (var r in _rows)
        {
            if (r.ComputedAt is { } at && (latest is null || at > latest)) latest = at;
        }
        return latest;
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        double v = bytes;
        string[] units = ["KB", "MB", "GB", "TB"];
        var i = -1;
        do
        {
            v /= 1024;
            i++;
        } while (v >= 1024 && i < units.Length - 1);
        return $"{v:0.#} {units[i]}";
    }
}
