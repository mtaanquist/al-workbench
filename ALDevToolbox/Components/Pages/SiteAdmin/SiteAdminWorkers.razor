@page "/site-admin/workers"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.ObjectExplorer.Delivery
@using ALDevToolbox.Services.ObjectExplorer.Import
@using ALDevToolbox.Services.ObjectExplorer.Projects
@using ALDevToolbox.Services.ObjectExplorer
@using ALDevToolbox.Services.Workers
@inject WorkerHeartbeatRegistry Heartbeats
@inject PersistedImportJobs ImportJobs
@inject ProjectBuildQueue Builds
@inject TimeProvider Clock

<PageTitle>Background workers · Site administration · AL Workbench</PageTitle>

<div class="page">
    <PageHead Title="Background workers"
              Trail='@([new("Site administration", "/site-admin"), new("Background workers")])'>
        <SubtitleContent>
            The jobs this site runs on its own, and whether they are keeping up.
            An unhealthy worker here is what turns <code class="code">/healthz</code> red.
        </SubtitleContent>
    </PageHead>

    <section class="card">
        <div class="card__head">
            <div><h2 class="card__title">Worker health</h2></div>
            <a class="btn btn--sm" href="/site-admin/workers">
                <Icon Name="refresh-cw" Width="14" Height="14" />
                <span>Refresh</span>
            </a>
        </div>
        @if (_heartbeats is null)
        {
            <div class="loading-block">
                <span class="spinner"></span><span>Loading...</span>
            </div>
        }
        else if (_heartbeats.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="clock" Width="21" Height="21" /></span>
                <span class="empty-state__title">Nothing reporting in yet</span>
                <span class="empty-state__text">The site is probably still starting up.</span>
                <span class="empty-state__action">
                    <a class="btn btn--sm" href="/site-admin/workers">Check again</a>
                </span>
            </div>
        }
        else
        {
            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                        <th>Worker</th>
                        <th>Busy since</th>
                        <th>Last heard from</th>
                        <th title="A worker counts as stuck if it stays busy longer than this, or goes quiet for longer than this.">Counts as stuck after</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in _heartbeats)
                {
                    <tr class="@RowStateIcon.RowClass(row.Healthy ? "healthy" : "unhealthy")">
                        <td class="data-table__col-state">
                            <RowStateIcon State="@(row.Healthy ? "healthy" : "unhealthy")"
                                          Label="@(row.Healthy ? "Keeping up" : $"Stuck - {row.Reason}")" />
                        </td>
                        <td>
                            @(row.Plain ?? Friendly(row.Name))
                            <div class="u-muted">@row.Name</div>
                        </td>
                        <td class="u-muted"><Timestamp Value="@row.ActiveSinceUtc" Format="yyyy-MM-dd HH:mm:ss" Placeholder="Not busy" /></td>
                        <td class="u-muted"><Timestamp Value="@row.LastTickUtc" Format="yyyy-MM-dd HH:mm:ss" Placeholder="Never" /></td>
                        <td class="u-muted">
                            @FormatSpan(row.MaxActiveDuration) busy@(
                                row.MaxIdleSilence is null ? "" : $", {FormatSpan(row.MaxIdleSilence.Value)} silent"
                            )
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="card">
        <div class="card__head">
            <div>
                <h2 class="card__title">Object Explorer imports</h2>
                @if (_queue is not null)
                {
                    <p class="card__sub">@_queue.Pending waiting or in progress right now.</p>
                }
            </div>
        </div>

        @if (_queue is null)
        {
            <div class="loading-block">
                <span class="spinner"></span><span>Loading...</span>
            </div>
        }
        else if (_queue.Recent.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><Icon Name="package" Width="21" Height="21" /></span>
                <span class="empty-state__title">No imports yet</span>
                <span class="empty-state__text">
                    Releases imported into Object Explorer show up here while they run,
                    and stay listed afterwards.
                </span>
            </div>
        }
        else
        {
            @foreach (var f in _queue.Recent.Where(j => j.Status == "failed" && !string.IsNullOrWhiteSpace(j.ErrorMessage)))
            {
                <div class="card__body">
                    <div class="code-block">
                        <div class="code-block__bar">
                            <span class="code-block__name">
                                <a href="/object-explorer/release/@f.ReleaseId">@(f.ReleaseLabel ?? $"Release {f.ReleaseId}")</a>
                                failed <Timestamp Value="@f.CompletedAt" Format="yyyy-MM-dd HH:mm:ss" />
                            </span>
                        </div>
                        <pre>@f.ErrorMessage</pre>
                    </div>
                </div>
            }

            <table class="data-table data-table--edge">
                <thead>
                    <tr>
                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                        <th>Job</th>
                        <th>Release</th>
                        <th>Kind</th>
                        <th>Submitted</th>
                        <th>Started</th>
                        <th>Finished</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var j in _queue.Recent)
                {
                    <tr class="@RowStateIcon.RowClass(j.Status)">
                        <td class="data-table__col-state">
                            <RowStateIcon State="@j.Status" />
                        </td>
                        <td class="u-muted">#@j.Id</td>
                        <td>
                            <a href="/object-explorer/release/@j.ReleaseId">@(j.ReleaseLabel ?? j.ReleaseId.ToString())</a>
                        </td>
                        <td class="u-muted">@j.Kind</td>
                        <td class="u-muted"><Timestamp Value="@j.CreatedAt" /></td>
                        <td class="u-muted"><Timestamp Value="@j.StartedAt" Placeholder="-" /></td>
                        <td class="u-muted"><Timestamp Value="@j.CompletedAt" Placeholder="-" /></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</div>

@code {
    private List<HeartbeatRow>? _heartbeats;
    private ImportQueueSnapshot? _queue;

    protected override async Task OnInitializedAsync()
    {
        var now = Clock.GetUtcNow().UtcDateTime;
        _heartbeats = Rows(Heartbeats.All(), now, Builds.Limit);
        _queue = await ImportJobs.SnapshotAsync();
    }

    /// <summary>
    /// Plain name for a worker, keyed by its type name.
    /// </summary>
    /// <remarks>
    /// The registry keys on the class name, and the logs print the same string,
    /// so the technical name has to stay visible -- correlating this page with a
    /// log line is the whole reason to open it. But it cannot be the *only*
    /// thing shown: "OffsiteRestoreWorker is stuck" tells an operator who never
    /// read the source nothing about what has stopped working. Both, with the
    /// plain one first.
    ///
    /// An unmapped worker falls back to its type name rather than to something
    /// invented, so a new one added elsewhere degrades to today's behaviour.
    /// </remarks>
    private static string Friendly(string name) => name switch
    {
        "BackupScheduler" => "Nightly backup",
        "DeliveryScheduler" => "Scheduled deployments to Business Central",
        "EmailOutboxScheduler" => "Sending email",
        "LoginAttemptPruneScheduler" => "Sign-in log clean-up",
        "ObjectExplorerVacuumScheduler" => "Reclaiming Object Explorer disk space",
        "OffsiteRestoreWorker" => "Downloading from off-site storage",
        "ProjectDiscoveryWorker" => "Preparing the pipeline editor's app list",
        "ReleaseAutoImportScheduler" => "Automatic BC release import",
        "ReleaseImportWorker" => "Importing a BC release",
        "UsageSnapshotScheduler" => "Measuring storage used",
        _ => name,
    };

    private const string BuildWorkerPrefix = nameof(ProjectBuildWorker) + " ";
    private const string DeliveryWorkerPrefix = nameof(DeliveryWorker) + " ";

    /// <summary>
    /// One row per worker, except the build workers waiting for work, which share one, and
    /// likewise the deployment workers (#1139).
    /// </summary>
    /// <remarks>
    /// All <see cref="ProjectBuildQueue.MaxConcurrency"/> build workers are always
    /// running so a new build limit applies without a restart (#1164), but at most the
    /// limit of them are ever busy. Sixteen identical "not busy" rows would bury the
    /// workers worth reading, so the idle, healthy ones fold into a single row. A build
    /// worker that is busy or stuck keeps a row of its own, so a stuck build still
    /// names the worker the logs name. Idle build workers need no beat to stay healthy:
    /// queue workers opt out of the silence check (see <see cref="WorkerHeartbeat"/>).
    /// </remarks>
    internal static List<HeartbeatRow> Rows(IEnumerable<WorkerHeartbeat> heartbeats, DateTime now, int buildLimit)
    {
        var rows = new List<HeartbeatRow>();
        var idleBuilders = new List<HeartbeatRow>();
        var idleDeliverers = new List<HeartbeatRow>();
        foreach (var h in heartbeats)
        {
            var healthy = h.IsHealthy(now, out var reason);
            var row = new HeartbeatRow(h.Name, h.LastTickUtc, h.ActiveSinceUtc, h.MaxActiveDuration, h.MaxIdleSilence, healthy, reason);
            var idle = healthy && h.ActiveSinceUtc is null;
            if (h.Name.StartsWith(BuildWorkerPrefix, StringComparison.Ordinal))
            {
                if (idle) idleBuilders.Add(row);
                else rows.Add(row with { Plain = "Running a build" });
            }
            else if (h.Name.StartsWith(DeliveryWorkerPrefix, StringComparison.Ordinal))
            {
                if (idle) idleDeliverers.Add(row);
                else rows.Add(row with { Plain = "Deploying to Business Central" });
            }
            else
            {
                rows.Add(row);
            }
        }
        if (idleBuilders.Count > 0)
        {
            rows.Add(Folded(idleBuilders, nameof(ProjectBuildWorker),
                $"Waiting for builds ({idleBuilders.Count} ready, up to {buildLimit} run at once)"));
        }
        if (idleDeliverers.Count > 0)
        {
            rows.Add(Folded(idleDeliverers, nameof(DeliveryWorker),
                $"Waiting for deployments ({idleDeliverers.Count} ready)"));
        }
        return rows
            .OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static HeartbeatRow Folded(List<HeartbeatRow> idle, string worker, string plain) =>
        new(
            Name: $"{worker} x{idle.Count}",
            LastTickUtc: idle.Max(r => r.LastTickUtc),
            ActiveSinceUtc: null,
            MaxActiveDuration: idle[0].MaxActiveDuration,
            MaxIdleSilence: idle[0].MaxIdleSilence,
            Healthy: true,
            Reason: null)
        {
            Plain = plain,
        };

    private static string FormatSpan(TimeSpan span) =>
        span.TotalHours >= 1 ? $"{span.TotalHours:N0}h" :
        span.TotalMinutes >= 1 ? $"{span.TotalMinutes:N0}m" :
        $"{span.TotalSeconds:N0}s";

    internal sealed record HeartbeatRow(
        string Name,
        DateTime? LastTickUtc,
        DateTime? ActiveSinceUtc,
        TimeSpan MaxActiveDuration,
        TimeSpan? MaxIdleSilence,
        bool Healthy,
        string? Reason)
    {
        /// <summary>The plain name, when it is not the one <see cref="Friendly"/> gives.</summary>
        public string? Plain { get; init; }
    }
}
