@page "/site-admin/audit/{id:int}/diff"
@attribute [Authorize(Roles = HttpOrganizationContext.SiteAdminRole)]
@inject AppDbContext Db
@inject ALDevToolbox.Services.Organizations.DisplayTimeZone Zone
@using ALDevToolbox.Data
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Components.Shared
@using Microsoft.EntityFrameworkCore
@using static ALDevToolbox.Components.Shared.AdminPageHelpers

@*
    SiteAdmin version of the audit-diff page. The org filter is bypassed via
    IgnoreQueryFilters() because the SiteAdmin audit search spans every
    organisation; see SiteAdminService.SearchAuditAsync.
*@

<PageTitle>Audit change · Site administration · AL Workbench</PageTitle>

@* Crumbs where this page used to have a "Back to audit log" button: the detail
   sheet has no back button, and the crumb is the same link in the place every
   other detail page keeps it. *@
<DetailPage IsLoading="@(_entry is null)" LoadingText="Loading change..." IsNotFound="@_notFound"
            Title="@TitleText" TitleTooltip="@(_entry is null ? null : $"{_entry.EntityType} #{_entry.EntityId}")">
    <NotFound>
        <div class="card">
            <EmptyState Icon="circle-alert" Title="That change is not here" Heading="true">
                <Text>
                There is no audit entry <code>#@Id</code> on this deployment. It may
                have been removed with the record it described.
                </Text>
                <Action><a class="btn" href="/site-admin/audit">Back to audit log</a></Action>
            </EmptyState>
        </div>
    </NotFound>
    <Crumbs>
        <a href="/site-admin/audit">Audit log</a>
        <Icon Name="chevron-right" Width="12" Height="12" />
        <span>Change #@Id</span>
    </Crumbs>
    <TitleRow>
        <StatusPill Tone="@AuditActionPill(_entry!.Action)">@_entry.Action</StatusPill>
    </TitleRow>
    <SubtitleContent>
        What changed when @AuditActor.Display(_entry!) @AuditVerb(_entry!.Action) this record.
        The "after" side is taken from the next change to the same record in the
        same organisation, so the most recent change has nothing to compare
        against yet.
    </SubtitleContent>
    <Meta>
        <div class="meta-item">
            <span class="meta-item__label">When</span>
            <span class="meta-item__value"><Timestamp Value="@_entry!.Timestamp" Format="yyyy-MM-dd HH:mm:ss" /></span>
        </div>
        <div class="meta-item">
            <span class="meta-item__label">Changed by</span>
            <span class="meta-item__value">@AuditActor.Display(_entry!)</span>
        </div>
        <div class="meta-item">
            <span class="meta-item__label">Organisation</span>
            <span class="meta-item__value">@(_organizationName ?? "Not recorded")</span>
        </div>
    </Meta>
    <ChildContent>
        <AuditDiffViewer
            BeforeJson="@_beforeJson"
            AfterJson="@_afterJson"
            BeforeLabel="@_beforeLabel"
            AfterLabel="@_afterLabel" />
    </ChildContent>
</DetailPage>

@code {
    /// <summary>The kind of record, and its name when the snapshot carries one.</summary>
    private string TitleText => _entry is null ? string.Empty
        : AuditSubjectOf(_entry).Name is { } subject
            ? $"{FriendlyAuditType(_entry.EntityType)}: {subject}"
            : FriendlyAuditType(_entry.EntityType);

    [Parameter] public int Id { get; set; }

    private AuditLogEntry? _entry;
    private string? _organizationName;
    private bool _notFound;
    private string? _beforeJson;
    private string? _afterJson;
    private string? _beforeLabel;
    private string? _afterLabel;

    protected override async Task OnInitializedAsync()
    {
        // Fence category 2 (SiteAdmin cross-org console): audit_log gained a
        // tenant query filter in #678; this page is the SiteAdmin diff viewer
        // and must open a row from any organisation. The route is behind the
        // SiteAdmin authorization policy ([Authorize(Roles = SiteAdminRole)]).
        var entry = await Db.AuditLog
            .IgnoreQueryFilters()
            .AsNoTracking()
            .Include(e => e.Organization)
            .FirstOrDefaultAsync(e => e.Id == Id);
        if (entry is null)
        {
            _notFound = true;
            _entry = new AuditLogEntry();
            return;
        }
        _entry = entry;
        _organizationName = entry.Organization?.Name;
        _beforeJson = entry.SnapshotJson;
        // The diff's labels are plain text, so they are formatted here, in the
        // organisation's display zone like every other time on the page.
        await Zone.EnsureLoadedAsync();
        _beforeLabel = entry.Action == AuditAction.Created
            ? "no prior state (created)"
            : Zone.Format(entry.Timestamp, "yyyy-MM-dd HH:mm:ss");

        // Fence category 2 (SiteAdmin cross-org console): same category as the
        // lookup above — the "after" snapshot lives in the same org as the
        // entry we just loaded (the predicate below pins it to that org).
        var next = await Db.AuditLog
            .IgnoreQueryFilters()
            .AsNoTracking()
            .Where(e => e.EntityType == entry.EntityType
                        && e.EntityId == entry.EntityId
                        && e.OrganizationId == entry.OrganizationId
                        && (e.Timestamp > entry.Timestamp
                            || (e.Timestamp == entry.Timestamp && e.Id > entry.Id)))
            .OrderBy(e => e.Timestamp)
            .ThenBy(e => e.Id)
            .FirstOrDefaultAsync();

        if (next is not null)
        {
            _afterJson = next.SnapshotJson;
            _afterLabel = Zone.Format(next.Timestamp, "yyyy-MM-dd HH:mm:ss");
        }
        else if (entry.Action == AuditAction.Deleted)
        {
            _afterJson = null;
            _afterLabel = "deleted (no later state)";
        }
        else
        {
            _afterJson = null;
            _afterLabel = "no later audit entry recorded yet";
        }
    }
}
