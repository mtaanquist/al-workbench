@page "/signup"
@layout ALDevToolbox.Components.Layout.AuthLayout
@using ALDevToolbox.Components.Shared
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Account
@inject IEmailService Email
@inject ALDevToolbox.Services.SingleTenant.ISingleTenantMode SingleTenant

<PageTitle>Sign up · AL Workbench</PageTitle>

@*
    Sign up, on the auth-card archetype. Four states rather than one page with
    everything on it at once:

      1. approved   - the .auth__ok card, nothing left to do
      2. code       - "check your email", with the code field right there
      3. by email   - ask for an address, we send a link (SMTP configured)
      4. full form  - everything at once (no SMTP, so no link to send)

    State 2 replaces a <details open="...">"Already have a code?"</details> that
    sat under the form. That was a mechanic being explained: having just been
    told a code is on its way, the reader had to notice a disclosure triangle to
    find where to type it. Now the confirmation *is* where you type it, and the
    people who arrive later with a code have a plain link to the same card.
*@

@if (Ok == "pending")
{
    <AuthCard>
        <Head>
            <div class="auth__ok">
                <span class="auth__ok-icon"><Icon Name="circle-check" Width="20" Height="20" /></span>
                <h1 class="auth__title">We've asked for approval</h1>
                <p class="auth__sub">
                    Someone at your organisation has to approve new accounts. We'll email
                    you as soon as yours is approved.
                </p>
            </div>
        </Head>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
    </AuthCard>
}
else if (ShowCodeCard)
{
    <AuthCard FormAction="/auth/signup/verify-code">
        <Head>
            <div class="auth__ok">
                <span class="auth__ok-icon"><Icon Name="mail" Width="20" Height="20" /></span>
                <h1 class="auth__title">Check your email</h1>
                <p class="auth__sub">
                    @if (CodeEntry == "1")
                    {
                        <text>Enter your email and the six-digit code from the confirmation email we sent you.</text>
                    }
                    else
                    {
                        <text>Click the link we sent, or type the six-digit code from it below.</text>
                    }
                </p>
                @if (!string.IsNullOrEmpty(EmailValue))
                {
                    <span class="auth__mail">@EmailValue</span>
                }
                <p class="auth__sub">The link and the code both expire in 30 minutes.</p>
            </div>
        </Head>
        <Alerts>
            @if (Error == "code-invalid")
            {
                <Alert Tone="AlertTone.Danger">
                    <span>That code didn't match. Check the email and try again, or ask for a new one.</span>
                </Alert>
            }
            else if (Error == "verify-invalid")
            {
                <Alert Tone="AlertTone.Danger">
                    <span>That link has expired. Enter your email again to get a new one.</span>
                </Alert>
            }
        </Alerts>
        <ChildContent>
            <div class="auth__fields">
                <div class="field">
                    <label class="field__label" for="su-code-email">Email</label>
                    <input class="input" id="su-code-email" type="email" name="Email" value="@EmailValue"
                           required autocomplete="username" placeholder="you@cronus.example" />
                </div>
                <div class="field">
                    <label class="field__label" for="su-code">Six-digit code</label>
                    <input class="input" id="su-code" type="text" name="Code" inputmode="numeric"
                           pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code"
                           placeholder="123456" autofocus />
                </div>
            </div>
            <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg)">
                <Icon Name="check" Width="16" Height="16" />
                <span>Continue</span>
            </button>
            <div class="auth__sso">
                <span class="auth__or">or</span>
                @* Navigates back to the one-field form; it does not itself send. *@
                <a class="btn" href="/signup">Use a different email address</a>
            </div>
        </ChildContent>
        <Foot>
            <a class="auth__link" href="/login">Back to sign in</a>
        </Foot>
        <Legal>Nothing after a few minutes? Check your spam folder, then ask whoever gave you this address for help.</Legal>
    </AuthCard>
}
else if (_smtpConfigured)
{
    <AuthCard Title="Sign up" FormAction="/auth/signup/start">
        <Sub>
            Start with your email. We'll send a link to confirm it, then you'll pick a password.
        </Sub>
        <Alerts>@InvalidFieldAlert</Alerts>
        <ChildContent>
            <div class="auth__fields">
                <div class="field">
                    <label class="field__label" for="su-email">Email</label>
                    <input class="input" id="su-email" type="email" name="Email" value="@EmailValue"
                           required autofocus autocomplete="username" placeholder="you@cronus.example" />
                </div>
            </div>
            <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg)">
                <Icon Name="user-plus" Width="16" Height="16" />
                <span>Send confirmation email</span>
            </button>
            <div class="auth__sso">
                <span class="auth__or">or</span>
                <a class="btn" href="/signup?code=1">I already have a code</a>
            </div>
        </ChildContent>
        <Foot>
            <span>Already have an account?</span>
            <a class="auth__link" href="/login">Sign in</a>
        </Foot>
        <Legal>AL Workbench is where your team builds Business Central solutions and looks after the environments they run on.</Legal>
    </AuthCard>
}
else
{
    @* No SMTP, so there is no confirmation email to send and the whole thing
       has to be asked for at once. *@
    <AuthCard Title="Sign up" FormAction="/auth/signup">
        <Sub>
            @if (SingleTenant.IsEnabled)
            {
                <text>
                    If your email domain is linked to the organisation we'll route you to it,
                    and an admin will approve you.
                </text>
            }
            else
            {
                <text>
                    If your email domain is already linked to an organisation we'll route you
                    to it. Otherwise, join one using its ID, or leave that blank and name a
                    new organisation to start your own.
                </text>
            }
        </Sub>
        <Alerts>@InvalidFieldAlert</Alerts>
        <ChildContent>
            <div class="auth__fields">
                <div class="field">
                    <label class="field__label" for="su-email">Email</label>
                    <input class="input" id="su-email" type="email" name="Email" required autofocus
                           autocomplete="username" placeholder="you@cronus.example" />
                </div>
                <div class="field">
                    <label class="field__label" for="su-display">Full name</label>
                    <input class="input" id="su-display" type="text" name="DisplayName" required
                           minlength="2" maxlength="80" placeholder="Kirsten Jensen" />
                </div>
                <div class="field">
                    <label class="field__label" for="su-password">Password</label>
                    <input class="input" id="su-password" type="password" name="Password" required
                           minlength="12" autocomplete="new-password" />
                    <span class="field__hint">At least 12 characters, and not one you use anywhere else.</span>
                </div>
                @if (!SingleTenant.IsEnabled)
                {
                    <div class="field">
                        <label class="field__label" for="su-org-name">Organisation name</label>
                        <input class="input" id="su-org-name" type="text" name="OrganizationName"
                               minlength="2" maxlength="80" placeholder="CRONUS International Ltd." />
                        <span class="field__hint">Only needed if you're starting a new organisation.</span>
                    </div>
                    <div class="field">
                        <label class="field__label" for="su-org">Organisation ID</label>
                        <input class="input" id="su-org" type="text" name="OrganizationSlug"
                               pattern="[a-z0-9-]*" maxlength="64" placeholder="cronus" />
                        <span class="field__hint">
                            The ID a colleague or your administrator gave you, for example cronus.
                            Leave blank to start the organisation named above.
                        </span>
                    </div>
                }
            </div>
            <button type="submit" class="btn btn--primary" style="height: var(--control-h-lg)">
                <Icon Name="user-plus" Width="16" Height="16" />
                <span>Sign up</span>
            </button>
        </ChildContent>
        <Foot>
            <span>Already have an account?</span>
            <a class="auth__link" href="/login">Sign in</a>
        </Foot>
    </AuthCard>
}

@code {
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "field")] public string? Field { get; set; }
    // A code, not the sentence: the copy lives in FormErrorReasons so an
    // edited link can't make this page say anything (#1544).
    [SupplyParameterFromQuery(Name = "reason")] public string? Reason { get; set; }
    [SupplyParameterFromQuery(Name = "email")] public string? EmailValue { get; set; }

    /// <summary>Set by the "I already have a code" link, so arriving late has a way in.</summary>
    [SupplyParameterFromQuery(Name = "code")] public string? CodeEntry { get; set; }

    private bool _smtpConfigured;

    private bool ShowCodeCard =>
        _smtpConfigured
        && (Ok == "check-email" || Error == "code-invalid" || Error == "verify-invalid" || CodeEntry == "1");

    protected override async Task OnInitializedAsync()
    {
        _smtpConfigured = await Email.IsConfiguredAsync();
    }

    private RenderFragment InvalidFieldAlert => @<text>
        @if (Error == "invalid" && !string.IsNullOrEmpty(Field))
        {
            <Alert Tone="AlertTone.Danger">
                <span>
                        @if (AuthCard.FieldLabel(@Field) is { } label)
                        {
                            <strong>@label:</strong>
                        }
                        @FormErrorReasons.MessageFor(Reason)
                    </span>
            </Alert>
        }
    </text>;
}
