@page "/cookbook"
@attribute [Authorize]
@* The filter box, type tabs and "Include deprecated" are all event handlers, so
   this page has to opt in to interactivity. See .design/design-migration.md. *@
@rendermode InteractiveServer
@implements IDisposable
@inject RecipeService Recipes
@inject NavigationManager Nav
@inject IServiceScopeFactory ScopeFactory
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Cookbook

<PageTitle>Cookbook · AL Workbench</PageTitle>

@*
    Archetype 2 (list / browser), card view — the handoff's own split: a table
    view carries status as an edge keyline, but "a card has no shared edge to
    line up", so cards keep the .status-pill. Four states, the fourth being
    filtered-empty, which offers "Clear filters" rather than the create action.
    See .design/design-migration.md.
*@

<ListPage Title="Cookbook" FiltersWhileLoading="true" FiltersWhenEmpty="true" LoadingText="Loading recipes..."
          Subtitle="Reusable AL recipes - from one-file snippets to almost-complete modules. Search by title, description, or keywords; open one to view its files and copy them into your project."
          IsLoading="@(_results is null)" IsEmpty="@(IsFirstRun && Rows.Count == 0)" HasNoMatches="@(Rows.Count == 0)"
          Trail='@([new("Home", "/"), new("Cookbook")])'>
    <Actions>
        <a class="btn" href="/cookbook/suggest">
            <Icon Name="lightbulb" Width="16" Height="16" />
            <span>Suggest a recipe</span>
        </a>
    </Actions>
    <Search>
        <input type="search"
               class="input"
               placeholder="Search the cookbook..."
               value="@_query"
               @oninput="OnQueryChanged"
               aria-label="Search the cookbook"
               aria-keyshortcuts="F3" title="Search the cookbook (F3)" />
    </Search>
    <Filters>
        <label class="check @(_includeDeprecated ? "is-checked" : "")">
            <input type="checkbox" @bind="_includeDeprecated" @bind:after="ReloadAsync" />
            <span class="check__box"><Icon Name="check" Width="12" Height="12" /></span>
            Include deprecated
        </label>
    </Filters>
    <Trailing>
        <div class="pill-tabs" role="group" aria-label="Filter by type">
            @foreach (var option in _typeOptions)
            {
                var active = _typeFilter == option.Value;
                <button type="button"
                        class="pill-tab @(active ? "is-active" : "")"
                        @onclick="() => SetTypeFilter(option.Value)"
                        aria-pressed="@(active ? "true" : "false")">
                    @option.Label
                    @if (_results is not null)
                    {
                        <span class="pill-tab__count">@CountFor(option.Value)</span>
                    }
                </button>
            }
        </div>
    </Trailing>
    <Empty>
        <div class="card">
            <EmptyState Icon="lightbulb" Title="No recipes yet">
                <Text>
                    No recipes in this organisation yet. If you have an AL pattern worth
                    reusing, suggest it and an admin will review and publish it.
                </Text>
                <Action>
                    <a class="btn btn--primary" href="/cookbook/suggest">
                        <Icon Name="lightbulb" Width="15" Height="15" />
                        <span>Suggest a recipe</span>
                    </a>
                </Action>
            </EmptyState>
        </div>
    </Empty>
    <NoMatches>
        <div class="card">
            <EmptyState Icon="funnel-x"
                        Title="@(string.IsNullOrWhiteSpace(_query) ? "No recipes match these filters" : $"No recipes match \"{_query}\"")">
                <Text>Try a shorter search term, or clear the type filter.</Text>
                <Action><button class="btn" type="button" @onclick="ClearFiltersAsync">Clear filters</button></Action>
            </EmptyState>
        </div>
    </NoMatches>
    <ChildContent>
        <div class="card-grid">
            @foreach (var s in Rows)
            {
                var tags = SplitKeywords(s.Keywords);
                var fileCount = _fileCounts.GetValueOrDefault(s.Id);
                <a class="browse-card cb-card" href="@($"/cookbook/{s.Id}")">
                    <div class="browse-card__top">
                        <span class="browse-card__title">@s.Title</span>
                        <span class="cb-card__badges">
                            <RecipeTypeBadge Type="s.Type" />
                            @if (s.Deprecated)
                            {
                                <StatusPill Tone="warn">
                                    <Icon Name="archive" Width="12" Height="12" />
                                    Deprecated
                                </StatusPill>
                            }
                        </span>
                    </div>
                    @* The minimum version is a subtitle, not a keyword. It
                       used to be a mono chip in the row below, where it was
                       miscategorised (it is metadata, not a tag), styled as
                       an identifier though it reads as a sentence, and wide
                       enough to escape the card. It was also hidden outright
                       on a deprecated recipe, which is where knowing the
                       version matters most. *@
                    @if (s.MinimumApplicationVersion is { } minV)
                    {
                        <span class="cb-card__req">@minV.Name or later</span>
                    }
                    <span class="browse-card__text">@s.Description</span>
                    <div class="browse-card__tags">
                        @foreach (var tag in tags.Take(6))
                        {
                            <span class="tag">@tag</span>
                        }
                        @if (tags.Count > 6)
                        {
                            <span class="tag cb-card__more">+@(tags.Count - 6)</span>
                        }
                    </div>
                    <div class="browse-card__foot">
                        <span class="cb-card__files">
                            <Icon Name="file-code" Width="13" Height="13" />
                            <span>@fileCount file@(fileCount == 1 ? "" : "s")</span>
                        </span>
                        <span class="cb-card__go">View recipe<Icon Name="arrow-right" Width="13" Height="13" /></span>
                    </div>
                </a>
            }
        </div>
    </ChildContent>
</ListPage>

@code {
    /// <summary>
    /// The search term, taken from <c>?q=</c>, so a keyword on a recipe page can
    /// link straight to the recipes that share it (issue #540).
    ///
    /// Read as a query parameter rather than from <c>IHttpContextAccessor</c>:
    /// an interactive page runs OnInitializedAsync twice - once while
    /// prerendering, where HttpContext exists, and again on the circuit, where
    /// it is null - and the second run would reset the term. Same shape as
    /// PipelinesBrowser.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    /// <summary>The <c>?q=</c> already applied, so a re-render doesn't re-query.</summary>
    private string? _appliedQuery;

    private string _query = string.Empty;
    private bool _includeDeprecated;
    private RecipeType? _typeFilter;
    private List<Recipe>? _results;
    private Dictionary<int, int> _fileCounts = new();
    private CancellationTokenSource? _debounce;

    private readonly (string Label, RecipeType? Value)[] _typeOptions =
    {
        ("All", (RecipeType?)null),
        ("Snippet", RecipeType.Snippet),
        ("Pattern", RecipeType.Pattern),
        ("Module", RecipeType.Module),
    };

    private static List<string> SplitKeywords(string? keywords) =>
        string.IsNullOrWhiteSpace(keywords)
            ? new List<string>()
            : keywords.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    protected override async Task OnInitializedAsync()
    {
        _fileCounts = await Recipes.GetFileCountsAsync();
    }

    // OnParametersSetAsync rather than OnInitializedAsync so following a keyword
    // link from another page - a navigation, not a new component - reloads.
    protected override async Task OnParametersSetAsync()
    {
        var incoming = (Q ?? string.Empty).Trim();
        if (_appliedQuery == incoming && _results is not null) return;

        _appliedQuery = incoming;
        _query = incoming;
        // A keyword link is a fresh search; carrying over the type tab would
        // silently hide most of what it just asked for.
        _typeFilter = null;
        await ReloadAsync();
    }

    private void OnQueryChanged(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        DebouncedReload();
    }

    private void DebouncedReload()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(200, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(ReloadAsync);
            }
            catch (TaskCanceledException) { }
        });
    }

    /// <summary>
    /// Runs the search on a DI scope of its own. The debounced reload, the deprecated
    /// checkbox and Clear filters can each start one while another is still awaiting, and
    /// the circuit's one AppDbContext takes one command at a time; InvokeAsync only keeps
    /// them apart between awaits. Same as the pipeline pages (#679). With several out at
    /// once, only the latest one's answer lands.
    /// </summary>
    private async Task ReloadAsync()
    {
        var search = ++_searches;
        List<Recipe> results;
        await using (var scope = ScopeFactory.CreateAsyncScope())
        {
            results = await scope.ServiceProvider.GetRequiredService<RecipeService>()
                .SearchAsync(_query, _includeDeprecated);
        }
        if (search != _searches) return;
        _results = results;
        StateHasChanged();
    }

    /// <summary>Counts the searches started, so an earlier one finishing late doesn't overwrite a later one.</summary>
    private int _searches;

    private void SetTypeFilter(RecipeType? value)
    {
        _typeFilter = value;
    }

    private async Task ClearFiltersAsync()
    {
        _query = string.Empty;
        _typeFilter = null;
        _includeDeprecated = false;
        _appliedQuery = string.Empty;
        await ReloadAsync();
        // Drop a ?q= we arrived with, so the address bar doesn't still claim a
        // filter the page no longer has. The guard above makes the resulting
        // parameter set a no-op rather than a second query.
        if (!string.IsNullOrEmpty(Q)) Nav.NavigateTo("/cookbook", replace: true);
    }

    private List<Recipe> ApplyTypeFilter(List<Recipe> rows) =>
        _typeFilter is null ? rows : rows.Where(r => r.Type == _typeFilter).ToList();

    /// <summary>
    /// True only when the organisation genuinely has no recipes — not when a
    /// filter simply matched none. The two empty states offer different actions.
    /// </summary>
    /// <summary>What the type tabs leave of the loaded results.</summary>
    private List<Recipe> Rows => _results is null ? new() : ApplyTypeFilter(_results);

    private bool IsFirstRun =>
        _results is { Count: 0 } && string.IsNullOrWhiteSpace(_query) && _typeFilter is null && !_includeDeprecated;

    /// <summary>How many of the current search results fall under one type tab.</summary>
    private int CountFor(RecipeType? type) =>
        _results is null ? 0
        : type is null ? _results.Count
        : _results.Count(r => r.Type == type);

    public void Dispose()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
