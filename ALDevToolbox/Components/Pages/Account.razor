@page "/account"
@page "/account/{SectionName}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using ALDevToolbox.Data
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services
@using ALDevToolbox.Services.Account
@using ALDevToolbox.Services.OAuth
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Components.Shared
@using Microsoft.EntityFrameworkCore
@using ALDevToolbox.Services.Operations
@using ALDevToolbox.Services.Organizations
@inject AccountService Accounts
@inject IOrganizationContext Org
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject RecoveryCodeService RecoveryCodes
@inject PasskeyService Passkeys
@inject EntraSignInService Entra
@inject IEmailService Email
@inject PersonalAccessTokenService Pats
@inject OAuthClientAdminService OAuthClients
@inject OrganizationConfigService OrgConfig
@inject RepositoryProviderPolicyService RepoProviderPolicy
@inject UserRepositoryTokenService RepoTokens
@inject GitHubAccessService GitHubAccess
@inject SystemSettingsService Settings
@inject ILogger<Account> Logger

@*
    Your account, on page archetype 7 ("settings with sub-nav").

    Two divergences from the pre-redesign page, both forced by the design system
    rather than chosen:

    - The left rail (.set-nav) is gone. The system's settings sub-nav is
      .header-tabs, and its component inventory has no vertical nav at all, so
      the rail had nothing to port onto. The tabs are real links, each to its
      own address (/account/security; Profile is the bare /account, #1088), so a
      tab is bookmarkable. The ?section= links that came before still work and
      are forwarded to that address.
    - "Danger zone" is no longer a tab. There is nothing destructive left on this
      page to put in one: a user cannot delete their own account, because doing
      so would take their audit trail with them - an admin disables the account
      instead (UserStatus.Disabled), which keeps the history readable.
      ?section=danger no longer parses and falls through to Profile.

    TabbedPage rather than SettingsPage: the tabs here are tables and several
    cards, not one .setting-list, which is the split those two components exist
    for. See their doc comments.
*@

<PageTitle>Your account · AL Workbench</PageTitle>

@if (_user is null)
{
    <div class="page">
        <div class="loading-block"><span class="spinner"></span><span>Loading...</span></div>
    </div>
}
else
{
    <TabbedPage Title="Your account" CrumbLabel="Home" CrumbHref="/"
                Tabs="@_tabs" TabsLabel="Account sections">
        <Sub>@_user.DisplayName · @_user.Email · @RoleWord(_user.Role) in @_organization?.Name</Sub>
        <Actions>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn">
                    <Icon Name="log-out" Width="15" Height="15" />
                    <span>Sign out</span>
                </button>
            </form>
        </Actions>
        <ChildContent>

            @* --- page-wide flashes, above the sections ------------------- *@

            @if (!string.IsNullOrEmpty(Error) && !string.IsNullOrEmpty(Message))
            {
                @* Endpoints redirect with err=<field>&msg=<sentence>, so the pair
                   is what carries meaning - a bare err= is a field name. *@
                <Alert Tone="AlertTone.Danger">
                    <span><strong>@Error:</strong> @Message</span>
                </Alert>
            }
            else if (!string.IsNullOrEmpty(Message))
            {
                @* A message with no field to blame: something went nowhere rather
                   than went wrong. Prefixing it with a field name would invent a
                   form the reader never filled in. *@
                <Alert Tone="AlertTone.Warn">
                    <span>@Message</span>
                </Alert>
            }
            @* The return banner below says "connected" and what to do next, so the
               generic flash would be the same news twice in two green boxes. *@
            @if (Ok is not null && !(CameFromRepositoriesTab && _github is { IsLinked: true }))
            {
                <Alert Tone="AlertTone.Success">
                    <span>@FlashFor(Ok)</span>
                </Alert>
            }
            @if (Required == "1")
            {
                <Alert Tone="AlertTone.Warn" Icon="shield-alert" Role="alert">
                    <span>
                        Your organisation requires either two-step verification or a passkey.
                        Set one up below - you won't be able to reach the rest of the site until you do.
                    </span>
                </Alert>
            }
            @if (!string.IsNullOrEmpty(_user.PendingEmail))
            {
                <Alert Tone="AlertTone.Info" Icon="mail" Role="status">
                    <span>
                        Pending email change to <strong>@_user.PendingEmail</strong>
                        (requested <Timestamp Value="@_user.PendingEmailAt" />).
                        The new address still needs to click the confirmation link.
                    </span>
                </Alert>
            }

            @if (_section == Section.Profile)
            {
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Profile</h2>
                            <p class="card__sub">Your name and how teammates see you.</p>
                        </div>
                    </div>
                    <form method="post" action="/auth/account/display-name">
                        <AntiforgeryToken />
                        <div class="setting-list">
                            <SettingRow Name="Full name"
                                        Hint="Shown on your activity and anywhere your account appears in the workbench.">
                                <input class="input" type="text" name="DisplayName" value="@_user.DisplayName"
                                       required minlength="2" maxlength="80" aria-label="Full name" />
                            </SettingRow>
                        </div>
                        <div class="card__foot">
                            <button type="submit" class="btn btn--primary">
                                <Icon Name="save" Width="16" Height="16" />
                                <span>Save name</span>
                            </button>
                        </div>
                    </form>
                </section>

                @* Read-only facts, so .meta-row rather than fake settings rows -
                   a .setting with no control reads as one you failed to render. *@
                <div class="meta-row">
                    <div class="meta-item">
                        <span class="meta-item__label">Email</span>
                        <span class="meta-item__value">@_user.Email</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-item__label">Role</span>
                        <span class="meta-item__value">@RoleWord(_user.Role) - @RoleBlurb(_user.Role)</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-item__label">Organisation</span>
                        <span class="meta-item__value">@_organization?.Name</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-item__label">Member since</span>
                        <span class="meta-item__value"><Timestamp Value="@_user.CreatedAt" Format="d MMMM yyyy" /></span>
                    </div>
                </div>

                <p class="u-muted">
                    @if (_user.Role == UserRole.Admin)
                    {
                        <text>
                            Need a different email? Change it on your own user under <a href="/admin/administration/users">Users</a>.
                            Accounts are closed there too, by disabling them - that keeps each person's name on the work they did.
                        </text>
                    }
                    else
                    {
                        <text>
                            Need a different email? Ask one of your organisation's admins to change it under <strong>Users</strong>.
                            To close your account, ask them to disable it - that keeps your name on the work you've already done.
                        </text>
                    }
                </p>
            }
            else if (_section == Section.Notifications)
            {
                <AccountNotificationsSection />
            }
            else if (_section == Section.Security)
            {
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Password</h2>
                            <p class="card__sub">A long phrase you'll remember is stronger than a short, complicated one.</p>
                        </div>
                    </div>
                    <form method="post" action="/auth/account/password">
                        <AntiforgeryToken />
                        <div class="card__body">
                            <div class="form-grid">
                                <label class="field">
                                    <span class="field__label">Current password</span>
                                    <input class="input" type="password" name="CurrentPassword" required
                                           autocomplete="current-password" placeholder="Enter your current password" />
                                </label>
                                <label class="field">
                                    <span class="field__label">New password</span>
                                    <input class="input" type="password" name="NewPassword" required minlength="12"
                                           autocomplete="new-password" placeholder="Choose a new password" />
                                    <span class="field__hint">Use at least 12 characters.</span>
                                </label>
                            </div>
                        </div>
                        <div class="card__foot">
                            <span class="form-actions__note">You'll stay signed in on this device.</span>
                            <button type="submit" class="btn btn--primary">
                                <Icon Name="lock" Width="16" Height="16" />
                                <span>Update password</span>
                            </button>
                        </div>
                    </form>
                </section>

                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Two-step verification</h2>
                            <p class="card__sub">A second check at sign-in, after your password.</p>
                        </div>
                        @if (_twoStepOn)
                        {
                            <StatusPill Tone="success">On</StatusPill>
                        }
                        else
                        {
                            <StatusPill Tone="muted">Off</StatusPill>
                        }
                    </div>
                    <div class="setting-list">
                        <SettingRow Name="Authenticator app"
                                    Hint="Six-digit codes from an app like Google Authenticator or 1Password. This is your main second step at sign-in.">
                            @if (!_user.TotpEnabled)
                            {
                                <span class="u-row">
                                    <StatusPill Tone="muted">Off</StatusPill>
                                    <a href="/account/2fa/totp/setup" class="btn btn--sm">
                                        <Icon Name="shield" Width="14" Height="14" />
                                        <span>Turn on authenticator app</span>
                                    </a>
                                </span>
                            }
                            else if (_totpAction is null)
                            {
                                <span class="u-row">
                                    <StatusPill Tone="success">On</StatusPill>
                                    <button type="button" class="btn btn--sm" @onclick='() => _totpAction = "regenerate"'>
                                        <Icon Name="refresh-cw" Width="14" Height="14" />
                                        <span>Get new recovery codes</span>
                                    </button>
                                    <button type="button" class="btn btn--sm btn--danger" @onclick='() => _totpAction = "disable"'>Turn off</button>
                                </span>
                                @if (_recoveryRemaining == 0)
                                {
                                    <FieldError Message="No recovery codes left. Generate new ones so you're not locked out." />
                                }
                                else
                                {
                                    <span class="form-actions__note">@_recoveryRemaining of 10 recovery codes left</span>
                                }
                            }
                            else
                            {
                                <form method="post" class="u-row"
                                      action="@(_totpAction == "disable" ? "/auth/account/2fa/totp/disable" : "/auth/account/2fa/recovery/regenerate")">
                                    <AntiforgeryToken />
                                    <input class="input" type="password" name="Password" required
                                           autocomplete="current-password"
                                           aria-label="Confirm with your current password"
                                           placeholder="Confirm with your current password" />
                                    <button type="submit" class="btn btn--sm @(_totpAction == "disable" ? "btn--danger" : "")">
                                        @(_totpAction == "disable" ? "Turn off" : "Generate codes")
                                    </button>
                                    <button type="button" class="btn btn--sm" @onclick="() => _totpAction = null">Cancel</button>
                                </form>
                            }
                        </SettingRow>

                        <SettingRow Name="Email codes"
                                    Hint="@($"A backup code sent to {_user.Email} for the times you can't reach your authenticator app.")">
                            @if (!_smtpConfigured)
                            {
                                <span class="form-actions__note">
                                    Email codes aren't available on this site yet - a site administrator needs to set up email first.
                                </span>
                            }
                            else if (_user.EmailMfaEnabled)
                            {
                                <form method="post" action="/auth/account/2fa/email/disable" class="u-row">
                                    <AntiforgeryToken />
                                    <StatusPill Tone="success">On</StatusPill>
                                    <input class="input" type="password" name="Password" required
                                           autocomplete="current-password" aria-label="Current password"
                                           placeholder="Current password" />
                                    <button type="submit" class="btn btn--sm btn--danger">Turn off email codes</button>
                                </form>
                            }
                            else if (_pendingEmailMfa)
                            {
                                <form method="post" action="/auth/account/2fa/email/confirm" class="u-row">
                                    <AntiforgeryToken />
                                    <input class="input" type="text" name="Code" inputmode="numeric" pattern="[0-9]{6}"
                                           maxlength="6" required aria-label="6-digit code" placeholder="6-digit code" />
                                    <button type="submit" class="btn btn--sm">Confirm</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="/auth/account/2fa/email/begin" class="u-row">
                                    <AntiforgeryToken />
                                    <StatusPill Tone="muted">Off</StatusPill>
                                    <button type="submit" class="btn btn--sm">
                                        <Icon Name="mail" Width="14" Height="14" />
                                        <span>Turn on email codes</span>
                                    </button>
                                </form>
                            }
                        </SettingRow>
                    </div>
                </section>

                @if (Passkeys.IsConfigured)
                {
                    <section class="card">
                        <div class="card__head">
                            <div>
                                <h2 class="card__title">Passkeys</h2>
                                <p class="card__sub">Sign in with your fingerprint, face, or a security key - no password to type.</p>
                            </div>
                        </div>
                        @if (_passkeys.Count == 0)
                        {
                            <div class="empty-state empty-state--quiet">
                                <span class="empty-state__title">No passkeys yet</span>
                                <span class="empty-state__text">
                                    Add one and your device does the checking, so there's nothing to remember or type.
                                </span>
                            </div>
                        }
                        else
                        {
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Device</th>
                                        <th>Added</th>
                                        <th>Last used</th>
                                        <th class="data-table__actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var p in _passkeys)
                                {
                                    <tr>
                                        <td>@p.Nickname</td>
                                        <td class="u-muted"><Timestamp Value="@p.CreatedAt" Format="d MMM yyyy" /></td>
                                        <td class="u-muted"><Timestamp Value="@p.LastUsedAt" Format="d MMM yyyy" Placeholder="Never" /></td>
                                        <td class="data-table__actions">
                                            @* Static message: a nickname is free text and an
                                               apostrophe in it would end the JS literal. *@
                                            <form method="post" action="/auth/account/passkeys/@p.Id/delete"
                                                  onsubmit="return confirm('Remove this passkey? You will not be able to sign in with that device until you add it again.');">
                                                <AntiforgeryToken />
                                                <button type="submit" class="btn btn--sm btn--danger">Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                        @if (!string.IsNullOrEmpty(_passkeyError))
                        {
                            <div class="card__body">
                                <Alert Tone="AlertTone.Danger">
                                    <span>@_passkeyError</span>
                                </Alert>
                            </div>
                        }
                        <div class="card__foot">
                            <button type="button" class="btn" @onclick="RegisterPasskeyAsync" disabled="@_busy">
                                <Icon Name="plus" Width="16" Height="16" />
                                <span>Add a passkey</span>
                            </button>
                        </div>
                    </section>
                }

                @* Same card shape as Passkeys, for the same reason: this is a way
                   of signing in that you either have or don't. The rows are
                   SettingRows because connecting an account is a setting, not a
                   record - it is on or off, and each row's control is the switch. *@
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Microsoft account</h2>
                            <p class="card__sub">Sign in with your work Microsoft account instead of typing a password.</p>
                        </div>
                        @if (_entraLinks.Count > 0)
                        {
                            <StatusPill Tone="success">Connected</StatusPill>
                        }
                    </div>
                    @if (!_orgEntraEnabled)
                    {
                        <div class="empty-state empty-state--quiet">
                            <span class="empty-state__title">Not turned on yet</span>
                            <span class="empty-state__text">
                                Your organisation hasn't turned Microsoft sign-in on. An admin can
                                turn it on under Administration.
                            </span>
                        </div>
                    }
                    else if (_entraLinks.Count == 0)
                    {
                        <div class="empty-state empty-state--quiet">
                            <span class="empty-state__title">No Microsoft account connected</span>
                            <span class="empty-state__text">
                                Connect one and you can sign in with it instead of a password. Your
                                admin decides which Microsoft organisations are allowed.
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="setting-list">
                            @foreach (var link in _entraLinks)
                            {
                                <SettingRow Name="@link.DisplayIdentity">
                                    <HintContent>Microsoft account, connected <Timestamp Value="@link.CreatedAt" Format="d MMM yyyy" />.</HintContent>
                                    <ChildContent>
                                    <span class="u-row">
                                        <StatusPill Tone="success">Connected</StatusPill>
                                        <button type="button" class="btn btn--sm btn--danger"
                                                @onclick="() => DisconnectEntraAsync(link)" disabled="@_busy">
                                            <Icon Name="trash-2" Width="14" Height="14" />
                                            <span>Disconnect</span>
                                        </button>
                                    </span>
                                    <span class="form-actions__note">
                                        @if (link.LastLoginAt is { } ll)
                                        {
                                            <text>Last signed in <Timestamp Value="@ll" Format="d MMM yyyy" /></text>
                                        }
                                        else
                                        {
                                            <text>Not used to sign in yet</text>
                                        }
                                    </span>
                                    </ChildContent>
                                </SettingRow>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_entraLinkError))
                    {
                        <div class="card__body">
                            <Alert Tone="AlertTone.Danger">
                                <span>@_entraLinkError</span>
                            </Alert>
                        </div>
                    }
                    @if (_orgEntraEnabled)
                    {
                        <div class="card__foot">
                            <form method="post" action="/auth/entra/link">
                                <AntiforgeryToken />
                                <button type="submit" class="btn">
                                    <Icon Name="plus" Width="16" Height="16" />
                                    <span>Connect a Microsoft account</span>
                                </button>
                            </form>
                        </div>
                    }
                </section>
            }
            else if (_section == Section.Ai)
            {
                <p class="u-muted">
                    Let AI coding assistants work in AL Workbench on your behalf. Desktop and
                    command-line tools (Claude Desktop, Cursor, Claude Code) sign in with an access
                    token you paste in once; Claude on the web and mobile connect through a
                    permission screen, with nothing to paste.
                    <a href="/docs/mcp">How to connect an assistant</a>.
                </p>

                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Access tokens</h2>
                            <p class="card__sub">Treat a token like a password - anyone who has it can act as you in connected tools.</p>
                        </div>
                        <button type="button" class="btn btn--sm" @onclick="() => _showCreateToken = !_showCreateToken">
                            <Icon Name="plus" Width="14" Height="14" />
                            <span>Create token</span>
                        </button>
                    </div>

                    @if (_showCreateToken)
                    {
                        <form method="post" action="/auth/account/access-tokens/create">
                            <AntiforgeryToken />
                            <div class="card__body">
                                <div class="form-grid">
                                    <label class="field">
                                        <span class="field__label">Name</span>
                                        <input class="input" type="text" name="Name" required minlength="1" maxlength="80"
                                               placeholder="e.g. Cursor on laptop" />
                                        <span class="field__hint">A label that helps you remember where this token is used.</span>
                                    </label>
                                    <label class="field">
                                        <span class="field__label">Expires</span>
                                        <SelectBox>
                                            <select class="select" name="TtlDays">
                                                <option value="30">30 days</option>
                                                <option value="90" selected>90 days</option>
                                                <option value="180">180 days</option>
                                                <option value="365">1 year</option>
                                                <option value="0">No expiry</option>
                                            </select>
                                        </SelectBox>
                                        <span class="field__hint">You can revoke a token at any time.</span>
                                    </label>
                                </div>
                            </div>
                            <div class="card__foot">
                                <button type="button" class="btn" @onclick="() => _showCreateToken = false">Cancel</button>
                                <button type="submit" class="btn btn--primary">
                                    <Icon Name="key-round" Width="16" Height="16" />
                                    <span>Create token</span>
                                </button>
                            </div>
                        </form>
                    }

                    @if (_tokens is null)
                    {
                        <div class="loading-block">
                            <span class="spinner"></span><span>Loading...</span>
                        </div>
                    }
                    else
                    {
                        var now = DateTime.UtcNow;
                        var active = _tokens.Where(t => PersonalAccessTokenService.IsActiveAt(t, now)).ToList();
                        var inactive = _tokens.Where(t => !PersonalAccessTokenService.IsActiveAt(t, now)).ToList();

                        @if (active.Count == 0 && !_showCreateToken)
                        {
                            <div class="empty-state empty-state--quiet">
                                <span class="empty-state__title">No access tokens yet</span>
                                <span class="empty-state__text">
                                    Create one to connect a desktop or command-line assistant.
                                </span>
                            </div>
                        }
                        else if (active.Count > 0)
                        {
                            <table class="data-table data-table--edge">
                                <thead>
                                    <tr>
                                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                        <th>Token</th>
                                        <th>Access</th>
                                        <th>Last used</th>
                                        <th>Expires</th>
                                        <th class="data-table__actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var t in active)
                                {
                                    var state = PersonalAccessTokenService.RowState(t, now);
                                    <tr class="@RowStateIcon.RowClass(state)">
                                        <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                                        <td>@t.Name<div class="u-muted"><code class="code">@t.TokenPrefix...</code></div></td>
                                        <td>Acts as you</td>
                                        <td class="u-muted"><Timestamp Value="@t.LastUsedAt" Format="d MMM yyyy" Placeholder="Never" /></td>
                                        <td class="u-muted"><Timestamp Value="@t.ExpiresAt" Format="d MMM yyyy" Placeholder="Never" /></td>
                                        <td class="data-table__actions">
                                            <form method="post" action="/auth/account/access-tokens/@t.Id/revoke"
                                                  onsubmit="return confirm('Revoke this token? Whatever is using it stops working straight away, and this cannot be undone.');">
                                                <AntiforgeryToken />
                                                <button type="submit" class="btn btn--sm btn--danger">Revoke</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }

                        @if (inactive.Count > 0)
                        {
                            <details class="card__body">
                                <summary>Show @inactive.Count revoked or expired @(inactive.Count == 1 ? "token" : "tokens")</summary>
                                <p class="u-muted">
                                    Kept so audit log entries that reference these tokens still resolve.
                                    They can't be used to sign in.
                                </p>
                                <table class="data-table data-table--edge">
                                    <thead>
                                        <tr>
                                            <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                            <th>Token</th>
                                            <th>Created</th>
                                            <th>Expires</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var t in inactive)
                                    {
                                        var state = PersonalAccessTokenService.RowState(t, now);
                                        <tr class="@RowStateIcon.RowClass(state)">
                                            <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                                            <td>@t.Name<div class="u-muted"><code class="code">@t.TokenPrefix...</code></div></td>
                                            <td class="u-muted"><Timestamp Value="@t.CreatedAt" Format="yyyy-MM-dd" /></td>
                                            <td class="u-muted"><Timestamp Value="@t.ExpiresAt" Format="yyyy-MM-dd" Placeholder="Never" /></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </details>
                        }
                    }
                </section>

                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Connected assistants</h2>
                            <p class="card__sub">These connect through a permission screen and can be disconnected here anytime.</p>
                        </div>
                    </div>

                    @if (_clients is null)
                    {
                        <div class="loading-block">
                            <span class="spinner"></span><span>Loading...</span>
                        </div>
                    }
                    else
                    {
                        var activeClients = _clients.Where(c => c.RevokedAt is null).ToList();
                        var inactiveClients = _clients.Where(c => c.RevokedAt is not null).ToList();

                        @if (activeClients.Count == 0)
                        {
                            <div class="empty-state empty-state--quiet">
                                <span class="empty-state__title">No assistants connected yet</span>
                                <span class="empty-state__text">
                                    Adding AL Workbench as a connector in Claude opens a permission
                                    screen; once you click <strong>Allow</strong>, the connection shows up here.
                                </span>
                            </div>
                        }
                        else
                        {
                            <table class="data-table data-table--edge">
                                <thead>
                                    <tr>
                                        <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                        <th>Assistant</th>
                                        <th>Permissions</th>
                                        <th>Connected</th>
                                        <th class="data-table__actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var c in activeClients)
                                {
                                    <tr class="@RowStateIcon.RowClass("active")">
                                        <td class="data-table__col-state"><RowStateIcon State="active" /></td>
                                        <td>
                                            @c.DisplayName
                                            @if (c.RedirectHosts.Count > 0)
                                            {
                                                <div class="u-muted">@string.Join(", ", c.RedirectHosts)</div>
                                            }
                                        </td>
                                        <td>@HumanScopes(c.Scopes)</td>
                                        <td class="u-muted"><Timestamp Value="@c.GrantedAt" Format="d MMM yyyy" /></td>
                                        <td class="data-table__actions">
                                            <button type="button" class="btn btn--sm btn--danger"
                                                    @onclick="() => DisconnectClientAsync(c)">Disconnect</button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }

                        @if (inactiveClients.Count > 0)
                        {
                            <details class="card__body">
                                <summary>Show @inactiveClients.Count revoked @(inactiveClients.Count == 1 ? "connection" : "connections")</summary>
                                <p class="u-muted">
                                    Kept so audit log entries still resolve. The assistant cannot reach
                                    AL Workbench unless it reconnects.
                                </p>
                                <table class="data-table data-table--edge">
                                    <thead>
                                        <tr>
                                            <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                            <th>Assistant</th>
                                            <th>Permissions</th>
                                            <th>Approved</th>
                                            <th>Revoked</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var c in inactiveClients)
                                    {
                                        <tr class="@RowStateIcon.RowClass("revoked")">
                                            <td class="data-table__col-state"><RowStateIcon State="revoked" /></td>
                                            <td>@c.DisplayName</td>
                                            <td class="u-muted">@HumanScopes(c.Scopes)</td>
                                            <td class="u-muted"><Timestamp Value="@c.GrantedAt" Format="yyyy-MM-dd" /></td>
                                            <td class="u-muted"><Timestamp Value="@c.RevokedAt" Format="yyyy-MM-dd" Placeholder="Never" /></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </details>
                        }
                    }
                </section>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_repoOk))
                {
                    <Alert Tone="AlertTone.Success">
                        <span>@_repoOk</span>
                    </Alert>
                }
                @if (!string.IsNullOrEmpty(_repoErr))
                {
                    <Alert Tone="AlertTone.Danger">
                        <span>@_repoErr</span>
                    </Alert>
                }
                @if (!string.IsNullOrEmpty(_githubNote))
                {
                    <Alert Tone="AlertTone.Info" Role="status">
                        <span>@_githubNote</span>
                    </Alert>
                }

                @* An admin sent here to link had, until now, to reconstruct
                   Admin -> Administration -> Repositories from memory once they
                   were done. Say why they are here on the way in, and hand them
                   the door on the way out. *@
                @if (CameFromRepositoriesTab && !_githubLoading)
                {
                    @if (_github is { IsLinked: true, NeedsRelink: false })
                    {
                        <Alert Tone="AlertTone.Success" Block="true">
                            <span class="u-stack">
                                <span>
                                    That is your own GitHub account done. Now finish connecting your
                                    organisation, back on the Repositories page.
                                </span>
                                <span class="u-row">
                                    <a class="btn btn--primary" href="/admin/administration/repositories">
                                        <Icon Name="arrow-left" Width="16" Height="16" />
                                        <span>Back to Repositories</span>
                                    </a>
                                </span>
                            </span>
                        </Alert>
                    }
                    else
                    {
                        <Alert Tone="AlertTone.Info" Role="status">
                            <span>
                                You came from Administration &#8594; Repositories. Connect your own GitHub
                                account below, and you will be sent back there to finish connecting your
                                organisation.
                            </span>
                        </Alert>
                    }
                }

                @if (_githubLoading || ShowGitHubCard)
                {
                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Your GitHub account</h2>
                            <p class="card__sub">
                                Lets the workbench work with GitHub <em>as you</em>: create repositories,
                                save your work into them, and show you the ones you can already open.
                                It is not what runs your builds - that is the token below.
                            </p>
                        </div>
                    </div>

                    @if (_githubLoading)
                    {
                        <div class="loading-block">
                            <span class="spinner"></span><span>Loading...</span>
                        </div>
                    }
                    else if (!_githubAvailable)
                    {
                        <div class="empty-state empty-state--quiet">
                            <span class="empty-state__title">GitHub is not set up on this server yet</span>
                            <span class="empty-state__text">
                                Ask whoever runs AL Workbench to set it up. Once they have, you can
                                connect your GitHub account here.
                            </span>
                        </div>
                    }
                    else if (_github is { IsLinked: true })
                    {
                        <table class="data-table data-table--edge">
                            <thead>
                                <tr>
                                    <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                    <th>GitHub account</th>
                                    <th>Connected</th>
                                    <th class="data-table__actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="@RowStateIcon.RowClass(GitHubRowState)">
                                    <td class="data-table__col-state">
                                        <RowStateIcon State="@GitHubRowState" Label="@GitHubMembershipLine" />
                                    </td>
                                    <td>
                                        <a href="https://github.com/@_github.Login" target="_blank" rel="noopener">@_github.Login</a>
                                        <div class="u-muted">@GitHubMembershipLine</div>
                                    </td>
                                    <td class="u-muted">
                                        <Timestamp Value="@_github.LinkedAt" Format="d MMM yyyy" Placeholder="-" />
                                    </td>
                                    <td class="data-table__actions">
                                        <button type="button" class="btn btn--sm btn--danger"
                                                @onclick="DisconnectGitHubAsync" disabled="@_githubBusy">Disconnect</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        @if (_github.NeedsRelink)
                        {
                            <div class="card__body">
                                <Alert Tone="AlertTone.Warn" Role="alert">
                                    <span>
                                        This connection has stopped working - most often because it was
                                        removed on GitHub. Connect again to carry on.
                                    </span>
                                </Alert>
                            </div>
                        }
                        else if (_githubOrgLogin is not null && _github.IsOrgMember == false)
                        {
                            <div class="card__body">
                                <Alert Tone="AlertTone.Info" Role="status">
                                    <span>
                                        Your account is connected, but GitHub does not list you in the
                                        <strong>@_githubOrgLogin</strong> organisation - so none of its
                                        repositories will appear in the workbench. Ask an owner of
                                        <a href="@GitHubOrgPeopleUrl" target="_blank" rel="noopener">@_githubOrgLogin</a>
                                        to add you, then choose Check again below.
                                    </span>
                                </Alert>
                            </div>
                        }
                        else if (_githubOrgLogin is null)
                        {
                            <div class="card__body">
                                <Alert Tone="AlertTone.Info" Role="status">
                                    <span>
                                        Nobody has told the workbench which GitHub organisation your company
                                        works in yet, so there is nothing for it to show you. An
                                        administrator picks one under Administration &#8594; Repositories.
                                    </span>
                                </Alert>
                            </div>
                        }

                        @* The whole answer to "what is this doing to my repositories"
                           used to disappear at the moment she agreed to it. Suspicion
                           does not end at the click, and she may have to repeat this
                           to a customer months later. *@
                        <div class="card__body">
                            <details>
                                <summary>What the workbench does with this</summary>
                                <ul>
                                    <li>It shows you the repositories you can already open on GitHub - and no others.</li>
                                    <li>It saves work to a repository only where you could save it yourself, with
                                        your name on the commit and the pull request.</li>
                                </ul>
                                <p class="u-muted">
                                    It never changes who can see what on GitHub, and it never acts as anyone
                                    else. Disconnect below whenever you like.
                                </p>
                            </details>
                        </div>

                        @if (_github.NeedsRelink)
                        {
                            <div class="card__foot">
                                <span class="form-actions__note">Disconnecting only stops the workbench using GitHub as you.</span>
                                <form method="post" action="/account/github/link">
                                    <AntiforgeryToken />
                                    @if (CameFromRepositoriesTab)
                                    {
                                        <input type="hidden" name="Return" value="@ReturnTo" />
                                    }
                                    <button type="submit" class="btn">
                                        <Icon Name="link" Width="16" Height="16" />
                                        <span>Connect again</span>
                                    </button>
                                </form>
                            </div>
                        }
                        else if (_githubOrgLogin is not null && _github.IsOrgMember != true)
                        {
                            @* The membership answer is stored, so someone who has just
                               been added to the organisation would otherwise keep
                               reading yesterday's answer. This asks GitHub again. *@
                            <div class="card__foot">
                                <span class="form-actions__note">Joined @_githubOrgLogin since you connected?</span>
                                <button type="button" class="btn" @onclick="RecheckGitHubMembershipAsync" disabled="@_githubBusy">
                                    <Icon Name="refresh-cw" Width="16" Height="16" />
                                    <span>@(_githubBusy ? "Checking..." : "Check again")</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="card__foot">
                                <span class="form-actions__note">Disconnecting only stops the workbench using GitHub as you.</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="card__body">
                            <p>
                                Connecting sends you to GitHub to sign in as yourself. After that the
                                workbench can:
                            </p>
                            <ul>
                                <li>show you the repositories you can already open on GitHub - and no others;</li>
                                <li>save work to a repository only where you could save it yourself, with
                                    your name on the commit and the pull request.</li>
                            </ul>
                            <p class="u-muted">
                                It never changes who can see what on GitHub, and it never acts as anyone
                                else. You can disconnect here at any time.
                            </p>
                        </div>
                        <div class="card__foot">
                            <span class="form-actions__note">You will be sent to GitHub and straight back.</span>
                            <form method="post" action="/account/github/link">
                                <AntiforgeryToken />
                                @if (CameFromRepositoriesTab)
                                {
                                    <input type="hidden" name="Return" value="@ReturnTo" />
                                }
                                <button type="submit" class="btn">
                                    <Icon Name="link" Width="16" Height="16" />
                                    <span>Connect GitHub</span>
                                </button>
                            </form>
                        </div>
                    }
                </section>
                }

                <section class="card">
                    <div class="card__head">
                        <div>
                            <h2 class="card__title">Repository access for builds</h2>
                            <p class="card__sub">
                                @* "A different job from the GitHub account above" is only true when
                                   that card is on the page - an Azure DevOps org does not see it. *@
                                @* Since the build clones with the connected GitHub account first,
                                   a GitHub token is the exception rather than the rule; say so, or
                                   people keep making tokens they no longer need. *@
                                @if (ShowGitHubCard)
                                {
                                    <text>When one of your solutions builds, AL Workbench reads each
                                    repository using your own access, so a build never sees more than
                                    you can. For GitHub that is the account connected above, so you only
                                    need a GitHub token if a build tells you a repository could not be
                                    read - usually one in a customer's organisation your account was
                                    never added to. Azure DevOps always needs a token.</text>
                                }
                                else
                                {
                                    <text>When one of your solutions builds, AL Workbench reads each
                                    repository using your own access, through a token you paste here.</text>
                                }
                                Tokens are stored encrypted and are only used to read your
                                repositories during a build. If one expires or is revoked, the build
                                stops and says which repository it could not read.
                            </p>
                        </div>
                    </div>

                    @if (_repoLoading)
                    {
                        <div class="loading-block">
                            <span class="spinner"></span><span>Loading...</span>
                        </div>
                    }
                    else if (_repoProviders.Count == 0)
                    {
                        <div class="empty-state empty-state--quiet">
                            <span class="empty-state__title">No Git providers turned on yet</span>
                            <span class="empty-state__text">
                                An administrator enables these for your organisation under
                                Administration → Repositories. Once one is on, you connect it here.
                            </span>
                        </div>
                    }
                    else
                    {
                        <table class="data-table data-table--edge">
                            <thead>
                                <tr>
                                    <th class="data-table__col-state"><span class="u-sr">Status</span></th>
                                    <th>Provider</th>
                                    <th>Last used</th>
                                    <th class="data-table__actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var p in _repoProviders)
                            {
                                var f = _repoFields[p];
                                var state = RepoRowState(p, f.HasToken);
                                <tr class="@RowStateIcon.RowClass(state)">
                                    <td class="data-table__col-state"><RowStateIcon State="@state" /></td>
                                    <td>
                                        @p.DisplayName()
                                        @* "Not connected" here read as "your GitHub is not connected"
                                           to anyone who had just connected it in the card above. Name
                                           the missing thing instead of the host. *@
                                        <div class="u-muted">@RepoRowText(p, f.HasToken)</div>
                                    </td>
                                    <td class="u-muted"><Timestamp Value="@f.LastUsedAt" Format="d MMM yyyy" Placeholder="Never" /></td>
                                    <td class="data-table__actions">
                                        @if (f.HasToken)
                                        {
                                            <button type="button" class="btn btn--sm btn--danger"
                                                    @onclick="() => DisconnectRepoAsync(p)">Disconnect</button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        @if (_showRepoForm)
                        {
                            <div class="card__body">
                                <div class="form-grid">
                                    @foreach (var p in _repoProviders)
                                    {
                                        var f = _repoFields[p];
                                        <label class="field">
                                            <span class="field__label">@p.DisplayName() build token</span>
                                            <input class="input" type="password" autocomplete="off"
                                                   placeholder="@(f.HasToken ? "Leave blank to keep the stored token" : RepoPlaceholder(p))"
                                                   @bind="f.NewValue" disabled="@_repoSaving" />
                                            <span class="field__hint">@RepoScopeHint(p)</span>
                                        </label>
                                    }
                                </div>
                            </div>
                            <div class="card__foot">
                                <button type="button" class="btn" @onclick="() => _showRepoForm = false" disabled="@_repoSaving">Cancel</button>
                                <button type="button" class="btn btn--primary" @onclick="SaveRepoTokensAsync" disabled="@_repoSaving">
                                    <Icon Name="save" Width="16" Height="16" />
                                    <span>@(_repoSaving ? "Saving..." : "Save tokens")</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="card__foot">
                                <span class="form-actions__note">Only used when one of your solutions builds.</span>
                                <button type="button" class="btn" @onclick="() => _showRepoForm = true">
                                    <Icon Name="plus" Width="16" Height="16" />
                                    <span>@(_connectedRepoCount > 0 ? "Add or update a token" : "Add a build token")</span>
                                </button>
                            </div>
                        }
                    }
                </section>
            }
        </ChildContent>
    </TabbedPage>
}

<ConfirmDialog @ref="_confirmDelete" />

@code {
    private enum Section { Profile, Notifications, Security, Ai, Repos }

    /// <summary>The tab in the address, /account/security. Absent is Profile. See <see cref="SegmentFor"/>.</summary>
    [Parameter] public string? SectionName { get; set; }

    /// <summary>
    /// The address a tab had before it had a path, ?section=security. It is in sent
    /// emails and bookmarks, so it is forwarded to the path form.
    /// </summary>
    [SupplyParameterFromQuery(Name = "section")] public string? SectionParam { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Message { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    [SupplyParameterFromQuery(Name = "required")] public string? Required { get; set; }
    /// <summary>
    /// Set when an admin was sent here from Administration -> Repositories to
    /// link before connecting their organisation. A closed marker, not a URL -
    /// see <c>GitHubAppEndpoints.AdminRepositoriesReturn</c>.
    /// </summary>
    [SupplyParameterFromQuery(Name = "return")] public string? ReturnTo { get; set; }

    private Section _section = Section.Profile;
    private IReadOnlyList<HeaderTabs.HeaderTabItem> _tabs = Array.Empty<HeaderTabs.HeaderTabItem>();

    private User? _user;
    private Organization? _organization;
    private bool _smtpConfigured;
    private bool _pendingEmailMfa;
    private int _recoveryRemaining;
    private string? _totpAction; // null, "regenerate" or "disable" — drives the inline password confirm
    private bool _busy;
    private string? _passkeyError;
    private IReadOnlyList<UserPasskey> _passkeys = Array.Empty<UserPasskey>();
    private IReadOnlyList<UserExternalLogin> _entraLinks = Array.Empty<UserExternalLogin>();
    private bool _orgEntraEnabled;
    private string? _entraLinkError;
    private ConfirmDialog? _confirmDelete;

    // AI assistants
    private IReadOnlyList<PersonalAccessToken>? _tokens;
    private IReadOnlyList<ConnectedClient>? _clients;
    private bool _showCreateToken;

    // Repository access
    private bool _repoLoading = true;
    private bool _repoSaving;
    private bool _showRepoForm;
    private string? _repoOk;
    private string? _repoErr;
    private List<RepositoryProvider> _repoProviders = new();
    private readonly Dictionary<RepositoryProvider, RepoField> _repoFields = new();

    // The GitHub account link. Deliberately separate from the token rows above:
    // a token is something you paste, this is something you authorise, and the
    // two answer different questions.
    private bool _githubLoading = true;
    private bool _githubBusy;
    private bool _githubAvailable;
    /// <summary>A fact that is neither a success nor a failure - "GitHub still does not list you" is the case that forced it.</summary>
    private string? _githubNote;
    private string? _githubOrgLogin;
    private GitHubLinkStatus? _github;

    private sealed class RepoField
    {
        public bool HasToken { get; set; }
        public DateTime? LastUsedAt { get; set; }
        public string? NewValue { get; set; }
    }

    private bool _twoStepOn => _user is { } u && (u.TotpEnabled || u.EmailMfaEnabled);
    private int _connectedRepoCount => _repoFields.Values.Count(f => f.HasToken);

    protected override async Task OnInitializedAsync()
    {
        // Leaving for the tab's own address: OnParametersSet sends it, and the page
        // there reads everything again.
        if (AddressToSettleOn() is not null) return;
        var userId = Org.CurrentUserId;
        if (userId is null) return;
        var overview = await Accounts.GetAccountOverviewAsync(userId.Value);
        if (overview is null) return;
        _user = overview.User;
        _organization = overview.Organization;
        _orgEntraEnabled = overview.OrganizationEntraEnabled;
        _smtpConfigured = await Email.IsConfiguredAsync();
        _pendingEmailMfa = Ok == "email-mfa-sent";
        _recoveryRemaining = await RecoveryCodes.RemainingAsync(_user.Id);
        if (Passkeys.IsConfigured)
        {
            _passkeys = await Passkeys.ListForUserAsync(_user.Id);
        }
        _entraLinks = await Entra.ListLinksAsync(_user.Id);
        _tokens = await Pats.ListForUserAsync(_user.Id);
        _clients = await OAuthClients.ListForUserAsync(_user.Id);

        await ReloadReposAsync();
        _repoLoading = false;

        await ReloadGitHubAsync();
        _githubLoading = false;
    }

    /// <summary>
    /// Reads the GitHub link and the organisation's connected GitHub
    /// organisation. Never calls GitHub itself, so the section still renders
    /// when GitHub is unreachable.
    /// </summary>
    private async Task ReloadGitHubAsync()
    {
        _githubAvailable = (await Settings.GetGitHubAppViewAsync()).IsConfigured;
        _githubOrgLogin = (await OrgConfig.GetCurrentAsync()).Settings.GitHubOrgLogin;
        _github = await GitHubAccess.GetLinkStatusAsync();
    }

    /// <summary>
    /// Disconnects the GitHub link. Confirmed first, like the other two things
    /// on this page you can take away from yourself - the same shape as
    /// <see cref="DisconnectClientAsync"/>; the POST endpoint behind
    /// <c>/account/github/unlink</c> is the non-interactive route to the same
    /// service call, mirroring the Microsoft link.
    /// </summary>
    private async Task DisconnectGitHubAsync()
    {
        if (_confirmDelete is null || _githubBusy) return;
        var confirmed = await _confirmDelete.OpenAsync(
            title: "Disconnect GitHub?",
            message: "The workbench will stop working with GitHub as you. Nothing on GitHub changes, and you can connect again whenever you like.",
            confirmLabel: "Disconnect",
            confirmButtonClass: "btn--danger");
        if (!confirmed) return;
        _githubBusy = true;
        _repoOk = _repoErr = _githubNote = null;
        try
        {
            await GitHubAccess.UnlinkAsync();
            await ReloadGitHubAsync();
            _repoOk = "GitHub disconnected.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disconnect the GitHub account link.");
            _repoErr = "An unexpected error occurred. Your GitHub account is still connected.";
        }
        finally
        {
            _githubBusy = false;
        }
    }

    /// <summary>Asks GitHub again whether this person is in the connected organisation, and stores the answer.</summary>
    private async Task RecheckGitHubMembershipAsync()
    {
        if (_user is null || _githubBusy) return;
        _githubBusy = true;
        _repoOk = _repoErr = _githubNote = null;
        try
        {
            var member = await GitHubAccess.TryGetOrgMembershipAsync(_user.Id);
            await ReloadGitHubAsync();
            if (member is null)
            {
                // GitHub did not answer, so neither of the sentences below is
                // true. Saying "an owner has to add you" here would be advice
                // she cannot act on, about a problem she does not have.
                _repoErr = "We could not reach GitHub just now. Try again in a minute.";
            }
            else if (member.Value)
            {
                _repoOk = $"You are in the {_githubOrgLogin} organisation on GitHub. Its repositories will show up in the workbench now.";
            }
            else
            {
                // Not a success and not a failure of ours: an owner of the GitHub
                // organisation has to act. A green tick here told her the opposite
                // of what the sentence said.
                _githubNote = $"GitHub still does not list you in {_githubOrgLogin}. Only an owner of that organisation can add you - ask one of them, then choose Check again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to re-check GitHub organisation membership.");
            _repoErr = "We could not reach GitHub just now. Try again in a minute.";
        }
        finally
        {
            _githubBusy = false;
        }
    }

    /// <summary>
    /// The row's own summary of the link. A green tick claimed everything was
    /// fine while the alert underneath said her repositories would not appear,
    /// so a link that cannot do its job gets the attention keyline instead.
    /// </summary>
    private string GitHubRowState =>
        _github is null || _github.NeedsRelink ? "failed"
        : _githubOrgLogin is not null && _github.IsOrgMember != true ? "needs-attention"
        : "connected";

    /// <summary>True when the admin arrived from the Repositories tab and still has that job to finish.</summary>
    private bool CameFromRepositoriesTab =>
        ReturnTo == ALDevToolbox.Endpoints.GitHubAppEndpoints.AdminRepositoriesReturn;

    /// <summary>The connected organisation's people page, so "ask an owner" has somewhere to go.</summary>
    private string GitHubOrgPeopleUrl =>
        $"https://github.com/orgs/{Uri.EscapeDataString(_githubOrgLogin ?? string.Empty)}/people";

    /// <summary>
    /// Whether to offer the GitHub account link at all. An organisation that
    /// keeps its code on Azure DevOps should not be pitched a GitHub set-up it
    /// will never use - but someone who linked before the admin narrowed the
    /// list still needs the row, if only to disconnect.
    /// </summary>
    private bool ShowGitHubCard =>
        _repoProviders.Contains(RepositoryProvider.GitHub) || _github is { IsLinked: true };

    /// <summary>
    /// The one line under the login that answers "why can't I see any
    /// repositories". Three different facts, and saying nothing when we do not
    /// know beats guessing.
    /// </summary>
    private string GitHubMembershipLine
    {
        get
        {
            // A link that has stopped working says so first: "Connected" under a
            // red row was the row contradicting itself.
            if (_github is null || _github.NeedsRelink) return "Not working - connect again";
            if (_githubOrgLogin is null) return "Connected";
            return _github.IsOrgMember switch
            {
                true => $"In the {_githubOrgLogin} organisation",
                false => $"Not in the {_githubOrgLogin} organisation",
                _ => $"We could not check whether you are in {_githubOrgLogin}",
            };
        }
    }

    /// <summary>
    /// Runs on every parameter change, not just the first: a page that is already
    /// built can be handed another tab's address as new parameters.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (AddressToSettleOn() is { } settled)
        {
            Nav.NavigateTo(settled, replace: true);
            return;
        }
        _section = ResolveSection();
        _tabs = new HeaderTabs.HeaderTabItem[]
        {
            new("Profile", AddressOf(Section.Profile), _section == Section.Profile),
            new("Notifications", AddressOf(Section.Notifications), _section == Section.Notifications),
            new("Sign-in & security", AddressOf(Section.Security), _section == Section.Security),
            new("AI assistants", AddressOf(Section.Ai), _section == Section.Ai),
            new("Repository access", AddressOf(Section.Repos), _section == Section.Repos),
        };
    }

    /// <summary>A tab's name in the address. Null for Profile, the tab the bare /account opens on.</summary>
    private static string? SegmentFor(Section section) =>
        section == Section.Profile ? null : section.ToString().ToLowerInvariant();

    private static string AddressOf(Section section) =>
        SegmentFor(section) is { } segment ? $"/account/{segment}" : "/account";

    /// <summary>
    /// Where this page should be, or null when it is there: a <c>?section=</c> moves
    /// into the path, a name is lower-cased, Profile or a name that is not a tab drops
    /// to the bare address, and a bare address carrying a redirect's code moves to the
    /// tab the code belongs to. Every other query value (the codes and messages) rides
    /// along.
    /// </summary>
    private string? AddressToSettleOn()
    {
        var wanted = AddressOf(ResolveSection());
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var path = relative.Split('?', '#')[0];
        if (SectionParam is null && string.Equals(path, wanted, StringComparison.Ordinal)) return null;
        var query = new Uri(Nav.GetUriWithQueryParameter("section", (string?)null)).Query;
        return wanted + query;
    }

    /// <summary>
    /// Picks the section to show. A tab named in the address wins; otherwise we land
    /// the user where a redirect's <c>ok=</c>/<c>err=</c> code (or the strong-auth
    /// gate's <c>required=1</c>) belongs, so the success/error banner shows in context
    /// rather than on Profile.
    /// </summary>
    private Section ResolveSection()
    {
        var named = SectionName ?? SectionParam;
        Section? explicitSection = named?.ToLowerInvariant() switch
        {
            "profile" => Section.Profile,
            "notifications" => Section.Notifications,
            "security" => Section.Security,
            "ai" => Section.Ai,
            "repos" => Section.Repos,
            _ => null,
        };
        if (explicitSection is { } section) return section;
        if (Required == "1") return Section.Security;
        if (CameFromRepositoriesTab) return Section.Repos;
        var code = Ok ?? Error;
        return code switch
        {
            "display-name" => Section.Profile,
            "password" or "totp-disabled" or "email-mfa-sent" or "email-mfa-enabled"
                or "email-mfa-disabled" or "passkey-added" or "passkey-deleted" or "passkey-renamed"
                or "ms-linked" or "ms-unlinked"
                or "Totp" or "Email" or "Code" or "Password" or "CurrentPassword" or "NewPassword"
                or "Passkey" => Section.Security,
            "token-revoked" or "token-created" => Section.Ai,
            "github-linked" or "github-unlinked" => Section.Repos,
            _ => Section.Profile,
        };
    }

    private static string FlashFor(string ok) => ok switch
    {
        "password" => "Password updated.",
        "display-name" => "Full name updated.",
        "totp-disabled" => "Authenticator app turned off.",
        "email-mfa-sent" => "We sent you a verification code. Enter it below to turn on email codes.",
        "email-mfa-enabled" => "Email codes turned on.",
        "email-mfa-disabled" => "Email codes turned off.",
        "passkey-added" => "Passkey added.",
        "passkey-deleted" => "Passkey removed.",
        "passkey-renamed" => "Passkey renamed.",
        "ms-linked" => "Microsoft account connected. You can now use \"Sign in with Microsoft\" on the login page.",
        "ms-unlinked" => "Microsoft account disconnected.",
        "token-revoked" => "Access token revoked.",
        "github-linked" => "GitHub connected. The workbench can now work with the repositories you have access to.",
        "github-unlinked" => "GitHub disconnected. The workbench no longer works with GitHub as you.",
        _ => "Saved.",
    };

    /// <summary>
    /// Disconnects one Microsoft account link. The service refuses the last
    /// link in a Microsoft-only organisation - that would lock the user out of
    /// their own account - and its message is what the user sees.
    /// </summary>
    private async Task DisconnectEntraAsync(UserExternalLogin link)
    {
        if (_user is null || _confirmDelete is null || _busy) return;
        _entraLinkError = null;
        var confirmed = await _confirmDelete.OpenAsync(
            title: "Disconnect this Microsoft account?",
            message: $"You'll stop being able to sign in as {link.DisplayIdentity} with Microsoft and go back to your other sign-in methods.",
            confirmLabel: "Disconnect");
        if (!confirmed) return;
        _busy = true;
        try
        {
            await Entra.UnlinkAsync(_user.Id, link.Id);
            _entraLinks = await Entra.ListLinksAsync(_user.Id);
        }
        catch (PlanValidationException ex)
        {
            _entraLinkError = ex.Errors.FirstOrDefault().Value ?? "The Microsoft account could not be disconnected.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disconnect Microsoft account for user {UserId}.", _user.Id);
            _entraLinkError = "An unexpected error occurred. The account was not disconnected.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string RoleWord(UserRole role) => role switch
    {
        UserRole.Admin => "Admin",
        UserRole.Editor => "Editor",
        _ => "User",
    };

    private static string RoleBlurb(UserRole role) => role switch
    {
        UserRole.Admin => "Full access",
        UserRole.Editor => "Can author content",
        _ => "Uses the generator",
    };

    // --- Passkeys --------------------------------------------------------

    private async Task RegisterPasskeyAsync()
    {
        _busy = true;
        _passkeyError = null;
        try
        {
            await JS.InvokeVoidAsync("aldtPasskey.register");
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away mid-ceremony — nothing to show the user.
        }
        catch (Exception ex)
        {
            // Don't surface the raw JS-interop / .NET exception text to the user;
            // log the detail and show a friendly line instead.
            Logger.LogWarning(ex, "Passkey registration failed for user {UserId}.", Org.CurrentUserId);
            _passkeyError = "We couldn't finish adding that passkey. Try again, or use a different authenticator.";
        }
        finally
        {
            _busy = false;
        }
    }

    // --- Connected assistants -------------------------------------------

    /// <summary>
    /// Disconnecting stops an assistant reaching the workbench as you, so it asks
    /// first — the old row button did it on a single click with no way back.
    /// </summary>
    private async Task DisconnectClientAsync(ConnectedClient client)
    {
        if (_user is null || _confirmDelete is null) return;
        var confirmed = await _confirmDelete.OpenAsync(
            title: "Disconnect this assistant?",
            message: $"{client.DisplayName} will lose access straight away. You can reconnect it from the assistant itself.",
            confirmLabel: "Disconnect",
            confirmButtonClass: "btn--danger");
        if (!confirmed) return;
        await OAuthClients.RevokeConsentAsync(client.ConsentId, _user.Id);
        _clients = await OAuthClients.ListForUserAsync(_user.Id);
    }

    private static string HumanScopes(string scopes)
    {
        var parts = scopes.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var labels = parts.Select(s => s switch
        {
            "mcp" => "Use AL Workbench tools",
            "offline_access" => "Stay signed in",
            _ => s,
        });
        return string.Join(", ", labels);
    }

    // --- Repository access ----------------------------------------------

    private async Task ReloadReposAsync()
    {
        _repoProviders = (await RepoProviderPolicy.GetAllowedProvidersAsync()).ToList();
        var status = await RepoTokens.GetTokenStatusAsync();
        _repoFields.Clear();
        foreach (var p in _repoProviders)
        {
            status.TryGetValue(p, out var s);
            _repoFields[p] = new RepoField { HasToken = s is not null, LastUsedAt = s?.LastUsedAt };
        }
    }

    private async Task SaveRepoTokensAsync()
    {
        if (_repoSaving) return;
        _repoSaving = true;
        _repoOk = _repoErr = null;
        try
        {
            var saved = 0;
            foreach (var p in _repoProviders)
            {
                var f = _repoFields[p];
                if (!string.IsNullOrWhiteSpace(f.NewValue))
                {
                    await RepoTokens.SaveTokenAsync(p, f.NewValue, clear: false);
                    saved++;
                }
            }
            await ReloadReposAsync();
            _showRepoForm = false;
            _repoOk = saved == 1 ? "Repository token saved." : saved > 1 ? "Repository tokens saved." : null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save repository tokens.");
            _repoErr = "An unexpected error occurred. The change was not saved.";
        }
        finally
        {
            _repoSaving = false;
        }
    }

    private async Task DisconnectRepoAsync(RepositoryProvider provider)
    {
        if (_confirmDelete is null) return;
        var confirmed = await _confirmDelete.OpenAsync(
            title: $"Disconnect {provider.DisplayName()}?",
            message: $"Your stored {provider.DisplayName()} token will be removed. Builds you start that clone {provider.DisplayName()} repositories will fail until you reconnect.",
            confirmLabel: "Disconnect",
            confirmButtonClass: "btn--danger");
        if (!confirmed) return;
        try
        {
            await RepoTokens.SaveTokenAsync(provider, plaintext: null, clear: true);
            await ReloadReposAsync();
            _repoOk = $"{provider.DisplayName()} disconnected.";
            _repoErr = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disconnect repository provider {Provider}.", provider);
            _repoErr = "An unexpected error occurred. The change was not saved.";
        }
    }

    /// <summary>
    /// Where to make the token and what to let it do. Named after the controls
    /// the person will actually see on the provider's own page - "repo (read)
    /// scope" was our word for it, not theirs.
    /// </summary>
    private static string RepoScopeHint(RepositoryProvider p) => p switch
    {
        RepositoryProvider.GitHub => "Only add this if a build reported that a GitHub repository could not be read. Make one on github.com under Settings → Developer settings → Personal access tokens → Fine-grained tokens, give it the repository, and set Contents to Read-only - it needs nothing else.",
        RepositoryProvider.AzureDevOps => "Make one on dev.azure.com, under User settings then Personal access tokens. Tick Code (Read) - it needs nothing else.",
        _ => string.Empty,
    };

    /// <summary>
    /// Whether a build can reach this provider as the person: a stored token,
    /// or for GitHub a healthy connected account. The row's icon and its second
    /// line answer from the same test, so they cannot disagree.
    /// </summary>
    private bool RepoRowReady(RepositoryProvider p, bool hasToken) =>
        hasToken || (p == RepositoryProvider.GitHub && _github is { IsLinked: true, NeedsRelink: false });

    private string RepoRowState(RepositoryProvider p, bool hasToken) =>
        RepoRowReady(p, hasToken) ? "connected" : "not-connected";

    /// <summary>
    /// The second line of a provider row. GitHub without a token is not "nothing",
    /// because the connected account clones on its own; only GitHub with neither
    /// is.
    /// </summary>
    private string RepoRowText(RepositoryProvider p, bool hasToken)
    {
        if (hasToken) return "Build token stored";
        return RepoRowReady(p, hasToken)
            ? "Builds with your connected GitHub account"
            : "No build token yet";
    }

    private static string RepoPlaceholder(RepositoryProvider p) => p switch
    {
        RepositoryProvider.GitHub => "Paste a GitHub personal access token",
        RepositoryProvider.AzureDevOps => "Paste an Azure DevOps personal access token",
        _ => "Paste a token",
    };
}
