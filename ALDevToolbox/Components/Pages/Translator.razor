@page "/translator"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using ALDevToolbox.Services.ObjectExplorer.Import
@using Microsoft.Extensions.DependencyInjection
@using ALDevToolbox.Services.Translation
@using ALDevToolbox.Services.Translation.Providers
@using ALDevToolbox.Services.GitHub
@using ALDevToolbox.Domain.ValueObjects
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject MachineTranslationService Mt
@inject TranslationSuggestionCoordinator Coordinator
@inject GitHubTranslationService RepoFiles
@inject ILogger<Translator> Log
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Translator · AL Workbench</PageTitle>

@* The Translator is page archetype 9 -- the translation grid -- so it wears the
   shared power-tool frame from pages-power.css: .pw fills the shell content
   area and every pane scrolls inside itself, which is what keeps the toolbar
   and the grid header put while 400 rows go past. .u-compact re-declares the
   density tokens (28px rows) for the whole tool.

   Only the loaded-file view is a power tool. The first-run screen is an
   ordinary .page, because .app__content:has(.pw) strips the shell's padding
   for the whole content column -- a drop target floating in an unpadded
   viewport is not what anyone wants to land on. *@
@if (!_hasFile)
{
    <div class="page">
        <PageHead Title="Translator">
            <SubtitleContent>
                Open an XLIFF (<code>.xlf</code>) file from your extension and translate it here. The file's
                exact formatting is kept, so a git diff shows only what you changed.
            </SubtitleContent>
        </PageHead>

        @if (_restoreName is not null)
        {
            <div class="note note--info">
                <span class="note__icon"><Icon Name="history" /></span>
                <div class="note__title">Pick up where you left off?</div>
                <div class="note__body">
                    <p>You were translating <strong>@_restoreName</strong> (last edited @_restoreAge).</p>
                    <div class="u-row">
                        <button type="button" class="btn btn--sm" @onclick="RestoreAsync" disabled="@_busy">Continue</button>
                        <button type="button" class="btn btn--sm btn--ghost" @onclick="DiscardAsync" disabled="@_busy">Discard those edits</button>
                    </div>
                </div>
            </div>
        }

        <div class="tdrop">
            <span class="tdrop__icon"><Icon Name="upload" Width="22" Height="22" /></span>
            <span class="tdrop__title">Open your extension's <code>.xlf</code></span>
            @if (_fsAccess)
            {
                @* This browser can open a file and save edits straight back to
                   it, so the picker (not a plain file input) is the click path —
                   that way click-to-open and drag-and-drop both grant the write
                   access an in-place Save needs. *@
                @* Click is wired in Translator.razor.js (initPicker), not via
                   @onclick — showOpenFilePicker must run inside the user gesture,
                   which a SignalR round-trip would drop. *@
                <span class="tdrop__hint">.xlf or .xliff · up to @(_maxFileMb) MB · your edits save straight back to the file you open (a build-generated .g.xlf is saved as a new language file instead)</span>
                <button type="button" class="btn btn--primary tdrop__btn" disabled="@_busy">
                    <Icon Name="folder-open" Width="15" Height="15" Css="btn__icon" /> Choose file
                </button>
            }
            else
            {
                @* No File System Access API here, so the whole panel is one
                   <label> over a transparent file input -- click anywhere. *@
                <span class="tdrop__hint">.xlf or .xliff · up to @(_maxFileMb) MB · you export a copy when you are done</span>
                <label class="btn btn--primary tdrop__label">
                    <Icon Name="folder-open" Width="15" Height="15" Css="btn__icon" /> Choose file
                    <InputFile OnChange="OnUploadAsync" accept=".xlf,.xliff" class="tdrop__input" />
                </label>
            }
            <p class="tdrop__aside">
                You will land on the strings that still need work — switch to <strong>All</strong> to see the
                rest. Each one comes with suggestions from the translations your organisation has already
                made. You can also drop the file anywhere on this panel.
            </p>
            @if (_busy)
            {
                <p class="tdrop__note">Reading file...</p>
            }
            @if (_parseError is not null)
            {
                <p class="tdrop__note tdrop__note--error"><Icon Name="circle-x" Width="14" Height="14" /> @_parseError</p>
            }
        </div>

        @* Open from a repository (issue #625). Below the upload panel and
           without a primary button of its own: "Choose file" is this page's one
           primary action, and a file in the list below opens when it is
           clicked, so there is nothing here to press twice.

           The sentence about the pull request is here rather than beside the
           Save button because this is where there is room for it, and because
           it is what makes someone willing to press Save later. *@
        <div class="trepo">
            <div class="trepo__head">
                <span class="trepo__icon"><Icon Name="folder-git-2" Width="18" Height="18" /></span>
                <div>
                    <div class="trepo__title">Or open one from a repository</div>
                    <p class="trepo__sub">
                        Pick the repository and the workbench lists the <code>.xlf</code> files in it. When you
                        save, your translation goes back on a branch of its own and opens a pull request -
                        nothing on the repository's own branch changes until someone merges it.
                    </p>
                </div>
            </div>

            <RepositoryPicker Selected="_repo" SelectedChanged="OnRepositoryChangedAsync"
                              Label="Repository" InputId="tr-repo" Disabled="@_busy" />

            @if (_repo is not null)
            {
                @if (_repoListLoading)
                {
                    <div class="loading-block">
                        <span class="spinner"></span><span>Looking for translation files...</span>
                    </div>
                }
                else if (_repoListError is not null)
                {
                    <Alert Tone="AlertTone.Warn" Role="alert">
                        <span class="u-stack">
                            <span>@_repoListError</span>
                            <span><button type="button" class="btn btn--sm" @onclick="ReloadRepositoryFilesAsync">Try again</button></span>
                        </span>
                    </Alert>
                }
                else if (_repoList.Count == 0)
                {
                    <p class="field__hint">
                        @_repo.FullName has no translation files yet. AL keeps them in a
                        <code>Translations</code> folder inside each extension.
                    </p>
                }
                else
                {
                    <ul class="trepo__files">
                        @foreach (var group in _repoList.GroupBy(f => f.Folder))
                        {
                            @if (!string.IsNullOrEmpty(group.Key))
                            {
                                <li class="trepo__group">@group.Key</li>
                            }
                            @foreach (var file in group)
                            {
                                <li>
                                    <button type="button" class="trepo__file" disabled="@_busy"
                                            @onclick="() => OpenFromRepositoryAsync(file)">
                                        <span class="trepo__file-icon"><Icon Name="file-code" Width="15" Height="15" /></span>
                                        <span class="trepo__file-text">
                                            <span class="trepo__file-name">@file.FileName</span>
                                            @if (file.IsSource)
                                            {
                                                <span class="trepo__file-sub">All the strings, none translated - start a new language here</span>
                                            }
                                            else if (file.Language is not null)
                                            {
                                                <span class="trepo__file-sub">@LanguageLabel(file.Language)</span>
                                            }
                                        </span>
                                        <span class="trepo__file-go"><Icon Name="chevron-right" Width="15" Height="15" /></span>
                                    </button>
                                </li>
                            }
                        }
                    </ul>
                }
            }
        </div>
    </div>
}
else
{
    var c = Counts();
    var hidden = HiddenCount();
    <div class="pw u-compact">
        @* Three rows, three jobs. The head says which file is open and carries
           the verbs that act on the file. The bar carries the controls that
           change what you are looking at. The foot is the status line: how much
           is left, and the keys that do the work.

           The progress ribbon started in the head. It moved to the foot when
           the filter tabs grew from three to four: the head cannot hold a 190px
           bar, four named counts AND four buttons on one 40px row, and the tabs
           now carry the per-state counts the ribbon's legend was duplicating. *@
        <div class="pw__head">
            <div class="pw__title">
                <span class="pw__name">Translator</span>
                @if (_editingName)
                {
                    <input class="pw__file tr-rename tr-rename--input" @bind="_fileName" @bind:event="oninput"
                           @onblur="StopRenameAsync" @onkeydown="OnFilenameKey" aria-label="File name" autofocus />
                }
                else
                {
                    <button type="button" class="pw__file tr-rename" @onclick="() => _editingName = true"
                            title="@(_fromGeneratedFile ? "Rename the translation file you download" : _canSaveInPlace ? "Rename the copy you export - the file you opened keeps its name" : "Rename the file you export")">
                        @_fileName
                        <Icon Name="pencil" Width="12" Height="12" />
                    </button>
                }
                @if (_unsaved)
                {
                    @* The only thing on screen that said edits were pending was
                       the modal you get when it is already too late to act on
                       it. Same dot the design system puts on a dirty file tab. *@
                    <span class="tr-dirty" title="You have edits that are not saved to a file yet"
                          aria-label="Unsaved edits"></span>
                }
                @* The payoff of the whole round trip, kept next to the file it
                   belongs to. The status line at the bottom has no width to
                   spare for it, and this is not a status - it is the thing the
                   translator wants to open next. *@
                @if (_pullRequest is not null)
                {
                    <a class="tr-pr" href="@_pullRequest.HtmlUrl" target="_blank" rel="noopener"
                       title="Open the pull request on GitHub">
                        <Icon Name="external-link" Width="12" Height="12" />Pull request #@_pullRequest.Number
                    </a>
                }
            </div>

            <span class="pw__sep"></span>

            <div class="tr-langs">
                <span class="tr-flag" title="Source language">@FlagOf(_sourceLang)</span>
                <Icon Name="arrow-right" Width="13" Height="13" />
                <SelectBox Class="tr-langsel">
                    <select class="select" aria-label="Target language" @onchange="OnTargetLangChanged">
                        @foreach (var l in Languages)
                        {
                            <option value="@l.Code" selected="@(l.Code == _targetLang)">@l.Name (@l.Code)</option>
                        }
                    </select>
                </SelectBox>
            </div>

            <span class="pw__spacer"></span>

            <button type="button" class="btn btn--sm" @onclick="PreTranslateAsync" disabled="@_busy"
                    title="Fill every untranslated string that has an exact match in your organisation's memory">
                <Icon Name="zap" Width="14" Height="14" Css="btn__icon" /><span>Pre-translate</span>
            </button>
            @if (_repoSource is not null)
            {
                @* The file came from a repository, so saving it back there is
                   what "save" means here - the download stays available beside
                   it, one step down, and there is still one primary button. *@
                <button type="button" class="btn btn--sm btn--primary" @onclick="SaveToRepositoryAsync" disabled="@_busy"
                        title="Commit your translation to @_repoSource.Repository.FullName and open a pull request for it">
                    <Icon Name="git-branch" Width="14" Height="14" Css="btn__icon" />
                    <span>@(_repoSaving ? "Saving..." : $"Save to repository{(_unsaved ? $" ({DirtyCount()})" : "")}")</span>
                </button>
                <button type="button" class="btn btn--sm" @onclick="ExportCopyAsync" disabled="@_busy">
                    <Icon Name="download" Width="14" Height="14" Css="btn__icon" /><span>Export a copy</span>
                </button>
            }
            else if (_fromGeneratedFile)
            {
                @* The file opened is the one the build generates and rewrites
                   every time, so saving into it would lose the translation on
                   the next build (#1325). The work goes out as a language file
                   of its own instead, named in the head. *@
                <button type="button" class="btn btn--sm btn--primary" @onclick="ExportCopyAsync" disabled="@_busy"
                        title="Download your translation as @_fileName and put it next to the file you opened in your Translations folder. The file you opened is rebuilt by every build, so it is left as it is.">
                    <Icon Name="download" Width="14" Height="14" Css="btn__icon" /><span>Download translation@(_unsaved ? $" ({DirtyCount()})" : "")</span>
                </button>
            }
            else if (_canSaveInPlace)
            {
                <button type="button" class="btn btn--sm btn--primary" @onclick="ExportAsync" disabled="@_busy"
                        title="Save your edits back into the file you opened (Ctrl+S)">
                    <Icon Name="save" Width="14" Height="14" Css="btn__icon" /><span>Save@(_unsaved ? $" ({DirtyCount()})" : "")</span>
                </button>
                <button type="button" class="btn btn--sm" @onclick="ExportCopyAsync" disabled="@_busy">
                    <Icon Name="download" Width="14" Height="14" Css="btn__icon" /><span>Export a copy</span>
                </button>
            }
            else
            {
                <button type="button" class="btn btn--sm btn--primary" @onclick="ExportAsync" disabled="@_busy"
                        title="Download the file with your edits in it, to replace the one you opened">
                    <Icon Name="download" Width="14" Height="14" Css="btn__icon" /><span>Export .xlf@(_unsaved ? $" ({DirtyCount()})" : "")</span>
                </button>
            }
            <button type="button" class="btn btn--sm" @onclick="CloseFileAsync" disabled="@_busy">
                <Icon Name="x" Width="14" Height="14" Css="btn__icon" /><span>Close</span>
            </button>
        </div>

        <div class="pw__bar">
            @if (_fromGeneratedFile && !_generatedNoteDismissed)
            {
                @* The header shows a different file name from the one the user
                   opened, and the language was chosen for them; without this
                   they would think they opened the wrong file (#1325). Inside
                   the bar, full width, because the frame's grid has a fixed
                   row for each of head, bar, body and foot. *@
                <Alert Tone="AlertTone.Info" Block="true" Role="status" Class="tr-gennote">
                    <span class="tr-gennote__text">
                        @if (_openedFileName is not null)
                        {
                            <strong>@_openedFileName</strong>
                        }
                        else
                        {
                            <text>The file you opened</text>
                        }
                        is the file your build creates, and every build overwrites it. Your translation is saved as a new file, <strong>@_fileName</strong>,
                        to put next to it in your Translations folder. The language is set to
                        @LanguageLabel(_targetLang) - change it above if you are translating into another
                        language, and the file name follows.
                    </span>
                    <button type="button" class="btn btn--sm btn--ghost btn--icon" aria-label="Dismiss"
                            title="Dismiss" @onclick="() => _generatedNoteDismissed = true">
                        <Icon Name="x" Width="14" Height="14" />
                    </button>
                </Alert>
            }
            @* One tab per state, and every badge is the number of rows its own
               tab produces. The three-tab version showed 88 on a tab that
               filtered to 175, because the filter counted units needing review
               and the badge did not. *@
            <div class="pill-tabs" role="group" aria-label="Filter">
                <button type="button" class="pill-tab @(_filter == "todo" ? "is-active" : "")" @onclick='() => SetFilter("todo")'>
                    Untranslated <span class="pill-tab__count">@c.Todo</span>
                </button>
                <button type="button" class="pill-tab @(_filter == "review" ? "is-active" : "")" @onclick='() => SetFilter("review")'>
                    Needs review <span class="pill-tab__count">@c.Review</span>
                </button>
                <button type="button" class="pill-tab @(_filter == "done" ? "is-active" : "")" @onclick='() => SetFilter("done")'>
                    Translated <span class="pill-tab__count">@(c.Translated + c.Final)</span>
                </button>
                <button type="button" class="pill-tab @(_filter == "all" ? "is-active" : "")" @onclick='() => SetFilter("all")'>
                    All <span class="pill-tab__count">@c.Total</span>
                </button>
            </div>

            <SelectBox Class="tr-kindsel">
                <select class="select" aria-label="Kind" @onchange="OnKindChanged">
                    @foreach (var k in KindOptions())
                    {
                        <option value="@k" selected="@(k == _kind)">@k</option>
                    }
                </select>
            </SelectBox>

            <div class="tr-search">
                <Icon Name="search" Width="14" Height="14" />
                <input class="input" placeholder="Search source or target..." aria-label="Search source or target"
                       data-page-search aria-keyshortcuts="F3" title="Search source or target (F3)"
                       value="@_search" @oninput="OnSearchInput" />
            </div>

            <span class="pw__sep"></span>

            <div class="pill-tabs" role="group" aria-label="View">
                <button type="button" class="pill-tab @(_view == "list" ? "is-active" : "")" @onclick='() => _view = "list"'
                        title="One unit at a time, with suggestions from your organisation's memory">
                    <Icon Name="book-open" Width="14" Height="14" />List
                </button>
                <button type="button" class="pill-tab @(_view == "grid" ? "is-active" : "")" @onclick='() => _view = "grid"'
                        title="Every unit in one table, for a fast first pass. No suggestions - use List for those.">
                    <Icon Name="layout-dashboard" Width="14" Height="14" />Grid
                </button>
            </div>
        </div>

        <div class="pw__body">
            @if (_filtered.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-state__icon"><Icon Name="search" Width="21" Height="21" /></span>
                    <div class="empty-state__title">No units match</div>
                    <p class="empty-state__text">Try a different filter, kind, or search term.</p>
                    <div class="empty-state__action">
                        <button type="button" class="btn btn--sm" @onclick="ClearFilters">Clear filters</button>
                    </div>
                </div>
            }
            else if (_view == "list")
            {
                <div class="tr-split">
                    <div class="pane">
                        <div class="pane__head">
                            <span class="pane__title">Units</span>
                            <span class="pane__count">@_filtered.Count</span>
                        </div>
                        <div class="pane__body">
                            <Virtualize Items="_filtered" Context="u" OverscanCount="12">
                                <button type="button" class="tr-urow @RowStateIcon.RowClass(DesignState(u)) @(u.Id == _selId ? "is-selected" : "")"
                                        @onclick="() => SelectAsync(u.Id)">
                                    <span class="tr-urow__edge"></span>
                                    <span class="tr-urow__body">
                                        <span class="tr-urow__meta">
                                            <span class="tr-urow__st"><RowStateIcon State="@DesignState(u)" /></span>
                                            <span class="tr-kind">@u.Kind</span>
                                            <span class="tr-id">@u.Short</span>
                                        </span>
                                        <span class="tr-urow__src">@u.Source</span>
                                        @if (string.IsNullOrEmpty(u.Target))
                                        {
                                            <span class="tr-urow__tgt tr-urow__tgt--empty">Needs translation</span>
                                        }
                                        else
                                        {
                                            <span class="tr-urow__tgt">@u.Target</span>
                                        }
                                    </span>
                                </button>
                            </Virtualize>
                        </div>
                    </div>

                    <div class="pw-split" role="separator" aria-orientation="vertical" tabindex="0"
                         aria-label="Resize the editor" title="Drag to resize · arrow keys when focused"
                         data-tr-split><span class="pw-split__grip" aria-hidden="true"></span></div>

                    <div class="pane">
                        @if (_sel is not null)
                        {
                            <div class="pane__head">
                                <span class="pane__title">Editor</span>
                                <span class="pane__count">@(SelIndex() + 1) / @_filtered.Count</span>
                                <span class="pw__spacer"></span>
                                <button type="button" class="btn btn--sm btn--icon" @onclick="() => Nav(-1)" title="Previous unit (Alt+Up)" aria-label="Previous unit">
                                    <Icon Name="arrow-up" Width="14" Height="14" Css="btn__icon" />
                                </button>
                                <button type="button" class="btn btn--sm btn--icon" @onclick="() => Nav(1)" title="Next unit (Alt+Down)" aria-label="Next unit">
                                    <Icon Name="arrow-down" Width="14" Height="14" Css="btn__icon" />
                                </button>
                            </div>
                            <div class="pane__body">
                                <div class="pane__sec">
                                    <div class="pane__sec-h">
                                        <span>Source · @_sourceLang</span>
                                        <span class="pw__spacer"></span>
                                        <span class="tr-kind">@_sel.Kind</span>
                                    </div>
                                    <div class="tr-srcbox">@_sel.Source</div>
                                    <div class="tr-unitid">@_sel.Short</div>
                                </div>

                                @if (ReadableNote(_sel.Note) is { } note)
                                {
                                    <div class="pane__sec">
                                        <div class="pane__sec-h"><span>Developer note</span></div>
                                        <div class="tr-notebox">@note</div>
                                    </div>
                                }

                                <div class="pane__sec">
                                    <div class="pane__sec-h">
                                        <span>Target · @TargetLangName()</span>
                                    </div>
                                    <div class="tr-tgtwrap">
                                        <textarea class="textarea tr-tgtarea" value="@_sel.Target"
                                                  placeholder="Type the translation..."
                                                  @oninput="OnTargetInput"></textarea>
                                        <div class="tr-statepick" role="group" aria-label="State">
                                            @foreach (var opt in StatePickOptions)
                                            {
                                                <button type="button" class="tr-statebtn @(_sel.State == opt.Token ? "is-active" : "") @RowStateIcon.RowClass(DesignStateOf(opt.Token))"
                                                        @onclick="() => SetState(opt.Token)">
                                                    <RowStateIcon State="@DesignStateOf(opt.Token)" />@opt.Label
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="pane__sec">
                                    <div class="pane__sec-h">
                                        <span>Suggestions · from your organisation</span>
                                        <span class="pw__spacer"></span>
                                        @if (_mtTrigger != MtTrigger.Off)
                                        {
                                            @if (_mtLoading)
                                            {
                                                <span class="tr-mtstatus"><Icon Name="languages" Width="13" Height="13" /> Machine translating...</span>
                                            }
                                            else if (!_suggestions.Any(x => x.IsMachineTranslation))
                                            {
                                                <button type="button" class="btn btn--sm" @onclick="RequestMachineTranslationAsync">
                                                    <Icon Name="languages" Width="14" Height="14" Css="btn__icon" /> Machine translate
                                                </button>
                                            }
                                        }
                                    </div>
                                    <div class="tr-sugg__list">
                                        @if (_suggLoading)
                                        {
                                            <div class="tr-sugg__empty">Looking up memory...</div>
                                        }
                                        else if (_suggestions.Count == 0)
                                        {
                                            <div class="tr-sugg__empty">Nobody in your organisation has translated this text before. What you type here will be suggested next time.</div>
                                        }
                                        else
                                        {
                                            @for (var i = 0; i < _suggestions.Count; i++)
                                            {
                                                var s = _suggestions[i];
                                                var n = i + 1;
                                                <div class="tr-sugg" role="button" tabindex="0"
                                                     @onclick="() => Fill(s.TargetText)"
                                                     @onkeydown="e => OnActivateKey(e, () => Fill(s.TargetText))">
                                                    <span class="kbd tr-skey">@n</span>
                                                    <div class="tr-sugg__body">
                                                        <div class="tr-stext">@s.TargetText</div>
                                                        <div class="tr-smeta">
                                                            @if (s.SourceRepository is not null && s.SourcePath is not null)
                                                            {
                                                                @* Learned from a file in one of the organisation's own
                                                                   repositories, so the caption can go there. The click is
                                                                   stopped from filling the target - opening the file and
                                                                   accepting the suggestion are different intentions. *@
                                                                <a class="tr-sorigin tr-sorigin--link"
                                                                   href="@RepositoryFileUrl(s.SourceRepository, s.SourcePath)"
                                                                   target="_blank" rel="noopener noreferrer"
                                                                   title="@($"{s.SourceRepository} - {s.SourcePath}")"
                                                                   @onclick:stopPropagation="true">
                                                                    @* Both halves: the origin says what kind of file it
                                                                       came from, the repository says which one. *@
                                                                    <Icon Name="external-link" Width="12" Height="12" />@(s.Origin is { Length: > 0 } origin
                                                                        ? $"from {origin} · {s.SourceRepository}"
                                                                        : $"from {s.SourceRepository}")
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <span class="tr-sorigin"><Icon Name="database" Width="12" Height="12" />@(s.Origin ?? "from your organisation")</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="tr-sugg__side">
                                                        @if (s.IsMachineTranslation)
                                                        {
                                                            <span class="tr-ssim tr-ssim--mt" title="Machine translation">MT</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="tr-ssim @SimClass(s.Similarity)">@SimLabel(s.Similarity)</span>
                                                        }
                                                        @if (s.EntryId > 0)
                                                        {
                                                            <div class="tr-vote" @onclick:stopPropagation="true">
                                                                <button type="button" class="tr-vbtn @(s.MyVote > 0 ? "is-active" : "")" title="Good translation - vote up" aria-label="Vote up"
                                                                        @onclick="() => VoteSuggestionAsync(s.EntryId, s.MyVote > 0 ? 0 : 1)">
                                                                    <Icon Name="thumbs-up" Width="13" Height="13" />
                                                                </button>
                                                                <span class="tr-vscore @(s.Score > 0 ? "is-pos" : s.Score < 0 ? "is-neg" : "")">@s.Score</span>
                                                                <button type="button" class="tr-vbtn @(s.MyVote < 0 ? "is-active" : "")" title="Bad translation - vote down" aria-label="Vote down"
                                                                        @onclick="() => VoteSuggestionAsync(s.EntryId, s.MyVote < 0 ? 0 : -1)">
                                                                    <Icon Name="thumbs-down" Width="13" Height="13" />
                                                                </button>
                                                                <AuthorizeView Roles="Admin,Editor" Context="curate">
                                                                    <button type="button" class="tr-vbtn tr-vbtn--del" title="Remove this translation from the memory" aria-label="Remove from memory"
                                                                            @onclick="() => RemoveSuggestionAsync(s.EntryId)">
                                                                        <Icon Name="trash-2" Width="13" Height="13" />
                                                                    </button>
                                                                </AuthorizeView>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pane__head"><span class="pane__title">Editor</span></div>
                            <div class="pane__body"><div class="tr-sugg__empty">Select a unit to translate.</div></div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="tgrid">
                    <div class="tgrid__head">
                        <span></span>
                        <span class="tgrid__h">Unit</span>
                        <span class="tgrid__h">Source · @_sourceLang</span>
                        <span class="tgrid__h">Target · @TargetLangName()</span>
                        <span class="tgrid__h">State</span>
                        <span class="tgrid__h">Kind</span>
                        <span class="tgrid__h"><span class="u-sr">Row actions</span></span>
                    </div>
                    <div class="tgrid__scroll">
                        <Virtualize Items="_filtered" Context="u" ItemSize="28" OverscanCount="12">
                            @if (u.Id == _selId)
                            {
                                @* The open row: the target becomes a real textarea with a
                                   character count, and the state buttons come inline. The
                                   height is declared (3 rows) rather than auto so Virtualize
                                   can still compute offsets. *@
                                <div class="trow trow--editing @RowStateIcon.RowClass(DesignState(u)) is-selected">
                                    <span class="trow__edge"></span>
                                    <span class="trow__key" title="@u.Short">@GridKey(u.Short)</span>
                                    <span class="trow__src">@u.Source</span>
                                    <span class="trow__edit">
                                        <textarea class="trow__ta" value="@u.Target"
                                                  placeholder="Type the translation..."
                                                  @oninput="e => OnGridTargetInput(u, e)"></textarea>
                                        @* No character count: XLIFF carries a maxwidth per unit and
                                           BC writes 0 (no limit) for every one of them, so the number
                                           had nothing to be measured against. *@
                                        <span class="trow__editmeta">
                                            <span class="kbd-hint"><span class="kbd-hint__label">Save and go to the next</span><span class="kbd">Alt</span><span class="kbd">&#8629;</span></span>
                                        </span>
                                    </span>
                                    <span class="trow__st">
                                        <span class="tr-statepick tr-statepick--row" role="group" aria-label="State">
                                            @foreach (var opt in StatePickOptions)
                                            {
                                                <button type="button" class="tr-statebtn tr-statebtn--icon @(u.State == opt.Token ? "is-active" : "") @RowStateIcon.RowClass(DesignStateOf(opt.Token))"
                                                        title="@opt.Label" aria-label="@opt.Label"
                                                        @onclick="() => SetState(opt.Token)">
                                                    <RowStateIcon State="@DesignStateOf(opt.Token)" />
                                                </button>
                                            }
                                        </span>
                                    </span>
                                    <span class="trow__kind">@u.Kind</span>
                                    <span class="trow__acts">
                                        @* stopPropagation, or clicking Clear also selects the row and
                                           opens the editor over the thing you just emptied. *@
                                        <button type="button" class="btn btn--icon btn--sm"
                                                title="Clear this translation"
                                                aria-label="Clear this translation"
                                                disabled="@(u.Target.Length == 0)"
                                                @onclick="() => ClearTarget(u)"
                                                @onclick:stopPropagation="true">
                                            <Icon Name="rotate-ccw" Width="13" Height="13" />
                                        </button>
                                    </span>
                                </div>
                            }
                            else
                            {
                                @* A .trow is a grid, so it cannot be a <button> without
                                   losing its column tracks. The list view's rows are real
                                   buttons; these get the same keyboard contract by hand. *@
                                <div class="trow @RowStateIcon.RowClass(DesignState(u))" role="button" tabindex="0"
                                     @onclick="() => SelectAsync(u.Id)"
                                     @onkeydown="e => OnActivateKey(e, () => _ = SelectAsync(u.Id))">
                                    <span class="trow__edge"></span>
                                    <span class="trow__key" title="@u.Short">@GridKey(u.Short)</span>
                                    <span class="trow__src">@u.Source</span>
                                    @if (string.IsNullOrEmpty(u.Target))
                                    {
                                        <span class="trow__tgt trow__tgt--empty">Needs translation</span>
                                    }
                                    else
                                    {
                                        <span class="trow__tgt">@u.Target</span>
                                    }
                                    <span class="trow__st"><RowStateIcon State="@DesignState(u)" /></span>
                                    <span class="trow__kind">@u.Kind</span>
                                    <span class="trow__acts">
                                        @* stopPropagation, or clicking Clear also selects the row and
                                           opens the editor over the thing you just emptied. *@
                                        <button type="button" class="btn btn--icon btn--sm"
                                                title="Clear this translation"
                                                aria-label="Clear this translation"
                                                disabled="@(u.Target.Length == 0)"
                                                @onclick="() => ClearTarget(u)"
                                                @onclick:stopPropagation="true">
                                            <Icon Name="rotate-ccw" Width="13" Height="13" />
                                        </button>
                                    </span>
                                </div>
                            }
                        </Virtualize>
                    </div>
                </div>
            }
        </div>

        @* Status bar: where the file stands, the keys that do the work, and the
           progress ribbon. *@
        <div class="pw__foot">
            <span>@_units.Count units</span>
            @if (hidden > 0)
            {
                <span>@hidden hidden by filter</span>
            }
            @if (_unsaved)
            {
                <span class="tr-foot__unsaved">@DirtyCount() unsaved</span>
            }
            @* Both say where the file came from, so the repository replaces the
               app name rather than crowding in beside it - this row runs out of
               width before it runs out of things worth saying. *@
            @if (_repoSource is not null)
            {
                <span class="tr-foot__repo" title="Saves to @_repoSource.Path on @_repoSource.Repository.FullName">
                    <Icon Name="folder-git-2" Width="11" Height="11" />@_repoSource.Repository.Name
                </span>
            }
            else if (_fromGeneratedFile && _openedFileName is not null)
            {
                @* The head shows the language file's name; this keeps the name
                   of the file actually opened in view beside it. *@
                <span class="tr-foot__orig">started from @_openedFileName</span>
            }
            else if (!string.IsNullOrEmpty(_original))
            {
                <span class="tr-foot__orig">from @_original</span>
            }
            <span class="pw__spacer"></span>
            <span class="kbd-hint"><span class="kbd-hint__label">Save and go to the next</span><span class="kbd">Alt</span><span class="kbd">&#8629;</span></span>
            <span class="kbd-hint"><span class="kbd-hint__label">Previous / next unit</span><span class="kbd">Alt</span><span class="kbd">&#8593;</span><span class="kbd">&#8595;</span></span>
            @if (_view == "list")
            {
                @* Alt+1..9 fills from the suggestion list, which only the list
                   view renders. Advertising it in the grid was a lie. *@
                <span class="kbd-hint"><span class="kbd-hint__label">Apply suggestion</span><span class="kbd">Alt</span> <span>+</span> <span class="kbd">1</span>&#8211;<span class="kbd">9</span></span>
            }
            @if (!_fromGeneratedFile)
            {
                <span class="kbd-hint"><span class="kbd-hint__label">@(_canSaveInPlace ? "Save" : "Export")</span><span class="kbd">Ctrl</span><span class="kbd">S</span></span>
            }

            <div class="tprog" role="img" aria-label="@c.Pct% translated: @c.Final final, @c.Translated translated, @c.Review needing review, @c.Todo untranslated">
                <div class="tprog__bar" aria-hidden="true">
                    <span class="tprog__seg tprog__seg--final" style="width:@Pct(c.Final, c.Total)"></span>
                    <span class="tprog__seg tprog__seg--trans" style="width:@Pct(c.Translated, c.Total)"></span>
                    <span class="tprog__seg tprog__seg--fuzzy" style="width:@Pct(c.Review, c.Total)"></span>
                    <span class="tprog__seg tprog__seg--untrans" style="width:@Pct(c.Todo, c.Total)"></span>
                </div>
                @* The one number anyone wants out of a progress bar. It used to
                   exist only on the aria-label. *@
                <span class="tprog__n" aria-hidden="true">@c.Pct% translated</span>
            </div>
        </div>

        @* Off-circuit export: JS fills these from IndexedDB then submits. The
           original XML never travels over the Blazor connection. Kept inside
           .pw so the shell's `:has(.pw) > *` height rule only ever sees one
           in-flow child. *@
        <form id="tr-export-form" method="post" action="/api/translator/export" enctype="multipart/form-data" class="tr-hiddenform">
            <AntiforgeryToken />
            <input type="hidden" name="FileName" id="tr-export-filename" />
            <input type="hidden" name="OriginalXml" id="tr-export-original" />
            <input type="hidden" name="Edits" id="tr-export-edits" />
            <input type="hidden" name="Learn" id="tr-export-learn" />
            <input type="hidden" name="TargetLanguage" id="tr-export-target-language" />
        </form>
    </div>
}

@* Labels are passed per call - the count is in the title. *@
<ConfirmDialog @ref="_preTranslateConfirm" />

@* Both repository dialogs pass their words per call, because both have to name
   the repository, the branch and the file they are about. *@
<ConfirmDialog @ref="_repoSaveConfirm" />
@* The way out of a conflict that keeps the translator's work is the one the
   body sentence points at, so the button says what it does rather than
   "Cancel". *@
<ConfirmDialog @ref="_repoConflictConfirm" CancelLabel="Keep my edits" />

<ConfirmDialog @ref="_leaveConfirm"
               Title="Leave with unsaved changes?"
               Message="You have unsaved edits. Leaving now means you'd have to re-open the file and pick up where you left off (your work is kept on this device until you close the file)."
               ConfirmLabel="Leave anyway"
               CancelLabel="Stay on page"
               ConfirmIcon="log-out" />

<ToastHost @ref="_toast" />

@code {
    // ── XLIFF state vocabulary (the four buckets the UI works in) ──────────
    private const string StTodo = "needs-translation";
    private const string StReview = "needs-review-translation";
    private const string StTranslated = "translated";
    private const string StFinal = "final";

    // All four states, spelled the way RowStateIcon spells them, so the picker
    // doubles as the legend for the glyphs in the rows. "Needs review" used to
    // be missing: a unit could arrive in that state and be moved out of it, but
    // never into it, and no control on the page ever named it.
    private static readonly (string Token, string Label)[] StatePickOptions =
    {
        (StTodo, "Untranslated"),
        (StReview, "Needs review"),
        (StTranslated, "Translated"),
        (StFinal, "Final"),
    };

    private sealed record Lang(string Code, string Name);

    // Common Business Central target languages (BCP-47).
    private static readonly Lang[] Languages =
    {
        new("da-DK", "Dansk"), new("de-DE", "Deutsch"), new("sv-SE", "Svenska"),
        new("nb-NO", "Norsk (bokmål)"), new("nl-NL", "Nederlands"), new("fr-FR", "Français"),
        new("fr-CA", "Français (Canada)"), new("es-ES", "Español"), new("fi-FI", "Suomi"),
        new("is-IS", "Íslenska"), new("it-IT", "Italiano"), new("en-GB", "English (UK)"),
        new("en-US", "English (US)"),
    };

    // Internal rather than private only so MarkCommitted can be tested.
    internal sealed class UnitVm
    {
        public required string Id { get; init; }
        public required string Short { get; init; }
        public required string Kind { get; init; }
        public required string Source { get; init; }
        public string? Note { get; init; }
        public string Target { get; set; } = string.Empty;
        public string State { get; set; } = StTodo;
        // True once the user has touched this unit - only dirty units are
        // written back on export, keeping every other byte identical.
        public bool Dirty { get; set; }
    }

    internal sealed class EditDto
    {
        [JsonPropertyName("t")] public string T { get; set; } = string.Empty;
        [JsonPropertyName("s")] public string? S { get; set; }
    }

    internal sealed class SessionPeek
    {
        /// <summary>The id of the session the prompt offers; Continue and Discard name it (#1609).</summary>
        [JsonPropertyName("openId")] public string? OpenId { get; set; }
        [JsonPropertyName("fileName")] public string FileName { get; set; } = string.Empty;
        [JsonPropertyName("savedAt")] public long SavedAt { get; set; }
    }

    internal sealed class SessionMeta
    {
        /// <summary>The fresh id the restoring tab now holds the session under (#1595, #1609).</summary>
        [JsonPropertyName("openId")] public string? OpenId { get; set; }
        [JsonPropertyName("fileName")] public string FileName { get; set; } = string.Empty;
        [JsonPropertyName("sourceLang")] public string? SourceLang { get; set; }
        [JsonPropertyName("targetLang")] public string? TargetLang { get; set; }
        [JsonPropertyName("edits")] public Dictionary<string, EditDto> Edits { get; set; } = new();
        [JsonPropertyName("learned")] public LearnedDto? Learned { get; set; }
        /// <summary>Where a file opened from a repository came from; null for any other file (#1540).</summary>
        [JsonPropertyName("repo")] public RepositoryOriginDto? Repo { get; set; }
    }

    /// <summary>The repository and path a session's file was opened from, as the browser keeps it.</summary>
    internal sealed class RepositoryOriginDto
    {
        [JsonPropertyName("repository")] public string Repository { get; set; } = string.Empty;
        [JsonPropertyName("path")] public string Path { get; set; } = string.Empty;
    }

    /// <summary>
    /// Whether a restored session's file was opened from a repository. A restore
    /// does not reconnect to the repository, so Save to repository is not
    /// offered, but the export still must not teach the translation memory
    /// pairs with no repository attached (#1540). A session saved before the
    /// origin was recorded has none and restores as a file from elsewhere.
    /// </summary>
    internal static bool RestoredFromRepository(SessionMeta meta) =>
        !string.IsNullOrEmpty(meta.Repo?.Repository);

    /// <summary>What each unit last taught the translation memory, per scope (#1343).</summary>
    internal sealed class LearnedDto
    {
        [JsonPropertyName("local")] public Dictionary<string, string> Local { get; set; } = new();
        [JsonPropertyName("repository")] public Dictionary<string, string> Repository { get; set; } = new();
    }

    private readonly int _maxFileMb = 100;
    private long MaxFileBytes => (long)_maxFileMb * 1024 * 1024;

    private bool _hasFile;
    private bool _busy;
    private string? _parseError;
    private string? _restoreName;
    /// <summary>Which stored session the restore prompt offers; one per open, so it has to be named (#1609).</summary>
    private string? _restoreOpenId;
    private string _restoreAge = "";

    // A saved session older than this is dropped on re-open rather than
    // offered - coming back after a weekend to a silently-restored file is
    // more surprising than helpful.
    private static readonly TimeSpan MaxSessionAge = TimeSpan.FromDays(7);

    private string _fileName = "";
    private string _sourceLang = "en-US";
    private string _targetLang = "da-DK";
    private string? _original;
    private bool _editingName;

    private List<UnitVm> _units = new();

    // The target each unit last taught the translation memory, by unit id, for
    // this file. Saving in place and exporting leave units marked as edited, so
    // without this every save re-taught - and added a hit to - every unit
    // touched since the file was opened (#1343). Kept per scope: an export
    // teaches the organisation-wide memory, a repository save teaches it under
    // that repository (#1324), and one must not stand in for the other. Kept in
    // the browser's session record with the edits, so a reload does not start
    // over.
    private readonly Dictionary<string, string> _learnedLocally = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _learnedToRepository = new(StringComparer.Ordinal);
    private List<UnitVm> _filtered = new();
    private string _filter = "todo";
    private string _kind = "All kinds";
    private string _search = "";
    private string _view = "list";

    private string? _selId;
    private UnitVm? _sel;
    private List<TranslationSuggestion> _suggestions = new();
    private bool _suggLoading;
    private bool _focusTargetPending;

    // #300/#302: the per-source suggestion cache, the machine-translation cache,
    // and the DbContext-serialising gate now live in TranslationSuggestionCoordinator
    // (injected as Coordinator). The component still owns the render-state pieces:
    // which unit to prefetch, the spinners, and when an auto MT fires.

    // Per-tenant machine-translation trigger, loaded once on init.
    private MtTrigger _mtTrigger = MtTrigger.Off;
    private bool _mtLoading;

    private ToastHost? _toast;
    private CancellationTokenSource? _persistCts;

    private IJSObjectReference? _module;
    private DotNetObjectReference<Translator>? _selfRef;
    private bool _dropZoneActive;
    private bool _pickerActive;
    private bool _splitActive;
    private ConfirmDialog? _preTranslateConfirm;

    // True when the browser supports the File System Access API, so files can be
    // opened via the picker/drag-drop and edits saved straight back to disk.
    private bool _fsAccess;
    // True when the current file was opened with a writable handle (picker or a
    // drop on a supported browser), so Save writes in place instead of
    // downloading. Reset whenever a file loads without one.
    private bool _canSaveInPlace;
    // The id the browser stamped on its session record when this tab opened
    // the file. The browser keeps one record for the whole site, so another
    // tab's open replaces it; every call that reads or writes the record passes
    // this, and the browser refuses when the record is another open's (#1595).
    private string? _openId;
    // True when a file opened from disk holds no translation yet - the
    // compiler's generated file. It is never saved in place and exports as a
    // language file named for _targetLang. See AdoptGeneratedFileAsync.
    private bool _fromGeneratedFile;
    // The generated file's own name, shown beside the language file's name so
    // the two are never confused, and whether its explanation was dismissed.
    private string? _openedFileName;
    private bool _generatedNoteDismissed;

    // True when there are edits that haven't been exported. Drives both the
    // in-app navigation guard (the modal) and the browser-level beforeunload
    // prompt. The work is also mirrored to IndexedDB, so it survives a refresh
    // - but we still warn so the user doesn't lose their place by accident.
    private bool _unsaved;
    private ConfirmDialog? _leaveConfirm;
    private IDisposable? _navRegistration;

    // ── Open from / save to a repository (issue #625) ─────────────────────
    // The repository chosen on the first-run panel, and the translation files
    // found in it. Both are about picking a file; neither survives opening one.
    private GitHubRepositorySummary? _repo;
    private IReadOnlyList<RepositoryTranslationFile> _repoList = [];
    private bool _repoListLoading;
    private string? _repoListError;

    // Where the open file came from and goes back to, when it came from a
    // repository - carrying the blob sha the editor's content is based on. Null
    // for an uploaded file, and that null is what decides which Save button the
    // toolbar shows.
    private RepositoryTranslationSource? _repoSource;

    // A session restored from the browser whose file was opened from a
    // repository. The restore does not bring _repoSource back, so this is what
    // keeps its export from teaching the memory unattributed pairs (#1540).
    private bool _restoredFromRepository;

    // The file exactly as the repository has it. Held for the life of the
    // session because the byte-faithful merge runs against it: the download
    // path keeps its copy in the browser, but a save to GitHub happens
    // server-side and must start from what was actually opened. The Contents
    // API only inlines files up to 1 MB, so this is bounded.
    private string? _repoOriginalXml;

    // The generated source file (.g.xlf) this translation was started from,
    // when it was. Its translations belong in a language file beside it, never
    // written back over the source - so the save path is derived from the
    // target language, and re-derived from this whenever that language changes.
    private string? _repoGeneratedPath;

    private GitHubPullRequest? _pullRequest;
    private bool _repoSaving;
    private bool _repoSaveExplained;
    private ConfirmDialog? _repoSaveConfirm;
    private ConfirmDialog? _repoConflictConfirm;

    protected override void OnInitialized()
    {
        // Intercept SPA navigation (sidebar links, browser back to an in-app
        // URL) so we can confirm before the user leaves with unexported edits.
        // Full reloads / tab close go through the beforeunload guard in the JS
        // companion. Mirrors Components/Pages/Admin/AdminTemplateEdit.razor.
        _navRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    protected override async Task OnInitializedAsync()
    {
        // Load the per-tenant machine-translation trigger once. This also warms
        // the cached OrganizationConfig, so later provider resolves never hit the
        // DB concurrently with a memory prefetch. Off (the default) renders no MT
        // affordance and makes no external calls.
        try
        {
            _mtTrigger = await Mt.GetTriggerAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Failed to load machine-translation settings; treating as off.");
            _mtTrigger = MtTrigger.Off;
        }
    }

    private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (!_unsaved || _leaveConfirm is null) return;
        var leave = await _leaveConfirm.OpenAsync();
        if (!leave) context.PreventNavigation();
    }

    /// <summary>
    /// Flips the unsaved-changes flag and keeps the browser-level beforeunload
    /// guard in sync. Only touches JS on a transition so per-keystroke edits
    /// don't spam the circuit.
    /// </summary>
    private void SetUnsaved(bool value)
    {
        if (_unsaved == value) return;
        _unsaved = value;
        if (_module is not null)
        {
            // Fire-and-forget, but through a helper that observes the task so a
            // disconnect mid-call doesn't surface as an unobserved exception.
            _ = SetBeforeUnloadAsync(value);
        }
    }

    private async Task SetBeforeUnloadAsync(bool value)
    {
        try { await _module!.InvokeVoidAsync("setBeforeUnload", value); }
        catch { /* circuit gone — nothing to keep in sync */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // #304: focus the target box once the detail rail for the new
            // selection has rendered. No-op in grid view (no .tr-tgtarea).
            if (_focusTargetPending && _module is not null)
            {
                _focusTargetPending = false;
                try { await _module.InvokeVoidAsync("focusTarget"); } catch { }
            }
            await SyncDropZoneAsync();
            return;
        }
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Translator.razor.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initKeys", _selfRef);
            _fsAccess = await _module.InvokeAsync<bool>("supportsFsAccess");
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            // The circuit dropped during first render — nothing to initialise.
            return;
        }
        if (!_hasFile)
        {
            try
            {
                // A component that starts with no file holds no open, but the
                // module may still hold the one a previous component in this
                // tab had - after a resumed connection, say. Let go of it first,
                // or that session would be hidden from this very tab (#1609).
                await _module.InvokeVoidAsync("release");
                // The newest session no other open tab is still working on.
                // Sessions past the age limit are never offered - the browser
                // deletes them here instead of surprising the user with a
                // week-old file.
                var session = await _module.InvokeAsync<SessionPeek?>("peek", (long)MaxSessionAge.TotalMilliseconds);
                if (session is not null && !string.IsNullOrEmpty(session.FileName) && !string.IsNullOrEmpty(session.OpenId))
                {
                    var age = DateTimeOffset.UtcNow - DateTimeOffset.FromUnixTimeMilliseconds(session.SavedAt);
                    _restoreName = session.FileName;
                    _restoreOpenId = session.OpenId;
                    _restoreAge = HumanizeAge(age < TimeSpan.Zero ? TimeSpan.Zero : age);
                    StateHasChanged();
                }
            }
            catch { /* storage unavailable */ }
        }
        await SyncDropZoneAsync();
    }

    // Keep the drag-and-drop handlers wired only while the no-file uploader is
    // on screen. Tearing down on file-load removes the window-level guard so
    // drops elsewhere behave normally once the user is translating.
    private async Task SyncDropZoneAsync()
    {
        if (_module is null) return;
        if (!_hasFile && !_dropZoneActive)
        {
            _dropZoneActive = true;
            try { await _module.InvokeVoidAsync("initDropZone", ".tdrop", ".tdrop__input"); } catch { }
        }
        else if (_hasFile && _dropZoneActive)
        {
            _dropZoneActive = false;
            try { await _module.InvokeVoidAsync("teardownDropZone"); } catch { }
        }

        // Wire the picker button's click in JS (in-gesture). It only exists once
        // _fsAccess is known, which is a render later than the drop zone, so this
        // is tracked separately.
        if (_fsAccess && !_hasFile && !_pickerActive)
        {
            _pickerActive = true;
            try { await _module.InvokeVoidAsync("initPicker", ".tdrop__btn"); } catch { }
        }
        else if ((_hasFile || !_fsAccess) && _pickerActive)
        {
            _pickerActive = false;
            try { await _module.InvokeVoidAsync("teardownPicker"); } catch { }
        }

        // The rail resizer, on the same pass. The handle only exists in the list
        // view of a loaded file, and it moves when the view toggles, so the
        // listeners are re-attached rather than kept.
        var wantSplit = _hasFile && _view == "list" && _filtered.Count > 0;
        if (wantSplit && !_splitActive)
        {
            _splitActive = true;
            try { await _module.InvokeVoidAsync("initSplit"); } catch { }
        }
        else if (!wantSplit && _splitActive)
        {
            _splitActive = false;
            try { await _module.InvokeVoidAsync("teardownSplit"); } catch { }
        }
    }

    // ── Upload ────────────────────────────────────────────────────────────
    private async Task OnUploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _busy = true;
        _parseError = null;
        try
        {
            byte[] bytes;
            await using (var stream = file.OpenReadStream(MaxFileBytes))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                bytes = ms.ToArray();
            }

            XliffDocument parsed;
            try
            {
                using var ps = new MemoryStream(bytes);
                parsed = AlXliffParser.Parse(ps);
            }
            catch (Exception ex) when (ex is InvalidDataException or System.Xml.XmlException)
            {
                _parseError = $"Could not read \"{file.Name}\" as XLIFF v1.2: {ex.Message}";
                return;
            }

            LoadParsed(file.Name, parsed);
            await AdoptGeneratedFileAsync(parsed, persist: false, openedFileName: file.Name);

            // Hand the verbatim original to IndexedDB via a stream (off the
            // 32 KB interop arg path), so a refresh can restore it.
            if (_module is not null)
            {
                using var dotNetStream = new DotNetStreamReference(new MemoryStream(bytes), leaveOpen: false);
                _openId = await _module.InvokeAsync<string?>("putBaseStream", _fileName, _sourceLang, _targetLang, dotNetStream);
            }
            await SelectAsync(_filtered.FirstOrDefault()?.Id ?? _units.FirstOrDefault()?.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Open in place (File System Access API) ────────────────────────────────
    // Both open paths are JS-initiated so the File System Access API runs inside
    // the user gesture: the picker click (initPicker) and a drag-drop on a
    // supported browser both stash a writable handle in the JS session record,
    // then call back here. We then load the file the same way a restore does —
    // read the verbatim original over a stream and parse it — and light up Save.
    [JSInvokable]
    public async Task OpenFromHandleAsync(string fileName, string openId)
    {
        if (_module is null) return;
        _busy = true;
        _parseError = null;
        StateHasChanged();
        try
        {
            await LoadFromStoreAsync(fileName, openId);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // Reads the verbatim original the JS side just stored (with its handle) and
    // parses it into the editable unit list. Shared by the picker and drop paths.
    private async Task LoadFromStoreAsync(string fileName, string openId)
    {
        if (_module is null) return;
        var streamRef = await _module.InvokeAsync<IJSStreamReference>("loadOriginalStream", openId);
        string xml;
        await using (var s = await streamRef.OpenReadStreamAsync(MaxFileBytes))
        using (var reader = new StreamReader(s, Encoding.UTF8))
        {
            xml = await reader.ReadToEndAsync();
        }
        if (string.IsNullOrEmpty(xml)) { _parseError = $"Could not read \"{fileName}\"."; return; }

        XliffDocument parsed;
        try
        {
            using var ps = new MemoryStream(Encoding.UTF8.GetBytes(xml));
            parsed = AlXliffParser.Parse(ps);
        }
        catch (Exception ex) when (ex is InvalidDataException or System.Xml.XmlException)
        {
            _parseError = $"Could not read \"{fileName}\" as XLIFF v1.2: {ex.Message}";
            return;
        }

        LoadParsed(fileName, parsed);
        _openId = openId;
        _canSaveInPlace = true; // opened with a writable handle
        await AdoptGeneratedFileAsync(parsed, persist: true, openedFileName: fileName);
        await SelectAsync(_filtered.FirstOrDefault()?.Id ?? _units.FirstOrDefault()?.Id);
    }

    private void LoadParsed(string fileName, XliffDocument parsed)
    {
        _fileName = fileName;
        _sourceLang = string.IsNullOrEmpty(parsed.SourceLanguage) ? "en-US" : parsed.SourceLanguage!;
        _targetLang = string.IsNullOrEmpty(parsed.TargetLanguage) ? _targetLang : parsed.TargetLanguage;
        _original = parsed.OriginalName;
        _units = parsed.Units.Select(ToVm).ToList();
        _learnedLocally.Clear();
        _learnedToRepository.Clear();
        _hasFile = true;
        // Default to download-only; the picker/drop/restore paths flip this on
        // when they carry a writable handle, and the repository path sets its
        // own source afterwards. Clearing here means an upload can never
        // inherit the last file's repository and save into it.
        _canSaveInPlace = false;
        _fromGeneratedFile = false;
        // Every open path stores the file and sets its own id afterwards.
        _openId = null;
        ForgetRepositorySource();
        ForgetRestore();
        Coordinator.ClearCaches();
        _filter = "todo";
        _kind = "All kinds";
        _search = "";
        SetUnsaved(false);
        RecomputeFiltered();
    }

    /// <summary>
    /// For a file opened from disk: when it holds no translation yet - the
    /// compiler's generated <c>.g.xlf</c> - turn off saving in place and name
    /// the export as the language file it should become (#1325). The build
    /// rewrites the generated file, so a translation saved into it would be
    /// lost on the next build, and it would still say it is in the source
    /// language. The repository path already saves such a file beside it
    /// (<see cref="DerivedSource"/>); this is the same rule for a local file.
    /// </summary>
    /// <param name="persist">
    /// True when the browser's session record was written before this ran, so
    /// the export it sends later carries the language and name chosen here.
    /// The upload path writes the record afterwards and passes false.
    /// </param>
    /// <param name="openedFileName">
    /// The name the file has on disk, for the notice and the footer. Null on a
    /// restore, whose session only remembers the language file's name.
    /// </param>
    private async Task AdoptGeneratedFileAsync(XliffDocument parsed, bool persist, string? openedFileName)
    {
        _fromGeneratedFile = TranslationFileRules.IsUntranslatedSource(parsed);
        if (!_fromGeneratedFile) return;

        _openedFileName = openedFileName;
        _generatedNoteDismissed = false;
        _canSaveInPlace = false;
        // Same as the repository path: "translate English into English" is
        // what the file says, not what anybody wants.
        if (string.Equals(_targetLang, _sourceLang, StringComparison.OrdinalIgnoreCase))
        {
            _targetLang = Languages.First(l => !string.Equals(l.Code, _sourceLang, StringComparison.OrdinalIgnoreCase)).Code;
        }
        _fileName = TranslationFileRules.LanguageFileName(_fileName, _targetLang);
        if (persist && _module is not null) await _module.InvokeVoidAsync("putMeta", _openId, _fileName, _targetLang);
    }

    private static UnitVm ToVm(XliffTransUnit u)
    {
        var kind = DisplayKind(AlXliffParser.BucketKind(u.Hint));
        return new UnitVm
        {
            Id = u.Id,
            Short = u.Id.Replace(" - ", " · "),
            Kind = kind,
            Source = u.SourceText,
            Note = u.DeveloperNote,
            Target = u.TargetText,
            State = NormaliseState(u.TargetState, u.TargetText),
        };
    }

    // ── Restore / close ───────────────────────────────────────────────────
    private async Task RestoreAsync()
    {
        if (_module is null) return;
        _busy = true;
        try
        {
            // The browser moves the session to a fresh id this tab then holds,
            // and answers null when another tab took it over meanwhile.
            var meta = await _module.InvokeAsync<SessionMeta?>("loadMeta", _restoreOpenId);
            if (meta is null)
            {
                ForgetRestore();
                Flash(OpenInAnotherTab, ToastKind.Warn);
                return;
            }
            try
            {
                await LoadRestoredAsync(meta);
            }
            catch
            {
                // The browser moved the session to an id this tab now holds; let
                // go of it so the prompt can offer it again (#1609).
                try { await _module.InvokeVoidAsync("release"); } catch { }
                _openId = null;
                throw;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private const string OpenInAnotherTab = "That file is open in another tab now, so its edits were kept.";

    /// <summary>Reads and opens a session Continue has just moved to <paramref name="meta"/>'s fresh id.</summary>
    private async Task LoadRestoredAsync(SessionMeta meta)
    {
        if (_module is null) return;
        var streamRef = await _module.InvokeAsync<IJSStreamReference>("loadOriginalStream", meta.OpenId);
        string xml;
        await using (var s = await streamRef.OpenReadStreamAsync(MaxFileBytes))
        using (var reader = new StreamReader(s, Encoding.UTF8))
        {
            xml = await reader.ReadToEndAsync();
        }
        if (string.IsNullOrEmpty(xml))
        {
            await _module.InvokeAsync<bool>("clear", meta.OpenId);
            ForgetRestore();
            return;
        }

        XliffDocument parsed;
        try
        {
            using var ps = new MemoryStream(Encoding.UTF8.GetBytes(xml));
            parsed = AlXliffParser.Parse(ps);
        }
        catch (Exception ex) when (ex is InvalidDataException or System.Xml.XmlException)
        {
            _parseError = $"Could not restore the saved session: {ex.Message}";
            // It would fail the same way next time, so it is not offered again.
            await _module.InvokeAsync<bool>("clear", meta.OpenId);
            ForgetRestore();
            return;
        }

        LoadParsed(meta.FileName, parsed);
        _openId = meta.OpenId;
        _restoredFromRepository = RestoredFromRepository(meta);
        if (!string.IsNullOrEmpty(meta.TargetLang)) _targetLang = meta.TargetLang!;

        // If the session was opened with a writable handle, it survives in
        // IndexedDB — re-enable in-place Save. Write permission is re-checked
        // (and re-prompted) on the Save gesture itself, not here. Never for
        // the generated file, which only ever exports (#1325).
        _canSaveInPlace = await _module.InvokeAsync<bool>("hasHandle", _openId);
        await AdoptGeneratedFileAsync(parsed, persist: true, openedFileName: null);

        // Re-apply the saved edit overlay.
        var byId = _units.ToDictionary(u => u.Id, StringComparer.Ordinal);
        foreach (var (id, ed) in meta.Edits)
        {
            if (!byId.TryGetValue(id, out var vm)) continue;
            vm.Target = ed.T;
            if (!string.IsNullOrEmpty(ed.S)) vm.State = ed.S!;
            vm.Dirty = true;
        }
        // What the memory already learned from this session, so the next
        // save does not teach it the same units again (#1343).
        if (meta.Learned is { } learnedBefore)
        {
            foreach (var (id, target) in learnedBefore.Local) _learnedLocally[id] = target;
            foreach (var (id, target) in learnedBefore.Repository) _learnedToRepository[id] = target;
        }
        // A restored session with edits is unsaved until it's exported.
        if (meta.Edits.Count > 0) SetUnsaved(true);
        RecomputeFiltered();
        await SelectAsync(_filtered.FirstOrDefault()?.Id ?? _units.FirstOrDefault()?.Id);
    }

    private async Task DiscardAsync()
    {
        // Only the session the prompt named, and the browser keeps it when a
        // tab has picked it up since the prompt appeared (#1609).
        var discarded = _module is null || await _module.InvokeAsync<bool>("clear", _restoreOpenId);
        ForgetRestore();
        if (!discarded) Flash(OpenInAnotherTab, ToastKind.Warn);
    }

    private void ForgetRestore()
    {
        _restoreName = null;
        _restoreOpenId = null;
    }

    private async Task CloseFileAsync()
    {
        // Only this tab's own session record (#1595, #1609).
        if (_module is not null) await _module.InvokeVoidAsync("clear", _openId);
        _openId = null;
        SetUnsaved(false);
        _canSaveInPlace = false;
        _fromGeneratedFile = false;
        _hasFile = false;
        _units = new();
        _learnedLocally.Clear();
        _learnedToRepository.Clear();
        _filtered = new();
        _sel = null;
        _selId = null;
        _suggestions = new();
        Coordinator.ClearCaches();
        _parseError = null;
        ForgetRepositorySource();
        _repo = null;
        _repoList = [];
        _repoListError = null;
    }

    /// <summary>
    /// Drops everything that ties the open file to a repository. Called
    /// wherever a file is replaced or closed, so the Save button can never
    /// point at the repository a previous file came from.
    /// </summary>
    private void ForgetRepositorySource()
    {
        _repoSource = null;
        _restoredFromRepository = false;
        _repoOriginalXml = null;
        _repoGeneratedPath = null;
        _pullRequest = null;
        _repoSaveExplained = false;
    }

    // ── Open from / save to a repository (issue #625) ─────────────────────
    // Both halves route through GitHubTranslationService, which is where the
    // access gate and the never-the-default-branch rule live. This component
    // only decides what to show.

    private async Task OnRepositoryChangedAsync(GitHubRepositorySummary? repo)
    {
        _repo = repo;
        _repoList = [];
        _repoListError = null;
        if (repo is null) return;
        await ReloadRepositoryFilesAsync();
    }

    private async Task ReloadRepositoryFilesAsync()
    {
        if (_repo is null) return;
        _repoListLoading = true;
        _repoListError = null;
        try
        {
            _repoList = await RepoFiles.ListFilesAsync(_repo.FullName);
        }
        catch (PlanValidationException ex)
        {
            _repoListError = FirstReason(ex);
        }
        catch (Exception ex) when (ex is GitHubApiException or GitHubAppNotConfiguredException
            or HttpRequestException or TaskCanceledException)
        {
            Log.LogWarning(ex, "Could not list the translation files in {RepoFullName}.", _repo.FullName);
            _repoListError = "The workbench could not reach GitHub just now, so it cannot list the files in "
                + $"{_repo.FullName}.";
        }
        finally
        {
            _repoListLoading = false;
        }
    }

    /// <summary>
    /// Loads a file out of the repository. Everything after the fetch is the
    /// upload path: the same parse, the same verbatim original handed to the
    /// browser's store, the same first selection - so a repository file behaves
    /// exactly like one that was dragged in, with a place to save it back to.
    /// </summary>
    private async Task OpenFromRepositoryAsync(RepositoryTranslationFile file)
    {
        if (_repo is null) return;
        var repo = _repo;
        _busy = true;
        _parseError = null;
        try
        {
            // While the language's pull request is open its branch is ahead of
            // the default branch, and a save is compared against the file there;
            // opening the default branch's copy would make every save a conflict
            // until the pull request is merged (#1244).
            var content = (!file.IsSource && !string.IsNullOrEmpty(file.Language)
                    ? await RepoFiles.OpenOnTranslationBranchAsync(repo.FullName, file.Path, file.Language)
                    : null)
                ?? await RepoFiles.OpenAsync(repo.FullName, file.Path);
            if (content is null)
            {
                _parseError = $"\"{file.FileName}\" is not in {repo.FullName} any more. "
                    + "Choose the repository again to see what is there now.";
                return;
            }

            var bytes = Encoding.UTF8.GetBytes(content.Text);
            XliffDocument parsed;
            try
            {
                using var ps = new MemoryStream(bytes);
                parsed = AlXliffParser.Parse(ps);
            }
            catch (Exception ex) when (ex is InvalidDataException or System.Xml.XmlException)
            {
                _parseError = $"Could not read \"{file.FileName}\" as XLIFF v1.2: {ex.Message}";
                return;
            }

            LoadParsed(file.FileName, parsed);

            // A generated source file says its target language is its source
            // language, which is its way of saying nothing is translated yet.
            // Taking that as the language to translate into would offer to
            // translate English into English.
            if (file.IsSource && string.Equals(_targetLang, _sourceLang, StringComparison.OrdinalIgnoreCase))
            {
                _targetLang = Languages.First(l => !string.Equals(l.Code, _sourceLang, StringComparison.OrdinalIgnoreCase)).Code;
            }

            _repoOriginalXml = content.Text;
            _repoGeneratedPath = file.IsSource ? file.Path : null;
            _repoSource = file.IsSource
                ? DerivedSource(repo, file.Path)
                : new RepositoryTranslationSource(repo, file.Path, file.FileName, content.Sha);
            if (file.IsSource) _fileName = _repoSource.FileName;

            // The browser keeps the verbatim original too, so "Export a copy"
            // and a refresh work on a repository file exactly as they do on an
            // uploaded one - except that the memory learns nothing from the
            // export, before or after a refresh (#1540).
            if (_module is not null)
            {
                using var dotNetStream = new DotNetStreamReference(new MemoryStream(bytes), leaveOpen: false);
                _openId = await _module.InvokeAsync<string?>("putBaseStream", _fileName, _sourceLang, _targetLang, dotNetStream,
                    RepositoryOrigin(_repoSource));
            }
            await SelectAsync(_filtered.FirstOrDefault()?.Id ?? _units.FirstOrDefault()?.Id);
        }
        catch (PlanValidationException ex)
        {
            _parseError = FirstReason(ex);
        }
        catch (Exception ex) when (ex is GitHubApiException or GitHubAppNotConfiguredException
            or HttpRequestException or TaskCanceledException)
        {
            Log.LogWarning(ex, "Could not open {Path} from {RepoFullName}.", file.Path, repo.FullName);
            _parseError = $"The workbench could not reach GitHub just now, so it could not open \"{file.FileName}\".";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Where a translation started from the generated source file should land:
    /// beside it, named for the language being translated into. The source file
    /// itself is never written back to - it belongs to the compiler.
    /// </summary>
    private RepositoryTranslationSource DerivedSource(GitHubRepositorySummary repo, string sourcePath)
    {
        // "App/Translations/App.g.xlf" -> "App/Translations/App.da-DK.xlf"
        var withoutSuffix = sourcePath[..^".g.xlf".Length];
        var path = $"{withoutSuffix}.{_targetLang}.xlf";
        return new RepositoryTranslationSource(repo, path, path[(path.LastIndexOf('/') + 1)..], BaseSha: null);
    }

    /// <summary>
    /// Commits the translation back and makes sure a pull request is open for
    /// it. The first save of a session says what it is about to do first: a
    /// pull request on someone else's repository is not something to discover
    /// after the fact.
    /// </summary>
    private async Task SaveToRepositoryAsync()
    {
        if (_repoSource is null || _repoOriginalXml is null || _module is null) return;

        if (!_repoSaveExplained && _repoSaveConfirm is not null)
        {
            var branch = GitHubTranslationService.BranchPrefix + _targetLang;
            var go = await _repoSaveConfirm.OpenAsync(
                $"Open a pull request on {_repoSource.Repository.FullName}?",
                $"Your translation is committed to a branch called {branch} and a pull request is opened "
                + $"from it. Nothing on {_repoSource.Repository.DefaultBranch} changes until someone reviews "
                + "and merges it. Later saves add to the same pull request.",
                "Save and open a pull request", "btn--primary", "git-branch");
            if (!go) return;
            _repoSaveExplained = true;
        }

        _busy = true;
        _repoSaving = true;
        try
        {
            // What goes into this commit, kept so that afterwards only these
            // units count as saved. The editor stays live while GitHub answers.
            var committed = BuildEdits();
            var xml = XliffTargetWriter.ApplyEdits(_repoOriginalXml, committed);
            if (_repoGeneratedPath is not null)
            {
                // Started from the compiler's generated file, which says its
                // target language is its source language. The file being
                // written is the new language file, so it has to say so.
                xml = XliffTargetWriter.SetTargetLanguage(xml, _targetLang);
            }
            var save = await RepoFiles.SaveAsync(_repoSource, _targetLang, xml, SaveSummary());

            _repoSource = save.Source;
            _pullRequest = save.PullRequest;
            // The repository now holds what the editor holds, so the next save
            // starts from this version rather than from the one first opened.
            _repoOriginalXml = xml;
            MarkCommitted(_units, committed);
            SetUnsaved(DirtyCount() > 0);

            // Rebase the browser's copy on what was just committed and drop the
            // edit overlay with it. Without this an "Export a copy" after two
            // saves would carry only the second batch of edits, because the
            // overlay is what the export merges. The record is this tab's own
            // and keeps its id (#1609); if the browser had lost it, this puts
            // it back.
            using (var saved = new DotNetStreamReference(new MemoryStream(Encoding.UTF8.GetBytes(xml)), leaveOpen: false))
            {
                _openId = await _module.InvokeAsync<string?>("putBaseStream", _fileName, _sourceLang, _targetLang, saved,
                    RepositoryOrigin(_repoSource), _openId);
            }
            // Edits typed while the save was in flight are not in that base,
            // so they go back into the overlay a refresh restores from - as does
            // what the memory has learned, which the new base record dropped.
            PersistEditsSoon();

            _toast?.Show(
                save.IsNewPullRequest
                    ? $"Saved. Pull request #{save.PullRequest.Number} is open for review."
                    : $"Saved to pull request #{save.PullRequest.Number}.",
                $"{_repoSource.Path} on {_repoSource.Repository.FullName}");

            // Best effort, and after the user already has what they asked for:
            // the same learning an export does, so a translation saved to a
            // repository still feeds the suggestions for the next file. Only
            // the units this save committed, and behind the coordinator's gate
            // - a suggestion lookup may be using the circuit's context. The
            // repository goes with the pairs: without it they would be
            // suggested to everyone in the organisation, even when only a
            // Private solution's team may see that repository (#1324).
            try
            {
                var learn = UnitsToLearn(committed, _learnedToRepository);
                await Coordinator.LearnGatedAsync(xml, _repoSource.FileName, learn.Keys.ToList(),
                    _repoSource.Repository.FullName, _repoSource.Path);
                RememberLearned(_learnedToRepository, learn);
            }
            catch (Exception ex)
            {
                Log.LogWarning(ex, "Saving to {RepoFullName} succeeded; feeding the translation memory did not.",
                    _repoSource.Repository.FullName);
            }
        }
        catch (GitHubContentConflictException)
        {
            await ShowConflictAsync();
        }
        catch (PlanValidationException ex)
        {
            _toast?.Show("The workbench could not save to the repository", FirstReason(ex), ToastKind.Danger);
        }
        catch (Exception ex) when (ex is GitHubApiException or GitHubAppNotConfiguredException
            or HttpRequestException or TaskCanceledException)
        {
            Log.LogWarning(ex, "Saving {Path} to {RepoFullName} failed.",
                _repoSource.Path, _repoSource.Repository.FullName);
            _toast?.Show(
                "The workbench could not reach GitHub just now",
                "Nothing was saved. Try again in a moment, or export a copy and commit it yourself.",
                ToastKind.Danger);
        }
        finally
        {
            _repoSaving = false;
            _busy = false;
        }
    }

    /// <summary>
    /// Marks saved only the units whose text and state are still exactly what
    /// <paramref name="committed"/> carried (issue #1249). A unit typed into
    /// while the save was in flight keeps its newer text on screen, so it has
    /// to stay unsaved: clearing every unit would leave it out of the next save
    /// and let the tab close without a warning.
    /// </summary>
    internal static void MarkCommitted(IEnumerable<UnitVm> units, IReadOnlyDictionary<string, TargetEdit> committed)
    {
        foreach (var u in units)
        {
            if (u.Dirty
                && committed.TryGetValue(u.Id, out var sent)
                && string.Equals(sent.Target, u.Target, StringComparison.Ordinal)
                && string.Equals(sent.State, u.State, StringComparison.Ordinal))
            {
                u.Dirty = false;
            }
        }
    }

    /// <summary>
    /// Somebody else changed the file after this session opened it. Nothing has
    /// been written, and the only two ways forward are honest ones: keep
    /// editing (and export a copy), or start again from what the repository
    /// holds now.
    /// </summary>
    private async Task ShowConflictAsync()
    {
        if (_repoSource is null) return;
        var source = _repoSource;
        var take = _repoConflictConfirm is not null && await _repoConflictConfirm.OpenAsync(
            $"{source.FileName} changed in the repository since you opened it",
            $"Someone has committed to {source.Path} on {source.Repository.FullName}. Nothing has been "
            + "saved, so their work is untouched. Opening the latest version replaces what is in the "
            + "Translator now - if you want to keep your edits, choose Keep my edits and use Export a copy "
            + "first.",
            "Open the latest version", "btn--danger", "refresh-cw");
        if (!take) return;

        _repo = source.Repository;
        // Named with the language so the reopen reads the translation branch,
        // which is the version the save was compared against.
        await OpenFromRepositoryAsync(new RepositoryTranslationFile(
            source.Path, source.FileName, string.Empty, _targetLang, IsSource: false));
    }

    /// <summary>The line the pull request body carries about how far the translation has got.</summary>
    private string SaveSummary()
    {
        var c = Counts();
        return c.Todo == 0
            ? $"All {c.Total} strings are translated."
            : $"{c.Total - c.Todo} of {c.Total} strings are translated; {c.Todo} still to do.";
    }

    /// <summary>The friendly name for a language tag, falling back to the tag itself.</summary>
    private static string LanguageLabel(string code) =>
        Languages.FirstOrDefault(l => string.Equals(l.Code, code, StringComparison.OrdinalIgnoreCase))
            is { } known
            ? $"{known.Name} ({known.Code})"
            : code;

    /// <summary>
    /// The one sentence out of a refusal. Every refusal these services raise
    /// carries a single field-keyed message written for the person reading it.
    /// </summary>
    private static string FirstReason(PlanValidationException ex) =>
        ex.Errors.Values.FirstOrDefault() ?? "The workbench could not use that repository.";

    // ── Selection + suggestions ───────────────────────────────────────────
    private async Task SelectAsync(string? id)
    {
        _selId = id;
        _sel = id is null ? null : _units.FirstOrDefault(u => u.Id == id);
        // #304: drop the cursor straight into the target box so the user can
        // start typing without a click. List view only - the grid focuses its
        // own cell via @onfocus. The actual focus happens in OnAfterRenderAsync,
        // once the detail rail has rendered.
        if (_sel is not null && _view == "list") _focusTargetPending = true;
        await LoadSuggestionsAsync();
    }

    private async Task LoadSuggestionsAsync()
    {
        _suggestions = new();
        _mtLoading = false;
        if (_sel is null || string.IsNullOrWhiteSpace(_sel.Source)) { _suggLoading = false; return; }
        var forId = _sel.Id;
        var source = _sel.Source;
        var (sourceLang, targetLang) = (_sourceLang, _targetLang);

        List<TranslationSuggestion> memory;
        if (Coordinator.TryGetCached(source, sourceLang, targetLang, out var cached))
        {
            // Warm from a previous visit or a prefetch - no spinner, no DB hit.
            memory = cached;
        }
        else
        {
            _suggLoading = true;
            try
            {
                memory = await Coordinator.LookupAndCacheAsync(source, sourceLang, targetLang);
            }
            catch (Exception ex)
            {
                Log.LogWarning(ex, "Suggestion lookup failed.");
                memory = new();
            }
            finally
            {
                _suggLoading = false;
            }
            // The user may have navigated away, or switched language, while we
            // awaited the DB - the result is then for something no longer shown.
            if (_sel?.Id != forId || _sourceLang != sourceLang || _targetLang != targetLang) return;
        }

        _suggestions = MergeSuggestions(source, memory);
        PrefetchUpcoming();
        ApplyMachineTranslation(source);
    }

    /// <summary>
    /// Decides whether to surface a machine translation for the current source,
    /// honouring the per-tenant trigger: a warm cache hit is appended instantly;
    /// <c>AlwaysAuto</c> always fetches; <c>AutoWhenNoExactMatch</c> fetches only
    /// when no memory/in-file suggestion is an exact (≥0.99) match;
    /// <c>OnDemand</c> waits for the button. The fetch is fire-and-forget so unit
    /// navigation never blocks on the network.
    /// </summary>
    private void ApplyMachineTranslation(string source)
    {
        if (_mtTrigger == MtTrigger.Off) return;
        if (Coordinator.TryGetCachedMt(source, _sourceLang, _targetLang, out var cached)) { AppendMtSuggestion(source, cached); return; }

        if (Coordinator.ShouldAutoTranslate(_mtTrigger, _suggestions))
            _ = LoadMachineTranslationAsync(source, userInitiated: false);
    }

    /// <summary>On-demand button handler - translates the current unit's source.</summary>
    private Task RequestMachineTranslationAsync()
    {
        if (_sel is null || string.IsNullOrWhiteSpace(_sel.Source)) return Task.CompletedTask;
        return LoadMachineTranslationAsync(_sel.Source, userInitiated: true);
    }

    /// <summary>
    /// Fetches a provider translation for <paramref name="source"/> and appends it
    /// as a suggestion chip. Best-effort: a null result (feature off / provider
    /// error) degrades to memory-only, with a toast only when the user asked.
    /// Guards against the user navigating away mid-request.
    /// </summary>
    private async Task LoadMachineTranslationAsync(string source, bool userInitiated)
    {
        if (_mtLoading) return;
        var forId = _selId;
        var (sourceLang, targetLang) = (_sourceLang, _targetLang);
        var context = _sel?.Note ?? (string.IsNullOrEmpty(_sel?.Kind) ? null : _sel!.Kind);

        if (Coordinator.TryGetCachedMt(source, sourceLang, targetLang, out var warm))
        {
            AppendMtSuggestion(source, warm);
            return;
        }

        _mtLoading = true;
        StateHasChanged();
        MtTranslation? res = null;
        try
        {
            // Own DI scope: the auto path fires this off the circuit's dispatcher, and
            // MachineTranslationService reaches the shared DbContext through
            // OrganizationConfigService on a cold cache. See #679.
            await using var scope = ScopeFactory.CreateAsyncScope();
            res = await scope.ServiceProvider.GetRequiredService<MachineTranslationService>()
                .TranslateAsync(source, sourceLang, targetLang, context);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Machine translation request failed.");
        }
        finally
        {
            _mtLoading = false;
        }

        // The user may have moved to another unit, or language, while we awaited the provider.
        if (_selId != forId || _sourceLang != sourceLang || _targetLang != targetLang) { StateHasChanged(); return; }

        if (res is not null && !string.IsNullOrWhiteSpace(res.TargetText))
        {
            var sugg = new TranslationSuggestion(0, res.TargetText, res.ProviderName,
                _sel?.Kind ?? string.Empty, 0.0, 0, 0, IsMachineTranslation: true);
            Coordinator.CacheMt(source, sourceLang, targetLang, sugg);
            AppendMtSuggestion(source, sugg);
        }
        else if (userInitiated)
        {
            Flash("No machine translation available", ToastKind.Warn);
        }
        StateHasChanged();
    }

    /// <summary>
    /// Appends a machine-translation chip to the live suggestion list (below
    /// memory and in-file matches), unless the current selection has moved on or
    /// the same target is already offered.
    /// </summary>
    private void AppendMtSuggestion(string source, TranslationSuggestion mt)
    {
        if (_sel is null || !string.Equals(_sel.Source, source, StringComparison.Ordinal)) return;
        if (_suggestions.Any(s => string.Equals(s.TargetText, mt.TargetText, StringComparison.Ordinal))) return;
        _suggestions = new List<TranslationSuggestion>(_suggestions) { mt };
    }

    /// <summary>
    /// Merges the in-file matches (#302) for <paramref name="source"/> ahead of
    /// the shared-memory hits. The in-file candidates are the user's own
    /// translations of the *same* source elsewhere in the open file (exact
    /// matches, excluding the selected unit and empty targets); the coordinator
    /// owns the de-dup and tagging.
    /// </summary>
    private List<TranslationSuggestion> MergeSuggestions(string source, List<TranslationSuggestion> memory)
    {
        var inFile = _units
            .Where(u => u.Id != _selId
                        && !string.IsNullOrEmpty(u.Target)
                        && string.Equals(u.Source, source, StringComparison.Ordinal))
            .Select(u => new TranslationSuggestionCoordinator.InFileCandidate(u.Target, u.Kind));
        return Coordinator.Merge(inFile, memory);
    }

    /// <summary>
    /// Warms the cache for the unit(s) the user is most likely to land on next -
    /// the next one needing translation (Alt+Enter) and the next row in the
    /// filtered view (Alt+↓ / click) - so #300's "wait for the next one" lag is
    /// gone. Fire-and-forget, gated, and only writes the cache back on the
    /// circuit thread.
    /// </summary>
    private void PrefetchUpcoming()
    {
        var (sourceLang, targetLang) = (_sourceLang, _targetLang);
        foreach (var source in UpcomingSources())
        {
            if (string.IsNullOrWhiteSpace(source) || Coordinator.IsCached(source, sourceLang, targetLang)) continue;
            var src = source;
            _ = Task.Run(async () =>
            {
                try
                {
                    // Own DI scope: this prefetch runs on the thread pool, so it must not
                    // query through the circuit's DbContext — the coordinator's gate only
                    // serialises calls made through the circuit's own instance. See #679.
                    await using var scope = ScopeFactory.CreateAsyncScope();
                    var hits = await scope.ServiceProvider
                        .GetRequiredService<TranslationSuggestionCoordinator>()
                        .LookupGatedAsync(src, sourceLang, targetLang);
                    await InvokeAsync(() =>
                    {
                        // Cached under the languages it was looked up in, so a
                        // prefetch that outlives a language switch cannot pass
                        // itself off as the new language's answer.
                        Coordinator.Cache(src, sourceLang, targetLang, hits);
                        // If the user already landed here while the panel was
                        // empty, fill it in now rather than make them re-select.
                        if (_sourceLang == sourceLang && _targetLang == targetLang
                            && _sel is not null && !_suggLoading && _suggestions.Count == 0
                            && string.Equals(_sel.Source, src, StringComparison.Ordinal))
                        {
                            _suggestions = MergeSuggestions(src, hits);
                            StateHasChanged();
                        }
                    });
                }
                catch { /* prefetch is best-effort */ }
            });
        }
    }

    private IEnumerable<string> UpcomingSources()
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        if (_sel is not null) seen.Add(_sel.Source); // current is already loaded

        // Alt+Enter target: the next unit needing translation, in _units order.
        foreach (var u in _units.Where(u => u.Id != _selId && IsNeeding(u)).Take(2))
            if (seen.Add(u.Source)) yield return u.Source;

        // Alt+↓ / click target: the next couple of rows in the filtered view.
        var i = _filtered.FindIndex(u => u.Id == _selId);
        if (i >= 0)
            for (var j = i + 1; j < _filtered.Count && j <= i + 2; j++)
                if (seen.Add(_filtered[j].Source)) yield return _filtered[j].Source;
    }

    // ── Editing ───────────────────────────────────────────────────────────
    private void OnTargetInput(ChangeEventArgs e)
    {
        if (_sel is null) return;
        _sel.Target = e.Value?.ToString() ?? string.Empty;
        _sel.Dirty = true;
        SetUnsaved(true);
        PersistEditsSoon();
    }

    private void OnGridTargetInput(UnitVm u, ChangeEventArgs e)
    {
        u.Target = e.Value?.ToString() ?? string.Empty;
        u.Dirty = true;
        SetUnsaved(true);
        PersistEditsSoon();
    }

    /// <summary>
    /// Empties a unit's target and puts it back in the to-do bucket (#560).
    ///
    /// The grid's last column was the handoff's hover-revealed actions track,
    /// and PR 13 had nothing to put in it. This is the action: the state picker
    /// can move a unit between states, but there was no way to undo a target
    /// you filled by mistake, in either view. An empty target IS untranslated,
    /// so the state moves with it rather than leaving a "Translated" row with
    /// nothing in it.
    /// </summary>
    private void ClearTarget(UnitVm u)
    {
        if (u.Target.Length == 0) return;
        u.Target = string.Empty;
        u.State = StTodo;
        u.Dirty = true;
        SetUnsaved(true);
        RecomputeFiltered();
        PersistEditsSoon();
        Flash("Cleared - back to Needs translation");
    }

    private void SetState(string token)
    {
        if (_sel is null) return;
        _sel.State = token;
        _sel.Dirty = true;
        SetUnsaved(true);
        RecomputeFiltered();
        PersistEditsSoon();
    }

    private async Task Fill(string target)
    {
        if (_sel is null) return;
        _sel.Target = target;
        _sel.State = StTranslated;
        _sel.Dirty = true;
        SetUnsaved(true);
        PersistEditsSoon();
        Flash("Filled from your organisation's memory · marked Translated");
        // #301: stay on this unit (no RecomputeFiltered, so it isn't dropped out
        // of the To-do filter and the selection isn't bumped to the next row) so
        // the user can keep refining - e.g. take an 80% match, then edit it.
        // #299: refresh suggestions for the same unit so picking again is easy.
        await LoadSuggestionsAsync();
    }

    /// <summary>
    /// Up/down votes a memory suggestion (toggling off when the same direction
    /// is clicked again) and reflects the new score/own-vote on the chip. Votes
    /// re-rank suggestions on the next lookup.
    /// </summary>
    private async Task VoteSuggestionAsync(long entryId, int direction)
    {
        try
        {
            var res = await Coordinator.VoteGatedAsync(entryId, direction);
            var idx = _suggestions.FindIndex(x => x.EntryId == entryId);
            if (idx >= 0) _suggestions[idx] = _suggestions[idx] with { Score = res.Score, MyVote = res.MyVote };
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Vote on memory entry {EntryId} failed.", entryId);
            Flash("Couldn't record that vote", ToastKind.Danger);
        }
    }

    /// <summary>
    /// Editor/Admin only: soft-deletes a bad memory entry so it stops appearing
    /// as a suggestion. Recoverable from the Translation memory admin page.
    /// </summary>
    private async Task RemoveSuggestionAsync(long entryId)
    {
        try
        {
            await Coordinator.DeleteGatedAsync(entryId);
            _suggestions.RemoveAll(x => x.EntryId == entryId);
            Flash("Removed. An admin can restore it from Translation memory.");
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Remove of memory entry {EntryId} failed.", entryId);
            Flash("Couldn't remove that entry", ToastKind.Danger);
        }
    }

    private void SaveAndNext()
    {
        if (_sel is null) return;
        // Alt+Enter confirms the current unit: a fresh translation (Todo with
        // text) and a flagged "needs review" line both become Translated - the
        // review case even with no edit, since confirming the review is the
        // whole point of the keystroke. (#303)
        if (!string.IsNullOrWhiteSpace(_sel.Target) && _sel.State is StTodo or StReview)
        {
            _sel.State = StTranslated;
            _sel.Dirty = true;
            SetUnsaved(true);
        }
        var next = _units.FirstOrDefault(u => u.Id != _sel!.Id && IsNeeding(u));
        RecomputeFiltered();
        PersistEditsSoon();
        if (next is not null)
        {
            _ = SelectAsync(next.Id);
            Flash("Saved · jumped to next unit needing translation");
        }
        else
        {
            Flash("Saved · nothing left to translate");
        }
    }

    private void Nav(int dir)
    {
        if (_filtered.Count == 0) return;
        var i = _filtered.FindIndex(u => u.Id == _selId);
        if (i < 0) { _ = SelectAsync(_filtered[0].Id); return; }
        var n = Math.Clamp(i + dir, 0, _filtered.Count - 1);
        _ = SelectAsync(_filtered[n].Id);
    }

    private async Task PreTranslateAsync()
    {
        _busy = true;
        try
        {
            var needing = _units.Where(IsNeeding).ToList();
            var sources = needing.Select(u => u.Source).Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.Ordinal).ToList();
            if (sources.Count == 0) { Flash("Nothing to pre-translate", ToastKind.Warn); return; }

            var matches = await Coordinator.GetExactMatchesGatedAsync(sources, _sourceLang, _targetLang);

            // It rewrites hundreds of rows at once with no undo, so the count
            // goes in front of the user before it happens rather than in the
            // toast afterwards.
            var willFill = needing.Count(u => matches.ContainsKey(u.Source));
            if (willFill == 0) { Flash("No exact memory matches to pre-fill", ToastKind.Warn); return; }
            if (_preTranslateConfirm is not null)
            {
                _busy = false;
                var go = await _preTranslateConfirm.OpenAsync(
                    $"Fill {willFill} string{(willFill == 1 ? "" : "s")} from memory?",
                    $"{(willFill == 1 ? "It has" : "They have")} an exact match in your organisation's memory and will be marked Translated. You can still edit each one afterwards, and nothing is written to your file until you save.",
                    "Fill them in", "btn--primary", "zap");
                _busy = true;
                if (!go) return;
            }

            var filled = 0;
            foreach (var u in needing)
            {
                if (matches.TryGetValue(u.Source, out var m))
                {
                    u.Target = m.TargetText;
                    u.State = StTranslated;
                    u.Dirty = true;
                    filled++;
                }
            }
            if (filled > 0) SetUnsaved(true);
            RecomputeFiltered();
            if (_sel is not null) await LoadSuggestionsAsync();
            PersistEditsSoon();
            Flash($"Filled {filled} string{(filled == 1 ? "" : "s")} from your organisation's memory",
                ToastKind.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Header controls ───────────────────────────────────────────────────
    private async Task OnTargetLangChanged(ChangeEventArgs e)
    {
        _targetLang = e.Value?.ToString() ?? _targetLang;
        Coordinator.ClearCaches(); // suggestions are language-specific

        // A translation started from the generated source file is named for the
        // language it is in, so changing the language changes where it saves -
        // and it is then a file nothing has been written to yet.
        if (_repoGeneratedPath is not null && _repoSource is not null)
        {
            _repoSource = DerivedSource(_repoSource.Repository, _repoGeneratedPath);
            _fileName = _repoSource.FileName;
            _pullRequest = null;
        }
        else if (_fromGeneratedFile)
        {
            // Likewise for one opened from disk: the export is named for it.
            _fileName = TranslationFileRules.LanguageFileName(_fileName, _targetLang);
        }

        if (_module is not null) await _module.InvokeVoidAsync("putMeta", _openId, _fileName, _targetLang);
        await LoadSuggestionsAsync();
    }

    private void OnKindChanged(ChangeEventArgs e)
    {
        _kind = e.Value?.ToString() ?? "All kinds";
        RecomputeFiltered();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        RecomputeFiltered();
    }

    private void SetFilter(string f) { _filter = f; RecomputeFiltered(); }

    private void ClearFilters() { _filter = "all"; _kind = "All kinds"; _search = ""; RecomputeFiltered(); }

    private async Task StopRenameAsync()
    {
        _editingName = false;
        if (_module is not null) await _module.InvokeVoidAsync("putMeta", _openId, _fileName, _targetLang);
    }

    private async Task OnFilenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await StopRenameAsync();
    }

    // ── Export / save ─────────────────────────────────────────────────────
    // The primary action: on a browser with a writable handle it saves in place;
    // otherwise it downloads. "Export a copy" (ExportCopyAsync) always downloads.
    private async Task ExportAsync()
    {
        if (_module is null) return;
        var editsJson = SerializeEdits();

        if (_canSaveInPlace)
        {
            await SaveInPlaceAsync(editsJson);
            return;
        }
        await DownloadExportAsync(editsJson);
    }

    private async Task ExportCopyAsync()
    {
        if (_module is null) return;
        await DownloadExportAsync(SerializeEdits());
    }

    // Writes edits straight back to the opened file. The byte-faithful merge
    // still runs server-side (same /api/translator/export endpoint); JS fetches
    // the result and writes it to the handle. See .design/translator/ and the
    // File System Access flow in Translator.razor.js.
    private async Task SaveInPlaceAsync(string editsJson)
    {
        var learn = PendingLearning(editsJson);
        _busy = true;
        try
        {
            var status = await _module!.InvokeAsync<string>("saveInPlace", _openId, _fileName, editsJson,
                JsonSerializer.Serialize(learn.Keys));
            switch (status)
            {
                case "saved":
                    RememberLearned(_learnedLocally, learn);
                    // Edits typed while the save was in flight are not in the
                    // file, so the unsaved guard stays up for them and they go
                    // back into the overlay a refresh restores from (#1268, L44).
                    if (SerializeEdits() == editsJson) SetUnsaved(false);
                    else PersistEditsSoon();
                    // Deliberately not built from the rename box's value:
                    // saveInPlace writes to the handle the user picked, whose
                    // name on disk never changes. The rename affordance retitles
                    // the copy Export writes, so after a rename this toast used
                    // to name a file that does not exist.
                    Flash("Saved to the file you opened");
                    break;
                case "denied":
                    Flash("Permission to write the file was declined", ToastKind.Danger);
                    break;
                case "no-handle":
                    // The handle went away (rare) — fall back to a download so
                    // the user still gets their edits out.
                    _canSaveInPlace = false;
                    await DownloadExportAsync(editsJson);
                    break;
                case "empty":
                    Flash("Nothing to save yet", ToastKind.Warn);
                    break;
                case "missing":
                    // The browser lost this file's stored copy and handle;
                    // nothing was written, and these edits are still unsaved.
                    Flash(StoredCopyMissing("save", fromRepository: _repoSource is not null), ToastKind.Danger);
                    break;
                default:
                    Flash("Could not save the file - try Export a copy", ToastKind.Danger);
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadExportAsync(string editsJson)
    {
        var learn = PendingLearning(editsJson);
        // Exporting *is* saving: the user now has a copy on disk. Drop the
        // unsaved-changes guard *before* the submit so the form POST (which the
        // browser treats as a navigation) doesn't trip the leave-confirm modal
        // or the beforeunload prompt. This also flips `_unsaved` off so the
        // LocationChanging handler stays quiet; the JS side detaches the
        // beforeunload listener synchronously right before `form.submit()`.
        var wasUnsaved = _unsaved;
        SetUnsaved(false);
        var status = await _module!.InvokeAsync<string>("exportNow", _openId, _fileName, editsJson,
            JsonSerializer.Serialize(learn.Keys));
        switch (status)
        {
            case "exported":
                RememberLearned(_learnedLocally, learn);
                break;
            case "missing":
                // The browser's stored copy of the file is gone, so nothing
                // was posted, and these edits are still unsaved.
                SetUnsaved(wasUnsaved);
                // The generated file's button says "Download translation".
                Flash(StoredCopyMissing(_fromGeneratedFile ? "download" : "export", fromRepository: _repoSource is not null),
                    ToastKind.Danger);
                break;
            default:
                // Nothing was posted either, so nothing was saved.
                SetUnsaved(wasUnsaved);
                Flash("Nothing to export yet", ToastKind.Warn);
                break;
        }
    }

    /// <summary>
    /// What the page says when the browser no longer has this tab's stored copy
    /// of the file, so it cannot export or save it. Each open keeps its own
    /// copy (#1609), so another tab no longer causes this; clearing the
    /// browser's site data does. For a local file, opening it again starts
    /// from the file on disk, so it says plainly that the edits typed here go.
    /// A file from a repository is different: Save to repository works from the
    /// copy the page itself holds, so the edits can still be kept (#1609, OEX4-4).
    /// </summary>
    internal static string StoredCopyMissing(string action, bool fromRepository) => fromRepository
        ? $"The browser no longer has a copy of this file, so it cannot {action} it. Save to repository still works and keeps your edits."
        : $"The browser no longer has a copy of this file, so it cannot {action} it. Open the file again to {action} - unsaved edits in this tab will be lost.";

    /// <summary>The units in <paramref name="editsJson"/> the translation memory has not yet learned with their current text.</summary>
    private Dictionary<string, string> PendingLearning(string editsJson)
    {
        var posted = JsonSerializer.Deserialize<Dictionary<string, EditDto>>(editsJson) ?? new();
        return ExportLearning(posted.ToDictionary(e => e.Key, e => new TargetEdit(e.Value.T, e.Value.S)),
            _learnedLocally, openedFromRepository: _repoSource is not null || _restoredFromRepository);
    }

    /// <summary>What the browser's session record keeps of <paramref name="source"/>, so a restore knows (#1540).</summary>
    private static RepositoryOriginDto RepositoryOrigin(RepositoryTranslationSource source) =>
        new() { Repository = source.Repository.FullName, Path = source.Path };

    /// <summary>
    /// What a download or an in-place save should teach the translation memory.
    /// Nothing, for a file opened from a repository: the export endpoint learns
    /// without a repository, and a pair with none is suggested to the whole
    /// organisation - so "Export a copy" of a Private solution's file used to
    /// hand its strings to people outside the solution's team (#1540). Save to
    /// repository learns those units with the repository attached (#1324), and
    /// the daily ingest picks up a copy committed by hand, so nothing is lost.
    /// </summary>
    internal static Dictionary<string, string> ExportLearning(
        IReadOnlyDictionary<string, TargetEdit> edits, IReadOnlyDictionary<string, string> learned,
        bool openedFromRepository) =>
        openedFromRepository
            ? new Dictionary<string, string>(StringComparer.Ordinal)
            : UnitsToLearn(edits, learned);

    private void RememberLearned(Dictionary<string, string> scope, IReadOnlyDictionary<string, string> learned)
    {
        if (learned.Count == 0) return;
        foreach (var (id, target) in learned) scope[id] = target;
        PersistEditsSoon();
    }

    private string SerializeLearned() => JsonSerializer.Serialize(new LearnedDto
    {
        Local = new(_learnedLocally, StringComparer.Ordinal),
        Repository = new(_learnedToRepository, StringComparer.Ordinal),
    });

    /// <summary>
    /// The edits worth teaching the translation memory, by unit id with the
    /// target they carry: those with text that differs from what the unit last
    /// taught it (#1343). A save that changed nothing about a unit since the
    /// last one adds no further hit to it.
    /// </summary>
    internal static Dictionary<string, string> UnitsToLearn(
        IReadOnlyDictionary<string, TargetEdit> edits, IReadOnlyDictionary<string, string> learned)
    {
        var result = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var (id, edit) in edits)
        {
            if (string.IsNullOrEmpty(edit.Target)) continue;
            if (learned.TryGetValue(id, out var last) && string.Equals(last, edit.Target, StringComparison.Ordinal)) continue;
            result[id] = edit.Target;
        }
        return result;
    }

    // ── Keyboard (from Translator.razor.js) ───────────────────────────────
    // Ctrl/Cmd+S. Only saves in place when a writable handle is available;
    // otherwise it's a no-op (the plain download stays on the explicit button,
    // since a surprise download on Ctrl+S would be jarring).
    [JSInvokable]
    public async Task SaveFromKey()
    {
        if (_module is null || _busy) return;
        if (_fromGeneratedFile && _repoSource is null)
        {
            // Ctrl+S out of habit would otherwise do nothing, and nothing
            // looks a lot like "saved" (#1325).
            Flash("This file is rebuilt by every build, so your work is not saved into it - use Download translation to keep it.",
                ToastKind.Warn);
            StateHasChanged();
            return;
        }
        if (!_canSaveInPlace) return;
        await SaveInPlaceAsync(SerializeEdits());
        StateHasChanged();
    }

    [JSInvokable]
    public Task SaveAndNextFromKey() { SaveAndNext(); StateHasChanged(); return Task.CompletedTask; }

    [JSInvokable]
    public Task NavFromKey(int dir) { Nav(dir); StateHasChanged(); return Task.CompletedTask; }

    [JSInvokable]
    public async Task ApplySuggestionFromKey(int n)
    {
        if (_sel is not null && n >= 1 && n <= _suggestions.Count)
        {
            await Fill(_suggestions[n - 1].TargetText);
            StateHasChanged();
        }
    }

    // ── Filtering / counts ────────────────────────────────────────────────
    private void RecomputeFiltered()
    {
        var q = _search.Trim();
        IEnumerable<UnitVm> src = _units;
        src = _filter switch
        {
            // Every arm asks DesignState, and so does Counts(), so a tab's badge
            // is always the number of rows that tab produces. They used to be
            // derived separately: the badge counted units needing translation
            // and the filter counted units needing *work*, so a tab reading 88
            // filtered to 175.
            "todo" => src.Where(u => DesignState(u) == "untranslated"),
            "review" => src.Where(u => DesignState(u) == "fuzzy"),
            "done" => src.Where(u => DesignState(u) is "translated" or "final"),
            _ => src,
        };
        if (_kind != "All kinds") src = src.Where(u => u.Kind == _kind);
        if (!string.IsNullOrEmpty(q))
            src = src.Where(u => u.Source.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (u.Target ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        _filtered = src.ToList();

        // Keep a valid selection within the filtered set.
        if (_filtered.Count > 0 && (_selId is null || _filtered.All(u => u.Id != _selId)))
        {
            _selId = _filtered[0].Id;
            _sel = _filtered[0];
        }
    }

    private static bool IsNeeding(UnitVm u) =>
        u.State is StTodo or StReview || string.IsNullOrEmpty(u.Target);

    private readonly record struct CountSet(int Total, int Final, int Translated, int Review, int Todo, int Pct);

    private CountSet Counts()
    {
        int final = 0, trans = 0, review = 0, todo = 0;
        foreach (var u in _units)
        {
            switch (DesignState(u))
            {
                case "final": final++; break;
                case "translated": trans++; break;
                case "fuzzy": review++; break;
                default: todo++; break;
            }
        }
        var total = _units.Count;
        var done = final + trans;
        var pct = total == 0 ? 0 : (int)Math.Round(done * 100.0 / total);
        return new CountSet(total, final, trans, review, todo, pct);
    }

    private int HiddenCount() => _units.Count - _filtered.Count;

    /// <summary>
    /// Enter or Space on something that behaves like a button but cannot be one.
    /// </summary>
    private static void OnActivateKey(KeyboardEventArgs e, Action activate)
    {
        if (e.Key is "Enter" or " ") activate();
    }

    /// <summary>Units the user has touched and not yet written back to a file.</summary>
    private int DirtyCount() => _units.Count(u => u.Dirty);

    /// <summary>
    /// The unit key as the grid shows it: the two ids, without the element-kind
    /// words between them. A BC XLIFF id is
    /// "Codeunit 1465371914 - NamedType 1138880009" - 42 characters, of which
    /// the leading half groups the row by object and the trailing half is what
    /// separates it from its neighbours. Neither fits a grid column with the
    /// other, and dropping either one makes a screen of rows that read alike.
    /// Dropping the *words* keeps both numbers and loses nothing the Kind column
    /// does not already say. Full id stays on the cell's title.
    /// </summary>
    private static string GridKey(string shortId)
    {
        var parts = shortId.Split(" · ", StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2) return shortId;

        // The FIRST segment keeps its word: "Codeunit" / "Page" / "Table" is the
        // object kind, which is the one part of the id a person can actually
        // read. Later segments ("NamedType", "Property", "Control") name the
        // element inside it, which the Kind column already covers.
        return string.Join(" · ", parts.Select((part, i) => i == 0 ? part : Trim(part)));

        // "NamedType 1138880009" -> "1138880009"; a segment with no trailing
        // number ("Table Customer") keeps it, since there is nothing to fall
        // back on.
        static string Trim(string part)
        {
            var space = part.LastIndexOf(' ');
            if (space <= 0) return part;
            var tail = part[(space + 1)..];
            return tail.Length > 0 && tail.All(char.IsDigit) ? tail : part;
        }
    }

    /// <summary>
    /// The developer note with BC's (Key=Value) wrapper unpicked, or null when
    /// nothing readable is left. The generator writes
    /// "(Namespace=Microsoft.EServices.EDocument)(LookupHint=Codeunit OIOUBL-Check
    /// Sales Header - NamedType DiscountAmountNegativeErr)" - the keys are the
    /// file format talking to itself, and the values are the part a translator
    /// can use to work out what the string is for.
    /// </summary>
    private static string? ReadableNote(string? note)
    {
        if (string.IsNullOrWhiteSpace(note)) return null;

        var parts = new List<string>();
        var rest = note.Trim();
        foreach (Match m in Regex.Matches(rest, @"\(([A-Za-z]+)=([^)]*)\)"))
        {
            var value = m.Groups[2].Value.Trim();
            if (value.Length > 0) parts.Add(value);
        }

        // Anything outside the (Key=Value) runs is the developer's own prose --
        // "%1 - document type, %2 - document no." - and is the most useful part
        // of all, so it leads.
        var prose = Regex.Replace(rest, @"\([A-Za-z]+=[^)]*\)", " ").Trim(' ', '.', ',');
        if (prose.Length > 0) parts.Insert(0, prose);

        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }
    private int SelIndex() => _filtered.FindIndex(u => u.Id == _selId);

    private List<string> KindOptions()
    {
        var kinds = _units.Select(u => u.Kind).Distinct().OrderBy(k => k).ToList();
        kinds.Insert(0, "All kinds");
        return kinds;
    }

    // ── Persistence (debounced) ───────────────────────────────────────────
    private void PersistEditsSoon()
    {
        _persistCts?.Cancel();
        _persistCts?.Dispose();
        _persistCts = new CancellationTokenSource();
        var token = _persistCts.Token;
        var json = SerializeEdits();
        var learned = SerializeLearned();
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested || _module is null) return;
                // The open id names this tab's own record, so the overlay never
                // lands on another tab's - even one with a file of the same
                // name (#1574, #1609). Read now, not when the save was queued,
                // so it is the id of the file open when the write happens.
                await _module.InvokeVoidAsync("putEdits", _openId, json, learned);
            }
            catch { /* debounced away or storage unavailable */ }
        });
    }

    private string SerializeEdits()
    {
        var map = new Dictionary<string, EditDto>(StringComparer.Ordinal);
        foreach (var u in _units.Where(u => u.Dirty))
        {
            map[u.Id] = new EditDto { T = u.Target, S = u.State };
        }
        return JsonSerializer.Serialize(map);
    }

    /// <summary>
    /// The same edit overlay <see cref="SerializeEdits"/> posts to the export
    /// endpoint, as the merge takes it. Saving to a repository merges
    /// server-side rather than posting a form, so it needs the map itself.
    /// </summary>
    private Dictionary<string, TargetEdit> BuildEdits()
    {
        var map = new Dictionary<string, TargetEdit>(StringComparer.Ordinal);
        foreach (var u in _units.Where(u => u.Dirty))
        {
            map[u.Id] = new TargetEdit(u.Target, u.State);
        }
        return map;
    }

    /// <summary>
    /// Shows a transient message. Defaults to the success variant because most
    /// of them confirm a save; pass a kind for the ones that report a failure
    /// or a no-op, which until the toast migration all rendered a green tick.
    /// </summary>
    private void Flash(string msg, ToastKind kind = ToastKind.Success) => _toast?.Show(msg, kind: kind);

    // ── Display helpers ───────────────────────────────────────────────────
    private static string DisplayKind(string bucket) => bucket switch
    {
        "caption" => "Caption",
        "tooltip" => "Tooltip",
        "label" => "Label",
        "option" => "Option",
        "instructional" => "Instructional",
        _ => "Other",
    };

    private static string NormaliseState(string? raw, string target)
    {
        var s = (raw ?? "").Trim().ToLowerInvariant();
        return s switch
        {
            "translated" => StTranslated,
            "final" or "signed-off" => StFinal,
            "needs-translation" or "new" => StTodo,
            _ when s.StartsWith("needs-review") || s.StartsWith("needs-adaptation") => StReview,
            "" => string.IsNullOrEmpty(target) ? StTodo : StTranslated,
            _ => string.IsNullOrEmpty(target) ? StTodo : StTranslated,
        };
    }

    // The four XLIFF buckets, in the design system's own vocabulary. RowStateIcon
    // knows this family (untranslated / fuzzy / translated / final): it maps each
    // one to a glyph and to the `is-*` class that colours the .trow keyline in
    // pages-power.css, so the row edge, the status glyph and the progress ribbon
    // can never disagree. Our internal tokens keep the XLIFF spelling because
    // that is what gets written back to the file.
    private static string DesignStateOf(string state) => state switch
    {
        StFinal => "final",
        StTranslated => "translated",
        StReview => "fuzzy",
        _ => "untranslated",
    };

    // A unit with a "translated" state but an empty target is still untranslated.
    // Counts() applies the same rule via IsNeeding, so the ribbon and the rows
    // agree about which bucket a unit is in.
    private static string DesignState(UnitVm u) =>
        IsNeeding(u) ? (u.State == StReview ? "fuzzy" : "untranslated") : DesignStateOf(u.State);

    private string TargetLangName()
    {
        var l = Languages.FirstOrDefault(x => x.Code == _targetLang);
        return l is null ? _targetLang : $"{l.Name} ({l.Code})";
    }

    private static string FlagOf(string code)
    {
        var dash = code.IndexOf('-');
        var lang = dash > 0 ? code[..dash] : code;
        return lang.ToUpperInvariant();
    }

    private static string HumanizeAge(TimeSpan age)
    {
        if (age < TimeSpan.FromMinutes(1)) return "just now";
        if (age < TimeSpan.FromHours(1)) return Plural((int)age.TotalMinutes, "minute");
        if (age < TimeSpan.FromHours(24)) return Plural((int)age.TotalHours, "hour");
        var days = (int)age.TotalDays;
        return days == 1 ? "yesterday" : Plural(days, "day");

        static string Plural(int n, string unit) => $"{n} {unit}{(n == 1 ? "" : "s")} ago";
    }

    private static string Pct(int n, int total) => total == 0 ? "0%" : $"{n * 100.0 / total:0.###}%";

    private static string SimClass(double sim) => sim >= 0.99 ? "exact" : sim >= 0.8 ? "high" : "mid";
    private static string SimLabel(double sim) => sim >= 0.99 ? "Exact" : $"{Math.Round(sim * 100)}%";

    /// <summary>
    /// The file a suggestion was learned from, on GitHub. The ref is HEAD, which
    /// GitHub resolves to the repository's current default branch, so the link
    /// survives a rename.
    /// </summary>
    private static string RepositoryFileUrl(string repository, string path) =>
        $"https://github.com/{repository}/blob/HEAD/{path}";

    public async ValueTask DisposeAsync()
    {
        _persistCts?.Cancel();
        _persistCts?.Dispose();
        _navRegistration?.Dispose();
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("setBeforeUnload", false); } catch { }
            try { await _module.InvokeVoidAsync("detachKeys"); } catch { }
            try { await _module.InvokeVoidAsync("teardownDropZone"); } catch { }
            try { await _module.InvokeVoidAsync("teardownPicker"); } catch { }
            try { await _module.InvokeVoidAsync("teardownSplit"); } catch { }
            // The file stays stored, so another tab's restore prompt can now
            // offer whatever was left unsaved here.
            try { await _module.InvokeVoidAsync("release"); } catch { }
            try { await _module.DisposeAsync(); } catch { }
        }
        _selfRef?.Dispose();
    }
}
