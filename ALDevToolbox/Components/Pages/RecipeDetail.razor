@page "/cookbook/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RecipeService Recipes
@inject MarkdownRenderer Markdown
@inject IJSRuntime JS
@inject IOrganizationContext OrgContext
@inject ILogger<RecipeDetail> Logger
@inject GitHubRepositoryService Repositories
@inject GitHubRecipeDeliveryService RecipeDelivery
@using ALDevToolbox.Domain.Entities
@using ALDevToolbox.Domain.ValueObjects
@using ALDevToolbox.Services.Cookbook
@using ALDevToolbox.Services.GitHub

<PageTitle>@(_recipe?.Title ?? "Recipe") · AL Workbench</PageTitle>

@*
    Archetype 3 (master-detail), same shape as /pipelines/{id} and /releases/{id}:
    crumbs outside the head, the page's actions on the title row, and the facts in
    a factbox rail beside the content (.detail-body + .detail-body__aside). The
    files open in the shared FileBrowser: a folder tree beside a read-only code
    viewer, the same one a suggestion is reviewed in. See .design/design-migration.md.

    Named user: a BC consultant opening a pattern for the first time to pull it
    into a customer solution. Primary action: the download.
*@

<div class="page">
    @if (_loaded && _recipe is null)
    {
        <div class="empty-state">
            <span class="empty-state__icon"><Icon Name="circle-alert" Width="21" Height="21" /></span>
            <h1 class="empty-state__title">Recipe not found</h1>
            <p class="empty-state__text">
                This recipe may have been deleted since the link was made.
            </p>
            <a class="btn btn--primary empty-state__action" href="/cookbook">
                <Icon Name="arrow-left" Width="16" Height="16" />
                <span>Back to cookbook</span>
            </a>
        </div>
    }
    else if (_recipe is null)
    {
        <div class="loading-block">
            <span class="spinner"></span><span>Loading recipe...</span>
        </div>
    }
    else
    {
        var tags = SplitKeywords(_recipe.Keywords);
        <div class="page-head__crumbs">
            <a href="/cookbook">Cookbook</a>
            <Icon Name="chevron-right" Width="12" Height="12" />
            <span>@_recipe.Title</span>
        </div>

        <div class="detail-head">
            <div class="rd-head">
                <div class="detail-head__title-row">
                    <h1 class="detail-head__title">@_recipe.Title</h1>
                    <RecipeTypeBadge Type="_recipe.Type" />
                    @if (_recipe.Deprecated)
                    {
                        <StatusPill Tone="warn">
                            <Icon Name="archive" Width="12" Height="12" />
                            Deprecated
                        </StatusPill>
                    }
                </div>
                <p class="rd-desc">@_recipe.Description</p>
                @* Keywords are links, not decoration. As mono chips they said
                   "identifier" and looked like filters while doing nothing;
                   they are the best way into related recipes, so they now go
                   there. See issue #540. *@
                @if (tags.Count > 0)
                {
                    <div class="rd-tags">
                        @foreach (var tag in tags)
                        {
                            <a class="tag" href="@($"/cookbook?q={Uri.EscapeDataString(tag)}")"
                               title="@($"Find recipes tagged {tag}")">@tag</a>
                        }
                    </div>
                }
            </div>
            @* The way back sits on the title row with the download, not on a line
               of its own above the page: one row of actions, the download the only
               primary one. Same shape as /releases/{id}. See issue #605. *@
            <div class="page-head__actions">
                <a class="btn" href="/cookbook">
                    <Icon Name="arrow-left" Width="15" Height="15" />
                    <span>Back to cookbook</span>
                </a>
                @* Primary even on a deprecated recipe: the amber banner below
                   carries the caution, and demoting the button only left the page
                   with two identical outline buttons and no obvious action. The
                   label names what arrives - the endpoint always builds a ZIP,
                   one file or twenty - and the trailing "..." is the convention
                   for a control that opens a dialog rather than acting
                   immediately; this one asks for a customer name first. *@
                @if (_recipe.Files.Count > 0)
                {
                    <button type="button" class="btn btn--primary" @onclick="OpenDownloadModal">
                        <Icon Name="download" Width="15" Height="15" />
                        <span>Download ZIP...</span>
                    </button>
                }
            </div>
        </div>

        @* What just happened, on the page rather than in a toast: a pull request
           is somebody else's turn next, and the link to it is the thing the
           consultant needs to send on. See issue #626. *@
        @if (_delivery is { } delivery)
        {
            <Alert Tone="AlertTone.Success" Block="true">
                <span class="u-stack">
                    <span>
                        @(delivery.IsNewPullRequest
                            ? $"Pull request #{delivery.PullRequest.Number} was opened on "
                            : $"The files were added to pull request #{delivery.PullRequest.Number}, already open on ")
                        <strong>@delivery.Repository.FullName</strong>
                        from branch <code class="code">@delivery.PullRequest.HeadBranch</code>.
                        Merge it on GitHub to add these files to the repository.
                    </span>
                    <span>
                        <a class="btn" href="@delivery.PullRequest.HtmlUrl" target="_blank" rel="noopener">
                            <Icon Name="external-link" Width="15" Height="15" />
                            <span>Open pull request #@delivery.PullRequest.Number</span>
                        </a>
                    </span>
                </span>
            </Alert>
        }

        @if (_recipe.Deprecated)
        {
            <Alert Tone="AlertTone.Warn" Role="" Block="true">
                <span>
                    <b>This recipe is no longer recommended.</b>
                    It is kept so existing solutions can still find it. Check it
                    carefully before using it on a new customer.
                </span>
            </Alert>
        }

        <div class="detail-body">
            <div class="detail-body__main">
                @* The section stays even with nothing in it. Dropping it put the
                   reader straight from the title into a wall of code with no sign
                   that a write-up was ever meant to be there. *@
                <section class="rd-sec">
                    <div class="rd-sec__head"><span class="section-label">Instructions</span></div>
                    @if (!string.IsNullOrWhiteSpace(_recipe.Instructions))
                    {
                        <div class="rd-prose">
                            @Markdown.Render(_recipe.Instructions)
                        </div>
                    }
                    else
                    {
                        <p class="rd-prose rd-prose--muted">
                            No write-up for this one - the code is meant to be read and
                            adapted directly.
                        </p>
                    }
                </section>

                <section class="rd-sec">
                    <div class="rd-sec__head">
                        <span class="section-label">Files</span>
                        <span class="rd-sec__note">@_recipe.Files.Count file@(_recipe.Files.Count == 1 ? "" : "s")</span>
                    </div>

                    @if (_recipe.Files.Count == 0)
                    {
                        <div class="card">
                            <div class="empty-state">
                                <span class="empty-state__icon"><Icon Name="file-code" Width="21" Height="21" /></span>
                                <span class="empty-state__title">No files attached</span>
                                <span class="empty-state__text">
                                    This recipe explains an approach rather than shipping code to copy.
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <FileBrowser Files="_files" OnCopy="CopyFileAsync" />
                    }
                </section>
            </div>

            @* The factbox rail. "Requires" and "Time saved" used to be a
               full-width .meta-row under the title; beside the content they read
               as what they are — the facts you check before pulling the pattern
               into a customer solution — and they leave the width to the code.
               The jump list sits under them once there is more than one file. *@
            <aside class="detail-body__aside">
                <section class="card">
                    <div class="card__head"><h2 class="card__title">At a glance</h2></div>
                    <div class="card__body rd-facts">
                        <div class="meta-item">
                            <span class="meta-item__label">Requires</span>
                            <span class="meta-item__value rd-meta-wrap">
                                @if (_recipe.MinimumApplicationVersion is { } minV)
                                {
                                    <text>@minV.Name or later</text>
                                    <span class="rd-meta-sub">app version @minV.Application</span>
                                }
                                else
                                {
                                    <text>Any supported version</text>
                                }
                            </span>
                        </div>
                        @if (_recipe.EstimatedValueHours is { } hours)
                        {
                            @* The label carries the meaning. It used to say "Est. value" and
                               explain itself in a title attribute — invisible on touch, on
                               keyboard, and to anyone who never rests a mouse there. *@
                            <div class="meta-item">
                                <span class="meta-item__label">Time saved</span>
                                <span class="meta-item__value rd-meta-wrap">
                                    @FormatHours(hours)
                                    <span class="rd-meta-sub">bill at least this</span>
                                </span>
                            </div>
                        }
                    </div>
                </section>
            </aside>
        </div>
    }
</div>

<ToastHost @ref="_toast" />

@if (_showDownloadModal)
{
    <div class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="dl-modal-title"
         @onkeydown="OnDownloadKeyDown">
        <div class="modal-backdrop" @onclick="CloseDownloadModal" aria-hidden="true"></div>
        <div class="confirm-dialog" @onclick:stopPropagation>
            <div class="confirm-dialog__head">
                <span class="confirm-dialog__icon" aria-hidden="true">
                    <Icon Name="download" Width="17" Height="17" />
                </span>
                <h2 id="dl-modal-title" class="confirm-dialog__title">Use this recipe</h2>
            </div>
            <div class="confirm-dialog__body">
                @* The name is asked for, and the reason given, but the download is
                   not gated on it. A required field here collected "test" and "x"
                   from everyone downloading for a demo, which is worse than an
                   honest blank. See issue #539. *@
                @* Say what lands in the Downloads folder. It is always a ZIP, even
                   for a one-file recipe, and a button that says "Download" without
                   saying what of is a small surprise every time. *@
                <p>
                    @if (_recipe is { Files.Count: 1 })
                    {
                        <text>You'll get a ZIP with this recipe's file.</text>
                    }
                    else
                    {
                        <text>You'll get a ZIP with the recipe's files, in their folders.</text>
                    }
                </p>
                <p>
                    Naming the customer tells us who to warn if a bug turns up in this
                    recipe later.
                </p>
                <div class="field">
                    <label class="field__label" for="dl-customer">Customer (optional)</label>
                    <input id="dl-customer" type="text" class="input" list="dl-customers" maxlength="200"
                           @bind="_customerName" @bind:event="oninput"
                           @onkeydown="OnCustomerKeyDown"
                           aria-describedby="dl-customer-hint"
                           placeholder="e.g. CRONUS A/S" autofocus />
                    <datalist id="dl-customers">
                        @foreach (var name in _customerSuggestions)
                        {
                            <option value="@name" />
                        }
                    </datalist>
                    @* Only promise a pick when there is something to pick. A new
                       org has no solutions and no download history, and an
                       invitation to choose from an empty list reads as broken. *@
                    <p class="field__hint" id="dl-customer-hint">
                        @if (_customerSuggestions.Count > 0)
                        {
                            <text>Pick one of your solutions, or type any customer name. </text>
                        }
                        else
                        {
                            <text>Leave it blank if this is for a demo. </text>
                        }
                        Only admins in your organisation can see it.
                    </p>
                </div>

                @* The second way out of the app (issue #626). The picker sits
                   here because it shares the customer name above; its button is
                   in the footer beside Download, so neither reads as the small
                   print of the other. It renders at all only when this person
                   could actually use it - a consultant with no GitHub account
                   connected is better off not being told about a door they
                   cannot open. *@
                @if (_repoReady)
                {
                    <div class="rd-repo">
                        <span class="section-label">or</span>
                        <RepositoryPicker Label="Add this recipe's files to a repository instead"
                                          InputId="dl-repo"
                                          @bind-Selected="_repository"
                                          Disabled="_repoBusy"
                                          Hint="The files are committed to a new branch, in their own folders, and opened as a pull request from your GitHub account. Nothing on the default branch changes until someone merges it." />
                        @if (!string.IsNullOrEmpty(_repoError))
                        {
                            <FieldError Message="@_repoError" />
                        }
                    </div>
                }
            </div>
            @* Both ways out of the dialog sit in the same row, so neither looks
               like the small print of the other. Download stays the primary. *@
            <div class="confirm-dialog__actions">
                <button type="button" class="btn" disabled="@_repoBusy" @onclick="CloseDownloadModal">Cancel</button>
                @if (_repoReady && _repository is not null)
                {
                    <button type="button" class="btn" disabled="@_repoBusy"
                            @onclick="ApplyToRepositoryAsync">
                        <Icon Name="git-branch" Width="14" Height="14" />
                        <span>@(_repoBusy ? "Opening pull request..." : "Open pull request")</span>
                    </button>
                }
                <button type="button" class="btn btn--primary" disabled="@_repoBusy" @onclick="ConfirmDownloadAsync">
                    <Icon Name="download" Width="14" Height="14" />
                    <span>Download</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Recipe? _recipe;
    private bool _loaded;
    private IReadOnlyList<FileBrowser.Entry> _files = [];
    private ToastHost? _toast;
    private bool _showDownloadModal;
    private bool _copyRecorded;
    private string _customerName = string.Empty;
    private List<string> _customerSuggestions = new();

    // The GitHub half (issue #626). _repoReady is answered from the database
    // alone, so the modal decides whether to offer the repository section
    // without waiting on GitHub.
    private bool _repoReady;
    private GitHubRepositorySummary? _repository;
    private bool _repoBusy;
    private string? _repoError;
    private GitHubRecipeDelivery? _delivery;

    protected override async Task OnInitializedAsync()
    {
        // Readiness first: the page renders as soon as _recipe is set, and a
        // click on Download ZIP then queries this same DbContext - so nothing
        // may still be in flight on it once the recipe is there.
        _repoReady = (await Repositories.GetAccessAsync()).IsReady;
        _recipe = await Recipes.GetAsync(Id);
        _files = _recipe?.Files
            .Select(f => new FileBrowser.Entry(f.RelativePath, f.FileName, f.Content))
            .ToList() ?? [];
        _loaded = true;
    }

    /// <summary>Formats the estimated-value hours compactly, e.g. <c>8 hours</c>.</summary>
    private static string FormatHours(decimal hours) =>
        $"{hours.ToString("0.##")} {(hours == 1 ? "hour" : "hours")}";

    private async Task OpenDownloadModal()
    {
        _customerName = string.Empty;
        _repoError = null;
        // Refresh suggestions each open so a solution added - or a customer named -
        // in this session shows up.
        _customerSuggestions = await Recipes.GetCustomerSuggestionsAsync();
        _showDownloadModal = true;
    }

    private void CloseDownloadModal() => _showDownloadModal = false;

    private void OnDownloadKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc") CloseDownloadModal();
    }

    /// <summary>
    /// Enter in the customer box does whatever the dialog is set up to do -
    /// downloads, or opens the pull request once a repository has been picked,
    /// so Enter never quietly does the other one. It matters in a one-field
    /// dialog: without it a consultant who types a name and presses Enter gets
    /// nothing, and an interstitial in front of an optional field is only
    /// tolerable if it costs one keystroke to clear. Bound to the input, not
    /// the modal: on the modal, Enter on a focused Cancel button would act and
    /// then cancel, and on the Download button it would download twice.
    /// </summary>
    private async Task OnCustomerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or "NumpadEnter")) return;
        if (_repoBusy) return;
        if (_repoReady && _repository is not null)
        {
            await ApplyToRepositoryAsync();
            return;
        }
        await ConfirmDownloadAsync();
    }

    /// <summary>
    /// Hands the download off to the ZIP endpoint with the customer name as a
    /// query value. The endpoint records the download and streams an
    /// attachment, so navigating to it downloads the file without leaving the
    /// page - hence <c>location.assign</c> rather than a Blazor navigation.
    /// </summary>
    private async Task ConfirmDownloadAsync()
    {
        if (_recipe is null) return;
        var customer = _customerName.Trim();
        var url = $"/api/cookbook/{_recipe.Id}/download?customer={Uri.EscapeDataString(customer)}";
        _showDownloadModal = false;
        await JS.InvokeVoidAsync("location.assign", url);

        // The browser streams the attachment without a navigation, so without
        // this the modal just vanishes and nothing says the download happened.
        _toast?.Show(
            "Download started",
            customer.Length > 0 ? $"Recorded for {customer}." : null);
    }

    /// <summary>
    /// Commits the recipe into the picked repository and opens a pull request
    /// for it. The service owns the branch rule, the refusals and the
    /// attribution, so the agent-facing tool behaves the same way; this method
    /// only has to word what came back. See issue #626.
    /// </summary>
    private async Task ApplyToRepositoryAsync()
    {
        if (_recipe is null || _repository is null) return;

        _repoBusy = true;
        _repoError = null;
        try
        {
            var customer = _customerName.Trim();
            _delivery = await RecipeDelivery.ApplyAsync(
                _recipe.Id, _repository.FullName, customer.Length > 0 ? customer : null);
            _showDownloadModal = false;
            // The alert lands at the top of the page, which somebody who opened
            // the dialog from further down will not be looking at.
            _toast?.Show(
                $"Pull request #{_delivery.PullRequest.Number} opened",
                _delivery.Repository.FullName);
        }
        catch (PlanValidationException ex)
        {
            // Both keys the service uses land beside the picker: the dialog has
            // nowhere else to put them, and either way the person is standing
            // right here.
            _repoError = string.Join(" ", ex.Errors.Values);
        }
        catch (GitHubApiException ex)
        {
            Logger.LogWarning(ex, "GitHub refused the pull request on {RepoFullName}.", _repository.FullName);
            _repoError = $"GitHub refused this: {ex.Message}. Check you still have write access to "
                + $"{_repository.FullName}, then try again.";
        }
        catch (Exception ex) when (ex is GitHubAppNotConfiguredException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Could not reach GitHub to apply recipe {RecipeId}.", _recipe.Id);
            _repoError = "The workbench could not reach GitHub just now, so nothing was committed. "
                + "Try again in a minute.";
        }
        finally
        {
            _repoBusy = false;
        }
    }

    private static List<string> SplitKeywords(string? keywords) =>
        string.IsNullOrWhiteSpace(keywords)
            ? new List<string>()
            : keywords.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private async Task CopyFileAsync(FileBrowser.Entry file)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", file.Content);
            _toast?.Show($"Copied {file.Path}");
            await RecordCopyOnceAsync();
        }
        catch
        {
            // navigator.clipboard is unavailable over plain http and can be
            // denied by permission policy. Saying so beats a button that looks
            // like it worked - the code is still selectable by hand.
            _toast?.Show("Couldn't copy", "Select the code and press Ctrl+C.", ToastKind.Danger);
        }
    }

    /// <summary>
    /// Records that this recipe was used, the first time the visitor copies a
    /// file out of it. Once per visit, not once per file: a module recipe has a
    /// dozen files and a dozen rows would bury the download history it shares.
    ///
    /// Best-effort - a copy that reached the clipboard succeeded from the
    /// user's point of view, so a failed write is logged and swallowed rather
    /// than turned into an error they can do nothing about.
    /// </summary>
    private async Task RecordCopyOnceAsync()
    {
        if (_copyRecorded) return;
        _copyRecorded = true;
        try
        {
            await Recipes.RecordCopyAsync(Id, OrgContext.CurrentUserId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not record a copy of recipe {RecipeId}.", Id);
        }
    }
}
