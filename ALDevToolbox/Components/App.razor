@inject IHttpContextAccessor Http
@inject ALDevToolbox.Services.CacheBust Bust
<!DOCTYPE html>
@* data-theme is rendered server-side from the aldt-theme cookie so Blazor's
   enhanced-navigation diff sees a value matching what the client already has
   on <html> and leaves it alone. Without the cookie, the response would have
   no attribute and the diff would strip it on every nav, visibly flipping
   the page to the OS default. The inline FOUC script handles cookie-less
   first visits; theme.js writes the cookie alongside localStorage on click. *@
<html lang="en" data-theme="@ServerTheme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Synchronously honour the persisted theme choice before the CSS files
       load, so users who picked dark don't see a light flash on cold loads. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem("aldt-theme");
                if (t === "light" || t === "dark") {
                    document.documentElement.setAttribute("data-theme", t);
                }
            } catch (e) { /* private mode etc. - fall through to system pref */ }
        })();
    </script>
    @* Load order is deliberate and load order is the whole mechanism: the design
       layer goes first so a not-yet-migrated page's own rules still win, which
       is what lets a tool move one PR at a time. See .design/design-migration.md
       and StylesheetLoadOrderTests. *@
    <link rel="stylesheet" href="@Assets["fonts.css"]" />
    <link rel="stylesheet" href="@Assets["tokens.css"]" />
    @* The shared component layer sits between the tokens and the page CSS, so a
       not-yet-migrated page can still override a component. As each tool moves
       onto these classes its bespoke rules are deleted, and the component layer
       becomes the only definition. See .design/design-migration.md. *@
    <link rel="stylesheet" href="@Assets["components.css"]" />
    <link rel="stylesheet" href="@Assets["shell.css"]" />
    <link rel="stylesheet" href="@Assets["pages.css"]" />
    <link rel="stylesheet" href="@Assets["pages-forms.css"]" />
    <link rel="stylesheet" href="@Assets["pages-power.css"]" />
    <link rel="stylesheet" href="@Assets["pages-content.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* The command palette is a script-built overlay, so its sheet cannot be a
       scoped one (Blazor's scope attribute is not on cloned nodes) and it loads
       with the other app-owned sheets. See .design/command-palette.md. *@
    <link rel="stylesheet" href="@Assets["command-palette.css"]" />
    @* Not legacy, despite sitting down here with it: code-editor.css styles DOM
       CodeMirror builds at runtime, and source-viewer.css is the Object
       Explorer's own composition on top of archetype 10. Both load after the
       design layer because both override it deliberately - the viewer's
       .source-viewer__code .cm-editor is the worked example. See PR 17b. *@
    <link rel="stylesheet" href="@Assets["code-editor.css"]" />
    <link rel="stylesheet" href="@Assets["source-viewer.css"]" />
    <link rel="stylesheet" href="@Assets["ALDevToolbox.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["shell-drawer.js"]"></script>
    <script src="@Assets["search-shortcut.js"]"></script>
    <script src="@Assets["nav-groups.js"]"></script>
    <script src="@Assets["nav-arrange.js"]"></script>
    <script src="@Assets["command-palette.js"]"></script>
    <script src="@Assets["generate.js"]"></script>
    <script src="@Assets["row-actions-menu.js"]"></script>
    <script src="@Assets["notification-flyout.js"]"></script>
    <script src="@Assets["copy-to-clipboard.js"]"></script>
    <script src="@Assets["docs-toc.js"]"></script>
    <script src="@Assets["object-explorer-import.js"]"></script>
    <script src="@Assets["uncontrolled-input.js"]"></script>
    <script src="@Assets["grid-paste.js"]"></script>
    <script src="@Assets["signup-details.js"]"></script>
    <script src="@Assets["js/webauthn.js"]"></script>
    @*
        Object Explorer source viewer's client glue.
        Loaded at the shell level (not on the source-viewer page itself)
        because Blazor's enhanced-navigation diff doesn't execute
        <script> tags that appear in page responses - confirmed by the
        network tab on a fresh navigation. With the script in the shell
        it loads once per session; the module's MutationObserver waits
        for .source-viewer to appear in the DOM and runs init() only
        when needed, so non-source-viewer pages pay nothing.

        ?v=token cache-buster comes from CacheBust (singleton, GUID
        prefix per process start) so deploys invalidate cleanly; the
        module forwards the same token to its dynamic import of
        /code-editor.js via import.meta.url.
    *@
    <script type="module" src="/source-viewer.js?v=@Bust.Token"></script>
</body>

</html>

@code {
    private string? ServerTheme
    {
        get
        {
            var cookie = Http.HttpContext?.Request.Cookies["aldt-theme"];
            return cookie is "light" or "dark" ? cookie : null;
        }
    }
}
